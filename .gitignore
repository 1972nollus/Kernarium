# Project build products
/.build/

# Local root filesystem image
/rootfs.ext2
/rootfs.erofs
*.img
.rootfs.*.uml-lock
.rootfs-provision-*/

# Official Linux checkout is maintained as its own repository; the outer tree
# tracks its reproducible patch series under kernel/patches/ instead.
/linux/

# Compiler and debugger output outside the build directory
*.dSYM/
compile_commands.json

# macOS filesystem metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor and IDE state
/.claude/
.idea/
.vscode/
*.swp
*.swo
*~
__pycache__/
*.pyc
/tmp/
*.pdf
/external/*

# Per-developer CMake configuration; checked-in workflows live in
# CMakePresets.json.
CMakeUserPresets.json
