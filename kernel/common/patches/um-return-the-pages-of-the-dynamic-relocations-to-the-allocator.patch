From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 31 Oct 2026 14:12:09 +0900
Subject: [PATCH] um: return the pages of the dynamic relocations to the
 allocator

The kernel image is a position-independent ELF file whose host loader
applies about 100,000 relative relocations before it jumps to the entry
point. The relocation records, 24 bytes each, stay in the image, 2.3 MiB
of the guest's RAM that nothing reads after the host has finished.

Name the .rela.dyn output section's bounds in the linker script and, once
the allocator is about to start, replace the host pages that lie wholly
inside it with the physical-memory file's alias, as for the pages after
the break, and free them to memblock. A host page shared with a neighbour
section stays: Darwin maps and protects whole 16 KiB host pages.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/um/kernel/dyn.lds.S |  9 +++++++++
 arch/um/kernel/mem.c     | 29 +++++++++++++++++++++++++++++
 2 files changed, 38 insertions(+)

diff --git a/arch/um/kernel/dyn.lds.S b/arch/um/kernel/dyn.lds.S
index 21cb40a672f97440f555af3df2fbcaa7113997a0..9817216e483f3a67785a52d07423387d24828d71 100644
--- a/arch/um/kernel/dyn.lds.S
+++ b/arch/um/kernel/dyn.lds.S
@@ -79,6 +79,15 @@ SECTIONS
 	*(.rela.iplt)
 	PROVIDE_HIDDEN(__rela_iplt_end = .);
   }
+  /* The dynamic relocations. The host applies them before it starts the
+   * kernel and nothing reads them again, so arch_mm_preinit() hands the
+   * host pages they fill to the page allocator.
+   */
+  .rela.dyn       : {
+	__rela_dyn_start = .;
+	*(.rela.dyn)
+	__rela_dyn_end = .;
+  }
   .init           : {
     KEEP (*(.init))
   } =0x90909090
diff --git a/arch/um/kernel/mem.c b/arch/um/kernel/mem.c
index 7c42ca72464020660034a658d553132b7f8b1f42..486f7123d563c645414788fa7c55a68127d9279e 100644
--- a/arch/um/kernel/mem.c
+++ b/arch/um/kernel/mem.c
@@ -60,6 +60,32 @@ int kmalloc_ok = 0;
 /* Used during early boot */
 static unsigned long brk_end;
 
+#ifdef UML_HOST_DARWIN
+extern char __rela_dyn_start[], __rela_dyn_end[];
+
+/*
+ * The host applied the image's dynamic relocations before it started the
+ * kernel, and nothing reads them again, yet they are two megabytes of the
+ * image: one 24-byte record per pointer the image holds. The host pages that
+ * lie wholly inside them go to the page allocator the way the pages after the
+ * break do. The physical-memory file replaces the image's copy of them, since
+ * a page that user space or the page cache can map has to be in that file,
+ * and what the allocator gets starts zeroed.
+ */
+static void __init free_dynamic_relocations(void)
+{
+	unsigned long start = ALIGN((unsigned long)__rela_dyn_start,
+				    4 * PAGE_SIZE);
+	unsigned long end = ALIGN_DOWN((unsigned long)__rela_dyn_end,
+				       4 * PAGE_SIZE);
+
+	if (start >= end)
+		return;
+	map_memory(start, __pa(start), end - start, 1, 1, 0);
+	memblock_free((void *)start, end - start);
+}
+#endif
+
 void __init arch_mm_preinit(void)
 {
 	/* Safe to call after jump_label_init(). Enables KASAN. */
@@ -81,6 +107,9 @@ void __init arch_mm_preinit(void)
 #endif
 	map_memory(brk_end, __pa(brk_end), uml_reserved - brk_end, 1, 1, 0);
 	memblock_free((void *)brk_end, uml_reserved - brk_end);
+#ifdef UML_HOST_DARWIN
+	free_dynamic_relocations();
+#endif
 	uml_reserved = brk_end;
 	min_low_pfn = PFN_UP(__pa(uml_reserved));
 	max_pfn = max_low_pfn;
