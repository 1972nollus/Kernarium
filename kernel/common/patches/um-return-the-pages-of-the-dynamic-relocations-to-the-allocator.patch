From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 31 Oct 2026 14:12:09 +0900
Subject: [PATCH] um: return the pages of the dynamic relocations to the
 allocator

The kernel image is a position-independent ELF file whose host loader
applies about 100,000 relative relocations before it jumps to the entry
point. The relocation records, 24 bytes each, stay in the image, 2.3 MiB
of the guest's RAM that nothing reads after the host has finished.

Name the .rela.dyn output section's bounds in the linker script and, once
the allocator is about to start, replace the host pages that lie wholly
inside it with the physical-memory file's alias, as for the pages after
the break, and free them to memblock. A host page shared with a neighbour
section stays: Darwin maps and protects whole 16 KiB host pages.

The pages lie below the break, and the memory table that virtio-uml sends
a vhost-user backend started at the break, since the image is not in the
file. A buffer the allocator placed in the freed range, such as a
virtio-gpu command, then lay outside the guest memory the backend knew,
and the backend dropped the connection ("virtqueue buffer is outside
guest memory"). The table now carries the freed range as a region of its
own, with its offset in the file.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/um/drivers/virtio_uml.c | 30 +++++++++++++++++------
 arch/um/include/shared/mem.h | 12 ++++++++++
 arch/um/kernel/dyn.lds.S     |  9 +++++++
 arch/um/kernel/mem.c         | 46 ++++++++++++++++++++++++++++++++++++
 4 files changed, 90 insertions(+), 7 deletions(-)

diff --git a/arch/um/drivers/virtio_uml.c b/arch/um/drivers/virtio_uml.c
index 61c5ef5b7f2f9b8a2c30a45235331818c74ed613..5288d707429c901b60b153ec005c8eca2226c50a 100644
--- a/arch/um/drivers/virtio_uml.c
+++ b/arch/um/drivers/virtio_uml.c
@@ -984,11 +984,11 @@ static int vhost_user_set_mem_table(struct virtio_uml_device *vu_dev)
 {
 	struct vhost_user_msg msg = {
 		.header.request = VHOST_USER_SET_MEM_TABLE,
-		.header.size = offsetof(typeof(msg.payload.mem_regions), regions[1]),
-		.payload.mem_regions.num = 1,
 	};
 	unsigned long reserved = uml_reserved - uml_physmem;
+	unsigned long hole_start, hole_end;
 	int fds[2];
+	u32 num = 0;
 	int rc;
 
 	/*
@@ -1025,16 +1025,32 @@ static int vhost_user_set_mem_table(struct virtio_uml_device *vu_dev)
 	 * between bss_start and where we map the file now, but it's not
 	 * something that you typically encounter with virtio drivers, so
 	 * it didn't seem worthwhile.
+	 *
+	 * Pages of the image that the kernel gave to the page allocator are
+	 * the exception. Their contents are in the file, and the allocator
+	 * hands them out like any other page, so they are a region of their
+	 * own.
 	 */
+	if (uml_image_hole(&hole_start, &hole_end)) {
+		rc = vhost_user_init_mem_region(hole_start,
+						hole_end - hole_start,
+						&fds[num],
+						&msg.payload.mem_regions.regions[num]);
+		if (rc < 0)
+			return rc;
+		num++;
+	}
 	rc = vhost_user_init_mem_region(reserved, physmem_size - reserved,
-					&fds[0],
-					&msg.payload.mem_regions.regions[0]);
-
+					&fds[num],
+					&msg.payload.mem_regions.regions[num]);
 	if (rc < 0)
 		return rc;
+	num++;
 
-	return vhost_user_send(vu_dev, &msg, fds,
-			       msg.payload.mem_regions.num);
+	msg.payload.mem_regions.num = num;
+	msg.header.size = offsetof(typeof(msg.payload.mem_regions),
+				   regions[num]);
+	return vhost_user_send(vu_dev, &msg, fds, num);
 }
 
 static int vhost_user_set_vring_state(struct virtio_uml_device *vu_dev,
diff --git a/arch/um/include/shared/mem.h b/arch/um/include/shared/mem.h
index 952b871ea04bf65e28379adcbe3788cd5f67cc1e..7b33518ca6a7319d8680f2ee28d0c10c79e35af3 100644
--- a/arch/um/include/shared/mem.h
+++ b/arch/um/include/shared/mem.h
@@ -28,6 +28,18 @@ int uml_vhost_user_shmem_unmap(void *owner,
 			       unsigned long long length);
 void uml_vhost_user_shmem_reset(void *owner);
 void uml_vhost_user_shmem_release(void *owner);
+
+/*
+ * The pages of the kernel image that the page allocator owns, as a physical
+ * range below uml_reserved. Their contents are in the physical-memory file,
+ * so a vhost-user backend can reach them if the memory table names them.
+ */
+int uml_image_hole(unsigned long *start, unsigned long *end);
+#else
+static inline int uml_image_hole(unsigned long *start, unsigned long *end)
+{
+	return 0;
+}
 #endif
 
 extern unsigned long uml_physmem;
diff --git a/arch/um/kernel/dyn.lds.S b/arch/um/kernel/dyn.lds.S
index 21cb40a672f97440f555af3df2fbcaa7113997a0..9817216e483f3a67785a52d07423387d24828d71 100644
--- a/arch/um/kernel/dyn.lds.S
+++ b/arch/um/kernel/dyn.lds.S
@@ -79,6 +79,15 @@ SECTIONS
 	*(.rela.iplt)
 	PROVIDE_HIDDEN(__rela_iplt_end = .);
   }
+  /* The dynamic relocations. The host applies them before it starts the
+   * kernel and nothing reads them again, so arch_mm_preinit() hands the
+   * host pages they fill to the page allocator.
+   */
+  .rela.dyn       : {
+	__rela_dyn_start = .;
+	*(.rela.dyn)
+	__rela_dyn_end = .;
+  }
   .init           : {
     KEEP (*(.init))
   } =0x90909090
diff --git a/arch/um/kernel/mem.c b/arch/um/kernel/mem.c
index 7c42ca72464020660034a658d553132b7f8b1f42..866ab3f2663597fea523b8ff0cf8bdf7e0745421 100644
--- a/arch/um/kernel/mem.c
+++ b/arch/um/kernel/mem.c
@@ -17,6 +17,7 @@
 #include <init.h>
 #include <kern.h>
 #include <kern_util.h>
+#include <mem.h>
 #include <mem_user.h>
 #include <os.h>
 #include <um_malloc.h>
@@ -60,6 +61,48 @@ int kmalloc_ok = 0;
 /* Used during early boot */
 static unsigned long brk_end;
 
+#ifdef UML_HOST_DARWIN
+extern char __rela_dyn_start[], __rela_dyn_end[];
+
+/* The physical range free_dynamic_relocations() gave to the allocator. */
+static unsigned long image_hole_start __ro_after_init;
+static unsigned long image_hole_end __ro_after_init;
+
+int uml_image_hole(unsigned long *start, unsigned long *end)
+{
+	*start = image_hole_start;
+	*end = image_hole_end;
+	return image_hole_end > image_hole_start;
+}
+
+/*
+ * The host applied the image's dynamic relocations before it started the
+ * kernel, and nothing reads them again, yet they are two megabytes of the
+ * image: one 24-byte record per pointer the image holds. The host pages that
+ * lie wholly inside them go to the page allocator the way the pages after the
+ * break do. The physical-memory file replaces the image's copy of them, since
+ * a page that user space or the page cache can map has to be in that file,
+ * and what the allocator gets starts zeroed. The range is below the break, so
+ * the memory table a vhost-user backend receives has to name it as a region of
+ * its own (uml_image_hole()); otherwise a buffer the allocator places there
+ * lies outside the guest memory the backend knows.
+ */
+static void __init free_dynamic_relocations(void)
+{
+	unsigned long start = ALIGN((unsigned long)__rela_dyn_start,
+				    4 * PAGE_SIZE);
+	unsigned long end = ALIGN_DOWN((unsigned long)__rela_dyn_end,
+				       4 * PAGE_SIZE);
+
+	if (start >= end)
+		return;
+	map_memory(start, __pa(start), end - start, 1, 1, 0);
+	memblock_free((void *)start, end - start);
+	image_hole_start = __pa(start);
+	image_hole_end = __pa(end);
+}
+#endif
+
 void __init arch_mm_preinit(void)
 {
 	/* Safe to call after jump_label_init(). Enables KASAN. */
@@ -81,6 +124,9 @@ void __init arch_mm_preinit(void)
 #endif
 	map_memory(brk_end, __pa(brk_end), uml_reserved - brk_end, 1, 1, 0);
 	memblock_free((void *)brk_end, uml_reserved - brk_end);
+#ifdef UML_HOST_DARWIN
+	free_dynamic_relocations();
+#endif
 	uml_reserved = brk_end;
 	min_low_pfn = PFN_UP(__pa(uml_reserved));
 	max_pfn = max_low_pfn;
