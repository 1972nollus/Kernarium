Subject: [PATCH] arm64: expose system mapping sealing

---
 arch/arm64/um/Kconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/um/Kconfig b/arch/arm64/um/Kconfig
index 69b162be2450e3e813d378cfe650526512ea0695..1619a8085d70bb0b4168dedfe0623c8b337ea080 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -3,6 +3,7 @@
 config UML_ARM64
 	def_bool y
 	select CLONE_BACKWARDS
+	select ARCH_SUPPORTS_MSEAL_SYSTEM_MAPPINGS
 	select ARCH_WANT_DEFAULT_TOPDOWN_MMAP_LAYOUT
 	select ARCH_HAS_SET_DIRECT_MAP
 	select ARCH_HAS_SET_MEMORY
