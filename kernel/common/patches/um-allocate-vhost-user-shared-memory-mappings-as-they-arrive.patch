From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 31 Oct 2026 14:07:37 +0900
Subject: [PATCH] um: allocate vhost-user shared-memory mappings as they arrive

The region a vhost-user backend maps host memory into has one mapping
per alignment unit at most, and the kernel kept two static tables sized
for that worst case, 2.75 MiB of image whether or not any device claims
a region. A guest takes that from its RAM for the life of the boot, yet
holds only the mappings its backend has asked for.

Keep each mapping in its own node in a tree keyed by its offset in the
region. The backend's request is served in an interrupt handler as well
as in the reply wait, so the node comes from GFP_ATOMIC before the raw
lock is taken, and a failed allocation rejects the map like any other
refusal. A revocation detaches the nodes in batches and closes their
descriptors outside the lock as before.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/um/kernel/physmem.c | 176 ++++++++++++++++++++++++---------------
 1 file changed, 108 insertions(+), 68 deletions(-)

diff --git a/arch/um/kernel/physmem.c b/arch/um/kernel/physmem.c
index 140b50af8ea238e32614f2c1f340745343fa1246..276f8711c5fa59310922ed8f36aab08a1b448db1 100644
--- a/arch/um/kernel/physmem.c
+++ b/arch/um/kernel/physmem.c
@@ -9,7 +9,9 @@
 #include <linux/mm.h>
 #include <linux/page_reporting.h>
 #include <linux/pfn.h>
+#include <linux/rbtree.h>
 #include <linux/scatterlist.h>
+#include <linux/slab.h>
 #include <linux/spinlock.h>
 #include <linux/workqueue.h>
 #include <asm/page.h>
@@ -24,29 +26,79 @@
 static int physmem_fd = -1;
 
 #ifdef UML_HOST_DARWIN
-#define UML_VHOST_USER_SHMEM_MAX_MAPS \
-	(UML_VHOST_USER_SHMEM_SIZE / UML_VHOST_USER_SHMEM_ALIGNMENT)
 #define UML_VHOST_USER_SHMEM_MAP_RW	1
+/* Mappings a revocation detaches under one hold of the lock. */
+#define UML_VHOST_USER_SHMEM_REVOKE_BATCH	32
 
+/*
+ * One mapping the backend asked for, keyed by its offset in the region. The
+ * mappings never overlap and the number of them is the backend's to choose, up
+ * to one per alignment unit of the region, so they are allocated one by one
+ * and found through a tree rather than kept in tables sized for the worst
+ * case.
+ */
 struct uml_vhost_user_shmem_mapping {
+	struct rb_node node;
 	void *owner;
 	unsigned long long fd_offset;
 	unsigned long long shm_offset;
 	unsigned long long length;
 	int fd;
-	bool mapped;
 };
 
 static DEFINE_RAW_SPINLOCK(uml_vhost_user_shmem_lock);
-static struct uml_vhost_user_shmem_mapping
-	uml_vhost_user_shmem_mappings[UML_VHOST_USER_SHMEM_MAX_MAPS];
-/* Zero means free; otherwise the page names its mapping's first page plus one. */
-static unsigned int uml_vhost_user_shmem_pages[UML_VHOST_USER_SHMEM_MAX_MAPS];
+static struct rb_root uml_vhost_user_shmem_tree = RB_ROOT;
 static void *uml_vhost_user_shmem_owner;
 static unsigned long uml_vhost_user_shmem_phys;
 static bool uml_vhost_user_shmem_reserved;
 static bool uml_vhost_user_shmem_revoking;
 
+/* The mapping that covers @offset in the region. The lock is held. */
+static struct uml_vhost_user_shmem_mapping *
+uml_vhost_user_shmem_find(unsigned long long offset)
+{
+	struct rb_node *node = uml_vhost_user_shmem_tree.rb_node;
+
+	while (node) {
+		struct uml_vhost_user_shmem_mapping *mapping =
+			rb_entry(node, struct uml_vhost_user_shmem_mapping, node);
+
+		if (offset < mapping->shm_offset)
+			node = node->rb_left;
+		else if (offset >= mapping->shm_offset + mapping->length)
+			node = node->rb_right;
+		else
+			return mapping;
+	}
+	return NULL;
+}
+
+/* Link @new in, or say -EEXIST if it overlaps a mapping. The lock is held. */
+static int uml_vhost_user_shmem_insert(
+	struct uml_vhost_user_shmem_mapping *new)
+{
+	struct rb_node **link = &uml_vhost_user_shmem_tree.rb_node;
+	struct rb_node *parent = NULL;
+
+	while (*link) {
+		struct uml_vhost_user_shmem_mapping *mapping =
+			rb_entry(*link, struct uml_vhost_user_shmem_mapping,
+				 node);
+
+		parent = *link;
+		if (new->shm_offset + new->length <= mapping->shm_offset)
+			link = &parent->rb_left;
+		else if (new->shm_offset >=
+			 mapping->shm_offset + mapping->length)
+			link = &parent->rb_right;
+		else
+			return -EEXIST;
+	}
+	rb_link_node(&new->node, parent, link);
+	rb_insert_color(&new->node, &uml_vhost_user_shmem_tree);
+	return 0;
+}
+
 void uml_vhost_user_shmem_reserve(void)
 {
 	if (uml_vhost_user_shmem_reserved)
@@ -99,7 +151,6 @@ int uml_vhost_user_shmem_map(void *owner, int fd,
 	struct uml_stat stat;
 	struct uml_vhost_user_shmem_mapping *mapping;
 	unsigned long irq_flags;
-	unsigned int first, count, i;
 	int ret = 0;
 
 	if (!owner || fd < 0 || !length ||
@@ -112,38 +163,32 @@ int uml_vhost_user_shmem_map(void *owner, int fd,
 		return -ERANGE;
 	if (os_stat_fd(fd, &stat) || fd_offset + length > stat.ust_size)
 		return -EINVAL;
-	first = shm_offset / UML_VHOST_USER_SHMEM_ALIGNMENT;
-	count = length / UML_VHOST_USER_SHMEM_ALIGNMENT;
-
-	raw_spin_lock_irqsave(&uml_vhost_user_shmem_lock, irq_flags);
-	if (uml_vhost_user_shmem_owner != owner) {
-		ret = -EPERM;
-		goto out_unlock;
-	}
-	if (uml_vhost_user_shmem_revoking) {
-		ret = -EBUSY;
-		goto out_unlock;
-	}
-	for (i = first; i < first + count; i++) {
-		if (uml_vhost_user_shmem_pages[i]) {
-			ret = -EEXIST;
-			goto out_unlock;
-		}
-	}
-	mapping = &uml_vhost_user_shmem_mappings[first];
+	/*
+	 * The backend's request arrives in an interrupt handler as well as in
+	 * the reply wait, so the node comes from the atomic reserves and the
+	 * lock is held only to link it.
+	 */
+	mapping = kmalloc(sizeof(*mapping), GFP_ATOMIC);
+	if (!mapping)
+		return -ENOMEM;
 	*mapping = (struct uml_vhost_user_shmem_mapping) {
 		.owner = owner,
 		.fd_offset = fd_offset,
 		.shm_offset = shm_offset,
 		.length = length,
 		.fd = fd,
-		.mapped = true,
 	};
-	for (i = first; i < first + count; i++)
-		uml_vhost_user_shmem_pages[i] = first + 1;
 
-out_unlock:
+	raw_spin_lock_irqsave(&uml_vhost_user_shmem_lock, irq_flags);
+	if (uml_vhost_user_shmem_owner != owner)
+		ret = -EPERM;
+	else if (uml_vhost_user_shmem_revoking)
+		ret = -EBUSY;
+	else
+		ret = uml_vhost_user_shmem_insert(mapping);
 	raw_spin_unlock_irqrestore(&uml_vhost_user_shmem_lock, irq_flags);
+	if (ret)
+		kfree(mapping);
 	return ret;
 }
 
@@ -153,7 +198,6 @@ int uml_vhost_user_shmem_unmap(void *owner,
 {
 	struct uml_vhost_user_shmem_mapping *mapping;
 	unsigned long flags;
-	unsigned int first, count, i;
 	int fd = -1;
 
 	if (!owner || !length ||
@@ -161,34 +205,34 @@ int uml_vhost_user_shmem_unmap(void *owner,
 	    shm_offset > U64_MAX - length ||
 	    shm_offset + length > UML_VHOST_USER_SHMEM_SIZE)
 		return -EINVAL;
-	first = shm_offset / UML_VHOST_USER_SHMEM_ALIGNMENT;
-	count = length / UML_VHOST_USER_SHMEM_ALIGNMENT;
 
 	raw_spin_lock_irqsave(&uml_vhost_user_shmem_lock, flags);
-	if (uml_vhost_user_shmem_owner != owner || uml_vhost_user_shmem_revoking)
-		goto out_unlock;
-	mapping = &uml_vhost_user_shmem_mappings[first];
-	if (!mapping->mapped || mapping->owner != owner ||
-	    mapping->shm_offset != shm_offset || mapping->length != length)
-		goto out_unlock;
-	fd = mapping->fd;
-	for (i = first; i < first + count; i++)
-		uml_vhost_user_shmem_pages[i] = 0;
-	*mapping = (struct uml_vhost_user_shmem_mapping) {};
-
-out_unlock:
+	mapping = NULL;
+	if (uml_vhost_user_shmem_owner == owner &&
+	    !uml_vhost_user_shmem_revoking) {
+		mapping = uml_vhost_user_shmem_find(shm_offset);
+		if (mapping && (mapping->owner != owner ||
+				mapping->shm_offset != shm_offset ||
+				mapping->length != length))
+			mapping = NULL;
+	}
+	if (mapping) {
+		fd = mapping->fd;
+		rb_erase(&mapping->node, &uml_vhost_user_shmem_tree);
+	}
 	raw_spin_unlock_irqrestore(&uml_vhost_user_shmem_lock, flags);
-	if (fd < 0)
+	if (!mapping)
 		return -ENOENT;
 	os_close_file(fd);
+	kfree(mapping);
 	return 0;
 }
 
 static void uml_vhost_user_shmem_revoke(void *owner, bool release)
 {
-	int fds[64];
+	struct uml_vhost_user_shmem_mapping *batch[UML_VHOST_USER_SHMEM_REVOKE_BATCH];
 	unsigned long flags;
-	unsigned int first, i, count;
+	unsigned int count, i;
 
 	raw_spin_lock_irqsave(&uml_vhost_user_shmem_lock, flags);
 	if (uml_vhost_user_shmem_owner != owner) {
@@ -202,28 +246,26 @@ static void uml_vhost_user_shmem_revoke(void *owner, bool release)
 		return;
 	}
 	uml_vhost_user_shmem_revoking = true;
-	memset(uml_vhost_user_shmem_pages, 0, sizeof(uml_vhost_user_shmem_pages));
 	raw_spin_unlock_irqrestore(&uml_vhost_user_shmem_lock, flags);
 
 	/* Keep the stack bounded and close host descriptors outside the raw lock. */
-	for (first = 0; first < UML_VHOST_USER_SHMEM_MAX_MAPS;
-	     first += ARRAY_SIZE(fds)) {
+	do {
+		struct rb_node *node;
+
 		count = 0;
 		raw_spin_lock_irqsave(&uml_vhost_user_shmem_lock, flags);
-		for (i = first; i < first + ARRAY_SIZE(fds) &&
-		     i < UML_VHOST_USER_SHMEM_MAX_MAPS; i++) {
-			struct uml_vhost_user_shmem_mapping *mapping =
-				&uml_vhost_user_shmem_mappings[i];
-
-			if (!mapping->mapped || mapping->owner != owner)
-				continue;
-			fds[count++] = mapping->fd;
-			*mapping = (struct uml_vhost_user_shmem_mapping) {};
+		while (count < ARRAY_SIZE(batch) &&
+		       (node = rb_first(&uml_vhost_user_shmem_tree))) {
+			rb_erase(node, &uml_vhost_user_shmem_tree);
+			batch[count++] = rb_entry(
+				node, struct uml_vhost_user_shmem_mapping, node);
 		}
 		raw_spin_unlock_irqrestore(&uml_vhost_user_shmem_lock, flags);
-		for (i = 0; i < count; i++)
-			os_close_file(fds[i]);
-	}
+		for (i = 0; i < count; i++) {
+			os_close_file(batch[i]->fd);
+			kfree(batch[i]);
+		}
+	} while (count == ARRAY_SIZE(batch));
 	raw_spin_lock_irqsave(&uml_vhost_user_shmem_lock, flags);
 	uml_vhost_user_shmem_revoking = false;
 	raw_spin_unlock_irqrestore(&uml_vhost_user_shmem_lock, flags);
@@ -245,7 +287,6 @@ static int uml_vhost_user_shmem_phys_mapping(
 	struct uml_vhost_user_shmem_mapping *mapping;
 	unsigned long long offset;
 	unsigned long flags;
-	unsigned int index;
 	int fd = -1;
 
 	raw_spin_lock_irqsave(&uml_vhost_user_shmem_lock, flags);
@@ -254,10 +295,9 @@ static int uml_vhost_user_shmem_phys_mapping(
 	offset = phys - uml_vhost_user_shmem_phys;
 	if (offset >= UML_VHOST_USER_SHMEM_SIZE)
 		goto out_unlock;
-	index = uml_vhost_user_shmem_pages[offset / UML_VHOST_USER_SHMEM_ALIGNMENT];
-	if (!index)
+	mapping = uml_vhost_user_shmem_find(offset);
+	if (!mapping)
 		goto out_unlock;
-	mapping = &uml_vhost_user_shmem_mappings[index - 1];
 	fd = mapping->fd;
 	*offset_out = mapping->fd_offset + offset - mapping->shm_offset;
 
