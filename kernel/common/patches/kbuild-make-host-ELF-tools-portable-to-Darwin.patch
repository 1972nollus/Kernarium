From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 3 Aug 2026 17:24:12 +0900
Subject: [PATCH] kbuild: make host ELF tools portable to Darwin

Apply the reviewed final-state topic without intermediate churn.
---
 scripts/Makefile.vmlinux | 7 ++++++-
 scripts/link-vmlinux.sh  | 6 +++++-
 scripts/mod/file2alias.c | 6 ++++++
 3 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/scripts/Makefile.vmlinux b/scripts/Makefile.vmlinux
index 276c3134a563ade4933fab4df17e7eafc6a39fe2..fbe545bd4c386f3ad3e563677b2a1fde0c5406f1 100644
--- a/scripts/Makefile.vmlinux
+++ b/scripts/Makefile.vmlinux
@@ -112,8 +112,13 @@ vmlinux: vmlinux.unstripped FORCE
 # Strip the trailing padding bytes after extracting .modinfo to comply with
 # what kmod expects to parse.
 quiet_cmd_modules_builtin_modinfo = GEN     $@
+ifeq ($(UML_HOST_OS),Darwin)
+      cmd_trim_modinfo_padding = perl -0777 -pi -e 's/\x00+\z/\x00/' $@
+else
+      cmd_trim_modinfo_padding = sed -i 's/\x00\+$$/\x00/g' $@
+endif
       cmd_modules_builtin_modinfo = $(cmd_objcopy); \
-                                    sed -i 's/\x00\+$$/\x00/g' $@; \
+				    $(cmd_trim_modinfo_padding); \
                                     chmod -x $@
 
 OBJCOPYFLAGS_modules.builtin.modinfo := -j .modinfo -O binary
diff --git a/scripts/link-vmlinux.sh b/scripts/link-vmlinux.sh
index 433849ff7529e1fb8bb24e01163455844c8a4c88..73b21ea8477be5fef3224c344b0352139182eeca 100755
--- a/scripts/link-vmlinux.sh
+++ b/scripts/link-vmlinux.sh
@@ -80,7 +80,11 @@ vmlinux_link()
 		wl=-Wl,
 		ld="${CC}"
 		ldflags="${CFLAGS_vmlinux}"
-		ldlibs="-lutil -lrt -lpthread"
+		if [ "${UML_HOST_OS}" = "Darwin" ]; then
+			ldlibs=""
+		else
+			ldlibs="-lutil -lrt -lpthread"
+		fi
 	else
 		wl=
 		ld="${LD}"
diff --git a/scripts/mod/file2alias.c b/scripts/mod/file2alias.c
index 4e99393a35f152d7b95a6c1d2a2368dcb58875b1..5820eb1b881a89fedc691ecfdffb0d751c53169c 100644
--- a/scripts/mod/file2alias.c
+++ b/scripts/mod/file2alias.c
@@ -107,6 +107,9 @@ typedef struct {
 	__u8 b[16];
 } guid_t;
 
+#ifdef __APPLE__
+#define uuid_t linux_uuid_t
+#endif
 typedef struct {
 	__u8 b[16];
 } uuid_t;
@@ -122,6 +125,9 @@ typedef struct {
  * even potentially has different endianness and word sizes, since
  * we handle those differences explicitly below */
 #include "../../include/linux/mod_devicetable.h"
+#ifdef __APPLE__
+#undef uuid_t
+#endif
 
 struct devtable {
 	const char *device_id;
