+			if (fault >= 4096 && uml_darwin_guest_range(fault, 1)) {
 				current_mm_force_sync(fault);
 				retry = darwin_uml_vm_retry_fault(fault,
 					FAULT_EXECUTE(registers->faultinfo),
@@ -973,7 +974,7 @@ void userspace(struct uml_pt_regs *registers)
 			}
 			segv(registers->faultinfo, UPT_IP(registers), 1,
 			     registers, NULL);
-			if (fault >= 4096 && fault < 0x600000000000UL) {
+			if (fault >= 4096 && uml_darwin_guest_range(fault, 1)) {
 				int write = FAULT_WRITE(registers->faultinfo);
 
 				if (current_mm_prefault_host_slot(fault, write) < 0)
