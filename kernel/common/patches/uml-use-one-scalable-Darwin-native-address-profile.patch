+++ b/arch/arm64/um/signal.c
@@ -22,7 +22,8 @@ struct uml_arm64_rt_sigframe {
  * Returning there lets the Darwin Mach exception bridge synthesize the
  * rt_sigreturn syscall without requiring an executable guest stack or vDSO.
  */
-#define UML_DARWIN_SIGRETURN_TRAMPOLINE 0x3fffffffff00UL
+#define UML_DARWIN_SIGRETURN_TRAMPOLINE \
+	(UML_DARWIN_TASK_SIZE - 0x100UL)
 #endif
 
 static int save_fpsimd_context(struct sigcontext __user *context,
diff --git a/arch/um/include/asm/processor-generic.h b/arch/um/include/asm/processor-generic.h
index dfcbfa025d624d2498f4f3e4421811f82daea62e..9e9f2c7f127f78532c554ee958d458884077d630 100644
--- a/arch/um/include/asm/processor-generic.h
+++ b/arch/um/include/asm/processor-generic.h
@@ -71,7 +71,7 @@ extern unsigned long stacksizelim;
  * above that host reservation.  Linux still owns the guest virtual address
  * space; the Darwin shadow-MMU maps these addresses into this process.
  */
-#define TASK_UNMAPPED_BASE	(0x100000000000UL)
+#define TASK_UNMAPPED_BASE	(UML_DARWIN_TASK_UNMAPPED_BASE)
 #else
 #define TASK_UNMAPPED_BASE	(0x40000000)
 #endif
diff --git a/arch/um/include/asm/uaccess.h b/arch/um/include/asm/uaccess.h
index 1c6e0ae41b0c5a7251e5ae81bfc57b21f739cec3..b435f1b5c30e8d4aec59db9c353649836bf3173b 100644
--- a/arch/um/include/asm/uaccess.h
+++ b/arch/um/include/asm/uaccess.h
@@ -10,10 +10,20 @@
 #include <asm/elf.h>
 #include <linux/unaligned.h>
 #include <sysdep/faultinfo.h>
+#ifdef UML_HOST_DARWIN
+#include <darwin-address-space.h>
+#endif
 
+#ifdef UML_HOST_DARWIN
+#define __under_task_size(addr, size) \
+	(((unsigned long) (addr) < TASK_SIZE) && \
+	 (((unsigned long) (addr) + (size)) < TASK_SIZE) && \
+	 uml_darwin_guest_range((unsigned long)(addr), (unsigned long)(size)))
+#else
 #define __under_task_size(addr, size) \
 	(((unsigned long) (addr) < TASK_SIZE) && \
 	 (((unsigned long) (addr) + (size)) < TASK_SIZE))
+#endif
 
 #define __access_ok_vsyscall(addr, size) \
 	  (((unsigned long) (addr) >= FIXADDR_USER_START) && \
diff --git a/arch/um/include/shared/darwin-address-space.h b/arch/um/include/shared/darwin-address-space.h
new file mode 100644
index 0000000000000000000000000000000000000000..1fd6bd965bb5ada99d3f51edc4776a2238b300bb
--- /dev/null
+++ b/arch/um/include/shared/darwin-address-space.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_DARWIN_ADDRESS_SPACE_H
+#define __UM_DARWIN_ADDRESS_SPACE_H
+
+extern unsigned long uml_physmem;
+extern unsigned long uml_darwin_native_end;
+
+static inline unsigned long uml_darwin_native_address_start(void)
+{
+	return uml_physmem;
+}
+
+static inline unsigned long uml_darwin_native_address_end(void)
+{
+	return uml_darwin_native_end;
+}
+
+static inline int uml_darwin_guest_range(unsigned long address,
+					 unsigned long length)
+{
+	unsigned long native_start = uml_darwin_native_address_start();
+	unsigned long native_end = uml_darwin_native_address_end();
+	unsigned long end;
+
+	if (address >= UML_DARWIN_GUEST_ADDRESS_LIMIT ||
+	    (address >= native_start &&
+	     address < native_end))
+		return 0;
+	if (length == 0)
+		return 1;
+	if (length > UML_DARWIN_GUEST_ADDRESS_LIMIT - address)
+		return 0;
+	end = address + length;
+	return end <= native_start ||
+		address >= native_end;
+}
+
+#endif
diff --git a/arch/um/kernel/trap.c b/arch/um/kernel/trap.c
index 1e6194ce52e3e8face711622b7b81a0c30b78c6a..31575c43f7e1ffdcfb7070ced4b346324b1d4274 100644
--- a/arch/um/kernel/trap.c
+++ b/arch/um/kernel/trap.c
@@ -18,6 +18,7 @@
 #include <skas.h>
 
 #ifdef UML_HOST_DARWIN
+#include <darwin-address-space.h>
 extern int darwin_uml_vm_retry_fault(unsigned long address, int execute,
 				     int write);
 #endif
@@ -395,7 +396,11 @@ unsigned long segv(struct faultinfo fi, unsigned long ip, int is_user,
 		show_regs(container_of(regs, struct pt_regs, regs));
 		panic("Segfault with no mm");
 	}
-	else if (!is_user && address > PAGE_SIZE && address < TASK_SIZE) {
+	else if (!is_user && address > PAGE_SIZE && address < TASK_SIZE
+#ifdef UML_HOST_DARWIN
+		 && uml_darwin_guest_range(address, 1)
+#endif
+		 ) {
 		show_regs(container_of(regs, struct pt_regs, regs));
 		panic("Kernel tried to access user memory at addr 0x%lx, ip 0x%lx",
 		       address, ip);
diff --git a/arch/um/kernel/um_arch.c b/arch/um/kernel/um_arch.c
index 4e2a98df7e9fa594a93e590c40de5e6e58c34fff..87ab3d9503d22267565e895193a234b672357c3a 100644
--- a/arch/um/kernel/um_arch.c
+++ b/arch/um/kernel/um_arch.c
@@ -125,6 +125,9 @@ const struct seq_operations cpuinfo_op = {
 /* Set in linux_main */
 unsigned long uml_physmem;
 EXPORT_SYMBOL(uml_physmem);
+#ifdef UML_HOST_DARWIN
+unsigned long uml_darwin_native_end = UML_DARWIN_NATIVE_ADDRESS_END;
+#endif
 
 unsigned long uml_reserved; /* Also modified in mem_init */
 unsigned long start_vm;
@@ -298,16 +301,48 @@ static void __init parse_cache_line(char *line)
 	}
 }
 
+#ifdef UML_HOST_DARWIN
+static unsigned long __init darwin_native_auxiliary_size(
+	unsigned long long memory)
+{
+	unsigned long size = PAGE_ALIGN(memory);
+
+	if (size < UML_DARWIN_NATIVE_AUXILIARY_MINIMUM)
+		size = UML_DARWIN_NATIVE_AUXILIARY_MINIMUM;
+	/*
+	 * Capped so RAM plus auxiliary stays inside the signed iOS envelope.
+	 * What vmalloc consumes is bounded by the guest page allocator, not by
+	 * the size of this reservation.
+	 */
+	if (size > UML_DARWIN_NATIVE_AUXILIARY_MAXIMUM)
+		size = UML_DARWIN_NATIVE_AUXILIARY_MAXIMUM;
+	return size;
+}
+#endif
+
 static unsigned long __init get_top_address(char **envp)
 {
 #ifdef UML_HOST_DARWIN
+	unsigned long memory = (physmem_size + PAGE_SIZE - 1) & PAGE_MASK;
+	unsigned long auxiliary = darwin_native_auxiliary_size(memory);
+	unsigned long native_start =
+		(unsigned long)__binary_start & PAGE_MASK;
+
 	/*
-	 * Darwin places the initial pthread stack near 6 GiB, below the linked
-	 * UML kernel.  Use an explicit free high window for kernel vmalloc; guest
-	 * mappings are capped below the kernel separately.
+	 * The host relocates one ET_DYN image into either iOS's low signed window
+	 * or macOS's high native window. Derive the kernel top from that runtime
+	 * base and the same RAM-scaled auxiliary rule instead of baking either
+	 * platform's host ceiling into the shared image.
 	 */
 	(void)envp;
-	return 0x700000000000UL;
+	if (native_start >= UML_DARWIN_GUEST_ADDRESS_LIMIT ||
+	    memory > UML_DARWIN_GUEST_ADDRESS_LIMIT - native_start ||
+	    auxiliary > UML_DARWIN_GUEST_ADDRESS_LIMIT - native_start - memory) {
+		os_warn("Darwin native window exceeds guest address limit\n");
+		exit(1);
+	}
+	uml_darwin_native_end = native_start + memory + auxiliary;
+	return uml_darwin_native_end;
 #else
 	unsigned long top_addr = (unsigned long) &top_addr;
 	int i;
@@ -329,6 +364,9 @@ int __init linux_main(int argc, char **argv, char **envp)
 {
 	unsigned long avail, diff;
 	unsigned long virtmem_size, max_physmem;
+#ifdef UML_HOST_DARWIN
+	unsigned long auxiliary_size;
+#endif
 	unsigned long stack;
 	unsigned int i;
 	int add;
@@ -355,15 +393,16 @@ int __init linux_main(int argc, char **argv, char **envp)
 	/* Limit TASK_SIZE to what is addressable by the page table */
 	task_size = host_task_size;
 #ifdef UML_HOST_DARWIN
-	/* Keep every same-process guest mapping below the kernel ELF window. */
-	task_size = 0x400000000000UL;
+	/* The Darwin software MMU can place guest mappings on both sides of the
+	 * compact native kernel window shared by every Apple product. */
+	task_size = UML_DARWIN_TASK_SIZE;
 #endif
 	if (task_size > (unsigned long long) PTRS_PER_PGD * PGDIR_SIZE)
 		task_size = PTRS_PER_PGD * PGDIR_SIZE;
 
-	/*
-	 * TASK_SIZE needs to be PGDIR_SIZE aligned or else exit_mmap craps
-	 * out
+	/* Keep the task boundary on a whole PGD.  The compact Darwin native
+	 * window is a hole inside the first guest PGD span, not the end of the
+	 * sparse software-MMU address space.
 	 */
 	task_size = task_size & PGDIR_MASK;
 
@@ -422,9 +461,20 @@ int __init linux_main(int argc, char **argv, char **envp)
 	avail = stack - start_vm;
 #ifdef UML_HOST_DARWIN
 	avail = host_task_size - start_vm;
-#endif
+	auxiliary_size = darwin_native_auxiliary_size(physmem_size);
+	if (avail > auxiliary_size)
+		avail = auxiliary_size;
+	/*
+	 * vmalloc owns the whole auxiliary window rather than only as much of
+	 * it as there is RAM. Clamping to physmem_size would leave the tail of
+	 * the window past end_vm, where the kernel fault handler no longer
+	 * recognises a vmalloc address.
+	 */
+	virtmem_size = avail;
+#else
 	if (physmem_size > avail)
 		virtmem_size = avail;
+#endif
 	end_vm = start_vm + virtmem_size;
 
 	if (virtmem_size < physmem_size)
