 arch/arm64/um/asm/elf.h                     |   4 +-
 arch/arm64/um/asm/processor.h               |   8 +
 arch/arm64/um/ptrace.c                      |  26 +-
 arch/arm64/um/registers.c                   |  13 +-
 arch/arm64/um/shared/sysdep/sme.h           |  28 +-
 arch/arm64/um/signal.c                      |   6 +-
 arch/arm64/um/sme.c                         |  20 +-
 arch/arm64/um/sme.h                         |  43 ++-
 arch/arm64/um/sme_signal.c                  | 123 +++++++--
 arch/arm64/um/sve.c                         | 282 ++++++++++++++++++++
 arch/um/os-Darwin/skas/process.c            |  17 ++
 arch/um/os-Darwin/uml_darwin_abi.h          |  38 ++-
 arch/um/os-Darwin/uml_darwin_abi_identity.h |   4 +-
 arch/um/os-Darwin/uml_darwin_cpu.h          |   4 +
