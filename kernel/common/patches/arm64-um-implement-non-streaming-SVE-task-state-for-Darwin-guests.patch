 create mode 100644 arch/arm64/um/sve.c

diff --git a/arch/arm64/um/Kconfig b/arch/arm64/um/Kconfig
index 3f5956ef66d2146c3d29243eb3194eda227cdae2..a1bc989a4b1f5e02f21dbc2b8525f19b8472c48a 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -22,8 +22,8 @@ config UML_ARM64
 	select ARCH_USE_QUEUED_RWLOCKS
 	select UML_SUBARCH_SUPPORTS_SMP
 
-# Every arm64 task carries SME registers in its Darwin bridge tail, and gets
-# SME task state when the host implements SME for the run.
+# Every arm64 task carries SME and SVE registers in its Darwin bridge tail, and
+# gets SME and SVE task state when the host implements them for the run.
 config UML_ARM64_SME
 	def_bool y
 
diff --git a/arch/arm64/um/Makefile b/arch/arm64/um/Makefile
index 8fb8cd5c5933244bf3a8889ff565b177da73d682..c805aee161a3fd5e8415064fa34445b0134ca3a4 100644
--- a/arch/arm64/um/Makefile
+++ b/arch/arm64/um/Makefile
@@ -2,7 +2,7 @@
 
 obj-y := bugs.o delay.o fault.o mem.o ptrace.o registers.o setjmp.o \
 	signal.o subarch.o syscall_table.o syscalls.o sysrq.o tls.o
-obj-$(CONFIG_UML_ARM64_SME) += sme.o sme_signal.o
+obj-$(CONFIG_UML_ARM64_SME) += sme.o sme_signal.o sve.o
 
 $(obj)/user-offsets.s: c_flags = -Wp,-MD,$(depfile) $(USER_CFLAGS)
 targets += user-offsets.s
diff --git a/arch/arm64/um/asm/elf.h b/arch/arm64/um/asm/elf.h
index 0a1ed25d8ee34401c84f359b868b25654df5ebc7..de061e2d957d4e3d9a875efe11504d5e91539348 100644
--- a/arch/arm64/um/asm/elf.h
+++ b/arch/arm64/um/asm/elf.h
@@ -86,8 +86,8 @@ typedef struct uml_arm64_fpsimd_state elf_fpregset_t;
 
 #ifdef CONFIG_UML_ARM64_SME
 /*
- * With SME, AT_MINSIGSTKSZ gives the stack the largest signal frame needs,
- * as on native arm64; without it the vector stays as it was.
+ * With SVE or SME, AT_MINSIGSTKSZ gives the stack the largest signal frame
+ * needs, as on native arm64; without them the vector stays as it was.
  */
 extern unsigned long uml_arm64_minsigstksz;
 #define ARCH_DLINFO do { \
diff --git a/arch/arm64/um/asm/processor.h b/arch/arm64/um/asm/processor.h
index c2b6adefd7bb47d9d13846bc2fe51664c6e0f067..2c22cebbdd40e3be84943d8c6328e7b0ea95db0c 100644
--- a/arch/arm64/um/asm/processor.h
+++ b/arch/arm64/um/asm/processor.h
@@ -14,6 +14,8 @@ struct arch_thread {
 #ifdef CONFIG_UML_ARM64_SME
 	/* PR_SME_VL_INHERIT, which survives exec. */
 	bool sme_vl_inherit;
+	/* PR_SVE_VL_INHERIT, likewise. */
+	bool sve_vl_inherit;
 #endif
 };
 
@@ -31,6 +33,7 @@ static inline void arch_copy_thread(struct arch_thread *from,
 	to->tpidr_el0 = from->tpidr_el0;
 #ifdef CONFIG_UML_ARM64_SME
 	to->sme_vl_inherit = from->sme_vl_inherit;
+	to->sve_vl_inherit = from->sve_vl_inherit;
 #endif
 }
 
@@ -46,6 +49,11 @@ extern int uml_arm64_sme_set_current_vl(unsigned long arg);
 extern int uml_arm64_sme_get_current_vl(void);
 #define SME_SET_VL(arg) uml_arm64_sme_set_current_vl(arg)
 #define SME_GET_VL() uml_arm64_sme_get_current_vl()
+/* Non-streaming SVE task state (arch/arm64/um/sve.c). */
+extern int uml_arm64_sve_set_current_vl(unsigned long arg);
+extern int uml_arm64_sve_get_current_vl(void);
+#define SVE_SET_VL(arg) uml_arm64_sve_set_current_vl(arg)
+#define SVE_GET_VL() uml_arm64_sve_get_current_vl()
 #endif
 
 #define current_sp() ({ void *sp; asm("mov %0, sp" : "=r"(sp)); sp; })
diff --git a/arch/arm64/um/ptrace.c b/arch/arm64/um/ptrace.c
index 5d374351c1acc2483eb6b3ff26e5f9b082ef59bd..f3c84c5601b35da9972114bca5cd9e2ad06ca2d3 100644
--- a/arch/arm64/um/ptrace.c
+++ b/arch/arm64/um/ptrace.c
@@ -13,9 +13,11 @@
 #endif
 #include "sme.h"
 
-/* Native arm64's third regset, after the two asm/ptrace.h names. */
+/* Native arm64's third regset, after the two asm/ptrace.h names, then
+ * NT_ARM_SVE, which a view has only with SVE or SME. */
 enum {
 	REGSET_TLS = REGSET_FP + 1,
+	REGSET_SVE,
 };
 
 static int register_index(int regno)
@@ -203,7 +205,18 @@ static const struct user_regset uml_arm64_regsets[] = {
 		.set = tls_set,
 	},
 #ifdef CONFIG_UML_ARM64_SME
-	/* Only the SME view below has these, as native arm64 with SME. */
+	/* Only the vector views below have these, as native arm64 with SVE,
+	 * and with SME the ones after NT_ARM_SVE, which then fails without
+	 * SVE as natively. */
+	[REGSET_SVE] = {
+		USER_REGSET_NOTE_TYPE(ARM_SVE),
+		.n = DIV_ROUND_UP(SVE_PT_SIZE(UML_ARM64_SVE_VQ,
+					      SVE_PT_REGS_SVE), SVE_VQ_BYTES),
+		.size = SVE_VQ_BYTES,
+		.align = SVE_VQ_BYTES,
+		.regset_get = uml_arm64_sve_get,
+		.set = uml_arm64_sve_set,
+	},
 	{
 		USER_REGSET_NOTE_TYPE(ARM_SSVE),
 		.n = DIV_ROUND_UP(SVE_PT_SIZE(UML_ARM64_SME_VQ_MAX,
@@ -243,6 +256,13 @@ static const struct user_regset_view uml_arm64_view = {
 };
 
 #ifdef CONFIG_UML_ARM64_SME
+static const struct user_regset_view uml_arm64_sve_view = {
+	.name = "aarch64",
+	.e_machine = EM_AARCH64,
+	.regsets = uml_arm64_regsets,
+	.n = REGSET_SVE + 1,
+};
+
 static const struct user_regset_view uml_arm64_sme_view = {
 	.name = "aarch64",
 	.e_machine = EM_AARCH64,
@@ -257,6 +277,8 @@ task_user_regset_view(struct task_struct *task)
 #ifdef CONFIG_UML_ARM64_SME
 	if (uml_arm64_sme_vl)
 		return &uml_arm64_sme_view;
+	if (uml_arm64_sve_vl)
+		return &uml_arm64_sve_view;
 #endif
 	return &uml_arm64_view;
 }
diff --git a/arch/arm64/um/registers.c b/arch/arm64/um/registers.c
index 44e138e7e5bc31175eddfcf186e245d8562c4b1c..023cfd4127aef8cc8f641de6147d21a9b8811b8f 100644
--- a/arch/arm64/um/registers.c
+++ b/arch/arm64/um/registers.c
@@ -5,9 +5,10 @@
 #include <longjmp.h>
 #include <registers.h>
 #include <sysdep/sme.h>
+#include "sme.h"
 
 /* The register tail every task hands the Darwin host: an arm64 task's FP
- * registers and SME registers. */
+ * registers, SME registers and SVE registers. */
 #ifdef CONFIG_UML_ARM64_SME
 #define UML_ARM64_HOST_FP_SIZE UML_ARM64_TASK_TAIL_SIZE
 #else
@@ -36,8 +37,14 @@ int put_fp_registers(int pid, unsigned long *regs)
 void get_safe_registers(unsigned long *regs, unsigned long *fp_regs)
 {
 	memset(regs, 0, UM_FRAME_SIZE);
-	if (fp_regs)
-		memset(fp_regs, 0, host_fp_size);
+	if (!fp_regs)
+		return;
+	memset(fp_regs, 0, host_fp_size);
+#ifdef CONFIG_UML_ARM64_SME
+	/* Every tail, which exec starts and fork copies, names the run's SVE
+	 * vector length. */
+	UML_ARM64_SVE_REGISTERS(fp_regs)->vl = uml_arm64_sve_vl;
+#endif
 }
 
 int init_pid_registers(int pid)
diff --git a/arch/arm64/um/shared/sysdep/sme.h b/arch/arm64/um/shared/sysdep/sme.h
index 3fa29f90482f77da5dff90423328b3b36bb45855..f6589399c40861c1cb37a09165ecddc8e871b925 100644
--- a/arch/arm64/um/shared/sysdep/sme.h
+++ b/arch/arm64/um/shared/sysdep/sme.h
@@ -6,7 +6,8 @@
  * Every arm64 task's Darwin bridge tail holds its SME registers right after
  * its 528-byte FP registers, whether or not the host implements SME for the
  * run (struct darwin_uml_guest_sme_registers).  The Darwin side checks this
- * mirror against the bridge header, which the kernel side cannot include.
+ * mirror, and the SVE one below, against the bridge header, which the kernel
+ * side cannot include.
  */
 struct uml_arm64_sme_registers {
 	unsigned long long tpidr2;
@@ -16,11 +17,33 @@ struct uml_arm64_sme_registers {
 	unsigned int reserved;
 };
 
+/*
+ * Then its non-streaming SVE registers (struct darwin_uml_guest_sve_registers)
+ * at the 16-byte vector length: P0-P15 and FFR, 16 bits each, bit k governing
+ * byte k, which is their layout in a signal frame and in NT_ARM_SVE.  They are
+ * the task's state only while UML_ARM64_SVE_LIVE is set, the image of native
+ * TIF_SVE: the host sets it when the task executes SVE outside streaming mode
+ * and the kernel clears it where native Linux discards the state.  vl is the
+ * run's vector length, or 0 without SVE.
+ */
+struct uml_arm64_sve_registers {
+	unsigned short p[16];
+	unsigned short ffr;
+	unsigned short flags;
+	unsigned int vl;
+};
+
+#define UML_ARM64_SVE_LIVE 0x1U
+
 #define UML_ARM64_FP_REGISTERS_SIZE 528
-#define UML_ARM64_TASK_TAIL_SIZE \
+#define UML_ARM64_SVE_REGISTERS_OFFSET \
 	(UML_ARM64_FP_REGISTERS_SIZE + sizeof(struct uml_arm64_sme_registers))
+#define UML_ARM64_TASK_TAIL_SIZE \
+	(UML_ARM64_SVE_REGISTERS_OFFSET + sizeof(struct uml_arm64_sve_registers))
 #define UML_ARM64_SME_REGISTERS(fp) ((struct uml_arm64_sme_registers *) \
 	((char *)(fp) + UML_ARM64_FP_REGISTERS_SIZE))
+#define UML_ARM64_SVE_REGISTERS(fp) ((struct uml_arm64_sve_registers *) \
+	((char *)(fp) + UML_ARM64_SVE_REGISTERS_OFFSET))
 
 /*
  * The storage holds Z0-Z31, P0-P15, ZA as svl horizontal vectors, then ZT0,
@@ -42,5 +65,6 @@ struct uml_arm64_sme_registers {
 /* Kernel entry points of the Darwin user-mode return path. */
 extern void uml_arm64_sme_syscall_enter(void);
 extern int uml_arm64_sme_access(void);
+extern void uml_arm64_sve_syscall_enter(void);
 
 #endif
diff --git a/arch/arm64/um/signal.c b/arch/arm64/um/signal.c
index 134007a2cbb6bf0b2c6c035d67d0f17681fb97d2..291efec44e2f99f3b8ab7db1813fbfbdf6d93d40 100644
--- a/arch/arm64/um/signal.c
+++ b/arch/arm64/um/signal.c
@@ -151,7 +151,7 @@ static int restore_mcontext(struct pt_regs *regs,
 	error |= get_user(PT_REGS_PSTATE(regs), &context->pstate);
 	if (!error && !uml_arm64_valid_user_pstate(&PT_REGS_PSTATE(regs)))
 		error = -EINVAL;
-	if (!error && uml_arm64_sme_vl)
+	if (!error && uml_arm64_vector_sigframes())
 		error = uml_arm64_sme_restore_sigframe(regs, (void __user *)
 			((char __user *)context -
 			 offsetof(struct uml_arm64_rt_sigframe, uc.uc_mcontext)));
@@ -170,7 +170,7 @@ int setup_signal_stack_si(unsigned long stack_top, struct ksignal *ksig,
 	unsigned long restorer;
 	int error = 0;
 
-	if (uml_arm64_sme_vl) {
+	if (uml_arm64_vector_sigframes()) {
 		long size = uml_arm64_sme_sigframe_size();
 
 		if (size < 0)
@@ -193,7 +193,7 @@ int setup_signal_stack_si(unsigned long stack_top, struct ksignal *ksig,
 	error |= save_mcontext(&frame->uc.uc_mcontext, regs);
 	if (ksig->ka.sa.sa_flags & SA_SIGINFO)
 		error |= copy_siginfo_to_user(&frame->info, &ksig->info);
-	if (!error && uml_arm64_sme_vl)
+	if (!error && uml_arm64_vector_sigframes())
 		error = uml_arm64_sme_save_sigframe(frame, regs);
 	if (error)
 		return error;
diff --git a/arch/arm64/um/sme.c b/arch/arm64/um/sme.c
index 504106fdc83d43ba5edfdad818f210eba6cd7969..953f7811bcbe18edd84c2b222386baffc3991502 100644
--- a/arch/arm64/um/sme.c
+++ b/arch/arm64/um/sme.c
@@ -90,7 +90,8 @@ static void sme_free(struct task_struct *task)
 /*
  * Native task_smstop_sm(): leaving streaming mode zeroes every vector
  * register and sets FPSR as ResetSVEState() does.  Z and P become dead, so
- * the storage keeps whatever it held.
+ * the storage keeps whatever it held.  The state is left in FPSIMD form, so
+ * the task stops tracking non-streaming SVE state too.
  */
 void uml_arm64_task_smstop_sm(struct task_struct *task)
 {
@@ -101,6 +102,7 @@ void uml_arm64_task_smstop_sm(struct task_struct *task)
 	memset(fp->vregs, 0, sizeof(fp->vregs));
 	fp->fpsr = 0x0800009f;
 	*uml_arm64_svcr(task) &= ~UML_ARM64_SVCR_SM;
+	uml_arm64_sve_discard(task);
 }
 
 /*
@@ -143,8 +145,10 @@ void uml_arm64_sme_dup_task(struct task_struct *dst)
 
 /*
  * copy_thread() for a user task, after it copied the parent's registers:
- * the child starts outside streaming mode with ZA off, as native
- * arch_dup_task_struct() leaves it.  A child with its own mm then inherits
+ * the child starts outside streaming mode with ZA off and its SVE state in
+ * FPSIMD form, as native arch_dup_task_struct() leaves it; the parent's
+ * system call has already discarded the parent's own unless a tracer wrote
+ * it since.  A child with its own mm then inherits
  * TPIDR2 and a copy of live ZA and ZT0, as copy_thread_za() gives it,
  * because a lazily saved ZA may be dormant behind TPIDR2.  A child sharing
  * the mm must not inherit TPIDR2, whose save block is on another task's
@@ -156,6 +160,7 @@ int uml_arm64_sme_copy_thread(struct task_struct *p, unsigned long clone_flags)
 	void *state;
 
 	uml_arm64_sme_dup_task(p);
+	uml_arm64_sve_discard(p);
 	if (!uml_arm64_sme_vl)
 		return 0;
 	uml_arm64_task_smstop_sm(p);
@@ -274,9 +279,9 @@ core_initcall(sme_sysctl_init);
 #endif
 
 /*
- * Regsets (native ptrace.c).  There is no NT_ARM_SVE: without non-streaming
- * SVE the streaming registers are NT_ARM_SSVE, present while SM is set.
- * NT_ARM_TLS, which every task has, is in ptrace.c.
+ * Regsets (native ptrace.c).  The streaming registers are NT_ARM_SSVE,
+ * present while SM is set.  NT_ARM_SVE is in sve.c and NT_ARM_TLS, which
+ * every task has, in ptrace.c.
  */
 
 static unsigned int sme_vq(void)
@@ -326,7 +331,7 @@ int uml_arm64_ssve_get(struct task_struct *target,
 /*
  * Native sve_set_common() for ARM64_VEC_SME: the task enters streaming mode
  * with zeroed Z, P, V, FPSR and FPCR, then takes what the tracer supplies;
- * ZA is kept.
+ * ZA is kept, and the non-streaming P and FFR become zero.
  */
 int uml_arm64_ssve_set(struct task_struct *target,
 		       const struct user_regset *regset, unsigned int pos,
@@ -361,6 +366,7 @@ int uml_arm64_ssve_set(struct task_struct *target,
 	memset(state, 0, UML_ARM64_SME_ZA_OFFSET(vl, 0));
 	*uml_arm64_svcr(target) |= UML_ARM64_SVCR_SM;
 	memset(fp, 0, sizeof(*fp));
+	uml_arm64_sve_zero_predicates(target);
 	if (count && vq != sve_vq_from_vl(header.vl))
 		return -EIO;
 	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf, state,
diff --git a/arch/arm64/um/sme.h b/arch/arm64/um/sme.h
index 5e600a5b46d72c7c8e680c8d2aa8f08b5baeeb1a..643eb95babe0a415e484322641e3ae1e9f55c582 100644
--- a/arch/arm64/um/sme.h
+++ b/arch/arm64/um/sme.h
@@ -9,6 +9,9 @@
 /* The largest streaming vector length an SME CPU can have, in quadwords. */
 #define UML_ARM64_SME_VQ_MAX 16
 
+/* The non-streaming SVE vector length of a Darwin guest, in quadwords. */
+#define UML_ARM64_SVE_VQ 1
+
 #ifdef CONFIG_UML_ARM64_SME
 /*
  * The streaming vector length in bytes when the Darwin host implements SME
@@ -18,11 +21,27 @@
 extern unsigned int uml_arm64_sme_vl;
 /* Whether the virtual CPU implements SME2, and with it ZT0. */
 extern bool uml_arm64_sme2;
+/*
+ * The non-streaming SVE vector length in bytes, 16, when the Darwin host
+ * implements SVE for this run, else 0 (sve.c).  Every SVE duty of the kernel
+ * is active only while it is non-zero.
+ */
+extern unsigned int uml_arm64_sve_vl;
 #else
 #define uml_arm64_sme_vl 0U
 #define uml_arm64_sme2 false
+#define uml_arm64_sve_vl 0U
 #endif
 
+/*
+ * With SVE or SME, signal frames take native arm64's layout with an
+ * sve_context record (sme_signal.c); otherwise they hold only fpsimd_context.
+ */
+static inline bool uml_arm64_vector_sigframes(void)
+{
+	return uml_arm64_sve_vl || uml_arm64_sme_vl;
+}
+
 static inline elf_fpregset_t *uml_arm64_fp_registers(struct task_struct *task)
 {
 	return (elf_fpregset_t *)task->thread.regs.regs.fp;
@@ -45,6 +64,18 @@ static inline unsigned long *uml_arm64_svcr(struct task_struct *task)
 	return &task->thread.regs.regs.svcr;
 }
 
+static inline struct uml_arm64_sve_registers *
+uml_arm64_sve_registers(struct task_struct *task)
+{
+	return UML_ARM64_SVE_REGISTERS(task->thread.regs.regs.fp);
+}
+
+/* Native TIF_SVE: P0-P15 and FFR are part of the task's state. */
+static inline bool uml_arm64_sve_live(struct task_struct *task)
+{
+	return uml_arm64_sve_registers(task)->flags & UML_ARM64_SVE_LIVE;
+}
+
 struct membuf;
 struct pt_regs;
 struct uml_arm64_rt_sigframe;
@@ -54,6 +85,8 @@ int uml_arm64_sme_alloc(struct task_struct *task);
 void uml_arm64_task_smstop_sm(struct task_struct *task);
 int uml_arm64_sme_set_vector_length(struct task_struct *task, unsigned long vl,
 				    unsigned long flags);
+void uml_arm64_sve_discard(struct task_struct *task);
+void uml_arm64_sve_zero_predicates(struct task_struct *task);
 
 #define UML_ARM64_SME_REGSET_OPS(name) \
 int uml_arm64_##name##_get(struct task_struct *target, \
@@ -63,16 +96,18 @@ int uml_arm64_##name##_set(struct task_struct *target, \
 			   const struct user_regset *regset, \
 			   unsigned int pos, unsigned int count, \
 			   const void *kbuf, const void __user *ubuf)
+UML_ARM64_SME_REGSET_OPS(sve);
 UML_ARM64_SME_REGSET_OPS(ssve);
 UML_ARM64_SME_REGSET_OPS(za);
 UML_ARM64_SME_REGSET_OPS(zt);
