diff --git a/arch/arm64/um/sve.c b/arch/arm64/um/sve.c
new file mode 100644
index 0000000000000000000000000000000000000000..9ba82f294fa62deef4ffa9dc856ca2f0aa31be3e
--- /dev/null
+++ b/arch/arm64/um/sve.c
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Non-streaming SVE task state for Darwin guests.
+ *
+ * When the Darwin host implements SVE for the run,
+ * darwin_uml_guest_sve_vector_length() reports its vector length (VL), 16
+ * bytes on every host, and the kernel gives each task what
+ * arch/arm64/kernel/fpsimd.c gives it on a CPU whose only supported SVE
+ * vector length is that VL.  Otherwise every function here leaves the task
+ * alone and the kernel behaves as one without SVE.
+ *
+ * At this VL each Z register is the V register of the task's FP registers,
+ * so the state SVE adds is P0-P15 and FFR, which live in the SVE registers of
+ * the task's bridge tail with a live flag, the image of native TIF_SVE.  The
+ * host sets the flag when the task executes SVE outside streaming mode and
+ * moves P and FFR across each entry only while it is set; a task that is not
+ * live finds them zero when it next executes SVE, as native do_sve_acc()
+ * leaves them.  The kernel clears the flag where native Linux stops tracking
+ * the state: a system call, a sigreturn or tracer write without SVE data,
+ * leaving streaming mode on the task's behalf, fork and exec.
+ */
+
+#include <linux/init.h>
+#include <linux/prctl.h>
+#include <linux/regset.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+#include <linux/sysctl.h>
+#include <asm/elf.h>
+#include <asm/processor.h>
+#include <asm/sigcontext.h>
+#include <uapi/asm/ptrace.h>
+#include "sme.h"
+
+unsigned int uml_arm64_sve_vl __ro_after_init;
+
+#ifdef UML_HOST_DARWIN
+extern unsigned long darwin_uml_guest_sve_vector_length(void);
+#define sve_host_vector_length() darwin_uml_guest_sve_vector_length()
+#else
+#define sve_host_vector_length() 0UL
+#endif
+
+static int __init uml_arm64_sve_init(void)
+{
+	unsigned long vl = sve_host_vector_length();
+
+	BUILD_BUG_ON(sizeof(struct uml_arm64_sve_registers) != 40);
+	BUILD_BUG_ON(sizeof(((struct uml_arm64_sve_registers *)NULL)->p[0]) !=
+		     SVE_SIG_PREG_SIZE(UML_ARM64_SVE_VQ));
+	BUILD_BUG_ON(sizeof(((elf_fpregset_t *)NULL)->vregs[0]) !=
+		     SVE_SIG_ZREG_SIZE(UML_ARM64_SVE_VQ));
+	BUILD_BUG_ON(sizeof(elf_fpregset_t) !=
+		     SVE_PT_FPSIMD_SIZE(UML_ARM64_SVE_VQ, SVE_PT_REGS_FPSIMD));
+	if (!vl)
+		return 0;
+	if (WARN(vl != UML_ARM64_SVE_VQ * SVE_VQ_BYTES,
+		 "Darwin: unsupported SVE vector length %lu\n", vl))
+		return 0;
+	uml_arm64_sve_vl = vl;
+	return 0;
+}
+early_initcall(uml_arm64_sve_init);
+
+/* P0-P15 and FFR become zero, and the live flag stays. */
+void uml_arm64_sve_zero_predicates(struct task_struct *task)
+{
+	struct uml_arm64_sve_registers *sve = uml_arm64_sve_registers(task);
+
+	memset(sve->p, 0, sizeof(sve->p));
+	sve->ffr = 0;
+}
+
+/*
+ * The task stops tracking SVE state until its next SVE instruction, as when
+ * native Linux saves it in FPSIMD form and clears TIF_SVE.
+ */
+void uml_arm64_sve_discard(struct task_struct *task)
+{
+	uml_arm64_sve_zero_predicates(task);
+	uml_arm64_sve_registers(task)->flags &= ~UML_ARM64_SVE_LIVE;
+}
+
+/*
+ * A system call discards P0-P15 and FFR (sve.rst, section 3), as native
+ * fpsimd_syscall_enter() does, before a tracer's syscall-entry stop can look
+ * at the task.  The host calls this only for a live task.
+ */
+void uml_arm64_sve_syscall_enter(void)
+{
+	uml_arm64_sve_discard(current);
+}
+
+/*
+ * vec_set_vector_length() for a CPU with one supported length: every valid
+ * length resolves to the VL, as find_supported_vector_length() resolves it,
+ * so the live length never changes and an exec-time length always equals
+ * it.  What remains is the inherit flag.
+ */
+static int sve_set_vector_length(struct task_struct *task, unsigned long vl,
+				 unsigned long flags)
+{
+	if (flags & ~(unsigned long)(PR_SVE_VL_INHERIT | PR_SVE_SET_VL_ONEXEC))
+		return -EINVAL;
+	if (!sve_vl_valid(vl))
+		return -EINVAL;
+	task->thread.arch.sve_vl_inherit = !!(flags & PR_SVE_VL_INHERIT);
+	return 0;
+}
+
+static int sve_prctl_status(void)
+{
+	int status = uml_arm64_sve_vl;
+
+	if (current->thread.arch.sve_vl_inherit)
+		status |= PR_SVE_VL_INHERIT;
+	return status;
+}
+
+/* PR_SVE_SET_VL */
+int uml_arm64_sve_set_current_vl(unsigned long arg)
+{
+	unsigned long vl = arg & PR_SVE_VL_LEN_MASK;
+	int error;
+
+	if (!uml_arm64_sve_vl)
+		return -EINVAL;
+	error = sve_set_vector_length(current, vl, arg & ~vl);
+	return error ?: sve_prctl_status();
+}
+
+/* PR_SVE_GET_VL */
+int uml_arm64_sve_get_current_vl(void)
+{
+	return uml_arm64_sve_vl ? sve_prctl_status() : -EINVAL;
+}
+
+#ifdef CONFIG_SYSCTL
+/* /proc/sys/abi/sve_default_vector_length reads the VL and accepts, with no
+ * effect, any valid length or -1, which natively select the VL too. */
+static int sve_proc_do_default_vl(const struct ctl_table *table, int write,
+				  void *buffer, size_t *lenp, loff_t *ppos)
+{
+	int vl = uml_arm64_sve_vl;
+	struct ctl_table value = {
+		.data = &vl,
+		.maxlen = sizeof(vl),
+	};
+	int error = proc_dointvec(&value, write, buffer, lenp, ppos);
+
+	if (error || !write || vl == -1)
+		return error;
+	return sve_vl_valid(vl) ? 0 : -EINVAL;
+}
+
+static const struct ctl_table sve_default_vl_table[] = {
+	{
+		.procname = "sve_default_vector_length",
+		.mode = 0644,
+		.proc_handler = sve_proc_do_default_vl,
+	},
+};
+
+static int __init sve_sysctl_init(void)
+{
+	if (uml_arm64_sve_vl && !register_sysctl("abi", sve_default_vl_table))
+		return -EINVAL;
+	return 0;
+}
+core_initcall(sve_sysctl_init);
+#endif
+
+/*
+ * NT_ARM_SVE (native sve_get_common() for ARM64_VEC_SVE).  In streaming mode
+ * there is only the header; otherwise SVE data while the task is live and
+ * the FPSIMD registers while it is not.
+ */
+int uml_arm64_sve_get(struct task_struct *target,
+		      const struct user_regset *regset, struct membuf to)
+{
+	const elf_fpregset_t *fp = uml_arm64_fp_registers(target);
+	const struct uml_arm64_sve_registers *sve =
+		uml_arm64_sve_registers(target);
+	const unsigned int vq = UML_ARM64_SVE_VQ;
+	bool active = !(*uml_arm64_svcr(target) & UML_ARM64_SVCR_SM);
+	bool live = active && uml_arm64_sve_live(target);
+	struct user_sve_header header = {
+		.vl = uml_arm64_sve_vl,
+		.max_vl = uml_arm64_sve_vl,
+		.flags = live ? SVE_PT_REGS_SVE : SVE_PT_REGS_FPSIMD,
+		.max_size = SVE_PT_SIZE(vq, SVE_PT_REGS_SVE),
+	};
+
+	if (!uml_arm64_sve_vl)
+		return -EINVAL;
+	if (target->thread.arch.sve_vl_inherit)
+		header.flags |= SVE_PT_VL_INHERIT;
+	header.size = active ? SVE_PT_SIZE(vq, header.flags) : sizeof(header);
+	membuf_write(&to, &header, sizeof(header));
+	if (!active)
+		return to.left;
+	/* struct user_fpsimd_state, as NT_PRFPREG gives it. */
+	if (!live)
+		return membuf_write(&to, fp, sizeof(*fp));
+	/* At this VL each Z is its V. */
+	membuf_write(&to, fp->vregs, sizeof(fp->vregs));
+	membuf_write(&to, sve->p, sizeof(sve->p));
+	membuf_write(&to, &sve->ffr, sizeof(sve->ffr));
+	membuf_zero(&to, SVE_PT_SVE_FPSR_OFFSET(vq) -
+		    (SVE_PT_SVE_FFR_OFFSET(vq) + SVE_PT_SVE_FFR_SIZE(vq)));
+	membuf_write(&to, &fp->fpsr, sizeof(fp->fpsr));
+	membuf_write(&to, &fp->fpcr, sizeof(fp->fpcr));
+	return membuf_zero(&to, ALIGN(header.size, SVE_VQ_BYTES) -
+			   (SVE_PT_SVE_FPCR_OFFSET(vq) + SVE_PT_SVE_FPCR_SIZE));
+}
+
+/*
+ * Native sve_set_common() for ARM64_VEC_SVE: the task leaves streaming mode
+ * and starts from zeroed V, FPSR and FPCR, then takes what the tracer
+ * supplies; FPSIMD data leaves it not live, and SVE data, or none, makes it
+ * live with zeroed P and FFR before the tracer's.  ZA is kept.
+ */
+int uml_arm64_sve_set(struct task_struct *target,
+		      const struct user_regset *regset, unsigned int pos,
+		      unsigned int count, const void *kbuf,
+		      const void __user *ubuf)
+{
+	elf_fpregset_t *fp = uml_arm64_fp_registers(target);
+	struct uml_arm64_sve_registers *sve = uml_arm64_sve_registers(target);
+	const unsigned int vq = UML_ARM64_SVE_VQ;
+	struct user_sve_header header;
+	int error;
+
+	if (!uml_arm64_sve_vl)
+		return -EINVAL;
+	if (count < sizeof(header))
+		return -EINVAL;
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf, &header, 0,
+				   sizeof(header));
+	if (error)
+		return error;
+	error = sve_set_vector_length(target, header.vl,
+		((unsigned long)header.flags & ~SVE_PT_REGS_MASK) << 16);
+	if (error)
+		return error;
+
+	*uml_arm64_svcr(target) &= ~UML_ARM64_SVCR_SM;
+	memset(fp, 0, sizeof(*fp));
+	uml_arm64_sve_zero_predicates(target);
+	if ((header.flags & SVE_PT_REGS_MASK) == SVE_PT_REGS_FPSIMD) {
+		sve->flags &= ~UML_ARM64_SVE_LIVE;
+		return user_regset_copyin(&pos, &count, &kbuf, &ubuf, fp,
+					  SVE_PT_FPSIMD_OFFSET,
+					  SVE_PT_FPSIMD_OFFSET + sizeof(*fp));
+	}
+
+	sve->flags |= UML_ARM64_SVE_LIVE;
+	if (count && sve_vq_from_vl(header.vl) != vq)
+		return -EIO;
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf, fp->vregs,
+				   SVE_PT_SVE_ZREGS_OFFSET,
+				   SVE_PT_SVE_PREGS_OFFSET(vq));
+	if (!error)
+		error = user_regset_copyin(&pos, &count, &kbuf, &ubuf, sve->p,
+					   SVE_PT_SVE_PREGS_OFFSET(vq),
+					   SVE_PT_SVE_FFR_OFFSET(vq));
+	if (!error)
+		error = user_regset_copyin(&pos, &count, &kbuf, &ubuf, &sve->ffr,
+					   SVE_PT_SVE_FFR_OFFSET(vq),
+					   SVE_PT_SVE_FFR_OFFSET(vq) +
+					   SVE_PT_SVE_FFR_SIZE(vq));
+	if (error)
+		return error;
+	user_regset_copyin_ignore(&pos, &count, &kbuf, &ubuf,
+				  SVE_PT_SVE_FFR_OFFSET(vq) +
+				  SVE_PT_SVE_FFR_SIZE(vq),
+				  SVE_PT_SVE_FPSR_OFFSET(vq));
+	return user_regset_copyin(&pos, &count, &kbuf, &ubuf, &fp->fpsr,
+				  SVE_PT_SVE_FPSR_OFFSET(vq),
+				  SVE_PT_SVE_FPCR_OFFSET(vq) +
+				  SVE_PT_SVE_FPCR_SIZE);
+}
