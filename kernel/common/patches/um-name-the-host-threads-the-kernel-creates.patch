From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 20 Oct 2026 00:46:50 +0900
Subject: [PATCH] um: name the host threads the kernel creates

Beside its vCPU carriers, which name themselves, the kernel starts host
threads of its own: the Darwin IRQ notification thread, the RTC alarm
helper and a terminal console's window-size helper. They had no names,
so host tools, crash reports and a host's lifecycle code saw anonymous
threads running kernel code over guest RAM, and could not tell them
from the host's own.

os_set_thread_name() names the calling host thread, with
pthread_setname_np() on Darwin and PR_SET_NAME on Linux, and each of
those threads calls it first: uml-irq-notify, uml-rtc-alarm and
uml-winch.
---
 arch/um/drivers/chan_user.c | 1 +
 arch/um/drivers/rtc_user.c  | 1 +
 arch/um/include/shared/os.h | 2 ++
 arch/um/os-Darwin/irq.c     | 1 +
 arch/um/os-Darwin/process.c | 6 ++++++
 arch/um/os-Linux/process.c  | 5 +++++
 6 files changed, 16 insertions(+)

diff --git a/arch/um/drivers/chan_user.c b/arch/um/drivers/chan_user.c
index c8b84de612665ed93b9fa1472ebd433cacec17e1..98d1d53d13e4beb8b51dac7d605f4789208fa27e 100644
--- a/arch/um/drivers/chan_user.c
+++ b/arch/um/drivers/chan_user.c
@@ -181,6 +181,7 @@ static __noreturn int winch_thread(void *arg)
 	char c = 1;
 
 	os_set_pdeathsig();
+	os_set_thread_name("uml-winch");
 
 	pty_fd = data->pty_fd;
 	pipe_fd = data->pipe_fd;
diff --git a/arch/um/drivers/rtc_user.c b/arch/um/drivers/rtc_user.c
index dfc7cafc52123d05064f41ce5b4eb9ce9fd254e9..522da40d6ba29e04f11380f7effaa34812c44a6c 100644
--- a/arch/um/drivers/rtc_user.c
+++ b/arch/um/drivers/rtc_user.c
@@ -36,6 +36,7 @@ static void *uml_rtc_alarm_thread(void *unused)
 	sigset_t blocked;
 
 	(void)unused;
+	os_set_thread_name("uml-rtc-alarm");
 	/* The process-wide UML tick must never be delivered to this helper. */
 	sigemptyset(&blocked);
 	sigaddset(&blocked, SIGALRM);
diff --git a/arch/um/include/shared/os.h b/arch/um/include/shared/os.h
index 43fbd97f093c987887068cdeb8850299e1e39c17..bb6fb24d7d7721ccee69c209073b498b2a1e85aa 100644
--- a/arch/um/include/shared/os.h
+++ b/arch/um/include/shared/os.h
@@ -229,6 +229,8 @@ extern int os_drop_memory(void *addr, int length);
 extern int can_drop_memory(void);
 
 void os_set_pdeathsig(void);
+/* Names the calling host thread, for host tools and crash reports. */
+void os_set_thread_name(const char *name);
 
 int os_futex_wait(void *uaddr, unsigned int val);
 int os_futex_wake(void *uaddr);
diff --git a/arch/um/os-Darwin/irq.c b/arch/um/os-Darwin/irq.c
index 36e4124304314c1352cb2a99a51e0beec39fd09a..dbd1380d87371928c5c5706b38bcdecee2442b1b 100644
--- a/arch/um/os-Darwin/irq.c
+++ b/arch/um/os-Darwin/irq.c
@@ -51,6 +51,7 @@ static void *notification_thread(void *unused)
 	sigset_t blocked;
 
 	(void)unused;
+	os_set_thread_name("uml-irq-notify");
 	/* This helper is created before Darwin switches UML to cooperative
 	 * timers.  Never let the process-wide ITIMER_REAL select it as the
 	 * recipient: the guest clock must run on the UML kernel/idle thread.
diff --git a/arch/um/os-Darwin/process.c b/arch/um/os-Darwin/process.c
index 8ce3c3ec407e77fb2f4604c7425209c13e13436a..6ed6f545ae4673312521ba01af06a960d8719a3b 100644
--- a/arch/um/os-Darwin/process.c
+++ b/arch/um/os-Darwin/process.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 
 #include <errno.h>
+#include <pthread.h>
 #include <signal.h>
 #include <sys/mman.h>
 #include <unistd.h>
@@ -108,3 +109,8 @@ void init_new_thread_signals(void)
 void os_set_pdeathsig(void)
 {
 }
+
+void os_set_thread_name(const char *name)
+{
+	(void)pthread_setname_np(name);
+}
diff --git a/arch/um/os-Linux/process.c b/arch/um/os-Linux/process.c
index 3a2a84ab93257de541fa5fbb6fd880f346d67ad5..be630a5bd577e894c26ed00d2fa3e5103eeedf48 100644
--- a/arch/um/os-Linux/process.c
+++ b/arch/um/os-Linux/process.c
@@ -192,6 +192,11 @@ void os_set_pdeathsig(void)
 	prctl(PR_SET_PDEATHSIG, SIGKILL);
 }
 
+void os_set_thread_name(const char *name)
+{
+	prctl(PR_SET_NAME, (unsigned long)name, 0, 0, 0);
+}
+
 int os_futex_wait(void *uaddr, unsigned int val)
 {
 	int r;
