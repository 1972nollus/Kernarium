diff --git a/arch/um/drivers/mconsole_kern.c b/arch/um/drivers/mconsole_kern.c
index 740d58096d1ac94813e5ccbb0a1cb390256e2288..257d1c028e3da7077d3d98237e65879c8850fe7f 100644
--- a/arch/um/drivers/mconsole_kern.c
+++ b/arch/um/drivers/mconsole_kern.c
@@ -227,6 +227,25 @@ void mconsole_go(struct mc_request *req)
 
 #ifdef CONFIG_SUSPEND
 static struct mc_request *suspend_request;
+static bool suspend_woken;
+/* From PM_SUSPEND_PREPARE to PM_POST_SUSPEND, whoever asked for the suspend. */
+static bool suspending;
+
+static int mconsole_pm_notify(struct notifier_block *nb, unsigned long action,
+			      void *data)
+{
+	if (action == PM_SUSPEND_PREPARE) {
+		WRITE_ONCE(suspending, true);
+	} else if (action == PM_POST_SUSPEND) {
+		WRITE_ONCE(suspending, false);
+		WRITE_ONCE(suspend_woken, false);
+	}
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block mconsole_pm_notifier = {
+	.notifier_call = mconsole_pm_notify,
+};
 
 void um_suspend_notify_entered(void)
 {
@@ -236,6 +255,11 @@ void um_suspend_notify_entered(void)
 		mconsole_reply(req, "suspended", 0, 0);
 }
 
+int um_suspend_wake_requested(void)
+{
+	return READ_ONCE(suspend_woken);
+}
+
 void mconsole_suspend(struct mc_request *req)
 {
 	struct mc_request *pending;
@@ -247,27 +271,49 @@ void mconsole_suspend(struct mc_request *req)
 		return;
 	}
 	error = pm_suspend(PM_SUSPEND_MEM);
+	WRITE_ONCE(suspend_woken, false);
 	pending = xchg(&suspend_request, NULL);
 	if (pending == NULL)
 		return;
 	snprintf(response, sizeof(response), "Suspend failed: %d", error);
 	mconsole_reply(pending, response, 1, 0);
 }
+
+void mconsole_wake(struct mc_request *req)
+{
+	/*
+	 * Until the suspend has stopped interrupts, this request is answered
+	 * here rather than left on the console to end the sleep.  Let it end
+	 * the suspend anyway, whether the host or the guest started it: the PM
+	 * core aborts at its next wakeup check, and um_suspend_enter() does not
+	 * sleep.  A guest that is not suspending only answers.
+	 */
+	if (READ_ONCE(suspend_request) != NULL || READ_ONCE(suspending)) {
+		WRITE_ONCE(suspend_woken, true);
+		pm_system_wakeup();
+	}
+	mconsole_reply(req, "running", 0, 0);
+}
 #else
 void um_suspend_notify_entered(void)
 {
 }
 
+int um_suspend_wake_requested(void)
+{
+	return 0;
+}
+
 void mconsole_suspend(struct mc_request *req)
 {
 	mconsole_reply(req, "System suspend is not configured", 1, 0);
 }
-#endif
 
 void mconsole_wake(struct mc_request *req)
 {
 	mconsole_reply(req, "running", 0, 0);
 }
+#endif
 
 void mconsole_stop(struct mc_request *req)
 {
@@ -798,6 +844,7 @@ static int __init mconsole_init(void)
 		um_free_irq(MCONSOLE_IRQ, (void *)sock);
 		goto out;
 	}
+	register_pm_notifier(&mconsole_pm_notifier);
 #endif
 
 	if (notify_socket != NULL) {
