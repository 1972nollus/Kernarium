diff --git a/arch/um/kernel/skas/mmu_darwin.c b/arch/um/kernel/skas/mmu_darwin.c
index 112d9734f69b3b87ca06288fab39279bf87e280a..1a74055c375e5b4606dea93f2b72d5b16b5357ac 100644
--- a/arch/um/kernel/skas/mmu_darwin.c
+++ b/arch/um/kernel/skas/mmu_darwin.c
@@ -8,6 +8,7 @@
 #include <asm/mm_hooks.h>
 #include <kern_util.h>
 #include <os.h>
+#include <skas.h>
 
 static atomic_t darwin_mm_generation = ATOMIC_INIT(1);
 
@@ -28,6 +29,102 @@ void arch_exit_mmap(struct mm_struct *mm)
 #endif
 }
 
+/*
+ * Whether another agent may observe the memory of current's mm, read at every
+ * entry of the task into its guest code (DARWIN_UML_DISPATCH_MM_SHARED); the
+ * Darwin host keeps x86's memory order for that entry while it holds.  The
+ * mm is shared while
+ *
+ * - another task may run on it: mm_users counts every task from copy_mm(),
+ *   before a CLONE_VM child can run, to the mmput() after its last write to
+ *   the mm.  A vfork child does not count the parent waiting for it, which
+ *   runs no user code until the child leaves the mm.  A temporary reference,
+ *   from /proc or ptrace, only keeps the mm shared while it lasts;
+ * - it maps a VM_MAYSHARE vma, which another mm may map too (MAP_SHARED of
+ *   any kind, read-only ones included, SysV shm, memfd, and the io_uring and
+ *   AIO rings the kernel fills from other CPUs); or
+ * - io_uring keeps a ring in pinned pages of it, which a completion or
+ *   another ring's IORING_OP_MSG_RING writes from other CPUs.
+ *
+ * Only a task on the mm can make an unshared mm shared, inside one of its own
+ * system calls, so the new sharer's first instruction and the task's next one
+ * run ordered.  The conditions are read with acquire semantics: the last
+ * other user's mmput() is a fully ordered decrement, and the unpin a release,
+ * so every store an agent made before it is visible once this task runs
+ * unordered.
+ */
+int current_mm_shared(void)
+{
+	struct mm_struct *mm = current->mm;
+	int users;
+
+	if (mm == NULL)
+		return 0;
+	users = atomic_read_acquire(&mm->mm_users);
+	if (READ_ONCE(current->vfork_done) != NULL)
+		users--;
+	return users > 1 || READ_ONCE(mm->context.darwin_maps_shared) ||
+	       atomic_read_acquire(&mm->context.darwin_ring_pins) != 0;
+}
+
+/* Whether @mm maps a VM_MAYSHARE vma; the caller holds its mmap_lock. */
+static bool maps_shared(struct mm_struct *mm)
+{
+	struct vm_area_struct *vma;
+	VMA_ITERATOR(vmi, mm, 0);
+
+	for_each_vma(vmi, vma)
+		if (vma->vm_flags & VM_MAYSHARE)
+			return true;
+	return false;
+}
+
+/* mmap_region() mapped a VM_MAYSHARE vma, holding mmap_lock for writing. */
+void arch_mmap_shared(struct mm_struct *mm)
+{
+	WRITE_ONCE(mm->context.darwin_maps_shared, 1);
+}
+
+/*
+ * The munmap path removed a VM_MAYSHARE vma, holding mmap_lock for reading
+ * at least.  Every vma that may remain is in the tree, the moved copy of an
+ * mremap() or the new vma of a MAP_FIXED mmap() included, and a new shared
+ * mapping needs the lock for writing, so the walk's answer stands until the
+ * lock is dropped.
+ */
+void arch_munmap_shared(struct mm_struct *mm)
+{
+	if (!maps_shared(mm))
+		WRITE_ONCE(mm->context.darwin_maps_shared, 0);
+}
+
+/*
+ * io_uring pinned user pages of @mm for a ring, or unpinned them, possibly
+ * from a work item after the ring's last reference went: the release orders
+ * every write to the ring before the count's fall.
+ */
+void arch_ring_pin(struct mm_struct *mm)
+{
+	atomic_inc(&mm->context.darwin_ring_pins);
+}
+
+void arch_ring_unpin(struct mm_struct *mm)
+{
+	atomic_dec_return_release(&mm->context.darwin_ring_pins);
+}
+
+/*
+ * A fork child gets the shared vmas its parent may not keep to itself
+ * (MADV_DONTFORK); both mmap_locks are held for writing.  Its pages that
+ * io_uring pins were copied for it, so it starts with no pinned ring.
+ */
+int arch_dup_mmap(struct mm_struct *oldmm, struct mm_struct *mm)
+{
+	if (READ_ONCE(oldmm->context.darwin_maps_shared) && maps_shared(mm))
+		WRITE_ONCE(mm->context.darwin_maps_shared, 1);
+	return 0;
+}
+
 int arch_unmap_one(struct mm_struct *mm, struct vm_area_struct *vma,
 		   unsigned long addr, pte_t orig_pte)
 {
@@ -53,6 +150,8 @@ int init_new_context(struct task_struct *task, struct mm_struct *mm)
 	id->pid = atomic_inc_return(&darwin_mm_generation);
 	id->darwin_generation = id->pid;
 	id->darwin_context = NULL;
+	mm->context.darwin_maps_shared = 0;
+	atomic_set(&mm->context.darwin_ring_pins, 0);
 	id->stack = 0;
 	id->sock = -1;
 	id->syscall_data_len = 0;
diff --git a/arch/um/os-Darwin/skas/process.c b/arch/um/os-Darwin/skas/process.c
index d069b6e05f2f0b35e27c7d9a89d61703f9bdfa2f..54fc1be5a31fbc65f69ebfe45a70c4bc6619049d 100644
--- a/arch/um/os-Darwin/skas/process.c
+++ b/arch/um/os-Darwin/skas/process.c
@@ -106,6 +106,34 @@ static void end_guest_step(struct uml_pt_regs *regs, int stepping)
 		UPT_PSTATE(regs) &= ~DARWIN_GUEST_PSTATE_SS;
 }
 
+/*
+ * The dispatch flags of the guest registers hold facts about the task for
+ * one entry (enum DARWIN_UML_DISPATCH_*).  They are set just before it and
+ * cleared right after, so no saved, traced or signal-frame register ever
+ * carries them.  The kernel works each one out afresh for every entry, after
+ * whatever ended the last one.  Returns the flags set for this entry.
+ */
+static unsigned int begin_guest_dispatch(struct uml_pt_regs *regs,
+					 struct mm_id *mm_id)
+{
+	unsigned int *flags = (unsigned int *)((char *)regs +
+		DARWIN_UML_ABI_GUEST_REGISTERS_DISPATCH_FLAGS_OFFSET);
+	unsigned int set = 0;
+
+	if (mm_id != NULL && current_mm_shared())
+		set |= DARWIN_UML_DISPATCH_MM_SHARED;
+	*flags |= set;
+	return set;
+}
+
+static void end_guest_dispatch(struct uml_pt_regs *regs, unsigned int set)
+{
+	unsigned int *flags = (unsigned int *)((char *)regs +
+		DARWIN_UML_ABI_GUEST_REGISTERS_DISPATCH_FLAGS_OFFSET);
+
+	*flags &= ~set;
+}
+
 static pthread_mutex_t shutdown_lock = PTHREAD_MUTEX_INITIALIZER;
 static pthread_cond_t shutdown_condition = PTHREAD_COND_INITIALIZER;
 static int shutdown_mode = -1;
@@ -331,6 +359,7 @@ void userspace(struct uml_pt_regs *registers)
 		unsigned long guest_tls;
 		const unsigned int *guest_ipi_sequence;
 		unsigned int guest_ipi_snapshot;
+		unsigned int dispatch;
 		int event;
 		int stepping;
 
@@ -376,12 +405,14 @@ void userspace(struct uml_pt_regs *registers)
 			guest_ipi_sequence, guest_ipi_snapshot) < 0)
 			fatal_userspace(registers, "interrupt registration", -1);
 		stepping = begin_guest_step(registers);
+		dispatch = begin_guest_dispatch(registers, mm_id);
 		darwin_ipi_guest_begin();
 		event = darwin_uml_enter_guest(registers, registers->fp,
 				host_fp_size,
 				mm_id == NULL ? 0 : mm_id->darwin_generation,
 				&guest_tls);
 		darwin_ipi_guest_end();
+		end_guest_dispatch(registers, dispatch);
 		end_guest_step(registers, stepping);
 		if (event == DARWIN_UML_EVENT_STOP)
 			darwin_host_stop();
diff --git a/arch/um/os-Darwin/uml_darwin_abi.h b/arch/um/os-Darwin/uml_darwin_abi.h
index fe293d21f68942523006048a8f322d099ddc5a0c..7a5aef6e24e96dc2382e81a975938812561267ec 100644
--- a/arch/um/os-Darwin/uml_darwin_abi.h
+++ b/arch/um/os-Darwin/uml_darwin_abi.h
@@ -59,8 +59,15 @@ enum darwin_uml_guest_event {
  * for one entry. The kernel sets them before it enters the guest and clears
  * them on return, so they never become part of the task's saved PSTATE. */
 enum {
-	/* clone(CLONE_VM) without CLONE_VFORK has shared the task's mm with
-	 * another task since the mm was created. */
+	/* Another agent may observe the memory of the task's mm during this
+	 * entry: another task may run on the mm (a vfork child does not count
+	 * its waiting parent), the mm maps memory that another mm may map too
+	 * (MAP_SHARED of any kind or SysV shm), or io_uring holds pinned
+	 * memory of the mm for a ring. The kernel works it out for each entry,
+	 * so it clears again once none of these holds. Every store made by
+	 * another agent before the condition ended is visible to the entry
+	 * that first lacks the flag. A host may rely on this meaning from
+	 * bridge ABI 19. */
 	DARWIN_UML_DISPATCH_MM_SHARED = 1U << 0,
 };
 
diff --git a/arch/um/os-Darwin/uml_darwin_abi_identity.h b/arch/um/os-Darwin/uml_darwin_abi_identity.h
index fc13ce83dcf8fbd119e4915d4a904089cd677c8e..da7d5a81db003f8572aafbaccc580c29f24ce2a8 100644
--- a/arch/um/os-Darwin/uml_darwin_abi_identity.h
+++ b/arch/um/os-Darwin/uml_darwin_abi_identity.h
@@ -3,7 +3,7 @@
 #ifndef UML_DARWIN_ABI_IDENTITY_H
 #define UML_DARWIN_ABI_IDENTITY_H
 
-#define DARWIN_UML_ABI_VERSION 17U
+#define DARWIN_UML_ABI_VERSION 19U
 #define DARWIN_UML_ABI_FINGERPRINT 0x75b16149a5953494ULL
 
 #endif
diff --git a/include/linux/io_uring_types.h b/include/linux/io_uring_types.h
index 4f1607e00359b7213fffbed93a4c7ea0cc4dcfb8..bd5daf58f876e2f032eb08fdc6b7f670f7985b10 100644
--- a/include/linux/io_uring_types.h
+++ b/include/linux/io_uring_types.h
@@ -91,6 +91,8 @@ struct io_mapped_region {
 	void			*ptr;
 	unsigned		nr_pages;
 	unsigned		flags;
+	/* the mm whose pages a user-provided region pins */
+	struct mm_struct	*mm;
 };
 
 /*
diff --git a/include/linux/mmu_context.h b/include/linux/mmu_context.h
index ac01dc4eb2cecd71ed39bbb65df912b4734e9169..8376b9de52f5098ad5b504db1262d80723209ef4 100644
--- a/include/linux/mmu_context.h
+++ b/include/linux/mmu_context.h
@@ -36,6 +36,39 @@ static inline unsigned long mm_untag_mask(struct mm_struct *mm)
 }
 #endif
 
+/*
+ * Memory of @mm that an agent other than the mm's own tasks can reach comes
+ * and goes.  mmap_region() calls arch_mmap_shared() once it has mapped a
+ * VM_MAYSHARE vma, which another mm may map too, and the munmap path calls
+ * arch_munmap_shared() once it has removed one, both with mmap_lock held.
+ * io_uring calls arch_ring_pin() when it pins user memory of @mm to keep a
+ * ring in, which other CPUs fill, and arch_ring_unpin() when it unpins it,
+ * possibly from another task.  An architecture that must know defines them.
+ */
+#ifndef arch_mmap_shared
+static inline void arch_mmap_shared(struct mm_struct *mm)
+{
+}
+#endif
+
+#ifndef arch_munmap_shared
+static inline void arch_munmap_shared(struct mm_struct *mm)
+{
+}
+#endif
+
+#ifndef arch_ring_pin
+static inline void arch_ring_pin(struct mm_struct *mm)
+{
+}
+#endif
+
+#ifndef arch_ring_unpin
+static inline void arch_ring_unpin(struct mm_struct *mm)
+{
+}
+#endif
+
 #ifndef arch_pgtable_dma_compat
 static inline bool arch_pgtable_dma_compat(struct mm_struct *mm)
 {
diff --git a/io_uring/memmap.c b/io_uring/memmap.c
index add03ca75cb90eb4040916b69731e40855a12da8..0742544502c74ba97e7cae074b159fbc85fe7959 100644
--- a/io_uring/memmap.c
+++ b/io_uring/memmap.c
@@ -8,6 +8,8 @@
 #include <linux/vmalloc.h>
 #include <linux/io_uring.h>
 #include <linux/io_uring_types.h>
+#include <linux/mmu_context.h>
+#include <linux/sched/mm.h>
 #include <asm/shmparam.h>
 
 #include "memmap.h"
@@ -103,6 +105,11 @@ void io_free_region(struct io_ring_ctx *ctx, struct io_mapped_region *mr)
 
 		kvfree(mr->pages);
 	}
+	if (mr->mm) {
+		/* Nothing writes the ring any more. */
+		arch_ring_unpin(mr->mm);
+		mmdrop(mr->mm);
+	}
 	if ((mr->flags & IO_REGION_F_VMAP) && mr->ptr)
 		vunmap(mr->ptr);
 	if (mr->nr_pages && ctx->user)
@@ -145,6 +152,13 @@ static int io_region_pin_pages(struct io_ring_ctx *ctx,
 	if (WARN_ON_ONCE(nr_pages != mr->nr_pages))
 		return -EFAULT;
 
+	/*
+	 * The ring now lives in the task's own memory, which other CPUs fill
+	 * or read: a completion, or another ring's IORING_OP_MSG_RING.
+	 */
+	mr->mm = current->mm;
+	mmgrab(mr->mm);
+	arch_ring_pin(mr->mm);
 	mr->pages = pages;
 	mr->flags |= IO_REGION_F_USER_PROVIDED;
 	return 0;
diff --git a/mm/vma.c b/mm/vma.c
index dcaa2d8998bfb1573da3d578d4e9b438320389f8..7f30fb6360b2579fc9ae14a60e2ada34d4399190 100644
--- a/mm/vma.c
+++ b/mm/vma.c
@@ -1306,6 +1306,7 @@ static void vms_complete_munmap_vmas(struct vma_munmap_struct *vms,
 {
 	struct vm_area_struct *vma;
 	struct mm_struct *mm;
+	bool shared = false;
 
 	mm = current->mm;
 	mm->map_count -= vms->vma_count;
@@ -1331,10 +1332,14 @@ static void vms_complete_munmap_vmas(struct vma_munmap_struct *vms,
 
 	/* Remove and clean up vmas */
 	mas_set(mas_detach, 0);
-	mas_for_each(mas_detach, vma, ULONG_MAX)
+	mas_for_each(mas_detach, vma, ULONG_MAX) {
+		shared |= !!(vma->vm_flags & VM_MAYSHARE);
 		remove_vma(vma);
+	}
 
 	vm_unacct_memory(vms->nr_accounted);
+	if (shared)
+		arch_munmap_shared(mm);
 	validate_mm(mm);
 	if (vms->unlock)
 		mmap_read_unlock(mm);
@@ -2783,6 +2788,8 @@ unsigned long mmap_region(struct file *file, unsigned long addr,
 	}
 
 	ret = __mmap_region(file, addr, len, vm_flags, pgoff, uf);
+	if ((vm_flags & VM_MAYSHARE) && !IS_ERR_VALUE(ret))
+		arch_mmap_shared(current->mm);
 
 	/* Clear our write mapping regardless of error. */
 	if (writable_file_mapping)
