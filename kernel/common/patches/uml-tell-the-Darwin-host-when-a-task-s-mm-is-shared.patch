From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 5 Oct 2026 02:08:45 +0900
Subject: [PATCH] uml: tell the Darwin host when a task's mm is shared

The Darwin host's x86 JIT may relax memory ordering while only one task
runs on an address space, and must restore x86's total store order the
moment a second one can. Bridge ABI 16 gives each guest entry a
dispatch flag, DARWIN_UML_DISPATCH_MM_SHARED, for that.

An mm becomes shared when clone() creates a task on it without
CLONE_VFORK, whose parent cannot run until the child leaves the mm.
The mark is sticky for the life of the mm: once a second task may have
seen its memory, a later return to one user is no proof that every
store is ordered, so the count of users is not consulted. Every later
entry of a task on the mm carries the flag; it is cleared after the
entry returns, as PSTATE.SS is.

The arm64 host ignores the flag.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/um/include/shared/skas/mm_id.h |  3 +++
 arch/um/kernel/process.c            | 11 ++++++++++
 arch/um/kernel/skas/mmu_darwin.c    |  1 +
 arch/um/os-Darwin/skas/process.c    | 31 +++++++++++++++++++++++++++++
 4 files changed, 46 insertions(+)

diff --git a/arch/um/include/shared/skas/mm_id.h b/arch/um/include/shared/skas/mm_id.h
index d4a87dfcda17a0e8fb5ea5a54e2c509623476d48..21e2a31b8a1bd08b06a1c96e650cd3a5fa850d54 100644
--- a/arch/um/include/shared/skas/mm_id.h
+++ b/arch/um/include/shared/skas/mm_id.h
@@ -19,6 +19,9 @@ struct mm_id {
 	/* Same-process address-space identity used by the Darwin VM mapper. */
 	unsigned long darwin_generation;
 	void *darwin_context;
+	/* Set once a second task may run on this mm at the same time: every
+	 * later entry of a task on it carries DARWIN_UML_DISPATCH_MM_SHARED. */
+	int darwin_mm_shared;
 #endif
 
 	/* Only used with SECCOMP mode */
diff --git a/arch/um/kernel/process.c b/arch/um/kernel/process.c
index e04b03437b9a89c2f8e9edd02af04953a5e4d255..8fc2d68003bd0e43955a9393c6092deb3bf5cbaa 100644
--- a/arch/um/kernel/process.c
+++ b/arch/um/kernel/process.c
@@ -173,6 +173,17 @@ int copy_thread(struct task_struct * p, const struct kernel_clone_args *args)
 
 	p->thread = (struct thread_struct) INIT_THREAD;
 
+#ifdef UML_HOST_DARWIN
+	/*
+	 * From now on two tasks may run on current's mm at once, which the
+	 * Darwin host learns at each entry.  A vfork child borrows the mm
+	 * while its parent waits, so it does not count.  The mark lasts as
+	 * long as the mm.
+	 */
+	if ((clone_flags & (CLONE_VM | CLONE_VFORK)) == CLONE_VM && current->mm)
+		WRITE_ONCE(current->mm->context.id.darwin_mm_shared, 1);
+#endif
+
 	if (!args->fn) {
 	  	memcpy(&p->thread.regs.regs, current_pt_regs(),
 		       sizeof(p->thread.regs.regs));
diff --git a/arch/um/kernel/skas/mmu_darwin.c b/arch/um/kernel/skas/mmu_darwin.c
index 112d9734f69b3b87ca06288fab39279bf87e280a..8981e106990db307c1cdffdf3f9c555542fedc70 100644
--- a/arch/um/kernel/skas/mmu_darwin.c
+++ b/arch/um/kernel/skas/mmu_darwin.c
@@ -53,6 +53,7 @@ int init_new_context(struct task_struct *task, struct mm_struct *mm)
 	id->pid = atomic_inc_return(&darwin_mm_generation);
 	id->darwin_generation = id->pid;
 	id->darwin_context = NULL;
+	id->darwin_mm_shared = 0;
 	id->stack = 0;
 	id->sock = -1;
 	id->syscall_data_len = 0;
diff --git a/arch/um/os-Darwin/skas/process.c b/arch/um/os-Darwin/skas/process.c
index 0cb7d999350d9ff8284615cc5b5738c392b17cef..874f52f56498e74ee4d233172ab993d6843a348e 100644
--- a/arch/um/os-Darwin/skas/process.c
+++ b/arch/um/os-Darwin/skas/process.c
@@ -106,6 +106,34 @@ static void end_guest_step(struct uml_pt_regs *regs, int stepping)
 		UPT_PSTATE(regs) &= ~DARWIN_GUEST_PSTATE_SS;
 }
 
+/*
+ * The dispatch flags of the guest registers hold facts about the task for
+ * one entry (enum DARWIN_UML_DISPATCH_*).  They are set just before it and
+ * cleared right after, so no saved, traced or signal-frame register ever
+ * carries them.  Returns the flags set for this entry.
+ */
+static unsigned int begin_guest_dispatch(struct uml_pt_regs *regs,
+					 struct mm_id *mm_id)
+{
+	unsigned int *flags = (unsigned int *)((char *)regs +
+		DARWIN_UML_ABI_GUEST_REGISTERS_DISPATCH_FLAGS_OFFSET);
+	unsigned int set = 0;
+
+	if (mm_id != NULL &&
+	    __atomic_load_n(&mm_id->darwin_mm_shared, __ATOMIC_RELAXED))
+		set |= DARWIN_UML_DISPATCH_MM_SHARED;
+	*flags |= set;
+	return set;
+}
+
+static void end_guest_dispatch(struct uml_pt_regs *regs, unsigned int set)
+{
+	unsigned int *flags = (unsigned int *)((char *)regs +
+		DARWIN_UML_ABI_GUEST_REGISTERS_DISPATCH_FLAGS_OFFSET);
+
+	*flags &= ~set;
+}
+
 static pthread_mutex_t shutdown_lock = PTHREAD_MUTEX_INITIALIZER;
 static pthread_cond_t shutdown_condition = PTHREAD_COND_INITIALIZER;
 static int shutdown_mode = -1;
@@ -357,6 +385,7 @@ void userspace(struct uml_pt_regs *registers)
 		unsigned long guest_tls;
 		const unsigned int *guest_ipi_sequence;
 		unsigned int guest_ipi_snapshot;
+		unsigned int dispatch;
 		int event;
 		int stepping;
 
@@ -402,12 +431,14 @@ void userspace(struct uml_pt_regs *registers)
 			guest_ipi_sequence, guest_ipi_snapshot) < 0)
 			fatal_userspace(registers, "interrupt registration", -1);
 		stepping = begin_guest_step(registers);
+		dispatch = begin_guest_dispatch(registers, mm_id);
 		darwin_ipi_guest_begin();
 		event = darwin_uml_enter_guest(registers, registers->fp,
 				host_fp_size,
 				mm_id == NULL ? 0 : mm_id->darwin_generation,
 				&guest_tls);
 		darwin_ipi_guest_end();
+		end_guest_dispatch(registers, dispatch);
 		end_guest_step(registers, stepping);
 		if (event == DARWIN_UML_EVENT_STOP)
 			darwin_host_stop();
