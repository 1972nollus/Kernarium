diff --git a/arch/um/os-Darwin/Makefile b/arch/um/os-Darwin/Makefile
new file mode 100644
index 000000000..5198f3022
--- /dev/null
+++ b/arch/um/os-Darwin/Makefile
@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: GPL-2.0
+
+# The Darwin backend is deliberately separate from os-Linux: no ptrace,
+# clone, eventfd, epoll, signalfd, timerfd, or Linux raw syscall may leak into
+# the single-process runtime.
+obj-y := compat.o file.o helper.o irq.o main.o mem.o process.o signal.o sigio.o \
+	start_up.o time.o tty.o umid.o util.o skas/
+obj-$(CONFIG_SMP) += smp.o
+
+USER_OBJS := compat.o file.o helper.o irq.o main.o mem.o process.o signal.o sigio.o \
+	start_up.o time.o tty.o umid.o util.o smp.o
+
+CFLAGS_main.o += -Wno-frame-larger-than
+
+include $(srctree)/arch/um/scripts/Makefile.rules
