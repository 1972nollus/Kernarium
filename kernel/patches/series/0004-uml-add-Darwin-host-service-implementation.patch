diff --git a/arch/um/os-Darwin/compat.c b/arch/um/os-Darwin/compat.c
new file mode 100644
index 000000000..12d70d6cb
--- /dev/null
+++ b/arch/um/os-Darwin/compat.c
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+#include "bridge.h"
+
+int vscnprintf(char *buffer, size_t size, const char *format, va_list args);
+
+/* Darwin's secure string header defines function-call syntax for memcpy as
+ * __builtin___memcpy_chk().  This file supplies that ELF compatibility symbol,
+ * so retaining the macro would make its success path call itself.  The UML
+ * user-object build already uses -fno-builtin; expose the real libc symbol for
+ * the checked wrappers below while retaining their explicit bounds checks.
+ */
+#undef memcpy
+
+static void *darwin_compat_copy(void *destination, const void *source,
+				size_t length)
+{
+	return memcpy(destination, source, length);
+}
+
+int darwin_elf_open(const char *path, int flags, ...) __asm("_open");
+int darwin_elf_close(int fd) __asm("_close");
+
+int darwin_elf_open(const char *path, int flags, ...)
+{
+	int mode = 0;
+
+	if (flags & O_CREAT) {
+		va_list args;
+		va_start(args, flags);
+		mode = va_arg(args, int);
+		va_end(args);
+	}
+	return darwin_uml_open(path, flags, mode);
+}
+
+int darwin_elf_close(int fd)
+{
+	return darwin_uml_close(fd);
+}
+
+int ioctl(int fd, unsigned long command, ...)
+{
+	va_list args;
+	void *argument;
+
+	va_start(args, command);
+	argument = va_arg(args, void *);
+	va_end(args);
+	return darwin_uml_ioctl(fd, command, argument);
+}
+
+int printf(const char *format, ...)
+{
+	char buffer[1024];
+	va_list args;
+	int length;
+
+	va_start(args, format);
+	length = vscnprintf(buffer, sizeof(buffer), format, args);
+	va_end(args);
+	if (length > 0)
+		(void)write(STDOUT_FILENO, buffer, (size_t)length);
+	return length;
+}
+
+void exit(int status)
+{
+	darwin_uml_exit(status, __builtin_return_address(0));
+}
+
+void darwin_elf__exit(int status) __asm("_exit");
+
+void darwin_elf__exit(int status)
+{
+	darwin_uml_exit(status, __builtin_return_address(0));
+}
+
+int __sprintf_chk(char *destination, int flag, size_t size,
+		  const char *format, ...)
+{
+	va_list args;
+	int length;
+
+	(void)flag;
+	va_start(args, format);
+	length = vscnprintf(destination, size, format, args);
+	va_end(args);
+	return length;
+}
+
+void *__memcpy_chk(void *destination, const void *source,
+		   size_t length, size_t destination_size)
+{
+	if (length > destination_size)
+		darwin_uml_abort();
+	return darwin_compat_copy(destination, source, length);
+}
+
+char *__strcpy_chk(char *destination, const char *source,
+		   size_t destination_size)
+{
+	size_t length = strlen(source) + 1;
+
+	if (length > destination_size)
+		darwin_uml_abort();
+	return darwin_compat_copy(destination, source, length);
+}
+
+char *__strcat_chk(char *destination, const char *source,
+		   size_t destination_size)
+{
+	size_t used = strlen(destination);
+	size_t length = strlen(source) + 1;
+
+	if (used + length > destination_size)
+		darwin_uml_abort();
+	darwin_compat_copy(destination + used, source, length);
+	return destination;
+}
diff --git a/arch/um/os-Darwin/file.c b/arch/um/os-Darwin/file.c
new file mode 100644
index 000000000..9e5398437
--- /dev/null
+++ b/arch/um/os-Darwin/file.c
@@ -0,0 +1,544 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <os.h>
+#include "bridge.h"
+
+static void copy_stat(struct uml_stat *destination, const struct stat *source)
+{
+	destination->ust_dev = (int)source->st_dev;
+	destination->ust_ino = source->st_ino;
+	destination->ust_mode = source->st_mode;
+	destination->ust_nlink = (int)source->st_nlink;
+	destination->ust_uid = source->st_uid;
+	destination->ust_gid = source->st_gid;
+	destination->ust_size = source->st_size;
+	destination->ust_blksize = source->st_blksize;
+	destination->ust_blocks = source->st_blocks;
+	destination->ust_atime = source->st_atimespec.tv_sec;
+	destination->ust_mtime = source->st_mtimespec.tv_sec;
+	destination->ust_ctime = source->st_ctimespec.tv_sec;
+}
+
+int os_stat_fd(const int fd, struct uml_stat *buffer)
+{
+	struct stat status;
+
+	if (fstat(fd, &status) < 0)
+		return -errno;
+	if (buffer != NULL)
+		copy_stat(buffer, &status);
+	return 0;
+}
+
+int os_stat_file(const char *path, struct uml_stat *buffer)
+{
+	struct stat status;
+
+	if (lstat(path, &status) < 0)
+		return -errno;
+	if (buffer != NULL)
+		copy_stat(buffer, &status);
+	return 0;
+}
+
+int os_access(const char *path, int mode)
+{
+	int host_mode = 0;
+
+	if (mode & OS_ACC_R_OK)
+		host_mode |= R_OK;
+	if (mode & OS_ACC_W_OK)
+		host_mode |= W_OK;
+	if (mode & OS_ACC_X_OK)
+		host_mode |= X_OK;
+	if (access(path, host_mode) < 0)
+		return -errno;
+	return 0;
+}
+
+int os_ioctl_generic(int fd, unsigned int command, unsigned long argument)
+{
+	int result = darwin_uml_ioctl(fd, command, (void *)argument);
+
+	return result < 0 ? -errno : result;
+}
+
+int os_get_ifname(int fd, char *name)
+{
+	(void)fd;
+	(void)name;
+	return -EOPNOTSUPP;
+}
+
+int os_mode_fd(int fd, int mode)
+{
+	return fchmod(fd, mode) < 0 ? -errno : 0;
+}
+
+int os_file_type(char *path)
+{
+	struct uml_stat status;
+	int error = os_stat_file(path, &status);
+
+	if (error < 0)
+		return error;
+	if (S_ISDIR(status.ust_mode))
+		return OS_TYPE_DIR;
+	if (S_ISLNK(status.ust_mode))
+		return OS_TYPE_SYMLINK;
+	if (S_ISCHR(status.ust_mode))
+		return OS_TYPE_CHARDEV;
+	if (S_ISBLK(status.ust_mode))
+		return OS_TYPE_BLOCKDEV;
+	if (S_ISFIFO(status.ust_mode))
+		return OS_TYPE_FIFO;
+	if (S_ISSOCK(status.ust_mode))
+		return OS_TYPE_SOCK;
+	return OS_TYPE_FILE;
+}
+
+int os_file_mode(const char *path, struct openflags *mode)
+{
+	*mode = OPENFLAGS();
+	if (access(path, R_OK) == 0)
+		*mode = of_read(*mode);
+	else if (errno != EACCES)
+		return -errno;
+	if (access(path, W_OK) == 0)
+		*mode = of_write(*mode);
+	else if (errno != EACCES)
+		return -errno;
+	return 0;
+}
+
+int os_open_file(const char *path, struct openflags flags, int mode)
+{
+	int host_flags = flags.r && flags.w ? O_RDWR :
+		flags.w ? O_WRONLY : O_RDONLY;
+	int fd;
+
+	if (flags.s)
+		host_flags |= O_SYNC;
+	if (flags.c)
+		host_flags |= O_CREAT;
+	if (flags.t)
+		host_flags |= O_TRUNC;
+	if (flags.e)
+		host_flags |= O_EXCL;
+	if (flags.a)
+		host_flags |= O_APPEND;
+	fd = darwin_uml_open(path, host_flags, mode);
+	if (fd < 0)
+		return -errno;
+	if (flags.cl && darwin_uml_fcntl(fd, F_SETFD, FD_CLOEXEC) < 0) {
+		int error = -errno;
+		close(fd);
+		return error;
+	}
+	return fd;
+}
+
+int os_connect_socket(const char *name)
+{
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	char *end;
+	long inherited;
+	int fd;
+
+	/*
+	 * The app-linked GPU backend uses a socketpair so the complete graphics
+	 * stack stays inside the emulator process on sandboxed Apple platforms.
+	 */
+	if (!strncmp(name, "fd=", 3)) {
+		errno = 0;
+		inherited = strtol(name + 3, &end, 10);
+		if (errno || *end || inherited < 0 || inherited > INT_MAX)
+			return -EINVAL;
+		fd = (int)inherited;
+		if (fcntl(fd, F_GETFD) < 0)
+			return -errno;
+		return fd;
+	}
+
+	if (strlcpy(address.sun_path, name, sizeof(address.sun_path)) >=
+	    sizeof(address.sun_path))
+		return -ENAMETOOLONG;
+	fd = socket(AF_UNIX, SOCK_STREAM, 0);
+	if (fd < 0)
+		return -errno;
+	if (connect(fd, (struct sockaddr *)&address, sizeof(address)) < 0) {
+		int error = -errno;
+		close(fd);
+		return error;
+	}
+	return fd;
+}
+
+int os_dup_file(int fd)
+{
+	int duplicate = dup(fd);
+	return duplicate < 0 ? -errno : duplicate;
+}
+
+void os_close_file(int fd)
+{
+	if (fd >= 0)
+		close(fd);
+}
+
+int os_seek_file(int fd, unsigned long long offset)
+{
+	off_t actual = lseek(fd, (off_t)offset, SEEK_SET);
+	return actual == (off_t)offset ? 0 : -errno;
+}
+
+int os_read_file(int fd, void *buffer, int length)
+{
+	ssize_t result = read(fd, buffer, (size_t)length);
+	return result < 0 ? -errno : (int)result;
+}
+
+int os_error_is_would_block(int error)
+{
+	/*
+	 * OS-facing UML helpers return host errno values.  Darwin's EAGAIN is
+	 * 35 while Linux's is 11, so kernel code must not compare the result
+	 * of os_read_file() with the guest's EAGAIN constant directly.
+	 */
+	return error == -EAGAIN || error == -EWOULDBLOCK;
+}
+
+int os_pread_file(int fd, void *buffer, int length,
+		  unsigned long long offset)
+{
+	ssize_t result = pread(fd, buffer, (size_t)length, (off_t)offset);
+	return result < 0 ? -errno : (int)result;
+}
+
+int os_write_file(int fd, const void *buffer, int length)
+{
+	ssize_t result = write(fd, buffer, (size_t)length);
+	return result < 0 ? -errno : (int)result;
+}
+
+int os_pwrite_file(int fd, const void *buffer, int length,
+		   unsigned long long offset)
+{
+	ssize_t result = pwrite(fd, buffer, (size_t)length, (off_t)offset);
+	return result < 0 ? -errno : (int)result;
+}
+
+int os_sync_file(int fd)
+{
+	return fsync(fd) < 0 ? -errno : 0;
+}
+
+int os_file_size(const char *path, unsigned long long *size)
+{
+	struct uml_stat status;
+	int error = os_stat_file(path, &status);
+
+	if (error < 0)
+		return error;
+	*size = status.ust_size;
+	return 0;
+}
+
+int os_file_modtime(const char *path, long long *modtime)
+{
+	struct uml_stat status;
+	int error = os_stat_file(path, &status);
+
+	if (error < 0)
+		return error;
+	*modtime = status.ust_mtime;
+	return 0;
+}
+
+int os_set_exec_close(int fd)
+{
+	return darwin_uml_fcntl(fd, F_SETFD, FD_CLOEXEC) < 0 ? -errno : 0;
+}
+
+int os_pipe(int *fds, int stream, int close_on_exec)
+{
+	int type = stream ? SOCK_STREAM : SOCK_DGRAM;
+
+	if (socketpair(AF_UNIX, type, 0, fds) < 0)
+		return -errno;
+	if (close_on_exec &&
+	    (os_set_exec_close(fds[0]) < 0 || os_set_exec_close(fds[1]) < 0)) {
+		int error = -errno;
+		close(fds[0]);
+		close(fds[1]);
+		return error;
+	}
+	return 0;
+}
+
+int os_set_fd_async(int fd)
+{
+	int flags = darwin_uml_fcntl(fd, F_GETFL, 0);
+
+	if (flags < 0)
+		return -errno;
+	/* The Darwin IRQ backend polls its descriptor registry from the timer
+	 * boundary.  F_SETOWN/O_ASYNC is both unnecessary and rejected by some
+	 * terminal and pipe descriptors on macOS.
+	 */
+	return darwin_uml_fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0 ?
+		-errno : 0;
+}
+
+int os_clear_fd_async(int fd)
+{
+	int flags = darwin_uml_fcntl(fd, F_GETFL, 0);
+
+	if (flags < 0)
+		return -errno;
+	return darwin_uml_fcntl(fd, F_SETFL, flags & ~O_NONBLOCK) < 0 ?
+		-errno : 0;
+}
+
+int os_set_fd_block(int fd, int blocking)
+{
+	int flags = darwin_uml_fcntl(fd, F_GETFL, 0);
+
+	if (flags < 0)
+		return -errno;
+	if (blocking)
+		flags &= ~O_NONBLOCK;
+	else
+		flags |= O_NONBLOCK;
+	return darwin_uml_fcntl(fd, F_SETFL, flags) < 0 ? -errno : 0;
+}
+
+int os_accept_connection(int fd)
+{
+	int accepted = accept(fd, NULL, NULL);
+	return accepted < 0 ? -errno : accepted;
+}
+
+int os_shutdown_socket(int fd, int read_side, int write_side)
+{
+	int direction;
+
+	if (read_side && write_side)
+		direction = SHUT_RDWR;
+	else if (read_side)
+		direction = SHUT_RD;
+	else if (write_side)
+		direction = SHUT_WR;
+	else
+		return -EINVAL;
+	return shutdown(fd, direction) < 0 ? -errno : 0;
+}
+
+ssize_t os_rcv_fd_msg(int fd, int *fds, unsigned int count,
+		      void *data, size_t data_length)
+{
+	union {
+		char bytes[CMSG_SPACE(sizeof(int) * 2)];
+		struct cmsghdr alignment;
+	} control;
+	struct iovec vector = { .iov_base = data, .iov_len = data_length };
+	struct msghdr message = {
+		.msg_iov = &vector,
+		.msg_iovlen = 1,
+		.msg_control = control.bytes,
+		.msg_controllen = sizeof(control.bytes),
+	};
+	struct cmsghdr *header;
+	ssize_t result;
+
+	if (count > 2)
+		return -EINVAL;
+	result = recvmsg(fd, &message, 0);
+	if (result < 0)
+		return -errno;
+	header = CMSG_FIRSTHDR(&message);
+	if (header != NULL && header->cmsg_level == SOL_SOCKET &&
+	    header->cmsg_type == SCM_RIGHTS)
+		memcpy(fds, CMSG_DATA(header),
+		       (size_t)(header->cmsg_len - CMSG_LEN(0)) <
+				count * sizeof(*fds) ?
+		       (size_t)(header->cmsg_len - CMSG_LEN(0)) :
+				count * sizeof(*fds));
+	return result;
+}
+
+int os_create_unix_socket(const char *path, int length, int close_on_exec)
+{
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	int fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+
+	(void)length;
+	if (fd < 0)
+		return -errno;
+	if (strlcpy(address.sun_path, path, sizeof(address.sun_path)) >=
+	    sizeof(address.sun_path)) {
+		close(fd);
+		return -ENAMETOOLONG;
+	}
+	if (close_on_exec && os_set_exec_close(fd) < 0) {
+		close(fd);
+		return -errno;
+	}
+	if (bind(fd, (struct sockaddr *)&address, sizeof(address)) < 0) {
+		int error = -errno;
+		close(fd);
+		return error;
+	}
+	return fd;
+}
+
+void os_flush_stdout(void)
+{
+	fflush(stdout);
+}
+
+int os_lock_file(int fd, int exclusive)
+{
+	struct flock lock = {
+		.l_type = exclusive ? F_WRLCK : F_RDLCK,
+		.l_whence = SEEK_SET,
+	};
+
+	return darwin_uml_fcntl(fd, F_SETLK, (long)&lock) < 0 ? -errno : 0;
+}
+
+unsigned os_major(unsigned long long device)
+{
+	return major((dev_t)device);
+}
+
+unsigned os_minor(unsigned long long device)
+{
+	return minor((dev_t)device);
+}
+
+unsigned long long os_makedev(unsigned major_number, unsigned minor_number)
+{
+	return makedev(major_number, minor_number);
+}
+
+int os_falloc_punch(int fd, unsigned long long offset, int length)
+{
+#ifdef F_PUNCHHOLE
+	struct fpunchhole punch = {
+		.fp_offset = (off_t)offset,
+		.fp_length = (off_t)length,
+	};
+	return darwin_uml_fcntl(fd, F_PUNCHHOLE, (long)&punch) < 0 ? -errno : 0;
+#else
+	(void)fd;
+	(void)offset;
+	(void)length;
+	return -EOPNOTSUPP;
+#endif
+}
+
+int os_falloc_zeroes(int fd, unsigned long long offset, int length)
+{
+	static const unsigned char zeroes[4096];
+	int remaining = length;
+
+	while (remaining > 0) {
+		int chunk = remaining < (int)sizeof(zeroes) ?
+			remaining : (int)sizeof(zeroes);
+		int result = os_pwrite_file(fd, zeroes, chunk, offset);
+
+		if (result < 0)
+			return result;
+		if (result == 0)
+			return -EIO;
+		remaining -= result;
+		offset += result;
+	}
+	return 0;
+}
+
+int os_eventfd(unsigned int initial_value, int flags)
+{
+	(void)initial_value;
+	(void)flags;
+	return -EOPNOTSUPP;
+}
+
+int os_sendmsg_fds(int fd, const void *data, unsigned int length,
+		   const int *fds, unsigned int count)
+{
+	char control[CMSG_SPACE(sizeof(int) * OS_SENDMSG_MAX_FDS)] = { };
+	struct iovec vector = { .iov_base = (void *)data, .iov_len = length };
+	struct msghdr message = {
+		.msg_iov = &vector,
+		.msg_iovlen = 1,
+		.msg_control = control,
+		.msg_controllen = CMSG_SPACE(sizeof(int) * count),
+	};
+	struct cmsghdr *header;
+	ssize_t result;
+
+	if (count > OS_SENDMSG_MAX_FDS)
+		return -EINVAL;
+	header = CMSG_FIRSTHDR(&message);
+	header->cmsg_level = SOL_SOCKET;
+	header->cmsg_type = SCM_RIGHTS;
+	header->cmsg_len = CMSG_LEN(sizeof(int) * count);
+	memcpy(CMSG_DATA(header), fds, sizeof(int) * count);
+	result = sendmsg(fd, &message, 0);
+	return result < 0 ? -errno : (int)result;
+}
+
+int os_poll(unsigned int count, const int *fds)
+{
+	struct pollfd pollfds[2] = { };
+	unsigned int index;
+	int result;
+
+	if (count > 2)
+		return -EINVAL;
+	for (index = 0; index < count; index++) {
+		pollfds[index].fd = fds[index];
+		pollfds[index].events = POLLIN;
+	}
+	result = poll(pollfds, count, -1);
+	if (result < 0)
+		return -errno;
+	for (index = 0; index < count; index++)
+		if (pollfds[index].revents != 0)
+			return (int)index;
+	return -EIO;
+}
+
+void *os_mmap_rw_shared(int fd, size_t size)
+{
+	void *mapping = mmap(NULL, size, PROT_READ | PROT_WRITE,
+			     MAP_SHARED, fd, 0);
+	return mapping == MAP_FAILED ? NULL : mapping;
+}
+
+void *os_mremap_rw_shared(void *old_address, size_t old_size, size_t new_size)
+{
+	void *mapping = mmap(NULL, new_size, PROT_READ | PROT_WRITE,
+			     MAP_PRIVATE | MAP_ANON, -1, 0);
+
+	if (mapping == MAP_FAILED)
+		return NULL;
+	memcpy(mapping, old_address, old_size < new_size ? old_size : new_size);
+	munmap(old_address, old_size);
+	return mapping;
+}
diff --git a/arch/um/os-Darwin/helper.c b/arch/um/os-Darwin/helper.c
new file mode 100644
index 000000000..540269e0b
--- /dev/null
+++ b/arch/um/os-Darwin/helper.c
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <os.h>
+#include "internal.h"
+
+#define DARWIN_MAX_INTEGER_HELPERS 64
+
+struct os_helper_thread {
+	pthread_t handle;
+};
+
+int run_helper(void (*pre_exec)(void *), void *pre_data, char **argv)
+{
+	(void)pre_exec;
+	(void)pre_data;
+	(void)argv;
+	/* A host exec would violate the single-process execution contract. */
+	return -EOPNOTSUPP;
+}
+
+struct integer_helper {
+	int (*routine)(void *);
+	void *argument;
+};
+
+struct integer_helper_slot {
+	pthread_t handle;
+	int in_use;
+	int stopping;
+};
+
+static pthread_mutex_t integer_helpers_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct integer_helper_slot
+	integer_helpers[DARWIN_MAX_INTEGER_HELPERS];
+
+static int reserve_integer_helper(void)
+{
+	int index;
+
+	pthread_mutex_lock(&integer_helpers_lock);
+	for (index = 0; index < DARWIN_MAX_INTEGER_HELPERS; index++) {
+		if (integer_helpers[index].in_use)
+			continue;
+		integer_helpers[index].in_use = 1;
+		integer_helpers[index].stopping = 0;
+		integer_helpers[index].handle = (pthread_t)0;
+		pthread_mutex_unlock(&integer_helpers_lock);
+		return index + 1;
+	}
+	pthread_mutex_unlock(&integer_helpers_lock);
+	return -EAGAIN;
+}
+
+static void release_integer_helper(int identifier)
+{
+	struct integer_helper_slot *slot;
+
+	if (identifier <= 0 || identifier > DARWIN_MAX_INTEGER_HELPERS)
+		return;
+	slot = &integer_helpers[identifier - 1];
+	pthread_mutex_lock(&integer_helpers_lock);
+	slot->handle = (pthread_t)0;
+	slot->stopping = 0;
+	slot->in_use = 0;
+	pthread_mutex_unlock(&integer_helpers_lock);
+}
+
+static pthread_t claim_integer_helper(int identifier)
+{
+	struct integer_helper_slot *slot;
+	pthread_t handle = (pthread_t)0;
+
+	if (identifier <= 0 || identifier > DARWIN_MAX_INTEGER_HELPERS)
+		return handle;
+	slot = &integer_helpers[identifier - 1];
+	pthread_mutex_lock(&integer_helpers_lock);
+	if (slot->in_use && !slot->stopping && slot->handle != (pthread_t)0) {
+		slot->stopping = 1;
+		handle = slot->handle;
+	}
+	pthread_mutex_unlock(&integer_helpers_lock);
+	return handle;
+}
+
+static void *integer_helper_entry(void *argument)
+{
+	struct integer_helper *helper = argument;
+	int (*routine)(void *) = helper->routine;
+	void *routine_argument = helper->argument;
+
+	free(helper);
+	return (void *)(long)routine(routine_argument);
+}
+
+int run_helper_thread(int (*routine)(void *), void *argument,
+		      unsigned int flags, unsigned long *stack_out)
+{
+	struct integer_helper *helper = malloc(sizeof(*helper));
+	pthread_attr_t attributes;
+	pthread_t thread;
+	void *result;
+	int identifier = 0;
+	int error;
+
+	(void)flags;
+	if (helper == NULL)
+		return -ENOMEM;
+	helper->routine = routine;
+	helper->argument = argument;
+	if (stack_out != NULL) {
+		identifier = reserve_integer_helper();
+		if (identifier < 0) {
+			free(helper);
+			return identifier;
+		}
+	}
+	error = pthread_attr_init(&attributes);
+	if (error != 0) {
+		release_integer_helper(identifier);
+		free(helper);
+		return -error;
+	}
+	if (error == 0)
+		error = pthread_create(&thread, &attributes,
+				       integer_helper_entry, helper);
+	pthread_attr_destroy(&attributes);
+	if (error != 0) {
+		release_integer_helper(identifier);
+		free(helper);
+		return -error;
+	}
+	if (stack_out != NULL) {
+		pthread_mutex_lock(&integer_helpers_lock);
+		integer_helpers[identifier - 1].handle = thread;
+		pthread_mutex_unlock(&integer_helpers_lock);
+		*stack_out = 0;
+		return identifier;
+	}
+	pthread_join(thread, &result);
+	return (int)(long)result;
+}
+
+int helper_wait(int id)
+{
+	pthread_t thread = claim_integer_helper(id);
+	int error;
+
+	if (thread == (pthread_t)0)
+		return -ESRCH;
+	error = pthread_join(thread, NULL);
+	release_integer_helper(id);
+	return error == 0 ? 0 : -error;
+}
+
+void darwin_kill_integer_helper(int identifier)
+{
+	pthread_t thread = claim_integer_helper(identifier);
+
+	if (thread == (pthread_t)0)
+		return;
+	(void)pthread_cancel(thread);
+	/* The winch helper normally sleeps in sigsuspend()/pause().  Supply its
+	 * permitted wake signal as well so cancellation cannot remain latent in
+	 * a host wait while the embedded kernel is being retired. */
+	(void)pthread_kill(thread, SIGWINCH);
+	(void)pthread_join(thread, NULL);
+	release_integer_helper(identifier);
+}
+
+int os_run_helper_thread(struct os_helper_thread **thread_out,
+			 void *(*routine)(void *), void *argument)
+{
+	struct os_helper_thread *thread = malloc(sizeof(*thread));
+	int error;
+
+	if (thread == NULL)
+		return -ENOMEM;
+	error = pthread_create(&thread->handle, NULL, routine, argument);
+	if (error != 0) {
+		free(thread);
+		return -error;
+	}
+	*thread_out = thread;
+	return 0;
+}
+
+void os_kill_helper_thread(struct os_helper_thread *thread)
+{
+	pthread_cancel(thread->handle);
+	pthread_join(thread->handle, NULL);
+	free(thread);
+}
+
+void os_fix_helper_thread_signals(void)
+{
+	sigset_t signals;
+
+	sigfillset(&signals);
+	pthread_sigmask(SIG_SETMASK, &signals, NULL);
+}
