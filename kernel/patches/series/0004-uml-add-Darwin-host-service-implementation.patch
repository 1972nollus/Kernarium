+#define DARWIN_GUEST_FPE_FLTUND 5
+#define DARWIN_GUEST_FPE_FLTRES 6
+#define DARWIN_GUEST_FPE_FLTINV 7
+#define DARWIN_GUEST_FPE_FLTUNK 14
+
+struct darwin_task_thread {
+	jmp_buf *key;
+	pthread_t thread;
+	pthread_mutex_t lock;
+	pthread_cond_t condition;
+	void (*entry)(void);
+	int cpu;
+	int runnable;
+	unsigned int references;
+	struct darwin_task_thread *previous;
+	struct darwin_task_thread *next;
+	struct darwin_task_thread *hash_previous;
+	struct darwin_task_thread *hash_next;
+};
+
+static pthread_mutex_t task_list_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t task_bucket_locks[DARWIN_TASK_HASH_BUCKETS];
+static pthread_once_t task_bucket_locks_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t shutdown_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t shutdown_condition = PTHREAD_COND_INITIALIZER;
+static struct darwin_task_thread *task_threads;
+static struct darwin_task_thread *task_buckets[DARWIN_TASK_HASH_BUCKETS];
+static pthread_key_t current_host_task_key;
+static pthread_once_t current_host_task_once = PTHREAD_ONCE_INIT;
+static uintptr_t cpu_execution_owner[CONFIG_NR_CPUS];
+static int shutdown_mode = -1;
+static unsigned int live_embedded_threads;
+static volatile sig_atomic_t cooperative_timers;
+static unsigned long long profile_activate_ns;
+static unsigned long long profile_sync_ns;
+static unsigned long long profile_guest_ns;
+static unsigned long long profile_stack_ns;
+static unsigned long long profile_syscall_ns;
+static unsigned long long profile_fault_ns;
+static unsigned long long profile_boundaries;
+static unsigned long long profile_thread_create_ns;
+static unsigned long long profile_thread_creates;
+static void timer_signal_mask(int how, sigset_t *old_mask);
+static void remove_task(struct darwin_task_thread *task);
+static void task_put(struct darwin_task_thread *task);
+
+static void profile_add(unsigned long long *counter,
+			unsigned long long value)
+{
+	__atomic_fetch_add(counter, value, __ATOMIC_RELAXED);
+}
+
+static unsigned long long profile_read(unsigned long long *counter)
+{
+	return __atomic_load_n(counter, __ATOMIC_RELAXED);
+}
+
+static void create_current_host_task_key(void)
+{
+	if (pthread_key_create(&current_host_task_key, NULL) != 0)
+		panic("Darwin: unable to create scheduler task key");
+}
+
+static struct darwin_task_thread *get_current_host_task(void)
+{
+	if (pthread_once(&current_host_task_once,
+			 create_current_host_task_key) != 0)
+		panic("Darwin: unable to initialize scheduler task key");
+	return pthread_getspecific(current_host_task_key);
+}
+
+static void set_current_host_task(struct darwin_task_thread *task)
+{
+	if (pthread_once(&current_host_task_once,
+			 create_current_host_task_key) != 0 ||
+	    pthread_setspecific(current_host_task_key, task) != 0)
+		panic("Darwin: unable to set scheduler task key");
+}
+
+int darwin_reserve_embedded_thread(void)
+{
+	int reserved = 0;
+
+	pthread_mutex_lock(&shutdown_lock);
+	if (__atomic_load_n(&shutdown_mode, __ATOMIC_ACQUIRE) < 0) {
+		live_embedded_threads++;
+		reserved = 1;
+	}
+	pthread_mutex_unlock(&shutdown_lock);
+	return reserved;
+}
+
+void darwin_release_embedded_thread(void)
+{
+	pthread_mutex_lock(&shutdown_lock);
+	if (live_embedded_threads == 0) {
+		pthread_mutex_unlock(&shutdown_lock);
+		panic("Darwin: embedded thread retirement underflow");
+		return;
+	}
+	live_embedded_threads--;
+	pthread_cond_broadcast(&shutdown_condition);
+	pthread_mutex_unlock(&shutdown_lock);
+}
+
+static void retire_task_carrier(void *unused)
+{
+	struct darwin_task_thread *task = get_current_host_task();
+	uintptr_t expected = (uintptr_t)pthread_self();
+	int cpu;
+
+	(void)unused;
+	/* A shutdown checkpoint can retire a carrier without a scheduler handoff.
+	 * Release its virtual CPU ownership here.  Ordinary dead-task and restart
+	 * paths have already cleared task->cpu, and the compare/exchange also makes
+	 * this safe after shutdown_kernel() released the current CPU explicitly.
+	 */
+	if (task != NULL) {
+		pthread_mutex_lock(&task->lock);
+		cpu = task->cpu;
+		if (cpu >= 0 && cpu < CONFIG_NR_CPUS) {
+			(void)__atomic_compare_exchange_n(&cpu_execution_owner[cpu],
+				&expected, 0, 0, __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+			task->cpu = -1;
+			task->runnable = 0;
+		}
+		pthread_mutex_unlock(&task->lock);
+		set_current_host_task(NULL);
+		remove_task(task);
+		darwin_retire_cpu_thread(pthread_self());
+		task_put(task);
+	}
+	darwin_release_embedded_thread();
+}
+
+int darwin_task_shutdown_requested(void)
+{
+	return __atomic_load_n(&shutdown_mode, __ATOMIC_ACQUIRE) >= 0;
+}
+
+int darwin_wait_for_embedded_threads(unsigned int timeout_ms)
+{
+	struct timespec deadline;
+	int error = 0;
+
+	if (clock_gettime(CLOCK_REALTIME, &deadline) != 0)
+		return -errno;
+	deadline.tv_sec += timeout_ms / 1000;
+	deadline.tv_nsec += (long)(timeout_ms % 1000) * 1000000L;
+	if (deadline.tv_nsec >= 1000000000L) {
+		deadline.tv_sec++;
+		deadline.tv_nsec -= 1000000000L;
+	}
+
+	pthread_mutex_lock(&shutdown_lock);
+	while (live_embedded_threads != 0 && error == 0)
+		error = pthread_cond_timedwait(&shutdown_condition,
+					       &shutdown_lock, &deadline);
+	if (live_embedded_threads == 0)
+		error = 0;
+	pthread_mutex_unlock(&shutdown_lock);
+	return error == 0 ? 0 : -error;
+}
+
+static void acquire_cpu_execution(int cpu)
+{
+	uintptr_t expected = 0;
+	uintptr_t owner = (uintptr_t)pthread_self();
+
+	if (cpu < 0 || cpu >= CONFIG_NR_CPUS ||
+	    !__atomic_compare_exchange_n(&cpu_execution_owner[cpu], &expected,
+					 owner, 0, __ATOMIC_ACQUIRE,
+					 __ATOMIC_RELAXED))
+		panic("Darwin: CPU%d has overlapping execution carriers", cpu);
+}
+
+static void release_cpu_execution(int cpu)
+{
+	uintptr_t expected = (uintptr_t)pthread_self();
+
+	if (cpu < 0 || cpu >= CONFIG_NR_CPUS ||
+	    !__atomic_compare_exchange_n(&cpu_execution_owner[cpu], &expected, 0,
+					 0, __ATOMIC_RELEASE,
+					 __ATOMIC_RELAXED))
+		panic("Darwin: CPU%d execution carrier ownership was lost", cpu);
+}
+
+static int boundary_profile_enabled(void)
+{
+	static int enabled = -1;
+
+	if (enabled < 0)
+		enabled = getenv("UML_PROFILE_TRAPS") != NULL;
+	return enabled;
+}
+
+static int static_dispatch_trace_enabled(void)
+{
+	static int enabled = -1;
+	static int minimum_pid = -1;
+	static int exact_pid = -1;
+
+	if (enabled < 0) {
+		const char *minimum;
+
+		enabled = getenv("UML_STATIC_TRACE") != NULL;
+		minimum = getenv("UML_STATIC_TRACE_MIN_PID");
+		minimum_pid = minimum == NULL ? 0 : atoi(minimum);
+		minimum = getenv("UML_STATIC_TRACE_PID");
+		exact_pid = minimum == NULL ? 0 : atoi(minimum);
+	}
+	return enabled && get_current_pid() >= minimum_pid &&
+		(exact_pid == 0 || get_current_pid() == exact_pid);
+}
+
+void darwin_enable_cooperative_timers(void)
+{
+	/* Stop the process-wide source and initialize every per-CPU deadline
+	 * before publishing cooperative mode to the other CPU carriers.
+	 */
+	darwin_timer_enable_cooperative();
+	__atomic_store_n(&cooperative_timers, 1, __ATOMIC_RELEASE);
+	timer_signal_mask(SIG_BLOCK, NULL);
+}
+
+int darwin_timers_cooperative(void)
+{
+	return __atomic_load_n(&cooperative_timers, __ATOMIC_ACQUIRE) != 0;
+}
+
+static void timer_signal_mask(int how, sigset_t *old_mask)
+{
+	sigset_t mask;
+
+	sigemptyset(&mask);
+	sigaddset(&mask, SIGALRM);
+	if (pthread_sigmask(how, &mask, old_mask) != 0)
+		panic("Darwin: unable to update task timer signal mask");
+}
+
+static void task_get(struct darwin_task_thread *task)
+{
+	__atomic_fetch_add(&task->references, 1, __ATOMIC_RELAXED);
+}
+
+static void task_put(struct darwin_task_thread *task)
+{
+	if (__atomic_fetch_sub(&task->references, 1, __ATOMIC_ACQ_REL) != 1)
+		return;
+	pthread_cond_destroy(&task->condition);
+	pthread_mutex_destroy(&task->lock);
+	free(task);
+}
+
+static unsigned long task_bucket_for(jmp_buf *key)
+{
+	uintptr_t value = (uintptr_t)key >> 4;
+
+	/* Linux task switch buffers occur at the same offset in power-of-two
+	 * aligned kernel stacks.  Fold higher address bits down so thousands of
+	 * short-lived shell tasks do not alternate between only two buckets.
+	 */
+	value ^= value >> 12;
+	value ^= value >> 24;
+	return value & (DARWIN_TASK_HASH_BUCKETS - 1);
+}
+
+static void create_task_bucket_locks(void)
+{
+	unsigned long bucket;
+
+	for (bucket = 0; bucket < DARWIN_TASK_HASH_BUCKETS; bucket++)
+		if (pthread_mutex_init(&task_bucket_locks[bucket], NULL) != 0)
+			panic("Darwin: unable to initialize task registry bucket");
+}
+
+static void initialize_task_bucket_locks(void)
+{
+	if (pthread_once(&task_bucket_locks_once,
+			 create_task_bucket_locks) != 0)
+		panic("Darwin: unable to initialize task registry");
+}
+
+static struct darwin_task_thread *find_task_locked(jmp_buf *key)
+{
+	struct darwin_task_thread *task;
+	unsigned long bucket = task_bucket_for(key);
+
+	for (task = task_buckets[bucket]; task != NULL;
+	     task = task->hash_next)
+		if (task->key == key)
+			return task;
+	return NULL;
+}
+
+static struct darwin_task_thread *find_task(jmp_buf *key)
+{
+	struct darwin_task_thread *task;
+	unsigned long bucket = task_bucket_for(key);
+
+	initialize_task_bucket_locks();
+	pthread_mutex_lock(&task_bucket_locks[bucket]);
+	task = find_task_locked(key);
+	if (task != NULL)
+		task_get(task);
+	pthread_mutex_unlock(&task_bucket_locks[bucket]);
+	return task;
+}
+
+static void remove_task_locked(struct darwin_task_thread *task)
+{
+	unsigned long bucket = task_bucket_for(task->key);
+
+	if (task->previous != NULL)
+		task->previous->next = task->next;
+	else
+		task_threads = task->next;
+	if (task->next != NULL)
+		task->next->previous = task->previous;
+	if (task->hash_previous != NULL)
+		task->hash_previous->hash_next = task->hash_next;
+	else
+		task_buckets[bucket] = task->hash_next;
+	if (task->hash_next != NULL)
+		task->hash_next->hash_previous = task->hash_previous;
+}
+
+static void register_task(struct darwin_task_thread *task)
+{
+	unsigned long bucket = task_bucket_for(task->key);
+
+	initialize_task_bucket_locks();
+	pthread_mutex_lock(&task_list_lock);
+	pthread_mutex_lock(&task_bucket_locks[bucket]);
+	task->previous = NULL;
+	task->next = task_threads;
+	if (task_threads != NULL)
+		task_threads->previous = task;
+	task_threads = task;
+	task->hash_previous = NULL;
+	task->hash_next = task_buckets[bucket];
+	if (task_buckets[bucket] != NULL)
+		task_buckets[bucket]->hash_previous = task;
+	task_buckets[bucket] = task;
+	pthread_mutex_unlock(&task_bucket_locks[bucket]);
+	pthread_mutex_unlock(&task_list_lock);
+}
+
+static void remove_task(struct darwin_task_thread *task)
+{
+	unsigned long bucket = task_bucket_for(task->key);
+
+	initialize_task_bucket_locks();
+	pthread_mutex_lock(&task_list_lock);
+	pthread_mutex_lock(&task_bucket_locks[bucket]);
+	remove_task_locked(task);
+	pthread_mutex_unlock(&task_bucket_locks[bucket]);
+	pthread_mutex_unlock(&task_list_lock);
+}
+
+static int wait_until_runnable(struct darwin_task_thread *task)
+{
+	while (!task->runnable &&
+	       __atomic_load_n(&shutdown_mode, __ATOMIC_ACQUIRE) < 0)
+		pthread_cond_wait(&task->condition, &task->lock);
+	return task->runnable;
+}
+
+static void *task_entry_main(void *argument)
+{
+	struct darwin_task_thread *task = argument;
+	int cpu;
+
+	set_current_host_task(task);
+	/* Every new carrier starts with the process-wide timer blocked.  It is
+	 * unblocked only while running before the SMP-wide cooperative switch.
+	 */
+	timer_signal_mask(SIG_BLOCK, NULL);
+	os_local_ipi_disable();
+	pthread_mutex_lock(&task->lock);
+	if (!wait_until_runnable(task)) {
+		pthread_mutex_unlock(&task->lock);
+		return NULL;
+	}
+	cpu = task->cpu;
+	pthread_mutex_unlock(&task->lock);
+	acquire_cpu_execution(cpu);
+	darwin_set_current_cpu(cpu);
+	/* Before the SMP-wide cooperative transition, the sole process timer is
+	 * CPU0's clockevent and must never execute on a secondary carrier.
+	 */
+	if (!darwin_timers_cooperative() && cpu == 0)
+		timer_signal_mask(SIG_UNBLOCK, NULL);
+	if (__atomic_load_n(&shutdown_mode, __ATOMIC_ACQUIRE) < 0) {
+		task->entry();
+	}
+	return NULL;
+}
+
+static void *task_entry(void *argument)
+{
+	void *result;
+
+	pthread_cleanup_push(retire_task_carrier, NULL);
+	result = task_entry_main(argument);
+	pthread_cleanup_pop(1);
+	return result;
+}
+
+static struct darwin_task_thread *create_task(void *stack, jmp_buf *key,
+					      void (*entry)(void))
+{
+	struct darwin_task_thread *task = calloc(1, sizeof(*task));
+	pthread_attr_t attributes;
+	sigset_t previous_mask;
+	unsigned long long create_start = 0;
+	int error;
+
+	if (task == NULL)
+		return NULL;
+	task->key = key;
+	task->entry = entry;
+	task->cpu = -1;
+	task->references = 1;
+	if (pthread_mutex_init(&task->lock, NULL) != 0) {
+		free(task);
+		return NULL;
+	}
+	if (pthread_cond_init(&task->condition, NULL) != 0) {
+		pthread_mutex_destroy(&task->lock);
+		free(task);
+		return NULL;
+	}
+	if (!darwin_reserve_embedded_thread()) {
+		pthread_cond_destroy(&task->condition);
+		pthread_mutex_destroy(&task->lock);
+		free(task);
+		return NULL;
+	}
+	(*key)[0].JB_IP = (unsigned long)entry;
+	(*key)[0].JB_SP = (unsigned long)stack + UM_THREAD_SIZE - sizeof(void *);
+
+	register_task(task);
+
+	if (pthread_attr_init(&attributes) != 0) {
+		remove_task(task);
+		task_put(task);
+		darwin_release_embedded_thread();
+		return NULL;
+	}
+	if (pthread_attr_setdetachstate(&attributes,
+					PTHREAD_CREATE_DETACHED) != 0) {
+		pthread_attr_destroy(&attributes);
+		remove_task(task);
+		task_put(task);
+		darwin_release_embedded_thread();
+		return NULL;
+	}
+	/*
+	 * Darwin's pthread startup code uses the supplied stack before task_entry
+	 * runs.  Keep that native implementation detail away from the Linux task
+	 * stack: the latter is guest-kernel state and can have Linux-sized guard
+	 * and protection boundaries which do not match the host's 16 KiB pages.
+	 *
+	 * current is maintained by cpu_tasks[] on UML, so a Darwin-managed native
+	 * stack does not change Linux task identity.  switch_buf still records the
+	 * corresponding Linux stack for the kernel's task bookkeeping.
+	 */
+	/* pthread signal masks are inherited.  Always create the new carrier with
+	 * the process-wide timer blocked, then let task_entry decide whether the
+	 * pre-SMP asynchronous source is still in use.
+	 */
+	timer_signal_mask(SIG_BLOCK, &previous_mask);
+	if (boundary_profile_enabled())
+		create_start = os_nsecs();
+	error = pthread_create(&task->thread, &attributes, task_entry, task);
+	if (boundary_profile_enabled()) {
+		profile_add(&profile_thread_create_ns,
+			    os_nsecs() - create_start);
+		profile_add(&profile_thread_creates, 1);
+	}
+	if (pthread_sigmask(SIG_SETMASK, &previous_mask, NULL) != 0)
+		panic("Darwin: unable to restore creator timer signal mask");
+	pthread_attr_destroy(&attributes);
+	if (error != 0) {
+		remove_task(task);
+		task_put(task);
+		darwin_release_embedded_thread();
+		return NULL;
+	}
+	return task;
+}
+
+void new_thread(void *stack, jmp_buf *buffer, void (*handler)(void))
+{
+	if (create_task(stack, buffer, handler) == NULL)
+		panic("Darwin: unable to create task pthread");
+}
+
+void switch_threads_dead(jmp_buf *from_key, jmp_buf *to_key, int from_dead)
+{
+	struct darwin_task_thread *from;
+	struct darwin_task_thread *to;
+	int from_referenced = 0;
+	int cpu;
+
+	/* Avoid timer re-entry while the host scheduling lock is held. */
+	os_local_ipi_disable();
+	/* A carrier must not receive the process-wide timer after it gives up its
+	 * virtual CPU.  If cooperative mode becomes active while this task waits,
+	 * leave the timer blocked permanently when it resumes.
+	 */
+	timer_signal_mask(SIG_BLOCK, NULL);
+	from = get_current_host_task();
+	if (from == NULL || from->key != from_key) {
+		from = find_task(from_key);
+		from_referenced = 1;
+	}
+	to = find_task(to_key);
+	if (from == NULL || to == NULL || from == to) {
+		if (from_referenced && from != NULL)
+			task_put(from);
+		if (to != NULL)
+			task_put(to);
+		panic("Darwin: scheduler thread mapping is missing");
+	}
+	pthread_mutex_lock(&from->lock);
+	pthread_mutex_lock(&to->lock);
+	cpu = from->cpu;
+	if (cpu < 0 || to->runnable || to->cpu >= 0) {
+		pthread_mutex_unlock(&to->lock);
+		pthread_mutex_unlock(&from->lock);
+		task_put(to);
+		if (from_referenced)
+			task_put(from);
+		panic("Darwin: invalid SMP task handoff from CPU %d", cpu);
+	}
+	from->runnable = 0;
+	from->cpu = -1;
+	release_cpu_execution(cpu);
+	to->cpu = cpu;
+	to->runnable = 1;
+	darwin_publish_cpu_thread(cpu, to->thread);
+	pthread_cond_signal(&to->condition);
+	pthread_mutex_unlock(&to->lock);
+	task_put(to);
+	if (from_dead) {
+		pthread_t retiring_thread = from->thread;
+
+		pthread_mutex_unlock(&from->lock);
+		remove_task(from);
+		set_current_host_task(NULL);
+		/* Drop the registry ownership transferred by removal, followed by the
+		 * uncommon lookup reference when TLS recovery was necessary.
+		 */
+		task_put(from);
+		if (from_referenced)
+			task_put(from);
+		darwin_retire_cpu_thread(retiring_thread);
+		pthread_exit(NULL);
+	}
+	if (!wait_until_runnable(from)) {
+		pthread_t retiring_thread = from->thread;
+
+		pthread_mutex_unlock(&from->lock);
+		remove_task(from);
+		set_current_host_task(NULL);
+		task_put(from);
+		if (from_referenced)
+			task_put(from);
+		darwin_retire_cpu_thread(retiring_thread);
+		pthread_exit(NULL);
+	}
+	cpu = from->cpu;
+	pthread_mutex_unlock(&from->lock);
+	if (from_referenced)
+		task_put(from);
+	acquire_cpu_execution(cpu);
+	darwin_set_current_cpu(cpu);
+	/* Timer signal state belongs to the virtual CPU, not to the Linux task's
+	 * pthread.  A task may resume on a different CPU, so derive the native mask
+	 * from its new CPU rather than restoring the mask it had before migration.
+	 */
+	if (!darwin_timers_cooperative() && cpu == 0)
+		timer_signal_mask(SIG_UNBLOCK, NULL);
+}
+
+void switch_threads(jmp_buf *from_key, jmp_buf *to_key)
+{
+	switch_threads_dead(from_key, to_key, 0);
+}
+
+int start_idle_thread(void *stack, jmp_buf *switch_buffer)
+{
+	struct darwin_task_thread *initial;
+
+	initial = create_task(stack, switch_buffer, uml_finishsetup);
+	if (initial == NULL)
+		return 0;
+	/* The launcher thread only supervises shutdown after this point. */
+	timer_signal_mask(SIG_BLOCK, NULL);
+	pthread_mutex_lock(&initial->lock);
+	initial->cpu = 0;
+	initial->runnable = 1;
+	darwin_publish_cpu_thread(0, initial->thread);
+	pthread_cond_signal(&initial->condition);
+	pthread_mutex_unlock(&initial->lock);
+	pthread_mutex_lock(&shutdown_lock);
+	while (__atomic_load_n(&shutdown_mode, __ATOMIC_ACQUIRE) < 0)
+		pthread_cond_wait(&shutdown_condition, &shutdown_lock);
+	pthread_mutex_unlock(&shutdown_lock);
+	return __atomic_load_n(&shutdown_mode, __ATOMIC_ACQUIRE);
+}
+
+#if IS_ENABLED(CONFIG_SMP)
+void darwin_activate_secondary_task(jmp_buf *key, int cpu)
+{
+	struct darwin_task_thread *task;
+
+	task = find_task(key);
+	if (task == NULL)
+		panic("Darwin: secondary CPU %d has no idle task", cpu);
+	pthread_mutex_lock(&task->lock);
+	if (task->runnable || task->cpu >= 0) {
+		pthread_mutex_unlock(&task->lock);
+		task_put(task);
+		panic("Darwin: secondary CPU %d has no idle task", cpu);
+	}
+	task->cpu = cpu;
+	task->runnable = 1;
+	darwin_publish_cpu_thread(cpu, task->thread);
+	pthread_cond_signal(&task->condition);
+	pthread_mutex_unlock(&task->lock);
+	task_put(task);
+}
+
+void __attribute__((noreturn)) darwin_restart_secondary_task(void *stack,
+							      jmp_buf *key,
+							      int cpu)
+{
+	struct darwin_task_thread *replacement;
+	struct darwin_task_thread *retiring;
+	pthread_t retiring_thread;
+
+	/* A physical CPU restarts at its secondary entry point with a clean
+	 * stack.  Preserve that contract for UML instead of recursively entering
+	 * cpu_startup_entry() on the parked idle pthread's old shutdown stack.
+	 * The Linux idle task and its switch-buffer key remain unchanged; only
+	 * their Darwin execution carrier is replaced.
+	 */
+	retiring = get_current_host_task();
+	if (retiring == NULL || retiring->key != key)
+		panic("Darwin: CPU%d has no restartable idle task", cpu);
+	pthread_mutex_lock(&retiring->lock);
+	if (retiring->cpu != cpu || !retiring->runnable) {
+		pthread_mutex_unlock(&retiring->lock);
+		panic("Darwin: CPU%d has no restartable idle task", cpu);
+	}
+	retiring_thread = retiring->thread;
+	retiring->runnable = 0;
+	retiring->cpu = -1;
+	release_cpu_execution(cpu);
+	pthread_mutex_unlock(&retiring->lock);
+	remove_task(retiring);
+
+	replacement = create_task(stack, key, new_thread_handler);
+	if (replacement == NULL)
+		panic("Darwin: unable to recreate CPU%d idle task", cpu);
+	darwin_activate_secondary_task(key, cpu);
+
+	set_current_host_task(NULL);
+	task_put(retiring);
+	darwin_retire_cpu_thread(retiring_thread);
+	pthread_exit(NULL);
+}
+#endif
+
+void initial_thread_cb_skas(void (*procedure)(void *), void *argument)
+{
+	procedure(argument);
+}
+
+static void shutdown_kernel(int reboot)
+{
+	struct darwin_task_thread *task;
+	struct darwin_task_thread *current_task;
+
+	if (boundary_profile_enabled())
+		os_warn("Darwin boundary ns: count=%llu activate=%llu sync=%llu "
+			"guest=%llu stack=%llu syscall=%llu "
+			"fault=%llu thread_creates=%llu thread_create=%llu\n",
+			profile_read(&profile_boundaries),
+			profile_read(&profile_activate_ns),
+			profile_read(&profile_sync_ns),
+			profile_read(&profile_guest_ns),
+			profile_read(&profile_stack_ns),
+			profile_read(&profile_syscall_ns),
+			profile_read(&profile_fault_ns),
+			profile_read(&profile_thread_creates),
+			profile_read(&profile_thread_create_ns));
+
+	current_task = get_current_host_task();
+	if (current_task != NULL) {
+		pthread_mutex_lock(&current_task->lock);
+		if (current_task->cpu >= 0)
+			release_cpu_execution(current_task->cpu);
+		pthread_mutex_unlock(&current_task->lock);
+	}
+	pthread_mutex_lock(&shutdown_lock);
+	__atomic_store_n(&shutdown_mode, reboot, __ATOMIC_RELEASE);
+	pthread_cond_broadcast(&shutdown_condition);
+	pthread_mutex_unlock(&shutdown_lock);
+	pthread_mutex_lock(&task_list_lock);
+	for (task = task_threads; task != NULL; task = task->next) {
+		pthread_mutex_lock(&task->lock);
+		pthread_cond_signal(&task->condition);
+		pthread_mutex_unlock(&task->lock);
+	}
+	pthread_mutex_unlock(&task_list_lock);
+	darwin_wake_cpu_threads_for_shutdown();
+	pthread_exit(NULL);
+}
+
+#ifndef CONFIG_PAGE_SIZE_16KB
+static int reconcile_implicit_stack_quarter(struct uml_pt_regs *registers)
+{
+	unsigned long stack_pointer = UPT_SP(registers);
+	int signal_code;
+	int staged;
+
+	staged = darwin_uml_vm_stage_stack(stack_pointer);
+	if (staged <= 0)
+		return staged;
+	/*
+	 * The 16 KiB host slot made this otherwise-unmapped 4 KiB stack page
+	 * temporarily accessible.  Resolve the Linux write fault now, then let
+	 * the runtime merge the bytes staged from the anonymous host quarter
+	 * into the newly allocated Linux physical page.
+	 */
+	if (handle_page_fault(stack_pointer, UPT_IP(registers), 1, 1,
+			      &signal_code) < 0) {
+		(void)darwin_uml_vm_finish_stack(stack_pointer);
+		return -1;
+	}
+	current_mm_force_sync(stack_pointer);
+	return darwin_uml_vm_finish_stack(stack_pointer);
+}
+
+static int syscall_snapshots_address_space(struct uml_pt_regs *registers)
+{
+	/* handle_syscall() copies architectural x8 into uml_pt_regs.syscall,
+	 * but this decision must happen before handle_syscall() builds the
+	 * child's COW page tables.  Read the current trap's x8 directly rather
+	 * than the previous syscall retained in the bookkeeping field.
+	 */
+	switch (UPT_X(registers, 8)) {
+	case __NR_clone:
+		/* CLONE_VM (including the usual CLONE_VFORK exec path) shares
+		 * the current mm and does not construct COW page tables.  Flushing
+		 * and write-protecting every shadow slot in that case only forces the
+		 * shared parent/child address space to refault clean pages.
+		 */
+		return !(UPT_X(registers, 0) & DARWIN_CLONE_VM);
+#ifdef __NR_clone3
+	case __NR_clone3:
+#endif
+		/* Linux builds a forked child's COW page tables from the physical
+		 * backing pages while the parent's latest userspace writes still
+		 * live in Darwin's private 4 KiB shadows.  Snapshot the active mm
+		 * before copy_mm() can observe stale heap or stack contents.  This
+		 * is harmless for CLONE_VM and keeps clone3 handling independent of
+		 * reading its userspace argument structure here.
+		 */
+		return 1;
+	default:
+		return 0;
+	}
+}
+#endif
+
+void halt_skas(void)
+{
+	shutdown_kernel(0);
+}
+
+void reboot_skas(void)
+{
+	shutdown_kernel(1);
+}
+
+int is_skas_winch(int pid, int fd, void *data)
+{
+	(void)pid;
+	(void)fd;
+	(void)data;
+	return 0;
+}
+
+static void fatal_userspace(struct uml_pt_regs *registers,
+			    const char *operation, int error)
+{
+	os_warn("Darwin: %s failed (%d) ip=0x%lx sp=0x%lx syscall=%ld\n",
+		operation, error, UPT_IP(registers), UPT_SP(registers),
+		(long)UPT_SYSCALL_NR(registers));
+	fatal_sigsegv();
+}
+
+static int floating_point_signal_code(unsigned int syndrome)
+{
+	if (!(syndrome & DARWIN_UML_FLOATING_POINT_TFV))
+		return DARWIN_GUEST_FPE_FLTUNK;
+	if (syndrome & DARWIN_UML_FLOATING_POINT_INVALID)
+		return DARWIN_GUEST_FPE_FLTINV;
+	if (syndrome & DARWIN_UML_FLOATING_POINT_DIVIDE_BY_ZERO)
+		return DARWIN_GUEST_FPE_FLTDIV;
+	if (syndrome & DARWIN_UML_FLOATING_POINT_OVERFLOW)
+		return DARWIN_GUEST_FPE_FLTOVF;
+	if (syndrome & DARWIN_UML_FLOATING_POINT_UNDERFLOW)
+		return DARWIN_GUEST_FPE_FLTUND;
+	if (syndrome & DARWIN_UML_FLOATING_POINT_INEXACT)
+		return DARWIN_GUEST_FPE_FLTRES;
+	return DARWIN_GUEST_FPE_FLTUNK;
+}
+
+void userspace(struct uml_pt_regs *registers)
+{
+	/* Deliver the host timer only at kernel/guest boundaries.  Allowing a
+	 * POSIX handler to schedule from the native guest register window would
+	 * strand a Linux task inside hard-IRQ context on another pthread.
+	 */
+	if (!darwin_timers_cooperative())
+		change_sig(SIGALRM, 0);
+	darwin_timer_poll(registers);
+	interrupt_end();
+	for (;;) {
+		struct mm_id *mm_id = current_mm_id();
+		unsigned long guest_tls;
+		const unsigned int *guest_ipi_sequence;
+		unsigned int guest_ipi_snapshot;
+		unsigned long long profile_start = 0;
+		int profiling = boundary_profile_enabled();
+		int event;
+#ifndef CONFIG_PAGE_SIZE_16KB
+		int snapshots_mm;
+#endif
+
+		/*
+		 * This loop is Darwin's user-mode return path.  Cooperative timer or
+		 * reschedule handling may have handed the vCPU to this task on a
+		 * different pthread while the per-CPU logical IRQ state was masked.
+		 * Native entry code and Linux-host UML restore IRQs before executing
+		 * user mode; do the equivalent explicitly before both guest execution
+		 * and the syscall entry which follows it.
+		 */
+		unblock_signals();
+
+		if (static_dispatch_trace_enabled())
+			os_warn("Darwin static loop begin cpu=%d pid=%d ip=%#lx generation=%lu\n",
+				uml_curr_cpu(), get_current_pid(), UPT_IP(registers),
+				mm_id == NULL ? 0 :
+				mm_id->darwin_generation);
+
+		if (profiling) {
+			profile_add(&profile_boundaries, 1);
+			profile_start = os_nsecs();
+		}
+		int result = darwin_uml_vm_activate(mm_id == NULL ? 0 :
+						    mm_id->darwin_generation);
+		if (profiling) {
+			profile_add(&profile_activate_ns,
+				    os_nsecs() - profile_start);
+			profile_start = os_nsecs();
+		}
+
+		if (result < 0)
+			fatal_userspace(registers, "VM activation", result);
+		current_mm_sync();
+		if (profiling) {
+			profile_add(&profile_sync_ns,
+				    os_nsecs() - profile_start);
+			profile_start = os_nsecs();
+		}
+		/* The active mapping generation is the process's live address space. Linux
+		 * copy_{to,from}_user accesses these same host addresses, and mapping
+		 * changes enter the runtime through current_mm_sync().  Rebuilding and
+		 * writing every mapped page at each syscall is therefore redundant.
+		 * darwin_uml_vm_activate() provides the coherence boundary when the
+		 * scheduler changes mm; map/protect/unmap rebuild affected slots.
+		 */
+		registers->is_user = 1;
+		guest_tls = current_tls();
+		/* Snapshot before polling so an IPI racing with the poll remains
+		 * visible to the translated-block check.  Polling may migrate this
+		 * task, so repeat until the vCPU identity is stable.
+		 */
+		do {
+			int snapshot_cpu = uml_curr_cpu();
+
+			guest_ipi_snapshot = darwin_ipi_guest_snapshot(
+				&guest_ipi_sequence);
+			darwin_ipi_poll();
+			if (snapshot_cpu == uml_curr_cpu())
+				break;
+		} while (1);
+		if (darwin_uml_static_guest_interrupt_sequence(
+			guest_ipi_sequence, guest_ipi_snapshot) < 0)
+			fatal_userspace(registers, "interrupt registration", -1);
+		darwin_ipi_guest_begin();
+		event = darwin_uml_enter_guest(registers, registers->fp,
+				host_fp_size,
+				mm_id == NULL ? 0 : mm_id->darwin_generation,
+				&guest_tls);
+		darwin_ipi_guest_end();
+		/*
+		 * Close the guest-to-kernel IPI race before handling an event that
+		 * may block.  A sender can publish an IPI after the translated loop's
+		 * final sequence check but before guest_executing is cleared.  Such a
+		 * sender deliberately omits the idle pipe edge because this boundary
+		 * is responsible for consuming the pending vector.
+		 */
+		darwin_ipi_poll();
+		if (static_dispatch_trace_enabled())
+			os_warn("Darwin static boundary cpu=%d pid=%d event=%d ip=%#lx sp=%#lx nr=%#lx x0=%#lx x1=%#lx x2=%#lx x19=%#lx x25=%#lx fault=%#lx execute=%d write=%d\n",
+				uml_curr_cpu(), get_current_pid(), event,
+				UPT_IP(registers), UPT_SP(registers),
+				UPT_X(registers, 8), UPT_X(registers, 0),
+				UPT_X(registers, 1), UPT_X(registers, 2),
+				UPT_X(registers, 19), UPT_X(registers, 25),
+				FAULT_ADDRESS(registers->faultinfo),
+				event == DARWIN_UML_EVENT_FAULT ?
+					FAULT_EXECUTE(registers->faultinfo) : 0,
+				event == DARWIN_UML_EVENT_FAULT ?
+					FAULT_WRITE(registers->faultinfo) : 0);
+		if (profiling) {
+			profile_add(&profile_guest_ns,
+				    os_nsecs() - profile_start);
+			profile_start = os_nsecs();
+		}
+		current_set_tls(guest_tls);
+		/*
+		 * Sample an expired cooperative deadline before changing the frame
+		 * to kernel mode.  The elapsed interval ended in translated
+		 * userspace even when its next architectural boundary is a syscall
+		 * or fault.  Deferring this sample until after that kernel work can
+		 * charge every tick to stime in a tight user/syscall loop.
+		 *
+		 * A second poll in the epilogue accounts a deadline which expires
+		 * while handling the event as kernel time.  The first poll consumes
+		 * an already-expired deadline, so the two boundaries cannot charge
+		 * one clock event twice.
+		 */
+		darwin_timer_poll(registers);
+		registers->is_user = 0;
+		if (static_dispatch_trace_enabled())
+			os_warn("Darwin static boundary TLS reconciled\n");
+#ifndef CONFIG_PAGE_SIZE_16KB
+		result = reconcile_implicit_stack_quarter(registers);
+		if (static_dispatch_trace_enabled())
+			os_warn("Darwin static boundary stack result=%d\n", result);
+		if (profiling)
+			profile_add(&profile_stack_ns,
+				    os_nsecs() - profile_start);
+		if (result < 0)
+			fatal_userspace(registers, "stack-quarter reconciliation",
+					result);
+#endif
+		switch (event) {
+		case DARWIN_UML_EVENT_SYSCALL:
+			if (profiling)
+				profile_start = os_nsecs();
+			registers->orig_x0 = UPT_X(registers, 0);
+#ifndef CONFIG_PAGE_SIZE_16KB
+			snapshots_mm = syscall_snapshots_address_space(registers);
+			if (snapshots_mm && darwin_uml_vm_flush_active() < 0)
+				fatal_userspace(registers, "pre-clone VM snapshot", -1);
+#endif
+			handle_syscall(registers);
+			if (static_dispatch_trace_enabled())
+				os_warn("Darwin static syscall cpu=%d pid=%d nr=%ld ret=%#lx\n",
+					uml_curr_cpu(), get_current_pid(),
+					(long)UPT_SYSCALL_NR(registers),
+					UPT_X(registers, 0));
+			if (profiling) {
+				profile_add(&profile_syscall_ns,
+					    os_nsecs() - profile_start);
+			}
+			/* copy_mm() records the parent's COW protection changes in
+			 * UML's normal TLB synchronization state.  The next userspace
+			 * boundary replays those changes, and Darwin's mixed-slot write
+			 * validation checks the live Linux PTEs before granting RW.
+			 * Replaying the entire mm here made every process creation scale
+			 * with its address-space size.
+			 */
+			break;
+		case DARWIN_UML_EVENT_FAULT:
+		{
+			unsigned long fault = FAULT_ADDRESS(registers->faultinfo);
+			int retry;
+
+			if (profiling)
+				profile_start = os_nsecs();
+
+			/* A valid 4 KiB Linux PTE may still be an unmaterialized
+			 * quarter of a 16 KiB Darwin VM slot.  Force all four PTEs
+			 * into the shadow MMU before asking Linux to resolve a real
+			 * guest page fault.
+			 */
+			if (fault >= 4096 && fault < 0x600000000000UL) {
+				if (static_dispatch_trace_enabled())
+					os_warn("Darwin static fault sync begin address=%#lx execute=%d write=%d\n",
+						fault, FAULT_EXECUTE(registers->faultinfo),
+						FAULT_WRITE(registers->faultinfo));
+				current_mm_force_sync(fault);
+				if (static_dispatch_trace_enabled())
+					os_warn("Darwin static fault sync complete address=%#lx\n",
+						fault);
+				retry = darwin_uml_vm_retry_fault(fault,
+					FAULT_EXECUTE(registers->faultinfo),
+					FAULT_WRITE(registers->faultinfo));
+				if (static_dispatch_trace_enabled())
+					os_warn("Darwin static fault retry address=%#lx result=%d\n",
+						fault, retry);
+				if (retry < 0)
+					fatal_userspace(registers, "fault retry", retry);
+				/* A 16 KiB host slot can combine writable and Linux-COW
+				 * 4 KiB siblings.  Resolve COW eagerly for every writable
+				 * sibling before falling back to a breakpoint-guarded store.
+				 * Otherwise a large userspace write takes two host exceptions
+				 * per instruction even though copying at most three adjacent
+				 * Linux pages makes the complete slot safely writable.
+				 */
+				if (retry == 2) {
+					if (current_mm_prefault_host_slot(fault, 1) < 0)
+						fatal_userspace(registers,
+							"mixed-slot COW prefault", -1);
+					retry = darwin_uml_vm_retry_fault(fault, 0, 1);
+					if (retry < 0)
+						fatal_userspace(registers,
+							"mixed-slot write retry", retry);
+				}
+				if (retry == 2) {
+					if (darwin_uml_begin_write_single_step(
+						fault, UPT_IP(registers)) <= 0)
+						fatal_userspace(registers,
+							"post-store breakpoint", -1);
+					break;
+				}
+				if (retry > 0)
+					break;
+			}
+			segv(registers->faultinfo, UPT_IP(registers), 1,
+			     registers, NULL);
+			if (fault >= 4096 && fault < 0x600000000000UL) {
+				int write = FAULT_WRITE(registers->faultinfo);
+
+				if (current_mm_prefault_host_slot(fault, write) < 0)
+					fatal_userspace(registers,
+						"host-slot prefault", -1);
+				/* A store which Linux just resolved should not take a
+				 * second protection fault merely to mark its clean Darwin
+				 * shadow dirty.  Grant the now-writable slot before retrying
+				 * the instruction.  Mixed permission slots retain the
+				 * hardware post-store breakpoint path.
+				 */
+				if (write) {
+					retry = darwin_uml_vm_retry_fault(fault, 0, 1);
+					if (retry < 0)
+						fatal_userspace(registers,
+							"resolved write retry", retry);
+					if (retry == 2 &&
+					    darwin_uml_begin_write_single_step(
+						fault, UPT_IP(registers)) <= 0)
+						fatal_userspace(registers,
+							"post-store breakpoint", -1);
+				}
+			}
+			if (profiling)
+				profile_add(&profile_fault_ns,
+					    os_nsecs() - profile_start);
+			break;
+		}
+		case DARWIN_UML_EVENT_INTERRUPT:
+			break;
+		case DARWIN_UML_EVENT_FLOATING_POINT_TRAP:
+		{
+			siginfo_t signal_info = { 0 };
+			unsigned int syndrome =
+				(unsigned int)registers->faultinfo.error_code;
+
+			signal_info.si_signo = SIGFPE;
+			signal_info.si_errno = 0;
+			signal_info.si_code =
+				floating_point_signal_code(syndrome);
+			signal_info.si_addr = (void *)UPT_IP(registers);
+			registers->is_user = 1;
+			block_signals_trace();
+			relay_signal(SIGFPE, (struct siginfo *)&signal_info,
+				     registers, NULL);
+			unblock_signals_trace();
+			registers->is_user = 0;
+			break;
+		}
+		case DARWIN_UML_EVENT_ILLEGAL_INSTRUCTION:
+		{
+			siginfo_t signal_info = { 0 };
+
+			/* UDF and other architecturally undefined instructions are
+			 * guest events, not failures of the host dispatcher.  Preserve
+			 * the faulting PC so SA_SIGINFO handlers and the saved AArch64
+			 * signal context observe the native SIGILL contract.
+			 */
+			registers->faultinfo.error_code = 0;
+			registers->faultinfo.cr2 = UPT_IP(registers);
+			registers->faultinfo.trap_no = 0;
+			signal_info.si_signo = SIGILL;
+			signal_info.si_errno = 0;
+			signal_info.si_code = ILL_ILLOPC;
+			signal_info.si_addr = (void *)UPT_IP(registers);
+			registers->is_user = 1;
+			block_signals_trace();
+			relay_signal(SIGILL, (struct siginfo *)&signal_info,
+				     registers, NULL);
+			unblock_signals_trace();
+			registers->is_user = 0;
+			break;
+		}
+		case DARWIN_UML_EVENT_PC_ALIGNMENT:
+		{
+			siginfo_t signal_info = { 0 };
+
+			/* Match native arm64's PC-alignment exception contract.  The
+			 * engine leaves the architectural PC at the misaligned address;
+			 * report that address as SIGBUS/BUS_ADRALN without retiring the
+			 * instruction at the invalid fetch boundary. */
+			registers->faultinfo.error_code = 0;
+			registers->faultinfo.cr2 = UPT_IP(registers);
+			registers->faultinfo.trap_no = 0;
+			signal_info.si_signo = SIGBUS;
+			signal_info.si_errno = 0;
+			signal_info.si_code = BUS_ADRALN;
+			signal_info.si_addr = (void *)UPT_IP(registers);
+			registers->is_user = 1;
+			block_signals_trace();
+			relay_signal(SIGBUS, (struct siginfo *)&signal_info,
+				     registers, NULL);
+			unblock_signals_trace();
+			registers->is_user = 0;
+			break;
+		}
+		case DARWIN_UML_EVENT_GCS_FAULT:
+		{
+			siginfo_t signal_info = { 0 };
+
+			/* Match native arm64: guarded-control-stack exceptions report
+			 * the faulting instruction address as SEGV_CPERR, not as an
+			 * ordinary page fault or an undefined instruction. */
+			registers->faultinfo.error_code = 0;
+			registers->faultinfo.cr2 = UPT_IP(registers);
+			registers->faultinfo.trap_no = 0;
+			signal_info.si_signo = SIGSEGV;
+			signal_info.si_errno = 0;
+			signal_info.si_code = DARWIN_GUEST_SEGV_CPERR;
+			signal_info.si_addr = (void *)UPT_IP(registers);
+			registers->is_user = 1;
+			block_signals_trace();
+			relay_signal(SIGSEGV, (struct siginfo *)&signal_info,
+				     registers, NULL);
+			unblock_signals_trace();
+			registers->is_user = 0;
+			break;
+		}
+		case DARWIN_UML_EVENT_BREAKPOINT:
+		{
+			siginfo_t signal_info = { 0 };
+
+			registers->faultinfo.error_code = 0;
+			registers->faultinfo.cr2 = UPT_IP(registers);
+			registers->faultinfo.trap_no = 0;
+			signal_info.si_signo = SIGTRAP;
+			signal_info.si_errno = 0;
+			signal_info.si_code = TRAP_BRKPT;
+			signal_info.si_addr = (void *)UPT_IP(registers);
+			registers->is_user = 1;
+			block_signals_trace();
+			relay_signal(SIGTRAP, (struct siginfo *)&signal_info,
+				     registers, NULL);
+			unblock_signals_trace();
+			registers->is_user = 0;
+			break;
+		}
+		default:
+			os_warn("Darwin: fatal guest event %d at ip 0x%lx\n",
+				event, UPT_IP(registers));
+			fatal_sigsegv();
+		}
+		if (static_dispatch_trace_enabled())
+			os_warn("Darwin static epilogue timer begin\n");
+		darwin_timer_poll(registers);
+		if (static_dispatch_trace_enabled())
+			os_warn("Darwin static epilogue timer complete\n");
+		interrupt_end();
+		if (static_dispatch_trace_enabled())
+			os_warn("Darwin static epilogue interrupt complete\n");
+		if (!darwin_timers_cooperative()) {
+			change_sig(SIGALRM, 1);
+			change_sig(SIGALRM, 0);
+		}
+	}
+}
diff --git a/arch/um/os-Darwin/smp.c b/arch/um/os-Darwin/smp.c
new file mode 100644
index 000000000..e05157ba5
--- /dev/null
+++ b/arch/um/os-Darwin/smp.c
@@ -0,0 +1,461 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <sched.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <kern_util.h>
+#include <os.h>
+#include <smp.h>
+#include "internal.h"
+
+struct cpu_thread_data {
+	int cpu;
+};
+
+static pthread_key_t current_cpu_key;
+static pthread_once_t current_cpu_once = PTHREAD_ONCE_INIT;
+static uintptr_t cpu_threads[CONFIG_NR_CPUS];
+static uintptr_t cpu_thread_hazards[CONFIG_NR_CPUS];
+static unsigned int pending_ipis[CONFIG_NR_CPUS];
+static unsigned int guest_ipi_sequences[CONFIG_NR_CPUS];
+static unsigned char guest_executing[CONFIG_NR_CPUS];
+static unsigned char ipi_idle_waiting[CONFIG_NR_CPUS];
+static int ipi_wake_pipes[CONFIG_NR_CPUS][2] = {
+	[0 ... CONFIG_NR_CPUS - 1] = { -1, -1 },
+};
+static pthread_mutex_t futex_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t futex_condition = PTHREAD_COND_INITIALIZER;
+
+static void create_current_cpu_key(void)
+{
+	if (pthread_key_create(&current_cpu_key, NULL) != 0)
+		panic("Darwin: unable to create current CPU key");
+}
+
+int uml_curr_cpu(void)
+{
+	uintptr_t encoded;
+
+	if (pthread_once(&current_cpu_once, create_current_cpu_key) != 0)
+		panic("Darwin: unable to initialize current CPU key");
+	encoded = (uintptr_t)pthread_getspecific(current_cpu_key);
+	return encoded == 0 ? 0 : (int)encoded - 1;
+}
+
+void darwin_publish_cpu_thread(int cpu, pthread_t thread)
+{
+	if (cpu < 0 || cpu >= CONFIG_NR_CPUS)
+		panic("Darwin: invalid virtual CPU %d", cpu);
+	__atomic_store_n(&cpu_threads[cpu], (uintptr_t)thread, __ATOMIC_RELEASE);
+}
+
+void darwin_retire_cpu_thread(pthread_t thread)
+{
+	uintptr_t retiring = (uintptr_t)thread;
+	uintptr_t expected;
+	int cpu;
+
+	/* Stop new IPI senders from acquiring this pthread before waiting for a
+	 * sender which already validated it.  Normal scheduler handoff has already
+	 * published a replacement, so the compare/exchange leaves that target intact.
+	 * pthread_t stops being valid as soon as a detached Darwin pthread exits.
+	 */
+	for (cpu = 0; cpu < uml_ncpus; cpu++) {
+		expected = retiring;
+		(void)__atomic_compare_exchange_n(&cpu_threads[cpu], &expected, 0, 0,
+						  __ATOMIC_ACQ_REL,
+						  __ATOMIC_ACQUIRE);
+	}
+	for (;;) {
+		for (cpu = 0; cpu < uml_ncpus; cpu++)
+			if (__atomic_load_n(&cpu_thread_hazards[cpu],
+					    __ATOMIC_ACQUIRE) == retiring)
+				break;
+		if (cpu == uml_ncpus)
+			return;
+		sched_yield();
+	}
+}
+
+void darwin_set_current_cpu(int cpu)
+{
+	char name[32];
+
+	if (pthread_once(&current_cpu_once, create_current_cpu_key) != 0 ||
+	    pthread_setspecific(current_cpu_key,
+		(void *)(uintptr_t)(cpu + 1)) != 0)
+		panic("Darwin: unable to set current virtual CPU");
+	snprintf(name, sizeof(name), "uml-vcpu%d", cpu);
+	(void)pthread_setname_np(name);
+	darwin_publish_cpu_thread(cpu, pthread_self());
+}
+
+static void drain_ipis(void)
+{
+	int cpu = uml_curr_cpu();
+	int previous;
+	unsigned int pending;
+
+	/*
+	 * Linux hardirq/softirq exit leaves local IRQs disabled for the
+	 * architecture entry code to restore.  Darwin can enter here either
+	 * asynchronously from the pthread signal handler or cooperatively at a
+	 * guest boundary, so provide that outer save/disable/restore pairing in
+	 * both cases.
+	 */
+	previous = um_set_signals(0);
+	/*
+	 * A sender leaves one pipe edge when the target is in host kernel or idle
+	 * code.  Consume that edge whenever the corresponding pending mask is
+	 * handled, not only after pselect().  Otherwise kernel-boundary delivery
+	 * clears pending_ipis while stale bytes accumulate until the nonblocking
+	 * pipe is full and can no longer wake a genuinely idle vCPU.
+	 */
+	darwin_ipi_idle_drain();
+	pending = __atomic_exchange_n(&pending_ipis[cpu], 0, __ATOMIC_ACQUIRE);
+	uml_ipi_handler_mask(pending);
+	um_set_signals(previous);
+}
+
+void darwin_ipi_poll(void)
+{
+	int cpu;
+
+	if (darwin_task_shutdown_requested())
+		pthread_exit(NULL);
+	/* Finishing a reschedule batch may resume this task on another virtual
+	 * CPU.  Recheck there before returning so callers never continue from an
+	 * IPI boundary with a stale CPU identity or an already-pending local
+	 * callback queue.
+	 */
+	do {
+		cpu = uml_curr_cpu();
+		if (__atomic_load_n(&pending_ipis[cpu], __ATOMIC_ACQUIRE))
+			drain_ipis();
+	} while (cpu != uml_curr_cpu());
+	if (darwin_task_shutdown_requested())
+		pthread_exit(NULL);
+}
+
+int darwin_ipi_idle_fd(void)
+{
+	return ipi_wake_pipes[uml_curr_cpu()][0];
+}
+
+void darwin_ipi_idle_begin(void)
+{
+	__atomic_store_n(&ipi_idle_waiting[uml_curr_cpu()], 1, __ATOMIC_RELEASE);
+}
+
+void darwin_ipi_idle_end(void)
+{
+	__atomic_store_n(&ipi_idle_waiting[uml_curr_cpu()], 0, __ATOMIC_RELEASE);
+}
+
+unsigned int darwin_ipi_guest_snapshot(const unsigned int **sequence)
+{
+	int cpu = uml_curr_cpu();
+
+	*sequence = &guest_ipi_sequences[cpu];
+	return __atomic_load_n(*sequence, __ATOMIC_ACQUIRE);
+}
+
+void darwin_ipi_guest_begin(void)
+{
+	__atomic_store_n(&guest_executing[uml_curr_cpu()], 1, __ATOMIC_RELEASE);
+}
+
+void darwin_ipi_guest_end(void)
+{
+	__atomic_store_n(&guest_executing[uml_curr_cpu()], 0, __ATOMIC_RELEASE);
+}
+
+void darwin_wake_cpu_threads_for_shutdown(void)
+{
+	char wake = 1;
+	int current = uml_curr_cpu();
+	int cpu;
+
+	/* A sequence change makes every execution engine leave translated guest
+	 * code at its next bounded block.  The pipe wakes an idle carrier.  No Linux
+	 * IPI vector is queued: the normal STOP vector deliberately parks a CPU and
+	 * would prevent the host pthread lifetime barrier from completing.
+	 */
+	for (cpu = 0; cpu < uml_ncpus; cpu++) {
+		if (cpu == current)
+			continue;
+		__atomic_fetch_add(&guest_ipi_sequences[cpu], 1, __ATOMIC_RELEASE);
+		if (ipi_wake_pipes[cpu][1] >= 0 &&
+		    write(ipi_wake_pipes[cpu][1], &wake, sizeof(wake)) < 0 &&
+		    errno != EAGAIN)
+			os_warn("Darwin: unable to wake CPU%d for shutdown: %d\n",
+				cpu, errno);
+	}
+}
+
+void darwin_ipi_idle_drain(void)
+{
+	char bytes[64];
+	int fd = darwin_ipi_idle_fd();
+	int saved_errno = errno;
+	struct pollfd ready = { .fd = fd, .events = POLLIN };
+
+	if (fd < 0)
+		return;
+	/* Do not rely solely on O_NONBLOCK here.  Darwin accepted F_SETFL for
+	 * these early-boot pipe descriptors but an empty follow-up read could
+	 * still sleep.  Polling before every bounded drain makes this helper
+	 * unconditionally nonblocking.
+	 */
+	while (poll(&ready, 1, 0) > 0 && (ready.revents & POLLIN)) {
+		if (read(fd, bytes, sizeof(bytes)) <= 0)
+			break;
+		ready.revents = 0;
+	}
+	errno = saved_errno;
+}
+
+static void ipi_signal_handler(int signal)
+{
+	int saved_errno = errno;
+
+	(void)signal;
+	/* pthread_kill() is only a wake edge.  Running Linux hardirq and scheduler
+	 * code from an arbitrary Darwin signal frame can enter libpthread while
+	 * the interrupted thread owns one of its locks.  The pending vector is
+	 * drained at the next translated-guest, syscall, timer, or idle boundary.
+	 */
+	errno = saved_errno;
+}
+
+void os_local_ipi_enable(void)
+{
+	/* IPI signals only wake; logical IRQ state controls cooperative drain. */
+}
+
+void os_local_ipi_disable(void)
+{
+	/* IPI signals only wake; logical IRQ state controls cooperative drain. */
+}
+
+int os_send_ipi(int cpu, int vector)
+{
+	unsigned int previous_pending;
+	char wake = 1;
+	int target_in_guest;
+	int pipe_error = 0;
+	int sender;
+	uintptr_t target;
+	int error;
+
+	if (cpu < 0 || cpu >= uml_ncpus || vector < 0 || vector >= 32)
+		return -EINVAL;
+	/* Make a translated target leave at its next bounded block even if the
+	 * Darwin signal is delayed or resumes the interrupted host instruction.
+	 */
+	__atomic_fetch_add(&guest_ipi_sequences[cpu], 1, __ATOMIC_RELEASE);
+	previous_pending = __atomic_fetch_or(&pending_ipis[cpu], 1U << vector,
+					    __ATOMIC_RELEASE);
+	target_in_guest = __atomic_load_n(&guest_executing[cpu],
+					  __ATOMIC_ACQUIRE);
+	/* A pipe is the reliable idle wake transport.  Darwin can restart an
+	 * interrupted pselect or pthread wait even when a signal handler is meant
+	 * to be only a wake edge.  One byte is sufficient for every transition
+	 * from no pending vectors to at least one; the pending bitmask coalesces
+	 * later IPIs until the target drains it.  A target already executing guest
+	 * code observes guest_ipi_sequences at every translated block and must not
+	 * receive a pipe byte: there is no host wait to wake, and its boundary will
+	 * consume the pending mask directly.
+	 */
+	if (previous_pending == 0 && !target_in_guest &&
+	    ipi_wake_pipes[cpu][1] >= 0 &&
+	    write(ipi_wake_pipes[cpu][1], &wake, sizeof(wake)) < 0 &&
+	    errno != EAGAIN)
+		pipe_error = -errno;
+	/* An idle target is waiting on the pipe above.  Avoid a Darwin signal for
+	 * that common case: pthread_kill() is substantially more expensive than
+	 * the coalesced pipe edge and was the dominant active cost in SMP wakeup
+	 * profiles.  The idle flag is published before pselect(), so an edge sent
+	 * during the transition remains readable when the target starts waiting.
+	 */
+	if (pipe_error == 0 &&
+	    __atomic_load_n(&ipi_idle_waiting[cpu], __ATOMIC_ACQUIRE))
+		return 0;
+	/* A translated target polls guest_ipi_sequences every block.  It needs
+	 * neither the much slower pthread_kill() nor an asynchronous host frame;
+	 * the normal interrupt boundary below will drain pending_ipis safely.
+	 */
+	if (pipe_error == 0 && target_in_guest)
+		return 0;
+	sender = uml_curr_cpu();
+	/* Publish the target as a hazard before validating it.  A retiring target
+	 * either observes the hazard and stays alive through pthread_kill(), or it
+	 * publishes its replacement first and makes this sender retry.  This also
+	 * removes an uncatchable Darwin libpthread hard-trap race under fork/I/O
+	 * pressure without serializing every IPI on the scheduler mutex.
+	 */
+	for (;;) {
+		target = __atomic_load_n(&cpu_threads[cpu], __ATOMIC_ACQUIRE);
+		if (target == 0)
+			return pipe_error;
+		__atomic_store_n(&cpu_thread_hazards[sender], target,
+				 __ATOMIC_RELEASE);
+		if (__atomic_load_n(&cpu_threads[cpu], __ATOMIC_ACQUIRE) ==
+		    target)
+			break;
+		__atomic_store_n(&cpu_thread_hazards[sender], 0,
+				 __ATOMIC_RELEASE);
+	}
+	error = pthread_kill((pthread_t)target, DARWIN_IPI_SIGNAL);
+	__atomic_store_n(&cpu_thread_hazards[sender], 0, __ATOMIC_RELEASE);
+	if (error == 0 || error == ESRCH)
+		return 0;
+	return pipe_error != 0 ? pipe_error : -error;
+}
+
+static void release_cpu_bootstrap(void *unused)
+{
+	(void)unused;
+	darwin_release_embedded_thread();
+}
+
+static void *cpu_thread(void *argument)
+{
+	struct cpu_thread_data *data = argument;
+
+	pthread_cleanup_push(release_cpu_bootstrap, NULL);
+	darwin_set_current_cpu(data->cpu);
+	uml_start_secondary(data);
+	pthread_cleanup_pop(1);
+	return NULL;
+}
+
+int os_start_cpu_thread(int cpu)
+{
+	struct cpu_thread_data *data;
+	pthread_attr_t attributes;
+	pthread_t thread;
+	sigset_t block;
+	sigset_t previous;
+	int error;
+
+	data = malloc(sizeof(*data));
+	if (data == NULL)
+		return -ENOMEM;
+	data->cpu = cpu;
+	if (!darwin_reserve_embedded_thread()) {
+		free(data);
+		return -ESHUTDOWN;
+	}
+	error = pthread_attr_init(&attributes);
+	if (error == 0)
+		error = pthread_attr_setdetachstate(&attributes,
+						PTHREAD_CREATE_DETACHED);
+	if (error != 0) {
+		darwin_release_embedded_thread();
+		free(data);
+		return -error;
+	}
+	sigemptyset(&block);
+	sigaddset(&block, SIGALRM);
+	error = pthread_sigmask(SIG_BLOCK, &block, &previous);
+	if (error == 0)
+		error = pthread_create(&thread, &attributes, cpu_thread, data);
+	if (pthread_sigmask(SIG_SETMASK, &previous, NULL) != 0)
+		panic("Darwin: unable to restore CPU creator signal mask");
+	pthread_attr_destroy(&attributes);
+	if (error != 0) {
+		darwin_release_embedded_thread();
+		free(data);
+		return -error;
+	}
+	return 0;
+}
+
+void os_start_secondary(void *argument, jmp_buf *switch_buffer)
+{
+	struct cpu_thread_data *data = argument;
+	int cpu = data->cpu;
+
+	darwin_activate_secondary_task(switch_buffer, cpu);
+	free(data);
+	darwin_retire_cpu_thread(pthread_self());
+	pthread_exit(NULL);
+}
+
+void __attribute__((noreturn)) os_restart_secondary(void *stack,
+						     jmp_buf *switch_buffer)
+{
+	darwin_restart_secondary_task(stack, switch_buffer, uml_curr_cpu());
+}
+
+void os_init_smp(void)
+{
+	struct sigaction action = { };
+	sigset_t unblock;
+	int cpu;
+	int flags;
+
+	for (cpu = 0; cpu < uml_ncpus; cpu++) {
+		if (pipe(ipi_wake_pipes[cpu]) < 0)
+			panic("Darwin: unable to create CPU%d IPI wake pipe: %d",
+			      cpu, errno);
+		flags = fcntl(ipi_wake_pipes[cpu][0], F_GETFL);
+		if (flags < 0 || fcntl(ipi_wake_pipes[cpu][0], F_SETFL,
+					flags | O_NONBLOCK) < 0)
+			panic("Darwin: unable to configure CPU%d IPI read pipe", cpu);
+		flags = fcntl(ipi_wake_pipes[cpu][1], F_GETFL);
+		if (flags < 0 || fcntl(ipi_wake_pipes[cpu][1], F_SETFL,
+					flags | O_NONBLOCK) < 0)
+			panic("Darwin: unable to configure CPU%d IPI write pipe", cpu);
+		(void)fcntl(ipi_wake_pipes[cpu][0], F_SETFD, FD_CLOEXEC);
+		(void)fcntl(ipi_wake_pipes[cpu][1], F_SETFD, FD_CLOEXEC);
+	}
+
+	action.sa_handler = ipi_signal_handler;
+	/* The handler deliberately does not run Linux interrupt code.  Its only
+	 * purpose is to make a target blocked in pselect() return to the idle
+	 * boundary, where darwin_ipi_poll() can drain the pending vector safely.
+	 * SA_RESTART defeats that contract on Darwin and can leave a reschedule
+	 * IPI pending indefinitely while an idle vCPU remains asleep.
+	 */
+	action.sa_flags = SA_ONSTACK;
+	sigfillset(&action.sa_mask);
+	if (sigaction(DARWIN_IPI_SIGNAL, &action, NULL) < 0)
+		panic("Darwin: unable to install IPI handler: %d", errno);
+	sigemptyset(&unblock);
+	sigaddset(&unblock, DARWIN_IPI_SIGNAL);
+	if (pthread_sigmask(SIG_UNBLOCK, &unblock, NULL) != 0)
+		panic("Darwin: unable to unblock IPI wake signal");
+	darwin_set_current_cpu(0);
+}
+
+void os_idle_prepare(void)
+{
+	darwin_ipi_poll();
+}
+
+int os_futex_wait(void *address, unsigned int value)
+{
+	pthread_mutex_lock(&futex_lock);
+	while (__atomic_load_n((unsigned int *)address, __ATOMIC_ACQUIRE) == value)
+		pthread_cond_wait(&futex_condition, &futex_lock);
+	pthread_mutex_unlock(&futex_lock);
+	return 0;
+}
+
+int os_futex_wake(void *address)
+{
+	(void)address;
+	pthread_mutex_lock(&futex_lock);
+	pthread_cond_broadcast(&futex_condition);
+	pthread_mutex_unlock(&futex_lock);
+	return 0;
+}
diff --git a/arch/um/os-Darwin/start_up.c b/arch/um/os-Darwin/start_up.c
new file mode 100644
index 000000000..623321096
--- /dev/null
+++ b/arch/um/os-Darwin/start_up.c
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <init.h>
+#include <kern_util.h>
+#include <os.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "bridge.h"
+
+int os_num_processors(void)
+{
+	long count = sysconf(_SC_NPROCESSORS_ONLN);
+
+	return count > 0 ? (int)count : 1;
+}
+
+void os_early_checks(void)
+{
+}
+
+void os_check_bugs(void)
+{
+}
+
+void check_host_supports_tls(int *supports_tls, int *tls_min)
+{
+	*supports_tls = 1;
+	*tls_min = 0;
+}
+
+void get_host_cpu_features(void (*flags_helper)(char *),
+			   void (*cache_helper)(char *))
+{
+	static const struct {
+		unsigned int bit;
+		const char *name;
+	} advertised[] = {
+		{ 0, "fp" },
+		{ 1, "asimd" },
+		{ 3, "aes" },
+		{ 4, "pmull" },
+		{ 5, "sha1" },
+		{ 6, "sha2" },
+		{ 7, "crc32" },
+		{ 8, "atomics" },
+		{ 17, "sha3" },
+		{ 21, "sha512" },
+	};
+	const unsigned long hwcap = darwin_uml_guest_hwcap();
+	char features[128] = "Features\t:";
+	char cache[] = "cache_alignment\t: 64";
+	unsigned int i;
+
+	for (i = 0; i < sizeof(advertised) / sizeof(advertised[0]); ++i) {
+		if (!(hwcap & (1UL << advertised[i].bit)))
+			continue;
+		strcat(features, " ");
+		strcat(features, advertised[i].name);
+	}
+
+	flags_helper(features);
+	cache_helper(cache);
+}
+
+int parse_iomem(char *string, int *add)
+{
+	(void)string;
+	*add = 0;
+	os_warn("iomem= is not supported by the Darwin backend\n");
+	return 1;
+}
diff --git a/arch/um/os-Darwin/time.c b/arch/um/os-Darwin/time.c
new file mode 100644
index 000000000..06199debb
--- /dev/null
+++ b/arch/um/os-Darwin/time.c
@@ -0,0 +1,280 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <time.h>
+#include <unistd.h>
+#include <irq_user.h>
+#include <kern_util.h>
+#include <os.h>
+#include <smp.h>
+#include "irq.h"
+#include "internal.h"
+
+struct darwin_cpu_timer {
+	unsigned long long delay_ns;
+	unsigned long long deadline_ns;
+	int active;
+	int periodic;
+};
+
+static struct darwin_cpu_timer cpu_timers[CONFIG_NR_CPUS];
+
+static struct darwin_cpu_timer *timer_for_cpu(int cpu)
+{
+	if (cpu < 0 || cpu >= CONFIG_NR_CPUS)
+		panic("Darwin: invalid timer CPU %d", cpu);
+	return &cpu_timers[cpu];
+}
+
+static long long timespec_to_ns(const struct timespec *time)
+{
+	return (long long)time->tv_sec * UM_NSEC_PER_SEC + time->tv_nsec;
+}
+
+static int timer_trace_enabled(void)
+{
+	static int enabled = -1;
+
+	if (enabled < 0)
+		enabled = getenv("UML_TIMER_TRACE") != NULL;
+	return enabled;
+}
+
+long long os_persistent_clock_emulation(void)
+{
+	struct timespec time;
+
+	clock_gettime(CLOCK_REALTIME, &time);
+	return timespec_to_ns(&time);
+}
+
+long long os_nsecs(void)
+{
+	struct timespec time;
+
+	clock_gettime(CLOCK_MONOTONIC, &time);
+	return timespec_to_ns(&time);
+}
+
+int os_timer_create(void)
+{
+	memset(timer_for_cpu(uml_curr_cpu()), 0,
+	       sizeof(struct darwin_cpu_timer));
+	return 0;
+}
+
+static int set_timer(int cpu, unsigned long long nsecs, int periodic)
+{
+	struct darwin_cpu_timer *state = timer_for_cpu(cpu);
+	struct itimerval timer = { };
+	unsigned long long usecs = (nsecs + 999) / 1000;
+
+	state->delay_ns = nsecs;
+	state->deadline_ns = (unsigned long long)os_nsecs() + nsecs;
+	state->active = 1;
+	state->periodic = periodic;
+	if (usecs == 0)
+		usecs = 1;
+	timer.it_value.tv_sec = usecs / 1000000;
+	timer.it_value.tv_usec = usecs % 1000000;
+	if (periodic)
+		timer.it_interval = timer.it_value;
+	if (timer_trace_enabled())
+		os_warn("Darwin timer CPU%d: set %s %llu ns\n", cpu,
+			periodic ? "periodic" : "one-shot", nsecs);
+	if (darwin_timers_cooperative() || cpu != 0)
+		return 0;
+	if (setitimer(ITIMER_REAL, &timer, NULL) < 0)
+		return -errno;
+	return 0;
+}
+
+int os_timer_set_interval(int cpu, unsigned long long nsecs)
+{
+	return set_timer(cpu, nsecs, 1);
+}
+
+int os_timer_one_shot(int cpu, unsigned long long nsecs)
+{
+	return set_timer(cpu, nsecs, 0);
+}
+
+void os_timer_disable(int cpu)
+{
+	struct darwin_cpu_timer *state = timer_for_cpu(cpu);
+	struct itimerval timer = { };
+
+	state->active = 0;
+	state->deadline_ns = 0;
+	if (timer_trace_enabled())
+		os_warn("Darwin timer CPU%d: disable\n", cpu);
+	if (cpu == 0 && !darwin_timers_cooperative())
+		setitimer(ITIMER_REAL, &timer, NULL);
+}
+
+void darwin_timer_enable_cooperative(void)
+{
+	struct itimerval timer = { };
+	unsigned long long now = (unsigned long long)os_nsecs();
+	int cpu;
+
+	/* ITIMER_REAL is process-directed on Darwin and can remain associated
+	 * with a UML pthread which the guest scheduler has parked.  From this
+	 * point onward the idle path and safe guest/kernel boundaries own the
+	 * monotonic deadline and deliver clock interrupts from a UML kernel
+	 * context.
+	 */
+	setitimer(ITIMER_REAL, &timer, NULL);
+	for (cpu = 0; cpu < CONFIG_NR_CPUS; cpu++)
+		if (cpu_timers[cpu].active)
+			cpu_timers[cpu].deadline_ns = now +
+				cpu_timers[cpu].delay_ns;
+	if (timer_trace_enabled())
+		os_warn("Darwin timer: cooperative deadline enabled\n");
+}
+
+static int consume_expired_timer(struct darwin_cpu_timer *state,
+				 unsigned long long now)
+{
+	if (!state->active || now < state->deadline_ns)
+		return 0;
+	if (state->periodic) {
+		do {
+			state->deadline_ns += state->delay_ns;
+		} while (state->deadline_ns <= now);
+	} else {
+		state->active = 0;
+		state->deadline_ns = 0;
+	}
+	return 1;
+}
+
+void darwin_timer_poll(struct uml_pt_regs *registers)
+{
+	struct darwin_cpu_timer *state;
+	unsigned long long now;
+	int cpu;
+
+	darwin_ipi_poll();
+	/* IPI completion may schedule this task on another virtual CPU. */
+	cpu = uml_curr_cpu();
+	state = timer_for_cpu(cpu);
+	if (!darwin_timers_cooperative() || !state->active)
+		return;
+	now = (unsigned long long)os_nsecs();
+	if (consume_expired_timer(state, now)) {
+		int previous = um_set_signals(0);
+
+		/*
+		 * Darwin does not provide Linux-style per-thread SIGIO ownership.
+		 * CPU0 therefore owns host descriptor polling.  Do it at the same
+		 * safe clock boundary while CPU0 is busy as well as from its idle
+		 * path; otherwise a CPU-bound guest can starve console and network
+		 * readiness indefinitely.
+		 */
+		if (cpu == 0)
+			sigio_handler(SIGIO, NULL, registers, NULL);
+		timer_handler(SIGALRM, NULL, registers);
+		um_set_signals(previous);
+	}
+}
+
+void os_idle_sleep(void)
+{
+	int cpu = uml_curr_cpu();
+	struct darwin_cpu_timer *state = timer_for_cpu(cpu);
+
+	if (!darwin_timers_cooperative()) {
+		pause();
+	} else {
+		sigset_t mask;
+		sigset_t previous_mask;
+		fd_set read_fds;
+		struct uml_pt_regs registers;
+		struct timespec timeout;
+		struct timespec *timeout_pointer = NULL;
+		unsigned long long now;
+		unsigned long long remaining;
+		int ipi_fd;
+		int fire_timer = 0;
+
+		if (cpu == 0)
+			darwin_irq_idle_begin(&previous_mask);
+		else
+			pthread_sigmask(SIG_SETMASK, NULL, &previous_mask);
+		pthread_sigmask(SIG_SETMASK, NULL, &mask);
+		if (cpu == 0)
+			sigdelset(&mask, SIGUSR2);
+		sigdelset(&mask, DARWIN_IPI_SIGNAL);
+		/* Drain readiness which appeared before the kqueue waiter was
+		 * published.  Any later edge queues SIGUSR2 while it is blocked,
+		 * making the following pselect race-free.
+		 */
+		memset(&registers, 0, sizeof(registers));
+		if (cpu == 0)
+			sigio_handler(SIGIO, NULL, &registers, NULL);
+		if (state->active) {
+			now = (unsigned long long)os_nsecs();
+			remaining = state->deadline_ns > now ?
+				state->deadline_ns - now : 0;
+			timeout.tv_sec = (time_t)(remaining / UM_NSEC_PER_SEC);
+			timeout.tv_nsec = (long)(remaining % UM_NSEC_PER_SEC);
+			timeout_pointer = &timeout;
+		}
+		ipi_fd = darwin_ipi_idle_fd();
+		FD_ZERO(&read_fds);
+		if (ipi_fd >= FD_SETSIZE)
+			panic("Darwin: CPU%d IPI wake fd %d exceeds FD_SETSIZE",
+			      cpu, ipi_fd);
+		if (ipi_fd >= 0) {
+			/* Darwin's fortified FD_SET asks libc to validate the backing
+			 * object.  UML kernel stacks are outside a native pthread's
+			 * conventional stack allocation, so that check rejects this valid
+			 * local fd_set and silently leaves it empty.  The explicit bound
+			 * above provides the required safety for the native representation.
+			 */
+			read_fds.fds_bits[(unsigned int)ipi_fd /
+				(sizeof(read_fds.fds_bits[0]) * 8)] |=
+				1U << ((unsigned int)ipi_fd %
+					(sizeof(read_fds.fds_bits[0]) * 8));
+		}
+		darwin_ipi_idle_begin();
+		(void)pselect(ipi_fd >= 0 ? ipi_fd + 1 : 0,
+			      ipi_fd >= 0 ? &read_fds : NULL, NULL, NULL,
+			      timeout_pointer, &mask);
+		/* Clear before draining.  A sender which observed the idle state has
+		 * already left a pipe byte; a later sender will use the signal wake
+		 * path while this CPU processes the completed wait.
+		 */
+		darwin_ipi_idle_end();
+		now = (unsigned long long)os_nsecs();
+		if (state->active)
+			fire_timer = consume_expired_timer(state, now);
+		if (cpu == 0)
+			darwin_irq_idle_end(&previous_mask);
+		else
+			pthread_sigmask(SIG_SETMASK, &previous_mask, NULL);
+		/* Drain the pipe before the bitmask.  An IPI which races after the
+		 * mask exchange leaves a fresh byte readable for the next idle wait;
+		 * one which races before it is included in this drain.
+		 */
+		darwin_ipi_idle_drain();
+		darwin_ipi_poll();
+		if (fire_timer)
+			timer_handler(SIGALRM, NULL, &registers);
+		/* Darwin's poll(2) does not report tty readiness reliably while
+		 * running on the interrupted signal frame.  Re-poll after returning
+		 * to the idle kernel context so console and network fd IRQs wake their
+		 * wait queues.
+		 */
+		memset(&registers, 0, sizeof(registers));
+		if (cpu == 0)
+			sigio_handler(SIGIO, NULL, &registers, NULL);
+	}
+}
diff --git a/arch/um/os-Darwin/tty.c b/arch/um/os-Darwin/tty.c
new file mode 100644
index 000000000..3c1f9f9b6
--- /dev/null
+++ b/arch/um/os-Darwin/tty.c
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <os.h>
+#include "bridge.h"
+
+int get_pty(void)
+{
+	int fd = darwin_uml_open("/dev/ptmx", O_RDWR, 0);
+
+	if (fd < 0)
+		return -errno;
+	if (grantpt(fd) < 0 || unlockpt(fd) < 0) {
+		int error = -errno;
+		close(fd);
+		return error;
+	}
+	return fd;
+}
diff --git a/arch/um/os-Darwin/umid.c b/arch/um/os-Darwin/umid.c
new file mode 100644
index 000000000..d00d373d9
--- /dev/null
+++ b/arch/um/os-Darwin/umid.c
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <os.h>
+
+#define UMID_LENGTH 64
+
+static char umid[UMID_LENGTH] = "darwin";
+
+char *get_umid(void)
+{
+	return umid;
+}
+
+int set_umid(char *name)
+{
+	if (name == NULL || name[0] == '\0')
+		return -EINVAL;
+	if (strlcpy(umid, name, sizeof(umid)) >= sizeof(umid))
+		return -ENAMETOOLONG;
+	return 0;
+}
+
+int umid_file_name(char *name, char *buffer, int length)
+{
+	const char prefix[] = "/tmp/uml-";
+	size_t needed = sizeof(prefix) - 1 + strlen(umid) + 1 + strlen(name) + 1;
+	size_t used;
+
+	if (length < 0 || (size_t)length < needed)
+		return -ENAMETOOLONG;
+	used = strlcpy(buffer, prefix, (size_t)length);
+	used += strlcpy(buffer + used, umid, (size_t)length - used);
+	used += strlcpy(buffer + used, "-", (size_t)length - used);
+	strlcpy(buffer + used, name, (size_t)length - used);
+	return 0;
+}
diff --git a/arch/um/os-Darwin/util.c b/arch/um/os-Darwin/util.c
new file mode 100644
index 000000000..3bdb99632
--- /dev/null
+++ b/arch/um/os-Darwin/util.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/random.h>
+#include <sys/utsname.h>
+#include <termios.h>
+#include <unistd.h>
+#include <init.h>
+#include <os.h>
+#include "bridge.h"
+
+int vscnprintf(char *buffer, size_t size, const char *format, va_list args);
+
+void stack_protections(unsigned long address)
+{
+	if (mprotect((void *)address, UM_THREAD_SIZE,
+		     PROT_READ | PROT_WRITE) < 0)
+		panic("protecting stack failed, errno = %d", errno);
+}
+
+unsigned long os_current_thread_stack_top(void)
+{
+	return (unsigned long)pthread_get_stackaddr_np(pthread_self());
+}
+
+int raw(int fd)
+{
+	struct termios terminal;
+
+	if (tcgetattr(fd, &terminal) < 0)
+		return -errno;
+	cfmakeraw(&terminal);
+	if (tcsetattr(fd, TCSADRAIN, &terminal) < 0)
+		return -errno;
+	return 0;
+}
+
+void setup_machinename(char *machine_out)
+{
+	memcpy(machine_out, "aarch64", sizeof("aarch64"));
+}
+
+void setup_hostinfo(char *buffer, int length)
+{
+	struct utsname host;
+	int used;
+
+	if (length <= 0)
+		return;
+	if (uname(&host) < 0) {
+		buffer[0] = '\0';
+		return;
+	}
+	used = strlcpy(buffer, host.sysname, (size_t)length);
+	if (used < length - 1)
+		used += strlcpy(buffer + used, " ", (size_t)(length - used));
+	if (used < length - 1)
+		strlcpy(buffer + used, host.release, (size_t)(length - used));
+}
+
+ssize_t os_getrandom(void *buffer, size_t length, unsigned int flags)
+{
+	(void)flags;
+	if (getentropy(buffer, length) == 0)
+		return (ssize_t)length;
+	return -1;
+}
+
+void os_fix_helper_signals(void)
+{
+	signal(SIGWINCH, SIG_IGN);
+	signal(SIGINT, SIG_DFL);
+	signal(SIGTERM, SIG_DFL);
+}
+
+void os_dump_core(void)
+{
+	darwin_uml_abort();
+}
+
+void um_early_printk(const char *string, unsigned int length)
+{
+	(void)write(STDERR_FILENO, string, length);
+}
+
+static int quiet_info;
+
+static int quiet_cmd_param(char *string, int *add)
+{
+	(void)string;
+	(void)add;
+	quiet_info = 1;
+	return 0;
+}
+
+__uml_setup("quiet", quiet_cmd_param,
+"quiet\n"
+"    Turns off host information messages during boot.\n\n");
+
+static void host_message(int fd, const char *format, va_list args)
+{
+	char buffer[512];
+	int length = vscnprintf(buffer, sizeof(buffer), format, args);
+
+	if (length > 0)
+		(void)write(fd, buffer, (size_t)length);
+}
+
+void os_info(const char *format, ...)
+{
+	va_list args;
+
+	if (quiet_info)
+		return;
+	va_start(args, format);
+	host_message(STDERR_FILENO, format, args);
+	va_end(args);
+}
+
+void os_warn(const char *format, ...)
+{
+	va_list args;
+
+	va_start(args, format);
+	host_message(STDERR_FILENO, format, args);
+	va_end(args);
+}
