diff --git a/arch/um/os-Darwin/skas/mem.c b/arch/um/os-Darwin/skas/mem.c
new file mode 100644
index 000000000..66322482a
--- /dev/null
+++ b/arch/um/os-Darwin/skas/mem.c
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <os.h>
+#include <errno.h>
+#include <sys/mman.h>
+
+int map(struct mm_id *mm_id, unsigned long address, unsigned long length,
+	int protection, int fd, unsigned long long offset)
+{
+	int execute = !!(protection & UM_PROT_EXEC);
+	int host_protection;
+	int result;
+
+	if (protection & UM_PROT_GUEST_CODE)
+		execute |= 2;
+	if (protection & UM_PROT_GUEST_WRITABLE)
+		execute |= 4;
+	host_protection = (protection & UM_PROT_READ ? PROT_READ : 0) |
+		(protection & UM_PROT_WRITE ? PROT_WRITE : 0) |
+		(execute & 1 ? PROT_EXEC : 0);
+	result = darwin_uml_vm_map_generation(
+		mm_id->darwin_generation, (void *)address, fd, offset, length,
+		host_protection, !!(execute & 2), !!(execute & 4));
+	return result < 0 ? -errno : result;
+}
+
+int unmap(struct mm_id *mm_id, unsigned long address, unsigned long length)
+{
+	int result = darwin_uml_vm_unmap_generation(
+		mm_id->darwin_generation, (void *)address, length);
+
+	return result < 0 ? -errno : result;
+}
