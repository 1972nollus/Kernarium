+#include <pthread.h>
+#include <signal.h>
+#include <sysdep/archsetjmp.h>
+
+#define DARWIN_IPI_SIGNAL SIGUSR1
+
+void darwin_kill_integer_helper(int identifier);
+int darwin_task_shutdown_requested(void);
+int darwin_reserve_embedded_thread(void);
+void darwin_release_embedded_thread(void);
