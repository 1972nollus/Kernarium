+++ b/arch/um/os-Darwin/bridge.h
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UML_DARWIN_BRIDGE_H
+#define __UML_DARWIN_BRIDGE_H
+
+/* Generated from the tracked outer ABI source by kernel/abi/sync.sh. */
+#include "uml_darwin_bridge.h"
