diff --git a/arch/um/os-Darwin/main.c b/arch/um/os-Darwin/main.c
new file mode 100644
index 000000000..cf597442f
--- /dev/null
+++ b/arch/um/os-Darwin/main.c
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <signal.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <as-layout.h>
+#include <irq_user.h>
+#include <kern_util.h>
+#include <os.h>
+#include "internal.h"
+
+long elf_aux_hwcap;
+
+static void fatal_exit(int signal)
+{
+	uml_cleanup();
+	_exit(128 + signal);
+}
+
+static void install_fatal_handler(int signal)
+{
+	struct sigaction action = { };
+
+	sigemptyset(&action.sa_mask);
+	action.sa_handler = fatal_exit;
+	action.sa_flags = SA_RESETHAND | SA_NODEFER;
+	if (sigaction(signal, &action, NULL) < 0)
+		_exit(127);
+}
+
+int main(int argc, char **argv, char **envp)
+{
+	int error;
+	int result;
+
+	install_fatal_handler(SIGINT);
+	install_fatal_handler(SIGTERM);
+	change_sig(SIGPIPE, 0);
+	result = linux_main(argc, argv, envp);
+	error = darwin_wait_for_embedded_threads(10000);
+	if (error != 0) {
+		os_warn("Darwin UML: embedded threads did not retire: %d\n", error);
+		/* Returning would let the embedded ELF loader unmap code which a live
+		 * pthread can still execute.  Terminate without unwinding instead.
+		 */
+		_exit(2);
+	}
+	error = deactivate_all_fds();
+	if (error != 0)
+		os_warn("Darwin UML: deactivate_all_fds failed: %d\n", error);
+	os_timer_disable(0);
+	unblock_signals();
+	os_warn("Darwin UML stopped: result=%d exitcode=%d\n",
+		result, uml_exitcode);
+	return result ? 2 : uml_exitcode;
+}
