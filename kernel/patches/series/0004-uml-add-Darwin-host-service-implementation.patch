diff --git a/arch/um/os-Darwin/signal.c b/arch/um/os-Darwin/signal.c
new file mode 100644
index 000000000..297d5b15b
--- /dev/null
+++ b/arch/um/os-Darwin/signal.c
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <mach/arm/thread_status.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ucontext.h>
+#include <unistd.h>
+#include <kern_util.h>
+#include <irq_user.h>
+#include <os.h>
+#include <sysdep/faultinfo.h>
+#include <sysdep/ptrace.h>
+#include <smp.h>
+
+#define UML_ARM64_FAULT_PAGE 14
+
+struct darwin_signal_state {
+	volatile sig_atomic_t enabled;
+	volatile sig_atomic_t alarm_pending;
+	volatile sig_atomic_t alarm_active;
+};
+
+/*
+ * A Linux context switch does not save and restore local IRQ state as task
+ * state.  The outgoing task leaves that state on the CPU and the incoming
+ * task continues with it until the architecture return path restores IRQs.
+ *
+ * Darwin task pthreads can move between UML CPUs.  Keeping this state in
+ * pthread-specific storage therefore lets an incoming task bring the IRQ
+ * state of its previous CPU into the middle of the new CPU's scheduler
+ * handoff.  Keep it with the UML CPU instead.  The Darwin scheduler guarantees
+ * that only one pthread executes on a virtual CPU at a time; sig_atomic_t also
+ * permits the host signal handler to inspect the same state safely.
+ */
+static struct darwin_signal_state signal_states[CONFIG_NR_CPUS];
+
+static struct darwin_signal_state *local_signal_state(void)
+{
+	return &signal_states[uml_curr_cpu()];
+}
+
+void (*sig_info[NSIG])(int, struct siginfo *, struct uml_pt_regs *, void *) = {
+	[SIGTRAP] = relay_signal,
+	[SIGFPE] = relay_signal,
+	[SIGILL] = relay_signal,
+	[SIGWINCH] = winch,
+	[SIGBUS] = relay_signal,
+	[SIGSEGV] = segv_handler,
+	[SIGIO] = sigio_handler,
+	[SIGCHLD] = sigchld_handler,
+};
+
+static void registers_from_ucontext(struct uml_pt_regs *registers,
+				    const ucontext_t *context)
+{
+	const arm_thread_state64_t *state = &context->uc_mcontext->__ss;
+	unsigned int index;
+
+	memset(registers, 0, sizeof(*registers));
+	for (index = 0; index < 29; index++)
+		UPT_X(registers, index) = state->__x[index];
+	UPT_FP(registers) = __darwin_arm_thread_state64_get_fp(*state);
+	UPT_LR(registers) = __darwin_arm_thread_state64_get_lr(*state);
+	UPT_SP(registers) = __darwin_arm_thread_state64_get_sp(*state);
+	UPT_IP(registers) = __darwin_arm_thread_state64_get_pc(*state);
+	UPT_PSTATE(registers) = state->__cpsr;
+	registers->is_user = 0;
+}
+
+static void fault_from_ucontext(struct faultinfo *fault,
+				const ucontext_t *context, const siginfo_t *info)
+{
+	const arm_exception_state64_t *exception = &context->uc_mcontext->__es;
+	unsigned int ec = exception->__esr >> 26;
+
+	memset(fault, 0, sizeof(*fault));
+	if (ec == 0x20 || ec == 0x21)
+		fault->error_code |= UML_ARM64_FAULT_EXECUTE;
+	else if (exception->__esr & (1U << 6))
+		fault->error_code |= UML_ARM64_FAULT_WRITE;
+	fault->cr2 = exception->__far != 0 ? exception->__far :
+		(unsigned long)info->si_addr;
+	fault->trap_no = UML_ARM64_FAULT_PAGE;
+}
+
+void darwin_mc_set_rip(void *machine_context, void *target)
+{
+	ucontext_t *context = machine_context;
+
+	__darwin_arm_thread_state64_set_pc_fptr(context->uc_mcontext->__ss,
+		(void (*)(void))target);
+}
+
+static void common_signal_handler(int signal, siginfo_t *info,
+				  ucontext_t *context)
+{
+	struct uml_pt_regs registers;
+
+	registers_from_ucontext(&registers, context);
+	os_warn("Darwin POSIX signal=%d pc=%p\n", signal,
+		(void *)UPT_IP(&registers));
+	if (signal == SIGSEGV || signal == SIGBUS) {
+		fault_from_ucontext(&registers.faultinfo, context, info);
+		os_warn("Darwin POSIX fault signal=%d pc=%p far=%p esr=%#x\n",
+			signal, (void *)UPT_IP(&registers),
+			(void *)FAULT_ADDRESS(registers.faultinfo),
+			context->uc_mcontext->__es.__esr);
+	}
+	if (sig_info[signal] != NULL)
+		sig_info[signal](signal, (struct siginfo *)info, &registers,
+				 context);
+}
+
+static void run_timer(ucontext_t *context)
+{
+	struct uml_pt_regs registers;
+
+	if (context != NULL)
+		registers_from_ucontext(&registers, context);
+	else
+		memset(&registers, 0, sizeof(registers));
+	/* Darwin has no epoll-compatible SIGIO ownership.  Poll registered
+	 * descriptors at the timer boundary before advancing the clock.
+	 */
+	sigio_handler(SIGIO, NULL, &registers, NULL);
+	timer_handler(SIGALRM, NULL, &registers);
+}
+
+static void hard_handler(int signal, siginfo_t *info, void *pointer)
+{
+	ucontext_t *context = pointer;
+	struct darwin_signal_state *state = local_signal_state();
+	int saved_errno = errno;
+	int previous = state->enabled;
+
+	if (signal == SIGALRM) {
+		if (!previous || state->alarm_active) {
+			state->alarm_pending = 1;
+			return;
+		}
+		block_signals();
+		state->alarm_pending = 0;
+		state->alarm_active = 1;
+		run_timer(context);
+		state->alarm_active = 0;
+		um_set_signals(previous);
+	} else {
+		block_signals();
+		common_signal_handler(signal, info, context);
+		um_set_signals(previous);
+	}
+	errno = saved_errno;
+}
+
+void deliver_alarm(void)
+{
+	struct darwin_signal_state *state = local_signal_state();
+
+	if (!state->enabled || state->alarm_active) {
+		state->alarm_pending = 1;
+		return;
+	}
+	block_signals();
+	state->alarm_pending = 0;
+	state->alarm_active = 1;
+	run_timer(NULL);
+	state->alarm_active = 0;
+	um_set_signals(1);
+}
+
+void timer_set_signal_handler(void)
+{
+	set_handler(SIGALRM);
+}
+
+void set_sigstack(void *stack_address, int size)
+{
+	stack_t stack;
+	void *host_stack;
+
+	(void)stack_address;
+	(void)size;
+	host_stack = malloc(SIGSTKSZ);
+	if (host_stack == NULL)
+		panic("allocating Darwin signal stack failed");
+	memset(&stack, 0, sizeof(stack));
+	stack.ss_sp = host_stack;
+	stack.ss_size = SIGSTKSZ;
+	if (sigaltstack(&stack, NULL) < 0)
+		panic("Darwin sigaltstack failed: %d", errno);
+}
+
+#if !IS_ENABLED(CONFIG_SMP)
+static void wake_handler(int signal)
+{
+	(void)signal;
+	uml_pm_wake();
+}
+#endif
+
+void register_pm_wake_signal(void)
+{
+#if !IS_ENABLED(CONFIG_SMP)
+	struct sigaction action = { };
+
+	action.sa_handler = wake_handler;
+	sigemptyset(&action.sa_mask);
+	sigaction(SIGUSR1, &action, NULL);
+#endif
+}
+
+void set_handler(int signal)
+{
+	struct sigaction action = { };
+	sigset_t unblock;
+
+	action.sa_sigaction = hard_handler;
+	action.sa_flags = SA_SIGINFO | SA_ONSTACK;
+	if (signal == SIGSEGV)
+		action.sa_flags |= SA_NODEFER;
+	sigemptyset(&action.sa_mask);
+	sigaddset(&action.sa_mask, SIGIO);
+	sigaddset(&action.sa_mask, SIGWINCH);
+	sigaddset(&action.sa_mask, SIGALRM);
+	if (signal == SIGIO || signal == SIGWINCH || signal == SIGALRM)
+		action.sa_flags |= SA_RESTART;
+	if (sigaction(signal, &action, NULL) < 0)
+		panic("Darwin sigaction failed: %d", errno);
+	sigemptyset(&unblock);
+	sigaddset(&unblock, signal);
+	if (pthread_sigmask(SIG_UNBLOCK, &unblock, NULL) != 0)
+		panic("Darwin pthread_sigmask failed");
+}
+
+void send_sigio_to_self(void)
+{
+	/* Poll-backed IRQ delivery needs no process-directed signal. */
+}
+
+int change_sig(int signal, int on)
+{
+	sigset_t set;
+	int result;
+
+	sigemptyset(&set);
+	sigaddset(&set, signal);
+	result = pthread_sigmask(on ? SIG_UNBLOCK : SIG_BLOCK, &set, NULL);
+	return result == 0 ? 0 : -result;
+}
+
+void block_signals(void)
+{
+	struct darwin_signal_state *state = local_signal_state();
+
+	/* Darwin IPI signals are wake edges only.  The logical state defers their
+	 * pending Linux vectors until a safe cooperative boundary.
+	 */
+	os_local_ipi_disable();
+	barrier();
+	state->enabled = 0;
+}
+
+void unblock_signals(void)
+{
+	struct darwin_signal_state *state = local_signal_state();
+
+	state->enabled = 1;
+	barrier();
+	os_local_ipi_enable();
+	/* ITIMER_REAL is periodic.  Coalesce ticks which arrived while the
+	 * kernel was in a critical section instead of recursively draining
+	 * them on the signal stack; the next host tick will advance time.
+	 */
+	if (state->alarm_pending && !state->alarm_active)
+		state->alarm_pending = 0;
+}
+
+int um_get_signals(void)
+{
+	return local_signal_state()->enabled;
+}
+
+int um_set_signals(int enable)
+{
+	int previous = um_get_signals();
+
+	if (enable)
+		unblock_signals();
+	else
+		block_signals();
+	return previous;
+}
+
+int um_set_signals_trace(int enable)
+{
+	return um_set_signals(enable);
+}
+
+void block_signals_hard(void)
+{
+	block_signals();
+}
+
+void unblock_signals_hard(void)
+{
+	unblock_signals();
+}
+
+void mark_sigio_pending(void)
+{
+}
