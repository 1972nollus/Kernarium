+/* The native entrypoint receives the fixed prefix of uml_pt_regs directly.
+ * These checks make an ABI drift fail at the kernel compiler rather than at a
+ * guest boundary after register state has been reinterpreted. */
+_Static_assert(sizeof(unsigned long) == 8, "Darwin UML ABI requires LP64");
+_Static_assert(DARWIN_UML_ABI_VERSION == 6U, "unexpected ABI version");
+_Static_assert(DARWIN_UML_ABI_FINGERPRINT == 0x6524b65f20239ea1ULL,
+	       "unexpected ABI fingerprint");
+_Static_assert(offsetof(struct uml_pt_regs, orig_x0) ==
+	      DARWIN_UML_ABI_GUEST_REGISTERS_ORIGINAL_X0_OFFSET,
+	       "orig_x0 ABI offset drift");
+_Static_assert(offsetof(struct uml_pt_regs, faultinfo) ==
+	      DARWIN_UML_ABI_GUEST_REGISTERS_FAULT_OFFSET,
+	       "faultinfo ABI offset drift");
+_Static_assert(offsetof(struct uml_pt_regs, syscall) ==
+	      DARWIN_UML_ABI_GUEST_REGISTERS_SYSCALL_OFFSET,
+	       "syscall ABI offset drift");
+_Static_assert(offsetof(struct uml_pt_regs, fpmr) ==
+	      DARWIN_UML_ABI_GUEST_REGISTERS_FPMR_OFFSET,
+	       "fpmr ABI offset drift");
+_Static_assert(offsetof(struct uml_pt_regs, pointer_auth_keys) ==
+	      DARWIN_UML_ABI_GUEST_REGISTERS_POINTER_AUTH_KEYS_OFFSET,
+	       "pointer-auth ABI offset drift");
+_Static_assert(offsetof(struct uml_pt_regs, fp) ==
+	      DARWIN_UML_ABI_GUEST_REGISTERS_SIZE,
+	       "uml_pt_regs ABI prefix size drift");
+
+#define DARWIN_CLONE_VM 0x00000100UL
+#define DARWIN_TASK_HASH_BUCKETS 4096
+/* Linux asm-generic/siginfo.h ABI value.  This host-side file includes
+ * Darwin's signal.h, where the guest-only SEGV_CPERR name is unavailable. */
+#define DARWIN_GUEST_SEGV_CPERR 10
+/* Linux asm-generic/siginfo.h values differ from Darwin's floating-point
+ * si_code values, so keep the guest ABI numbers explicit at this boundary. */
