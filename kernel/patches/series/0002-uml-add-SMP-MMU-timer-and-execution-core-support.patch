diff --git a/arch/um/kernel/hugetlb.c b/arch/um/kernel/hugetlb.c
new file mode 100644
index 000000000..78b40df35
--- /dev/null
+++ b/arch/um/kernel/hugetlb.c
@@ -0,0 +1,250 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * HugeTLB support for User-Mode Linux.
+ *
+ * A UML address space is ultimately installed into host VM mappings one base
+ * page at a time. Represent a 2 MiB HugeTLB mapping as a contiguous run of
+ * 512 ordinary PTEs. A 1 GiB HugeTLB mapping uses a PUD leaf which the UML
+ * TLB synchronizer expands into host mappings. The HugeTLB core still sees
+ * one representative PTE through the helpers below.
+ */
+
+#include <linux/hugetlb.h>
+#include <linux/mm.h>
+
+#include <asm/tlbflush.h>
+
+static unsigned int um_huge_nr_ptes(unsigned long sz)
+{
+	VM_WARN_ON_ONCE(sz != HPAGE_SIZE);
+	return sz >> PAGE_SHIFT;
+}
+
+static void um_set_huge_present(struct mm_struct *mm, unsigned long addr,
+				pte_t *ptep, pte_t pte, unsigned long sz)
+{
+	unsigned int nr = um_huge_nr_ptes(sz);
+
+	while (nr--) {
+		set_pte_at(mm, addr, ptep, pte);
+		pte = pte_next_pfn(pte);
+		ptep++;
+		addr += PAGE_SIZE;
+	}
+}
+
+static bool um_huge_pte_is_pud(struct mm_struct *mm, unsigned long addr,
+			       pte_t *ptep)
+{
+	pgd_t *pgd = pgd_offset(mm, addr);
+	p4d_t *p4d;
+
+	if (!pgd_present(*pgd))
+		return false;
+	p4d = p4d_offset(pgd, addr);
+	if (!p4d_present(*p4d))
+		return false;
+	return ptep == (pte_t *)pud_offset(p4d, addr);
+}
+
+static void um_set_huge_pud(struct mm_struct *mm, unsigned long addr,
+			    pte_t *ptep, pte_t pte)
+{
+	set_pud((pud_t *)ptep, __pud(pte_val(pte)));
+	um_tlb_mark_sync(mm, addr, addr + PUD_SIZE);
+}
+
+pte_t *huge_pte_alloc(struct mm_struct *mm, struct vm_area_struct *vma,
+		      unsigned long addr, unsigned long sz)
+{
+	pgd_t *pgd;
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+
+	VM_WARN_ON_ONCE((sz != HPAGE_SIZE && sz != PUD_SIZE) ||
+			!IS_ALIGNED(addr, sz));
+
+	pgd = pgd_offset(mm, addr);
+	p4d = p4d_alloc(mm, pgd, addr);
+	if (!p4d)
+		return NULL;
+	pud = pud_alloc(mm, p4d, addr);
+	if (!pud)
+		return NULL;
+	if (sz == PUD_SIZE)
+		return (pte_t *)pud;
+	pmd = pmd_alloc(mm, pud, addr);
+	if (!pmd)
+		return NULL;
+
+	return pte_alloc_huge(mm, pmd, addr & HPAGE_MASK);
+}
+
+pte_t *huge_pte_offset(struct mm_struct *mm, unsigned long addr,
+		       unsigned long sz)
+{
+	pgd_t *pgd;
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+
+	VM_WARN_ON_ONCE(sz != HPAGE_SIZE && sz != PUD_SIZE);
+	addr &= ~(sz - 1);
+
+	pgd = pgd_offset(mm, addr);
+	if (!pgd_present(*pgd))
+		return NULL;
+	p4d = p4d_offset(pgd, addr);
+	if (!p4d_present(*p4d))
+		return NULL;
+	pud = pud_offset(p4d, addr);
+	if (sz == PUD_SIZE)
+		return (pte_t *)pud;
+	if (!pud_present(*pud))
+		return NULL;
+	pmd = pmd_offset(pud, addr);
+	if (!pmd_present(*pmd))
+		return NULL;
+
+	return pte_offset_huge(pmd, addr);
+}
+
+unsigned long hugetlb_mask_last_page(struct hstate *h)
+{
+	return huge_page_size(h) == PUD_SIZE ? P4D_SIZE - PUD_SIZE : 0;
+}
+
+pte_t arch_make_huge_pte(pte_t entry, unsigned int shift, vm_flags_t flags)
+{
+	VM_WARN_ON_ONCE(shift != HPAGE_SHIFT && shift != PUD_SHIFT);
+	pte_set_bits(entry, _PAGE_HUGE);
+	return entry;
+}
+
+pte_t huge_ptep_get(struct mm_struct *mm, unsigned long addr, pte_t *ptep)
+{
+	pte_t pte;
+	unsigned int nr = HPAGE_SIZE >> PAGE_SHIFT;
+
+	if (um_huge_pte_is_pud(mm, addr, ptep))
+		return __pte(pud_val(READ_ONCE(*(pud_t *)ptep)));
+	pte = ptep_get(ptep);
+
+	if (!pte_present(pte) || !pte_huge(pte))
+		return pte;
+
+	while (--nr) {
+		pte_t subpte = ptep_get(++ptep);
+
+		if (pte_dirty(subpte))
+			pte = pte_mkdirty(pte);
+		if (pte_young(subpte))
+			pte = pte_mkyoung(pte);
+	}
+
+	return pte;
+}
+
+void set_huge_pte_at(struct mm_struct *mm, unsigned long addr, pte_t *ptep,
+		     pte_t pte, unsigned long sz)
+{
+	unsigned int nr;
+	unsigned int i;
+
+	if (sz == PUD_SIZE) {
+		um_set_huge_pud(mm, addr, ptep, pte);
+		return;
+	}
+	nr = um_huge_nr_ptes(sz);
+
+	if (pte_present(pte)) {
+		um_set_huge_present(mm, addr, ptep, pte, sz);
+		return;
+	}
+
+	/* Non-present HugeTLB state is represented by the first PTE only. */
+	set_pte_at(mm, addr, ptep, pte);
+	for (i = 1; i < nr; i++)
+		pte_clear(mm, addr + i * PAGE_SIZE, ptep + i);
+	um_tlb_mark_sync(mm, addr, addr + sz);
+}
+
+void huge_pte_clear(struct mm_struct *mm, unsigned long addr, pte_t *ptep,
+		    unsigned long sz)
+{
+	unsigned int nr;
+	unsigned int i;
+
+	if (sz == PUD_SIZE) {
+		pud_clear((pud_t *)ptep);
+		um_tlb_mark_sync(mm, addr, addr + sz);
+		return;
+	}
+	nr = um_huge_nr_ptes(sz);
+
+	for (i = 0; i < nr; i++)
+		pte_clear(mm, addr + i * PAGE_SIZE, ptep + i);
+	um_tlb_mark_sync(mm, addr, addr + sz);
+}
+
+pte_t huge_ptep_get_and_clear(struct mm_struct *mm, unsigned long addr,
+			      pte_t *ptep, unsigned long sz)
+{
+	pte_t pte = huge_ptep_get(mm, addr, ptep);
+
+	huge_pte_clear(mm, addr, ptep, sz);
+	return pte;
+}
+
+pte_t huge_ptep_clear_flush(struct vm_area_struct *vma, unsigned long addr,
+			    pte_t *ptep)
+{
+	unsigned long sz = huge_page_size(hstate_vma(vma));
+	pte_t pte = huge_ptep_get_and_clear(vma->vm_mm, addr, ptep, sz);
+
+	flush_tlb_range(vma, addr, addr + sz);
+	return pte;
+}
+
+void huge_ptep_set_wrprotect(struct mm_struct *mm, unsigned long addr,
+			     pte_t *ptep)
+{
+	unsigned int nr = HPAGE_SIZE >> PAGE_SHIFT;
+
+	if (um_huge_pte_is_pud(mm, addr, ptep)) {
+		pte_t pte = huge_ptep_get(mm, addr, ptep);
+
+		um_set_huge_pud(mm, addr, ptep, pte_wrprotect(pte));
+		return;
+	}
+
+	while (nr--) {
+		ptep_set_wrprotect(mm, addr, ptep);
+		ptep++;
+		addr += PAGE_SIZE;
+	}
+}
+
+int huge_ptep_set_access_flags(struct vm_area_struct *vma,
+			       unsigned long addr, pte_t *ptep,
+			       pte_t pte, int dirty)
+{
+	unsigned long sz = huge_page_size(hstate_vma(vma));
+	pte_t old = huge_ptep_get(vma->vm_mm, addr, ptep);
+
+	if (pte_same(old, pte))
+		return 0;
+
+	if (sz == PUD_SIZE)
+		um_set_huge_pud(vma->vm_mm, addr, ptep, pte);
+	else
+		um_set_huge_present(vma->vm_mm, addr, ptep, pte, sz);
+	flush_tlb_range(vma, addr, addr + sz);
+	return 1;
+}
+
+bool __init arch_hugetlb_valid_size(unsigned long size)
+{
+	return size == HPAGE_SIZE || size == PUD_SIZE;
+}
