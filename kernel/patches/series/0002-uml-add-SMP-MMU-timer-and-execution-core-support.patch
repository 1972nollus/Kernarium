diff --git a/arch/um/kernel/smp.c b/arch/um/kernel/smp.c
new file mode 100644
index 000000000..cc0c6c58a
--- /dev/null
+++ b/arch/um/kernel/smp.c
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2025 Ant Group
+ * Author: Tiwei Bie <tiwei.btw@antgroup.com>
+ *
+ * Based on the previous implementation in TT mode
+ * Copyright (C) 2000 - 2007 Jeff Dike (jdike@{addtoit,linux.intel}.com)
+ */
+
+#include <linux/sched.h>
+#include <linux/sched/hotplug.h>
+#include <linux/sched/task.h>
+#include <linux/sched/task_stack.h>
+#include <linux/module.h>
+#include <linux/processor.h>
+#include <linux/threads.h>
+#include <linux/cpu.h>
+#include <linux/cpuhotplug.h>
+#include <linux/context_tracking_irq.h>
+#include <linux/hardirq.h>
+#include <linux/smp.h>
+#include <linux/smp-internal.h>
+#include <init.h>
+#include <kern.h>
+#include <os.h>
+#include <skas.h>
+#include <smp.h>
+
+enum {
+	UML_IPI_RES = 0,
+	UML_IPI_CALL_SINGLE,
+	UML_IPI_CALL,
+	UML_IPI_STOP,
+};
+
+void arch_smp_send_reschedule(int cpu)
+{
+	os_send_ipi(cpu, UML_IPI_RES);
+}
+
+void arch_send_call_function_single_ipi(int cpu)
+{
+	os_send_ipi(cpu, UML_IPI_CALL_SINGLE);
+}
+
+void arch_send_call_function_ipi_mask(const struct cpumask *mask)
+{
+	int cpu;
+
+	for_each_cpu(cpu, mask)
+		os_send_ipi(cpu, UML_IPI_CALL);
+}
+
+void smp_send_stop(void)
+{
+	int cpu, me = smp_processor_id();
+
+	for_each_online_cpu(cpu) {
+		if (cpu == me)
+			continue;
+		os_send_ipi(cpu, UML_IPI_STOP);
+	}
+}
+
+static void ipi_handler(int vector, struct uml_pt_regs *regs)
+{
+	struct pt_regs *old_regs = set_irq_regs((struct pt_regs *)regs);
+	int cpu = raw_smp_processor_id();
+
+	irq_enter();
+
+	if (current->mm)
+		os_alarm_process(current->mm->context.id.pid);
+
+	switch (vector) {
+	case UML_IPI_RES:
+		inc_irq_stat(irq_resched_count);
+		scheduler_ipi();
+		break;
+
+	case UML_IPI_CALL_SINGLE:
+		inc_irq_stat(irq_call_count);
+		generic_smp_call_function_single_interrupt();
+		break;
+
+	case UML_IPI_CALL:
+		inc_irq_stat(irq_call_count);
+		generic_smp_call_function_interrupt();
+		break;
+
+	case UML_IPI_STOP:
+		set_cpu_online(cpu, false);
+		while (1)
+			pause();
+		break;
+
+	default:
+		pr_err("CPU#%d received unknown IPI (vector=%d)!\n", cpu, vector);
+		break;
+	}
+
+	irq_exit();
+	set_irq_regs(old_regs);
+}
+
+void uml_ipi_handler(int vector)
+{
+	uml_ipi_handler_mask(1U << vector);
+}
+
+void uml_ipi_handler_mask(unsigned int pending)
+{
+	struct uml_pt_regs r = { .is_user = 0 };
+	bool rcu_watching = rcu_is_watching();
+	int vector;
+
+	/*
+	 * A Darwin wake edge can coalesce several vectors.  Keep the captured
+	 * batch on its original virtual CPU: handling the reschedule vector may
+	 * otherwise switch this task to another CPU before a following call
+	 * function vector is dispatched, consuming the original CPU's pending
+	 * bit while flushing the new CPU's callback queue.
+	 */
+	/*
+	 * The cooperative Darwin idle path drains IPIs before returning from
+	 * arch_cpu_idle(), while context tracking still considers the CPU to be
+	 * in an extended quiescent state.  Make that interrupt work visible to
+	 * RCU.  Otherwise a callback can observe a grace period while an idle
+	 * carrier is actively executing its callback queue.
+	 */
+	if (!rcu_watching)
+		ct_irq_enter();
+	preempt_disable();
+	for (vector = 0; pending != 0; vector++, pending >>= 1)
+		if (pending & 1U)
+			ipi_handler(vector, &r);
+	/*
+	 * The host carrier is still inside the architecture's interrupt-exit
+	 * wrapper here.  A plain preempt_enable() may schedule immediately and
+	 * resume this task on another virtual CPU before drain_ipis() restores
+	 * the originating CPU's logical interrupt state.  It would also pair an
+	 * extended-quiescent-state exit with the wrong CPU.  Leave rescheduling to
+	 * interrupt_end() (or the generic idle loop) after all per-CPU exit state
+	 * has been restored.
+	 */
+#ifdef UML_HOST_DARWIN
+	preempt_enable_no_resched();
+#else
+	preempt_enable();
+#endif
+	if (!rcu_watching)
+		ct_irq_exit();
+}
+
+/* AP states used only during CPU startup */
+enum {
+	UML_CPU_PAUSED = 0,
+	UML_CPU_RUNNING,
+};
+
+static int cpu_states[NR_CPUS];
+
+static void __noreturn secondary_startup(void)
+{
+	int err, cpu = raw_smp_processor_id();
+
+	notify_cpu_starting(cpu);
+	err = um_setup_timer();
+	if (err)
+		panic("CPU#%d failed to setup timer, err = %d", cpu, err);
+	set_cpu_online(cpu, true);
+
+	local_irq_enable();
+	cpu_startup_entry(CPUHP_AP_ONLINE_IDLE);
+	BUG();
+}
+
+static int start_secondary(void *unused)
+{
+	secondary_startup();
+}
+
+#ifdef CONFIG_HOTPLUG_CPU
+static int restart_secondary(void *unused)
+{
+	/* tick_offline_cpu() unregisters the per-CPU clockevent device.  Recreate
+	 * and register it before the normal STARTING callbacks run, just as on the
+	 * CPU's first boot.  Without a local tick, the next teardown can deadlock
+	 * in sched_cpu_deactivate() waiting for an RCU callback queued on this CPU.
+	 */
+	secondary_startup();
+}
+
+bool arch_cpu_is_hotpluggable(int cpu)
+{
+	/* Keep the boot CPU online so the process always has one scheduler and
+	 * serial-console owner.  Every secondary CPU is a parkable UML thread.
+	 */
+	return cpu != 0;
+}
+
+/* Runs on the virtual CPU after the generic hotplug callbacks have drained
+ * runnable work and moved timers away.  UML has no local interrupt controller
+ * to tear down, so changing the online mask is the architecture boundary.
+ */
+int __cpu_disable(void)
+{
+	set_cpu_online(smp_processor_id(), false);
+	return 0;
+}
+
+/* The host idle-task thread remains parked until a later __cpu_up().  By the
+ * time the boot CPU reaches this hook the target has already reported the
+ * standard CPUHP_AP_IDLE_DEAD state, so there is no physical shutdown to poll.
+ */
+void __cpu_die(unsigned int cpu)
+{
+}
+
+void __noreturn arch_cpu_idle_dead(void)
+{
+	struct mm_struct *mm = &init_mm;
+	int cpu = raw_smp_processor_id();
+
+	idle_task_exit();
+	WRITE_ONCE(cpu_states[cpu], UML_CPU_PAUSED);
+	smp_wmb();
+	cpuhp_ap_report_dead();
+	os_futex_wait(&cpu_states[cpu], UML_CPU_PAUSED);
+	smp_rmb();
+
+	/* finish_cpu() drops this reference after every successful offline. */
+	mmgrab(mm);
+	current->active_mm = mm;
+#ifdef UML_HOST_DARWIN
+	current->thread.prev_sched = NULL;
+	current->thread.request.thread.proc = restart_secondary;
+	current->thread.request.thread.arg = NULL;
+	os_restart_secondary(task_stack_page(current),
+			     &current->thread.switch_buf);
+#else
+	secondary_startup();
+#endif
+}
+#endif
+
+void uml_start_secondary(void *opaque)
+{
+	int cpu = raw_smp_processor_id();
+	struct mm_struct *mm = &init_mm;
+	struct task_struct *idle;
+
+	stack_protections((unsigned long) &cpu_irqstacks[cpu]);
+	set_sigstack(&cpu_irqstacks[cpu], THREAD_SIZE);
+
+	set_cpu_present(cpu, true);
+	os_futex_wait(&cpu_states[cpu], UML_CPU_PAUSED);
+
+	smp_rmb(); /* paired with smp_wmb() in __cpu_up() */
+
+	idle = cpu_tasks[cpu];
+	idle->thread_info.cpu = cpu;
+
+	mmgrab(mm);
+	idle->active_mm = mm;
+
+	idle->thread.request.thread.proc = start_secondary;
+	idle->thread.request.thread.arg = NULL;
+
+	new_thread(task_stack_page(idle), &idle->thread.switch_buf,
+		   new_thread_handler);
+	os_start_secondary(opaque, &idle->thread.switch_buf);
+}
+
+void __init smp_prepare_cpus(unsigned int max_cpus)
+{
+	int err, cpu, me = smp_processor_id();
+	unsigned long deadline;
+
+	os_init_smp();
+#ifdef UML_HOST_DARWIN
+	/*
+	 * ITIMER_REAL is process-wide on Darwin.  Stop using it before the first
+	 * secondary CPU can run: an asynchronous CPU0 tick may schedule the
+	 * interrupted task, whose host signal frame could then resume after Linux
+	 * migrates that task to another CPU.  Per-CPU deadline polling is already
+	 * ready for CPU0, and each secondary installs its deadline as it starts.
+	 */
+	darwin_enable_cooperative_timers();
+#endif
+
+	for_each_possible_cpu(cpu) {
+		if (cpu == me)
+			continue;
+
+		pr_debug("Booting processor %d...\n", cpu);
+		err = os_start_cpu_thread(cpu);
+		if (err) {
+			pr_crit("CPU#%d failed to start cpu thread, err = %d",
+				cpu, err);
+			continue;
+		}
+
+		deadline = jiffies + msecs_to_jiffies(1000);
+		spin_until_cond(cpu_present(cpu) ||
+				time_is_before_jiffies(deadline));
+
+		if (!cpu_present(cpu))
+			pr_crit("CPU#%d failed to boot\n", cpu);
+	}
+}
+
+int __cpu_up(unsigned int cpu, struct task_struct *tidle)
+{
+	cpu_tasks[cpu] = tidle;
+	smp_wmb(); /* paired with smp_rmb() in uml_start_secondary() */
+	cpu_states[cpu] = UML_CPU_RUNNING;
+	os_futex_wake(&cpu_states[cpu]);
+	spin_until_cond(cpu_online(cpu));
+
+	return 0;
+}
+
+void __init smp_cpus_done(unsigned int max_cpus)
+{
+}
+
+/* Set in uml_ncpus_setup */
+#ifdef UML_HOST_DARWIN
+/* Zero selects every online host CPU, capped by CONFIG_NR_CPUS. */
+int uml_ncpus;
+#else
+int uml_ncpus = 1;
+#endif
+
+void __init prefill_possible_map(void)
+{
+	int cpu;
+
+	if (uml_ncpus == 0)
+		uml_ncpus = clamp(os_num_processors(), 1, NR_CPUS);
+	os_info("UML: enabling %d virtual CPUs\n", uml_ncpus);
+
+	for (cpu = 0; cpu < uml_ncpus; cpu++)
+		set_cpu_possible(cpu, true);
+	for (; cpu < NR_CPUS; cpu++)
+		set_cpu_possible(cpu, false);
+}
+
+static int __init uml_ncpus_setup(char *line, int *add)
+{
+	*add = 0;
+
+	if (kstrtoint(line, 10, &uml_ncpus)) {
+		os_warn("%s: Couldn't parse '%s'\n", __func__, line);
+		return -1;
+	}
+
+	uml_ncpus = clamp(uml_ncpus, 1, NR_CPUS);
+
+	return 0;
+}
+
+__uml_setup("ncpus=", uml_ncpus_setup,
+"ncpus=<# of desired CPUs>\n"
+"    This tells UML how many virtual processors to start. The maximum\n"
+"    number of supported virtual processors can be obtained by querying\n"
+"    the CONFIG_NR_CPUS option using --showconfig.\n\n"
+);
+
+EXPORT_SYMBOL(uml_curr_cpu);
