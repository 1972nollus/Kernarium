@@ -358,6 +368,109 @@ int uml_ncpus;
 int uml_ncpus = 1;
 #endif
 
+#ifdef UML_HOST_DARWIN
+enum uml_cpu_capacity_profile_state {
+	UML_CPU_CAPACITY_ABSENT,
+	UML_CPU_CAPACITY_PENDING,
+	UML_CPU_CAPACITY_ENABLED,
+	UML_CPU_CAPACITY_REJECTED,
+};
+
+static enum uml_cpu_capacity_profile_state uml_cpu_capacity_state;
+static unsigned long uml_cpu_capacities[NR_CPUS];
+static int uml_cpu_capacity_count;
+
+static void reject_cpu_capacity_profile(const char *reason)
+{
+	os_warn("UML: ignoring Darwin CPU capacity profile: %s\n", reason);
+	uml_cpu_capacity_state = UML_CPU_CAPACITY_REJECTED;
+	uml_cpu_capacity_count = 0;
+}
+
+static int __init uml_cpu_capacity_setup(char *line, int *add)
+{
+	unsigned long previous = UML_CPU_CAPACITY_SCALE;
+	int count = 0;
+	char *cursor = line;
+
+	*add = 0;
+	if (uml_cpu_capacity_state != UML_CPU_CAPACITY_ABSENT) {
+		reject_cpu_capacity_profile("argument was supplied more than once");
+		return 0;
+	}
+	while (*cursor != '\0') {
+		unsigned long capacity = 0;
+
+		if (count >= NR_CPUS || *cursor < '0' || *cursor > '9')
+			goto malformed;
+		do {
+			capacity = capacity * 10 + (*cursor - '0');
+			if (capacity > UML_CPU_CAPACITY_SCALE)
+				goto malformed;
+			cursor++;
+		} while (*cursor >= '0' && *cursor <= '9');
+		if (capacity == 0 || (count == 0 &&
+		    capacity != UML_CPU_CAPACITY_SCALE) ||
+		    (count != 0 && capacity > previous))
+			goto malformed;
+		uml_cpu_capacities[count++] = capacity;
+		previous = capacity;
+		if (*cursor == '\0')
+			break;
+		if (*cursor != ',' || cursor[1] == '\0')
+			goto malformed;
+		cursor++;
+	}
+	if (count == 0)
+		goto malformed;
+	uml_cpu_capacity_count = count;
+	uml_cpu_capacity_state = UML_CPU_CAPACITY_PENDING;
+	return 0;
+
+malformed:
+	reject_cpu_capacity_profile("malformed value");
+	return 0;
+}
+
+__uml_setup("darwin_cpu_capacity_v1=", uml_cpu_capacity_setup,
+"darwin_cpu_capacity_v1=<capacity0,...,capacityN>\n"
+"    Assign one normalized scheduler capacity to every Darwin UML vCPU.\n"
+"    The vector must match ncpus, start at 1024, contain values in\n"
+"    1...1024, and be nonincreasing. Invalid input is ignored atomically.\n\n"
+);
+
+void uml_finalize_cpu_capacity_profile(void)
+{
+	if (uml_cpu_capacity_state != UML_CPU_CAPACITY_PENDING)
+		return;
+	if (uml_ncpus == 0)
+		uml_ncpus = clamp(os_num_processors(), 1, NR_CPUS);
+	if (uml_cpu_capacity_count != uml_ncpus) {
+		reject_cpu_capacity_profile("vector length does not match ncpus");
+		return;
+	}
+	uml_cpu_capacity_state = UML_CPU_CAPACITY_ENABLED;
+}
+
+void uml_disable_cpu_capacity_profile(void)
+{
+	uml_cpu_capacity_state = UML_CPU_CAPACITY_REJECTED;
+	uml_cpu_capacity_count = 0;
+}
+
+int uml_cpu_capacity_profile_enabled(void)
+{
+	return uml_cpu_capacity_state == UML_CPU_CAPACITY_ENABLED;
+}
+
+unsigned long uml_cpu_capacity(int cpu)
+{
+	if (!uml_cpu_capacity_profile_enabled() || cpu < 0 || cpu >= uml_ncpus)
+		return UML_CPU_CAPACITY_SCALE;
+	return uml_cpu_capacities[cpu];
+}
+#endif
+
 void __init prefill_possible_map(void)
 {
 	int cpu;
diff --git a/arch/um/os-Darwin/smp.c b/arch/um/os-Darwin/smp.c
index b2977982b068fad40fd48ba46bba8feb7eb8ee2a..7d87f241c71ae2d13dde5777904d8ff3949efc55 100644
--- a/arch/um/os-Darwin/smp.c
+++ b/arch/um/os-Darwin/smp.c
@@ -4,6 +4,7 @@
 #include <fcntl.h>
 #include <poll.h>
 #include <pthread.h>
+#include <pthread/qos.h>
 #include <sched.h>
 #include <signal.h>
 #include <stdint.h>
@@ -477,6 +478,45 @@ static void *cpu_carrier(void *argument)
 	return NULL;
 }
 
+static qos_class_t cpu_carrier_qos(int cpu)
+{
+	return uml_cpu_capacity(cpu) == UML_CPU_CAPACITY_SCALE ?
+		QOS_CLASS_USER_INITIATED : QOS_CLASS_UTILITY;
+}
+
+static int preflight_cpu_carrier_qos(void)
+{
+	int cpu;
+
+	for (cpu = 0; cpu < uml_ncpus; cpu++) {
+		pthread_attr_t attributes;
+		int destroy_error;
+		int error;
+
+		error = pthread_attr_init(&attributes);
+		if (error != 0)
+			return error;
+		error = pthread_attr_set_qos_class_np(&attributes,
+						      cpu_carrier_qos(cpu), 0);
+		destroy_error = pthread_attr_destroy(&attributes);
+		if (error != 0 || destroy_error != 0)
+			return error != 0 ? error : destroy_error;
+	}
+	return 0;
+}
+
+static int initialize_cpu_carrier_attributes(pthread_attr_t *attributes)
+{
+	int error = pthread_attr_init(attributes);
+
+	if (error != 0)
+		return error;
+	error = pthread_attr_setdetachstate(attributes, PTHREAD_CREATE_DETACHED);
+	if (error != 0)
+		pthread_attr_destroy(attributes);
+	return error;
+}
+
 static int start_cpu_carrier(int cpu, int primary, void *stack,
 			     jmp_buf *switch_buffer)
 {
@@ -488,6 +528,8 @@ static int start_cpu_carrier(int cpu, int primary, void *stack,
 	int mask_set = 0;
