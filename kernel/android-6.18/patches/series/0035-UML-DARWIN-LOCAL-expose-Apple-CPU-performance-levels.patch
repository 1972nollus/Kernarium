+					"CPU capacity profile: %d\n", error);
+				uml_disable_cpu_capacity_profile();
+				pthread_attr_destroy(&attributes);
+				error = initialize_cpu_carrier_attributes(&attributes);
+			} else {
+				os_warn("UML: CPU%d carrier QoS setup failed: %d\n",
+					cpu, error);
+				pthread_attr_destroy(&attributes);
+			}
+		}
+	}
 	if (error != 0) {
 		darwin_release_embedded_thread();
 		free(data);
