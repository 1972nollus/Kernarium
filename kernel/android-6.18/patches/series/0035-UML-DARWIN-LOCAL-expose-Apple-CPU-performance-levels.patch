+		uml_finalize_cpu_capacity_profile();
 	data = malloc(sizeof(*data));
 	if (data == NULL)
 		return -ENOMEM;
@@ -499,10 +541,27 @@ static int start_cpu_carrier(int cpu, int primary, void *stack,
 		free(data);
 		return -ESHUTDOWN;
 	}
-	error = pthread_attr_init(&attributes);
-	if (error == 0)
-		error = pthread_attr_setdetachstate(&attributes,
-						PTHREAD_CREATE_DETACHED);
+	error = initialize_cpu_carrier_attributes(&attributes);
+	if (error == 0 && uml_cpu_capacity_profile_enabled()) {
+		if (primary)
