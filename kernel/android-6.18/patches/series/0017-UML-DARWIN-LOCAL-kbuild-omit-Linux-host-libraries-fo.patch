From 600b00b7526f139f03566d9ade287e03cdbbeccf Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 14:51:46 +0000
Subject: [PATCH 17/47] UML-DARWIN-LOCAL: kbuild: omit Linux host libraries for
 Darwin ELF

Change-Id: Ia765233c82169001c3e5fbe3d1e835341e31d265
---
 scripts/link-vmlinux.sh | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/scripts/link-vmlinux.sh b/scripts/link-vmlinux.sh
index 433849ff7529e1fb8bb24e01163455844c8a4c88..73b21ea8477be5fef3224c344b0352139182eeca 100755
--- a/scripts/link-vmlinux.sh
+++ b/scripts/link-vmlinux.sh
@@ -80,7 +80,11 @@ vmlinux_link()
 		wl=-Wl,
 		ld="${CC}"
 		ldflags="${CFLAGS_vmlinux}"
-		ldlibs="-lutil -lrt -lpthread"
+		if [ "${UML_HOST_OS}" = "Darwin" ]; then
+			ldlibs=""
+		else
+			ldlibs="-lutil -lrt -lpthread"
+		fi
 	else
 		wl=
 		ld="${LD}"
