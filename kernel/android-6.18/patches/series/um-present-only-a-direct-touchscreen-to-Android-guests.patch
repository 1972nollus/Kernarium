From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 26 Sep 2026 12:12:02 +0900
Subject: [PATCH] um: present only a direct touchscreen to Android guests

The shared input driver keeps the desktop tablet's mouse buttons and wheel
beside BTN_TOUCH, which libinput guests need. Android and recovery interfaces
must see the Darwin display as a touchscreen, not a hybrid tablet and mouse.
Advertise only INPUT_PROP_DIRECT, BTN_TOUCH, and ABS_X/ABS_Y, and discard
auxiliary buttons and wheel events instead of exposing pointer-mode
capabilities to the guest.

Keep translating legacy host BTN_LEFT events to BTN_TOUCH so older accepted
frontends remain usable. Current frontends send BTN_TOUCH directly and suppress
hover coordinates outside an active contact.
---
 arch/um/drivers/vnc_input.c | 35 +++++++++++++++--------------------
 1 file changed, 15 insertions(+), 20 deletions(-)

diff --git a/arch/um/drivers/vnc_input.c b/arch/um/drivers/vnc_input.c
index 7d72c22268902c6bf4aa299731c584ffa52f9acf..0e5dfebe6106bc2843d0a26aeb96b9519f8dc7d5 100644
--- a/arch/um/drivers/vnc_input.c
+++ b/arch/um/drivers/vnc_input.c
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * VNC keyboard and absolute-pointer input passed directly from the Darwin
- * host frontend over an inherited datagram socket.
+ * VNC keyboard and direct-touch input passed from the Darwin host frontend
+ * over an inherited datagram socket.
  */
 
 #include <linux/init.h>
@@ -45,11 +45,15 @@ static void deliver_event(const struct uml_vnc_input_event *wire)
 	if (type == EV_SYN) {
 		input_sync(keyboard);
 		input_sync(pointer);
-	} else if (type == EV_ABS || type == EV_REL ||
-		   (type == EV_KEY && code >= BTN_MISC)) {
+	} else if (type == EV_ABS ||
+		   (type == EV_KEY && code == BTN_TOUCH)) {
 		input_event(pointer, type, code, value);
-		if (type == EV_KEY && code == BTN_LEFT)
-			input_event(pointer, EV_KEY, BTN_TOUCH, value);
+	} else if (type == EV_KEY && code == BTN_LEFT) {
+		/* Accept primary clicks from host frontends predating BTN_TOUCH. */
+		input_event(pointer, EV_KEY, BTN_TOUCH, value);
+	} else if (type == EV_REL ||
+		   (type == EV_KEY && code >= BTN_MISC)) {
+		return;
 	} else {
 		input_event(keyboard, type, code, value);
 	}
@@ -96,26 +100,17 @@ static void configure_keyboard(struct input_dev *device)
 
 static void configure_pointer(struct input_dev *device)
 {
-	device->name = "Darwin UML VNC Tablet";
+	device->name = "Darwin UML Touchscreen";
 	device->phys = "uml/vnc/input1";
 	device->id.bustype = BUS_VIRTUAL;
 	/*
 	 * Android's EventHub only recognises an absolute device when it reports
-	 * BTN_TOUCH together with ABS_X and ABS_Y. A bare INPUT_PROP_POINTER
-	 * tablet matches none of its classification rules, so it is dropped
-	 * before InputReader ever opens it and the guest sees no pointer at all.
-	 * INPUT_PROP_DIRECT then selects TouchInputMapper's direct mode, which
-	 * maps the absolute range straight onto the display - exactly what a
-	 * host window pointer already is. The mouse buttons stay so a click is
-	 * still reported as the primary button.
+	 * BTN_TOUCH together with ABS_X and ABS_Y. INPUT_PROP_DIRECT selects
+	 * TouchInputMapper's direct mode and keeps pointer-mode buttons and wheel
+	 * axes out of the guest capability table.
 	 */
 	__set_bit(INPUT_PROP_DIRECT, device->propbit);
 	input_set_capability(device, EV_KEY, BTN_TOUCH);
-	input_set_capability(device, EV_KEY, BTN_LEFT);
-	input_set_capability(device, EV_KEY, BTN_MIDDLE);
-	input_set_capability(device, EV_KEY, BTN_RIGHT);
-	input_set_capability(device, EV_REL, REL_WHEEL);
-	input_set_capability(device, EV_REL, REL_HWHEEL);
 	input_set_abs_params(device, ABS_X, 0, 32767, 0, 0);
 	input_set_abs_params(device, ABS_Y, 0, 32767, 0, 0);
 }
@@ -156,7 +151,7 @@ static int __init vnc_input_init(void)
 		error = input_irq;
 		goto unregister_pointer;
 	}
-	pr_info("uml_vnc_input: registered keyboard and tablet at fd=%d\n",
+	pr_info("uml_vnc_input: registered keyboard and touchscreen at fd=%d\n",
 		input_fd);
 	return 0;
 
