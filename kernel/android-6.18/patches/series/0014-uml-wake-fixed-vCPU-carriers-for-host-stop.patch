From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 13 Aug 2026 17:47:44 +0900
Subject: [PATCH 14/44] uml: wake fixed vCPU carriers for host stop

---
 arch/um/os-Darwin/internal.h                |  2 ++
 arch/um/os-Darwin/main.c                    |  5 ++++-
 arch/um/os-Darwin/skas/process.c            | 23 +++++++++++++++++++--
 arch/um/os-Darwin/time.c                    | 17 +++++++++++++--
 arch/um/os-Darwin/uml_darwin_abi.h          |  6 ++++--
 arch/um/os-Darwin/uml_darwin_abi_identity.h |  4 ++--
 arch/um/os-Darwin/uml_darwin_host.h         |  2 ++
 7 files changed, 50 insertions(+), 9 deletions(-)

diff --git a/arch/um/os-Darwin/internal.h b/arch/um/os-Darwin/internal.h
index 60fbc7aaa5842059da88c2a4ba46af8ce8714e1a..ec61427d7257278e9ea61a293403a98066c05291 100644
--- a/arch/um/os-Darwin/internal.h
+++ b/arch/um/os-Darwin/internal.h
@@ -13,6 +13,8 @@ int darwin_task_shutdown_requested(void);
 int darwin_reserve_embedded_thread(void);
 void darwin_release_embedded_thread(void);
 int darwin_wait_for_embedded_threads(unsigned int timeout_ms);
+void darwin_host_stop_checkpoint(void);
+void __attribute__((noreturn)) darwin_host_stop(void);
 
 #if IS_ENABLED(CONFIG_SMP)
 void darwin_set_current_cpu(int cpu);
diff --git a/arch/um/os-Darwin/main.c b/arch/um/os-Darwin/main.c
index cf597442f04361423a906926d07df47e28cac18a..6ddd3fbe0fdd6115bd24d7b049a74119a8eeb346 100644
--- a/arch/um/os-Darwin/main.c
+++ b/arch/um/os-Darwin/main.c
@@ -13,7 +13,10 @@ long elf_aux_hwcap;
 
 static void fatal_exit(int signal)
 {
-	uml_cleanup();
+	/* This is the second-signal/last-ditch path.  Exit immediately instead of
+	 * running sleepable Linux exitcalls from whichever fixed carrier received a
+	 * process-directed signal (which may be that vCPU's idle task).
+	 */
 	_exit(128 + signal);
 }
 
diff --git a/arch/um/os-Darwin/skas/process.c b/arch/um/os-Darwin/skas/process.c
index 93d674346bb32783c7501dcebc1972edeb7cdccb..fe8e7d48e59b7e18a5900eacea5216d2daf886a0 100644
--- a/arch/um/os-Darwin/skas/process.c
+++ b/arch/um/os-Darwin/skas/process.c
@@ -24,8 +24,8 @@
  * These checks make an ABI drift fail at the kernel compiler rather than at a
  * guest boundary after register state has been reinterpreted. */
 _Static_assert(sizeof(unsigned long) == 8, "Darwin UML ABI requires LP64");
-_Static_assert(DARWIN_UML_ABI_VERSION == 7U, "unexpected ABI version");
-_Static_assert(DARWIN_UML_ABI_FINGERPRINT == 0xefcbbdbbf473686eULL,
+_Static_assert(DARWIN_UML_ABI_VERSION == 8U, "unexpected ABI version");
+_Static_assert(DARWIN_UML_ABI_FINGERPRINT == 0x3871ad612337ea76ULL,
 	       "unexpected ABI fingerprint");
 _Static_assert(offsetof(struct uml_pt_regs, orig_x0) ==
 	      DARWIN_UML_ABI_GUEST_REGISTERS_ORIGINAL_X0_OFFSET,
@@ -265,6 +265,23 @@ static void shutdown_kernel(int reboot)
 	darwin_exit_cpu_carrier();
 }
 
+void darwin_host_stop_checkpoint(void)
+{
+	/* A public embedding stop is a forced host boundary, not a Linux poweroff.
+	 * Skip Linux exitcalls: the selected task may be the idle task and several
+	 * sibling vCPUs are still live.  The owning app tears down host devices only
+	 * after every fixed carrier has returned to its native pthread stack.
+	 */
+	if (darwin_uml_stop_requested())
+		shutdown_kernel(0);
+}
+
+void __attribute__((noreturn)) darwin_host_stop(void)
+{
+	shutdown_kernel(0);
+	__builtin_unreachable();
+}
+
 #ifndef CONFIG_PAGE_SIZE_16KB
 static int reconcile_implicit_stack_quarter(struct uml_pt_regs *registers)
 {
@@ -456,6 +473,8 @@ void userspace(struct uml_pt_regs *registers)
 				mm_id == NULL ? 0 : mm_id->darwin_generation,
 				&guest_tls);
 		darwin_ipi_guest_end();
+		if (event == DARWIN_UML_EVENT_STOP)
+			darwin_host_stop();
 		/*
 		 * Close the guest-to-kernel IPI race before handling an event that
 		 * may block.  A sender can publish an IPI after the translated loop's
diff --git a/arch/um/os-Darwin/time.c b/arch/um/os-Darwin/time.c
index 06199debb04605afe3d519c63c9ab0602d462e6b..1f1209910aa4aea0d11a2c4f774cf978342cb2f5 100644
--- a/arch/um/os-Darwin/time.c
+++ b/arch/um/os-Darwin/time.c
@@ -13,6 +13,7 @@
 #include <kern_util.h>
 #include <os.h>
 #include <smp.h>
+#include "bridge.h"
 #include "irq.h"
 #include "internal.h"
 
@@ -202,6 +203,8 @@ void os_idle_sleep(void)
 		unsigned long long now;
 		unsigned long long remaining;
 		int ipi_fd;
+		int stop_fd;
+		int wake_fd;
 		int fire_timer = 0;
 
 		if (cpu == 0)
@@ -228,6 +231,7 @@ void os_idle_sleep(void)
 			timeout_pointer = &timeout;
 		}
 		ipi_fd = darwin_ipi_idle_fd();
+		stop_fd = darwin_uml_stop_fd();
 		FD_ZERO(&read_fds);
 		if (ipi_fd >= FD_SETSIZE)
 			panic("Darwin: CPU%d IPI wake fd %d exceeds FD_SETSIZE",
@@ -244,9 +248,17 @@ void os_idle_sleep(void)
 				1U << ((unsigned int)ipi_fd %
 					(sizeof(read_fds.fds_bits[0]) * 8));
 		}
+		if (stop_fd >= FD_SETSIZE)
+			panic("Darwin: host stop fd %d exceeds FD_SETSIZE", stop_fd);
+		if (stop_fd >= 0)
+			read_fds.fds_bits[(unsigned int)stop_fd /
+				(sizeof(read_fds.fds_bits[0]) * 8)] |=
+				1U << ((unsigned int)stop_fd %
+					(sizeof(read_fds.fds_bits[0]) * 8));
+		wake_fd = ipi_fd > stop_fd ? ipi_fd : stop_fd;
 		darwin_ipi_idle_begin();
-		(void)pselect(ipi_fd >= 0 ? ipi_fd + 1 : 0,
-			      ipi_fd >= 0 ? &read_fds : NULL, NULL, NULL,
+		(void)pselect(wake_fd >= 0 ? wake_fd + 1 : 0,
+			      wake_fd >= 0 ? &read_fds : NULL, NULL, NULL,
 			      timeout_pointer, &mask);
 		/* Clear before draining.  A sender which observed the idle state has
 		 * already left a pipe byte; a later sender will use the signal wake
@@ -260,6 +272,7 @@ void os_idle_sleep(void)
 			darwin_irq_idle_end(&previous_mask);
 		else
 			pthread_sigmask(SIG_SETMASK, &previous_mask, NULL);
+		darwin_host_stop_checkpoint();
 		/* Drain the pipe before the bitmask.  An IPI which races after the
 		 * mask exchange leaves a fresh byte readable for the next idle wait;
 		 * one which races before it is included in this drain.
diff --git a/arch/um/os-Darwin/uml_darwin_abi.h b/arch/um/os-Darwin/uml_darwin_abi.h
