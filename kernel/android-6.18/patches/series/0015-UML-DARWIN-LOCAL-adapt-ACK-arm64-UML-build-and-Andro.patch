From a3cbc5ce35ad32bd16c7489d8c3253d973bc5991 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 26 Aug 2026 23:39:11 +0000
Subject: [PATCH 15/22] UML-DARWIN-LOCAL: adapt ACK arm64 UML build and Android
 interfaces

Keep ACK generated-header, SIMD, Darwin-link, Rust-target, ashmem binding, and system-mapping sealing adaptations in one ACK compatibility topic.

Change-Id: I81810028be1329ab2cd4d90ed27830a14bd90367
---
 arch/arm64/um/Kconfig           | 1 +
 arch/um/Makefile                | 6 ++++++
 arch/um/include/asm/Kbuild      | 1 +
 rust/bindings/bindings_helper.h | 1 +
 scripts/link-vmlinux.sh         | 6 +++++-
 5 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/um/Kconfig b/arch/arm64/um/Kconfig
index b0603b1240cdc084043dcc83f1b4941872e630d3..2b518b23fbe29da511c84051c58db647b1a80734 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -3,6 +3,7 @@
 config UML_ARM64
 	def_bool y
 	select CLONE_BACKWARDS
+	select ARCH_SUPPORTS_MSEAL_SYSTEM_MAPPINGS
 	select ARCH_SUPPORTS_HUGETLBFS
 	select ARCH_WANT_DEFAULT_TOPDOWN_MMAP_LAYOUT
 	select ARCH_HAS_SET_DIRECT_MAP
diff --git a/arch/um/Makefile b/arch/um/Makefile
index 5066ec876cf7a3321f0780b28ad64017e47e2b7a..f52bebee8c4bd12f2a52dca08a5f51dbe7bb6808 100644
--- a/arch/um/Makefile
+++ b/arch/um/Makefile
@@ -65,6 +65,9 @@ KBUILD_CFLAGS += $(CFLAGS) $(CFLAGS-y) -D__arch_um__ \
 	-D__close_range=kernel__close_range
 
 KBUILD_RUSTFLAGS += -Crelocation-model=pie
+ifeq ($(HEADER_ARCH),arm64)
+KBUILD_RUSTFLAGS += --target=aarch64-unknown-none-softfloat -Zfixed-x18
+endif
 
 KBUILD_AFLAGS += $(ARCH_INCLUDE)
 
@@ -118,6 +121,9 @@ archheaders:
 
 archprepare:
 	$(Q)$(MAKE) $(build)=$(HOST_DIR)/um include/generated/user_constants.h
+ifeq ($(HEADER_ARCH),arm64)
+	$(Q)$(MAKE) $(build)=$(HOST_DIR)/tools kapi
+endif
 
 LINK-$(CONFIG_LD_SCRIPT_STATIC) += -static
 LINK-$(CONFIG_LD_SCRIPT_DYN) += -no-pie
diff --git a/arch/um/include/asm/Kbuild b/arch/um/include/asm/Kbuild
index 3c21b4fd2a3474a1fb619c120cb3b806e1ae9cb0..af6be97171bad5c22fe1dc81a6817b0bb9d88aed 100644
--- a/arch/um/include/asm/Kbuild
+++ b/arch/um/include/asm/Kbuild
@@ -19,6 +19,7 @@ generic-y += parport.h
 generic-y += percpu.h
 generic-y += preempt.h
 generic-y += runtime-const.h
+generic-y += simd.h
 generic-y += softirq_stack.h
 generic-y += switch_to.h
 generic-y += trace_clock.h
diff --git a/rust/bindings/bindings_helper.h b/rust/bindings/bindings_helper.h
index ead4260dc6289fe547ae7dfadb49c625b813558c..0959692d02035efc561fc48f2befddb61a32dbfb 100644
--- a/rust/bindings/bindings_helper.h
+++ b/rust/bindings/bindings_helper.h
@@ -70,6 +70,7 @@
 #include <linux/of_device.h>
 #include <linux/pci.h>
 #include <linux/page_size_compat.h>
+#include <linux/personality.h>
 #include <linux/phy.h>
 #include <linux/pid_namespace.h>
 #include <linux/platform_device.h>
diff --git a/scripts/link-vmlinux.sh b/scripts/link-vmlinux.sh
index 433849ff7529e1fb8bb24e01163455844c8a4c88..73b21ea8477be5fef3224c344b0352139182eeca 100755
--- a/scripts/link-vmlinux.sh
+++ b/scripts/link-vmlinux.sh
@@ -80,7 +80,11 @@ vmlinux_link()
 		wl=-Wl,
 		ld="${CC}"
 		ldflags="${CFLAGS_vmlinux}"
-		ldlibs="-lutil -lrt -lpthread"
+		if [ "${UML_HOST_OS}" = "Darwin" ]; then
+			ldlibs=""
+		else
+			ldlibs="-lutil -lrt -lpthread"
+		fi
 	else
 		wl=
 		ld="${LD}"
