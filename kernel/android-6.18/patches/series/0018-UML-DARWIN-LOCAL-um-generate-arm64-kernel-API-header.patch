From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 14:47:32 +0000
Subject: [PATCH 18/42] UML-DARWIN-LOCAL: um: generate arm64 kernel API headers

Change-Id: I3f4cec02a7bc851816960914ec52f5b7ff1f1788
---
 arch/um/Makefile | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/um/Makefile b/arch/um/Makefile
index 5066ec876cf7a3321f0780b28ad64017e47e2b7a..93abe7c0c9d22fe412d24d8bfa2856e15d6aa594 100644
--- a/arch/um/Makefile
+++ b/arch/um/Makefile
@@ -118,6 +118,9 @@ archheaders:
 
 archprepare:
 	$(Q)$(MAKE) $(build)=$(HOST_DIR)/um include/generated/user_constants.h
+ifeq ($(HEADER_ARCH),arm64)
+	$(Q)$(MAKE) $(build)=$(HOST_DIR)/tools kapi
+endif
 
 LINK-$(CONFIG_LD_SCRIPT_STATIC) += -static
 LINK-$(CONFIG_LD_SCRIPT_DYN) += -no-pie
