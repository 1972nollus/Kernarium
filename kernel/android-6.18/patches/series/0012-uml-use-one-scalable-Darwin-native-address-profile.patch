+
 static unsigned long __init get_top_address(char **envp)
 {
 #ifdef UML_HOST_DARWIN
+	unsigned long memory = (physmem_size + PAGE_SIZE - 1) & PAGE_MASK;
+	unsigned long auxiliary = darwin_native_auxiliary_size(memory);
+	unsigned long native_start =
+		(unsigned long)__binary_start & PAGE_MASK;
+
 	/*
-	 * Darwin places the initial pthread stack near 6 GiB, below the linked
-	 * UML kernel.  Use an explicit free high window for kernel vmalloc; guest
-	 * mappings are capped below the kernel separately.
+	 * The host relocates one ET_DYN image into either iOS's low signed window
+	 * or macOS's high native window. Derive the kernel top from that runtime
+	 * base and the same RAM-scaled auxiliary rule instead of baking either
+	 * platform's host ceiling into the shared image.
 	 */
 	(void)envp;
-	return 0x700000000000UL;
+	if (native_start >= UML_DARWIN_GUEST_ADDRESS_LIMIT ||
+	    memory > UML_DARWIN_GUEST_ADDRESS_LIMIT - native_start ||
+	    auxiliary > UML_DARWIN_GUEST_ADDRESS_LIMIT - native_start - memory) {
+		os_warn("Darwin native window exceeds guest address limit\n");
+		exit(1);
+	}
+	uml_darwin_native_end = native_start + memory + auxiliary;
+	return uml_darwin_native_end;
 #else
 	unsigned long top_addr = (unsigned long) &top_addr;
 	int i;
@@ -329,6 +363,9 @@ int __init linux_main(int argc, char **argv, char **envp)
 {
 	unsigned long avail, diff;
 	unsigned long virtmem_size, max_physmem;
+#if defined(UML_HOST_DARWIN) && UML_DARWIN_DYNAMIC_NATIVE_LAYOUT
+	unsigned long auxiliary_size;
+#endif
 	unsigned long stack;
 	unsigned int i;
 	int add;
@@ -355,17 +392,20 @@ int __init linux_main(int argc, char **argv, char **envp)
 	/* Limit TASK_SIZE to what is addressable by the page table */
 	task_size = host_task_size;
 #ifdef UML_HOST_DARWIN
-	/* Keep every same-process guest mapping below the kernel ELF window. */
-	task_size = 0x400000000000UL;
+	/* The Darwin software MMU can place guest mappings on both sides of the
+	 * compact native kernel window shared by every Apple product. */
+	task_size = UML_DARWIN_TASK_SIZE;
 #endif
 	if (task_size > (unsigned long long) PTRS_PER_PGD * PGDIR_SIZE)
 		task_size = PTRS_PER_PGD * PGDIR_SIZE;
 
-	/*
-	 * TASK_SIZE needs to be PGDIR_SIZE aligned or else exit_mmap craps
-	 * out
+	/* Keep the task boundary on a whole PGD.  The compact Darwin native
+	 * window is a hole inside the first guest PGD span, not the end of the
+	 * sparse software-MMU address space.
 	 */
+#if !defined(UML_HOST_DARWIN) || UML_DARWIN_ALIGN_TASK_SIZE_TO_PGDIR
 	task_size = task_size & PGDIR_MASK;
+#endif
 
 	/* OS sanity checks that need to happen before the kernel runs */
 	os_early_checks();
@@ -422,6 +462,11 @@ int __init linux_main(int argc, char **argv, char **envp)
 	avail = stack - start_vm;
 #ifdef UML_HOST_DARWIN
 	avail = host_task_size - start_vm;
+#if UML_DARWIN_DYNAMIC_NATIVE_LAYOUT
+	auxiliary_size = darwin_native_auxiliary_size(physmem_size);
+	if (avail > auxiliary_size)
+		avail = auxiliary_size;
+#endif
 #endif
 	if (physmem_size > avail)
 		virtmem_size = avail;
