diff --git a/arch/um/include/shared/darwin-address-space.h b/arch/um/include/shared/darwin-address-space.h
new file mode 100644
index 0000000000000000000000000000000000000000..09169ea2f067c57656239bda81f4bfe2df24cbda
--- /dev/null
+++ b/arch/um/include/shared/darwin-address-space.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_DARWIN_ADDRESS_SPACE_H
+#define __UM_DARWIN_ADDRESS_SPACE_H
+
+#if UML_DARWIN_DYNAMIC_NATIVE_LAYOUT
+extern unsigned long uml_physmem;
+extern unsigned long uml_darwin_native_end;
+#endif
+
+static inline unsigned long uml_darwin_native_address_start(void)
+{
+#if UML_DARWIN_DYNAMIC_NATIVE_LAYOUT
+	return uml_physmem;
+#else
+	return UML_DARWIN_NATIVE_ADDRESS_START;
+#endif
+}
+
+static inline unsigned long uml_darwin_native_address_end(void)
+{
+#if UML_DARWIN_DYNAMIC_NATIVE_LAYOUT
+	return uml_darwin_native_end;
+#else
+	return UML_DARWIN_NATIVE_ADDRESS_END;
+#endif
+}
+
+static inline int uml_darwin_guest_range(unsigned long address,
+					 unsigned long length)
+{
+	unsigned long native_start = uml_darwin_native_address_start();
+	unsigned long native_end = uml_darwin_native_address_end();
+	unsigned long end;
+
+	if (address >= UML_DARWIN_GUEST_ADDRESS_LIMIT ||
+	    (address >= native_start &&
+	     address < native_end))
+		return 0;
+	if (length == 0)
+		return 1;
+	if (length > UML_DARWIN_GUEST_ADDRESS_LIMIT - address)
+		return 0;
+	end = address + length;
+	return end <= native_start ||
+		address >= native_end;
+}
+
+#endif
