From 19bb56ef462cf27469fb9fdc22b112caf4f92f09 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 23 Aug 2026 10:58:16 +0000
Subject: [PATCH 32/45] UML-DARWIN-LOCAL: um: let vmalloc use the whole
 auxiliary window

The native hole is guest RAM plus an auxiliary allowance, and that allowance
was one eighth of RAM: 504 MiB on a 4 GiB guest. That made address space the
binding constraint on vmalloc even though vmalloc pages come from the guest
page allocator and are already bounded by mem=. Enabling vmapped kernel stacks
exhausted the window at guest second 175 and panicked in exit_mmap at 203.

Track RAM one-for-one between a 1 GiB floor and a 4 GiB ceiling. The ceiling
keeps RAM plus auxiliary inside the 14 GiB signed iOS envelope for every guest
up to 10 GiB, which no Apple product approaches; the previous rule allowed up
to 12 GiB there.

Also give vmalloc the whole window instead of min(window, RAM). end_vm is what
the kernel fault handler uses to recognise a vmalloc address, so a window
larger than RAM would otherwise have a tail that faults are not resolved in.
That could not happen while the allowance was RAM/8.

Change-Id: I4b671ef0c6e3ced31b44c2ecae26cca958314318
---
 arch/arm64/Makefile.um   | 11 +++++++++--
 arch/um/kernel/um_arch.c | 17 ++++++++++++++++-
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/Makefile.um b/arch/arm64/Makefile.um
index 509ae73cf3c93def1319f028dfbc44a3172141d9..935bc927ac93d45f62e6a84e7929b4b5309c8e0e 100644
--- a/arch/arm64/Makefile.um
+++ b/arch/arm64/Makefile.um
@@ -1,6 +1,11 @@
 # SPDX-License-Identifier: GPL-2.0
 
 # Keep native kernel mappings disjoint from the software guest task range.
+# The auxiliary half of the hole is address space, not memory: vmalloc's pages
+# come from the guest page allocator and are already bounded by mem=. It tracks
+# RAM one-for-one between a 1 GiB floor and a 4 GiB ceiling so vmalloc is never
+# the binding constraint; the ceiling keeps RAM plus auxiliary inside the
+# 14 GiB iOS envelope for every guest up to 10 GiB.
 # All Apple products use one relocatable image, RAM-scaled native hole, and
 # sparse guest range. The kernel is linked at the bottom of the iOS envelope;
 # the host loader keeps it below 62 GiB on iOS and moves the same bytes into
@@ -12,8 +17,9 @@ UML_DARWIN_GUEST_ADDRESS_LIMIT := 0x800000000000UL
 UML_DARWIN_TASK_UNMAPPED_BASE := 0x1000000000UL
 UML_DARWIN_NATIVE_ADDRESS_START := 0xc00000000UL
 UML_DARWIN_NATIVE_ADDRESS_END := 0xf80000000UL
-UML_DARWIN_NATIVE_AUXILIARY_DIVISOR := 8
-UML_DARWIN_NATIVE_AUXILIARY_MINIMUM := 0x2000000UL
+UML_DARWIN_NATIVE_AUXILIARY_DIVISOR := 1
+UML_DARWIN_NATIVE_AUXILIARY_MINIMUM := 0x40000000UL
+UML_DARWIN_NATIVE_AUXILIARY_MAXIMUM := 0x100000000UL
 UML_DARWIN_DYNAMIC_NATIVE_LAYOUT := 1
 UML_DARWIN_SIGRETURN_TRAMPOLINE := 0x7fffffffff00ULL
 UML_DARWIN_ALIGN_TASK_SIZE_TO_PGDIR := 1
@@ -26,6 +32,7 @@ KBUILD_CFLAGS += \
 	-DUML_DARWIN_NATIVE_ADDRESS_END=$(UML_DARWIN_NATIVE_ADDRESS_END) \
 	-DUML_DARWIN_NATIVE_AUXILIARY_DIVISOR=$(UML_DARWIN_NATIVE_AUXILIARY_DIVISOR) \
 	-DUML_DARWIN_NATIVE_AUXILIARY_MINIMUM=$(UML_DARWIN_NATIVE_AUXILIARY_MINIMUM) \
+	-DUML_DARWIN_NATIVE_AUXILIARY_MAXIMUM=$(UML_DARWIN_NATIVE_AUXILIARY_MAXIMUM) \
 	-DUML_DARWIN_DYNAMIC_NATIVE_LAYOUT=$(UML_DARWIN_DYNAMIC_NATIVE_LAYOUT) \
 	-DDARWIN_UML_SIGRETURN_TRAMPOLINE=$(UML_DARWIN_SIGRETURN_TRAMPOLINE) \
 	-DUML_DARWIN_ALIGN_TASK_SIZE_TO_PGDIR=$(UML_DARWIN_ALIGN_TASK_SIZE_TO_PGDIR)
diff --git a/arch/um/kernel/um_arch.c b/arch/um/kernel/um_arch.c
index 6188055ccf6c9632e1d88af7f7a7c83ec5bc430e..d3c969b0c7ecc2b8999def0f6ed751a135214da6 100644
--- a/arch/um/kernel/um_arch.c
+++ b/arch/um/kernel/um_arch.c
@@ -311,6 +311,13 @@ static unsigned long __init darwin_native_auxiliary_size(
 
 	if (size < UML_DARWIN_NATIVE_AUXILIARY_MINIMUM)
 		size = UML_DARWIN_NATIVE_AUXILIARY_MINIMUM;
+	/*
+	 * Capped so RAM plus auxiliary stays inside the signed iOS envelope.
+	 * What vmalloc consumes is bounded by the guest page allocator, not by
+	 * the size of this reservation.
+	 */
+	if (size > UML_DARWIN_NATIVE_AUXILIARY_MAXIMUM)
+		size = UML_DARWIN_NATIVE_AUXILIARY_MAXIMUM;
 	return size;
 #else
 	(void)memory;
@@ -467,9 +474,17 @@ int __init linux_main(int argc, char **argv, char **envp)
 	if (avail > auxiliary_size)
 		avail = auxiliary_size;
 #endif
-#endif
+	/*
+	 * vmalloc owns the whole auxiliary window rather than only as much of
+	 * it as there is RAM. Clamping to physmem_size would leave the tail of
+	 * the window past end_vm, where the kernel fault handler no longer
+	 * recognises a vmalloc address.
+	 */
+	virtmem_size = avail;
+#else
 	if (physmem_size > avail)
 		virtmem_size = avail;
+#endif
 	end_vm = start_vm + virtmem_size;
 
 	if (virtmem_size < physmem_size)
