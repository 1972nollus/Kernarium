From e056073776933d4a4210e0d3c5db80e0c0923b06 Mon Sep 17 00:00:00 2001
From: linux-um-darwin kernel patch maintainer
 <noreply@linux-um-darwin.invalid>
Date: Thu, 3 Sep 2026 11:52:15 +0000
Subject: [PATCH 38/38] UML-DARWIN-LOCAL: uml: name the virtual CPU from the
 host emulator

/proc/cpuinfo reported "UML" as the model name on every configuration.  That
names the kernel port rather than the machine, and it is the same name whether
the guest is running on the emulated CPU this project provides or on a plain
UML build, so nothing a guest reads distinguishes them.

The emulator already decides what the virtual CPU is -- on x86-64 userspace it
answers CPUID with a brand string -- so ask it, and report that.  The new
bridge entry point returns one name for every guest architecture the host
presents.

A UML kernel built for a host with no emulator behind it keeps upstream name.

Bridge ABI 9.

Change-Id: I2c9f0b7e5a4d13886c0f7a1b9e4d2f60ab5c7d31
---
 arch/um/include/shared/os.h                 |  3 +++
 arch/um/kernel/um_arch.c                    | 17 ++++++++++++++++-
 arch/um/os-Darwin/skas/process.c            |  4 ++--
 arch/um/os-Darwin/start_up.c                |  5 +++++
 arch/um/os-Darwin/uml_darwin_abi.h          |  4 ++--
 arch/um/os-Darwin/uml_darwin_abi_identity.h |  4 ++--
 arch/um/os-Darwin/uml_darwin_cpu.h          |  4 ++++
 7 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/arch/um/include/shared/os.h b/arch/um/include/shared/os.h
index b54cab5d1499bc56128a0186d6f64ee33c995fc6..da7f6996f5698ea02488186bb5232b647b744c9b 100644
--- a/arch/um/include/shared/os.h
+++ b/arch/um/include/shared/os.h
@@ -190,6 +190,9 @@ extern void check_host_supports_tls(int *supports_tls, int *tls_min);
 extern void get_host_cpu_features(
 	void (*flags_helper_func)(char *line),
 	void (*cache_helper_func)(char *line));
+#ifdef UML_HOST_DARWIN
+extern const char *os_guest_cpu_model_name(void);
+#endif
 
 /* mem.c */
 extern int create_mem_file(unsigned long long len);
diff --git a/arch/um/kernel/um_arch.c b/arch/um/kernel/um_arch.c
index 9a865342cef8e0cd3d84fb63c31672ff9f2c924c..a9e6e103038680f439da26dc4d012d0d1e3f9395 100644
--- a/arch/um/kernel/um_arch.c
+++ b/arch/um/kernel/um_arch.c
@@ -69,6 +69,21 @@ EXPORT_SYMBOL(boot_cpu_data);
 /* Changed in setup_arch, which is called in early boot */
 static char host_info[(__NEW_UTS_LEN + 1) * 5];
 
+/*
+ * What this virtual CPU calls itself.  The emulator decides that, because it
+ * is the component that decides what the CPU is; the kernel reports the
+ * decision rather than making one of its own.  A UML kernel on a host with no
+ * emulator behind it keeps upstream's name.
+ */
+static const char *uml_cpu_model_name(void)
+{
+#ifdef UML_HOST_DARWIN
+	return os_guest_cpu_model_name();
+#else
+	return "UML";
+#endif
+}
+
 static int show_cpuinfo(struct seq_file *m, void *v)
 {
 	int i = 0;
@@ -81,7 +96,7 @@ static int show_cpuinfo(struct seq_file *m, void *v)
 
 	seq_printf(m, "processor\t: %d\n", i);
 	seq_printf(m, "vendor_id\t: User Mode Linux\n");
-	seq_printf(m, "model name\t: UML\n");
+	seq_printf(m, "model name\t: %s\n", uml_cpu_model_name());
 	seq_printf(m, "mode\t\t: skas\n");
 	seq_printf(m, "host\t\t: %s\n", host_info);
 	seq_printf(m, "fpu\t\t: %s\n", str_yes_no(cpu_has(&boot_cpu_data, X86_FEATURE_FPU)));
diff --git a/arch/um/os-Darwin/skas/process.c b/arch/um/os-Darwin/skas/process.c
index fe8e7d48e59b7e18a5900eacea5216d2daf886a0..15cd5f645408b6d61dba3f4286c99b5a5180505a 100644
--- a/arch/um/os-Darwin/skas/process.c
+++ b/arch/um/os-Darwin/skas/process.c
@@ -24,8 +24,8 @@
  * These checks make an ABI drift fail at the kernel compiler rather than at a
  * guest boundary after register state has been reinterpreted. */
 _Static_assert(sizeof(unsigned long) == 8, "Darwin UML ABI requires LP64");
-_Static_assert(DARWIN_UML_ABI_VERSION == 8U, "unexpected ABI version");
-_Static_assert(DARWIN_UML_ABI_FINGERPRINT == 0x3871ad612337ea76ULL,
+_Static_assert(DARWIN_UML_ABI_VERSION == 9U, "unexpected ABI version");
+_Static_assert(DARWIN_UML_ABI_FINGERPRINT == 0xd17ab76bfc9adf0cULL,
 	       "unexpected ABI fingerprint");
 _Static_assert(offsetof(struct uml_pt_regs, orig_x0) ==
 	      DARWIN_UML_ABI_GUEST_REGISTERS_ORIGINAL_X0_OFFSET,
diff --git a/arch/um/os-Darwin/start_up.c b/arch/um/os-Darwin/start_up.c
index 623321096c9f33390e1810039ad69090fefbff8b..69eda27a60dcd9cca8beff08cc7bced71e9ca7ab 100644
--- a/arch/um/os-Darwin/start_up.c
+++ b/arch/um/os-Darwin/start_up.c
@@ -63,6 +63,11 @@ void get_host_cpu_features(void (*flags_helper)(char *),
 	cache_helper(cache);
 }
 
+const char *os_guest_cpu_model_name(void)
+{
+	return darwin_uml_guest_cpu_model_name();
+}
+
 int parse_iomem(char *string, int *add)
 {
 	(void)string;
diff --git a/arch/um/os-Darwin/uml_darwin_abi.h b/arch/um/os-Darwin/uml_darwin_abi.h
index 8e770d81be5b491dd65d25007cf0cee7dfc1908d..2da80e362f1e0b48a8465bc6d8edb2c7ab64c3a0 100644
--- a/arch/um/os-Darwin/uml_darwin_abi.h
+++ b/arch/um/os-Darwin/uml_darwin_abi.h
@@ -120,8 +120,8 @@ struct darwin_uml_guest_fp_registers {
 
 #if defined(__cplusplus)
 #include <stddef.h>
-static_assert(DARWIN_UML_ABI_VERSION == 8U);
-static_assert(DARWIN_UML_ABI_FINGERPRINT == 0x3871ad612337ea76ULL);
+static_assert(DARWIN_UML_ABI_VERSION == 9U);
+static_assert(DARWIN_UML_ABI_FINGERPRINT == 0xd17ab76bfc9adf0cULL);
 static_assert(DARWIN_UML_EVENT_FLOATING_POINT_TRAP == 7);
 static_assert(DARWIN_UML_EVENT_PC_ALIGNMENT == 8);
 static_assert(DARWIN_UML_EVENT_STOP == 9);
diff --git a/arch/um/os-Darwin/uml_darwin_abi_identity.h b/arch/um/os-Darwin/uml_darwin_abi_identity.h
index 3dd57da3e4fe970b1d8385230a5828d7e7cc3109..bbcdba4a468fa0749fabc6f8b183a89c5d75780c 100644
--- a/arch/um/os-Darwin/uml_darwin_abi_identity.h
+++ b/arch/um/os-Darwin/uml_darwin_abi_identity.h
@@ -3,7 +3,7 @@
 #ifndef UML_DARWIN_ABI_IDENTITY_H
 #define UML_DARWIN_ABI_IDENTITY_H
 
-#define DARWIN_UML_ABI_VERSION 8U
-#define DARWIN_UML_ABI_FINGERPRINT 0x3871ad612337ea76ULL
+#define DARWIN_UML_ABI_VERSION 9U
+#define DARWIN_UML_ABI_FINGERPRINT 0xd17ab76bfc9adf0cULL
 
 #endif
diff --git a/arch/um/os-Darwin/uml_darwin_cpu.h b/arch/um/os-Darwin/uml_darwin_cpu.h
index 8f0fc63b8119f5fe325a904576338de4a94ec7e1..0138c26228f00aab8e7ddb1ccc2d19b6e7081494 100644
--- a/arch/um/os-Darwin/uml_darwin_cpu.h
+++ b/arch/um/os-Darwin/uml_darwin_cpu.h
@@ -13,6 +13,10 @@ int darwin_uml_enter_guest(void *registers, void *fp_registers,
 			   unsigned long *tls);
 unsigned long darwin_uml_guest_hwcap(void);
 unsigned long darwin_uml_guest_hwcap2(void);
+/* The virtual CPU's model name, for /proc/cpuinfo. Static storage owned by
+ * the emulator, valid for the lifetime of the process, and identical for
+ * every guest architecture the host presents. */
+const char *darwin_uml_guest_cpu_model_name(void);
 int darwin_uml_static_guest_interrupt_sequence(
 	const unsigned int *sequence, unsigned int snapshot);
 
