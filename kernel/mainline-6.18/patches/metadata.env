#
# Authoritative upstream Git identity and replayable Darwin UML Linux delta.
# The stable branch name documents the maintained upstream line; the full
# commit and tree are the immutable source identity.
UML_KERNEL_SERIES_SCHEMA=4
UML_KERNEL_RELEASE_VERSION='6.18.54'
UML_KERNEL_UPSTREAM_REPOSITORY='https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git'
UML_KERNEL_UPSTREAM_BRANCH='linux-6.18.y'
UML_KERNEL_UPSTREAM_COMMIT='1b357ecb321392158d507b04672ffee57bfa071d'
UML_KERNEL_UPSTREAM_TREE='a11229a049f2349659181b4d85d9ae9ea7f80798'
UML_KERNEL_BASE_REF='refs/heads/uml/upstream-linux-6.18.54'
# Ordered generated series from the upstream commit to this line's tree, each
# paired with the managed replay branch that ends it. kernel/common/patches is
# shared by every line and regenerated from the mainline replay; a line
# regenerates only the series it owns. kernel/common/tooling/kernel_series.py
# reads these.
UML_KERNEL_SERIES='kernel/common/patches:codex/linux-6.18-common kernel/mainline-6.18/patches/series:codex/linux-6.18-darwin'
UML_KERNEL_OWNED_SERIES='kernel/common/patches kernel/mainline-6.18/patches/series'
UML_KERNEL_FINAL_TREE='8f0ef66a19d88b2161de364f7ad2f8ef39dc9f95'
