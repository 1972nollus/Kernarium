 struct uml_pt_regs {
 	unsigned long gp[MAX_REG_NR];
@@ -55,17 +70,121 @@ struct uml_pt_regs {
 	unsigned long fp[];
 };
 
+static inline int upt_is_x86_64(const struct uml_pt_regs *regs)
+{
+	return regs->padding == UML_GUEST_ISA_X86_64;
+}
+
+#define UPT_IS_X86_64(regs) upt_is_x86_64(regs)
+#define UPT_X86_64(regs, n) UPT_X((regs), (n))
+#define UPT_X86_64_RIP(regs) UPT_IP(regs)
+#define UPT_X86_64_RFLAGS(regs) UPT_X((regs), 16)
+#define UPT_X86_64_FS_BASE(regs) UPT_X((regs), 17)
+#define UPT_X86_64_GS_BASE(regs) UPT_X((regs), 18)
+#define UML_X86_64_COMPAT_SYSCALL (1UL << 32)
+
+static inline int upt_x86_64_compat_syscall(const struct uml_pt_regs *regs)
+{
+	return upt_is_x86_64(regs) &&
+		(regs->svcr & UML_X86_64_COMPAT_SYSCALL);
+}
+
+#define UPT_X86_64_COMPAT_SYSCALL(regs) \
+	upt_x86_64_compat_syscall(regs)
+
+static inline unsigned long *upt_sp(struct uml_pt_regs *regs)
+{
+	return upt_is_x86_64(regs) ?
+		&UPT_X86_64(regs, UML_X86_64_RSP) : &regs->gp[HOST_SP];
+}
+
+#undef UPT_SP
+#define UPT_SP(regs) (*upt_sp(regs))
+
+static inline unsigned long *upt_syscall_return(struct uml_pt_regs *regs)
+{
+	return upt_is_x86_64(regs) ?
+		&UPT_X86_64(regs, UML_X86_64_RAX) : &regs->gp[HOST_X0];
+}
+
+#define UPT_SYSCALL_RETURN(regs) (*upt_syscall_return(regs))
+
+static inline unsigned long
+upt_syscall_arch_nr(const struct uml_pt_regs *regs)
+{
+	if (upt_x86_64_compat_syscall(regs))
+		return (unsigned int)UPT_X86_64(regs, UML_X86_64_RAX);
+	return upt_is_x86_64(regs) ? UPT_X86_64(regs, UML_X86_64_RAX) :
+		regs->gp[HOST_X8];
+}
+
+#define UPT_SYSCALL_ARCH_NR(regs) upt_syscall_arch_nr(regs)
+
+static inline unsigned long *
+upt_syscall_argument(struct uml_pt_regs *regs, unsigned int argument)
+{
+	static const unsigned char x86_registers[] = {
+		UML_X86_64_RDI, UML_X86_64_RSI, UML_X86_64_RDX,
+		UML_X86_64_R10, UML_X86_64_R8, UML_X86_64_R9,
+	};
+	static const unsigned char x86_compat_registers[] = {
+		UML_X86_64_RBX, UML_X86_64_RCX, UML_X86_64_RDX,
+		UML_X86_64_RSI, UML_X86_64_RDI, UML_X86_64_RBP,
+	};
+
+	if (upt_x86_64_compat_syscall(regs))
+		return &UPT_X86_64(regs, x86_compat_registers[argument]);
+	if (upt_is_x86_64(regs))
+		return &UPT_X86_64(regs, x86_registers[argument]);
+	return argument == 0 ? &regs->orig_x0 : &regs->gp[HOST_X0 + argument];
+}
+
+#define UPT_SYSCALL_ARG1(regs) (*upt_syscall_argument((regs), 0))
+#define UPT_SYSCALL_ARG2(regs) (*upt_syscall_argument((regs), 1))
+#define UPT_SYSCALL_ARG3(regs) (*upt_syscall_argument((regs), 2))
+#define UPT_SYSCALL_ARG4(regs) (*upt_syscall_argument((regs), 3))
+#define UPT_SYSCALL_ARG5(regs) (*upt_syscall_argument((regs), 4))
+#define UPT_SYSCALL_ARG6(regs) (*upt_syscall_argument((regs), 5))
+
+static inline void upt_save_original_syscall(struct uml_pt_regs *regs)
+{
+	unsigned int argument;
+
+	if (upt_x86_64_compat_syscall(regs)) {
+		UPT_X86_64(regs, UML_X86_64_RAX) =
+			(unsigned int)UPT_X86_64(regs, UML_X86_64_RAX);
+		for (argument = 0; argument < 6; argument++)
+			*upt_syscall_argument(regs, argument) =
+				(unsigned int)*upt_syscall_argument(regs, argument);
+	}
+	regs->orig_x0 = upt_is_x86_64(regs) ?
+		UPT_X86_64(regs, UML_X86_64_RAX) : regs->gp[HOST_X0];
+}
+
+#define UPT_SAVE_ORIGINAL_SYSCALL(regs) upt_save_original_syscall(regs)
+
+static inline void upt_syscall_rollback(struct uml_pt_regs *regs)
+{
+	if (upt_is_x86_64(regs))
+		UPT_X86_64(regs, UML_X86_64_RAX) = regs->orig_x0;
+	else
+		regs->gp[HOST_X0] = regs->orig_x0;
+}
+
+#define UPT_SYSCALL_ROLLBACK(regs) upt_syscall_rollback(regs)
+
 #define EMPTY_UML_PT_REGS { }
 #define UPT_SYSCALL_NR(regs) ((regs)->syscall)
 #define UPT_FAULTINFO(regs) (&(regs)->faultinfo)
 #define UPT_IS_USER(regs) ((regs)->is_user)
 #define UPT_RESTART_SYSCALL(regs) do { \
-	/* AArch64 returns syscall results in x0, which is also argument 1. \
-	 * Restore it before re-executing SVC; unlike x86, rewinding the PC \
-	 * alone would retry with -ERESTART* as the first argument. \
-	 */ \
-	UPT_X((regs), 0) = (regs)->orig_x0; \
-	UPT_IP(regs) -= 4; \
+	if (UPT_IS_X86_64(regs)) { \
+		UPT_X86_64((regs), UML_X86_64_RAX) = (regs)->orig_x0; \
+		UPT_IP(regs) -= 2; \
+	} else { \
+		UPT_X((regs), 0) = (regs)->orig_x0; \
+		UPT_IP(regs) -= 4; \
+	} \
 } while (0)
 
 extern unsigned long host_fp_size;
diff --git a/arch/arm64/um/signal.c b/arch/arm64/um/signal.c
index 5df9d3a0e..628d07be3 100644
--- a/arch/arm64/um/signal.c
+++ b/arch/arm64/um/signal.c
@@ -17,6 +17,152 @@ struct uml_arm64_rt_sigframe {
 	struct ucontext uc;
 };
 
+/* Keep these layouts independent from the host architecture headers.  They
+ * are the Linux x86-64 userspace signal and XSAVE ABIs implemented by the
+ * Darwin x86 backend.
+ */
+struct uml_x86_64_sigcontext {
+	unsigned long r8;
+	unsigned long r9;
+	unsigned long r10;
+	unsigned long r11;
+	unsigned long r12;
+	unsigned long r13;
+	unsigned long r14;
+	unsigned long r15;
+	unsigned long di;
+	unsigned long si;
+	unsigned long bp;
+	unsigned long bx;
+	unsigned long dx;
+	unsigned long ax;
+	unsigned long cx;
+	unsigned long sp;
+	unsigned long ip;
+	unsigned long flags;
+	unsigned short cs;
+	unsigned short gs;
+	unsigned short fs;
+	unsigned short ss;
+	unsigned long err;
+	unsigned long trapno;
+	unsigned long oldmask;
+	unsigned long cr2;
+	unsigned long fpstate;
+	unsigned long reserved1[8];
+};
+
+struct uml_x86_64_ucontext {
+	unsigned long uc_flags;
+	unsigned long uc_link;
+	stack_t uc_stack;
+	struct uml_x86_64_sigcontext uc_mcontext;
+	sigset_t uc_sigmask;
+};
+
+struct uml_x86_64_rt_sigframe {
+	unsigned long pretcode;
+	struct uml_x86_64_ucontext uc;
+	struct siginfo info;
+};
+
+struct uml_x86_64_fpx_sw_bytes {
+	unsigned int magic1;
+	unsigned int extended_size;
+	unsigned long xfeatures;
+	unsigned int xstate_size;
+	unsigned int padding[7];
+};
+
+struct uml_x86_64_fpstate {
+	unsigned short cwd;
+	unsigned short swd;
+	unsigned short twd;
+	unsigned short fop;
+	unsigned long rip;
+	unsigned long rdp;
+	unsigned int mxcsr;
+	unsigned int mxcsr_mask;
+	unsigned int st_space[32];
+	unsigned int xmm_space[64];
+	unsigned int reserved2[12];
+	union {
+		unsigned int reserved3[12];
+		struct uml_x86_64_fpx_sw_bytes sw_reserved;
+	};
+};
+
+struct uml_x86_64_xstate_header {
+	unsigned long xfeatures;
+	unsigned long reserved[7];
+};
+
+struct uml_x86_64_xstate {
+	struct uml_x86_64_fpstate fpstate;
+	struct uml_x86_64_xstate_header header;
+	unsigned int ymmh_space[64];
+};
+
+/* The Darwin bridge stores sixteen 256-bit x86 vectors in the same 512-byte
+ * payload used by the arm64 FPSIMD register array.  The remaining words are
+ * x86 control state when the marker is present.
+ */
+struct uml_x86_64_task_fpstate {
+	unsigned char vectors[16][32];
+	unsigned int mxcsr;
+	unsigned int x87_control_status;
+	unsigned int x87_tag_top;
+	unsigned int marker;
+};
+
+#define UML_X86_64_USER_CS 0x33
+#define UML_X86_64_USER_SS 0x2b
+#define UML_X86_64_UC_FP_XSTATE 0x1
+#define UML_X86_64_UC_SIGCONTEXT_SS 0x2
+#define UML_X86_64_UC_STRICT_RESTORE_SS 0x4
+#define UML_X86_64_FP_XSTATE_MAGIC1 0x46505853U
+#define UML_X86_64_FP_XSTATE_MAGIC2 0x46505845U
+#define UML_X86_64_FP_MARKER 0x58383634U
+#define UML_X86_64_XFEATURE_X87 (1UL << 0)
+#define UML_X86_64_XFEATURE_SSE (1UL << 1)
+#define UML_X86_64_XFEATURE_AVX (1UL << 2)
+#define UML_X86_64_XFEATURES (UML_X86_64_XFEATURE_X87 | \
+	UML_X86_64_XFEATURE_SSE | UML_X86_64_XFEATURE_AVX)
+#define UML_X86_64_XSTATE_SIZE sizeof(struct uml_x86_64_xstate)
+#define UML_X86_64_XSTATE_FRAME_SIZE \
+	(UML_X86_64_XSTATE_SIZE + sizeof(unsigned int))
+#define UML_X86_64_X87_SIGNIFICAND_SLOT 19
+#define UML_X86_64_X87_EXPONENT_SLOT 27
+#define UML_X86_64_X87_TOP_MASK (7U << 11)
+#define UML_X86_64_MXCSR_MASK 0xffffU
+#define UML_X86_64_RFLAGS_TF (1UL << 8)
+#define UML_X86_64_RFLAGS_DF (1UL << 10)
+#define UML_X86_64_RFLAGS_RF (1UL << 16)
+
+static_assert(sizeof(struct uml_x86_64_fpstate) == 512);
+static_assert(sizeof(struct uml_x86_64_xstate_header) == 64);
+static_assert(sizeof(struct uml_x86_64_xstate) == 832);
+static_assert(sizeof(struct uml_x86_64_task_fpstate) ==
+	      sizeof(elf_fpregset_t));
+
+static void x86_64_set_segment_selector(struct uml_pt_regs *guest,
+					unsigned int index,
+					unsigned short selector)
+{
+	unsigned int shift;
+	unsigned long *packed;
+
+	if (index < 4) {
+		shift = index * 16;
+		packed = &guest->fpmr;
+	} else {
+		shift = (index - 4) * 16;
+		packed = &guest->svcr;
+	}
+	*packed = (*packed & ~(0xffffUL << shift)) |
+		((unsigned long)selector << shift);
+}
+
 #ifdef UML_HOST_DARWIN
 /* The final guest page is deliberately above STACK_TOP and never mapped.
  * Returning there lets the Darwin Mach exception bridge synthesize the
@@ -98,6 +244,365 @@ static int restore_mcontext(struct pt_regs *regs,
 	return error;
 }
 
+static struct uml_x86_64_task_fpstate *
+x86_64_task_fpstate(struct uml_pt_regs *guest)
+{
+	return (void *)guest->fp;
+}
+
+static unsigned short x86_64_x87_exponent(const struct uml_pt_regs *guest,
+					   unsigned int index)
+{
+	unsigned long packed = UPT_X(guest,
+		UML_X86_64_X87_EXPONENT_SLOT + index / 4);
+
+	return packed >> ((index % 4) * 16);
+}
+
+static void x86_64_set_x87_exponent(struct uml_pt_regs *guest,
+				    unsigned int index, unsigned short value)
+{
+	unsigned int shift = (index % 4) * 16;
+	unsigned long *packed = &UPT_X(guest,
+		UML_X86_64_X87_EXPONENT_SLOT + index / 4);
+
+	*packed = (*packed & ~(0xffffUL << shift)) |
+		((unsigned long)value << shift);
+}
+
+static unsigned short x86_64_x87_tag(unsigned long significand,
+				     unsigned short sign_exponent)
+{
+	unsigned short exponent = sign_exponent & 0x7fff;
+
+	if (!exponent && !significand)
+		return 1;
+	if (!exponent || exponent == 0x7fff || !(significand & (1UL << 63)))
+		return 2;
+	return 0;
+}
+
+static void clear_x86_64_fpstate(struct uml_pt_regs *guest)
+{
+	struct uml_x86_64_task_fpstate *fp = x86_64_task_fpstate(guest);
+	unsigned int index;
+
+	memset(fp, 0, sizeof(*fp));
+	fp->mxcsr = 0x1f80;
+	fp->x87_control_status = 0x037f;
+	fp->x87_tag_top = 0xffff;
+	fp->marker = UML_X86_64_FP_MARKER;
+	for (index = 0; index < 8; index++) {
+		UPT_X(guest, UML_X86_64_X87_SIGNIFICAND_SLOT + index) = 0;
+		x86_64_set_x87_exponent(guest, index, 0);
+	}
+}
+
+static int save_x86_64_fpstate(struct uml_x86_64_xstate __user *user_state,
+			       struct pt_regs *regs)
+{
+	struct uml_x86_64_xstate state = { };
+	struct uml_pt_regs *guest = &regs->regs;
+	struct uml_x86_64_task_fpstate *task = x86_64_task_fpstate(guest);
+	unsigned short control = 0x037f;
+	unsigned short status = 0;
+	unsigned short tag = 0xffff;
+	unsigned int top = 0;
+	unsigned int index;
+	unsigned int magic2 = UML_X86_64_FP_XSTATE_MAGIC2;
+	unsigned int mxcsr = 0x1f80;
+
+	if (task->marker == UML_X86_64_FP_MARKER) {
+		control = task->x87_control_status;
+		status = task->x87_control_status >> 16;
+		tag = task->x87_tag_top;
+		top = (task->x87_tag_top >> 16) & 7;
+		mxcsr = task->mxcsr;
+	}
+
+	state.fpstate.cwd = control;
+	state.fpstate.swd = (status & ~UML_X86_64_X87_TOP_MASK) |
+		(top << 11);
+	state.fpstate.mxcsr = mxcsr;
+	state.fpstate.mxcsr_mask = UML_X86_64_MXCSR_MASK;
+	for (index = 0; index < 8; index++) {
+		unsigned int physical = (top + index) & 7;
+		unsigned long significand = UPT_X(guest,
+			UML_X86_64_X87_SIGNIFICAND_SLOT + physical);
+		unsigned short exponent = x86_64_x87_exponent(guest, physical);
+		unsigned char *slot = (void *)&state.fpstate.st_space[index * 4];
+
+		if (((tag >> (physical * 2)) & 3) != 3)
+			state.fpstate.twd |= 1U << physical;
+		memcpy(slot, &significand, sizeof(significand));
+		memcpy(slot + sizeof(significand), &exponent, sizeof(exponent));
+	}
+	if (task->marker == UML_X86_64_FP_MARKER) {
+		for (index = 0; index < 16; index++) {
+			memcpy(&state.fpstate.xmm_space[index * 4],
+			       task->vectors[index], 16);
+			memcpy(&state.ymmh_space[index * 4],
+			       task->vectors[index] + 16, 16);
+		}
+	}
+	state.fpstate.sw_reserved.magic1 = UML_X86_64_FP_XSTATE_MAGIC1;
+	state.fpstate.sw_reserved.extended_size =
+		UML_X86_64_XSTATE_FRAME_SIZE;
+	state.fpstate.sw_reserved.xfeatures = UML_X86_64_XFEATURES;
+	state.fpstate.sw_reserved.xstate_size = UML_X86_64_XSTATE_SIZE;
+	state.header.xfeatures = UML_X86_64_XFEATURES;
+
+	if (copy_to_user(user_state, &state, sizeof(state)))
+		return 1;
+	return put_user(magic2, (unsigned int __user *)
+		((unsigned long)user_state + sizeof(state)));
+}
+
+static int restore_x86_64_fpstate(struct pt_regs *regs,
+				  unsigned long user_address)
+{
+	struct uml_x86_64_xstate state = { };
+	struct uml_pt_regs *guest = &regs->regs;
+	struct uml_x86_64_task_fpstate *task = x86_64_task_fpstate(guest);
+	struct uml_x86_64_xstate __user *user_state =
+		(void __user *)user_address;
+	unsigned long present = UML_X86_64_XFEATURE_X87 |
+		UML_X86_64_XFEATURE_SSE;
+	unsigned int magic2;
+	unsigned int top;
+	unsigned int index;
+	unsigned short tag = 0xffff;
+	bool extended = false;
+
+	if (!user_address) {
+		clear_x86_64_fpstate(guest);
+		return 0;
+	}
+	if (!access_ok(user_state, sizeof(state.fpstate)) ||
+	    copy_from_user(&state.fpstate, user_state,
+			   sizeof(state.fpstate)))
+		return 1;
+
+	if (state.fpstate.sw_reserved.magic1 ==
+		    UML_X86_64_FP_XSTATE_MAGIC1 &&
+	    state.fpstate.sw_reserved.extended_size ==
+		    UML_X86_64_XSTATE_FRAME_SIZE &&
+	    state.fpstate.sw_reserved.xstate_size == UML_X86_64_XSTATE_SIZE) {
+		if (get_user(magic2, (unsigned int __user *)
+		    (user_address + UML_X86_64_XSTATE_SIZE)))
+			return 1;
+		if (magic2 == UML_X86_64_FP_XSTATE_MAGIC2) {
+			if (copy_from_user(&state.header, &user_state->header,
+					   sizeof(state) - sizeof(state.fpstate)))
+				return 1;
+			extended = true;
+		}
+	}
+
+	if (extended) {
+		if ((state.fpstate.sw_reserved.xfeatures &
+		     ~UML_X86_64_XFEATURES) ||
+		    (state.header.xfeatures &
+		     ~state.fpstate.sw_reserved.xfeatures))
+			return 1;
+		for (index = 0; index < ARRAY_SIZE(state.header.reserved);
+		     index++)
+			if (state.header.reserved[index])
+				return 1;
+		present = state.header.xfeatures;
+		if ((present & UML_X86_64_XFEATURE_AVX) &&
+		    !(present & UML_X86_64_XFEATURE_SSE))
+			return 1;
+	}
+	if ((present & UML_X86_64_XFEATURE_SSE) &&
+	    (state.fpstate.mxcsr & ~UML_X86_64_MXCSR_MASK))
+		return 1;
+
+	clear_x86_64_fpstate(guest);
+	if (present & UML_X86_64_XFEATURE_X87) {
+		top = (state.fpstate.swd >> 11) & 7;
+		for (index = 0; index < 8; index++) {
+			unsigned int physical = (top + index) & 7;
+			unsigned long significand;
+			unsigned short exponent;
+			unsigned char *slot =
+				(void *)&state.fpstate.st_space[index * 4];
+
+			memcpy(&significand, slot, sizeof(significand));
+			memcpy(&exponent, slot + sizeof(significand),
+			       sizeof(exponent));
+			UPT_X(guest, UML_X86_64_X87_SIGNIFICAND_SLOT + physical) =
+				significand;
+			x86_64_set_x87_exponent(guest, physical, exponent);
+			if (state.fpstate.twd & (1U << physical)) {
+				unsigned int shift = physical * 2;
+				unsigned short value = x86_64_x87_tag(
+					significand, exponent);
+
+				tag = (tag & ~(3U << shift)) | (value << shift);
+			}
+		}
+		task->x87_control_status = state.fpstate.cwd |
+			((unsigned int)(state.fpstate.swd &
+			  ~UML_X86_64_X87_TOP_MASK) << 16);
+		task->x87_tag_top = tag | (top << 16);
+	}
+	if (present & UML_X86_64_XFEATURE_SSE) {
+		task->mxcsr = state.fpstate.mxcsr;
+		for (index = 0; index < 16; index++)
+			memcpy(task->vectors[index],
+			       &state.fpstate.xmm_space[index * 4], 16);
+	}
+	if (present & UML_X86_64_XFEATURE_AVX)
+		for (index = 0; index < 16; index++)
+			memcpy(task->vectors[index] + 16,
+			       &state.ymmh_space[index * 4], 16);
+	return 0;
+}
+
+static int
+save_x86_64_mcontext(struct uml_x86_64_sigcontext __user *context,
+		     struct pt_regs *regs, unsigned long oldmask,
+		     unsigned long fpstate)
+{
+	struct uml_x86_64_sigcontext state = { };
+	struct uml_pt_regs *guest = &regs->regs;
+
+	state.r8 = UPT_X86_64(guest, UML_X86_64_R8);
+	state.r9 = UPT_X86_64(guest, UML_X86_64_R9);
+	state.r10 = UPT_X86_64(guest, UML_X86_64_R10);
+	state.r11 = UPT_X86_64(guest, UML_X86_64_R11);
+	state.r12 = UPT_X86_64(guest, UML_X86_64_R12);
+	state.r13 = UPT_X86_64(guest, UML_X86_64_R13);
+	state.r14 = UPT_X86_64(guest, UML_X86_64_R14);
+	state.r15 = UPT_X86_64(guest, UML_X86_64_R15);
+	state.di = UPT_X86_64(guest, UML_X86_64_RDI);
+	state.si = UPT_X86_64(guest, UML_X86_64_RSI);
+	state.bp = UPT_X86_64(guest, UML_X86_64_RBP);
+	state.bx = UPT_X86_64(guest, UML_X86_64_RBX);
+	state.dx = UPT_X86_64(guest, UML_X86_64_RDX);
+	state.ax = UPT_X86_64(guest, UML_X86_64_RAX);
+	state.cx = UPT_X86_64(guest, UML_X86_64_RCX);
+	state.sp = UPT_X86_64(guest, UML_X86_64_RSP);
+	state.ip = UPT_X86_64_RIP(guest);
+	state.flags = UPT_X86_64_RFLAGS(guest);
+	state.cs = UML_X86_64_USER_CS;
+	state.ss = UML_X86_64_USER_SS;
+	state.err = guest->faultinfo.error_code;
+	state.trapno = guest->faultinfo.trap_no;
+	state.oldmask = oldmask;
+	state.cr2 = guest->faultinfo.cr2;
+	state.fpstate = fpstate;
+	return copy_to_user(context, &state, sizeof(state));
+}
+
+static int
+restore_x86_64_mcontext(struct pt_regs *regs,
+			struct uml_x86_64_sigcontext __user *context)
+{
+	struct uml_x86_64_sigcontext state;
+	struct uml_pt_regs *guest = &regs->regs;
+
+	if (copy_from_user(&state, context, sizeof(state)))
+		return 1;
+	UPT_X86_64(guest, UML_X86_64_R8) = state.r8;
+	UPT_X86_64(guest, UML_X86_64_R9) = state.r9;
+	UPT_X86_64(guest, UML_X86_64_R10) = state.r10;
+	UPT_X86_64(guest, UML_X86_64_R11) = state.r11;
+	UPT_X86_64(guest, UML_X86_64_R12) = state.r12;
+	UPT_X86_64(guest, UML_X86_64_R13) = state.r13;
+	UPT_X86_64(guest, UML_X86_64_R14) = state.r14;
+	UPT_X86_64(guest, UML_X86_64_R15) = state.r15;
+	UPT_X86_64(guest, UML_X86_64_RDI) = state.di;
+	UPT_X86_64(guest, UML_X86_64_RSI) = state.si;
+	UPT_X86_64(guest, UML_X86_64_RBP) = state.bp;
+	UPT_X86_64(guest, UML_X86_64_RBX) = state.bx;
+	UPT_X86_64(guest, UML_X86_64_RDX) = state.dx;
+	UPT_X86_64(guest, UML_X86_64_RAX) = state.ax;
+	UPT_X86_64(guest, UML_X86_64_RCX) = state.cx;
+	UPT_X86_64(guest, UML_X86_64_RSP) = state.sp;
+	UPT_X86_64_RIP(guest) = state.ip;
+	UPT_X86_64_RFLAGS(guest) = state.flags | 2;
+	if ((state.cs | 3) != UML_X86_64_USER_CS ||
+	    (state.ss | 3) != UML_X86_64_USER_SS)
+		return 1;
+	x86_64_set_segment_selector(guest, 1, state.cs | 3);
+	x86_64_set_segment_selector(guest, 2, state.ss | 3);
+	if (restore_x86_64_fpstate(regs, state.fpstate))
+		return 1;
+	guest->svcr &= ~UML_X86_64_COMPAT_SYSCALL;
+	PT_REGS_SYSCALL_NR(regs) = -1;
+	return 0;
+}
+
+static int setup_x86_64_signal_stack(unsigned long stack_top,
+				     struct ksignal *ksig,
+				     struct pt_regs *regs, sigset_t *mask)
+{
+	struct uml_x86_64_rt_sigframe __user *frame;
+	struct uml_x86_64_xstate __user *fpstate;
+	unsigned long frame_end;
+	unsigned long restorer;
+	int error = 0;
+
+	if (stack_top < 128 + UML_X86_64_XSTATE_FRAME_SIZE)
+		return 1;
+	fpstate = (void __user *)round_down(stack_top - 128 -
+		UML_X86_64_XSTATE_FRAME_SIZE, 64);
+	frame = (void __user *)((unsigned long)fpstate - sizeof(*frame));
+	frame = (void __user *)round_down((unsigned long)frame, 16);
+	frame = (void __user *)((unsigned long)frame - 8);
+	frame_end = (unsigned long)fpstate + UML_X86_64_XSTATE_FRAME_SIZE;
+	if (frame_end < (unsigned long)frame ||
+	    !access_ok(frame, frame_end - (unsigned long)frame))
+		return 1;
+
+	if (ksig->ka.sa.sa_flags & SA_RESTORER)
+		restorer = (unsigned long)ksig->ka.sa.sa_restorer;
+#ifdef UML_HOST_DARWIN
+	else
+		restorer = UML_DARWIN_SIGRETURN_TRAMPOLINE;
+#else
+	else
+		return 1;
+#endif
+
+	error |= put_user(restorer, &frame->pretcode);
+	error |= put_user(UML_X86_64_UC_FP_XSTATE |
+			  UML_X86_64_UC_SIGCONTEXT_SS |
+			  UML_X86_64_UC_STRICT_RESTORE_SS,
+			  &frame->uc.uc_flags);
+	error |= put_user(0, &frame->uc.uc_link);
+	error |= __save_altstack(&frame->uc.uc_stack,
+		UPT_X86_64(&regs->regs, UML_X86_64_RSP));
+	error |= __copy_to_user(&frame->uc.uc_sigmask, mask, sizeof(*mask));
+	error |= save_x86_64_fpstate(fpstate, regs);
+	error |= save_x86_64_mcontext(&frame->uc.uc_mcontext, regs,
+		mask->sig[0], (unsigned long)fpstate);
+	if (ksig->ka.sa.sa_flags & SA_SIGINFO)
+		error |= copy_siginfo_to_user(&frame->info, &ksig->info);
+	if (error)
+		return error;
+
+	clear_x86_64_fpstate(&regs->regs);
+	x86_64_set_segment_selector(&regs->regs, 1, UML_X86_64_USER_CS);
+	x86_64_set_segment_selector(&regs->regs, 2, UML_X86_64_USER_SS);
+	regs->regs.svcr &= ~UML_X86_64_COMPAT_SYSCALL;
+	UPT_X86_64(&regs->regs, UML_X86_64_RDI) = ksig->sig;
+	UPT_X86_64(&regs->regs, UML_X86_64_RSI) =
+		(unsigned long)&frame->info;
+	UPT_X86_64(&regs->regs, UML_X86_64_RDX) =
+		(unsigned long)&frame->uc;
+	UPT_X86_64(&regs->regs, UML_X86_64_RAX) = 0;
+	UPT_X86_64(&regs->regs, UML_X86_64_RSP) = (unsigned long)frame;
+	UPT_X86_64_RIP(&regs->regs) =
+		(unsigned long)ksig->ka.sa.sa_handler;
+	UPT_X86_64_RFLAGS(&regs->regs) &=
+		~(UML_X86_64_RFLAGS_TF | UML_X86_64_RFLAGS_DF |
+		  UML_X86_64_RFLAGS_RF);
+	return 0;
+}
