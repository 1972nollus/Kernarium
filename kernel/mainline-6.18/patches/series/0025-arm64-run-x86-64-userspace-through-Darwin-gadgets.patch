--- a/arch/arm64/um/shared/sysdep/ptrace.h
+++ b/arch/arm64/um/shared/sysdep/ptrace.h
@@ -22,15 +22,30 @@
 #define UPT_IP(regs) REGS_IP((regs)->gp)
 #define UPT_PSTATE(regs) REGS_PSTATE((regs)->gp)
 
-#define UPT_SYSCALL_ARG1(regs) ((regs)->orig_x0)
-#define UPT_SYSCALL_ARG2(regs) UPT_X((regs), 1)
-#define UPT_SYSCALL_ARG3(regs) UPT_X((regs), 2)
-#define UPT_SYSCALL_ARG4(regs) UPT_X((regs), 3)
-#define UPT_SYSCALL_ARG5(regs) UPT_X((regs), 4)
