 struct uml_pt_regs {
 	unsigned long gp[MAX_REG_NR];
@@ -55,17 +70,94 @@ struct uml_pt_regs {
 	unsigned long fp[];
 };
 
+static inline int upt_is_x86_64(const struct uml_pt_regs *regs)
+{
+	return regs->padding == UML_GUEST_ISA_X86_64;
+}
+
+#define UPT_IS_X86_64(regs) upt_is_x86_64(regs)
+#define UPT_X86_64(regs, n) UPT_X((regs), (n))
+#define UPT_X86_64_RIP(regs) UPT_IP(regs)
+#define UPT_X86_64_RFLAGS(regs) UPT_X((regs), 16)
+#define UPT_X86_64_FS_BASE(regs) UPT_X((regs), 17)
+#define UPT_X86_64_GS_BASE(regs) UPT_X((regs), 18)
+
+static inline unsigned long *upt_sp(struct uml_pt_regs *regs)
+{
+	return upt_is_x86_64(regs) ?
+		&UPT_X86_64(regs, UML_X86_64_RSP) : &regs->gp[HOST_SP];
+}
+
+#undef UPT_SP
+#define UPT_SP(regs) (*upt_sp(regs))
+
+static inline unsigned long *upt_syscall_return(struct uml_pt_regs *regs)
+{
+	return upt_is_x86_64(regs) ?
+		&UPT_X86_64(regs, UML_X86_64_RAX) : &regs->gp[HOST_X0];
+}
+
+#define UPT_SYSCALL_RETURN(regs) (*upt_syscall_return(regs))
+
+static inline unsigned long
+upt_syscall_arch_nr(const struct uml_pt_regs *regs)
+{
+	return upt_is_x86_64(regs) ?
+		UPT_X86_64(regs, UML_X86_64_RAX) : regs->gp[HOST_X8];
+}
+
+#define UPT_SYSCALL_ARCH_NR(regs) upt_syscall_arch_nr(regs)
+
+static inline unsigned long *
+upt_syscall_argument(struct uml_pt_regs *regs, unsigned int argument)
+{
+	static const unsigned char x86_registers[] = {
+		UML_X86_64_RDI, UML_X86_64_RSI, UML_X86_64_RDX,
+		UML_X86_64_R10, UML_X86_64_R8, UML_X86_64_R9,
+	};
+
+	if (upt_is_x86_64(regs))
+		return &UPT_X86_64(regs, x86_registers[argument]);
+	return argument == 0 ? &regs->orig_x0 : &regs->gp[HOST_X0 + argument];
+}
+
+#define UPT_SYSCALL_ARG1(regs) (*upt_syscall_argument((regs), 0))
+#define UPT_SYSCALL_ARG2(regs) (*upt_syscall_argument((regs), 1))
+#define UPT_SYSCALL_ARG3(regs) (*upt_syscall_argument((regs), 2))
+#define UPT_SYSCALL_ARG4(regs) (*upt_syscall_argument((regs), 3))
+#define UPT_SYSCALL_ARG5(regs) (*upt_syscall_argument((regs), 4))
+#define UPT_SYSCALL_ARG6(regs) (*upt_syscall_argument((regs), 5))
+
+static inline void upt_save_original_syscall(struct uml_pt_regs *regs)
+{
+	regs->orig_x0 = upt_is_x86_64(regs) ?
+		UPT_X86_64(regs, UML_X86_64_RAX) : regs->gp[HOST_X0];
+}
+
+#define UPT_SAVE_ORIGINAL_SYSCALL(regs) upt_save_original_syscall(regs)
+
+static inline void upt_syscall_rollback(struct uml_pt_regs *regs)
+{
+	if (upt_is_x86_64(regs))
+		UPT_X86_64(regs, UML_X86_64_RAX) = regs->orig_x0;
+	else
+		regs->gp[HOST_X0] = regs->orig_x0;
+}
+
+#define UPT_SYSCALL_ROLLBACK(regs) upt_syscall_rollback(regs)
+
 #define EMPTY_UML_PT_REGS { }
 #define UPT_SYSCALL_NR(regs) ((regs)->syscall)
 #define UPT_FAULTINFO(regs) (&(regs)->faultinfo)
 #define UPT_IS_USER(regs) ((regs)->is_user)
 #define UPT_RESTART_SYSCALL(regs) do { \
-	/* AArch64 returns syscall results in x0, which is also argument 1. \
-	 * Restore it before re-executing SVC; unlike x86, rewinding the PC \
-	 * alone would retry with -ERESTART* as the first argument. \
-	 */ \
-	UPT_X((regs), 0) = (regs)->orig_x0; \
-	UPT_IP(regs) -= 4; \
+	if (UPT_IS_X86_64(regs)) { \
+		UPT_X86_64((regs), UML_X86_64_RAX) = (regs)->orig_x0; \
+		UPT_IP(regs) -= 2; \
+	} else { \
+		UPT_X((regs), 0) = (regs)->orig_x0; \
+		UPT_IP(regs) -= 4; \
+	} \
 } while (0)
 
 extern unsigned long host_fp_size;
diff --git a/arch/arm64/um/signal.c b/arch/arm64/um/signal.c
index 5df9d3a0e..36f53526f 100644
--- a/arch/arm64/um/signal.c
+++ b/arch/arm64/um/signal.c
@@ -17,6 +17,60 @@ struct uml_arm64_rt_sigframe {
 	struct ucontext uc;
 };
 
+/* Keep this layout independent from the host architecture headers.  It is the
+ * Linux x86-64 userspace sigcontext/ucontext ABI, with no advertised FP state
+ * until the x86 backend grows vector registers.
+ */
+struct uml_x86_64_sigcontext {
+	unsigned long r8;
+	unsigned long r9;
+	unsigned long r10;
+	unsigned long r11;
+	unsigned long r12;
+	unsigned long r13;
+	unsigned long r14;
+	unsigned long r15;
+	unsigned long di;
+	unsigned long si;
+	unsigned long bp;
+	unsigned long bx;
+	unsigned long dx;
+	unsigned long ax;
+	unsigned long cx;
+	unsigned long sp;
+	unsigned long ip;
+	unsigned long flags;
+	unsigned short cs;
+	unsigned short gs;
+	unsigned short fs;
+	unsigned short ss;
+	unsigned long err;
+	unsigned long trapno;
+	unsigned long oldmask;
+	unsigned long cr2;
+	unsigned long fpstate;
+	unsigned long reserved1[8];
+};
+
+struct uml_x86_64_ucontext {
+	unsigned long uc_flags;
+	unsigned long uc_link;
+	stack_t uc_stack;
+	struct uml_x86_64_sigcontext uc_mcontext;
+	sigset_t uc_sigmask;
+};
+
+struct uml_x86_64_rt_sigframe {
+	unsigned long pretcode;
+	struct uml_x86_64_ucontext uc;
+	struct siginfo info;
+};
+
+#define UML_X86_64_USER_CS 0x33
+#define UML_X86_64_USER_SS 0x2b
+#define UML_X86_64_UC_SIGCONTEXT_SS 0x2
+#define UML_X86_64_UC_STRICT_RESTORE_SS 0x4
+
 #ifdef UML_HOST_DARWIN
 /* The final guest page is deliberately above STACK_TOP and never mapped.
  * Returning there lets the Darwin Mach exception bridge synthesize the
@@ -98,6 +152,122 @@ static int restore_mcontext(struct pt_regs *regs,
 	return error;
 }
 
+static int
+save_x86_64_mcontext(struct uml_x86_64_sigcontext __user *context,
+		     struct pt_regs *regs, unsigned long oldmask)
+{
+	struct uml_x86_64_sigcontext state = { };
+	struct uml_pt_regs *guest = &regs->regs;
+
+	state.r8 = UPT_X86_64(guest, UML_X86_64_R8);
+	state.r9 = UPT_X86_64(guest, UML_X86_64_R9);
+	state.r10 = UPT_X86_64(guest, UML_X86_64_R10);
+	state.r11 = UPT_X86_64(guest, UML_X86_64_R11);
+	state.r12 = UPT_X86_64(guest, UML_X86_64_R12);
+	state.r13 = UPT_X86_64(guest, UML_X86_64_R13);
+	state.r14 = UPT_X86_64(guest, UML_X86_64_R14);
+	state.r15 = UPT_X86_64(guest, UML_X86_64_R15);
+	state.di = UPT_X86_64(guest, UML_X86_64_RDI);
+	state.si = UPT_X86_64(guest, UML_X86_64_RSI);
+	state.bp = UPT_X86_64(guest, UML_X86_64_RBP);
+	state.bx = UPT_X86_64(guest, UML_X86_64_RBX);
+	state.dx = UPT_X86_64(guest, UML_X86_64_RDX);
+	state.ax = UPT_X86_64(guest, UML_X86_64_RAX);
+	state.cx = UPT_X86_64(guest, UML_X86_64_RCX);
+	state.sp = UPT_X86_64(guest, UML_X86_64_RSP);
+	state.ip = UPT_X86_64_RIP(guest);
+	state.flags = UPT_X86_64_RFLAGS(guest);
+	state.cs = UML_X86_64_USER_CS;
+	state.ss = UML_X86_64_USER_SS;
+	state.err = guest->faultinfo.error_code;
+	state.trapno = guest->faultinfo.trap_no;
+	state.oldmask = oldmask;
+	state.cr2 = guest->faultinfo.cr2;
+	return copy_to_user(context, &state, sizeof(state));
+}
+
+static int
+restore_x86_64_mcontext(struct pt_regs *regs,
+			struct uml_x86_64_sigcontext __user *context)
+{
+	struct uml_x86_64_sigcontext state;
+	struct uml_pt_regs *guest = &regs->regs;
+
+	if (copy_from_user(&state, context, sizeof(state)))
+		return 1;
+	UPT_X86_64(guest, UML_X86_64_R8) = state.r8;
+	UPT_X86_64(guest, UML_X86_64_R9) = state.r9;
+	UPT_X86_64(guest, UML_X86_64_R10) = state.r10;
+	UPT_X86_64(guest, UML_X86_64_R11) = state.r11;
+	UPT_X86_64(guest, UML_X86_64_R12) = state.r12;
+	UPT_X86_64(guest, UML_X86_64_R13) = state.r13;
+	UPT_X86_64(guest, UML_X86_64_R14) = state.r14;
+	UPT_X86_64(guest, UML_X86_64_R15) = state.r15;
+	UPT_X86_64(guest, UML_X86_64_RDI) = state.di;
+	UPT_X86_64(guest, UML_X86_64_RSI) = state.si;
+	UPT_X86_64(guest, UML_X86_64_RBP) = state.bp;
+	UPT_X86_64(guest, UML_X86_64_RBX) = state.bx;
+	UPT_X86_64(guest, UML_X86_64_RDX) = state.dx;
+	UPT_X86_64(guest, UML_X86_64_RAX) = state.ax;
+	UPT_X86_64(guest, UML_X86_64_RCX) = state.cx;
+	UPT_X86_64(guest, UML_X86_64_RSP) = state.sp;
+	UPT_X86_64_RIP(guest) = state.ip;
+	UPT_X86_64_RFLAGS(guest) = state.flags | 2;
+	PT_REGS_SYSCALL_NR(regs) = -1;
+	return 0;
+}
+
+static int setup_x86_64_signal_stack(unsigned long stack_top,
+				     struct ksignal *ksig,
+				     struct pt_regs *regs, sigset_t *mask)
+{
+	struct uml_x86_64_rt_sigframe __user *frame;
+	unsigned long restorer;
+	int error = 0;
+
+	frame = (void __user *)(stack_top - sizeof(*frame));
+	frame = (void __user *)round_down((unsigned long)frame, 16);
+	frame = (void __user *)((unsigned long)frame - 128 - 8);
+	if (!access_ok(frame, sizeof(*frame)))
+		return 1;
+
+	if (ksig->ka.sa.sa_flags & SA_RESTORER)
+		restorer = (unsigned long)ksig->ka.sa.sa_restorer;
+#ifdef UML_HOST_DARWIN
+	else
+		restorer = UML_DARWIN_SIGRETURN_TRAMPOLINE;
+#else
+	else
+		return 1;
+#endif
+
+	error |= put_user(restorer, &frame->pretcode);
+	error |= put_user(UML_X86_64_UC_SIGCONTEXT_SS |
+			  UML_X86_64_UC_STRICT_RESTORE_SS,
+			  &frame->uc.uc_flags);
+	error |= put_user(0, &frame->uc.uc_link);
+	error |= __save_altstack(&frame->uc.uc_stack,
+		UPT_X86_64(&regs->regs, UML_X86_64_RSP));
+	error |= __copy_to_user(&frame->uc.uc_sigmask, mask, sizeof(*mask));
+	error |= save_x86_64_mcontext(&frame->uc.uc_mcontext, regs,
+		mask->sig[0]);
+	if (ksig->ka.sa.sa_flags & SA_SIGINFO)
+		error |= copy_siginfo_to_user(&frame->info, &ksig->info);
+	if (error)
+		return error;
+
+	UPT_X86_64(&regs->regs, UML_X86_64_RDI) = ksig->sig;
+	UPT_X86_64(&regs->regs, UML_X86_64_RSI) =
+		(unsigned long)&frame->info;
+	UPT_X86_64(&regs->regs, UML_X86_64_RDX) =
+		(unsigned long)&frame->uc;
+	UPT_X86_64(&regs->regs, UML_X86_64_RAX) = 0;
+	UPT_X86_64(&regs->regs, UML_X86_64_RSP) = (unsigned long)frame;
+	UPT_X86_64_RIP(&regs->regs) =
+		(unsigned long)ksig->ka.sa.sa_handler;
+	return 0;
+}
+
 int setup_signal_stack_si(unsigned long stack_top, struct ksignal *ksig,
 			  struct pt_regs *regs, sigset_t *mask)
 {
@@ -105,6 +275,9 @@ int setup_signal_stack_si(unsigned long stack_top, struct ksignal *ksig,
 	unsigned long restorer;
 	int error = 0;
 
+	if (UPT_IS_X86_64(&regs->regs))
+		return setup_x86_64_signal_stack(stack_top, ksig, regs, mask);
