-	(UPT_X((regs), 0) = (regs)->orig_x0)
+enum uml_guest_isa {
+	UML_GUEST_ISA_ARM64 = 1,
+	UML_GUEST_ISA_X86_64 = 2,
+};
+
+enum uml_x86_64_register {
+	UML_X86_64_RAX,
+	UML_X86_64_RCX,
+	UML_X86_64_RDX,
+	UML_X86_64_RBX,
+	UML_X86_64_RSP,
+	UML_X86_64_RBP,
+	UML_X86_64_RSI,
+	UML_X86_64_RDI,
