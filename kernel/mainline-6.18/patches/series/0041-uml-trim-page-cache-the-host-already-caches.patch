From c6a2d80ff47b92dc370beff862f2ebbcdba397f4 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 24 Sep 2026 11:27:11 +0900
Subject: [PATCH 41/42] uml: trim page cache the host already caches

Every UML disk is a host file with a host page cache of its own, so a
guest page-cache page duplicates data the host already holds. Only the
guest's copy is charged to the emulator process: on iOS the host file
cache does not count against the application's memory limit at all.
Linux keeps page cache until memory runs out, so a file the guest read
once stayed resident at the application's expense for the rest of the
boot, and with guest RAM now returned on demand it is page cache that
keeps the footprint up.

Reclaim it early instead. A deferrable worker shrinks the inactive file
pages above a floor by a quarter every two seconds, through the same
proactive reclaim memory.reclaim uses, without swap. Freed pages reach
the host through free-page reporting, and reading one back is a copy
from the host's cache. Reclaim takes the coldest pages first and leaves
writeback to the flusher, and workingset refault detection promotes a
page that comes back soon. page_cache_trim.interval_ms and
page_cache_trim.floor_mb tune or disable it.
---
 arch/um/kernel/Makefile          |  2 +-
 arch/um/kernel/page_cache_trim.c | 89 ++++++++++++++++++++++++++++++++
 2 files changed, 90 insertions(+), 1 deletion(-)
 create mode 100644 arch/um/kernel/page_cache_trim.c

diff --git a/arch/um/kernel/Makefile b/arch/um/kernel/Makefile
index 5777ded66..3c0e879c2 100644
--- a/arch/um/kernel/Makefile
+++ b/arch/um/kernel/Makefile
@@ -18,7 +18,7 @@ obj-y = config.o exec.o exitcode.o irq.o ksyms.o mem.o \
 	physmem.o process.o ptrace.o reboot.o sigio.o \
 	signal.o sysrq.o time.o tlb.o trap.o \
 	um_arch.o umid.o kmsg_dump.o skas/
-obj-y += load_file.o
+obj-y += load_file.o page_cache_trim.o
 
 obj-$(CONFIG_UML_ARM64) += capflags_arm64.o
 obj-$(CONFIG_UML_X86) += capflags.o
diff --git a/arch/um/kernel/page_cache_trim.c b/arch/um/kernel/page_cache_trim.c
new file mode 100644
index 000000000..19936a1b2
--- /dev/null
+++ b/arch/um/kernel/page_cache_trim.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Trim page cache that the host already caches.
+ *
+ * Every guest disk is a host file, and the host keeps a page cache of its
+ * own for it. A guest page-cache page therefore duplicates data the host
+ * already holds, but only the guest's copy is charged to the emulator: on iOS
+ * the host file cache does not count against the application's memory limit
+ * at all. Linux keeps page cache until memory runs out, so a file the guest
+ * read once stayed resident at the application's expense for the rest of the
+ * boot.
+ *
+ * Hand cold page cache back early instead. Every interval, the inactive file
+ * pages above a floor shrink by a quarter through the kernel's proactive
+ * reclaim, the mechanism behind memory.reclaim, restricted to file pages.
+ * Freed pages reach the host through free-page reporting, and reading one
+ * back costs a copy from the host's cache. Proactive reclaim never swaps
+ * here and leaves writeback to the flusher, it takes the coldest pages
+ * first, and workingset refault detection promotes a page that comes back
+ * soon, so a working set that is actually in use stays resident.
+ *
+ * page_cache_trim.interval_ms=0 disables trimming; page_cache_trim.floor_mb
+ * sets the inactive file cache it keeps, which defaults to 1/32 of RAM.
+ */
+
+#include <linux/init.h>
+#include <linux/memcontrol.h>
+#include <linux/jiffies.h>
+#include <linux/minmax.h>
+#include <linux/mm.h>
+#include <linux/moduleparam.h>
+#include <linux/swap.h>
+#include <linux/vmstat.h>
+#include <linux/workqueue.h>
+
+#undef MODULE_PARAM_PREFIX
+#define MODULE_PARAM_PREFIX "page_cache_trim."
+
+static unsigned int interval_ms = 2000;
+module_param(interval_ms, uint, 0644);
+MODULE_PARM_DESC(interval_ms, "Milliseconds between page-cache trims, or 0 to disable");
+
+static unsigned int floor_mb;
+module_param(floor_mb, uint, 0644);
+MODULE_PARM_DESC(floor_mb, "Inactive file cache kept, in MiB (0 selects 1/32 of RAM)");
+
+/* Bounds one pass to a few milliseconds of reclaim work. */
+#define PAGE_CACHE_TRIM_MAX_BYTES (32UL << 20)
+
+static void page_cache_trim(struct work_struct *work);
+static DECLARE_DEFERRABLE_WORK(page_cache_trim_work, page_cache_trim);
+
+static unsigned long page_cache_trim_floor(void)
+{
+	unsigned int floor = READ_ONCE(floor_mb);
+
+	if (floor)
+		return (unsigned long)floor << (20 - PAGE_SHIFT);
+	return totalram_pages() / 32;
+}
+
+static void page_cache_trim(struct work_struct *work)
+{
+	unsigned long inactive = global_node_page_state(NR_INACTIVE_FILE);
+	unsigned long floor = page_cache_trim_floor();
+	unsigned int interval = READ_ONCE(interval_ms);
+
+	/* Without MEMCG_RECLAIM_MAY_SWAP, reclaim takes file pages only. */
+	if (inactive > floor && !mem_cgroup_disabled())
+		try_to_free_mem_cgroup_pages(root_mem_cgroup,
+			min((inactive - floor + 3) / 4,
+			    PAGE_CACHE_TRIM_MAX_BYTES >> PAGE_SHIFT),
+			GFP_KERNEL, MEMCG_RECLAIM_PROACTIVE, NULL);
+	/* A disabled trimmer stops here; re-enabling it takes a reboot. */
+	if (interval)
+		queue_delayed_work(system_unbound_wq, &page_cache_trim_work,
+				   msecs_to_jiffies(interval));
+}
+
+static int __init page_cache_trim_init(void)
+{
+	unsigned int interval = READ_ONCE(interval_ms);
+
+	if (interval)
+		queue_delayed_work(system_unbound_wq, &page_cache_trim_work,
+				   msecs_to_jiffies(interval));
+	return 0;
+}
+late_initcall(page_cache_trim_init);
