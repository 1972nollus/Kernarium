+++ b/arch/um/include/asm/common.lds.S
@@ -5,7 +5,15 @@
   _etext = .;
   PROVIDE (etext = .);
 
+  /* A 4 KiB Darwin guest still executes inside 16 KiB host VM slots.  Keep
+   * native kernel text and writable data in different host slots so the
+   * non-JIT path needs neither W+X nor runtime permission transitions.
+   */
+#ifdef UML_HOST_DARWIN
+  . = ALIGN(0x4000);
+#else
   . = ALIGN(4096);
+#endif
   _sdata = .;
   PROVIDE (sdata = .);
 
@@ -64,7 +72,11 @@
 	__uml_exitcall_end = .;
   }
 
-  . = ALIGN(4);
+  /* Darwin ARM64 protects memory in 16 KiB pages.  Keep .exit.text between
+   * host-page boundaries: its preceding exit-call tables and following init
+   * data are writable, while orderly shutdown must still execute this code.
+   */
+  . = ALIGN(0x4000);
   .altinstructions : {
 	__alt_instructions = .;
 	*(.altinstructions)
@@ -74,6 +86,7 @@
