 arch/um/include/shared/os.h                 |   7 +-
 arch/um/kernel/mem.c                        |   2 +
 arch/um/kernel/physmem.c                    | 180 ++++++++++++++++----
 arch/um/os-Darwin/mem.c                     |  34 ++--
 arch/um/os-Darwin/skas/process.c            |   4 +-
 arch/um/os-Darwin/uml_darwin_abi.h          |   4 +-
 arch/um/os-Darwin/uml_darwin_abi_identity.h |   4 +-
 arch/um/os-Darwin/uml_darwin_memory.h       |   9 +
 9 files changed, 190 insertions(+), 65 deletions(-)

