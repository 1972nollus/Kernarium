From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 3 Aug 2026 17:24:12 +0900
Subject: [PATCH] smack: use the connected socket for stream sendmsg checks

Apply the reviewed final-state topic without intermediate churn.
---
 security/smack/smack_lsm.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/security/smack/smack_lsm.c b/security/smack/smack_lsm.c
index 7fd8a60b8be908faa36569c55c677d44404d60b0..b99be69f73b106162b3804d4266efa31b7ad8ecf 100644
--- a/security/smack/smack_lsm.c
+++ b/security/smack/smack_lsm.c
@@ -4033,6 +4033,14 @@ static int smack_socket_sendmsg(struct socket *sock, struct msghdr *msg,
 	if (sip == NULL)
 		return 0;
 
+	/*
+	 * A destination supplied to sendmsg(2) is ignored for an already
+	 * connected stream socket.  The peer was checked by socket_connect(),
+	 * so validating the ignored address here can only change send semantics.
+	 */
+	if (sock->type == SOCK_STREAM && sock->state == SS_CONNECTED)
+		return 0;
+
 	switch (sock->sk->sk_family) {
 	case AF_INET:
 		if (msg->msg_namelen < sizeof(struct sockaddr_in) ||
