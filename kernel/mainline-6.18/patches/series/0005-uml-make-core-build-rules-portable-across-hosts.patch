From bf900e860dfc420e61713f02dc3684d71d6086fd Mon Sep 17 00:00:00 2001
From: Darwin UML maintainers <uml-darwin@example.invalid>
Date: Mon, 3 Aug 2026 17:24:07 +0900
Subject: [PATCH 05/29] uml: make core build rules portable across hosts

Wire the split core objects and use a host-portable configuration transform in one build-only final-state topic.
---
 arch/um/kernel/Makefile | 23 +++++++++++++----------
 1 file changed, 13 insertions(+), 10 deletions(-)

diff --git a/arch/um/kernel/Makefile b/arch/um/kernel/Makefile
index b8f4e9281..5777ded66 100644
--- a/arch/um/kernel/Makefile
+++ b/arch/um/kernel/Makefile
@@ -17,14 +17,19 @@ always-$(KBUILD_BUILTIN) := vmlinux.lds
 obj-y = config.o exec.o exitcode.o irq.o ksyms.o mem.o \
 	physmem.o process.o ptrace.o reboot.o sigio.o \
 	signal.o sysrq.o time.o tlb.o trap.o \
-	um_arch.o umid.o kmsg_dump.o capflags.o skas/
+	um_arch.o umid.o kmsg_dump.o skas/
 obj-y += load_file.o
 
+obj-$(CONFIG_UML_ARM64) += capflags_arm64.o
+obj-$(CONFIG_UML_X86) += capflags.o
+
 obj-$(CONFIG_BLK_DEV_INITRD) += initrd.o
 obj-$(CONFIG_GPROF)	+= gprof_syms.o
 obj-$(CONFIG_OF) += dtb.o
+obj-$(CONFIG_HUGETLB_PAGE) += hugetlb.o
 obj-$(CONFIG_EARLY_PRINTK) += early_printk.o
 obj-$(CONFIG_STACKTRACE) += stacktrace.o
+obj-$(CONFIG_SMP) += smp.o
 
 USER_OBJS := config.o
 
@@ -32,8 +37,9 @@ include $(srctree)/arch/um/scripts/Makefile.rules
 
 targets := config.c config.tmp capflags.c
 
-# Be careful with the below Sed code - sed is pitfall-rich!
-# We use sed to lower build requirements, for "embedded" builders for instance.
+# Keep this transformation in POSIX awk.  GNU and BSD sed disagree on the
+# syntax of an appended line, which otherwise prevents UML from being built on
+# Darwin hosts.
 
 $(obj)/config.tmp: $(objtree)/.config FORCE
 	$(call if_changed,quote1)
@@ -55,10 +61,7 @@ $(obj)/capflags.c: $(cpufeature) $(vmxfeature) $(src)/../../x86/kernel/cpu/mkcap
 	$(call if_changed,mkcapflags)
 
 quiet_cmd_quote2 = QUOTE   $@
-      cmd_quote2 = sed -e '/CONFIG/{'          \
-		  -e 's/"CONFIG"//'            \
-		  -e 'r $(obj)/config.tmp'     \
-		  -e 'a \'                     \
-		  -e '""'                      \
-		  -e '}'                       \
-		  $< > $@
+      cmd_quote2 = awk -v config='$(obj)/config.tmp' \
+		  '/"CONFIG"/ { while ((getline line < config) > 0) \
+		  print line; close(config); print "\"\""; next } \
+		  { print }' $< > $@
