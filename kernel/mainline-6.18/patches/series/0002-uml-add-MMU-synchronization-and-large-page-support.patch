diff --git a/arch/um/kernel/skas/mmu_darwin.c b/arch/um/kernel/skas/mmu_darwin.c
new file mode 100644
index 000000000..5ad85f4e0
--- /dev/null
+++ b/arch/um/kernel/skas/mmu_darwin.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Same-process mm lifetime management for the Darwin UML backend. */
+
+#include <linux/atomic.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/mutex.h>
+#include <asm/mm_hooks.h>
+#include <kern_util.h>
+#include <os.h>
+
+static atomic_t darwin_mm_generation = ATOMIC_INIT(1);
+
+/* The turnstile must be owned by the guest task, not by the host carrier
+ * thread.  A task can be scheduled out inside this region, so taking only
+ * the host walker mutex lets every other carrier block on it and consume
+ * the very virtual CPUs the holder needs to make progress.  Take the
+ * sleeping guest mutex first, exactly as the Linux host backend does: a
+ * waiter then blocks as a Linux task and releases its virtual CPU, and the
+ * host walker lock behind it is uncontended.
+ */
+void enter_turnstile(struct mm_id *id) __acquires(turnstile)
+{
+	struct mm_context *ctx = container_of(id, struct mm_context, id);
+
+	mutex_lock(&ctx->turnstile);
+	if (darwin_uml_vm_walker_lock(id->darwin_generation) < 0)
+		panic("Darwin: unable to lock address-space walker %lu",
+		      id->darwin_generation);
+}
+
+void exit_turnstile(struct mm_id *id) __releases(turnstile)
+{
+	struct mm_context *ctx = container_of(id, struct mm_context, id);
+
+	if (darwin_uml_vm_walker_unlock(id->darwin_generation) < 0)
+		panic("Darwin: unable to unlock address-space walker %lu",
+		      id->darwin_generation);
+	mutex_unlock(&ctx->turnstile);
+}
+
+void arch_exit_mmap(struct mm_struct *mm)
+{
+#ifndef CONFIG_PAGE_SIZE_16KB
+	/* exit_mmap() is about to free the physical pages which back this mm.
+	 * Commit live private 4 KiB shadows while those pages still belong to
+	 * the exiting address space.  A later destroy_context() must not be the
+	 * first writeback point because the same PFN may already have been reused.
+	 */
+	if (darwin_uml_vm_flush_generation(
+			mm->context.id.darwin_generation) < 0)
+		panic("Darwin: unable to flush exiting address space %lu",
+		      mm->context.id.darwin_generation);
+#else
+	(void)mm;
+#endif
+}
+
+int arch_unmap_one(struct mm_struct *mm, struct vm_area_struct *vma,
+		   unsigned long addr, pte_t orig_pte)
+{
+	(void)vma;
+	(void)orig_pte;
+	return darwin_uml_vm_unmap_generation(
+		mm->context.id.darwin_generation, (void *)addr, PAGE_SIZE);
+}
+
+int init_new_context(struct task_struct *task, struct mm_struct *mm)
+{
+	struct mm_id *id = &mm->context.id;
+
+	mutex_init(&mm->context.turnstile);
+	spin_lock_init(&mm->context.sync_tlb_lock);
+	mm->context.sync_tlb_range_count = 0;
+
+	/*
+	 * This is a guest address-space number, not a Darwin PID.  The host
+	 * backend uses it to select the guest address-space mappings associated
+	 * with the Linux page tables.
+	 */
+	id->pid = atomic_inc_return(&darwin_mm_generation);
+	id->darwin_generation = id->pid;
+	id->darwin_context = NULL;
+	id->stack = 0;
+	id->sock = -1;
+	id->syscall_data_len = 0;
+	id->syscall_fd_num = 0;
+
+	return 0;
+}
+
+void destroy_context(struct mm_struct *mm)
+{
+	struct mm_id *id = &mm->context.id;
+
+	if (id->darwin_generation > 0 &&
+	    darwin_uml_vm_destroy(id->darwin_generation) < 0)
+		panic("Darwin: unable to destroy guest address space %lu",
+		      id->darwin_generation);
+	id->darwin_context = NULL;
+	id->pid = -1;
+}
