 arch/um/kernel/process.c                    |  14 +-
 arch/um/kernel/skas/process.c               |   2 +
 arch/um/os-Darwin/internal.h                |  20 +-
 arch/um/os-Darwin/main.c                    |   5 +-
 arch/um/os-Darwin/signal.c                  |  17 +-
 arch/um/os-Darwin/skas/process.c            | 584 ++------------------
 arch/um/os-Darwin/smp.c                     | 207 +++++--
 arch/um/os-Darwin/time.c                    |  17 +-
 arch/um/os-Darwin/uml_darwin_abi.h          |   6 +-
 arch/um/os-Darwin/uml_darwin_abi_identity.h |   4 +-
 arch/um/os-Darwin/uml_darwin_host.h         |   2 +
 12 files changed, 284 insertions(+), 603 deletions(-)

diff --git a/arch/arm64/um/asm/processor.h b/arch/arm64/um/asm/processor.h
index 3cf7106cc..c113d51b8 100644
--- a/arch/arm64/um/asm/processor.h
+++ b/arch/arm64/um/asm/processor.h
@@ -39,13 +39,22 @@ static inline void arch_copy_thread(struct arch_thread *from,
 	((address) + 65536 + 32 * sizeof(unsigned long) >= \
 	 UPT_SP(&current->thread.regs.regs))
 
+#ifdef UML_HOST_DARWIN
+void darwin_cpu_relax(void);
+#endif
+
 static __always_inline void cpu_relax(void)
 {
 	if (time_travel_mode == TT_MODE_INFCPU ||
 	    time_travel_mode == TT_MODE_EXTERNAL)
 		time_travel_ndelay(1);
+#ifdef UML_HOST_DARWIN
+	else
+		darwin_cpu_relax();
+#else
 	else
 		asm volatile("yield" : : : "memory");
+#endif
 }
 
 #define task_pt_regs(task) (&(task)->thread.regs)
diff --git a/arch/um/kernel/process.c b/arch/um/kernel/process.c
index 9dcd8758f..838272e9b 100644
--- a/arch/um/kernel/process.c
+++ b/arch/um/kernel/process.c
@@ -121,13 +121,11 @@ void new_thread_handler(void)
 		schedule_tail(current->thread.prev_sched);
 #ifdef UML_HOST_DARWIN
 		/*
-		 * Linux-host UML transfers to a new kernel stack with siglongjmp(),
-		 * which restores the signal/IRQ state saved by the scheduler.  Darwin
-		 * gives every Linux task its own pthread instead, so a first-run task
-		 * has no suspended schedule() frame to perform the matching
-		 * local_irq_enable().  The runqueue lock is gone after schedule_tail()
-		 * and a newly scheduled task must enter both kernel-thread code and
-		 * userspace with local interrupts enabled.
+		 * A first-run task has no suspended schedule() frame to perform the
+		 * matching local_irq_enable().  The runqueue lock is gone after
+		 * schedule_tail(), and the task now owns its selected fixed vCPU carrier,
+		 * so it must enter kernel-thread code or userspace with local interrupts
+		 * enabled.
 		 */
 		local_irq_enable();
 #endif
@@ -149,7 +147,7 @@ static void fork_handler(void)
 {
 	schedule_tail(current->thread.prev_sched);
 #ifdef UML_HOST_DARWIN
-	/* See new_thread_handler(): this is the first activation of a pthread. */
+	/* See new_thread_handler(): this is the task's first carrier activation. */
 	local_irq_enable();
 #endif
 
diff --git a/arch/um/kernel/skas/process.c b/arch/um/kernel/skas/process.c
index b53004892..64b45ceee 100644
--- a/arch/um/kernel/skas/process.c
+++ b/arch/um/kernel/skas/process.c
@@ -34,7 +34,9 @@ char cpu_irqstacks[NR_CPUS][THREAD_SIZE] __aligned(THREAD_SIZE);
 int __init start_uml(void)
 {
 	stack_protections((unsigned long) &cpu_irqstacks[0]);
+#ifndef UML_HOST_DARWIN
 	set_sigstack(cpu_irqstacks[0], THREAD_SIZE);
+#endif
 
 	init_new_thread_signals();
 
diff --git a/arch/um/os-Darwin/internal.h b/arch/um/os-Darwin/internal.h
index 400668265..ec61427d7 100644
--- a/arch/um/os-Darwin/internal.h
+++ b/arch/um/os-Darwin/internal.h
@@ -13,15 +13,15 @@ int darwin_task_shutdown_requested(void);
 int darwin_reserve_embedded_thread(void);
 void darwin_release_embedded_thread(void);
 int darwin_wait_for_embedded_threads(unsigned int timeout_ms);
+void darwin_host_stop_checkpoint(void);
+void __attribute__((noreturn)) darwin_host_stop(void);
 
 #if IS_ENABLED(CONFIG_SMP)
 void darwin_set_current_cpu(int cpu);
 void darwin_publish_cpu_thread(int cpu, pthread_t thread);
 void darwin_retire_cpu_thread(pthread_t thread);
-void darwin_activate_secondary_task(jmp_buf *key, int cpu);
-void __attribute__((noreturn)) darwin_restart_secondary_task(void *stack,
-							      jmp_buf *key,
-							      int cpu);
+int darwin_start_primary_cpu_carrier(void *stack, jmp_buf *switch_buffer);
+void __attribute__((noreturn)) darwin_exit_cpu_carrier(void);
 void darwin_ipi_poll(void);
 int darwin_ipi_idle_fd(void);
 void darwin_ipi_idle_begin(void);
@@ -42,6 +42,18 @@ static inline void darwin_retire_cpu_thread(pthread_t thread)
 {
 	(void)thread;
 }
+static inline int darwin_start_primary_cpu_carrier(
+	void *stack, jmp_buf *switch_buffer)
+{
+	(void)stack;
+	(void)switch_buffer;
+	return -1;
+}
+static inline void __attribute__((noreturn)) darwin_exit_cpu_carrier(void)
+{
+	pthread_exit(NULL);
+	__builtin_unreachable();
+}
 static inline void darwin_ipi_poll(void) { }
 static inline int darwin_ipi_idle_fd(void) { return -1; }
 static inline void darwin_ipi_idle_begin(void) { }
diff --git a/arch/um/os-Darwin/main.c b/arch/um/os-Darwin/main.c
index cf597442f..6ddd3fbe0 100644
--- a/arch/um/os-Darwin/main.c
+++ b/arch/um/os-Darwin/main.c
@@ -13,7 +13,10 @@ long elf_aux_hwcap;
 
 static void fatal_exit(int signal)
 {
-	uml_cleanup();
+	/* This is the second-signal/last-ditch path.  Exit immediately instead of
+	 * running sleepable Linux exitcalls from whichever fixed carrier received a
+	 * process-directed signal (which may be that vCPU's idle task).
+	 */
 	_exit(128 + signal);
 }
 
diff --git a/arch/um/os-Darwin/signal.c b/arch/um/os-Darwin/signal.c
index 297d5b15b..948a794aa 100644
--- a/arch/um/os-Darwin/signal.c
+++ b/arch/um/os-Darwin/signal.c
@@ -29,12 +29,11 @@ struct darwin_signal_state {
  * state.  The outgoing task leaves that state on the CPU and the incoming
  * task continues with it until the architecture return path restores IRQs.
  *
- * Darwin task pthreads can move between UML CPUs.  Keeping this state in
- * pthread-specific storage therefore lets an incoming task bring the IRQ
- * state of its previous CPU into the middle of the new CPU's scheduler
- * handoff.  Keep it with the UML CPU instead.  The Darwin scheduler guarantees
- * that only one pthread executes on a virtual CPU at a time; sig_atomic_t also
- * permits the host signal handler to inspect the same state safely.
+ * Darwin keeps one permanent pthread carrier per UML CPU and moves only the
+ * stackful Linux task context.  Keep IRQ state indexed by that UML CPU rather
+ * than by task so a migration cannot carry the previous CPU's state into the
+ * middle of the new CPU's scheduler handoff.  sig_atomic_t also permits the
+ * host signal handler to inspect the same state safely.
  */
 static struct darwin_signal_state signal_states[CONFIG_NR_CPUS];
 
@@ -230,6 +229,12 @@ void set_handler(int signal)
 		action.sa_flags |= SA_RESTART;
 	if (sigaction(signal, &action, NULL) < 0)
 		panic("Darwin sigaction failed: %d", errno);
+	/* ITIMER_REAL is process-directed.  Installing the disposition on the
+	 * launcher must not make that non-vCPU thread eligible for a guest tick.
+	 * CPU0's carrier explicitly unblocks SIGALRM after taking ownership.
+	 */
+	if (signal == SIGALRM)
+		return;
 	sigemptyset(&unblock);
 	sigaddset(&unblock, signal);
 	if (pthread_sigmask(SIG_UNBLOCK, &unblock, NULL) != 0)
diff --git a/arch/um/os-Darwin/skas/process.c b/arch/um/os-Darwin/skas/process.c
