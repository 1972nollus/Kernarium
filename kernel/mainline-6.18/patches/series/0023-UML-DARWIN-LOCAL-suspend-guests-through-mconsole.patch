From d50cf0863ff3c8cbdf701e1a97d163f453fe12e4 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 27 Aug 2026 12:54:23 +0900
Subject: [PATCH 23/30] UML-DARWIN-LOCAL: suspend guests through mconsole

---
 arch/um/Kconfig                    |  1 -
 arch/um/drivers/mconsole.h         |  2 ++
 arch/um/drivers/mconsole_kern.c    | 55 ++++++++++++++++++++++++++++++
 arch/um/drivers/mconsole_user.c    |  2 ++
 arch/um/include/shared/kern_util.h |  1 +
 arch/um/kernel/um_arch.c           |  1 +
 6 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/arch/um/Kconfig b/arch/um/Kconfig
index 1ec666f76..bb37228ec 100644
--- a/arch/um/Kconfig
+++ b/arch/um/Kconfig
@@ -313,7 +313,6 @@ source "arch/um/drivers/Kconfig"
 
 config ARCH_SUSPEND_POSSIBLE
 	def_bool y
-	depends on !SMP
 
 menu "Power management options"
 
diff --git a/arch/um/drivers/mconsole.h b/arch/um/drivers/mconsole.h
index 635637830..b9b97d818 100644
--- a/arch/um/drivers/mconsole.h
+++ b/arch/um/drivers/mconsole.h
@@ -84,6 +84,8 @@ extern void mconsole_sysrq(struct mc_request *req);
 extern void mconsole_cad(struct mc_request *req);
 extern void mconsole_stop(struct mc_request *req);
 extern void mconsole_go(struct mc_request *req);
+extern void mconsole_suspend(struct mc_request *req);
+extern void mconsole_wake(struct mc_request *req);
 extern void mconsole_log(struct mc_request *req);
 extern void mconsole_proc(struct mc_request *req);
 extern void mconsole_stack(struct mc_request *req);
diff --git a/arch/um/drivers/mconsole_kern.c b/arch/um/drivers/mconsole_kern.c
index ff4bda95b..740d58096 100644
--- a/arch/um/drivers/mconsole_kern.c
+++ b/arch/um/drivers/mconsole_kern.c
@@ -17,6 +17,7 @@
 #include <linux/sched/debug.h>
 #include <linux/proc_fs.h>
 #include <linux/slab.h>
+#include <linux/suspend.h>
 #include <linux/syscalls.h>
 #include <linux/utsname.h>
 #include <linux/socket.h>
@@ -189,6 +190,8 @@ void mconsole_proc(struct mc_request *req)
     cad - invoke the Ctrl-Alt-Del handler \n\
     stop - pause the UML; it will do nothing until it receives a 'go' \n\
     go - continue the UML after a 'stop' \n\
+    suspend - enter system suspend until the host sends 'wake' \n\
+    wake - resume a system-suspended UML \n\
     log <string> - make UML enter <string> into the kernel log\n\
     proc <file> - returns the contents of the UML's /proc/<file>\n\
     stack <pid> - returns the stack of the specified pid\n\
@@ -222,6 +225,50 @@ void mconsole_go(struct mc_request *req)
 	mconsole_reply(req, "Not stopped", 1, 0);
 }
 
+#ifdef CONFIG_SUSPEND
+static struct mc_request *suspend_request;
+
+void um_suspend_notify_entered(void)
+{
+	struct mc_request *req = xchg(&suspend_request, NULL);
+
+	if (req != NULL)
+		mconsole_reply(req, "suspended", 0, 0);
+}
+
+void mconsole_suspend(struct mc_request *req)
+{
+	struct mc_request *pending;
+	char response[64];
+	int error;
+
+	if (cmpxchg(&suspend_request, NULL, req) != NULL) {
+		mconsole_reply(req, "Suspend already in progress", 1, 0);
+		return;
+	}
+	error = pm_suspend(PM_SUSPEND_MEM);
+	pending = xchg(&suspend_request, NULL);
+	if (pending == NULL)
+		return;
+	snprintf(response, sizeof(response), "Suspend failed: %d", error);
+	mconsole_reply(pending, response, 1, 0);
+}
+#else
+void um_suspend_notify_entered(void)
+{
+}
+
+void mconsole_suspend(struct mc_request *req)
+{
+	mconsole_reply(req, "System suspend is not configured", 1, 0);
+}
+#endif
+
+void mconsole_wake(struct mc_request *req)
+{
+	mconsole_reply(req, "running", 0, 0);
+}
+
 void mconsole_stop(struct mc_request *req)
 {
 	block_signals();
@@ -744,6 +791,14 @@ static int __init mconsole_init(void)
 		printk(KERN_ERR "Failed to get IRQ for management console\n");
 		goto out;
 	}
+#ifdef CONFIG_SUSPEND
+	err = irq_set_irq_wake(MCONSOLE_IRQ, 1);
+	if (err < 0) {
+		printk(KERN_ERR "Failed to make management console a wake source\n");
+		um_free_irq(MCONSOLE_IRQ, (void *)sock);
+		goto out;
+	}
+#endif
 
 	if (notify_socket != NULL) {
 		notify_socket = kstrdup(notify_socket, GFP_KERNEL);
diff --git a/arch/um/drivers/mconsole_user.c b/arch/um/drivers/mconsole_user.c
index a04cd13c6..19b89ceb4 100644
--- a/arch/um/drivers/mconsole_user.c
+++ b/arch/um/drivers/mconsole_user.c
@@ -29,6 +29,8 @@ static struct mconsole_command commands[] = {
 	{ "cad", mconsole_cad, MCONSOLE_INTR },
 	{ "stop", mconsole_stop, MCONSOLE_PROC },
 	{ "go", mconsole_go, MCONSOLE_INTR },
+	{ "suspend", mconsole_suspend, MCONSOLE_PROC },
+	{ "wake", mconsole_wake, MCONSOLE_INTR },
 	{ "log", mconsole_log, MCONSOLE_INTR },
 	{ "proc", mconsole_proc, MCONSOLE_PROC },
 	{ "stack", mconsole_stack, MCONSOLE_INTR },
diff --git a/arch/um/include/shared/kern_util.h b/arch/um/include/shared/kern_util.h
index 960950e40..d36d5b8f7 100644
--- a/arch/um/include/shared/kern_util.h
+++ b/arch/um/include/shared/kern_util.h
@@ -72,6 +72,7 @@ extern void winch(int sig, struct siginfo *unused_si, struct uml_pt_regs *regs,
 extern void fatal_sigsegv(void) __attribute__ ((noreturn));
 
 void um_idle_sleep(void);
+void um_suspend_notify_entered(void);
 
 void kasan_map_memory(void *start, size_t len);
 
diff --git a/arch/um/kernel/um_arch.c b/arch/um/kernel/um_arch.c
index d3c969b0c..9a865342c 100644
--- a/arch/um/kernel/um_arch.c
+++ b/arch/um/kernel/um_arch.c
@@ -614,6 +614,7 @@ static int um_suspend_enter(suspend_state_t state)
 	if (WARN_ON(state != PM_SUSPEND_MEM))
 		return -EINVAL;
 
+	um_suspend_notify_entered();
 	/*
 	 * This is identical to the idle sleep, but we've just
 	 * (during suspend) turned off all interrupt sources
