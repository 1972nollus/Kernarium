+/* x86 and arm64 assign these open flags to different bits. */
+#define UML_X86_O_DIRECT	00040000ULL
+#define UML_X86_O_LARGEFILE	00100000ULL
+#define UML_X86_O_DIRECTORY	00200000ULL
+#define UML_X86_O_NOFOLLOW	00400000ULL
+#define UML_X86_OPEN_ARCH_MASK	00740000ULL
+
+static inline u64 uml_x86_to_native_open_flags(u64 x86_flags)
+{
+	u64 flags = x86_flags & ~UML_X86_OPEN_ARCH_MASK;
+
+	if (x86_flags & UML_X86_O_DIRECT)
+		flags |= O_DIRECT;
+	if (x86_flags & UML_X86_O_LARGEFILE)
+		flags |= O_LARGEFILE;
+	if (x86_flags & UML_X86_O_DIRECTORY)
+		flags |= O_DIRECTORY;
+	if (x86_flags & UML_X86_O_NOFOLLOW)
+		flags |= O_NOFOLLOW;
+	return flags;
+}
+
+static inline u64 uml_native_to_x86_open_flags(u64 native_flags)
+{
+	u64 flags = native_flags & ~UML_X86_OPEN_ARCH_MASK;
+
+	if (native_flags & O_DIRECT)
+		flags |= UML_X86_O_DIRECT;
+	if (native_flags & O_LARGEFILE)
+		flags |= UML_X86_O_LARGEFILE;
+	if (native_flags & O_DIRECTORY)
+		flags |= UML_X86_O_DIRECTORY;
+	if (native_flags & O_NOFOLLOW)
+		flags |= UML_X86_O_NOFOLLOW;
+	return flags;
+}
+
