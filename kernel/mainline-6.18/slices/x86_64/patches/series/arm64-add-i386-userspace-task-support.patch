+static int allocate_x86_32_signal_frame(unsigned long stack_top,
+					 size_t frame_size,
+					 void __user **frame_out,
+					 struct uml_x86_32_xstate __user **fpstate_out)
+{
+	unsigned long frame_address;
+	unsigned long frame_end;
+	unsigned long fpstate_address;
+	unsigned long fxsave_address;
+
+	if (stack_top < frame_size + UML_X86_32_XSTATE_FRAME_SIZE + 64)
+		return 1;
+	fxsave_address = round_down(stack_top -
+		UML_X86_64_XSTATE_FRAME_SIZE, 64);
+	if (fxsave_address < UML_X86_32_FSAVE_HEADER_SIZE)
+		return 1;
+	fpstate_address = fxsave_address - UML_X86_32_FSAVE_HEADER_SIZE;
+	if (fpstate_address < frame_size + 16)
+		return 1;
+	frame_address = fpstate_address - frame_size;
+	frame_address = ((frame_address + 4) & ~15UL) - 4;
+	frame_end = fxsave_address + UML_X86_64_XSTATE_FRAME_SIZE;
+	if (frame_end < frame_address ||
+	    !access_ok((void __user *)frame_address,
+		       frame_end - frame_address))
+		return 1;
+	*frame_out = (void __user *)frame_address;
+	*fpstate_out = (void __user *)fpstate_address;
+	return 0;
