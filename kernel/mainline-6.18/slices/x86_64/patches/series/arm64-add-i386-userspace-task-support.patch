diff --git a/arch/arm64/um/ptrace.c b/arch/arm64/um/ptrace.c
index 0e16e611416a790dd3a58a5d688cec2fe0ea4a0a..23145bdaae87aa507991bcbf787bfd680c41ba6a 100644
--- a/arch/arm64/um/ptrace.c
+++ b/arch/arm64/um/ptrace.c
@@ -81,6 +81,53 @@ static void set_user_regs(struct uml_pt_regs *guest,
 	upt_x86_64_set_segment_selector(guest, 5, regs->gs);
 }
 
+static void get_user_regs32(const struct uml_pt_regs *guest,
+			    struct uml_x86_32_user_regs *regs)
+{
+	memset(regs, 0, sizeof(*regs));
+	regs->ebx = UPT_X86_64(guest, UML_X86_64_RBX);
+	regs->ecx = UPT_X86_64(guest, UML_X86_64_RCX);
+	regs->edx = UPT_X86_64(guest, UML_X86_64_RDX);
+	regs->esi = UPT_X86_64(guest, UML_X86_64_RSI);
+	regs->edi = UPT_X86_64(guest, UML_X86_64_RDI);
+	regs->ebp = UPT_X86_64(guest, UML_X86_64_RBP);
+	regs->eax = UPT_X86_64(guest, UML_X86_64_RAX);
+	regs->ds = upt_x86_64_segment_selector(guest, 3);
+	regs->es = upt_x86_64_segment_selector(guest, 0);
+	regs->fs = upt_x86_64_segment_selector(guest, 4);
+	regs->gs = upt_x86_64_segment_selector(guest, 5);
+	regs->orig_eax = guest->orig_x0;
+	regs->eip = UPT_X86_64_RIP(guest);
+	regs->cs = upt_x86_64_segment_selector(guest, 1);
+	regs->eflags = UPT_X86_64_RFLAGS(guest);
+	regs->esp = UPT_X86_64(guest, UML_X86_64_RSP);
+	regs->ss = upt_x86_64_segment_selector(guest, 2);
+}
+
+static void set_user_regs32(struct uml_pt_regs *guest,
+			    const struct uml_x86_32_user_regs *regs)
+{
+	UPT_X86_64(guest, UML_X86_64_RBX) = regs->ebx;
+	UPT_X86_64(guest, UML_X86_64_RCX) = regs->ecx;
+	UPT_X86_64(guest, UML_X86_64_RDX) = regs->edx;
