+struct uml_x86_64_epoll_event {
+	__u32 events;
+	__u64 data;
+} __packed;
+
+static_assert(sizeof(struct uml_x86_64_epoll_event) == 12);
+
+#define UML_X86_64_O_DIRECT	00040000ULL
+#define UML_X86_64_O_LARGEFILE	00100000ULL
+#define UML_X86_64_O_DIRECTORY	00200000ULL
+#define UML_X86_64_O_NOFOLLOW	00400000ULL
+#define UML_X86_64_OPEN_ARCH_MASK	00740000ULL
+
+static u64 uml_x86_64_to_native_open_flags(u64 x86_flags)
+{
+	u64 flags = x86_flags & ~UML_X86_64_OPEN_ARCH_MASK;
+
+	if (x86_flags & UML_X86_64_O_DIRECT)
+		flags |= O_DIRECT;
+	if (x86_flags & UML_X86_64_O_LARGEFILE)
+		flags |= O_LARGEFILE;
+	if (x86_flags & UML_X86_64_O_DIRECTORY)
+		flags |= O_DIRECTORY;
+	if (x86_flags & UML_X86_64_O_NOFOLLOW)
+		flags |= O_NOFOLLOW;
+	return flags;
+}
+
+static u64 uml_native_to_x86_64_open_flags(u64 native_flags)
+{
+	u64 flags = native_flags & ~UML_X86_64_OPEN_ARCH_MASK;
+
+	if (native_flags & O_DIRECT)
+		flags |= UML_X86_64_O_DIRECT;
+	if (native_flags & O_LARGEFILE)
+		flags |= UML_X86_64_O_LARGEFILE;
+	if (native_flags & O_DIRECTORY)
+		flags |= UML_X86_64_O_DIRECTORY;
+	if (native_flags & O_NOFOLLOW)
+		flags |= UML_X86_64_O_NOFOLLOW;
+	return flags;
+}
+
+unsigned int uml_x86_64_epoll_event_size(void)
+{
+	return sizeof(struct uml_x86_64_epoll_event);
+}
+
+struct epoll_event __user *
+uml_x86_64_epoll_put_uevent(__poll_t revents, __u64 data,
+			    struct epoll_event __user *uevent)
+{
+	struct uml_x86_64_epoll_event value = {
+		.events = (__force __u32)revents,
+		.data = data,
+	};
+	struct uml_x86_64_epoll_event __user *x86_event =
+		(void __user *)uevent;
+
+	if (copy_to_user(x86_event, &value, sizeof(value)))
+		return NULL;
+	return (struct epoll_event __user *)(x86_event + 1);
+}
+
+static long uml_x86_64_epoll_ctl(struct uml_pt_regs *regs)
+{
+#ifdef CONFIG_EPOLL
+	struct uml_x86_64_epoll_event user_event;
+	struct epoll_event event = { };
+	int operation = UPT_SYSCALL_ARG2(regs);
+
+	if (ep_op_has_event(operation)) {
+		if (copy_from_user(&user_event,
+				   (const void __user *)UPT_SYSCALL_ARG4(regs),
+				   sizeof(user_event)))
+			return -EFAULT;
+		event.events = (__force __poll_t)user_event.events;
+		event.data = user_event.data;
+	}
+	return do_epoll_ctl(UPT_SYSCALL_ARG1(regs), operation,
+			    UPT_SYSCALL_ARG3(regs), &event, false);
+#else
+	return -ENOSYS;
+#endif
+}
