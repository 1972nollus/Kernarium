+	case 369: return __NR_sendto;
+	case 371: return __NR_recvfrom;
+	case 373: return __NR_shutdown;
+	case 375: return __NR_membarrier;
+	case 376: return __NR_mlock2;
+	case 377: return __NR_copy_file_range;
+	case 380: return __NR_pkey_mprotect;
+	case 381: return __NR_pkey_alloc;
+	case 382: return __NR_pkey_free;
+	case 383: return __NR_statx;
+	case 386: return __NR_rseq;
+	case 403: return __NR_clock_gettime;
+	case 406: return __NR_clock_getres;
+	case 407: return __NR_clock_nanosleep;
+	case 422: return __NR_futex;
+	case 435: return __NR_clone3;
+	case 437: return __NR_openat2;
+	case 438: return __NR_pidfd_getfd;
+	case 439: return __NR_faccessat2;
+	case 441: return __NR_epoll_pwait2;
+	default: return -1;
