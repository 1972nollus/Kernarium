+
+/* Long-mode INT 0x80 enters the i386 syscall numbering and register ABI, but
+ * does not turn the task into a 32-bit ELF personality.  Translate calls whose
+ * pointed-to UAPI data is identical on i386 and arm64.  Calls with time32,
+ * compat iovec, compat signal-frame, or split 64-bit arguments remain rejected
+ * until they have an explicit adapter.
+ */
+int uml_x86_32_syscall_number(int syscall)
+{
+	switch (syscall) {
+	case 1: return __NR_exit;
+	case 3: return __NR_read;
