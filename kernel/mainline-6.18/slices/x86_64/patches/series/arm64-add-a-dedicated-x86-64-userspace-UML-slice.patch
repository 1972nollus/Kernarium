+	case 242: return __NR_sched_getaffinity;
+	case 252: return __NR_exit_group;
+	case 258: return __NR_set_tid_address;
+	case 270: return __NR_tgkill;
+	case 295: return __NR_openat;
+	case 296: return __NR_mkdirat;
+	case 297: return __NR_mknodat;
+	case 298: return __NR_fchownat;
+	case 301: return __NR_unlinkat;
+	case 303: return __NR_linkat;
+	case 304: return __NR_symlinkat;
