+struct uml_x86_64_stat {
+	__u64 dev;
+	__u64 ino;
+	__u64 nlink;
+	__u32 mode;
+	__u32 uid;
+	__u32 gid;
+	__u32 pad0;
+	__u64 rdev;
+	__s64 size;
+	__s64 blksize;
+	__s64 blocks;
+	__u64 atime;
+	__u64 atime_nsec;
+	__u64 mtime;
+	__u64 mtime_nsec;
+	__u64 ctime;
+	__u64 ctime_nsec;
+	__s64 unused[3];
+};
+
+static long uml_x86_64_copy_stat(const struct kstat *stat,
+				 unsigned long destination)
+{
+	struct uml_x86_64_stat result = {
+		.dev = new_encode_dev(stat->dev),
+		.ino = stat->ino,
+		.nlink = stat->nlink,
+		.mode = stat->mode,
+		.uid = from_kuid_munged(current_user_ns(), stat->uid),
+		.gid = from_kgid_munged(current_user_ns(), stat->gid),
+		.rdev = new_encode_dev(stat->rdev),
+		.size = stat->size,
+		.blksize = stat->blksize,
+		.blocks = stat->blocks,
+		.atime = stat->atime.tv_sec,
+		.atime_nsec = stat->atime.tv_nsec,
+		.mtime = stat->mtime.tv_sec,
+		.mtime_nsec = stat->mtime.tv_nsec,
+		.ctime = stat->ctime.tv_sec,
+		.ctime_nsec = stat->ctime.tv_nsec,
+	};
+
+	static_assert(sizeof(result) == 144);
+	return copy_to_user((void __user *)destination, &result, sizeof(result)) ?
+		-EFAULT : 0;
+}
+
+static long uml_x86_64_stat_call(struct uml_pt_regs *regs, int syscall)
+{
+	struct kstat stat;
+	long error;
+
+	switch (syscall) {
+	case 4:
+		error = vfs_stat((const char __user *)UPT_SYSCALL_ARG1(regs),
+				 &stat);
+		break;
+	case 5:
+		error = vfs_fstat(UPT_SYSCALL_ARG1(regs), &stat);
+		break;
+	case 6:
+		error = vfs_lstat((const char __user *)UPT_SYSCALL_ARG1(regs),
+				  &stat);
+		break;
+	case 262:
+		error = vfs_fstatat(UPT_SYSCALL_ARG1(regs),
+				    (const char __user *)UPT_SYSCALL_ARG2(regs),
+				    &stat, UPT_SYSCALL_ARG4(regs));
+		break;
+	default:
+		return -ENOSYS;
+	}
+	if (error)
+		return error;
+	return uml_x86_64_copy_stat(&stat,
+		syscall == 262 ? UPT_SYSCALL_ARG3(regs) :
+		UPT_SYSCALL_ARG2(regs));
+}
