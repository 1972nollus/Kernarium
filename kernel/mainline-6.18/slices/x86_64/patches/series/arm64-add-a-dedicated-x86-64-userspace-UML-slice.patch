+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_UM_ARM64_UNISTD_H
+#define _ASM_UM_ARM64_UNISTD_H
+
+#define __ARCH_WANT_SYS_FORK
+#define __ARCH_WANT_SYS_GETPGRP
