+					 (struct epoll_event __user *)
+						UPT_SYSCALL_ARG2(regs),
+					 UPT_SYSCALL_ARG3(regs),
+					 UPT_SYSCALL_ARG4(regs));
+		break;
+	case 233:
+		*result = uml_x86_64_epoll_ctl(regs);
+		break;
+	case 240:
+		*result = uml_x86_64_mq_open(regs);
+		break;
+	case 253:
+		*result = sys_inotify_init();
