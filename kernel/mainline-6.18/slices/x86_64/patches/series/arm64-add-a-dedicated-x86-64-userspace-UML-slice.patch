+
+/*
+ * scripts/syscalltbl.sh emits every slot through the last entry in the Linux
+ * 6.18 x86 tables.  Keep these bounds synchronized with those generated
+ * tables; an out-of-range generated initializer makes the build fail.
+ */
+#define UML_X86_64_NR_SYSCALLS 470
+
+#endif
