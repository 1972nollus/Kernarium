diff --git a/arch/arm64/um/Kconfig b/arch/arm64/um/Kconfig
index 6068242b331a532ca5735f49556d1d497a49798b..5ecda903ad20895c211be00c4ba8ea0d4ea1da61 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -22,6 +22,15 @@ config UML_ARM64
 	select ARCH_USE_QUEUED_RWLOCKS
 	select UML_SUBARCH_SUPPORTS_SMP
 
+config UML_X86_64_USERSPACE_ONLY
+	bool "Run x86-64 userspace exclusively"
+	depends on PAGE_SIZE_4KB
+	help
+	  Build the dedicated Darwin UML compatibility slice whose kernel
+	  remains arm64.  Every userspace task uses the Linux x86-64 ABI, and
+	  arm64 userspace executables are rejected.  This slice requires 4 KiB
+	  guest pages and must not be selected by a native arm64 slice.
+
 config ARCH_MMAP_RND_BITS_MIN
 	int
 	default 18
diff --git a/arch/arm64/um/Makefile b/arch/arm64/um/Makefile
index b3bbae6cd5a149976a91c3df809f696e79d83ef0..476b8f2426167dd2d1c07c0f7b7d3a6075453492 100644
--- a/arch/arm64/um/Makefile
+++ b/arch/arm64/um/Makefile
@@ -1,7 +1,24 @@
 # SPDX-License-Identifier: GPL-2.0
 
 obj-y := bugs.o delay.o fault.o mem.o ptrace.o registers.o setjmp.o \
-	signal.o subarch.o syscall_table.o syscalls.o sysrq.o tls.o
+	signal.o subarch.o syscall_table.o syscalls.o sysrq.o tls.o \
+	x86_64_syscalls.o
+obj-$(CONFIG_UML_X86_64_USERSPACE_ONLY) += mmap.o x86_syscall_tables.o
+
+x86-syscalltbl := $(srctree)/scripts/syscalltbl.sh
+x86-syscall-64 := $(srctree)/arch/x86/entry/syscalls/syscall_64.tbl
+
+quiet_cmd_x86_systbl = X86SYSTBL $@
+      cmd_x86_systbl = $(CONFIG_SHELL) $(x86-syscalltbl) \
+		--abis $(abis) $< $@
+
+$(obj)/x86_syscalls_64.h: abis := common,64
+$(obj)/x86_syscalls_64.h: $(x86-syscall-64) $(x86-syscalltbl) FORCE
+	$(call if_changed,x86_systbl)
+
+$(obj)/x86_syscall_tables.o: $(obj)/x86_syscalls_64.h
+
+targets += x86_syscalls_64.h
 
 $(obj)/user-offsets.s: c_flags = -Wp,-MD,$(depfile) $(USER_CFLAGS)
 targets += user-offsets.s
