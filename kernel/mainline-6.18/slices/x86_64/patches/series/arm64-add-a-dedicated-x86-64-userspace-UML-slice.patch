+static long uml_x86_64_openat(int dfd, const char __user *path,
+			      unsigned long x86_flags, umode_t mode)
+{
+	int flags = uml_x86_64_to_native_open_flags((unsigned int)x86_flags);
+
+	return sys_openat(dfd, path, flags, mode);
+}
+
+static long uml_x86_64_fcntl(struct uml_pt_regs *regs)
+{
+	unsigned int command = UPT_SYSCALL_ARG2(regs);
+	unsigned long argument = UPT_SYSCALL_ARG3(regs);
+	long result;
+
+	if (command == F_SETFL)
+		argument = uml_x86_64_to_native_open_flags((unsigned int)argument);
+	result = sys_fcntl(UPT_SYSCALL_ARG1(regs), command, argument);
+	if (command == F_GETFL && result >= 0)
+		result = uml_native_to_x86_64_open_flags((unsigned int)result);
+	return result;
+}
+
+static long uml_x86_64_openat2(struct uml_pt_regs *regs)
+{
+	struct open_how how;
+	const void __user *user_how =
+		(const void __user *)UPT_SYSCALL_ARG3(regs);
+	size_t size = UPT_SYSCALL_ARG4(regs);
+	int error;
+
+	BUILD_BUG_ON(sizeof(struct open_how) < OPEN_HOW_SIZE_VER0);
+	BUILD_BUG_ON(sizeof(struct open_how) != OPEN_HOW_SIZE_LATEST);
+	if (unlikely(size < OPEN_HOW_SIZE_VER0))
+		return -EINVAL;
+	if (unlikely(size > PAGE_SIZE))
+		return -E2BIG;
+	error = copy_struct_from_user(&how, sizeof(how), user_how, size);
+	if (error)
+		return error;
+	how.flags = uml_x86_64_to_native_open_flags(how.flags);
+	audit_openat2_how(&how);
+	if (!(how.flags & O_PATH) && force_o_largefile())
+		how.flags |= O_LARGEFILE;
+	return do_sys_openat2(UPT_SYSCALL_ARG1(regs),
+		(const char __user *)UPT_SYSCALL_ARG2(regs), &how);
+}
