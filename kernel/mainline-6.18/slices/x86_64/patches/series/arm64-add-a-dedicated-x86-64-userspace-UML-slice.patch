+
+/* x86-64's __kernel_old_dev_t is an unsigned long, so its legacy loop_info
+ * is 168 bytes where the generic one the loop driver copies is 160. Both
+ * requests rewrite the caller's buffer in place, which the larger x86 layout
+ * always covers; LOOP_SET_STATUS restores the caller's bytes afterwards.
+ */
+struct uml_x86_64_loop_info {
+	int lo_number;
+	__u64 lo_device;
+	__u64 lo_inode;
+	__u64 lo_rdevice;
+	int lo_offset;
+	int lo_encrypt_type;
+	int lo_encrypt_key_size;
+	int lo_flags;
+	char lo_name[LO_NAME_SIZE];
+	unsigned char lo_encrypt_key[LO_KEY_SIZE];
+	__u64 lo_init[2];
+	char reserved[4];
+};
+
+static void uml_x86_64_loop_info_to_generic(
+	const struct uml_x86_64_loop_info *x86, struct loop_info *generic)
+{
+	memset(generic, 0, sizeof(*generic));
+	generic->lo_number = x86->lo_number;
+	generic->lo_device = x86->lo_device;
+	generic->lo_inode = x86->lo_inode;
+	generic->lo_rdevice = x86->lo_rdevice;
+	generic->lo_offset = x86->lo_offset;
+	generic->lo_encrypt_type = x86->lo_encrypt_type;
+	generic->lo_encrypt_key_size = x86->lo_encrypt_key_size;
+	generic->lo_flags = x86->lo_flags;
+	memcpy(generic->lo_name, x86->lo_name, sizeof(generic->lo_name));
+	memcpy(generic->lo_encrypt_key, x86->lo_encrypt_key,
+	       sizeof(generic->lo_encrypt_key));
+	generic->lo_init[0] = x86->lo_init[0];
+	generic->lo_init[1] = x86->lo_init[1];
+	memcpy(generic->reserved, x86->reserved, sizeof(generic->reserved));
+}
+
+static void uml_x86_64_loop_info_from_generic(
+	const struct loop_info *generic, struct uml_x86_64_loop_info *x86)
+{
+	memset(x86, 0, sizeof(*x86));
+	x86->lo_number = generic->lo_number;
+	x86->lo_device = generic->lo_device;
+	x86->lo_inode = generic->lo_inode;
+	x86->lo_rdevice = generic->lo_rdevice;
+	x86->lo_offset = generic->lo_offset;
+	x86->lo_encrypt_type = generic->lo_encrypt_type;
+	x86->lo_encrypt_key_size = generic->lo_encrypt_key_size;
+	x86->lo_flags = generic->lo_flags;
+	memcpy(x86->lo_name, generic->lo_name, sizeof(x86->lo_name));
+	memcpy(x86->lo_encrypt_key, generic->lo_encrypt_key,
+	       sizeof(x86->lo_encrypt_key));
+	x86->lo_init[0] = generic->lo_init[0];
+	x86->lo_init[1] = generic->lo_init[1];
+	memcpy(x86->reserved, generic->reserved, sizeof(x86->reserved));
+}
+
+static long uml_x86_64_loop_status(unsigned int fd, unsigned int command,
+				   unsigned long address)
+{
+	void __user *user = (void __user *)address;
+	struct uml_x86_64_loop_info x86;
+	struct loop_info generic;
+	long ret;
+
+	static_assert(sizeof(x86) == 168);
+	static_assert(sizeof(generic) < sizeof(x86));
+	if (command == LOOP_GET_STATUS) {
+		ret = sys_ioctl(fd, command, address);
+		if (ret < 0)
+			return ret;
+		if (copy_from_user(&generic, user, sizeof(generic)))
+			return -EFAULT;
+		uml_x86_64_loop_info_from_generic(&generic, &x86);
+		return copy_to_user(user, &x86, sizeof(x86)) ? -EFAULT : ret;
+	}
+	if (copy_from_user(&x86, user, sizeof(x86)))
+		return -EFAULT;
+	uml_x86_64_loop_info_to_generic(&x86, &generic);
+	if (copy_to_user(user, &generic, sizeof(generic)))
+		return -EFAULT;
+	ret = sys_ioctl(fd, command, address);
+	if (copy_to_user(user, &x86, sizeof(x86)))
+		return -EFAULT;
+	return ret;
+}
+
+/* x86-64 keeps the i386 semid64_ds padding words; the generic layout that
+ * sys_semctl writes has none, so sem_nsems lands two words early.
+ */
+struct uml_x86_64_semid64_ds {
+	struct ipc64_perm sem_perm;
+	__s64 sem_otime;
+	__u64 unused1;
+	__s64 sem_ctime;
+	__u64 unused2;
+	__u64 sem_nsems;
+	__u64 unused3;
+	__u64 unused4;
+};
+
+static long uml_x86_64_semctl(struct uml_pt_regs *regs)
+{
+	unsigned long address = UPT_SYSCALL_ARG4(regs);
+	struct uml_x86_64_semid64_ds result = { };
+	struct semid64_ds generic;
+	long ret;
+
+	static_assert(sizeof(result) == 104);
+	static_assert(sizeof(generic) < sizeof(result));
+	ret = sys_semctl(UPT_SYSCALL_ARG1(regs), UPT_SYSCALL_ARG2(regs),
+			 UPT_SYSCALL_ARG3(regs), address);
+	if (ret < 0)
+		return ret;
+	switch (UPT_SYSCALL_ARG3(regs) & ~IPC_64) {
+	case IPC_STAT:
+	case SEM_STAT:
+	case SEM_STAT_ANY:
+		break;
+	default:
+		return ret;
+	}
+	if (copy_from_user(&generic, (void __user *)address, sizeof(generic)))
+		return -EFAULT;
+	result.sem_perm = generic.sem_perm;
+	result.sem_otime = generic.sem_otime;
+	result.sem_ctime = generic.sem_ctime;
+	result.sem_nsems = generic.sem_nsems;
+	return copy_to_user((void __user *)address, &result, sizeof(result)) ?
+		-EFAULT : ret;
+}
+
+static long uml_x86_64_time(__kernel_old_time_t __user *tloc)
+{
+	__kernel_old_time_t seconds =
+		(__kernel_old_time_t)ktime_get_real_seconds();
+
+	if (tloc && put_user(seconds, tloc))
+		return -EFAULT;
+	force_successful_syscall_return();
+	return seconds;
+}
+
+int uml_x86_64_special_syscall(struct uml_pt_regs *regs, long *result)
+{
+	unsigned long arg1 = UPT_SYSCALL_ARG1(regs);
+	unsigned long arg2 = UPT_SYSCALL_ARG2(regs);
+	unsigned long arg3 = UPT_SYSCALL_ARG3(regs);
+	unsigned long arg4 = UPT_SYSCALL_ARG4(regs);
+	const char __user *path1 =
+		(const char __user *)arg1;
+	const char __user *path2 =
+		(const char __user *)arg2;
+
+	switch (UPT_SYSCALL_NR(regs)) {
+	case 2:
+		*result = uml_x86_64_openat(AT_FDCWD, path1, arg2, arg3);
+		break;
+	case 4:
+	case 5:
+	case 6:
+	case 262:
+		*result = uml_x86_64_stat_call(regs, UPT_SYSCALL_NR(regs));
+		break;
+	case 7:
+		*result = sys_poll((struct pollfd __user *)UPT_SYSCALL_ARG1(regs),
+				   UPT_SYSCALL_ARG2(regs),
+				   UPT_SYSCALL_ARG3(regs));
+		break;
+	case 16:
+		if (arg2 != LOOP_SET_STATUS && arg2 != LOOP_GET_STATUS)
+			return 0;
+		*result = uml_x86_64_loop_status(arg1, arg2, arg3);
+		break;
+	case 21:
+		*result = sys_faccessat(AT_FDCWD,
+					(const char __user *)UPT_SYSCALL_ARG1(regs),
+					UPT_SYSCALL_ARG2(regs));
+		break;
+	case 22:
+		*result = sys_pipe2((int __user *)UPT_SYSCALL_ARG1(regs), 0);
+		break;
+	case 23:
+		*result = sys_select(UPT_SYSCALL_ARG1(regs),
+				     (fd_set __user *)UPT_SYSCALL_ARG2(regs),
+				     (fd_set __user *)UPT_SYSCALL_ARG3(regs),
+				     (fd_set __user *)UPT_SYSCALL_ARG4(regs),
+				     (struct __kernel_old_timeval __user *)
+					UPT_SYSCALL_ARG5(regs));
+		break;
+	case 33:
+		*result = sys_dup2(UPT_SYSCALL_ARG1(regs),
+				   UPT_SYSCALL_ARG2(regs));
+		break;
+	case 34:
+		*result = uml_x86_64_pause();
+		break;
+	case 37:
+		*result = sys_alarm(UPT_SYSCALL_ARG1(regs));
+		break;
+	case 56:
+		*result = uml_x86_64_clone(regs);
+		break;
+	case 57:
+	{
+		struct kernel_clone_args args = { .exit_signal = SIGCHLD };
+
+		*result = kernel_clone(&args);
+		break;
+	}
+	case 58:
+	{
+		struct kernel_clone_args args = {
+			.flags = CLONE_VFORK | CLONE_VM,
+			.exit_signal = SIGCHLD,
+		};
+
+		*result = kernel_clone(&args);
+		break;
+	}
+	case 66:
+		*result = uml_x86_64_semctl(regs);
+		break;
+	case 72:
+		*result = uml_x86_64_fcntl(regs);
+		break;
+	case 78:
+		*result = sys_getdents(arg1, (struct linux_dirent __user *)arg2, arg3);
+		break;
+	case 82:
+		*result = sys_rename(path1, path2);
+		break;
+	case 83:
+		*result = sys_mkdir(path1, UPT_SYSCALL_ARG2(regs));
+		break;
+	case 84:
+		*result = sys_rmdir(path1);
+		break;
+	case 85:
+		*result = sys_creat(path1, UPT_SYSCALL_ARG2(regs));
+		break;
+	case 86:
+		*result = sys_link(path1, path2);
+		break;
+	case 87:
+		*result = sys_unlink(path1);
+		break;
+	case 88:
+		*result = sys_symlink(path1, path2);
+		break;
+	case 89:
+		*result = sys_readlink(path1, (char __user *)arg2, arg3);
+		break;
+	case 90:
+		*result = sys_chmod(path1, UPT_SYSCALL_ARG2(regs));
+		break;
+	case 91:
+		*result = sys_fchmod(arg1, arg2);
+		break;
+	case 92:
+		*result = sys_chown(path1, UPT_SYSCALL_ARG2(regs),
+				    UPT_SYSCALL_ARG3(regs));
+		break;
+	case 93:
+		*result = sys_fchown(arg1, arg2, arg3);
+		break;
+	case 94:
+		*result = sys_lchown(path1, UPT_SYSCALL_ARG2(regs),
+				     UPT_SYSCALL_ARG3(regs));
