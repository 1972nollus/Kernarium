 arch/arm64/um/shared/sysdep/ptrace.h  | 150 ++++-
 arch/arm64/um/signal.c                | 598 ++++++++++++++-----
 arch/arm64/um/tls.c                   |   3 +-
 arch/arm64/um/x86_64_syscalls.c       | 806 ++++++++++++++++++++++++++
 arch/arm64/um/x86_syscall_tables.c    |  32 +
 arch/um/include/asm/pgtable.h         |   5 +
 arch/um/include/asm/syscall-generic.h |   2 +-
 arch/um/kernel/exec.c                 |   5 +
 arch/um/kernel/process.c              |   2 +-
 arch/um/kernel/skas/syscall.c         |  31 +-
