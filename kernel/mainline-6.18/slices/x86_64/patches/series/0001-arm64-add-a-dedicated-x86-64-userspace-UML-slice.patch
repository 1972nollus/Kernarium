+static long uml_x86_64_clone(struct uml_pt_regs *regs)
+{
+	unsigned long flags = UPT_SYSCALL_ARG1(regs);
+	int __user *parent_tid =
+		(int __user *)UPT_SYSCALL_ARG3(regs);
+	struct kernel_clone_args args = {
+		.flags = lower_32_bits(flags) & ~CSIGNAL,
+		.pidfd = parent_tid,
+		.child_tid = (int __user *)UPT_SYSCALL_ARG4(regs),
+		.parent_tid = parent_tid,
+		.exit_signal = lower_32_bits(flags) & CSIGNAL,
+		.stack = UPT_SYSCALL_ARG2(regs),
+		.tls = UPT_SYSCALL_ARG5(regs),
+	};
+
+	return kernel_clone(&args);
+}
