diff --git a/arch/arm64/um/Kconfig b/arch/arm64/um/Kconfig
index b0603b124..a81eeaad7 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -20,6 +20,15 @@ config UML_ARM64
 	select ARCH_USE_QUEUED_RWLOCKS
 	select UML_SUBARCH_SUPPORTS_SMP
 
+config UML_X86_64_USERSPACE_ONLY
+	bool "Run x86-64 userspace exclusively"
+	depends on PAGE_SIZE_4KB
+	help
+	  Build the dedicated Darwin UML compatibility slice whose kernel
+	  remains arm64.  Every userspace task uses the Linux x86-64 ABI, and
+	  arm64 userspace executables are rejected.  This slice requires 4 KiB
+	  guest pages and must not be selected by a native arm64 slice.
+
 config ARCH_MMAP_RND_BITS_MIN
 	int
 	default 18
