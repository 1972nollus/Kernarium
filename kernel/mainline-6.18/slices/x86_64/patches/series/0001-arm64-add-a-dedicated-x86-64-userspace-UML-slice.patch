+	if (regno < 0 || regno >= sizeof(struct user_regs_struct) ||
 	    (regno & (sizeof(unsigned long) - 1)))
 		return -EINVAL;
 	return regno / sizeof(unsigned long);
 }
 
+static void get_user_regs(const struct uml_pt_regs *guest,
+			  struct user_regs_struct *regs)
+{
+	regs->r15 = UPT_X86_64(guest, UML_X86_64_R15);
+	regs->r14 = UPT_X86_64(guest, UML_X86_64_R14);
+	regs->r13 = UPT_X86_64(guest, UML_X86_64_R13);
+	regs->r12 = UPT_X86_64(guest, UML_X86_64_R12);
+	regs->bp = UPT_X86_64(guest, UML_X86_64_RBP);
+	regs->bx = UPT_X86_64(guest, UML_X86_64_RBX);
+	regs->r11 = UPT_X86_64(guest, UML_X86_64_R11);
+	regs->r10 = UPT_X86_64(guest, UML_X86_64_R10);
+	regs->r9 = UPT_X86_64(guest, UML_X86_64_R9);
+	regs->r8 = UPT_X86_64(guest, UML_X86_64_R8);
+	regs->ax = UPT_X86_64(guest, UML_X86_64_RAX);
+	regs->cx = UPT_X86_64(guest, UML_X86_64_RCX);
+	regs->dx = UPT_X86_64(guest, UML_X86_64_RDX);
+	regs->si = UPT_X86_64(guest, UML_X86_64_RSI);
+	regs->di = UPT_X86_64(guest, UML_X86_64_RDI);
+	regs->orig_ax = guest->orig_x0;
+	regs->ip = UPT_X86_64_RIP(guest);
+	regs->cs = upt_x86_64_segment_selector(guest, 1);
+	regs->flags = UPT_X86_64_RFLAGS(guest);
+	regs->sp = UPT_X86_64(guest, UML_X86_64_RSP);
+	regs->ss = upt_x86_64_segment_selector(guest, 2);
+	regs->fs_base = UPT_X86_64_FS_BASE(guest);
+	regs->gs_base = UPT_X86_64_GS_BASE(guest);
+	regs->ds = upt_x86_64_segment_selector(guest, 3);
+	regs->es = upt_x86_64_segment_selector(guest, 0);
+	regs->fs = upt_x86_64_segment_selector(guest, 4);
+	regs->gs = upt_x86_64_segment_selector(guest, 5);
+}
+
+static void set_user_regs(struct uml_pt_regs *guest,
+			  const struct user_regs_struct *regs)
+{
+	UPT_X86_64(guest, UML_X86_64_R15) = regs->r15;
+	UPT_X86_64(guest, UML_X86_64_R14) = regs->r14;
+	UPT_X86_64(guest, UML_X86_64_R13) = regs->r13;
+	UPT_X86_64(guest, UML_X86_64_R12) = regs->r12;
+	UPT_X86_64(guest, UML_X86_64_RBP) = regs->bp;
+	UPT_X86_64(guest, UML_X86_64_RBX) = regs->bx;
+	UPT_X86_64(guest, UML_X86_64_R11) = regs->r11;
+	UPT_X86_64(guest, UML_X86_64_R10) = regs->r10;
+	UPT_X86_64(guest, UML_X86_64_R9) = regs->r9;
+	UPT_X86_64(guest, UML_X86_64_R8) = regs->r8;
+	UPT_X86_64(guest, UML_X86_64_RAX) = regs->ax;
+	UPT_X86_64(guest, UML_X86_64_RCX) = regs->cx;
+	UPT_X86_64(guest, UML_X86_64_RDX) = regs->dx;
+	UPT_X86_64(guest, UML_X86_64_RSI) = regs->si;
+	UPT_X86_64(guest, UML_X86_64_RDI) = regs->di;
+	guest->orig_x0 = regs->orig_ax;
