+static long uml_x86_64_copy_stat(const struct kstat *stat,
+				 unsigned long destination)
+{
+	struct uml_x86_64_stat result = {
+		.dev = new_encode_dev(stat->dev),
+		.ino = stat->ino,
+		.nlink = stat->nlink,
+		.mode = stat->mode,
+		.uid = from_kuid_munged(current_user_ns(), stat->uid),
+		.gid = from_kgid_munged(current_user_ns(), stat->gid),
+		.rdev = new_encode_dev(stat->rdev),
+		.size = stat->size,
+		.blksize = stat->blksize,
+		.blocks = stat->blocks,
+		.atime = stat->atime.tv_sec,
+		.atime_nsec = stat->atime.tv_nsec,
+		.mtime = stat->mtime.tv_sec,
+		.mtime_nsec = stat->mtime.tv_nsec,
+		.ctime = stat->ctime.tv_sec,
+		.ctime_nsec = stat->ctime.tv_nsec,
+	};
+
+	static_assert(sizeof(result) == 144);
+	return copy_to_user((void __user *)destination, &result, sizeof(result)) ?
+		-EFAULT : 0;
+}
