@@ -80,6 +81,20 @@ static inline int upt_x86_64_compat_syscall(const struct uml_pt_regs *regs)
 #define UPT_X86_64_COMPAT_SYSCALL(regs) \
 	upt_x86_64_compat_syscall(regs)
 
+static inline int upt_x86_32_task_mode(const struct uml_pt_regs *regs)
+{
+	return !!(regs->svcr & UML_X86_32_TASK_MODE);
+}
+
+static inline void upt_x86_32_set_task_mode(struct uml_pt_regs *regs,
+					     int enabled)
+{
+	if (enabled)
+		regs->svcr |= UML_X86_32_TASK_MODE;
+	else
+		regs->svcr &= ~UML_X86_32_TASK_MODE;
+}
+
 static inline unsigned short
 upt_x86_64_segment_selector(const struct uml_pt_regs *regs, unsigned int index)
