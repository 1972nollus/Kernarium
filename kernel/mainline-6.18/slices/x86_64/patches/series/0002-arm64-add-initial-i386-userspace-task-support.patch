@@ -14,13 +14,15 @@ static inline int syscall_get_arch(struct task_struct *task)
 {
 	struct uml_pt_regs *regs = &task->thread.regs.regs;
 
-	if (UPT_X86_64_COMPAT_SYSCALL(regs))
+	if (test_tsk_thread_flag(task, TIF_32BIT) ||
+	    UPT_X86_64_COMPAT_SYSCALL(regs))
 		return AUDIT_ARCH_I386;
 	return AUDIT_ARCH_X86_64;
 }
 
