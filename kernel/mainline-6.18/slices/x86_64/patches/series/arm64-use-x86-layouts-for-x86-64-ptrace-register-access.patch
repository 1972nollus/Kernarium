From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 23 Sep 2026 12:38:51 +0900
Subject: [PATCH] arm64: use x86 layouts for x86-64 ptrace register access

The x86-64 slice inherited arm64 ptrace layouts that do not match x86
tracers.  PTRACE_GETREGS wrote the 272-byte arm64 frame into gdb's
216-byte user_regs_struct and smashed its stack, PTRACE_GETFPREGS was
unimplemented, and NT_PRFPREG returned the 528-byte arm64 FPSIMD image.

Serve PTRACE_GETREGS, SETREGS, GETFPREGS and SETFPREGS from the x86
regsets, report FP state as a 512-byte FXSAVE image, and add the
NT_X86_XSTATE regset, which reports XCR0 in the software-reserved words
as x86 does.  i386 tasks expose the same state as NT_PRXFPREG and
NT_X86_XSTATE.  The signal-frame code and the regsets share one
conversion between the task FP state and a standard XSAVE image.

PTRACE_PEEKUSER and POKEUSER follow x86 struct user rules: other fields
read as zero, and debug registers read as idle.  A tracer may clear them
or stage addresses, but enabling a hardware breakpoint fails because UML
cannot arm one.
---
 arch/arm64/um/asm/ptrace-abi.h |   3 +
 arch/arm64/um/ptrace.c         | 165 ++++++++++++++++++++++++++++++---
 arch/arm64/um/signal.c         | 118 ++++++++---------------
 arch/arm64/um/x86_fpstate.h    |  81 ++++++++++++++++
 arch/um/kernel/ptrace.c        |   6 +-
 5 files changed, 280 insertions(+), 93 deletions(-)
 create mode 100644 arch/arm64/um/x86_fpstate.h

diff --git a/arch/arm64/um/asm/ptrace-abi.h b/arch/arm64/um/asm/ptrace-abi.h
index 3afa6ed84585b358f068303471d9b3d640f20421..7af74c93f494f76334b7b6610fbe1ad56c8a58ee 100644
--- a/arch/arm64/um/asm/ptrace-abi.h
+++ b/arch/arm64/um/asm/ptrace-abi.h
@@ -2,8 +2,11 @@
 #ifndef _ASM_UM_ARM64_PTRACE_ABI_H
 #define _ASM_UM_ARM64_PTRACE_ABI_H
 
+/* The x86-64 slice serves these in subarch_ptrace() with x86 layouts. */
+#ifndef CONFIG_UML_X86_64_USERSPACE_ONLY
 #define PTRACE_GETREGS 12
 #define PTRACE_SETREGS 13
+#endif
 #define PTRACE_GETFPREGS 14
 #define PTRACE_SETFPREGS 15
 #define PTRACE_OLDSETOPTIONS 21
diff --git a/arch/arm64/um/ptrace.c b/arch/arm64/um/ptrace.c
index 03612f21119fe2c96208237a462ad80b2e606cda..a64194ef882d68724511eb377d29b04aaba5d3ab 100644
--- a/arch/arm64/um/ptrace.c
+++ b/arch/arm64/um/ptrace.c
@@ -6,6 +6,20 @@
 #include <linux/uaccess.h>
 #include <asm/ptrace.h>
 #include <asm/user.h>
+#include "x86_fpstate.h"
+
+/* struct user offsets for x86-64 PTRACE_PEEKUSER and PTRACE_POKEUSER. */
+#define UML_X86_64_USER_DEBUGREG 848
+#define UML_X86_64_USER_SIZE 912
+#define UML_X86_64_DR7_ENABLE_MASK 0xffUL
+#define UML_X86_64_PTRACE_GETREGS 12
+#define UML_X86_64_PTRACE_SETREGS 13
+#define UML_X86_64_PTRACE_GETFPREGS 14
+#define UML_X86_64_PTRACE_SETFPREGS 15
+
+enum {
+	REGSET_XSTATE = REGSET_FP + 1,
+};
 
 static int register_index(int regno)
 {
@@ -148,26 +162,80 @@ int putreg(struct task_struct *child, int regno, unsigned long value)
 	return 0;
 }
 
+static bool debugreg_offset(long addr)
+{
+	return addr >= UML_X86_64_USER_DEBUGREG &&
+		addr < UML_X86_64_USER_SIZE;
+}
+
+/* UML cannot arm x86 hardware breakpoints.  Debug registers read as idle,
+ * and a tracer may clear them or stage addresses, but enabling one fails.
+ */
+static int set_debugreg(long addr, unsigned long value)
+{
+	unsigned long n = (addr - UML_X86_64_USER_DEBUGREG) /
+		sizeof(unsigned long);
+
+	if (n == 4 || n == 5)
+		return -EIO;
+	if (n == 7 && (value & UML_X86_64_DR7_ENABLE_MASK))
+		return -EINVAL;
+	return 0;
+}
+
 int peek_user(struct task_struct *child, long addr, long data)
 {
-	unsigned long value;
+	unsigned long value = 0;
 
-	if (register_index(addr) < 0)
+	if (addr < 0 || addr >= UML_X86_64_USER_SIZE ||
+	    (addr & (sizeof(unsigned long) - 1)))
 		return -EIO;
-	value = getreg(child, addr);
+	if (register_index(addr) >= 0)
+		value = getreg(child, addr);
 	return put_user(value, (unsigned long __user *)data);
 }
 
 int poke_user(struct task_struct *child, long addr, long data)
 {
-	if (register_index(addr) < 0)
+	if (addr < 0 || addr >= UML_X86_64_USER_SIZE ||
+	    (addr & (sizeof(unsigned long) - 1)))
 		return -EIO;
-	return putreg(child, addr, data);
+	if (register_index(addr) >= 0)
+		return putreg(child, addr, data);
+	if (debugreg_offset(addr))
+		return set_debugreg(addr, data);
+	return -EIO;
 }
 
+static const struct user_regset_view uml_x86_64_view;
+
 long subarch_ptrace(struct task_struct *child, long request,
 		    unsigned long addr, unsigned long data)
 {
+	void __user *datap = (void __user *)data;
+
+	switch (request) {
+	case UML_X86_64_PTRACE_GETREGS:
+		return copy_regset_to_user(child, &uml_x86_64_view,
+					   REGSET_GENERAL, 0,
+					   sizeof(struct user_regs_struct),
+					   datap);
+	case UML_X86_64_PTRACE_SETREGS:
+		return copy_regset_from_user(child, &uml_x86_64_view,
+					     REGSET_GENERAL, 0,
+					     sizeof(struct user_regs_struct),
+					     datap);
+	case UML_X86_64_PTRACE_GETFPREGS:
+		return copy_regset_to_user(child, &uml_x86_64_view,
+					   REGSET_FP, 0,
+					   sizeof(struct uml_x86_64_fpstate),
+					   datap);
+	case UML_X86_64_PTRACE_SETFPREGS:
+		return copy_regset_from_user(child, &uml_x86_64_view,
+					     REGSET_FP, 0,
+					     sizeof(struct uml_x86_64_fpstate),
+					     datap);
+	}
 	return -EIO;
 }
 
@@ -226,8 +294,10 @@ static int genregs32_set(struct task_struct *target,
 static int fpregs_get(struct task_struct *target,
 		      const struct user_regset *regset, struct membuf to)
 {
-	membuf_write(&to, target->thread.regs.regs.fp, host_fp_size);
-	return 0;
+	struct uml_x86_64_xstate state;
+
+	uml_x86_64_get_xstate(&target->thread.regs.regs, &state);
+	return membuf_write(&to, &state.fpstate, sizeof(state.fpstate));
 }
 
 static int fpregs_set(struct task_struct *target,
@@ -235,8 +305,55 @@ static int fpregs_set(struct task_struct *target,
 		      unsigned int pos, unsigned int count,
 		      const void *kbuf, const void __user *ubuf)
 {
-	return user_regset_copyin(&pos, &count, &kbuf, &ubuf,
-		target->thread.regs.regs.fp, 0, host_fp_size);
+	struct uml_x86_64_xstate state;
+	int error;
+
+	uml_x86_64_get_xstate(&target->thread.regs.regs, &state);
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf,
+				   &state.fpstate, 0, sizeof(state.fpstate));
+	if (error)
+		return error;
+	return uml_x86_64_set_xstate(&target->thread.regs.regs, &state,
+				     UML_X86_64_XFEATURES);
+}
+
+static int xstate_get(struct task_struct *target,
+		      const struct user_regset *regset, struct membuf to)
+{
+	struct uml_x86_64_xstate state;
+	u64 xcr0 = UML_X86_64_XFEATURES;
+
+	uml_x86_64_get_xstate(&target->thread.regs.regs, &state);
+	/* ptrace reports XCR0 in the first software-reserved word. */
+	memset(&state.fpstate.sw_reserved, 0,
+	       sizeof(state.fpstate.sw_reserved));
+	memcpy(&state.fpstate.sw_reserved, &xcr0, sizeof(xcr0));
+	return membuf_write(&to, &state, sizeof(state));
+}
+
+static int xstate_set(struct task_struct *target,
+		      const struct user_regset *regset,
+		      unsigned int pos, unsigned int count,
+		      const void *kbuf, const void __user *ubuf)
+{
+	struct uml_x86_64_xstate state;
+	unsigned int index;
+	int error;
+
+	if (pos || count != sizeof(state))
+		return -EFAULT;
+	uml_x86_64_get_xstate(&target->thread.regs.regs, &state);
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf,
+				   &state, 0, sizeof(state));
+	if (error)
+		return error;
+	if (state.header.xfeatures & ~UML_X86_64_XFEATURES)
+		return -EINVAL;
+	for (index = 0; index < ARRAY_SIZE(state.header.reserved); index++)
+		if (state.header.reserved[index])
+			return -EINVAL;
+	return uml_x86_64_set_xstate(&target->thread.regs.regs, &state,
+				     state.header.xfeatures);
 }
 
 static const struct user_regset uml_x86_64_regsets[] = {
@@ -250,12 +367,20 @@ static const struct user_regset uml_x86_64_regsets[] = {
 	},
 	[REGSET_FP] = {
 		USER_REGSET_NOTE_TYPE(PRFPREG),
-		.n = sizeof(elf_fpregset_t) / sizeof(unsigned long),
-		.size = sizeof(unsigned long),
-		.align = sizeof(unsigned long),
+		.n = sizeof(struct uml_x86_64_fpstate) / sizeof(u64),
+		.size = sizeof(u64),
+		.align = sizeof(u64),
 		.regset_get = fpregs_get,
 		.set = fpregs_set,
 	},
+	[REGSET_XSTATE] = {
+		USER_REGSET_NOTE_TYPE(X86_XSTATE),
+		.n = sizeof(struct uml_x86_64_xstate) / sizeof(u64),
+		.size = sizeof(u64),
+		.align = sizeof(u64),
+		.regset_get = xstate_get,
+		.set = xstate_set,
+	},
 };
 
 static const struct user_regset_view uml_x86_64_view = {
@@ -274,6 +399,22 @@ static const struct user_regset uml_x86_32_regsets[] = {
 		.regset_get = genregs32_get,
 		.set = genregs32_set,
 	},
+	[REGSET_FP] = {
+		USER_REGSET_NOTE_TYPE(PRXFPREG),
+		.n = sizeof(struct uml_x86_64_fpstate) / sizeof(u32),
+		.size = sizeof(u32),
+		.align = sizeof(u32),
+		.regset_get = fpregs_get,
+		.set = fpregs_set,
+	},
+	[REGSET_XSTATE] = {
+		USER_REGSET_NOTE_TYPE(X86_XSTATE),
+		.n = sizeof(struct uml_x86_64_xstate) / sizeof(u64),
+		.size = sizeof(u64),
+		.align = sizeof(u64),
+		.regset_get = xstate_get,
+		.set = xstate_set,
+	},
 };
 
 static const struct user_regset_view uml_x86_32_view = {
