#
# Dedicated 4 KiB x86-family-userspace overlay applied after the shared Darwin
# UML kernel series. The kernel remains arm64 and this slice exposes no arm64
# userspace ABI.
UML_KERNEL_SERIES_SCHEMA=4
UML_KERNEL_RELEASE_VERSION='6.18.41'
UML_KERNEL_UPSTREAM_REPOSITORY='https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git'
UML_KERNEL_UPSTREAM_BRANCH='linux-6.18.y'
UML_KERNEL_UPSTREAM_COMMIT='2fe596715f840d053aed5cee5455f701bdcd2b50'
UML_KERNEL_UPSTREAM_TREE='9b4299714b8020ae57ca8c6310d747c2299aea0f'
UML_KERNEL_BASE_REF='refs/heads/uml/upstream-linux-6.18.41'
# Ordered generated series from the upstream commit to this line's tree, each
# paired with the managed replay branch that ends it; the line regenerates
# only the series it owns. kernel/common/tooling/kernel_series.py reads these.
UML_KERNEL_SERIES='kernel/mainline-6.18/patches/series:codex/linux-6.18-darwin kernel/mainline-6.18/slices/x86_64/patches/series:codex/linux-6.18-darwin-x86_64'
UML_KERNEL_OWNED_SERIES='kernel/mainline-6.18/slices/x86_64/patches/series'
UML_KERNEL_SLICE='x86_64'
UML_KERNEL_FINAL_TREE='e101fda0c95fe3e647d0bfd3b96deddb63ed0dbb'
UML_KERNEL_ABI_VERSION=12
UML_KERNEL_ABI_FINGERPRINT='0xefee2a66cbe8be89'
