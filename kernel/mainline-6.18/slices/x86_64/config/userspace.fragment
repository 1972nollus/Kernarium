# Fixed x86_64 userspace ABI for the dedicated 4 KiB compatibility slice.
CONFIG_UML_X86_64_USERSPACE_ONLY=y
# The fixed x86 userspace ABI does not expose the eBPF syscall/verifier. The
# networking-selected classic BPF interpreter remains available.
# CONFIG_BPF_SYSCALL is not set
# CONFIG_CGROUP_BPF is not set
