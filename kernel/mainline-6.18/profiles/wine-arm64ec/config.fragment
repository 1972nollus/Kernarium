# SPDX-License-Identifier: GPL-2.0-or-later
# The ARM64EC Wine appliance remains an arm64 Linux userspace profile. These
# entries assert the facilities Wine depends on and select a lower-latency
# active tick without waking idle iOS vCPU carriers.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_MISC=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_MEMFD_CREATE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_USERFAULTFD=y
CONFIG_HZ=250
CONFIG_NO_HZ_IDLE=y
