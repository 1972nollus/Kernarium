#!/bin/sh
# Compatibility app for root filesystems that provide BusyBox adduser but
# not the shadow-utils useradd command expected by Linux test and admin tools.

usage()
{
	echo "usage: useradd [-c comment] [-d home] [-g group] [-G groups]" >&2
	echo "               [-M|-m] [-r] [-s shell] [-u uid] user" >&2
	exit 2
}

gecos=
home=
primary_group=
supplementary_groups=
shell=
uid=
system_user=false
# shadow-utils useradd creates a home only with -m unless configured otherwise.
# Keep that behavior deterministic on the small Buildroot image.
no_home=true

while [ "$#" -gt 0 ]; do
	case "$1" in
	-c|-d|-g|-G|-s|-u)
		[ "$#" -ge 2 ] || usage
		case "$1" in
		-c) gecos=$2 ;;
		-d) home=$2 ;;
		-g) primary_group=$2 ;;
		-G) supplementary_groups=$2 ;;
		-s) shell=$2 ;;
		-u) uid=$2 ;;
		esac
		shift 2
		;;
	-M) no_home=true; shift ;;
	-m) no_home=false; shift ;;
	-r) system_user=true; shift ;;
	--) shift; break ;;
	-*) echo "useradd: unsupported option: $1" >&2; usage ;;
	*) break ;;
	esac
done

[ "$#" -eq 1 ] || usage
user=$1

set -- -D
[ -z "$gecos" ] || set -- "$@" -g "$gecos"
[ -z "$home" ] || set -- "$@" -h "$home"
[ -z "$primary_group" ] || set -- "$@" -G "$primary_group"
[ -z "$shell" ] || set -- "$@" -s "$shell"
[ -z "$uid" ] || set -- "$@" -u "$uid"
[ "$system_user" = false ] || set -- "$@" -S
[ "$no_home" = false ] || set -- "$@" -H

adduser "$@" "$user" || exit $?

old_ifs=$IFS
IFS=,
for group in $supplementary_groups; do
	[ -z "$group" ] || adduser "$user" "$group" || exit $?
done
IFS=$old_ifs
