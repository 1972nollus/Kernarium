rm /etc/inittab
write darwin/rootfs/inittab /etc/inittab
rm /etc/init.d/rcS
write darwin/rootfs/rcS /etc/init.d/rcS
set_inode_field /etc/init.d/rcS mode 0100755
rm /etc/profile
write darwin/rootfs/profile /etc/profile
rm /usr/sbin/useradd
write darwin/rootfs/useradd /usr/sbin/useradd
set_inode_field /usr/sbin/useradd mode 0100755
rm /usr/sbin/userdel
write darwin/rootfs/userdel /usr/sbin/userdel
set_inode_field /usr/sbin/userdel mode 0100755
rm /usr/sbin/groupadd
write darwin/rootfs/groupadd /usr/sbin/groupadd
set_inode_field /usr/sbin/groupadd mode 0100755
rm /usr/sbin/groupdel
write darwin/rootfs/groupdel /usr/sbin/groupdel
set_inode_field /usr/sbin/groupdel mode 0100755
rm /sbin/mkfs.ext2
write darwin/rootfs/mkfs.ext2 /sbin/mkfs.ext2
set_inode_field /sbin/mkfs.ext2 mode 0100755
rm /sbin/uml-overlay-init
write darwin/rootfs/uml-overlay-init /sbin/uml-overlay-init
set_inode_field /sbin/uml-overlay-init mode 0100755
