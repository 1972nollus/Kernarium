#!/bin/sh
# Buildroot's BusyBox exposes the ext2 formatter as mke2fs.  Provide the
# conventional filesystem-specific command name used by Linux administration
# and test tooling.  BusyBox does not provide tune2fs, so enable the ext2
# user_xattr default directly in each freshly-created superblock.  The field is
# a little-endian u32 at byte 0x100 of the 1 KiB ext2 superblock and bit 2 is
# EXT2_DEFM_XATTR_USER.
device=
for argument do
	device=$argument
done

# LTP's filesystem helpers may pass an option bundle such as "-b 1024" as a
# single argument.  e2fsprogs accepts the whitespace before the numeric value,
# while BusyBox's stricter parser does not.  Block-device paths cannot contain
# whitespace, so split the formatter command line here to provide the standard
# mkfs.ext2 command-line behavior on this compact rootfs.
# shellcheck disable=SC2048,SC2086
mke2fs $* || exit $?

if [ -n "$device" ] && [ -b "$device" ]; then
	printf '\004\000\000\000' |
		dd of="$device" bs=1 seek=1280 conv=notrunc 2>/dev/null
fi
