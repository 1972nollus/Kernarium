# SPDX-License-Identifier: Apache-2.0
#
# init.vendor.rc grows userdata with e2fsck, tune2fs and resize2fs, which all
# run in the fsck domain. resize2fs leaves new inode tables for the kernel to
# initialise lazily only when /sys/fs/ext4/features/lazy_itable_init is
# visible; otherwise it writes every new table before /data can be mounted.
# AOSP grants the same read to the e2fs domain for mke2fs.
allow fsck sysfs_fs_ext4_features:dir search;
allow fsck sysfs_fs_ext4_features:file r_file_perms;
