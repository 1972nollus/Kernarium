# The UML product exposes one single-port Virtio console as its Android shell.
/dev/hvc0  u:object_r:serial_device:s0

# Mesa's EGL SP-HAL resolves this dependency through the same namespace.
/vendor/lib(64)?/libzstd\.so  u:object_r:same_process_hal_file:s0

# The Venus Vulkan HAL is loaded into every application process that uses
# Vulkan, like the Mesa EGL/GLES stack beside it.
/vendor/lib(64)?/hw/vulkan\.virtio\.so  u:object_r:same_process_hal_file:s0

# The platform labels the EGL and GLES libraries in /vendor/lib64/egl; the
# gallium driver they link is loaded into the same processes.
/vendor/lib(64)?/venus_gallium_dri\.so  u:object_r:same_process_hal_file:s0

# Mesa loads the allocator's gralloc0 module in the same processes to read
# buffer metadata.
/vendor/lib(64)?/hw/gralloc\.minigbm\.so  u:object_r:same_process_hal_file:s0

# Addresses eth0 and builds the virtual Wi-Fi interface at post-fs-data.
/vendor/bin/kernarium_net_setup  u:object_r:kernarium_net_setup_exec:s0
