<!-- The guest has no hardware video decoder, and the software decoders of the
     swcodec APEX advertise less than they decode: VP9 stops at 2048x2048 and HEVC
     at 2,000,000 8x8 blocks per second, which is 1080p at 60 frames per second.
     Both decode 3840x2160 correctly, so the product states the capability the
     Mainline CTS asks of some component of every device. The vendor file is parsed
     after the APEX's and updates its entries; the values not named here stay.
     Verified by tools/verify-target-files.py: HEVC at 3840x2160 and 30 frames per
     second (129,600 blocks, 3,888,000 per second) and VP9 at 3840x2160 (32,400
     16x16 blocks) must be inside the limits. -->
<MediaCodecs>
    <Decoders>
        <!-- HEVC Main tier level 5.2, which the decoder already reports: 4096x2176
             at 60 frames per second is 1,069,547,520 luma samples per second. -->
        <MediaCodec name="c2.android.hevc.decoder" type="video/hevc" update="true">
            <Limit name="blocks-per-second" range="1-16711680" />
        </MediaCodec>
        <MediaCodec name="c2.android.vp9.decoder" type="video/x-vnd.on2.vp9" update="true">
            <Limit name="size" min="2x2" max="4096x4096" />
            <Limit name="block-count" range="1-65536" />
            <Limit name="blocks-per-second" range="1-2000000" />
        </MediaCodec>
    </Decoders>
</MediaCodecs>
