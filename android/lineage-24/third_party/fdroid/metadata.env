# SPDX-License-Identifier: Apache-2.0
# The F-Droid client and its Privileged Extension, pinned exactly. Both are
# presigned by F-Droid: the build installs them unchanged and no key of this
# project signs them. Source preparation downloads them from FDROID_BASE_URL,
# the only network use outside Repo; every later step uses the verified copies.
# The detached PGP signatures (<file>.asc) were verified once against F-Droid's
# key with this fingerprint when the pins were set; the digests below pin the
# files themselves.
FDROID_SCHEMA=1
FDROID_BASE_URL='https://f-droid.org/repo'
FDROID_DESTINATION='vendor/kernarium/fdroid'
FDROID_PGP_KEY_FINGERPRINT='37D2C98789D8311948394E3E41E7044E1DBA2E89'
FDROID_SIGNING_CERT_SHA256='43238d512c1e5eb2d6569f4a3afbf5523418b82e0a3ed1552770abb9a9c9ccab'
FDROID_CLIENT_FILE='org.fdroid.fdroid_2000051.apk'
FDROID_CLIENT_SIZE=12537183
FDROID_CLIENT_SHA256='83d3fe522281c3cb89fce3bc05038f81b3c3b32c108536941f184c5f9bb53778'
FDROID_EXTENSION_FILE='org.fdroid.fdroid.privileged_2140.apk'
FDROID_EXTENSION_SIZE=45943
FDROID_EXTENSION_SHA256='6261445e671bea58fd8d5b7c10140845a44a01940cc2e1ad8c52e3aa4a264e94'
