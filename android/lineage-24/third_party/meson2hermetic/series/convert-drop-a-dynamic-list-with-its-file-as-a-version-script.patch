From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 26 Sep 2026 21:02:56 +0000
Subject: [PATCH] convert: drop a dynamic list with its file, as a version
 script

Meson can pass a dynamic list as two arguments, -Wl,--dynamic-list and
the list file, as it does a version script. The converter drops a
version script's option together with its file. It kept a bare
-Wl,--dynamic-list, however, and that option then consumed the next
linker argument as its file. Drop the dynamic list the same way.
---
 mesonbuild/convert/instance/convert_instance_build_target.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/mesonbuild/convert/instance/convert_instance_build_target.py b/mesonbuild/convert/instance/convert_instance_build_target.py
index 9753fce9b63610a60225e9917a8a96e6089a3ba1..13f3a27be1e0b9047f50a5f7132f4feff3762377 100644
--- a/mesonbuild/convert/instance/convert_instance_build_target.py
+++ b/mesonbuild/convert/instance/convert_instance_build_target.py
@@ -325,7 +325,10 @@ class ConvertInstanceBuildTarget:
             for arg in build_target.link_args:
                 # Meson should really support version scripts to avoid special cases, such as here.
                 # https://github.com/mesonbuild/meson/issues/3047
-                if arg == '-Wl,--version-script':
+                # A dynamic list names its file the same way, and the file
+                # argument is dropped below with a version script's; the
+                # option alone would consume the next linker argument.
+                if arg in ('-Wl,--version-script', '-Wl,--dynamic-list'):
                     continue
 
                 normalized_string = project_instance.normalize_string(arg, self.subdir)
