# SPDX-License-Identifier: GPL-2.0-or-later
# Exact source and product identity of the LineageOS 24 guest. The manifest
# revision is the branch or tag the manifest repository is read at; the AOSP
# tag is the Android release the tree is built on.
LINEAGE24_METADATA_SCHEMA=2
LINEAGE24_MANIFEST_REPOSITORY='https://github.com/LineageOS/android.git'
LINEAGE24_MANIFEST_REVISION='lineage-24.0'
LINEAGE24_MANIFEST_COMMIT='2a50ca061bffe4e73918ae2e0b99b7a05f647154'
LINEAGE24_MANIFEST_TREE='d3a8882098e15a149db9e252836e130611d9fc16'
LINEAGE24_BASE_MANIFEST_SHA256='88df0db80dd98766af3b26779237f5790989ad0deda62decd87c9af906d4471c'
LINEAGE24_AOSP_TAG='android-17.0.0_r1'
LINEAGE24_ANDROID_MAJOR=17
LINEAGE24_PRODUCT='lineage_darwin'
LINEAGE24_KERNEL_PAGE_SIZE=4096
LINEAGE24_MAX_PAGE_SIZE_SUPPORTED=16384
LINEAGE24_RELEASE_CONFIG='cp2a'
# user or userdebug: lunch, target-file verification and the release manifest
# all follow this one setting.
LINEAGE24_BUILD_VARIANT='userdebug'
