Subject: [PATCH] virtualization: use ext4 APEX payload

---
 build/apex/Android.bp | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/build/apex/Android.bp b/build/apex/Android.bp
index f24eb80001f3e8f8cd730b27e2efc9a52be73269..6dbbc99dee7b710e7374db82852082fff8a66682 100644
--- a/build/apex/Android.bp
+++ b/build/apex/Android.bp
@@ -201,10 +201,7 @@ apex_defaults {
         default: unset,
     }),
 
-    payload_fs_type: "erofs",
-    erofs: {
-        pcluster_size: 32768,
-    },
+    payload_fs_type: "ext4",
 }
 
 apex_defaults {
