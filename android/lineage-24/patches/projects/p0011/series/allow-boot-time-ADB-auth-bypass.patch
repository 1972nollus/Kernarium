From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 28 Aug 2026 08:28:48 +0000
Subject: [PATCH] allow boot-time ADB auth bypass

Kernarium exposes one immutable per-boot policy for ADB authorization,
ro.boot.kernarium.adb_auth. Without it adbd requires authorization. When it
is false, the host is an unattended test host: adbd accepts every key, and
the root service starts with rooted debugging enabled so adb root works
without the Developer options switch.

Change-Id: I72ccb50505c2ff519d7d599be8358348e2dbf5cb
---
 daemon/main.cpp          | 7 +++++++
 root/adbroot_service.cpp | 9 +++++++++
 2 files changed, 16 insertions(+)

diff --git a/daemon/main.cpp b/daemon/main.cpp
index 87e56ddedbd766957652a90aa84337be7b28cbee..3d1d8e7f62bb34cafdc90c6bea303d8332cda16c 100644
--- a/daemon/main.cpp
+++ b/daemon/main.cpp
@@ -230,6 +230,13 @@ int adbd_main() {
     }
 #endif
 
+    // Kernarium exposes one immutable per-boot policy for ADB authorization.
+    // Authorization is enabled when the property is absent, overriding the
+    // Cuttlefish user-build default; only an explicit false value permits
+    // unattended host testing.
+    auth_required = android::base::GetBoolProperty(
+            "ro.boot.kernarium.adb_auth", true);
+
     // Our external storage path may be different than apps, since
     // we aren't able to bind mount after dropping root.
     const char* adb_external_storage = getenv("ADB_EXTERNAL_STORAGE");
diff --git a/root/adbroot_service.cpp b/root/adbroot_service.cpp
index bbf94438d34292baa5ab643793af43046283709f..36b62d9a06b811e37d0b21b4faa5ffe1cadabc40 100644
--- a/root/adbroot_service.cpp
+++ b/root/adbroot_service.cpp
@@ -71,6 +71,7 @@ namespace android {
 namespace adbroot {
 
 using ::android::AutoMutex;
+using ::android::base::GetBoolProperty;
 using ::android::base::ReadFileToString;
 using ::android::base::SetProperty;
 using ::android::base::Trim;
@@ -87,6 +88,14 @@ AdbRootService::AdbRootService() : enabled_(false) {
     if (ReadFileToString(kStoragePath + kEnabled, &buf)) {
         enabled_ = Trim(buf) == "1";
     }
+
+    // Kernarium hosts that boot without ADB authorization are unattended test
+    // hosts: they enable rooted debugging for the boot, so adb root works
+    // without the Developer options switch. Authorized boots keep the stored
+    // setting, which is off on a fresh data partition.
+    if (!GetBoolProperty("ro.boot.kernarium.adb_auth", true)) {
+        enabled_ = true;
+    }
 }
 
 void AdbRootService::Register() {
