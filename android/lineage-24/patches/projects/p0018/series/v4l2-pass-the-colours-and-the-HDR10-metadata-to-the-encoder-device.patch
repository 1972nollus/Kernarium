+// static
+C2R EncodeInterface::ColorAspectsSetter(bool /*mayBlock*/,
+                                        C2P<C2StreamColorAspectsInfo::input>& me) {
+    if (me.v.range > C2Color::RANGE_OTHER) me.set().range = C2Color::RANGE_OTHER;
+    if (me.v.primaries > C2Color::PRIMARIES_OTHER) me.set().primaries = C2Color::PRIMARIES_OTHER;
+    if (me.v.transfer > C2Color::TRANSFER_OTHER) me.set().transfer = C2Color::TRANSFER_OTHER;
+    if (me.v.matrix > C2Color::MATRIX_OTHER) me.set().matrix = C2Color::MATRIX_OTHER;
+    return C2R::Ok();
+}
+
+// static
+C2R EncodeInterface::CodedColorAspectsSetter(bool /*mayBlock*/,
+                                             C2P<C2StreamColorAspectsInfo::output>& me,
+                                             const C2P<C2StreamColorAspectsInfo::input>& coded) {
+    // The stream describes its colours the way the client described the frames.
+    me.set().range = coded.v.range;
+    me.set().primaries = coded.v.primaries;
+    me.set().transfer = coded.v.transfer;
+    me.set().matrix = coded.v.matrix;
+    return C2R::Ok();
+}
+
+// static
+C2R EncodeInterface::HdrStaticInfoSetter(bool /*mayBlock*/,
+                                         C2P<C2StreamHdrStaticInfo::input>& me) {
+    // The chromaticities are fractions, the luminances and light levels are in the units and
+    // ranges of the SEI messages that carry them.
+    auto clampTo = [](float* value, float high) { *value = std::clamp(*value, 0.f, high); };
+    C2HdrStaticMetadataStruct& info = me.set();
+    for (C2ColorXyStruct* xy : {&info.mastering.red, &info.mastering.green, &info.mastering.blue,
+                                &info.mastering.white}) {
+        clampTo(&xy->x, 1.f);
+        clampTo(&xy->y, 1.f);
+    }
+    clampTo(&info.mastering.maxLuminance, 65535.f);
+    clampTo(&info.mastering.minLuminance, 6.5535f);
+    clampTo(&info.maxCll, 65535.f);
+    clampTo(&info.maxFall, 65535.f);
+    return C2R::Ok();
+}
