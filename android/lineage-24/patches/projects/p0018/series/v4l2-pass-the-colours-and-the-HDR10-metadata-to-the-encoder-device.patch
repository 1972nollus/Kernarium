         caps->supportedLevels = queryC2Levels(pixFmt);
     }
+
+    // Main 10 takes 10-bit frames, so a device that lists the profile but takes no 10-bit frame
+    // cannot encode it. The HDR10 metadata only has a meaning for that profile.
+    if (isHEVC) {
+        const std::vector<uint32_t> rawFormats =
+                enumerateSupportedPixelformats(V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+        const bool takesP010 = std::find(rawFormats.begin(), rawFormats.end(),
+                                         V4L2_PIX_FMT_P010) != rawFormats.end();
+        if (!takesP010) {
+            caps->supportedProfiles.erase(
+                    std::remove_if(caps->supportedProfiles.begin(), caps->supportedProfiles.end(),
+                                   [](const SupportedProfile& profile) {
+                                       return profile.profile == C2Config::PROFILE_HEVC_MAIN_10 ||
+                                              profile.profile ==
+                                                      C2Config::PROFILE_HEVC_MAIN_10_INTRA;
+                                   }),
+                    caps->supportedProfiles.end());
+        }
+        caps->supportsHdr10 = takesP010 &&
+                              queryControl(V4L2_CID_COLORIMETRY_HDR10_CLL_INFO, &ctrl) &&
+                              queryControl(V4L2_CID_COLORIMETRY_HDR10_MASTERING_DISPLAY, &ctrl);
+    }
 }
 
