+void V4L2Encoder::configureHdr(const C2HdrStaticMetadataStruct& info) {
+    auto scaled = [](float value, float unit, int32_t low, int32_t high) {
+        return std::clamp(static_cast<int32_t>(std::lround(value / unit)), low, high);
+    };
+
+    // The units of the controls are those of the SEI messages that carry the metadata: 0.00002 for
+    // the chromaticity coordinates and 0.0001 cd/m2 for the mastering luminance.
+    constexpr float kChromaticity = 0.00002f;
+    constexpr float kLuminance = 0.0001f;
+    // The primaries are in the order green, blue, red, as the SEI message has them.
+    const C2ColorXyStruct* primaries[] = {&info.mastering.green, &info.mastering.blue,
+                                          &info.mastering.red};
+    struct v4l2_ctrl_hdr10_mastering_display mastering;
+    memset(&mastering, 0, sizeof(mastering));
+    for (size_t i = 0; i < 3; ++i) {
+        mastering.display_primaries_x[i] =
+                scaled(primaries[i]->x, kChromaticity, V4L2_HDR10_MASTERING_PRIMARIES_X_LOW,
+                       V4L2_HDR10_MASTERING_PRIMARIES_X_HIGH);
+        mastering.display_primaries_y[i] =
+                scaled(primaries[i]->y, kChromaticity, V4L2_HDR10_MASTERING_PRIMARIES_Y_LOW,
+                       V4L2_HDR10_MASTERING_PRIMARIES_Y_HIGH);
+    }
+    mastering.white_point_x = scaled(info.mastering.white.x, kChromaticity,
+                                     V4L2_HDR10_MASTERING_WHITE_POINT_X_LOW,
+                                     V4L2_HDR10_MASTERING_WHITE_POINT_X_HIGH);
+    mastering.white_point_y = scaled(info.mastering.white.y, kChromaticity,
+                                     V4L2_HDR10_MASTERING_WHITE_POINT_Y_LOW,
+                                     V4L2_HDR10_MASTERING_WHITE_POINT_Y_HIGH);
+    mastering.max_display_mastering_luminance =
+            scaled(info.mastering.maxLuminance, kLuminance, V4L2_HDR10_MASTERING_MAX_LUMA_LOW,
+                   V4L2_HDR10_MASTERING_MAX_LUMA_HIGH);
+    mastering.min_display_mastering_luminance =
+            scaled(info.mastering.minLuminance, kLuminance, V4L2_HDR10_MASTERING_MIN_LUMA_LOW,
+                   V4L2_HDR10_MASTERING_MIN_LUMA_HIGH);
+
+    struct v4l2_ctrl_hdr10_cll_info lightLevel;
+    memset(&lightLevel, 0, sizeof(lightLevel));
+    lightLevel.max_content_light_level = scaled(info.maxCll, 1.f, 0, UINT16_MAX);
+    lightLevel.max_pic_average_light_level = scaled(info.maxFall, 1.f, 0, UINT16_MAX);
+
+    // The metadata is optional, so a device that refuses it still encodes the stream.
+    if (!mDevice->setExtCtrls(V4L2_CTRL_CLASS_COLORIMETRY,
+                              {V4L2ExtCtrl(V4L2_CID_COLORIMETRY_HDR10_MASTERING_DISPLAY, &mastering,
+                                           sizeof(mastering))})) {
+        ALOGW("Setting the HDR10 mastering display metadata failed");
+    }
+    if (!mDevice->setExtCtrls(V4L2_CTRL_CLASS_COLORIMETRY,
+                              {V4L2ExtCtrl(V4L2_CID_COLORIMETRY_HDR10_CLL_INFO, &lightLevel,
+                                           sizeof(lightLevel))})) {
+        ALOGW("Setting the HDR10 content light level failed");
+    }
+}
