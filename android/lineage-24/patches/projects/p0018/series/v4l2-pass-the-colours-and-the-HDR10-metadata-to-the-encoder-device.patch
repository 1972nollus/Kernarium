+C2ColorAspectsStruct EncodeInterface::getColorAspects() const {
+    Lock lock = this->lock();
+    C2ColorAspectsStruct aspects;
+    aspects.range = mColorAspects->range;
+    aspects.primaries = mColorAspects->primaries;
+    aspects.transfer = mColorAspects->transfer;
+    aspects.matrix = mColorAspects->matrix;
+    return aspects;
+}
+
+std::optional<C2HdrStaticMetadataStruct> EncodeInterface::getHdrStaticInfo() const {
+    if (!mHdrStaticInfo) return std::nullopt;
+
+    Lock lock = this->lock();
+    const C2HdrStaticMetadataStruct& info = *mHdrStaticInfo;
+    // The defaults are all zero, and a client that sets some of the values leaves the others zero.
+    if (info.mastering.maxLuminance == 0.f && info.maxCll == 0.f && info.maxFall == 0.f) {
+        return std::nullopt;
+    }
+    return info;
+}
