--- a/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h
+++ b/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h
@@ -552,6 +552,10 @@ private:
     SupportedProfiles enumerateSupportedProfiles(V4L2Device::Type type,
                                                  const std::vector<uint32_t>& pixelFormats);
 
+    // Returns the size in bytes of the coded buffers this decoder device negotiates for
+    // |pixFmt|, or 0 if it states none. The device must be open.
+    uint32_t queryCodedBufferSize(uint32_t pixFmt);
+
     // Fills the rate control and structure capabilities of |caps| from the controls of this
     // encoder device, which must be open and encode to |codec| in |pixFmt|.
     void queryEncoderControls(VideoCodec codec, uint32_t pixFmt, SupportedCapabilities* caps);
