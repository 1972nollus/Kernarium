     C2Config::level_t defaultLevel = C2Config::LEVEL_UNUSED;
 
+    // The size in bytes of the coded buffers the decoder device negotiates for the codec: what
+    // the input queue reports before any size is requested. 0 when the device states none.
+    uint32_t codedBufferSize = 0;
+
     // Rate control and structure capabilities of an encoder, filled from the encoder device's
     // controls. A control the device does not expose leaves its value at the default below, and
