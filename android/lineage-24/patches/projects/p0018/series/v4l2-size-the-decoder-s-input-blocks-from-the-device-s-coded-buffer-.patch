diff --git a/components/DecodeInterface.cpp b/components/DecodeInterface.cpp
index d882db3342bada2a134e20fdb1170942471f3e40..270505bc3ca0b8713a5fef10fe6be5d01d13b51f 100644
--- a/components/DecodeInterface.cpp
+++ b/components/DecodeInterface.cpp
@@ -23,16 +23,13 @@
 namespace android {
 namespace {
 
-constexpr size_t k1080pArea = 1920 * 1088;
-constexpr size_t k4KArea = 3840 * 2160;
-// Input bitstream buffer size for up to 1080p streams.
-// Set it to 2MB since it is possible for the encoded bitstream to exceed the size of 1MB
-// when using higher bitrates, like 1Mb/s on slower devices. Also, this brings up compability
-// with the Chrome browser as it is using 2MB buffer size for a 1080p stream, ref:
-// https://source.chromium.org/chromium/chromium/src/+/main:media/gpu/gpu_video_encode_accelerator_helpers.cc;l=25
-constexpr size_t kInputBufferSizeFor1080p = 16 * 1024 * 1024;  // 16MB
-// Input bitstream buffer size for up to 4k streams.
-constexpr size_t kInputBufferSizeFor4K = 4 * kInputBufferSizeFor1080p;
+// The range of the input blocks the component asks for by default. The framework allocates every
+// input block at the maximum input size and a stream keeps several of them, so a size beyond what
+// the device takes is memory that no frame uses: 64 MiB blocks held about 0.9 GB for one 4K stream,
+// while the component copies only the bytes a frame uses. The size comes from the device (see
+// inputBufferSizeFor), within these bounds.
+constexpr size_t kMinInputBufferSize = 1 * 1024 * 1024;
+constexpr size_t kMaxInputBufferSize = 16 * 1024 * 1024;
 
 // The levels of the HEVC Main tier that have a High tier counterpart, and that counterpart.
 struct HevcTierPair {
@@ -65,15 +62,13 @@ void addHevcHighTierLevels(std::vector<unsigned int>* levels) {
     }
 }
 
-size_t calculateInputBufferSize(size_t area) {
-    if (area > k4KArea) {
-        ALOGW("Input buffer size for video size (%zu) larger than 4K (%zu) might be too small.",
-              area, k4KArea);
-    }
-
-    // Enlarge the input buffer for 4k video
-    if (area > k1080pArea) return kInputBufferSizeFor4K;
-    return kInputBufferSizeFor1080p;
+// The size of the input blocks for a device that negotiates coded buffers of |codedBufferSize|
+// bytes: that size, within [kMinInputBufferSize, kMaxInputBufferSize]. A device that states no
+// size (the query failed or the device lists none) gets the largest block, which fits any coded
+// buffer up to that size and does not depend on a size the component could not get.
+size_t inputBufferSizeFor(uint32_t codedBufferSize) {
+    if (codedBufferSize == 0) return kMaxInputBufferSize;
+    return std::clamp<size_t>(codedBufferSize, kMinInputBufferSize, kMaxInputBufferSize);
 }
 }  // namespace
 
@@ -120,7 +115,11 @@ C2R DecodeInterface::SizeSetter(bool /* mayBlock */,
 }
 
 C2R DecodeInterface::InputSizeSetter(bool /* mayBlock */,
-                                     C2P<C2StreamMaxBufferSizeInfo::input>& inputSize) {
+                                     C2P<C2StreamMaxBufferSizeInfo::input>& inputSize,
+                                     const C2P<C2V4l2InputBlockSizeSetting>& inputBlockSize) {
+    // A client states the largest sample of the clip it starts with, and the stream can carry
+    // larger ones (adaptive playback); the blocks never get smaller than the device's buffers.
+    if (inputSize.v.value < inputBlockSize.v.value) inputSize.set().value = inputBlockSize.v.value;
     return inputSize.F(inputSize.v.value).validatePossible(inputSize.v.value);
 }
 
@@ -157,17 +156,6 @@ C2R DecodeInterface::MergedColorAspectsSetter(bool /* mayBlock */,
     return C2R::Ok();
 }
 
-// static
-C2R DecodeInterface::MaxInputBufferSizeCalculator(
-        bool /* mayBlock */, C2P<C2StreamMaxBufferSizeInfo::input>& me,
-        const C2P<C2StreamPictureSizeInfo::output>& size) {
-    size_t calculatedSize = calculateInputBufferSize(size.v.width * size.v.height);
-
-    if (me.v.value < calculatedSize) me.set().value = calculatedSize;
-
-    return C2R::Ok();
-}
-
 DecodeInterface::DecodeInterface(const std::string& name,
                                  const std::shared_ptr<C2ReflectorHelper>& helper,
                                  const SupportedCapabilities& caps)
@@ -179,6 +167,7 @@ DecodeInterface::DecodeInterface(const std::string& name,
 
     // The system resources are a struct that the reflector does not know yet.
     helper->addStructDescriptors<C2SystemResourceStruct>();
+    helper->addStructDescriptors<C2V4l2InputBlockSizeSetting>();
 
     addParameter(DefineParam(mKind, C2_PARAMKEY_COMPONENT_KIND)
                          .withConstValue(new C2ComponentKindSetting(C2Component::KIND_DECODER))
@@ -456,14 +445,18 @@ DecodeInterface::DecodeInterface(const std::string& name,
                              .build());
     }
 
+    const uint32_t inputBlockSize =
+            static_cast<uint32_t>(inputBufferSizeFor(caps.codedBufferSize));
+    addParameter(DefineParam(mInputBlockSize, C2_PARAMKEY_V4L2_INPUT_BLOCK_SIZE)
+                         .withConstValue(new C2V4l2InputBlockSizeSetting(inputBlockSize))
+                         .build());
     addParameter(
             DefineParam(mMaxInputSize, C2_PARAMKEY_INPUT_MAX_BUFFER_SIZE)
-                    .withDefault(new C2StreamMaxBufferSizeInfo::input(0u, kInputBufferSizeFor1080p))
+                    .withDefault(new C2StreamMaxBufferSizeInfo::input(0u, inputBlockSize))
                     .withFields({
                             C2F(mMaxInputSize, value).any(),
                     })
-                    .withSetter(InputSizeSetter)
-                    .calculatedAs(MaxInputBufferSizeCalculator, mSize)
+                    .withSetter(InputSizeSetter, mInputBlockSize)
                     .build());
 
     bool secureMode = name.find(".secure") != std::string::npos;
diff --git a/components/include/v4l2_codec2/components/DecodeInterface.h b/components/include/v4l2_codec2/components/DecodeInterface.h
index 7e5d900cb0de023d94c2a7af54e1725d07f028bf..15eaa31ba42b13c6f7d0af9423841b46f2fdb924 100644
--- a/components/include/v4l2_codec2/components/DecodeInterface.h
+++ b/components/include/v4l2_codec2/components/DecodeInterface.h
@@ -17,6 +17,15 @@
 
 namespace android {
 
+// The size of the input blocks the component asks for by default and never below: the size of the
+// coded buffers the device negotiates, within the bounds the component keeps. A setting of the
+// component's own that no client sets; the maximum input size depends on it, because a client
+// states a maximum from its first clip (a few tens of KB) and later samples are larger.
+constexpr C2Param::type_index_t kParamIndexInputBlockSize = C2Param::TYPE_INDEX_VENDOR_START + 1;
+typedef C2GlobalParam<C2Setting, C2Uint32Value, kParamIndexInputBlockSize>
+        C2V4l2InputBlockSizeSetting;
+constexpr char C2_PARAMKEY_V4L2_INPUT_BLOCK_SIZE[] = "vendor.v4l2.input-block-size";
+
 class DecodeInterface : public C2InterfaceHelper {
 public:
     DecodeInterface(const std::string& name, const std::shared_ptr<C2ReflectorHelper>& helper,
@@ -35,6 +44,9 @@ public:
 
     static uint32_t getOutputDelay(VideoCodec codec);
 
+    // The size of the coded buffers the decoder asks the device for, which an input block is at
+    // least as large as when it is queued: the maximum input size, which is never below the size
+    // the device negotiates.
     size_t getInputBufferSize() const;
     // Get the system resources that the configured instance needs, as the framework reads them: a
     // copy of the parameter, and the pixel rate in it, for telling two states apart.
@@ -55,10 +67,8 @@ private:
     // Configurable parameter setters.
     static C2R ProfileLevelSetter(bool mayBlock, C2P<C2StreamProfileLevelInfo::input>& info);
     static C2R SizeSetter(bool mayBlock, C2P<C2StreamPictureSizeInfo::output>& videoSize);
-    static C2R InputSizeSetter(bool mayBlock, C2P<C2StreamMaxBufferSizeInfo::input>& inputSize);
-    static C2R MaxInputBufferSizeCalculator(bool mayBlock,
-                                            C2P<C2StreamMaxBufferSizeInfo::input>& me,
-                                            const C2P<C2StreamPictureSizeInfo::output>& size);
+    static C2R InputSizeSetter(bool mayBlock, C2P<C2StreamMaxBufferSizeInfo::input>& inputSize,
+                               const C2P<C2V4l2InputBlockSizeSetting>& inputBlockSize);
 
     static C2R OperatingRateSetter(bool mayBlock, C2P<C2OperatingRateTuning>& me);
 
@@ -120,6 +130,8 @@ private:
     // The system resources the instance needs for the configuration. Read-only.
     std::shared_ptr<C2ResourcesNeededTuning> mResourcesNeeded;
     uint64_t mPixelRateCapacity = 0;
+    // The size of the input blocks by default and the least the maximum input size takes. Read-only.
+    std::shared_ptr<C2V4l2InputBlockSizeSetting> mInputBlockSize;
     // Maximum size of one input buffer.
     std::shared_ptr<C2StreamMaxBufferSizeInfo::input> mMaxInputSize;
     // The suggested usage of input buffer allocator ID.
diff --git a/v4l2/V4L2Decoder.cpp b/v4l2/V4L2Decoder.cpp
index 83fad685e1cd020046159a7ee54f6605c593c0e4..5211d01bb1c78e91fc4f6961d711aeacb2849680 100644
--- a/v4l2/V4L2Decoder.cpp
+++ b/v4l2/V4L2Decoder.cpp
@@ -211,6 +211,13 @@ bool V4L2Decoder::setupInputFormat(const uint32_t inputPixelFormat, const size_t
         return false;
     }
     ALOG_ASSERT(format->fmt.pix_mp.pixelformat == inputPixelFormat);
+    // The device takes a dma-buf at least as large as the size it settled on, which is the
+    // largest of the size asked for and the one it needs. The component asks for the size of its
+    // input blocks, so a device that needs more cannot be given a block it accepts.
+    if (format->fmt.pix_mp.plane_fmt[0].sizeimage > inputBufferSize) {
+        ALOGW("The device needs coded buffers of %u bytes, the input blocks are %zu bytes",
+              format->fmt.pix_mp.plane_fmt[0].sizeimage, inputBufferSize);
+    }
 
     if (mInputQueue->allocateBuffers(kNumInputBuffers, V4L2_MEMORY_DMABUF) == 0) {
         ALOGE("Failed to allocate input buffer.");
diff --git a/v4l2/V4L2Device.cpp b/v4l2/V4L2Device.cpp
index 0f9c4a19c2c8661ffa78b71a6810f64461448cd1..fccc79ca30abfe299d631a4d463ac3bacca4c39e 100644
--- a/v4l2/V4L2Device.cpp
+++ b/v4l2/V4L2Device.cpp
@@ -2535,9 +2535,33 @@ SupportedCapabilities V4L2Device::queryDecodingCapabilities(VideoCodec codec) {
     caps.defaultProfile = V4L2Device::getDefaultProfile(codec);
     caps.pixelRateCapacity = V4L2Device::getDecodePixelRateCapacity();
 
+    // The coded buffer size is that of the device that decodes |codec|, which is the one a decoder
+    // of the codec will open.
+    const uint32_t pixelFormat = V4L2Device::videoCodecToPixFmt(codec);
+    scoped_refptr<V4L2Device> device = V4L2Device::create();
+    const std::string path = device->getDevicePathFor(Type::kDecoder, pixelFormat);
+    if (!path.empty() && device->openDevicePath(path, Type::kDecoder)) {
+        caps.codedBufferSize = device->queryCodedBufferSize(pixelFormat);
+        device->closeDevice();
+    }
+    ALOGI("%s(%s): the device negotiates coded buffers of %u bytes", __func__,
+          fourccToString(pixelFormat).c_str(), caps.codedBufferSize);
+
     return caps;
 }
 
+uint32_t V4L2Device::queryCodedBufferSize(uint32_t pixFmt) {
+    // A format that asks for no size gets the device's own size back: the driver raises the
+    // requested size of the coded plane to the largest packet it takes.
+    v4l2_format format;
+    memset(&format, 0, sizeof(format));
+    format.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    format.fmt.pix_mp.pixelformat = pixFmt;
+    format.fmt.pix_mp.num_planes = 1;
+    if (ioctl(VIDIOC_TRY_FMT, &format) != 0) return 0;
+    return format.fmt.pix_mp.plane_fmt[0].sizeimage;
+}
+
 // static
 SupportedCapabilities V4L2Device::queryEncodingCapabilities(VideoCodec codec) {
     SupportedCapabilities caps;
diff --git a/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h b/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h
