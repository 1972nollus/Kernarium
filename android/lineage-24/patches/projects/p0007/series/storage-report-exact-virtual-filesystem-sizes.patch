Subject: [PATCH] storage: report exact virtual filesystem sizes

Change-Id: I71084985d09716f44e043dffc6e595f083bbff97
---
 .../android/os/storage/StorageManager.java    | 20 ++++++--
 core/tests/andariumstorage/Android.bp         | 13 +++++
 .../tests/andariumstorage/AndroidManifest.xml |  8 +++
 .../StorageAccountingTest.java                | 49 +++++++++++++++++++
 4 files changed, 85 insertions(+), 5 deletions(-)
 create mode 100644 core/tests/andariumstorage/Android.bp
 create mode 100644 core/tests/andariumstorage/AndroidManifest.xml
 create mode 100644 core/tests/andariumstorage/src/com/android/frameworks/andariumstorage/StorageAccountingTest.java

diff --git a/core/java/android/os/storage/StorageManager.java b/core/java/android/os/storage/StorageManager.java
index 81fb975984d8bb5b1afbabfb72cb4075fb368179..37faebd388c4de6a92519e2b7d562dcab56e4f59 100644
--- a/core/java/android/os/storage/StorageManager.java
+++ b/core/java/android/os/storage/StorageManager.java
@@ -1394,15 +1394,25 @@ public class StorageManager {
 
     /** @hide */
     public static Pair<String, Long> getPrimaryStoragePathAndSize() {
-        return Pair.create(null,
-                FileUtils.roundStorageSize(Environment.getDataDirectory().getTotalSpace()
-                        + Environment.getRootDirectory().getTotalSpace()));
+        return Pair.create(null, getPrimaryStorageSizeBytes());
     }
 
     /** @hide */
     public long getPrimaryStorageSize() {
-        return FileUtils.roundStorageSize(Environment.getDataDirectory().getTotalSpace()
-                + Environment.getRootDirectory().getTotalSpace());
+        return getPrimaryStorageSizeBytes();
+    }
+
+    private static long getPrimaryStorageSizeBytes() {
+        // Andarium's data and five read-only OS filesystems are separate
+        // virtual partitions. Retail media rounding can report less than
+        // /data contains, making Settings' System category negative, or
+        // inflate the total to the next advertised capacity.
+        return Environment.getDataDirectory().getTotalSpace()
+                + Environment.getRootDirectory().getTotalSpace()
+                + Environment.getSystemExtDirectory().getTotalSpace()
+                + Environment.getProductDirectory().getTotalSpace()
+                + Environment.getVendorDirectory().getTotalSpace()
+                + Environment.getOdmDirectory().getTotalSpace();
     }
 
     /** @hide */
