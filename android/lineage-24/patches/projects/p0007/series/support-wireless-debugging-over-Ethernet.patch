+package com.android.server.adb;
+
+import android.content.Context;
+import android.net.ConnectivityManager;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.net.NetworkRequest;
+import android.os.Handler;
+import android.util.Slog;
+import androidx.annotation.NonNull;
+import com.android.server.adb.AdbDebuggingManager.AdbDebuggingHandler;
+
+/** Monitors the Ethernet transport used for wireless debugging on Ethernet-only devices. */
+public class AdbEthernetNetworkMonitor extends ConnectivityManager.NetworkCallback
+    implements AdbNetworkMonitor {
+
+  private static final String TAG = AdbEthernetNetworkMonitor.class.getSimpleName();
+
+  private final Context mContext;
+  private final Handler mAdbDebuggingHandler;
+  private boolean mStarted;
+  private Network mNetwork;
+
+  AdbEthernetNetworkMonitor(@NonNull Context context, @NonNull Handler adbDebuggingHandler) {
+    mContext = context;
+    mAdbDebuggingHandler = adbDebuggingHandler;
+    register();
+  }
+
+  @Override
+  public final void register() {
+    if (mStarted) {
+      return;
+    }
+    ConnectivityManager connectivityManager = mContext.getSystemService(ConnectivityManager.class);
+    NetworkRequest request =
+        new NetworkRequest.Builder()
+            .addTransportType(NetworkCapabilities.TRANSPORT_ETHERNET)
+            .addCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+            .build();
+    connectivityManager.registerNetworkCallback(request, this);
+    mStarted = true;
+  }
+
+  @Override
+  public final void unregister() {
+    if (!mStarted) {
+      return;
+    }
+    ConnectivityManager connectivityManager = mContext.getSystemService(ConnectivityManager.class);
+    connectivityManager.unregisterNetworkCallback(this);
+    mStarted = false;
+    mNetwork = null;
+  }
+
+  @Override
+  public final void onAvailable(@NonNull Network network) {
+    if (network.equals(mNetwork)) {
+      return;
+    }
+    mNetwork = network;
+    mAdbDebuggingHandler.sendEmptyMessage(AdbDebuggingHandler.MSG_START_TLS_SERVICE);
+    Slog.i(TAG, "Ethernet network available. Attempting to start wireless debugging.");
+  }
+
+  @Override
+  public final void onLost(@NonNull Network network) {
+    if (!network.equals(mNetwork)) {
+      return;
+    }
+    mNetwork = null;
+    mAdbDebuggingHandler.sendEmptyMessage(AdbDebuggingHandler.MSG_STOP_TLS_SERVICE);
+    Slog.i(TAG, "Ethernet network lost. Stopping wireless debugging.");
+  }
+}
