+        private AdbConnectionInfo getCurrentEthernetInfo() {
+            ConnectivityManager connectivityManager =
+                    mContext.getSystemService(ConnectivityManager.class);
+            if (connectivityManager == null) {
+                Slog.i(TAG, "Connectivity service unavailable. Not enabling wireless debugging.");
+                return null;
+            }
+
+            Network network = connectivityManager.getActiveNetwork();
+            NetworkCapabilities capabilities =
+                    network == null ? null : connectivityManager.getNetworkCapabilities(network);
+            if (capabilities == null
+                    || !capabilities.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)) {
+                Slog.i(TAG, "Not connected to an Ethernet network. Not enabling wireless debugging.");
+                return null;
+            }
+
+            LinkProperties linkProperties = connectivityManager.getLinkProperties(network);
+            String interfaceName =
+                    linkProperties == null ? null : linkProperties.getInterfaceName();
+            if (TextUtils.isEmpty(interfaceName)) {
+                Slog.e(TAG, "Unable to identify the Ethernet interface.");
+                return null;
+            }
+
+            String networkName = "Ethernet (" + interfaceName + ")";
+            return new AdbConnectionInfo("ethernet:" + interfaceName, networkName);
+        }
