+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.net.NetworkRequest;
+import android.os.Handler;
+import android.os.Message;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+import org.mockito.ArgumentCaptor;
+import org.mockito.Captor;
+import org.mockito.Mock;
+import org.mockito.Mockito;
+import org.mockito.junit.MockitoJUnit;
+import org.mockito.junit.MockitoRule;
+
+@RunWith(JUnit4.class)
+public final class AdbEthernetNetworkMonitorTest {
+
+  @Rule public final MockitoRule mocks = MockitoJUnit.rule();
+
+  @Mock private ConnectivityManager mConnectivityManager;
+  @Mock private Network mNetwork;
+  @Mock private Network mOtherNetwork;
+  @Mock private Context mContext;
+  @Mock private Handler mAdbDebuggingHandler;
+
+  @Captor private ArgumentCaptor<NetworkRequest> mNetworkRequestCaptor;
+  @Captor private ArgumentCaptor<Message> mHandlerMessageCaptor;
+
+  private AdbEthernetNetworkMonitor mMonitor;
+
+  @Before
+  public void setUp() {
+    when(mContext.getSystemServiceName(ConnectivityManager.class))
+        .thenReturn(Context.CONNECTIVITY_SERVICE);
+    when(mContext.getSystemService(Context.CONNECTIVITY_SERVICE)).thenReturn(mConnectivityManager);
+
+    mMonitor = Mockito.spy(new AdbEthernetNetworkMonitor(mContext, mAdbDebuggingHandler));
+
+    verify(mConnectivityManager)
+        .registerNetworkCallback(
+            mNetworkRequestCaptor.capture(), any(ConnectivityManager.NetworkCallback.class));
+  }
+
+  @Test
+  public void registerNetworkCallback_onlyConsidersEthernetWithInternet() {
+    NetworkRequest request = mNetworkRequestCaptor.getValue();
+    assertArrayEquals(
+        new int[] {NetworkCapabilities.TRANSPORT_ETHERNET}, request.getTransportTypes());
+    assertTrue(request.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET));
+  }
+
+  @Test
+  public void onAvailable_startsWirelessDebuggingOnce() {
+    mMonitor.onAvailable(mNetwork);
+    mMonitor.onAvailable(mNetwork);
+
+    verify(mAdbDebuggingHandler, times(1))
+        .sendMessageAtTime(mHandlerMessageCaptor.capture(), anyLong());
+    assertEquals(
+        AdbDebuggingManager.AdbDebuggingHandler.MSG_START_TLS_SERVICE,
+        mHandlerMessageCaptor.getValue().what);
+  }
+
+  @Test
+  public void onLost_activeNetwork_stopsWirelessDebugging() {
+    mMonitor.onAvailable(mNetwork);
+    mMonitor.onLost(mNetwork);
+
+    verify(mAdbDebuggingHandler, times(2))
+        .sendMessageAtTime(mHandlerMessageCaptor.capture(), anyLong());
+    assertEquals(
+        AdbDebuggingManager.AdbDebuggingHandler.MSG_STOP_TLS_SERVICE,
+        mHandlerMessageCaptor.getValue().what);
+  }
+
+  @Test
+  public void onLost_otherNetwork_isIgnored() {
+    mMonitor.onAvailable(mNetwork);
+    mMonitor.onLost(mOtherNetwork);
+
+    verify(mAdbDebuggingHandler, times(1))
+        .sendMessageAtTime(mHandlerMessageCaptor.capture(), anyLong());
+    assertEquals(
+        AdbDebuggingManager.AdbDebuggingHandler.MSG_START_TLS_SERVICE,
+        mHandlerMessageCaptor.getValue().what);
+  }
+
+  @Test
+  public void registerAndUnregister_areIdempotent() {
+    mMonitor.register();
+    mMonitor.unregister();
+    mMonitor.unregister();
+
+    verify(mConnectivityManager, times(1))
+        .registerNetworkCallback(
+            any(NetworkRequest.class), any(ConnectivityManager.NetworkCallback.class));
+    verify(mConnectivityManager, times(1))
+        .unregisterNetworkCallback(any(ConnectivityManager.NetworkCallback.class));
+  }
+}
