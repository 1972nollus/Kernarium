{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linux-um-darwin.invalid/android/aosp-17/release-manifest.schema.json",
  "title": "Android 17 ACK 6.18 16 KiB UML release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "directory_name",
    "product_family",
    "acceptance",
    "published_at_utc",
    "android",
    "aosp",
    "kernel",
    "outer",
    "producer",
    "inventory"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "directory_name": { "type": "string" },
    "product_family": { "const": "android-17-ack-6.18-16k" },
    "acceptance": { "const": "accepted" },
    "published_at_utc": { "type": "string" },
    "android": { "type": "object" },
    "aosp": { "type": "object" },
    "kernel": { "type": "object" },
    "outer": { "type": "object" },
    "producer": { "type": "object" },
    "inventory": { "type": "array" }
  }
}
