From ee87b5736f11a8612922752142844561ecdc6adc Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 03:00:35 +0000
Subject: [PATCH 2/4] UML-ANDROID-LOCAL: Mesa Venus take paired protocol
 headers from the tree

Meson refuses an absolute include directory inside the source tree, and the
Soong converter can only express an include directory that lives inside the
project. Let an empty -Dvenus-protocol-dir select the tree's own paired
headers, which this port replaces with the generated codec. A named build
directory keeps its existing meaning and its existing validation.
---
 src/virtio/vulkan/meson.build | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/virtio/vulkan/meson.build b/src/virtio/vulkan/meson.build
index 57604e32f1d873da882ee2f9ffd178ec69b580a2..44686d67c24858caee94886a10af8eb16cf0790d 100644
--- a/src/virtio/vulkan/meson.build
+++ b/src/virtio/vulkan/meson.build
@@ -93,13 +93,20 @@ libvn_files = files(
 )
 
 vn_protocol_dir = get_option('venus-protocol-dir')
-if not fs.is_absolute(vn_protocol_dir) or not fs.is_file(
+if vn_protocol_dir == ''
+  # A tree that already carries the paired generated headers, such as the
+  # Android port, selects them from their source directory instead of naming
+  # an out-of-tree generator build directory.
+  vn_protocol_inc = include_directories('../venus-protocol')
+elif not fs.is_absolute(vn_protocol_dir) or not fs.is_file(
     vn_protocol_dir / 'vn_protocol_driver.h')
   error('Virtio requires -Dvenus-protocol-dir pointing to the paired generated driver headers')
+else
+  vn_protocol_inc = include_directories(vn_protocol_dir)
 endif
 
 vn_incs = [
-  include_directories(vn_protocol_dir),
+  vn_protocol_inc,
   inc_include,
   inc_src,
   inc_virtio,
