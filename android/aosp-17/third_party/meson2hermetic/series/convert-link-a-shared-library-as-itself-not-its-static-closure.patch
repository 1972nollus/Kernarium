From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 26 Sep 2026 21:01:42 +0000
Subject: [PATCH] convert: link a shared library as itself, not its static
 closure

The converter took a build target's link dependencies from
get_all_linked_targets(). That walk continues through shared libraries,
so a target that links a shared library from the same project also
linked every static library the shared library was built from.

Mesa's EGL and GLES libraries link the Gallium DRI library. Converted,
they also linked the DRI library's whole static closure: the driver
libraries, whose descriptors only the DRI library provides, and their
liblog users. The libraries then failed to link.

Follow Meson's own rule for a link line (BuildTarget.get_dependencies):
walk only through static libraries, and link a shared library as
itself.
---
 .../instance/convert_instance_build_target.py | 34 +++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/mesonbuild/convert/instance/convert_instance_build_target.py b/mesonbuild/convert/instance/convert_instance_build_target.py
index 22072a20054aa5feed67442ca4f9e76f746c1a39..9753fce9b63610a60225e9917a8a96e6089a3ba1 100644
--- a/mesonbuild/convert/instance/convert_instance_build_target.py
+++ b/mesonbuild/convert/instance/convert_instance_build_target.py
@@ -5,7 +5,7 @@
 from __future__ import annotations
 import typing as T
 import os
-from collections import defaultdict
+from collections import defaultdict, deque
 from dataclasses import dataclass
 
 from mesonbuild import build
@@ -25,6 +25,36 @@ from mesonbuild.convert.convert_project_instance import ConvertProjectInstance
 from mesonbuild.convert.convert_project_config import ConvertProjectConfig
 
 
+def _linked_targets(build_target: build.BuildTarget) -> T.List[build.BuildTarget]:
+    """Every target a build target links: its own link targets, and those of
+    each static library among them, transitively.
+
+    A shared library is linked as itself. The static libraries it was built
+    from are already inside it, so its own link targets are not its
+    consumer's; following them would link a second copy of each into the
+    consumer. This is Meson's own rule for a link line (see
+    BuildTarget.get_dependencies), whereas get_all_linked_targets() also
+    walks through shared libraries.
+    """
+    result: T.List[build.BuildTarget] = []
+    stack: T.Deque[T.Any] = deque()
+    stack.extendleft(build_target.link_targets)
+    stack.extendleft(build_target.link_whole_targets)
+    while stack:
+        t = stack.pop()
+        if t in result:
+            continue
+        if isinstance(t, build.CustomTargetIndex):
+            stack.appendleft(t.target)
+            continue
+        if isinstance(t, build.BuildTarget):
+            result.append(t)
+            if not isinstance(t, build.SharedLibrary):
+                stack.extendleft(t.link_targets)
+                stack.extendleft(t.link_whole_targets)
+    return result
+
+
 class RustABI(Enum):
     RUST = 'rust'
     C = 'c'
@@ -259,7 +289,7 @@ class ConvertInstanceBuildTarget:
             if isinstance(target, build.BuildTarget):
                 self.whole_static_libs.append(ConvertId(sanitized_name, target.subdir))
 
-        for linked_target in build_target.get_all_linked_targets():
+        for linked_target in _linked_targets(build_target):
             if not isinstance(linked_target, build.BuildTarget):
                 continue
             dep_rust_abi = _determine_rust_abi(linked_target)
