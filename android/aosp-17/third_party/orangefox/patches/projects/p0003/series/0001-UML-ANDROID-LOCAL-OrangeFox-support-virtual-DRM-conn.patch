From 316db3f4d7c2286a8edf20e797f23c498ef3b420 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 27 Aug 2026 06:04:08 +0000
Subject: [PATCH] UML-ANDROID-LOCAL: OrangeFox support virtual DRM connectors

---
 minuitwrp/graphics_drm.cpp | 51 ++++++++++++++++++++++++++++++++++++--
 1 file changed, 49 insertions(+), 2 deletions(-)

diff --git a/minuitwrp/graphics_drm.cpp b/minuitwrp/graphics_drm.cpp
index 0cc80f5cb0c00368556174c35dac0dbfe54ec6f9..ae7770cfdc624ec3d6bc931ab54f0ff200434956 100644
--- a/minuitwrp/graphics_drm.cpp
+++ b/minuitwrp/graphics_drm.cpp
@@ -232,6 +232,7 @@ static drmModeConnector *main_monitor_connector;
 static int drm_fd = -1;
 
 static bool current_blank_state = true;
+static bool use_legacy_modeset = false;
 static int fb_prop_id;
 static struct Crtc crtc_res;
 static struct Connector conn_res;
@@ -590,6 +591,20 @@ static int drm_enable_crtc(drmModeAtomicReqPtr atomic_req) {
 }
 
 static void drm_blank(minui_backend* backend __unused, bool blank) {
+  if (use_legacy_modeset) {
+    uint32_t connector_id = main_monitor_connector->connector_id;
+    int ret = drmModeSetCrtc(
+        drm_fd, main_monitor_crtc->crtc_id,
+        blank ? 0 : drm_surfaces[current_buffer]->fb_id, 0, 0,
+        blank ? nullptr : &connector_id, blank ? 0 : 1,
+        blank ? nullptr : &main_monitor_crtc->mode);
+    if (ret == 0)
+      current_blank_state = blank;
+    else
+      printf("Legacy modeset failed, rc = %d\n", ret);
+    return;
+  }
+
   int ret = 0;
 
   if (blank == current_blank_state)
@@ -993,7 +1008,8 @@ static GRSurface* drm_init(minui_backend* backend __unused) {
     return nullptr;
   }
 
-  disable_non_main_crtcs(drm_fd, res, main_monitor_crtc);
+  if (main_monitor_connector->connector_type != DRM_MODE_CONNECTOR_VIRTUAL)
+    disable_non_main_crtcs(drm_fd, res, main_monitor_crtc);
 
   main_monitor_crtc->mode = main_monitor_connector->modes[selected_mode];
 
@@ -1038,6 +1054,27 @@ static GRSurface* drm_init(minui_backend* backend __unused) {
 
   current_buffer = 0;
 
+  if (main_monitor_connector->connector_type == DRM_MODE_CONNECTOR_VIRTUAL) {
+    uint32_t connector_id = main_monitor_connector->connector_id;
+    int ret = drmModeSetCrtc(
+        drm_fd, main_monitor_crtc->crtc_id, drm_surfaces[0]->fb_id, 0, 0,
+        &connector_id, 1, &main_monitor_crtc->mode);
+    if (ret != 0) {
+      printf("Initial legacy modeset failed, rc = %d\n", ret);
+      free(draw_buf->data);
+      free(draw_buf);
+      draw_buf = nullptr;
+      drm_destroy_surface(drm_surfaces[0]);
+      drm_destroy_surface(drm_surfaces[1]);
+      close(drm_fd);
+      drm_fd = -1;
+      return nullptr;
+    }
+    use_legacy_modeset = true;
+    current_blank_state = false;
+    return draw_buf;
+  }
+
   drmSetClientCap(drm_fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1);
   drmSetClientCap(drm_fd, DRM_CLIENT_CAP_ATOMIC, 1);
 
@@ -1149,7 +1186,17 @@ static GRSurface* drm_init(minui_backend* backend __unused) {
 static GRSurface* drm_flip(minui_backend* backend __unused) {
     memcpy(drm_surfaces[current_buffer]->base.data,
             draw_buf->data, draw_buf->height * draw_buf->row_bytes);
-    update_plane_fb();
+    if (use_legacy_modeset) {
+      uint32_t connector_id = main_monitor_connector->connector_id;
+      int ret = drmModeSetCrtc(
+          drm_fd, main_monitor_crtc->crtc_id,
+          drm_surfaces[current_buffer]->fb_id, 0, 0, &connector_id, 1,
+          &main_monitor_crtc->mode);
+      if (ret != 0)
+        printf("Legacy page flip failed, rc = %d\n", ret);
+    } else {
+      update_plane_fb();
+    }
     current_buffer = 1 - current_buffer;
     return draw_buf;
 }
