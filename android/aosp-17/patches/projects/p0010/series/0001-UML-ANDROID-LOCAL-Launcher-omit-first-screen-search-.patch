From 0cf087c2f2a5207a46bfda777ebde3f962b57a07 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 26 Aug 2026 08:21:46 +0000
Subject: [PATCH 1/2] UML-ANDROID-LOCAL: Launcher omit first-screen search
 surface

This product omits QuickSearchBox. Build Launcher without
QSB_ON_FIRST_SCREEN, and give the hotseat an empty, hidden placeholder with
the search container's id instead of inflating a search bar nothing serves.

Change-Id: I9eb5cd22ddf7011a62f0180db0acde641ac74cce
---
 Android.bp                                        | 2 +-
 src/com/android/launcher3/qsb/QsbWidgetFactory.kt | 7 +++++++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/Android.bp b/Android.bp
index 46d199d1cac93405df1cdb70928b1f82c46212d2..98bbe04e9412c91d9ca2a6eb6d79a4a643cec655 100644
--- a/Android.bp
+++ b/Android.bp
@@ -179,7 +179,7 @@ genrule {
     tools: [
         "launcher-build-config-tool",
     ],
-    cmd: " $(location launcher-build-config-tool) > $(out)",
+    cmd: " $(location launcher-build-config-tool) -d QSB_ON_FIRST_SCREEN > $(out)",
     out: ["BuildConfig.java"],
 }
 
diff --git a/src/com/android/launcher3/qsb/QsbWidgetFactory.kt b/src/com/android/launcher3/qsb/QsbWidgetFactory.kt
index 1137dd255fbffc926c3b87cbbad8b9de3190648f..a0cd3358ebacd996e9279cf70aafaffd5685b8a8 100644
--- a/src/com/android/launcher3/qsb/QsbWidgetFactory.kt
+++ b/src/com/android/launcher3/qsb/QsbWidgetFactory.kt
@@ -19,6 +19,7 @@ package com.android.launcher3.qsb
 import android.view.LayoutInflater
 import android.view.View
 import android.view.ViewGroup
+import com.android.launcher3.BuildConfig
 import com.android.launcher3.R
 import javax.inject.Inject
 
@@ -26,6 +27,12 @@ import javax.inject.Inject
 open class QsbWidgetFactory @Inject constructor() {
 
     open fun createView(container: ViewGroup): View {
+        if (!BuildConfig.QSB_ON_FIRST_SCREEN) {
+            return View(container.context).apply {
+                id = R.id.search_container_hotseat
+                visibility = View.GONE
+            }
+        }
         return LayoutInflater.from(container.context)
             .inflate(R.layout.qsb_container_hotseat, container, false)
     }
