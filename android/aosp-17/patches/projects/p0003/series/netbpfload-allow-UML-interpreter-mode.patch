From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 21 Aug 2026 01:18:01 +0000
Subject: [PATCH] netbpfload: allow UML interpreter mode

---
 bpf/loader/NetBpfLoad.cpp | 49 ++++++++++++++++++++++++++++-----------
 1 file changed, 35 insertions(+), 14 deletions(-)

diff --git a/bpf/loader/NetBpfLoad.cpp b/bpf/loader/NetBpfLoad.cpp
index 7ba3247dcc6f31ab9b612d410202067c821ab58a..33c17c50786a232a59f7ee39241ba94ef3fbea10 100644
--- a/bpf/loader/NetBpfLoad.cpp
+++ b/bpf/loader/NetBpfLoad.cpp
@@ -976,6 +976,10 @@ static int pinProg(const borrowed_fd& fd, const struct bpf_prog_def& progDef) {
     return 0;
 }
 
+static bool useUmlBpfInterpreter() {
+    return GetProperty("ro.boot.uml_bpf_interpreter", "0") == "1";
+}
+
 static int validateProg(const borrowed_fd& fd, const char* const progPinLoc) {
     if (!isAtLeastKernelVersion(4, 14)) {
         return 0;
@@ -1002,7 +1006,8 @@ static int validateProg(const borrowed_fd& fd, const char* const progPinLoc) {
     }
     if (!isUser) ALOGD("prog %s id %d len jit:%d xlat:%d", progPinLoc, progId, jitLen, xlatLen);
 
-    if (!jitLen && api_level_full >= NETBPFLOAD_25Q2_VER) {
+    const bool umlInterpreter = useUmlBpfInterpreter();
+    if (!jitLen && api_level_full >= NETBPFLOAD_25Q2_VER && !umlInterpreter) {
         ALOGE("Kernel eBPF JIT failure for %s", progPinLoc);
         return -ENOTSUP;
     }
@@ -1351,7 +1356,11 @@ static bool loadObject(const char* const progPath, const bool useLibbpf = true)
 static bool loadAllObjects() {
     // Enable on kernels that have the BPF CFI backports, see: b/488034908
     // b/494690861: funcs may trigger Real-time Kernel Protection (RKP)
-    bool funcs = isAtLeast26Q2 && isAtLeastKernelVersion(6, 6, 118);
+    const bool umlInterpreter = useUmlBpfInterpreter();
+    bool funcs = isAtLeast26Q2 && isAtLeastKernelVersion(6, 6, 118) && !umlInterpreter;
+    if (umlInterpreter) {
+        ALOGW("UML BPF interpreter cannot execute callbacks; using inline BPF objects.");
+    }
 
     if (!loadObject(BPFROOT "offload.o", /*libbpf*/false)) return false;
     if (!loadObject(BPFROOT "test.o")) return false;
@@ -1748,18 +1757,30 @@ static int doLoad(char** argv, char * const envp[]) {
         // on Android T and earlier versions they're written from the 'load_bpf_programs'
         // trigger (ie. by init itself) instead.
 
-        // Enable the eBPF JIT -- but do note that on 64-bit kernels it is likely
-        // already force enabled by the kernel config option BPF_JIT_ALWAYS_ON.
-        // (Note: this (open) will fail with ENOENT 'No such file or directory' if
-        //  kernel does not have CONFIG_BPF_JIT=y)
-        // BPF_JIT is required by R VINTF (which means 4.14/4.19/5.4 kernels),
-        // but 4.14/4.19 were released with P & Q, and only 5.4 is new in R+.
-        if (!writeFile("/proc/sys/net/core/bpf_jit_enable", "1\n")) return 24;
-
-        // Enable JIT kallsyms export for privileged users only
-        // (Note: this (open) will fail with ENOENT 'No such file or directory' if
-        //  kernel does not have CONFIG_HAVE_EBPF_JIT=y)
-        if (!writeFile("/proc/sys/net/core/bpf_jit_kallsyms", "1\n")) return 25;
+        static constexpr char kBpfJitEnable[] = "/proc/sys/net/core/bpf_jit_enable";
+        static constexpr char kBpfJitKallsyms[] = "/proc/sys/net/core/bpf_jit_kallsyms";
+        const bool umlInterpreter = useUmlBpfInterpreter();
+
+        if (!exists(kBpfJitEnable) && umlInterpreter) {
+            if (exists(kBpfJitKallsyms)) {
+                ALOGE("Kernel exposes BPF JIT kallsyms without the JIT enable sysctl.");
+                return 25;
+            }
+            ALOGW("UML kernel has no eBPF JIT; using its built-in interpreter.");
+        } else {
+            // Enable the eBPF JIT -- but do note that on 64-bit kernels it is likely
+            // already force enabled by the kernel config option BPF_JIT_ALWAYS_ON.
+            // (Note: this (open) will fail with ENOENT 'No such file or directory' if
+            //  kernel does not have CONFIG_BPF_JIT=y)
+            // BPF_JIT is required by R VINTF (which means 4.14/4.19/5.4 kernels),
+            // but 4.14/4.19 were released with P & Q, and only 5.4 is new in R+.
+            if (!writeFile(kBpfJitEnable, "1\n")) return 24;
+
+            // Enable JIT kallsyms export for privileged users only
+            // (Note: this (open) will fail with ENOENT 'No such file or directory' if
+            //  kernel does not have CONFIG_HAVE_EBPF_JIT=y)
+            if (!writeFile(kBpfJitKallsyms, "1\n")) return 25;
+        }
     }
 
     // Create all the pin subdirectories
