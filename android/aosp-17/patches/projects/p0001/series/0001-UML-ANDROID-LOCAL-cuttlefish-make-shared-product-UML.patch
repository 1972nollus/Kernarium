From 56c11fbb07be34003657b4107cd0e01dbf8afc46 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 26 Aug 2026 23:23:09 +0000
Subject: [PATCH 1/3] UML-ANDROID-LOCAL: cuttlefish make shared product
 UML-configurable

Keep built-in-kernel, static-storage, nonsecure-security, and optional-HAL selection in one final-state product configuration topic.

Change-Id: Ib5adf782e74ba808e027c475b021d55cd4d67e0a
---
 shared/config/Android.bp        | 28 +++++++++++++++++
 shared/desktop/common.mk        |  2 ++
 shared/device.mk                | 55 +++++++++++++++++++++++++++++----
 shared/phone/device_vendor.mk   |  6 ++++
 shared/sensors/device_vendor.mk |  5 +++
 5 files changed, 90 insertions(+), 6 deletions(-)

diff --git a/shared/config/Android.bp b/shared/config/Android.bp
index 730495feaab680b5c16ed8f99db9c87172ae75a8..f98204452cfc61aed24fdefbc83e6b14ac251961 100644
--- a/shared/config/Android.bp
+++ b/shared/config/Android.bp
@@ -98,12 +98,14 @@ genrule {
 
 prebuilt_etc {
     name: "fstab.cf.f2fs.hctr2",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     src: ":gen_fstab_cf_f2fs_hctr2",
     vendor: true,
 }
 
 prebuilt_etc {
     name: "fstab.cf.f2fs.hctr2.vendor_ramdisk",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     srcs: [
         ":gen_fstab_cf_f2fs_hctr2",
     ],
@@ -115,12 +117,14 @@ prebuilt_etc {
 
 prebuilt_etc {
     name: "fstab.cf.f2fs.cts",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     src: ":gen_fstab_cf_f2fs_cts",
     vendor: true,
 }
 
 prebuilt_etc {
     name: "fstab.cf.f2fs.cts.vendor_ramdisk",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     srcs: [
         ":gen_fstab_cf_f2fs_cts",
     ],
@@ -132,12 +136,14 @@ prebuilt_etc {
 
 prebuilt_etc {
     name: "fstab.cf.ext4.hctr2",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     src: ":gen_fstab_cf_ext4_hctr2",
     vendor: true,
 }
 
 prebuilt_etc {
     name: "fstab.cf.ext4.hctr2.vendor_ramdisk",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     srcs: [
         ":gen_fstab_cf_ext4_hctr2",
     ],
@@ -149,12 +155,14 @@ prebuilt_etc {
 
 prebuilt_etc {
     name: "fstab.cf.ext4.cts",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     src: ":gen_fstab_cf_ext4_cts",
     vendor: true,
 }
 
 prebuilt_etc {
     name: "fstab.cf.ext4.cts.vendor_ramdisk",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     srcs: [
         ":gen_fstab_cf_ext4_cts",
     ],
@@ -196,6 +204,14 @@ prebuilt_defaults {
     }),
 }
 
+prebuilt_defaults {
+    name: "cuttlefish_config_not_builtin_kernel_defaults",
+    enabled: select(soong_config_variable("cuttlefish_config", "use_builtin_kernel"), {
+        true: false,
+        default: unset,
+    }),
+}
+
 prebuilt_etc {
     name: "device_google_cuttlefish_shared_config_init_vendor_rc",
     defaults: ["cuttlefish_config_general_files_defaults"],
@@ -203,6 +219,10 @@ prebuilt_etc {
     dsts: ["init.cutf_cvm.rc"],
     vendor: true,
     relative_install_path: "init",
+    enabled: select(soong_config_variable("cuttlefish_config", "use_builtin_kernel"), {
+        true: false,
+        default: unset,
+    }),
 }
 
 prebuilt_etc {
@@ -263,6 +283,10 @@ prebuilt_etc {
     ],
     relative_install_path: "init",
     vendor: true,
+    enabled: select(soong_config_variable("cuttlefish_config", "use_builtin_kernel"), {
+        true: false,
+        default: unset,
+    }),
 }
 
 prebuilt_etc {
@@ -272,6 +296,10 @@ prebuilt_etc {
         "ueventd.rc",
     ],
     vendor: true,
+    enabled: select(soong_config_variable("cuttlefish_config", "use_builtin_kernel"), {
+        true: false,
+        default: unset,
+    }),
 }
 
 prebuilt_etc {
diff --git a/shared/desktop/common.mk b/shared/desktop/common.mk
index 4649cff34e2e1f0a5346503de9d27c62230be6b4..8cb4085e2eb1d07c9641358a7af013f1d209bec1 100644
--- a/shared/desktop/common.mk
+++ b/shared/desktop/common.mk
@@ -32,11 +32,13 @@ $(call inherit-product, $(SRC_TARGET_DIR)/product/core_minimal.mk)
 $(call inherit-product-if-exists, frameworks/base/data/sounds/AllAudio.mk)
 
 # Dynamic partitions support
+ifneq ($(UML_ANDROID_STATIC_STORAGE),true)
 PRODUCT_USE_DYNAMIC_PARTITIONS := true
 
 $(call inherit-product, $(SRC_TARGET_DIR)/product/virtual_ab_ota/android_t_baseline.mk)
 # Compression for virtual AB partitions
 PRODUCT_VIRTUAL_AB_COMPRESSION_METHOD := lz4
+endif
 
 # init_dev_config service to initialize device configuration and APEX
 # selection properties
diff --git a/shared/device.mk b/shared/device.mk
index ae0341029f76b4c2ca550f000f65fe2f5bf81ee4..b173afba75dc3b61e0192970202e083a0c362ca6 100644
--- a/shared/device.mk
+++ b/shared/device.mk
@@ -53,6 +53,7 @@ endif
 PRODUCT_SYSTEM_EXT_PROPERTIES += bluetooth.hci.timeout_milliseconds=5000
 
 # Enable Virtual A/B
+ifneq ($(UML_ANDROID_STATIC_STORAGE),true)
 $(call inherit-product, $(SRC_TARGET_DIR)/product/virtual_ab_ota/vabc_features.mk)
 PRODUCT_VIRTUAL_AB_COMPRESSION_METHOD := lz4
 PRODUCT_VIRTUAL_AB_COW_VERSION := 3
@@ -62,9 +63,17 @@ PRODUCT_VENDOR_PROPERTIES += ro.virtual_ab.compression.threads=true
 PRODUCT_VENDOR_PROPERTIES += ro.virtual_ab.batch_writes=true
 # Opt in for ublk based OTA for testing
 PRODUCT_VENDOR_PROPERTIES += ro.virtual_ab.ublk.enabled=true
+endif
 
 # Enable Scoped Storage related
+ifeq ($(UML_ANDROID_DISABLE_PROJECT_QUOTAS),true)
+PRODUCT_FS_CASEFOLD := 1
+PRODUCT_VENDOR_PROPERTIES += \
+    external_storage.casefold.enabled=1 \
+    external_storage.sdcardfs.enabled=0
+else
 $(call inherit-product, $(SRC_TARGET_DIR)/product/emulated_storage.mk)
+endif
 
 # Properties that are not vendor-specific. These will go in the product
 # partition, instead of the vendor partition, and do not need vendor
@@ -122,6 +131,7 @@ PRODUCT_VENDOR_PROPERTIES += \
 PRODUCT_VENDOR_PROPERTIES += ro.control_privapp_permissions?=enforce
 
 # Copy preopted files from system_b on first boot
+ifneq ($(UML_ANDROID_STATIC_STORAGE),true)
 PRODUCT_VENDOR_PROPERTIES += ro.cp_system_other_odex=1
 
 AB_OTA_POSTINSTALL_CONFIG += \
@@ -138,8 +148,11 @@ AB_OTA_POSTINSTALL_CONFIG += \
 
 # Userdata Checkpointing OTA GC
 PRODUCT_PACKAGES += \
-    checkpoint_gc \
-    vkms_controller \
+    checkpoint_gc
+endif
+
+PRODUCT_PACKAGES += \
+    vkms_controller
 
 # DRM service opt-in
 PRODUCT_VENDOR_PROPERTIES += drm.service.enabled=true
@@ -227,14 +240,19 @@ PRODUCT_CHECK_PREBUILT_MAX_PAGE_SIZE := true
 #
 
 $(call soong_config_set_bool,cuttlefish_config,use_general_files,true)
+ifeq ($(UML_ANDROID_BUILTIN_KERNEL),true)
+$(call soong_config_set_bool,cuttlefish_config,use_builtin_kernel,true)
+else
 PRODUCT_PACKAGES += \
     device_google_cuttlefish_shared_config_init_vendor_rc \
+    device_google_cuttlefish_shared_config_seriallogging_rc \
+    device_google_cuttlefish_shared_config_ueventd_rc
+endif
+PRODUCT_PACKAGES += \
     device_google_cuttlefish_shared_config_init_product_rc \
     device_google_cuttlefish_shared_config_media_codecs \
     device_google_cuttlefish_shared_config_media_profiles \
     device_google_cuttlefish_shared_config_media_profiles_vendor \
-    device_google_cuttlefish_shared_config_seriallogging_rc \
-    device_google_cuttlefish_shared_config_ueventd_rc \
     device_google_cuttlefish_shared_default_permissions_cuttlefish \
     device_google_cuttlefish_shared_privapp_permissions_cuttlefish
 
@@ -261,6 +279,7 @@ endif
 #
 PRODUCT_PACKAGES += com.google.cf.input.config
 
+ifneq ($(UML_ANDROID_STATIC_STORAGE),true)
 PRODUCT_PACKAGES += \
     fstab.cf.f2fs.hctr2 \
     fstab.cf.f2fs.hctr2.vendor_ramdisk \
@@ -269,7 +288,8 @@ PRODUCT_PACKAGES += \
     fstab.cf.ext4.hctr2 \
     fstab.cf.ext4.hctr2.vendor_ramdisk \
     fstab.cf.ext4.cts \
-    fstab.cf.ext4.cts.vendor_ramdisk \
+    fstab.cf.ext4.cts.vendor_ramdisk
+endif
 
 # Packages for HAL implementations
 
@@ -370,10 +390,17 @@ PRODUCT_PACKAGES += $(LOCAL_DUMPSTATE_PRODUCT_PACKAGE)
 #
 # Gatekeeper
 #
+ifeq ($(UML_ANDROID_SECURITY_HALS),nonsecure)
+PRODUCT_PACKAGES += \
+  com.android.hardware.gatekeeper.nonsecure \
+
+else
 PRODUCT_PACKAGES += \
   com.android.hardware.gatekeeper.cf_remote \
   com.android.hardware.gatekeeper.nonsecure \
 
+endif
+
 #
 # Oemlock
 #
@@ -434,11 +461,18 @@ endif
 #
 # KeyMint HAL
 #
+ifeq ($(UML_ANDROID_SECURITY_HALS),nonsecure)
+PRODUCT_PACKAGES += \
+	com.android.hardware.keymint.rust_nonsecure \
+
+else
 PRODUCT_PACKAGES += \
 	com.android.hardware.keymint.rust_cf_remote \
 	com.android.hardware.keymint.rust_nonsecure \
 	com.android.hardware.keymint.rust_cf_guest_trusty_nonsecure \
 
+endif
+
 # Indicate that KeyMint includes support for the ATTEST_KEY key purpose.
 PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.keystore.app_attest_key.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.keystore.app_attest_key.xml
@@ -478,6 +512,8 @@ PRODUCT_PACKAGES += $(LOCAL_THERMAL_HAL_PRODUCT_PACKAGE)
 #
 # NeuralNetworks HAL
 #
+LOCAL_ENABLE_NEURALNETWORKS ?= true
+ifeq ($(LOCAL_ENABLE_NEURALNETWORKS),true)
 PRODUCT_PACKAGES += \
     com.android.hardware.neuralnetworks
 
@@ -492,15 +528,18 @@ ifeq ($(RELEASE_AIDL_USE_UNFROZEN),true)
     PRODUCT_COPY_FILES += \
         frameworks/native/data/etc/android.hardware.npu.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.npu.xml
 endif
+endif
 
 # USB
 PRODUCT_PACKAGES += \
     com.android.hardware.usb
 
 # BootControl HAL
+ifneq ($(UML_ANDROID_STATIC_STORAGE),true)
 PRODUCT_PACKAGES += \
     com.android.hardware.boot \
     android.hardware.boot-service.default_recovery
+endif
 
 
 # Memtrack HAL
@@ -520,8 +559,10 @@ PRODUCT_COPY_FILES += \
     device/google/cuttlefish/shared/config/cgroups.json:$(TARGET_COPY_OUT_RECOVERY)/root/vendor/etc/cgroups.json \
     device/google/cuttlefish/shared/config/ueventd.rc:$(TARGET_COPY_OUT_RECOVERY)/root/ueventd.cutf_cvm.rc \
 
+ifneq ($(UML_ANDROID_STATIC_STORAGE),true)
 PRODUCT_PACKAGES += \
     update_engine_sideload
+endif
 
 endif
 
@@ -580,9 +621,11 @@ PRODUCT_SYSTEM_EXT_PROPERTIES += \
 # Start fingerprint virtual HAL process
 PRODUCT_VENDOR_PROPERTIES += ro.vendor.fingerprint_virtual_hal_start=true
 
-# Vendor Dlkm Locader
+# Vendor DLKM loader
+ifneq ($(UML_ANDROID_BUILTIN_KERNEL),true)
 PRODUCT_PACKAGES += \
    dlkm_loader
+endif
 
 # CAS AIDL HAL
 PRODUCT_PACKAGES += \
diff --git a/shared/phone/device_vendor.mk b/shared/phone/device_vendor.mk
index 354c49e7de1f7eca559fa77c973a328390d73fec..fdbc727046b29b819223ac950058bbb9a529819a 100644
--- a/shared/phone/device_vendor.mk
+++ b/shared/phone/device_vendor.mk
@@ -69,14 +69,20 @@ PRODUCT_PACKAGES += \
     android.hardware.motioncontext-service.default
 
 # NFC AIDL HAL
+LOCAL_ENABLE_NFC ?= true
+ifeq ($(LOCAL_ENABLE_NFC),true)
 PRODUCT_PACKAGES += \
     com.google.cf.nfc
+endif
 
 TARGET_BOARD_INFO_FILE ?= device/google/cuttlefish/shared/phone/android-info.txt
 
 # Storage: for factory reset protection feature
+LOCAL_ENABLE_FRP ?= true
+ifeq ($(LOCAL_ENABLE_FRP),true)
 PRODUCT_VENDOR_PROPERTIES += \
     ro.frp.pst=/dev/block/by-name/frp
+endif
 
 # Cuttlefish doesn't support protected VMs, run AppSearch in non-protected mode
 PRODUCT_PRODUCT_PROPERTIES += ro.appsearch.feature.enable_isolated_storage=true
diff --git a/shared/sensors/device_vendor.mk b/shared/sensors/device_vendor.mk
index f4e4bf1b35edaf25a929cbf19465c29ec34f7a0f..afaa4cd4eba97be5ca743fd40af7a6f0b08958c9 100644
--- a/shared/sensors/device_vendor.mk
+++ b/shared/sensors/device_vendor.mk
@@ -13,6 +13,9 @@
 # See the License for the specific language governing permissions and
 # limitations under the License.
 #
+LOCAL_ENABLE_SENSORS ?= true
+ifeq ($(LOCAL_ENABLE_SENSORS),true)
+
 
 # set LOCAL_SENSOR_FILE_OVERRIDES := true if a device has a custom list of sensors. Otherwise
 # install the default set like below
@@ -43,3 +46,5 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_PACKAGES += \
     cuttlefish_sensor_injection
+
+endif
