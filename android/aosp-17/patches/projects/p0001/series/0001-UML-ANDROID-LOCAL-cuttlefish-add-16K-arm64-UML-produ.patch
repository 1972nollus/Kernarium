+
+# Start with Cuttlefish's 64-bit-only page-agnostic board contract. The UML
+# product owns a distinct device directory so later UBD, ramdisk, VINTF, and
+# HAL changes do not alter any Cuttlefish product.
+include device/google/cuttlefish/vsoc_arm64_pgagnostic/BoardConfig.mk
+
+# This product has one fixed 16 KiB kernel rather than Cuttlefish's optional
+# alternate developer kernel image.
+BOARD_KERNEL_PATH_16K :=
+BOARD_KERNEL_MODULES_16K :=
diff --git a/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk b/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
new file mode 100644
index 0000000000000000000000000000000000000000..95e554c511efd66f959c9337f007e19bbdb8793a
--- /dev/null
+++ b/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
@@ -0,0 +1,46 @@
+#
+# Copyright 2026 The Android Open Source Project
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#      http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+#
+
+# Use the maintained AOSP page-agnostic arm64 product as the initial Android
+# userspace composition. UML-specific storage, init, VINTF, and HAL ownership
+# is added in this device directory without changing Cuttlefish products.
+$(call inherit-product, device/google/cuttlefish/vsoc_arm64_pgagnostic/phone/aosp_cf.mk)
+
+PRODUCT_NAME := aosp_uml_arm64_pgagnostic
+PRODUCT_DEVICE := vsoc_uml_arm64_pgagnostic
+PRODUCT_BRAND := Android
+PRODUCT_MANUFACTURER := Kernarium
+PRODUCT_MODEL := Android 17 on Darwin UML
+
+# The guest is arm64-only and page-size agnostic in userspace, but the only
+# kernel and runtime product that may consume it uses 16 KiB pages.
+PRODUCT_MAX_PAGE_SIZE_SUPPORTED := 16384
+PRODUCT_NO_BIONIC_PAGE_SIZE_MACRO := true
+PRODUCT_CHECK_PREBUILT_MAX_PAGE_SIZE := true
+TARGET_BOOTS_16K := true
+PRODUCT_16K_DEVELOPER_OPTION := false
+
+# ACK 6.18 supplies memfd-backed ashmem compatibility for legacy clients and
+# the Android 17 memfd SELinux class for new clients. Prefer that path from the
+# first product build.
+PRODUCT_PRODUCT_PROPERTIES += sys.use_memfd=true
+
+PRODUCT_VENDOR_PROPERTIES += \
+    ro.soc.manufacturer=$(PRODUCT_MANUFACTURER) \
+    ro.soc.model=$(PRODUCT_DEVICE)
+
+# Keep Android.mk ignored exactly as in the source page-agnostic product.
+PRODUCT_IGNORE_ALL_ANDROIDMK := true
