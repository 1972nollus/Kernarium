From c8950c7d54f953bb9552b5b0bc38bf1f4282ac85 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 17:20:26 +0000
Subject: [PATCH 04/10] UML-ANDROID-LOCAL: cuttlefish: scope nonsecure security
 packages

Change-Id: I52fc5ebf9e17eb1c61c176a5da71acaa0f1a1afa
---
 shared/device.mk                            | 14 ++++++++++++++
 vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk |  9 +--------
 2 files changed, 15 insertions(+), 8 deletions(-)

diff --git a/shared/device.mk b/shared/device.mk
index ae0341029f76b4c2ca550f000f65fe2f5bf81ee4..0636cf70dee9f4459e43329581bdb111e71c6bb0 100644
--- a/shared/device.mk
+++ b/shared/device.mk
@@ -370,10 +370,17 @@ PRODUCT_PACKAGES += $(LOCAL_DUMPSTATE_PRODUCT_PACKAGE)
 #
 # Gatekeeper
 #
+ifeq ($(UML_ANDROID_SECURITY_HALS),nonsecure)
+PRODUCT_PACKAGES += \
+  com.android.hardware.gatekeeper.nonsecure \
+
+else
 PRODUCT_PACKAGES += \
   com.android.hardware.gatekeeper.cf_remote \
   com.android.hardware.gatekeeper.nonsecure \
 
+endif
+
 #
 # Oemlock
 #
@@ -434,11 +441,18 @@ endif
 #
 # KeyMint HAL
 #
+ifeq ($(UML_ANDROID_SECURITY_HALS),nonsecure)
+PRODUCT_PACKAGES += \
+	com.android.hardware.keymint.rust_nonsecure \
+
+else
 PRODUCT_PACKAGES += \
 	com.android.hardware.keymint.rust_cf_remote \
 	com.android.hardware.keymint.rust_nonsecure \
 	com.android.hardware.keymint.rust_cf_guest_trusty_nonsecure \
 
+endif
+
 # Indicate that KeyMint includes support for the ATTEST_KEY key purpose.
 PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.keystore.app_attest_key.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.keystore.app_attest_key.xml
diff --git a/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk b/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
index 5bce5b80f4c5efe2ad2df6bea7df4806ecfc0381..91f4d6f3f003ef60483fa4e60f0502e8fa201ae7 100644
--- a/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
+++ b/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
@@ -20,6 +20,7 @@
 # The emulator has no protected-VM transport. Set this before inheritance so
 # Cuttlefish does not add the Trusty security VM and its nested kernel build.
 TRUSTY_SYSTEM_VM := disabled
+UML_ANDROID_SECURITY_HALS := nonsecure
 $(call inherit-product, device/google/cuttlefish/vsoc_arm64_pgagnostic/phone/aosp_cf.mk)
 
 PRODUCT_NAME := aosp_uml_arm64_pgagnostic
@@ -42,14 +43,6 @@ PRODUCT_BUILD_VENDOR_DLKM_IMAGE := false
 PRODUCT_BUILD_ODM_DLKM_IMAGE := false
 PRODUCT_BUILD_SYSTEM_DLKM_IMAGE := false
 
-# Retain only the explicitly nonsecure software security HALs for bring-up.
-# Remote and guest-Trusty variants require host services this emulator does not
-# implement and must not enter the build or published feature contract.
-PRODUCT_PACKAGES := $(filter-out \
-    com.android.hardware.gatekeeper.cf_remote \
-    com.android.hardware.keymint.rust_cf_guest_trusty_nonsecure \
-    com.android.hardware.keymint.rust_cf_remote,$(PRODUCT_PACKAGES))
-
 # ACK 6.18 supplies memfd-backed ashmem compatibility for legacy clients and
 # the Android 17 memfd SELinux class for new clients. Prefer that path from the
 # first product build.
