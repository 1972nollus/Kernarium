From 5f6e0650cc7a0752f7114258fc0af2b93a00cc61 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 16:08:33 +0000
Subject: [PATCH 2/2] UML-ANDROID-LOCAL: cuttlefish: remove loadable kernel
 modules

Change-Id: I97eb4c780963a4372f10c90cce004a9d1004b725
---
 vsoc_uml_arm64_pgagnostic/BoardConfig.mk    | 55 ++++++++++++++++++++-
 vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk |  6 +++
 2 files changed, 59 insertions(+), 2 deletions(-)

diff --git a/vsoc_uml_arm64_pgagnostic/BoardConfig.mk b/vsoc_uml_arm64_pgagnostic/BoardConfig.mk
index fd927b27b7a0d376d8e8ed7912a48d53d495a0c3..225fae3180e352544847be3171033083a4edd973 100644
--- a/vsoc_uml_arm64_pgagnostic/BoardConfig.mk
+++ b/vsoc_uml_arm64_pgagnostic/BoardConfig.mk
@@ -19,7 +19,58 @@
 # HAL changes do not alter any Cuttlefish product.
 include device/google/cuttlefish/vsoc_arm64_pgagnostic/BoardConfig.mk
 
-# This product has one fixed 16 KiB kernel rather than Cuttlefish's optional
-# alternate developer kernel image.
+# The ACK UML ELF is built and published independently. Android packaging must
+# neither substitute a Cuttlefish kernel nor stage any loadable module. Every
+# driver required by the guest is verified built-in by build-kernel.sh.
+PRODUCT_COPY_FILES := $(filter-out %:kernel,$(PRODUCT_COPY_FILES))
+TARGET_KERNEL_PATH :=
+SYSTEM_DLKM_SRC :=
+KERNEL_MODULES_PATH :=
+SYSTEM_VIRTIO_PREBUILTS_PATH :=
+RAMDISK_KERNEL_MODULES :=
+
+BOARD_GENERIC_RAMDISK_KERNEL_MODULES :=
+BOARD_GENERIC_RAMDISK_KERNEL_MODULES_LOAD :=
+BOARD_RECOVERY_KERNEL_MODULES :=
+BOARD_VENDOR_CHARGER_KERNEL_MODULES :=
+BOARD_VENDOR_CHARGER_KERNEL_MODULES_LOAD :=
+BOARD_VENDOR_KERNEL_RAMDISK_CHARGER_KERNEL_MODULES_LOAD :=
+BOARD_VENDOR_KERNEL_RAMDISK_KERNEL_MODULES :=
+BOARD_VENDOR_KERNEL_RAMDISK_KERNEL_MODULES_BLOCKLIST_FILE :=
+BOARD_VENDOR_KERNEL_RAMDISK_RECOVERY_KERNEL_MODULES_LOAD :=
+BOARD_VENDOR_RAMDISK_CHARGER_KERNEL_MODULES_LOAD :=
+BOARD_VENDOR_RAMDISK_KERNEL_MODULES :=
+BOARD_VENDOR_RAMDISK_KERNEL_MODULES_BLOCKLIST_FILE :=
+BOARD_VENDOR_RAMDISK_KERNEL_MODULES_LOAD :=
+BOARD_VENDOR_RAMDISK_KERNEL_MODULES_OPTIONS_FILE :=
+BOARD_VENDOR_RAMDISK_RECOVERY_KERNEL_MODULES_LOAD :=
+BOARD_VENDOR_KERNEL_MODULES :=
+BOARD_VENDOR_KERNEL_MODULES_BLOCKLIST_FILE :=
+BOARD_VENDOR_KERNEL_MODULES_LOAD :=
+BOARD_VENDOR_KERNEL_MODULES_2ND_STAGE_16KB_MODE :=
+BOARD_SYSTEM_KERNEL_MODULES :=
+BOARD_SYSTEM_KERNEL_MODULES_BLOCKLIST_FILE :=
+BOARD_SYSTEM_KERNEL_MODULES_LOAD :=
+BOARD_ODM_KERNEL_MODULES :=
+BOARD_ODM_KERNEL_MODULES_BLOCKLIST_FILE :=
+BOARD_KERNEL_MODULES_ZIP :=
+BOARD_KERNEL_MODULES_ZIP_EXTRA_BLOCKED_16K_MODULES :=
+BOARD_KERNEL_MODULES_ZIP_EXTRA_VENDOR_KERNEL_MODULES :=
+BOARD_KERNEL_MODULES_ZIP_EXTRA_VENDOR_KERNEL_RAMDISK_LOADS :=
+BOARD_KERNEL_MODULE_INTERFACE_VERSIONS :=
 BOARD_KERNEL_PATH_16K :=
 BOARD_KERNEL_MODULES_16K :=
+BOARD_KERNEL_MODULES_LOAD_16K :=
+
+# Keep the inherited dynamic-partition layout for this intermediate milestone,
+# but remove every DLKM partition and its AVB chain. Static UBD partition
+# ownership is introduced by the later disk-layout topic.
+BOARD_AVB_VBMETA_CUSTOM_PARTITIONS := \
+    $(filter-out vendor_dlkm system_dlkm odm_dlkm,$(BOARD_AVB_VBMETA_CUSTOM_PARTITIONS))
+BOARD_AVB_VBMETA_VENDOR_DLKM :=
+BOARD_AVB_VBMETA_SYSTEM_DLKM :=
+BOARD_GOOGLE_SYSTEM_DYNAMIC_PARTITIONS_PARTITION_LIST := \
+    $(filter-out system_dlkm,$(BOARD_GOOGLE_SYSTEM_DYNAMIC_PARTITIONS_PARTITION_LIST))
+BOARD_GOOGLE_VENDOR_DYNAMIC_PARTITIONS_PARTITION_LIST := \
+    $(filter-out vendor_dlkm odm_dlkm,$(BOARD_GOOGLE_VENDOR_DYNAMIC_PARTITIONS_PARTITION_LIST))
+AB_OTA_PARTITIONS := $(filter-out vendor_dlkm system_dlkm odm_dlkm,$(AB_OTA_PARTITIONS))
diff --git a/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk b/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
index 95e554c511efd66f959c9337f007e19bbdb8793a..75fb2c97a4aabc4a6b09583814aa52386e688a20 100644
--- a/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
+++ b/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
@@ -33,6 +33,12 @@ PRODUCT_CHECK_PREBUILT_MAX_PAGE_SIZE := true
 TARGET_BOOTS_16K := true
 PRODUCT_16K_DEVELOPER_OPTION := false
 
+# The separately published ACK UML kernel has CONFIG_MODULES=n. Never build
+# Android DLKM partitions or package Cuttlefish module prebuilts for this guest.
+PRODUCT_BUILD_VENDOR_DLKM_IMAGE := false
+PRODUCT_BUILD_ODM_DLKM_IMAGE := false
+PRODUCT_BUILD_SYSTEM_DLKM_IMAGE := false
+
 # ACK 6.18 supplies memfd-backed ashmem compatibility for legacy clients and
 # the Android 17 memfd SELinux class for new clients. Prefer that path from the
 # first product build.
