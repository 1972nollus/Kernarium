-# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
-# See the License for the specific language governing permissions and
-# limitations under the License.
-#
-
-# Use the maintained AOSP page-agnostic arm64 product as the initial Android
-# userspace composition. UML-specific storage, init, VINTF, and HAL ownership
-# is added in this device directory without changing Cuttlefish products.
-# The emulator has no protected-VM transport. Set this before inheritance so
-# Cuttlefish does not add the Trusty security VM and its nested kernel build.
-TRUSTY_SYSTEM_VM := disabled
-UML_ANDROID_SECURITY_HALS := nonsecure
-# The ACK UML kernel has CONFIG_MODULES=n; select the module-free init path.
-UML_ANDROID_BUILTIN_KERNEL := true
-UML_ANDROID_STATIC_STORAGE := true
-UML_ANDROID_DISABLE_PROJECT_QUOTAS := true
-# Do not package or declare Cuttlefish HALs whose transports and backing
-# devices are absent from the Darwin UML machine. Keeping them out of the
-# product prevents init from repeatedly restarting processes that can never
-# become healthy.
-BOARD_HAVE_BLUETOOTH := false
-CF_VENDOR_NO_UWB := true
-CF_VENDOR_NO_THREADNETWORK := true
-LOCAL_ENABLE_LIGHT := false
-LOCAL_ENABLE_OEMLOCK := false
-LOCAL_ENABLE_NEURALNETWORKS := false
-LOCAL_ENABLE_SENSORS := false
-# The Cuttlefish RIL needs the modem simulator and the Cuttlefish NFC HAL opens
-# /dev/hvc12; neither exists on this machine, so both processes exit immediately
-# and init restarts them forever. Each restart runs flags_health_check
-# UPDATABLE_CRASHING, which resets server-configurable flags, so the loop is not
-# merely noisy.
-TARGET_USES_CF_RILD := false
-LOCAL_ENABLE_NFC := false
-# The fixed UBD GPT exposes seven partitions and none of them is frp, so
-# PersistentDataBlockService waits on a block device that never appears and
-# throws "Service PersistentDataBlockService init timeout" during boot phase
-# 500, killing system_server. SystemServer only starts that service when
-# ro.frp.pst is non-empty, so leaving the property unset is the supported way
-# to describe a device without a factory reset protection partition.
-LOCAL_ENABLE_FRP := false
-# Android 17's bundled arm64 Mesa prebuilt is linked for 4 KiB pages. Select
-# the AOSP-source EGL/GLES and Gallium Virgl modules generated for this 16 KiB
-# product while leaving every other Cuttlefish product on its existing stack.
-UML_ANDROID_SOURCE_MESA := true
-$(call inherit-product, device/google/cuttlefish/vsoc_arm64_pgagnostic/phone/aosp_cf.mk)
-
-PRODUCT_NAME := aosp_uml_arm64_pgagnostic
-PRODUCT_DEVICE := vsoc_uml_arm64_pgagnostic
-PRODUCT_BRAND := Android
-PRODUCT_MANUFACTURER := Kernarium
-PRODUCT_MODEL := Android 17 on Darwin UML
-
-# The guest is arm64-only and page-size agnostic in userspace, but the only
-# kernel and runtime product that may consume it uses 16 KiB pages.
-PRODUCT_MAX_PAGE_SIZE_SUPPORTED := 16384
-PRODUCT_NO_BIONIC_PAGE_SIZE_MACRO := true
-PRODUCT_CHECK_PREBUILT_MAX_PAGE_SIZE := true
-TARGET_BOOTS_16K := true
-PRODUCT_16K_DEVELOPER_OPTION := false
-
-# The separately published ACK UML kernel has CONFIG_MODULES=n. Never build
-# Android DLKM partitions or package Cuttlefish module prebuilts for this guest.
-PRODUCT_BUILD_VENDOR_DLKM_IMAGE := false
-PRODUCT_BUILD_ODM_DLKM_IMAGE := false
-PRODUCT_BUILD_SYSTEM_DLKM_IMAGE := false
-
-# Produce independent filesystem images for the fixed UBD GPT layout. Dynamic
-# super, Virtual A/B snapshots, and OTA payloads have no runtime consumer.
-PRODUCT_USE_DYNAMIC_PARTITIONS := false
-PRODUCT_USE_DYNAMIC_PARTITION_SIZE := false
-PRODUCT_BUILD_SUPER_PARTITION := false
-PRODUCT_BUILD_SUPER_EMPTY_IMAGE := false
-PRODUCT_BUILD_SYSTEM_OTHER_IMAGE := false
-PRODUCT_VIRTUAL_AB_OTA := false
-PRODUCT_VIRTUAL_AB_COMPRESSION := false
-PRODUCT_VIRTUAL_AB_COMPRESSION_METHOD :=
-PRODUCT_VIRTUAL_AB_COMPRESSION_FACTOR :=
-# AOSP core assigns a default COW format even when Virtual A/B is disabled;
-# PRODUCT_VIRTUAL_AB_OTA is the authoritative switch for this static product.
-PRODUCT_OTA_FORCE_NON_AB_PACKAGE := false
-AB_OTA_POSTINSTALL_CONFIG :=
-
-# ACK 6.18 supplies memfd-backed ashmem compatibility for legacy clients and
-# the Android 17 memfd SELinux class for new clients. Prefer that path from the
-# first product build.
-PRODUCT_PRODUCT_PROPERTIES += sys.use_memfd=true
-
-# audioserver aborts itself through mediautils TimeCheck when a call outlives
-# its deadline. AOSP already recognises this product as relaxed-timing, because
-# ro.product.system.name starts with aosp_, and grants 6000 ms plus a 4000 ms
-# second chance. Translated execution under a software MMU still overruns that:
-# IAudioFlinger::registerClient aborted after about 10.6 s while waiting on a
-# priority-inheritance mutex, which then took system_server and SystemUI with
-# it. CONFIG_FUTEX_PI and CONFIG_RT_MUTEXES are both built in, so the wait is
-# slow rather than unsupported. Scale the documented overrides by the same
-# factor this product already applies to androidboot.hw_timeout_multiplier.
-PRODUCT_PRODUCT_PROPERTIES += \
-    audio.timecheck.timeout_duration_ms=300000 \
-    audio.timecheck.second_chance_duration_ms=200000
-
-# Keep Android.mk ignored exactly as in the source page-agnostic product.
-PRODUCT_IGNORE_ALL_ANDROIDMK := true
diff --git a/vsoc_uml_arm64_pgagnostic/sepolicy/vendor/file_contexts b/vsoc_uml_arm64_pgagnostic/sepolicy/vendor/file_contexts
deleted file mode 100644
index 29b489060352f0163361bb8470101762406e20a6..0000000000000000000000000000000000000000
--- a/vsoc_uml_arm64_pgagnostic/sepolicy/vendor/file_contexts
+++ /dev/null
@@ -1,5 +0,0 @@
-# The UML product exposes one single-port Virtio console as its Android shell.
-/dev/hvc0  u:object_r:serial_device:s0
-
-# Mesa's EGL SP-HAL resolves this dependency through the same namespace.
-/vendor/lib(64)?/libzstd\.so  u:object_r:same_process_hal_file:s0
diff --git a/vsoc_uml_arm64_pgagnostic/sepolicy/vendor/genfs_contexts b/vsoc_uml_arm64_pgagnostic/sepolicy/vendor/genfs_contexts
deleted file mode 100644
index 3cf4ea7d5dc5c9739224378c189c36d39f96bf61..0000000000000000000000000000000000000000
--- a/vsoc_uml_arm64_pgagnostic/sepolicy/vendor/genfs_contexts
+++ /dev/null
@@ -1,8 +0,0 @@
-# libdrm resolves both /dev/dri/card0 and /dev/dri/renderD128 through this
-# platform device.  Mesa EGL enumerates render nodes with drmGetDevices2(),
-# which reads the device subsystem link and the drm/ directory as well as
-# uevent, so labelling uevent alone leaves SurfaceFlinger unable to classify
-# the device: it finds no DRM device, eglInitialize() fails, and it aborts
-# with "no suitable EGLConfig found".  genfscon matches by prefix, so label
-# the whole GPU platform device.
-genfscon sysfs /devices/virtio-uml-cmdline/virtio-uml.0 u:object_r:sysfs_gpu:s0
