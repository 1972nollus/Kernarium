From 6c615c8949af9315f773b3fd5cacf51b57e250e9 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 22 Aug 2026 15:38:15 +0000
Subject: [PATCH 20/20] UML-ANDROID-LOCAL: cuttlefish omit the RIL and NFC HALs

The Cuttlefish RIL service needs the modem simulator and the Cuttlefish NFC
service opens /dev/hvc12. Neither exists on the Darwin UML machine, so both
processes exit immediately and init restarts them forever: one ten-vCPU boot
recorded 74 vendor.ril-daemon starts and 75 nfc_hal_service starts in about
nine minutes.

The loop is not merely noisy. Every restart trips
process with updatable components ... exited 4 times before boot completed,
which runs flags_health_check UPDATABLE_CRASHING and resets server-configurable
flags, and the constant fork, cgroup, and SELinux churn starves the guest badly
enough that the console shell cannot complete a getprop.

Guard the NFC APEX with LOCAL_ENABLE_NFC in the same style as the other omitted
HALs, then set TARGET_USES_CF_RILD and LOCAL_ENABLE_NFC to false for the UML
product.

Change-Id: I663c0d310cef01928a7b6e3119b9e1ad8e8a5202
---
 shared/phone/device_vendor.mk               | 3 +++
 vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk | 7 +++++++
 2 files changed, 10 insertions(+)

diff --git a/shared/phone/device_vendor.mk b/shared/phone/device_vendor.mk
index 354c49e7de1f7eca559fa77c973a328390d73fec..7de3291a8715a1fe4bf625e256448e7b263ecc35 100644
--- a/shared/phone/device_vendor.mk
+++ b/shared/phone/device_vendor.mk
@@ -69,8 +69,11 @@ PRODUCT_PACKAGES += \
     android.hardware.motioncontext-service.default
 
 # NFC AIDL HAL
+LOCAL_ENABLE_NFC ?= true
+ifeq ($(LOCAL_ENABLE_NFC),true)
 PRODUCT_PACKAGES += \
     com.google.cf.nfc
+endif
 
 TARGET_BOARD_INFO_FILE ?= device/google/cuttlefish/shared/phone/android-info.txt
 
diff --git a/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk b/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
index c29de5361e9d80cff101b9114feae01aef655a27..215e802c178dc0bf911ee6b34b7082cdf324ac36 100644
--- a/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
+++ b/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
@@ -36,6 +36,13 @@ LOCAL_ENABLE_LIGHT := false
 LOCAL_ENABLE_OEMLOCK := false
 LOCAL_ENABLE_NEURALNETWORKS := false
 LOCAL_ENABLE_SENSORS := false
+# The Cuttlefish RIL needs the modem simulator and the Cuttlefish NFC HAL opens
+# /dev/hvc12; neither exists on this machine, so both processes exit immediately
+# and init restarts them forever. Each restart runs flags_health_check
+# UPDATABLE_CRASHING, which resets server-configurable flags, so the loop is not
+# merely noisy.
+TARGET_USES_CF_RILD := false
+LOCAL_ENABLE_NFC := false
 # Android 17's bundled arm64 Mesa prebuilt is linked for 4 KiB pages. Select
 # the AOSP-source EGL/GLES and Gallium Virgl modules generated for this 16 KiB
 # product while leaving every other Cuttlefish product on its existing stack.
