From 8bd1477d81596c55290478d3c8598e6c38ea07b0 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 22 Aug 2026 18:12:04 +0000
Subject: [PATCH 21/23] UML-ANDROID-LOCAL: cuttlefish omit factory reset
 protection storage

The fixed UBD GPT exposes seven partitions - system, system_ext, product,
vendor, odm, metadata, and userdata - and none of them is frp. The product
still advertised ro.frp.pst=/dev/block/by-name/frp, so
PersistentDataBlockService waited on a block device that never appears and threw

  java.lang.RuntimeException: Failed to boot service
    com.android.server.pdb.PersistentDataBlockService: onBootPhase threw an
    exception during phase 500
  Caused by: java.lang.IllegalStateException:
    Service PersistentDataBlockService init timeout

That is a fatal exception in the system process, so system_server died and the
runtime restarted roughly every 80 seconds without reaching sys.boot_completed.

SystemServer starts that service only when the property is non-empty:

  final boolean hasPdb = !SystemProperties.get(PERSISTENT_DATA_BLOCK_PROP).equals("");
  if (hasPdb) { mSystemServiceManager.startService(PersistentDataBlockService.class); }

so leaving ro.frp.pst unset is the supported way to describe a device without a
factory reset protection partition rather than a workaround. Guard it with
LOCAL_ENABLE_FRP in the same style as the other omitted features.

Change-Id: Ie88d76f4877f1700c580e5f8451a8e6f9815d235
---
 shared/phone/device_vendor.mk               | 3 +++
 vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk | 7 +++++++
 2 files changed, 10 insertions(+)

diff --git a/shared/phone/device_vendor.mk b/shared/phone/device_vendor.mk
index 7de3291a8715a1fe4bf625e256448e7b263ecc35..fdbc727046b29b819223ac950058bbb9a529819a 100644
--- a/shared/phone/device_vendor.mk
+++ b/shared/phone/device_vendor.mk
@@ -78,8 +78,11 @@ endif
 TARGET_BOARD_INFO_FILE ?= device/google/cuttlefish/shared/phone/android-info.txt
 
 # Storage: for factory reset protection feature
+LOCAL_ENABLE_FRP ?= true
+ifeq ($(LOCAL_ENABLE_FRP),true)
 PRODUCT_VENDOR_PROPERTIES += \
     ro.frp.pst=/dev/block/by-name/frp
+endif
 
 # Cuttlefish doesn't support protected VMs, run AppSearch in non-protected mode
 PRODUCT_PRODUCT_PROPERTIES += ro.appsearch.feature.enable_isolated_storage=true
diff --git a/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk b/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
index 215e802c178dc0bf911ee6b34b7082cdf324ac36..4162ab8a90ea90718aa2cb540da9f7d85be0fabf 100644
--- a/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
+++ b/vsoc_uml_arm64_pgagnostic/phone/aosp_uml.mk
@@ -43,6 +43,13 @@ LOCAL_ENABLE_SENSORS := false
 # merely noisy.
 TARGET_USES_CF_RILD := false
 LOCAL_ENABLE_NFC := false
+# The fixed UBD GPT exposes seven partitions and none of them is frp, so
+# PersistentDataBlockService waits on a block device that never appears and
+# throws "Service PersistentDataBlockService init timeout" during boot phase
+# 500, killing system_server. SystemServer only starts that service when
+# ro.frp.pst is non-empty, so leaving the property unset is the supported way
+# to describe a device without a factory reset protection partition.
+LOCAL_ENABLE_FRP := false
 # Android 17's bundled arm64 Mesa prebuilt is linked for 4 KiB pages. Select
 # the AOSP-source EGL/GLES and Gallium Virgl modules generated for this 16 KiB
 # product while leaving every other Cuttlefish product on its existing stack.
