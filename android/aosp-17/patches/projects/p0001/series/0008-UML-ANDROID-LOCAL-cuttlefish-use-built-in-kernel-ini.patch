+package {
+    default_applicable_licenses: ["Android-Apache-2.0"],
+}
+
+prebuilt_etc {
+    name: "device_google_cuttlefish_uml_config_init_vendor_rc",
+    srcs: ["init.vendor.rc"],
+    dsts: ["init.cutf_cvm.rc"],
