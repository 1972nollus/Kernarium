From 58f829d856f4b45910294bbc0c1267916845a5dc Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 19:19:57 +0000
Subject: [PATCH 1/3] UML-ANDROID-LOCAL: build: omit updater when OTA is
 skipped

Change-Id: I611cb22957be03a4a600975fab4ee09fd07d2364
---
 core/Makefile | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/core/Makefile b/core/Makefile
index 39cad66a4443bfe6cf8d06e53e82e53bb0e30ae5..b307057ff24e7737fd98bec657064556ee4ff281 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -6356,10 +6356,13 @@ built_ota_tools :=
 # We can't build static executables when SANITIZE_TARGET=address
 ifeq (,$(filter address, $(SANITIZE_TARGET)))
 ifeq (false,$(AB_OTA_UPDATER))
+# TARGET_SKIP_OTA_PACKAGE also permits target-files without a legacy updater.
+ifneq ($(TARGET_SKIP_OTA_PACKAGE),true)
 built_ota_tools += \
     $(call intermediates-dir-for,EXECUTABLES,updater)/updater
 endif
 endif
+endif
 
 $(BUILT_TARGET_FILES_DIR): PRIVATE_OTA_TOOLS := $(built_ota_tools)
 
