From 0903e82d59e6847b405b122f2b3ef8c21215d32e Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 24 Aug 2026 12:21:08 +0000
Subject: [PATCH 2/2] UML-ANDROID-LOCAL: build: allow inherited payload
 exclusions

Change-Id: Id61d2ee5525b53f0721b994e3b4909aa67ca4a10
---
 core/product.mk        |  2 ++
 core/product_config.mk | 13 +++++++++++++
 2 files changed, 15 insertions(+)

diff --git a/core/product.mk b/core/product.mk
index 1ba058dc2856aee5f8bae1f3042a0bfd657e0bac..5347415a9f21b471903c9f4b52255e7871cf2fe5 100644
--- a/core/product.mk
+++ b/core/product.mk
@@ -45,6 +45,7 @@ _product_single_value_vars += PRODUCT_AAPT_PREF_CONFIG
 _product_list_vars += PRODUCT_AAPT_PREBUILT_DPI
 _product_list_vars += PRODUCT_HOST_PACKAGES
 _product_list_vars += PRODUCT_PACKAGES
+_product_list_vars += PRODUCT_PACKAGES_EXCLUDE
 _product_list_vars += PRODUCT_PACKAGES_DEBUG
 _product_list_vars += PRODUCT_PACKAGES_DEBUG_ASAN
 _product_list_vars += PRODUCT_PACKAGES_ARM64
@@ -107,6 +108,7 @@ _product_single_value_vars += PRODUCT_CHARACTERISTICS
 # The rules for these copy steps are defined in build/make/core/Makefile.
 # The optional :<owner> is used to indicate the owner of a vendor file.
 _product_list_vars += PRODUCT_COPY_FILES
+_product_list_vars += PRODUCT_COPY_FILES_EXCLUDE
 
 # The OTA key(s) specified by the product config, if any.  The names
 # of these keys are stored in the target-files zip so that post-build
diff --git a/core/product_config.mk b/core/product_config.mk
index 2bcc764b55a5a1d207a4b077d83f15e3c1130beb..96840d62a01d00b21aa2ed97f3cd9b95673c35df 100644
--- a/core/product_config.mk
+++ b/core/product_config.mk
@@ -268,6 +268,19 @@ INTERNAL_PRODUCT := $(current_product_makefile)
 # Strip and assign the PRODUCT_ variables.
 $(call strip-product-vars)
 
+# A product may intentionally omit inherited packages and copy-file entries
+# without forking the reusable product layer that supplied them. Exclusions
+# are resolved through the same inheritance graph before they are applied.
+PRODUCT_PACKAGES := $(filter-out $(PRODUCT_PACKAGES_EXCLUDE),$(PRODUCT_PACKAGES))
+PRODUCT_PACKAGES_DEBUG := $(filter-out $(PRODUCT_PACKAGES_EXCLUDE),$(PRODUCT_PACKAGES_DEBUG))
+PRODUCT_PACKAGES_ENG := $(filter-out $(PRODUCT_PACKAGES_EXCLUDE),$(PRODUCT_PACKAGES_ENG))
+PRODUCT_PACKAGES_TESTS := $(filter-out $(PRODUCT_PACKAGES_EXCLUDE),$(PRODUCT_PACKAGES_TESTS))
+PRODUCT_PACKAGES_DEBUG_ASAN := $(filter-out $(PRODUCT_PACKAGES_EXCLUDE),$(PRODUCT_PACKAGES_DEBUG_ASAN))
+PRODUCT_PACKAGES_DEBUG_JAVA_COVERAGE := $(filter-out $(PRODUCT_PACKAGES_EXCLUDE),$(PRODUCT_PACKAGES_DEBUG_JAVA_COVERAGE))
+PRODUCT_PACKAGES_ARM64 := $(filter-out $(PRODUCT_PACKAGES_EXCLUDE),$(PRODUCT_PACKAGES_ARM64))
+PRODUCT_SYSTEM_SERVER_APPS := $(filter-out $(PRODUCT_PACKAGES_EXCLUDE),$(PRODUCT_SYSTEM_SERVER_APPS))
+PRODUCT_COPY_FILES := $(filter-out $(PRODUCT_COPY_FILES_EXCLUDE),$(PRODUCT_COPY_FILES))
+
 # Quick check
 $(check-current-product)
 
