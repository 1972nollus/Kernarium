+bool OpDispatchBuilder::EmbedderFPEstimate(IROps IROp) const {
+  const auto Kind = EmbedderFPKindOf(IROp);
+  return CTX->Embedded && Kind && (*Kind == Core::EMBEDDER_FP_RCP || *Kind == Core::EMBEDDER_FP_RSQRT);
