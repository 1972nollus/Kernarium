+
+bool OpDispatchBuilder::EmbedderFPChecks(Core::EmbedderFPKind Kind) const {
+  if (!CTX->Embedded) {
+    return false;
+  }
+  switch (Kind) {
+  case Core::EMBEDDER_FP_RCP:
+  case Core::EMBEDDER_FP_RSQRT: return true;
+  default: return false;
+  }
+}
