+uint32_t OpDispatchBuilder::EmbedderFMAFlags(IROps IROp) {
+  switch (IROp) {
+  case OP_VFMLS:
+  case OP_VFMLSSCALARINSERT: return Core::EMBEDDER_FP_FMA_NEGATE_ADDEND;
+  case OP_VFNMLA:
+  case OP_VFNMLASCALARINSERT: return Core::EMBEDDER_FP_FMA_NEGATE_PRODUCT;
+  case OP_VFNMLS:
+  case OP_VFNMLSSCALARINSERT: return Core::EMBEDDER_FP_FMA_NEGATE_PRODUCT | Core::EMBEDDER_FP_FMA_NEGATE_ADDEND;
+  default: return 0;
+  }
+}
