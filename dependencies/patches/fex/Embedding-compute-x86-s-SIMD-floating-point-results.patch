+std::optional<Core::EmbedderFPKind> OpDispatchBuilder::EmbedderFPKindOf(IROps IROp) {
+  switch (IROp) {
+  case OP_VFADD:
+  case OP_VFADDSCALARINSERT: return Core::EMBEDDER_FP_ADD;
+  case OP_VFSUB:
+  case OP_VFSUBSCALARINSERT: return Core::EMBEDDER_FP_SUB;
+  case OP_VFMUL:
+  case OP_VFMULSCALARINSERT: return Core::EMBEDDER_FP_MUL;
+  case OP_VFDIV:
+  case OP_VFDIVSCALARINSERT: return Core::EMBEDDER_FP_DIV;
+  case OP_VFMIN:
+  case OP_VFMINSCALARINSERT: return Core::EMBEDDER_FP_MIN;
+  case OP_VFMAX:
+  case OP_VFMAXSCALARINSERT: return Core::EMBEDDER_FP_MAX;
+  case OP_VFSQRT:
+  case OP_VFSQRTSCALARINSERT: return Core::EMBEDDER_FP_SQRT;
+  case OP_VFRECP:
+  case OP_VFRECPSCALARINSERT: return Core::EMBEDDER_FP_RCP;
+  case OP_VFRSQRT:
+  case OP_VFRSQRTSCALARINSERT: return Core::EMBEDDER_FP_RSQRT;
+  case OP_VFADDP: return Core::EMBEDDER_FP_HADD;
+  default: return std::nullopt;
+  }
+}
+
+bool OpDispatchBuilder::EmbedderFPEstimate(IROps IROp) const {
+  const auto Kind = EmbedderFPKindOf(IROp);
+  return CTX->Embedded && Kind && (*Kind == Core::EMBEDDER_FP_RCP || *Kind == Core::EMBEDDER_FP_RSQRT);
+}
+
+bool OpDispatchBuilder::EmbedderFPChecks(Core::EmbedderFPKind Kind) const {
+  if (!CTX->Embedded) {
+    return false;
+  }
+  switch (Kind) {
+  case Core::EMBEDDER_FP_MIN:
+  case Core::EMBEDDER_FP_MAX: return false;
+  default: return true;
+  }
+}
+
+Ref OpDispatchBuilder::EmbedderFPResult(Ref Result, uint32_t Descriptor, Ref Source1, Ref Source2, Ref Source3) {
+  if (!EmbedderFPChecks(static_cast<Core::EmbedderFPKind>(Descriptor & 0xFF))) {
+    return Result;
+  }
+  return _EmbedderFPCheck(Result, Source1, Source2 ? Source2 : Source1, Source3 ? Source3 : Source1, Descriptor);
+}
+
+Ref OpDispatchBuilder::EmbedderFPArith(IROps IROp, IR::OpSize ElementSize, IR::OpSize Size, Ref Result, Ref Source1, Ref Source2) {
+  const auto Kind = EmbedderFPKindOf(IROp);
+  // FEXCore's 256-bit operations need SVE256; an embedding host has none.
+  if (!Kind || Size > OpSize::i128Bit) {
+    return Result;
+  }
+  const bool Scalar = IROp == OP_VFADDSCALARINSERT || IROp == OP_VFSUBSCALARINSERT || IROp == OP_VFMULSCALARINSERT ||
+                      IROp == OP_VFDIVSCALARINSERT || IROp == OP_VFMINSCALARINSERT || IROp == OP_VFMAXSCALARINSERT ||
+                      IROp == OP_VFSQRTSCALARINSERT || IROp == OP_VFRECPSCALARINSERT || IROp == OP_VFRSQRTSCALARINSERT;
+  const bool Unary = *Kind == Core::EMBEDDER_FP_SQRT || *Kind == Core::EMBEDDER_FP_RCP || *Kind == Core::EMBEDDER_FP_RSQRT;
+  const auto Lanes = Scalar ? 1 : IR::OpSizeToSize(Size) / IR::OpSizeToSize(ElementSize);
+  const auto Desc = Core::EmbedderFPDescriptor(*Kind, IR::OpSizeToSize(ElementSize), Lanes);
+  return Unary ? EmbedderFPResult(Result, Desc, Source2) : EmbedderFPResult(Result, Desc, Source1, Source2);
+}
