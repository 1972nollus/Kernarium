+// SPDX-License-Identifier: MIT
+/*
+$info$
+tags: backend|arm64
+desc: x86's SIMD floating-point results for an embedding host
+$end_info$
+*/
+
+#include "Interface/Context/Context.h"
+#include "Interface/Core/JIT/JITClass.h"
+
+#include <FEXCore/Core/CoreState.h>
+
+namespace FEXCore::CPU {
+namespace {
+
+// An EmbedderFPCheck op's Core::EmbedderFPDescriptor.
+struct FPDescriptor {
+  uint32_t Raw;
+
+  Core::EmbedderFPKind Kind() const {
+    return static_cast<Core::EmbedderFPKind>(Raw & 0xFF);
+  }
+  uint32_t ElementBytes() const {
+    return 2U << ((Raw >> Core::EMBEDDER_FP_ELEMENT_SHIFT) & 3);
+  }
+  uint32_t Lanes() const {
+    return (Raw >> Core::EMBEDDER_FP_LANES_SHIFT) & 0xF;
+  }
+  uint32_t Bytes() const {
+    return ElementBytes() * Lanes();
+  }
+};
+
+} // namespace
+
+// Branches to Target when any of the first Bytes bytes of Mask, all ones or
+// zero in each lane, is set. No NZCV writes: guest flags may be live.
+void Arm64JITCore::EmbedderFPBranchIfAny(ARMEmitter::VRegister Mask, uint32_t Bytes, ARMEmitter::ForwardLabel* Target) {
+  if (Bytes > 8) {
+    umaxv(ARMEmitter::SubRegSize::i32Bit, Mask.Q(), Mask.Q());
+    fmov(ARMEmitter::Size::i32Bit, TMP1.W(), Mask.S());
+    cbnz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, Target);
+  } else if (Bytes == 8) {
+    fmov(ARMEmitter::Size::i64Bit, TMP1, Mask.D());
+    cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP1, Target);
+  } else {
+    fmov(ARMEmitter::Size::i32Bit, TMP1.W(), Mask.S());
+    cbnz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, Target);
+  }
+}
+
+// RCPPS, RCPSS, RSQRTPS and RSQRTSS. x86 takes a denormal input as zero,
+// returns a zero for a reciprocal of 2^126 or more and the indefinite NaN for
+// the reciprocal square root of a negative number, and ignores MXCSR; the
+// host's correctly rounded quotient lies within x86's error everywhere else.
+// Lanes needing more than that quotient go to the host first, so the host
+// raises nothing for them: an exponent of zero, and for RCP one of 0xFD and
+// above, for RSQRT a negative sign.
+void Arm64JITCore::EmbedderFPEstimate(bool Reciprocal, uint32_t Bytes, ARMEmitter::VRegister Dst, ARMEmitter::VRegister Source,
+                                      ARMEmitter::VRegister Result, ARMEmitter::ForwardLabel* Cold) {
+  using ARMEmitter::SubRegSize;
+  const bool Scalar = Bytes == 4;
+  shl(SubRegSize::i32Bit, VTMP1.Q(), Source.Q(), 1);
+  if (Reciprocal) {
+    movi(SubRegSize::i32Bit, VTMP2.Q(), 0x03, 24);
+    add(SubRegSize::i32Bit, VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+    movi(SubRegSize::i32Bit, VTMP2.Q(), 0x04, 24);
+    cmhi(SubRegSize::i32Bit, VTMP1.Q(), VTMP2.Q(), VTMP1.Q());
+  } else {
+    movi(SubRegSize::i32Bit, VTMP2.Q(), 0x01, 24);
+    cmhi(SubRegSize::i32Bit, VTMP1.Q(), VTMP2.Q(), VTMP1.Q());
+    cmlt(SubRegSize::i32Bit, VTMP2.Q(), Source.Q());
+    orr(VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+  }
+  EmbedderFPBranchIfAny(VTMP1, Bytes, Cold);
+
+  if (Scalar) {
+    if (Reciprocal) {
+      fmov(ARMEmitter::ScalarRegSize::i32Bit, VTMP1, 1.0f);
+      fdiv(VTMP1.S(), VTMP1.S(), Source.S());
+    } else {
+      fsqrt(VTMP2.S(), Source.S());
+      fmov(ARMEmitter::ScalarRegSize::i32Bit, VTMP1, 1.0f);
+      fdiv(VTMP1.S(), VTMP1.S(), VTMP2.S());
+    }
+    if (Dst != Result) {
+      mov(Dst.Q(), Result.Q());
+    }
+    ins(SubRegSize::i32Bit, Dst, 0, VTMP1, 0);
+    return;
+  }
+  if (Reciprocal) {
+    fmov(SubRegSize::i32Bit, VTMP1.Q(), 1.0f);
+    fdiv(SubRegSize::i32Bit, Dst.Q(), VTMP1.Q(), Source.Q());
+  } else {
+    fsqrt(SubRegSize::i32Bit, VTMP2.Q(), Source.Q());
+    fmov(SubRegSize::i32Bit, VTMP1.Q(), 1.0f);
+    fdiv(SubRegSize::i32Bit, Dst.Q(), VTMP1.Q(), VTMP2.Q());
+  }
+}
+
+DEF_OP(EmbedderFPCheck) {
+  const auto Op = IROp->C<IR::IROp_EmbedderFPCheck>();
+  const FPDescriptor Desc {Op->Descriptor};
+  LOGMAN_THROW_A_FMT(Embedded() && Desc.Bytes() <= 16, "Unexpected EmbedderFPCheck {:#x}", Desc.Raw);
+
+  auto Site = fextl::make_unique<EmbedderFPSite>();
+  Site->Sources[0] = GetVReg(Op->Source1);
+  Site->Sources[1] = GetVReg(Op->Source2);
+  Site->Sources[2] = GetVReg(Op->Source3);
+  Site->Result = GetVReg(Op->Result);
+  Site->Dst = GetVReg(Node);
+  Site->Descriptor = Desc.Raw | (static_cast<uint64_t>(EmbedderUnretired(false)) << Core::EMBEDDER_FP_UNRETIRED_SHIFT);
+  Site->GuestRIP = EmbedderCurrentRIP;
+
+  switch (Desc.Kind()) {
+  case Core::EMBEDDER_FP_RCP:
+  case Core::EMBEDDER_FP_RSQRT:
+    EmbedderFPEstimate(Desc.Kind() == Core::EMBEDDER_FP_RCP, Desc.Bytes(), Site->Dst, Site->Sources[0], Site->Result, &Site->Entry);
+    break;
+  default:
+    LOGMAN_MSG_A_FMT("Unexpected EmbedderFPCheck kind {}", Desc.Raw & 0xFF);
+    FEX_UNREACHABLE;
+  }
+  (void)Bind(&Site->Done);
+  EmbedderFPSites.push_back(std::move(Site));
+}
+
+void Arm64JITCore::EmitEmbedderFPSites() {
+  const auto Scratch = offsetof(FEXCore::Core::CpuStateFrame, Embedder.FPScratch);
+  for (auto& Site : EmbedderFPSites) {
+    // A block too large for a short branch to reach its cold code is
+    // compiled again with far branches. No NZCV writes: guest flags may be
+    // live, and the shared path keeps them.
+    BindOrRestart(&Site->Entry);
+    for (uint32_t Index = 0; Index < 3; ++Index) {
+      str(Site->Sources[Index].Q(), STATE, Scratch + Index * 16);
+    }
+    str(Site->Result.Q(), STATE, Scratch + Core::EMBEDDER_FP_SCRATCH_RESULT);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Site->Descriptor);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP2, Site->GuestRIP);
+    ARMEmitter::ForwardLabel Resume;
+    adr_OrRestart(TMP3, &Resume);
+    ldr(TMP4, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.EmbedderFPCheck));
+    br(TMP4);
+    (void)Bind(&Resume);
+    ldr(Site->Dst.Q(), STATE, Scratch + Core::EMBEDDER_FP_SCRATCH_RESULT);
+    b_OrRestart(&Site->Done);
+  }
+  EmbedderFPSites.clear();
+}
+
+} // namespace FEXCore::CPU
