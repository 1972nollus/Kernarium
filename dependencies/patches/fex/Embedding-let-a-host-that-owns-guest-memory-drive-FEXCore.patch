diff --git a/CodeEmitter/CodeEmitter/Buffer.h b/CodeEmitter/CodeEmitter/Buffer.h
index 602eeb67472509e0287343f6958a1bcf09b490e1..6688c9efdb1b0a2bce0a4000bedd3cceb720263e 100644
--- a/CodeEmitter/CodeEmitter/Buffer.h
+++ b/CodeEmitter/CodeEmitter/Buffer.h
@@ -22,9 +22,26 @@ public:
     Size = BaseSize;
   }
 
+  // Called instead of writing when an emission would pass the end of the
+  // buffer. It must not return: its owner restarts the emission with a
+  // larger buffer. Without one the buffer is unchecked.
+  using OverflowHandler = void (*)(void* Data);
+  void SetOverflowHandler(OverflowHandler Handler, void* Data) {
+    Overflow = Handler;
+    OverflowData = Data;
+  }
+
+  // Makes sure Bytes more fit at the cursor before they are written.
+  void EnsureSpace(size_t Bytes) {
+    if (Overflow && Bytes > static_cast<size_t>(BufferBase + Size - CurrentOffset)) [[unlikely]] {
+      Overflow(OverflowData);
+    }
+  }
+
   template<typename T>
   requires (std::is_trivially_copyable_v<T>)
   void dcn(const T& Data) {
+    EnsureSpace(sizeof(Data));
     std::memcpy(CurrentOffset, &Data, sizeof(Data));
     CurrentOffset += sizeof(Data);
   }
@@ -43,6 +60,7 @@ public:
 
   void EmitString(const char* String) {
     const auto StringLength = strlen(String);
+    EnsureSpace(StringLength);
     memcpy(CurrentOffset, String, StringLength);
     CurrentOffset += StringLength;
   }
@@ -53,6 +71,7 @@ public:
     if (!CurrentAlignment) {
       return;
     }
+    EnsureSpace(Size - CurrentAlignment);
     std::memset(CurrentOffset, 0, Size - CurrentAlignment);
     CurrentOffset += Size - CurrentAlignment;
   }
@@ -75,10 +94,14 @@ public:
   }
 
   void CursorIncrement(size_t Size) {
+    EnsureSpace(Size);
     CurrentOffset += Size;
   }
 
   void SetCursorOffset(size_t Offset) {
+    if (Overflow && Offset > Size) [[unlikely]] {
+      Overflow(OverflowData);
+    }
     CurrentOffset = BufferBase + Offset;
   }
 
@@ -96,5 +119,7 @@ protected:
   uint8_t* BufferBase;
   uint8_t* CurrentOffset;
   uint64_t Size;
+  OverflowHandler Overflow {};
+  void* OverflowData {};
 };
