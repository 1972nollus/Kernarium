@@ -432,6 +433,56 @@ void Dispatcher::EmitDispatcher() {
     }
   }
 
+  if (CTX->Embedded) {
+    // Embedder exits. Break ops (guest exceptions, SYSCALL and INT 0x80)
+    // arrive through the GuestSignal pointers with SynchronousFaultData and
+    // RIP stored; budget, fault and unsupported exits set their own reason.
+    EmbedderBreakAddress = GetCursorAddress<uint64_t>();
+    LoadConstant(ARMEmitter::Size::i32Bit, TMP1, FEXCore::Core::EMBEDDER_EXIT_BREAK);
+    str(TMP1.W(), STATE_PTR(CpuStateFrame, Embedder.ExitReason));
+
+    EmbedderExitAddress = GetCursorAddress<uint64_t>();
+    SpillStaticRegs(TMP1);
+
+    EmbedderExitNoSpillAddress = GetCursorAddress<uint64_t>();
+    ldr(ARMEmitter::XReg::x0, STATE_PTR(CpuStateFrame, ReturningStackLocation));
+    add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::r0, 0);
+    PopCalleeSavedRegisters();
+    ret();
+
+    // Shared TLB-miss path. x0 = guest address, x1 = access info, x2 = resume.
+    // Returns to x2 with the host address in x0, or leaves the dispatch with
+    // the state spilled when the helper recorded a fault.
+    ARMEmitter::ForwardLabel l_Fault;
+    EmbedderTLBMissAddress = GetCursorAddress<uint64_t>();
+    stp<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::x2, ARMEmitter::XReg::x30, ARMEmitter::Reg::rsp, -16);
+    // The miss lands inside an op, where the register allocator may hold any
+    // 64-bit value in the PF and AF registers; the state spill keeps only
+    // their low halves.
+    stp<ARMEmitter::IndexType::PRE>(REG_PF.X(), REG_AF.X(), ARMEmitter::Reg::rsp, -16);
+    PushDynamicRegs(TMP4);
+    SpillStaticRegs(TMP4);
+    mov(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r2, ARMEmitter::Reg::r1);
+    mov(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, ARMEmitter::Reg::r0);
+    mov(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r0, STATE.R());
+    ldr(ARMEmitter::XReg::x3, STATE_PTR(CpuStateFrame, Pointers.EmbedderTLBMissHelper));
+    blr(ARMEmitter::Reg::r3);
+    (void)cbz(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r0, &l_Fault);
+    FillStaticRegs();
+    PopDynamicRegs();
+    ldp<ARMEmitter::IndexType::POST>(REG_PF.X(), REG_AF.X(), ARMEmitter::Reg::rsp, 16);
+    ldp<ARMEmitter::IndexType::POST>(ARMEmitter::XReg::x2, ARMEmitter::XReg::x30, ARMEmitter::Reg::rsp, 16);
+    br(ARMEmitter::Reg::r2);
+
+    (void)Bind(&l_Fault);
+    // The static registers were spilled above, so the state is the guest's at
+    // the start of the faulting instruction.
+    ldr(ARMEmitter::XReg::x0, STATE_PTR(CpuStateFrame, ReturningStackLocation));
+    add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::r0, 0);
+    PopCalleeSavedRegisters();
+    ret();
+  }
+
   {
