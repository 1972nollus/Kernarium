+void Arm64JITCore::EmitEmbedderUnsupported(const char* What) {
+  // Reaching an operation the embedded backend cannot run leaves the dispatch
+  // at the instruction, reported to the host, instead of touching host memory.
+  LogMan::Msg::EFmt("Embedded JIT: unsupported {} at RIP {:#x}", What, EmbedderCurrentRIP);
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, EmbedderCurrentRIP);
+  str(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.rip));
+  LoadConstant(ARMEmitter::Size::i32Bit, TMP1, Core::EMBEDDER_EXIT_UNSUPPORTED);
+  str(TMP1.W(), STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.ExitReason));
+  ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.EmbedderExit));
+  br(TMP1);
+}
