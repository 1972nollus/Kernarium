+bool Arm64JITCore::Embedded() const {
+  return CTX->Embedded;
+}
+
+ARMEmitter::Register Arm64JITCore::EmbedderTranslate(ARMEmitter::Register Address, uint32_t Size, uint64_t Flags,
+                                                     std::function<void(ARMEmitter::Register)> PreStore) {
+  LOGMAN_THROW_A_FMT(Address != TMP1 && Address != TMP2 && Address != TMP3, "Translation temporaries would clobber the address");
+  LOGMAN_THROW_A_FMT(Size > 0 && Size <= 64, "Unexpected access size {}", Size);
+
+  auto Site = fextl::make_unique<EmbedderColdSite>();
+  Site->Address = Address;
+  Site->Info = Size | Flags;
+  Site->GuestRIP = EmbedderCurrentRIP;
+  Site->PreStore = std::move(PreStore);
+
+  constexpr uint32_t PageBits = 12;
+  const bool Write = (Flags & (Core::EMBEDDER_ACCESS_WRITE | Core::EMBEDDER_ACCESS_ATOMIC | Core::EMBEDDER_ACCESS_READ_WRITE)) != 0;
+
+  // An access that leaves its guest page always takes the host path. Atomic
+  // and ordered accesses must also stay in one 16-byte granule, which FEAT_LSE2
+  // makes single-copy atomic; the host reports one that does not.
+  const bool Granule = (Flags & (Core::EMBEDDER_ACCESS_ATOMIC | Core::EMBEDDER_ACCESS_ORDERED)) != 0;
+  const uint32_t BoundaryBits = Granule ? 4 : PageBits;
+  if (Size > 1) {
+    ubfx(ARMEmitter::Size::i64Bit, TMP2, Address, 0, BoundaryBits);
+    add(ARMEmitter::Size::i64Bit, TMP2, TMP2, Size - 1);
+    if (RequiresFarARM64Jumps) {
+      lsr(ARMEmitter::Size::i64Bit, TMP2, TMP2, BoundaryBits);
+      cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP2, &Site->Entry);
+    } else if (tbnz(TMP2, BoundaryBits, &Site->Entry) != ARMEmitter::BranchEncodeSucceeded::Success) {
+      FEXCore::UncheckedLongJump::LongJump(ThreadState->RestartJump, FEXCore::ToUnderlying(RestartOptions::Control::EnableFarARM64Jumps));
+    }
+  }
+
+  // Flags are live across every access, so nothing here may set NZCV.
+  ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.TLB));
+  ubfx(ARMEmitter::Size::i64Bit, TMP2, Address, PageBits, Core::EMBEDDER_TLB_BITS);
+  add(ARMEmitter::Size::i64Bit, TMP1, TMP1, TMP2, ARMEmitter::ShiftType::LSL, 5);
+  ldp<ARMEmitter::IndexType::OFFSET>(TMP2, TMP3, TMP1, Write ? 16 : 0);
+  eon(ARMEmitter::Size::i64Bit, TMP2, TMP2, Address, ARMEmitter::ShiftType::LSR, PageBits);
+  cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP2, &Site->Entry);
+  add(ARMEmitter::Size::i64Bit, TMP1, Address, TMP3);
+  (void)Bind(&Site->Resume);
+
+  EmbedderColdSites.push_back(std::move(Site));
+  return TMP1;
+}
+
+ARMEmitter::Register Arm64JITCore::EmbedderTranslate(ARMEmitter::Register Base, IR::OrderedNodeWrapper Offset, IR::MemOffsetType OffsetType,
+                                                     uint8_t OffsetScale, IR::OpSize AccessSize, uint32_t Size, uint64_t Flags,
+                                                     std::function<void(ARMEmitter::Register)> PreStore) {
+  auto Address = ApplyMemOperand(AccessSize, Base, TMP4, Offset, OffsetType, OffsetScale);
+  return EmbedderTranslate(Address, Size, Flags, std::move(PreStore));
+}
+
+void Arm64JITCore::EmitEmbedderColdSites() {
+  const auto BounceOffset = offsetof(FEXCore::Core::CpuStateFrame, Embedder.Bounce);
+
+  for (auto& Site : EmbedderColdSites) {
+    // A block too large for a short branch to reach its cold code is
+    // compiled again with far branches.
+    BindOrRestart(&Site->Entry);
+
+    if (Site->PreStore) {
+      // Put the value where the host can complete a page-crossing store from.
+      LoadConstant(ARMEmitter::Size::i64Bit, TMP2, BounceOffset);
+      add(ARMEmitter::Size::i64Bit, TMP2, STATE, TMP2);
+      Site->PreStore(TMP2);
+    }
+
+    if (Site->Address != TMP1) {
+      mov(ARMEmitter::Size::i64Bit, TMP1, Site->Address);
+    }
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP4, Site->GuestRIP);
+    str(TMP4, STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.AccessRIP));
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP2, Site->Info);
+    adr_OrRestart(TMP3, &Site->Resume);
+    ldr(TMP4, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.EmbedderTLBMiss));
+    br(TMP4);
+  }
+
+  EmbedderColdSites.clear();
+
+  for (auto& Site : EmbedderBudgetSites) {
+    // A block too large for a short branch to reach its cold code is
+    // compiled again with far branches.
+    BindOrRestart(&Site->Entry);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Site->GuestRIP);
+    str(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.rip));
+    if (Site->FaultData) {
+      LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Site->FaultData);
+      str(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, SynchronousFaultData));
+    }
+    LoadConstant(ARMEmitter::Size::i32Bit, TMP1, Site->ExitReason);
+    str(TMP1.W(), STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.ExitReason));
+    ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.EmbedderExit));
+    br(TMP1);
+  }
+  EmbedderBudgetSites.clear();
+
+  for (auto& Site : EmbedderLoopSites) {
+    // No NZCV writes: the loop's condition flags are live.
+    // A block too large for a short branch to reach its cold code is
+    // compiled again with far branches.
+    BindOrRestart(&Site->Entry);
+    ARMEmitter::ForwardLabel Exhausted;
+    ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.Budget));
+    sub(ARMEmitter::Size::i64Bit, TMP1, TMP1, 1);
+    (void)tbnz(TMP1, 63, &Exhausted);
+    str(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.Budget));
+    b_OrRestart(Site->Target);
+    (void)Bind(&Exhausted);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Site->GuestRIP);
+    str(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.rip));
+    LoadConstant(ARMEmitter::Size::i32Bit, TMP1, Site->ExitReason);
+    str(TMP1.W(), STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.ExitReason));
+    ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.EmbedderExit));
+    br(TMP1);
+  }
+  EmbedderLoopSites.clear();
+}
+
+Arm64JITCore::EmbedderLoopSite* Arm64JITCore::EmbedderLoopBranch(ARMEmitter::BiDirectionalLabel* Target) {
+  if (!Embedded() || !Target->Backward.Location) {
+    return nullptr;
+  }
+  auto Site = fextl::make_unique<EmbedderLoopSite>();
+  Site->Target = Target;
+  Site->GuestRIP = EmbedderCurrentRIP;
+  Site->ExitReason = Core::EMBEDDER_EXIT_YIELD;
+  if (Target >= JumpTargets.data() && Target < JumpTargets.data() + JumpTargets.size()) {
+    if (const auto TargetRIP = EmbedderBlockRIPs[Target - JumpTargets.data()]) {
+      Site->GuestRIP = TargetRIP;
+      Site->ExitReason = Core::EMBEDDER_EXIT_BUDGET;
+    }
+  }
+  auto* Result = Site.get();
+  EmbedderLoopSites.push_back(std::move(Site));
+  return Result;
+}
+
+void Arm64JITCore::EmitEmbedderBudgetCheck(uint64_t GuestRIP) {
+  // Spend this block's instructions; a block the budget cannot cover is not
+  // started. No NZCV writes: guest flags are live here.
+  auto Site = fextl::make_unique<EmbedderBudgetSite>();
+  Site->GuestRIP = GuestRIP;
+  Site->ExitReason = Core::EMBEDDER_EXIT_BUDGET;
+  const uint32_t Cost = std::clamp<uint32_t>(EmbedderBlockInstructions, 1, 4095);
+  ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.Budget));
+  sub(ARMEmitter::Size::i64Bit, TMP1, TMP1, Cost);
+  if (RequiresFarARM64Jumps) {
+    lsr(ARMEmitter::Size::i64Bit, TMP2, TMP1, 63);
+    cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP2, &Site->Entry);
+  } else if (tbnz(TMP1, 63, &Site->Entry) != ARMEmitter::BranchEncodeSucceeded::Success) {
+    FEXCore::UncheckedLongJump::LongJump(ThreadState->RestartJump, FEXCore::ToUnderlying(RestartOptions::Control::EnableFarARM64Jumps));
+  }
+  str(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.Budget));
+  EmbedderBudgetSites.push_back(std::move(Site));
+}
+
+void Arm64JITCore::EmitEmbedderDivide(bool Signed, IR::OpSize OpSize, ARMEmitter::Register Lower, std::optional<ARMEmitter::Register> Upper,
+                                      ARMEmitter::Register Divisor, ARMEmitter::Register Quotient, ARMEmitter::Register Remainder) {
+  // x86 DIV and IDIV raise #DE, before writing anything, for a zero divisor
+  // and for a quotient that does not fit the destination. The frontend emits
+  // these forms only for them and for AAM, whose quotient always fits: DIV
+  // r/m8 as a 16-bit UDiv and IDIV r/m8 as a 64-bit Div, both without Upper,
+  // and the wider forms with Upper. The quotient is formed and checked in a
+  // temporary, because the register allocator may give an output the
+  // architectural register the exit would report.
+  using ARMEmitter::Size;
+  auto Site = fextl::make_unique<EmbedderBudgetSite>();
+  Site->GuestRIP = EmbedderCurrentRIP;
+  Site->ExitReason = Core::EMBEDDER_EXIT_BREAK;
+  Core::CpuStateFrame::SynchronousFaultDataStruct Fault = {
+    .FaultToTopAndGeneratedException = 1,
+    .Signal = Core::EMBEDDER_SIGNAL_DIVIDE,
+    .TrapNo = X86State::X86_TRAPNO_DE,
+    .si_code = 0,
+    .err_code = 0,
+  };
+  memcpy(&Site->FaultData, &Fault, sizeof(Fault));
+  auto* DivideError = &Site->Entry;
+  EmbedderBudgetSites.push_back(std::move(Site));
+
+  cbz_OrRestart(OpSize == IR::OpSize::i64Bit ? Size::i64Bit : Size::i32Bit, Divisor, DivideError);
+
+  // Checks the quotient in TMP1 against Bits signed or unsigned bits.
+  const auto CheckQuotient = [&](Size EmitSize, unsigned Bits) {
+    if (Signed) {
+      sbfx(EmitSize, TMP2, TMP1, 0, Bits);
+      eor(EmitSize, TMP2, TMP2, TMP1);
+    } else {
+      lsr(EmitSize, TMP2, TMP1, Bits);
+    }
+    cbnz_OrRestart(EmitSize, TMP2, DivideError);
+  };
+  // TMP1 holds the quotient; Dividend and DivisorReg are what it came from.
+  const auto Finish = [&](Size EmitSize, ARMEmitter::Register Dividend, ARMEmitter::Register DivisorReg) {
+    msub(EmitSize, Remainder, TMP1, DivisorReg, Dividend);
+    mov(Size::i64Bit, Quotient, TMP1);
+  };
+
+  if (!Upper) {
+    if (!Signed && OpSize == IR::OpSize::i16Bit) {
+      // DIV r/m8: AX by the zero-extended divisor into AL and AH.
+      udiv(Size::i32Bit, TMP1, Lower, Divisor);
+      CheckQuotient(Size::i32Bit, 8);
+      Finish(Size::i32Bit, Lower, Divisor);
+    } else if (Signed && OpSize == IR::OpSize::i64Bit) {
+      // IDIV r/m8: the sign-extended AX by the sign-extended divisor.
+      sdiv(Size::i64Bit, TMP1, Lower, Divisor);
+      CheckQuotient(Size::i64Bit, 8);
+      Finish(Size::i64Bit, Lower, Divisor);
+    } else {
+      // AAM, and any other form whose quotient fits its size.
+      const auto EmitSize = OpSize == IR::OpSize::i64Bit ? Size::i64Bit : Size::i32Bit;
+      ARMEmitter::Register Dividend = Lower;
+      ARMEmitter::Register DivisorReg = Divisor;
+      if (Signed && OpSize == IR::OpSize::i8Bit) {
+        sxtb(EmitSize, TMP3, Lower);
+        sxtb(EmitSize, TMP4, Divisor);
+        Dividend = TMP3;
+        DivisorReg = TMP4;
+      } else if (Signed && OpSize == IR::OpSize::i16Bit) {
+        sxth(EmitSize, TMP3, Lower);
+        sxth(EmitSize, TMP4, Divisor);
+        Dividend = TMP3;
+        DivisorReg = TMP4;
+      }
+      if (Signed) {
+        sdiv(EmitSize, TMP1, Dividend, DivisorReg);
+      } else {
+        udiv(EmitSize, TMP1, Dividend, DivisorReg);
+      }
+      Finish(EmitSize, Dividend, DivisorReg);
+    }
+    return;
+  }
+
+  switch (OpSize) {
+  case IR::OpSize::i16Bit: {
+    // DX:AX by a 16-bit divisor, in 32 bits.
+    uxth(Size::i32Bit, TMP3, Lower);
+    bfi(Size::i32Bit, TMP3, *Upper, 16, 16);
+    if (Signed) {
+      sxth(Size::i32Bit, TMP4, Divisor);
+      sdiv(Size::i32Bit, TMP1, TMP3, TMP4);
+    } else {
+      uxth(Size::i32Bit, TMP4, Divisor);
+      udiv(Size::i32Bit, TMP1, TMP3, TMP4);
+    }
+    CheckQuotient(Size::i32Bit, 16);
+    Finish(Size::i32Bit, TMP3, TMP4);
+    break;
+  }
+  case IR::OpSize::i32Bit: {
+    // EDX:EAX by a 32-bit divisor, in 64 bits.
+    mov(Size::i64Bit, TMP3, Lower);
+    bfi(Size::i64Bit, TMP3, *Upper, 32, 32);
+    if (Signed) {
+      sxtw(TMP4, Divisor.W());
+      sdiv(Size::i64Bit, TMP1, TMP3, TMP4);
+    } else {
