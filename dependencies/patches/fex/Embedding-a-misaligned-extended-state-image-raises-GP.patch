From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 6 Oct 2026 22:02:15 +0900
Subject: [PATCH] Embedding: a misaligned extended-state image raises #GP

FXSAVE and FXRSTOR require their image aligned to 16 bytes, and XSAVE,
XSAVEOPT and XRSTOR to 64; x86 raises #GP(0) at the instruction for an
image that is not, before it accesses it, whatever RFLAGS.AC holds.
Embedded, each now checks its address first and breaks with that fault.
---
 .../Source/Interface/Core/OpcodeDispatcher.h  |  4 +++
 .../Core/OpcodeDispatcher/Vector.cpp          | 29 +++++++++++++++++++
 2 files changed, 33 insertions(+)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index 73d3118859f297027a5b1c3613aefb05be827030..e481889592d4f2590448f406bbab8ac74a18756d 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -1489,6 +1489,10 @@ private:
                             uint32_t Imm = 0, uint32_t Flags = 0);
   // Embedded, while RFLAGS.AC is set: an EmbedderAlignmentCheck op.
   void EmbedderAlignmentCheck(Ref Addr, uint32_t Alignment, bool Exempt);
+  // Embedded: raises #GP(0) at the instruction unless Addr is a multiple of
+  // Alignment, as FXSAVE, FXRSTOR, XSAVE and XRSTOR do for their image. It
+  // ends the block, so the caller computes its values after it.
+  void EmbedderRequireAlignment(OpcodeArgs, Ref Addr, uint32_t Alignment);
   // Embedded, while the x87 control word unmasks an exception: x87 checks.
   bool EmbedderX87Checks() const;
   // With x87 checks, EmbedderX87Commit(Mask).
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
index 8403bd88d1054d5673ec70724fae536e889ca133..d100bbb137019fea7ceba485cd9d0cd0a78e0a12 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
@@ -775,6 +775,30 @@ void OpDispatchBuilder::EmbedderAlignmentCheck(Ref Addr, uint32_t Alignment, boo
   }
 }
 
+void OpDispatchBuilder::EmbedderRequireAlignment(OpcodeArgs, Ref Addr, uint32_t Alignment) {
+  if (!CTX->Embedded) {
+    return;
+  }
+  Ref Misaligned = _And(OpSize::i64Bit, Addr, Constant(Alignment - 1));
+  CalculateDeferredFlags();
+  auto CondJump_ = CondJump(Misaligned, CondClass::NEQ);
+  auto FaultBlock = CreateNewCodeBlockAfter(GetCurrentBlock());
+  SetTrueJumpTarget(CondJump_, FaultBlock);
+  SetCurrentCodeBlock(FaultBlock);
+  StartNewBlock();
+  _StoreContextGPR(GetGPROpSize(), GetRelocatedPC(Op, -Op->InstSize), offsetof(FEXCore::Core::CPUState, rip));
+  Break({
+    .ErrorRegister = 0,
+    .Signal = Core::FAULT_SIGSEGV,
+    .TrapNumber = X86State::X86_TRAPNO_GP,
+    .si_code = 0x80,
+  });
+  auto NextBlock = CreateNewCodeBlockAfter(FaultBlock);
+  SetFalseJumpTarget(CondJump_, NextBlock);
+  SetCurrentCodeBlock(NextBlock);
+  StartNewBlock();
+}
+
