From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 9 Oct 2026 23:28:28 +0900
Subject: [PATCH] Embedding: a reserved MXCSR bit raises #GP

MXCSR_MASK is 0xFFFF, and LDMXCSR, VLDMXCSR and FXRSTOR raise #GP(0)
for an image or operand with a bit above it set, before they change
anything. Embedded, they masked the bits off and loaded the rest. A new
EmbedderRaiseGP op leaves the dispatch with #GP(0) at the instruction
when its operand is not zero, with the stack pointer, registers and
flags as the instruction found them; FXRSTOR checks the MXCSR it would
load once it has read the whole image.
---
 .../Interface/Core/JIT/EmbedderMemory.cpp     | 20 +++++++++++++++++++
 .../Source/Interface/Core/OpcodeDispatcher.h  |  4 ++++
 .../Core/OpcodeDispatcher/Vector.cpp          | 17 ++++++++++++++--
 FEXCore/Source/Interface/IR/IR.json           |  7 +++++++
 .../IR/Passes/RegisterAllocationPass.cpp      |  1 +
 5 files changed, 47 insertions(+), 2 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/JIT/EmbedderMemory.cpp b/FEXCore/Source/Interface/Core/JIT/EmbedderMemory.cpp
index 8fa607a4c13b9ffcbcc855f712664bb10e7e710b..e35ee124dc8ee4e55c6003c69a944372b93da5ed 100644
--- a/FEXCore/Source/Interface/Core/JIT/EmbedderMemory.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/EmbedderMemory.cpp
@@ -128,6 +128,26 @@ DEF_OP(EmbedderProbe) {
   (void)EmbedderTranslate(TMP4, 1, 0);
 }
 
+DEF_OP(EmbedderRaiseGP) {
+  const auto Op = IROp->C<IR::IROp_EmbedderRaiseGP>();
+  LOGMAN_THROW_A_FMT(Embedded(), "EmbedderRaiseGP outside embedding");
+  auto Site = fextl::make_unique<EmbedderBudgetSite>();
+  Site->GuestRIP = EmbedderCurrentRIP;
+  Site->ExitReason = Core::EMBEDDER_EXIT_BREAK;
+  Site->Unretired = EmbedderUnretired(false);
+  const Core::CpuStateFrame::SynchronousFaultDataStruct Fault = {
+    .FaultToTopAndGeneratedException = 1,
+    .Signal = Core::FAULT_SIGSEGV,
+    .TrapNo = X86State::X86_TRAPNO_GP,
+    .si_code = 0x80,
+    .err_code = 0,
+  };
+  memcpy(&Site->FaultData, &Fault, sizeof(Fault));
+  auto* Entry = &Site->Entry;
+  EmbedderBudgetSites.push_back(std::move(Site));
+  cbnz_OrRestart(ARMEmitter::Size::i32Bit, GetReg(Op->Value), Entry);
+}
+
 void Arm64JITCore::EmbedderAtomic(ARMEmitter::Register Address, uint32_t Size, std::function<void(ARMEmitter::Register)> Op) {
   const auto Host = EmbedderTranslate(Address, Size, Core::EMBEDDER_ACCESS_ATOMIC);
   auto* Site = EmbedderColdSites.back().get();
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index 5b81a1888ae4488379addd49293ac004ef42e391..98b6c7cef5d28dc2ba34c7550f29fe2bb52cbad0 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -1519,6 +1519,10 @@ private:
   // Alignment, as FXSAVE, FXRSTOR, XSAVE and XRSTOR do for their image. It
   // ends the block, so the caller computes its values after it.
   void EmbedderRequireAlignment(OpcodeArgs, Ref Addr, uint32_t Alignment);
+  // Embedded: raises #GP(0), with nothing changed, when MXCSR has a reserved
+  // bit set, as LDMXCSR, FXRSTOR and XRSTOR do. Selected, if given, is 1 when
+  // the instruction loads MXCSR at all and 0 when it does not.
+  void EmbedderCheckMXCSR(Ref MXCSR, Ref Selected = nullptr);
   // Embedded: faults as a read of the byte at Addr, as CLFLUSH, CLFLUSHOPT and CLWB do.
   void EmbedderCacheLineProbe(Ref Addr);
   // Embedded, while the x87 control word unmasks an exception: x87 checks.
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
index b63368a043cbef172b9dfc9f440236d71453b419..6f3c5763ae1e791cf0e9e6d09f235a16f1f6c847 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
@@ -837,6 +837,17 @@ void OpDispatchBuilder::EmbedderRequireAlignment(OpcodeArgs, Ref Addr, uint32_t
   StartNewBlock();
 }
 
+void OpDispatchBuilder::EmbedderCheckMXCSR(Ref MXCSR, Ref Selected) {
+  if (!CTX->Embedded) {
+    return;
+  }
+  Ref Reserved = _And(OpSize::i32Bit, MXCSR, Constant(~MXCSRMask()));
+  if (Selected) {
+    Reserved = _And(OpSize::i32Bit, Reserved, _Sub(OpSize::i32Bit, Constant(0), Selected));
+  }
+  _EmbedderRaiseGP(Reserved);
+}
+
 Ref OpDispatchBuilder::EmbedderFPResult(Ref Result, uint32_t Descriptor, Ref Source1, Ref Source2, Ref Source3) {
   if (!EmbedderFPChecks(static_cast<Core::EmbedderFPKind>(Descriptor & 0xFF))) {
     return Result;
@@ -3509,10 +3520,11 @@ void OpDispatchBuilder::FXRStoreOp(OpcodeArgs) {
     _EmbedderProbe(Mem, 512);
   }
 
+  Ref MXCSR = _LoadMemGPR(OpSize::i32Bit, Mem, Constant(24), OpSize::i32Bit, MemOffsetType::SXTX, 1);
+  EmbedderCheckMXCSR(MXCSR);
+
   RestoreX87State(Mem);
   RestoreSSEState(Mem);
-
-  Ref MXCSR = _LoadMemGPR(OpSize::i32Bit, Mem, Constant(24), OpSize::i32Bit, MemOffsetType::SXTX, 1);
   RestoreMXCSRState(MXCSR);
   EmbedderFPModeCheck(Op);
 }
@@ -3741,6 +3753,7 @@ void OpDispatchBuilder::UCOMISxOp(OpcodeArgs, IR::OpSize ElementSize) {
 
 void OpDispatchBuilder::LDMXCSR(OpcodeArgs) {
   Ref Dest = LoadSourceGPR_WithOpSize(Op, Op->Dest, OpSize::i32Bit, Op->Flags);
+  EmbedderCheckMXCSR(Dest);
   RestoreMXCSRState(Dest);
   EmbedderFPModeCheck(Op);
 }
