   const uint8_t MaskWidth = Op->Src[1].Literal() & 0x3F;
   const uint8_t Shift = (Op->Src[1].Literal() >> 8) & 0x3F;
 
@@ -6124,6 +6146,12 @@ void OpDispatchBuilder::Insertq_imm(OpcodeArgs) {
 }
 
 void OpDispatchBuilder::Extrq(OpcodeArgs) {
+  // SSE4a is an AMD extension that an Intel core raises #UD for.
+  if (CTX->Embedded) {
+    UnimplementedOp(Op);
+    return;
+  }
+
   Ref Dest = LoadSourceFPR(Op, Op->Dest, Op->Flags);
   Ref Src = LoadSourceFPR(Op, Op->Src[0], Op->Flags);
 
@@ -6149,6 +6177,12 @@ void OpDispatchBuilder::Extrq(OpcodeArgs) {
 }
 
 void OpDispatchBuilder::Insertq(OpcodeArgs) {
+  // SSE4a is an AMD extension that an Intel core raises #UD for.
+  if (CTX->Embedded) {
+    UnimplementedOp(Op);
+    return;
+  }
+
   Ref Dest = LoadSourceFPR(Op, Op->Dest, Op->Flags);
   Ref Src = LoadSourceFPR(Op, Op->Src[0], Op->Flags);
 
