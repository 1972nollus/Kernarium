index b82c6f9136eb66ad761fced628506878028c5040..1b0b6a24cbffeaf0f3f1df5283daf6939e929900 100644
--- a/FEXCore/Source/Interface/Core/JIT/EmbedderFloat.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/EmbedderFloat.cpp
@@ -602,17 +602,6 @@ DEF_OP(EmbedderSaveFPFlags) {
   str(TMP1.W(), STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.FPSRPart));
 }
 
-DEF_OP(EmbedderReadFPSR) {
-  LOGMAN_THROW_A_FMT(Embedded(), "EmbedderReadFPSR outside embedding");
-  mrs(GetReg(Node), ARMEmitter::SystemRegister::FPSR);
-}
-
-DEF_OP(EmbedderWriteFPSR) {
-  const auto Op = IROp->C<IR::IROp_EmbedderWriteFPSR>();
-  LOGMAN_THROW_A_FMT(Embedded(), "EmbedderWriteFPSR outside embedding");
-  msr(ARMEmitter::SystemRegister::FPSR, GetReg(Op->Value));
-}
-
 DEF_OP(EmbedderRaiseInexact) {
   const auto Op = IROp->C<IR::IROp_EmbedderRaiseInexact>();
   LOGMAN_THROW_A_FMT(Embedded(), "EmbedderRaiseInexact outside embedding");
