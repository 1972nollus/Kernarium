@@ -42,6 +42,16 @@ void OpDispatchBuilder::MOVVectorUnalignedOp(OpcodeArgs) {
   StoreResult_WithAVXInsert(VectorOpType::SSE, RegClass::FPR, Op, Src);
 }
 
+// MOVNTSS and MOVNTSD are SSE4a, an AMD extension that an Intel core raises
+// #UD for.
+void OpDispatchBuilder::MOVNTScalarOp(OpcodeArgs) {
+  if (CTX->Embedded) {
+    UnimplementedOp(Op);
+    return;
+  }
+  MOVVectorNTOp(Op, false);
+}
+
 void OpDispatchBuilder::MOVVectorNTOp(OpcodeArgs, bool IsAVX) {
   const auto Size = OpSizeFromDst(Op);
 
@@ -6082,6 +6092,12 @@ void OpDispatchBuilder::VPGATHER(OpcodeArgs, OpSize AddrElementSize) {
 }
 
 void OpDispatchBuilder::Extrq_imm(OpcodeArgs) {
+  // SSE4a is an AMD extension that an Intel core raises #UD for.
+  if (CTX->Embedded) {
+    UnimplementedOp(Op);
+    return;
+  }
+
   const uint8_t MaskWidth = Op->Src[1].Literal() & 0x3F;
   const uint8_t Shift = (Op->Src[1].Literal() >> 8) & 0x3F;
 
@@ -6099,6 +6115,12 @@ void OpDispatchBuilder::Extrq_imm(OpcodeArgs) {
 }
 
