From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 9 Oct 2026 23:17:37 +0900
Subject: [PATCH] Embedding: AMD's 3DNow! and SSE4a raise #UD

An Intel core has no 3DNow!, FEMMS, EXTRQ, INSERTQ, MOVNTSS or MOVNTSD
and raises #UD for each, whatever the guest's CPUID reports. Embedded,
the decoder refuses every 0F 0F encoding, and FEMMS, EXTRQ, INSERTQ,
MOVNTSS and MOVNTSD are undefined instructions. The FPSR and MXCSR a
3DNow! instruction used to put back, and the IR ops that carried them,
go with it.
---
 FEXCore/Source/Interface/Core/Core.cpp        | 15 --------
 FEXCore/Source/Interface/Core/Frontend.cpp    |  4 +++
 .../Interface/Core/JIT/EmbedderFloat.cpp      | 11 ------
 .../Source/Interface/Core/OpcodeDispatcher.h  |  2 ++
 .../Core/OpcodeDispatcher/SecondaryTables.h   |  6 ++--
 .../Core/OpcodeDispatcher/Vector.cpp          | 34 +++++++++++++++++++
 .../Interface/Core/OpcodeDispatcher/X87.cpp   |  9 +++++
 FEXCore/Source/Interface/IR/IR.json           | 11 ------
 8 files changed, 52 insertions(+), 40 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 87cf6ef9f4f83c7a2aec840e0397d38c053e738c..3b4437b8a1197d3871f7db5357c5fa6280f1a8cd 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -702,22 +702,7 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
           if (Embedded && !BlockInfo->Is64BitMode) {
             Thread->OpDispatcher->EmbedderSegmentCheck(DecodedInfo);
           }
-          // Embedded: MXCSR does not govern 3DNow!, whose host arithmetic
-          // and checks leave the guest's MXCSR flags, in FPSR and in the
-          // state, as they were.
-          const auto& DDDNow = FEXCore::X86Tables::DDDNowOps;
-          const bool Is3DNow = Embedded && TableInfo >= DDDNow.data() && TableInfo < DDDNow.data() + DDDNow.size();
-          IR::Ref SavedFPSR {};
-          IR::Ref SavedMXCSR {};
-          if (Is3DNow) {
-            SavedFPSR = Thread->OpDispatcher->_EmbedderReadFPSR();
-            SavedMXCSR = Thread->OpDispatcher->_LoadContextGPR(IR::OpSize::i32Bit, offsetof(FEXCore::Core::CPUState, mxcsr));
-          }
           std::invoke(Fn, Thread->OpDispatcher, DecodedInfo);
-          if (Is3DNow) {
-            Thread->OpDispatcher->_EmbedderWriteFPSR(SavedFPSR);
-            Thread->OpDispatcher->_StoreContextGPR(IR::OpSize::i32Bit, SavedMXCSR, offsetof(FEXCore::Core::CPUState, mxcsr));
-          }
           if (Embedded) {
             Thread->OpDispatcher->EmbedderFPEndInstruction();
           }
diff --git a/FEXCore/Source/Interface/Core/Frontend.cpp b/FEXCore/Source/Interface/Core/Frontend.cpp
index 9b836702582497a1dfcf067d48c933fb18a1100f..b9517213b1e05e4df01cccd17cf6808b83e76687 100644
--- a/FEXCore/Source/Interface/Core/Frontend.cpp
+++ b/FEXCore/Source/Interface/Core/Frontend.cpp
@@ -908,6 +908,10 @@ Decoder::DecodedBlockStatus Decoder::DecodeInstructionImpl(uint64_t PC) {
       switch (EscapeOp) {
       case 0x0F:
         [[unlikely]] { // 3DNow!
+          // 3DNow! is AMD's, and an Intel core raises #UD for every encoding.
+          if (CTX->Embedded) {
+            return DecodedBlockStatus::INVALID_INST;
+          }
           DecodeREXIfValid(-2);
           // 3DNow! Instruction Encoding: 0F 0F [ModRM] [SIB] [Displacement] [Opcode]
           // Decode ModRM
