+++ b/FEXCore/Source/Interface/Core/JIT/JITClass.h
@@ -167,6 +167,17 @@ private:
   // charges the budget for, and their offsets from the entry in order.
   uint32_t EmbedderBlockInstructions {};
   fextl::vector<uint32_t> EmbedderInstructionOffsets;
+  // By node ID, the loads of the unit that read what a store of the same
+  // instruction then writes. They take write permission, so a fault of the
+  // read-modify-write, a copy-on-write page among them, comes before the
+  // instruction has changed a register or a flag.
