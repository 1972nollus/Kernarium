           EmbedderInstructionOffsets.push_back(IROp->C<IR::IROp_GuestOpcode>()->GuestEntryOffset);
+          Loads.clear();
         }
+        EmbedderFindReadsForWrite(CodeNode, IROp, Loads);
       }
     }
     std::sort(EmbedderInstructionOffsets.begin(), EmbedderInstructionOffsets.end());
