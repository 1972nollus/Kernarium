   EmbedderInstructionOffsets.clear();
+  EmbedderReadsForWrite.assign(SSACount, false);
   if (Embedded()) {
+    fextl::vector<IR::Ref> Loads;
     for (auto [BlockNode, BlockHeader] : IR->GetBlocks()) {
+      Loads.clear();
       for (auto [CodeNode, IROp] : IR->GetCode(BlockNode)) {
