+    const auto ID = IR->GetID(Node).Value;
+    return ID < EmbedderReadsForWrite.size() && EmbedderReadsForWrite[ID] ? Core::EMBEDDER_ACCESS_READ_WRITE : 0;
+  }
   // The instructions of the unit an exit at the current instruction leaves
   // unretired: that one and those after it, less that one when it retired, as
   // a trap's instruction has.
