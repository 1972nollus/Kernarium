   Ref SP = _RMWHandle(LoadGPRRegister(X86State::REG_RSP));
+  if (CTX->Embedded) {
+    // The whole frame is read before CS or the flags are loaded from it.
+    _EmbedderProbe(SP, IR::OpSizeToSize(GPRSize) * (Is64BitMode ? 5 : 3));
+  }
 
   // RIP (64/32/16 bits)
   auto NewRIP = Pop(GPRSize, SP);
@@ -458,6 +462,20 @@ void OpDispatchBuilder::PUSHSegmentOp(OpcodeArgs, uint32_t SegmentReg) {
 }
 
 void OpDispatchBuilder::POPOp(OpcodeArgs) {
+  if (CTX->Embedded && !Op->Dest.IsGPR()) {
+    // The destination's address is formed from the incremented RSP, but a
+    // faulting store must leave RSP as the instruction found it. The
+    // address takes a node of its own and RSP's update comes after the
+    // store, so the register allocator cannot give the incremented value
+    // RSP's static register before the store.
+    const auto Size = OpSizeFromSrc(Op);
+    Ref SP = LoadGPRRegister(X86State::REG_RSP);
+    Ref Value = _LoadMem(RegClass::GPR, Size, SP, Invalid(), OpSize::i8Bit, MemOffsetType::SXTX, 1);
+    StoreGPRRegister(X86State::REG_RSP, Add(OpSize::i64Bit, SP, IR::OpSizeToSize(Size)));
+    StoreResultGPR(Op, Value);
+    StoreGPRRegister(X86State::REG_RSP, Add(OpSize::i64Bit, SP, IR::OpSizeToSize(Size)));
+    return;
+  }
   Ref Value = Pop(OpSizeFromSrc(Op));
   StoreResultGPR(Op, Value);
 }
