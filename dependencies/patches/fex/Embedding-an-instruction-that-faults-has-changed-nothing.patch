+bool Arm64JITCore::EmbedderSameValue(IR::OrderedNodeWrapper A, IR::OrderedNodeWrapper B, unsigned Depth) const {
+  if (A.ID() == B.ID()) {
+    return true;
+  }
+  if (A.IsInvalid() || B.IsInvalid() || A.IsImmediate() || B.IsImmediate()) {
+    return false;
+  }
+  // The dispatcher forms an operand's address afresh for its load and its
+  // store, so the two may be equal values in distinct nodes. Only the pure
+  // operations an address is built from are compared.
+  const auto* OA = IR->GetOp<IR::IROp_Header>(A);
+  const auto* OB = IR->GetOp<IR::IROp_Header>(B);
+  if (OA->Op != OB->Op || OA->Size != OB->Size) {
+    return false;
+  }
+  switch (OA->Op) {
+  case IR::OP_CONSTANT: return OA->C<IR::IROp_Constant>()->Constant == OB->C<IR::IROp_Constant>()->Constant;
+  case IR::OP_INLINECONSTANT: return OA->C<IR::IROp_InlineConstant>()->Constant == OB->C<IR::IROp_InlineConstant>()->Constant;
+  case IR::OP_ENTRYPOINTOFFSET: return OA->C<IR::IROp_EntrypointOffset>()->Offset == OB->C<IR::IROp_EntrypointOffset>()->Offset;
+  case IR::OP_INLINEENTRYPOINTOFFSET:
+    return OA->C<IR::IROp_InlineEntrypointOffset>()->Offset == OB->C<IR::IROp_InlineEntrypointOffset>()->Offset;
+  case IR::OP_LOADCONTEXT: {
+    // A segment base, which no instruction that also stores memory changes.
+    const auto* CA = OA->C<IR::IROp_LoadContext>();
+    const auto* CB = OB->C<IR::IROp_LoadContext>();
+    return CA->Class == CB->Class && CA->Offset == CB->Offset;
+  }
+  case IR::OP_ADD:
+  case IR::OP_SUB:
+  case IR::OP_LSHL:
+    return Depth != 0 && EmbedderSameValue(OA->Args[0], OB->Args[0], Depth - 1) && EmbedderSameValue(OA->Args[1], OB->Args[1], Depth - 1);
+  case IR::OP_ADDSHIFT: {
+    const auto* SA = OA->C<IR::IROp_AddShift>();
+    const auto* SB = OB->C<IR::IROp_AddShift>();
+    return Depth != 0 && SA->Shift == SB->Shift && SA->ShiftAmount == SB->ShiftAmount &&
+           EmbedderSameValue(SA->Src1, SB->Src1, Depth - 1) && EmbedderSameValue(SA->Src2, SB->Src2, Depth - 1);
+  }
+  default: return false;
+  }
+}
+
+void Arm64JITCore::EmbedderFindReadsForWrite(IR::Ref CodeNode, const IR::IROp_Header* IROp, fextl::vector<IR::Ref>& Loads) {
+  // The loads and stores of one instruction; the caller clears the loads
+  // at each instruction.
+  if (IROp->Op == IR::OP_LOADMEM || IROp->Op == IR::OP_LOADMEMTSO) {
+    Loads.push_back(CodeNode);
+    return;
+  }
+  if (IROp->Op != IR::OP_STOREMEM && IROp->Op != IR::OP_STOREMEMTSO) {
+    return;
+  }
+  // LoadMem and LoadMemTSO, and StoreMem and StoreMemTSO, share a layout.
+  static_assert(offsetof(IR::IROp_LoadMem, Addr) == offsetof(IR::IROp_LoadMemTSO, Addr));
+  static_assert(offsetof(IR::IROp_LoadMem, OffsetScale) == offsetof(IR::IROp_LoadMemTSO, OffsetScale));
+  static_assert(offsetof(IR::IROp_StoreMem, Addr) == offsetof(IR::IROp_StoreMemTSO, Addr));
+  static_assert(offsetof(IR::IROp_StoreMem, OffsetScale) == offsetof(IR::IROp_StoreMemTSO, OffsetScale));
+  const auto* Store = IROp->C<IR::IROp_StoreMem>();
+  for (auto Load : Loads) {
+    const auto* LoadHeader = IR->GetOp<IR::IROp_Header>(Load);
+    const auto* Op = LoadHeader->C<IR::IROp_LoadMem>();
+    if (LoadHeader->Size == IROp->Size && Op->OffsetType == Store->OffsetType && Op->OffsetScale == Store->OffsetScale &&
+        EmbedderSameValue(Op->Addr, Store->Addr, 3) && EmbedderSameValue(Op->Offset, Store->Offset, 3)) {
+      EmbedderReadsForWrite[IR->GetID(Load).Value] = true;
+    }
+  }
+}
+
+DEF_OP(EmbedderProbe) {
+  const auto Op = IROp->C<IR::IROp_EmbedderProbe>();
+  const auto Addr = GetReg(Op->Addr);
+  LOGMAN_THROW_A_FMT(Embedded() && Op->Size > 0 && Op->Size <= 4096, "Unexpected probe of {} bytes", Op->Size);
+  // The first byte, then the start of the page the last byte is on, which
+  // is the first byte's page when the operand does not cross one: a fault
+  // names the first byte of the operand that is not readable.
+  (void)EmbedderTranslate(Addr, 1, 0);
+  add(ARMEmitter::Size::i64Bit, TMP4, Addr, Op->Size - 1);
+  and_(ARMEmitter::Size::i64Bit, TMP4, TMP4, ~uint64_t {0xFFF});
+  (void)EmbedderTranslate(TMP4, 1, 0);
+}
+
 void Arm64JITCore::EmbedderAtomic(ARMEmitter::Register Address, uint32_t Size, std::function<void(ARMEmitter::Register)> Op) {
   const auto Host = EmbedderTranslate(Address, Size, Core::EMBEDDER_ACCESS_ATOMIC);
   auto* Site = EmbedderColdSites.back().get();
