+inline Ref X87StackOptimization::X87FlagOr(uint32_t Flag, Ref Bit) {
+  const auto Offset = offsetof(FEXCore::Core::CPUState, flags) + Flag;
+  Ref Value = IREmit->_Or(OpSize::i32Bit, IREmit->_LoadContextGPR(OpSize::i8Bit, Offset), Bit);
+  IREmit->_StoreContextGPR(OpSize::i8Bit, Value, Offset);
+  return Value;
+}
+
+inline Ref X87StackOptimization::X87StackFault(Ref Value, Ref Fault, bool Overflow) {
+  // Branch-free and without NZCV, which holds the guest's flags.
+  X87FlagOr(FEXCore::X86State::X87FLAG_IE_LOC, Fault);
+  X87FlagOr(FEXCore::X86State::X87FLAG_SF_LOC, Fault);
+  if (Overflow) {
+    X87FlagOr(FEXCore::X86State::X87FLAG_C1_LOC, Fault);
+  } else {
+    const auto C1 = offsetof(FEXCore::Core::CPUState, flags) + FEXCore::X86State::X87FLAG_C1_LOC;
+    IREmit->_StoreContextGPR(OpSize::i8Bit, IREmit->_Andn(OpSize::i32Bit, IREmit->_LoadContextGPR(OpSize::i8Bit, C1), Fault), C1);
+  }
+  Ref FCW = IREmit->_LoadContextGPR(OpSize::i16Bit, offsetof(FEXCore::Core::CPUState, FCW));
+  Ref Unmasked = IREmit->_Andn(OpSize::i32Bit, Fault, FCW);
+  X87FlagOr(FEXCore::X86State::X87FLAG_ES_LOC, Unmasked);
+  X87FlagOr(FEXCore::X86State::X87FLAG_B_LOC, Unmasked);
+
+  Ref Indefinite = IREmit->_VCastFromGPR(OpSize::i128Bit, OpSize::i64Bit, IREmit->_Constant(0xC000'0000'0000'0000ULL));
+  Indefinite = IREmit->_VInsGPR(OpSize::i128Bit, OpSize::i64Bit, 1, Indefinite, IREmit->_Constant(0xFFFF));
+  Ref Mask = IREmit->_VDupFromGPR(OpSize::i128Bit, OpSize::i64Bit, IREmit->_Sub(OpSize::i64Bit, GetConstant(0), Fault));
+  return IREmit->_VBSL(OpSize::i128Bit, Mask, Indefinite, Value);
+}
+
+inline Ref X87StackOptimization::TwoResultOperand(Ref Operand, Ref Full) {
+  Ref Zero = IREmit->_VCastFromGPR(OpSize::i128Bit, OpSize::i64Bit, GetConstant(0));
+  Ref Mask = IREmit->_VDupFromGPR(OpSize::i128Bit, OpSize::i64Bit, IREmit->_Sub(OpSize::i64Bit, GetConstant(0), Full));
+  return IREmit->_VBSL(OpSize::i128Bit, Mask, Zero, Operand);
+}
+
