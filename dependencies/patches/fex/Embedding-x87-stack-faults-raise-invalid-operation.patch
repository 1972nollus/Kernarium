 }
 
 void OpDispatchBuilder::X87FXAM(OpcodeArgs) {
-  auto a = _ReadStackValue(0);
+  // FXAM classifies an empty register too, so its read is no stack underflow.
+  auto a = _ReadStackValue(0, true);
   Ref Result =
     ReducedPrecisionMode ? _VExtractToGPR(OpSize::i64Bit, OpSize::i64Bit, a, 0) : _VExtractToGPR(OpSize::i128Bit, OpSize::i64Bit, a, 1);
 
@@ -908,11 +909,26 @@ void OpDispatchBuilder::X87FXAM(OpcodeArgs) {
 }
 
 void OpDispatchBuilder::X87FXTRACT(OpcodeArgs) {
-  auto Top = _ReadStackValue(0);
+  Ref Top = _ReadStackValue(0);
+  Ref Full {};
+  Ref Mask {};
+  if (CTX->Embedded) {
+    // x86 checks the register the significand goes to first: on a full
+    // stack it computes nothing, and both results are the QNaN indefinite
+    // of the stack overflow the second push raises. 1.0 raises nothing.
+    Full = _StackValidTag(7);
+    Mask = _VDupFromGPR(OpSize::i128Bit, OpSize::i64Bit, _Sub(OpSize::i64Bit, Constant(0), Full));
+    Top = _VBSL(OpSize::i128Bit, Mask, LoadAndCacheNamedVectorConstant(OpSize::i128Bit, NamedVectorConstant::NAMED_VECTOR_X87_ONE), Top);
+  }
 
   _PopStackDestroy();
-  auto Exp = _F80XTRACT_EXP(Top);
-  auto Sig = _F80XTRACT_SIG(Top);
+  Ref Exp = _F80XTRACT_EXP(Top);
+  Ref Sig = _F80XTRACT_SIG(Top);
+  if (Mask) {
+    Ref Indefinite = _VCastFromGPR(OpSize::i128Bit, OpSize::i64Bit, Constant(0xC000'0000'0000'0000ULL));
+    Indefinite = _VInsGPR(OpSize::i128Bit, OpSize::i64Bit, 1, Indefinite, Constant(0xFFFF));
+    Exp = _VBSL(OpSize::i128Bit, Mask, Indefinite, Exp);
+  }
   _PushStack(Exp, Invalid(), OpSize::iInvalid);
   _PushStack(Sig, Invalid(), OpSize::iInvalid);
 }
