-  return SlowPath ? LoadStackValueAtOffset_Slow(Offset) : StackValue->StackDataNode;
+  return SlowPath ? LoadStackValueAtOffset_Slow(Offset, Quiet) : StackValue->StackDataNode;
 }
 
