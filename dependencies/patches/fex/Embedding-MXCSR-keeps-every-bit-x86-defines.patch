From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 6 Oct 2026 04:49:29 +0900
Subject: [PATCH] Embedding: MXCSR keeps every bit x86 defines

x86 keeps the exception flags LDMXCSR, FXRSTOR and XRSTOR load, and
STMXCSR, FXSAVE and XSAVE store them with an MXCSR_MASK of 0xFFFF;
FEXCore dropped them and stored 0xFFC0. Embedded, MXCSR now keeps all
sixteen bits, as an embedding host that shares its guest state with
another engine needs. FEXCore's own behaviour stays as it was.
---
 FEXCore/Source/Interface/Core/OpcodeDispatcher.h   |  1 +
 .../Interface/Core/OpcodeDispatcher/Vector.cpp     | 14 ++++++++++----
 2 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index 8876342a1459e66885296495184d97cbf17025d7..af21fafa7e009ecb33fc455a5501f25bc552f0a9 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -1524,6 +1524,7 @@ private:
   void DefaultSSEState();
   void DefaultAVXState();
 
+  uint32_t MXCSRMask() const;
   Ref GetMXCSR();
 
 #undef OpcodeArgs
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
index 37a7e8c3952623392b3ac13dcfa3cf972a1b11b7..ca8b720275a01f928ffa320e84be4d119c79ac58 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
@@ -3249,7 +3249,7 @@ void OpDispatchBuilder::SaveSSEState(Ref MemBase) {
 
 void OpDispatchBuilder::SaveMXCSRState(Ref MemBase) {
   // Store MXCSR and the mask for all bits.
-  _StoreMemPairGPR(OpSize::i32Bit, GetMXCSR(), Constant(0xFFC0), MemBase, 24);
+  _StoreMemPairGPR(OpSize::i32Bit, GetMXCSR(), Constant(MXCSRMask()), MemBase, 24);
 }
 
 void OpDispatchBuilder::SaveAVXState(Ref MemBase) {
@@ -3263,11 +3263,17 @@ void OpDispatchBuilder::SaveAVXState(Ref MemBase) {
   }
 }
 
+uint32_t OpDispatchBuilder::MXCSRMask() const {
+  // Embedded, MXCSR keeps every bit x86 defines, the exception flags
+  // included, as STMXCSR shows them. Otherwise FZ, RC, the exception masks
+  // and DAZ.
+  return CTX->Embedded ? 0xFFFF : 0xFFC0;
+}
+
 Ref OpDispatchBuilder::GetMXCSR() {
   Ref MXCSR = _LoadContextGPR(OpSize::i32Bit, offsetof(FEXCore::Core::CPUState, mxcsr));
   // Mask out unsupported bits
-  // Keeps FZ, RC, exception masks, and DAZ
-  MXCSR = _And(OpSize::i32Bit, MXCSR, Constant(0xFFC0));
+  MXCSR = _And(OpSize::i32Bit, MXCSR, Constant(MXCSRMask()));
   return MXCSR;
 }
 
@@ -3393,7 +3399,7 @@ void OpDispatchBuilder::RestoreSSEState(Ref MemBase) {
 
 void OpDispatchBuilder::RestoreMXCSRState(Ref MXCSR) {
   // Mask out unsupported bits
-  MXCSR = _And(OpSize::i32Bit, MXCSR, Constant(0xFFC0));
+  MXCSR = _And(OpSize::i32Bit, MXCSR, Constant(MXCSRMask()));
 
   _StoreContextGPR(OpSize::i32Bit, MXCSR, offsetof(FEXCore::Core::CPUState, mxcsr));
   // We only support the rounding mode and FTZ bit being set
