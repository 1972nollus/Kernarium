 #include <malloc.h>
+#endif
 #include <stdlib.h>
 #include <stdio.h>
 #include <string.h>
@@ -188,7 +192,12 @@ void* calloc(size_t n, size_t size) {
   return ::calloc(n, size);
 }
 void* memalign(size_t align, size_t s) {
+#ifdef __APPLE__
+  void* Ptr {};
+  return ::posix_memalign(&Ptr, align < sizeof(void*) ? sizeof(void*) : align, s) == 0 ? Ptr : nullptr;
