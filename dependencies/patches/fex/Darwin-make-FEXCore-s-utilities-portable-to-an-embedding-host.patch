   return ::valloc(size);
@@ -203,10 +212,21 @@ void free(void* ptr) {
   return ::free(ptr);
 }
 size_t malloc_usable_size(void* ptr) {
+#ifdef __APPLE__
+  return ::malloc_size(ptr);
+#else
   return ::malloc_usable_size(ptr);
+#endif
 }
 void* aligned_alloc(size_t a, size_t s) {
+#ifdef __APPLE__
+  // Darwin's aligned_alloc rejects an alignment below the pointer size and a
+  // size that is not a multiple of the alignment; fextl containers pass both.
+  void* Ptr {};
+  return ::posix_memalign(&Ptr, a < sizeof(void*) ? sizeof(void*) : a, s ? s : 1) == 0 ? Ptr : nullptr;
+#else
   return ::aligned_alloc(a, s);
+#endif
 }
 void aligned_free(void* ptr) {
   return ::free(ptr);
