       close(SourceFD);
       return false;
     }
+#ifdef __APPLE__
+    bool Result = false;
+    {
+      char Buffer[65536];
+      off_t Total = 0;
+      ssize_t Read;
+      while ((Read = read(SourceFD, Buffer, sizeof(Buffer))) > 0) {
+        if (write(DestinationFD, Buffer, Read) != Read) {
