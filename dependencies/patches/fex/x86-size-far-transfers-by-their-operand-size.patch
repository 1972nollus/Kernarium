From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 5 Oct 2026 12:49:45 +0900
Subject: [PATCH] x86: size far transfers by their operand size

A far JMP, CALL or RET takes its operand size from its prefixes, in
64-bit mode too: 16 bits with 0x66, 64 with REX.W, and otherwise 32.
FEXCore read a 32-bit offset for every far JMP and CALL, with the
selector after it, and pushed and popped 32-bit slots unless REX.W
was present. The offset, the selector's place after it, and each
stack slot now follow the operand size.
---
 .../Interface/Core/OpcodeDispatcher.cpp       | 22 ++++++++++++++-----
 1 file changed, 16 insertions(+), 6 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index b404eaa73ebf5f4c1cae28ca0cd9e16f52cc272b..fe1fc28c79c9eabb58a8c40630f4f6630dedf8f6 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -1016,7 +1016,17 @@ void OpDispatchBuilder::JUMPAbsoluteOp(OpcodeArgs) {
   ExitFunction(RIPOffset);
 }
 
+// A far transfer's offset and stack slots take its operand size: 16 bits
+// with 0x66, 64 with REX.W, and otherwise 32, in 64-bit mode too.
+static OpSize FarTransferSize(X86Tables::DecodedOp Op) {
+  return (Op->Flags & X86Tables::DecodeFlags::FLAG_REX_WIDENING) ? OpSize::i64Bit :
+         (Op->Flags & X86Tables::DecodeFlags::FLAG_OPERAND_SIZE) ? OpSize::i16Bit :
+                                                                   OpSize::i32Bit;
+}
+
 void OpDispatchBuilder::JUMPFARIndirectOp(OpcodeArgs) {
+  const auto SrcSize = FarTransferSize(Op);
+
   // Calculate flags early.
   CalculateDeferredFlags();
 
@@ -1025,8 +1035,8 @@ void OpDispatchBuilder::JUMPFARIndirectOp(OpcodeArgs) {
   // This uses ModRM to determine its location
   // No way to use this effectively in multiblock
   Ref Src = MakeSegmentAddress(Op, Op->Dest);
-  AddressMode SrcCS = {.Base = Src, .Offset = 4, .AddrSize = OpSize::i64Bit};
-  auto RIPOffset = _LoadMemGPRAutoTSO(OpSize::i32Bit, Src, OpSize::i8Bit);
+  AddressMode SrcCS = {.Base = Src, .Offset = static_cast<int64_t>(IR::OpSizeToSize(SrcSize)), .AddrSize = OpSize::i64Bit};
+  auto RIPOffset = _LoadMemGPRAutoTSO(SrcSize, Src, OpSize::i8Bit);
   auto NewSegmentCS = _LoadMemGPRAutoTSO(OpSize::i16Bit, SrcCS, OpSize::i8Bit);
 
   // Set up the new CSSegment.
@@ -1038,7 +1048,7 @@ void OpDispatchBuilder::JUMPFARIndirectOp(OpcodeArgs) {
 }
 
 void OpDispatchBuilder::CALLFARIndirectOp(OpcodeArgs) {
-  const auto SrcSize = Op->Flags & FEXCore::X86Tables::DecodeFlags::FLAG_REX_WIDENING ? OpSize::i64Bit : OpSize::i32Bit;
+  const auto SrcSize = FarTransferSize(Op);
 
   // Calculate flags early.
   CalculateDeferredFlags();
@@ -1046,8 +1056,8 @@ void OpDispatchBuilder::CALLFARIndirectOp(OpcodeArgs) {
   BlockSetRIP = true;
 
   Ref Src = MakeSegmentAddress(Op, Op->Dest);
-  AddressMode SrcCS = {.Base = Src, .Offset = 4, .AddrSize = OpSize::i64Bit};
-  auto RIPOffset = _LoadMemGPRAutoTSO(OpSize::i32Bit, Src, OpSize::i8Bit);
+  AddressMode SrcCS = {.Base = Src, .Offset = static_cast<int64_t>(IR::OpSizeToSize(SrcSize)), .AddrSize = OpSize::i64Bit};
+  auto RIPOffset = _LoadMemGPRAutoTSO(SrcSize, Src, OpSize::i8Bit);
   auto NewSegmentCS = _LoadMemGPRAutoTSO(OpSize::i16Bit, SrcCS, OpSize::i8Bit);
   auto CurrentCS = _LoadContextGPR(OpSize::i16Bit, offsetof(FEXCore::Core::CPUState, cs_idx));
 
@@ -1081,7 +1091,7 @@ void OpDispatchBuilder::CALLFARIndirectOp(OpcodeArgs) {
 
 void OpDispatchBuilder::RETFARIndirectOp(OpcodeArgs) {
   const auto GPRSize = GetGPROpSize();
-  const auto SrcSize = Op->Flags & FEXCore::X86Tables::DecodeFlags::FLAG_REX_WIDENING ? OpSize::i64Bit : OpSize::i32Bit;
+  const auto SrcSize = FarTransferSize(Op);
 
   Ref SP = _RMWHandle(LoadGPRRegister(X86State::REG_RSP));
   Ref NewRIP = Pop(SrcSize, SP);
