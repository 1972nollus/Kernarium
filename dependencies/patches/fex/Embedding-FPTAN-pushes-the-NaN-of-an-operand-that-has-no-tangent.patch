diff --git a/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp b/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
index c8aecf492bdf20ad18a14c4f6274fb0387814293..5a96f9767da51d9f80514f2fae852e5c29fc9972 100644
--- a/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
+++ b/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
@@ -1000,12 +1000,14 @@ void X87StackOptimization::Run(IREmitter* Emit) {
         if (Embedded && !ReducedPrecisionMode) {
           Ref Full = GetX87ValidTag_Slow(7);
           Ref Operand = TwoResultOperand(LoadStackValue(), Full);
-          Ref Value {};
-          DeriveOp(Value, OP_F80TAN, IREmit->_F80SQRT(Operand));
-          StoreStackValue(X87StackFault(Value, Full, true));
-          Ref One = IREmit->_LoadNamedVectorConstant(OpSize::i128Bit, NamedVectorConstant::NAMED_VECTOR_X87_ONE);
+          // The register pushed holds 1.0, or the NaN an operand without a
+          // tangent returns.
+          Ref Tangent = IREmit->_AllocateFPR(OpSize::i128Bit, OpSize::i128Bit);
+          Ref Second = IREmit->_AllocateFPR(OpSize::i128Bit, OpSize::i128Bit);
+          IREmit->_F80PTAN(Operand, Tangent, Second);
+          StoreStackValue(X87StackFault(Tangent, Full, true));
           UpdateTopForPush_Slow();
-          StoreStackValueAtOffset_Slow(X87StackFault(One, Full, true));
+          StoreStackValueAtOffset_Slow(X87StackFault(Second, Full, true));
           break;
         }
         HandleUnop(OP_F64TAN, false, OP_F80TAN);
