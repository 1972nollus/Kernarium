From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 10 Oct 2026 01:50:12 +0900
Subject: [PATCH] Embedding: clear the code cache in place

A host that drops every translation on a code change cannot afford a
new, larger code buffer each time: the window it serves buffers from
is finite. ClearCodeCache(Thread, false) kept the buffer but left
everything else as it was. The cursor stayed, so the buffer filled
with dead code until a larger one replaced it; the arena that holds
the block links was never released, so each clear left its links
behind; the pages' lists of blocks kept naming blocks that were gone;
and the decoder kept the executable range it last asked the host
about, so a host that counts the pages holding code was not asked
again about the page decoded last, whose count it had dropped with
the code.

It now rewinds the buffer, returns the links' arena, clears the page
lists and resets the decoder's range. That is correct for a context
whose buffer only one thread uses, which is what the declaration now
says.

The arena also had no destructor, so a code buffer that a larger one
replaced, and every context that was destroyed, left the links of all its
blocks mapped for the life of the process. It now returns its buffers when
it dies, and it cannot be copied, which would free them twice.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 FEXCore/Source/Interface/Core/Core.cpp          | 13 +++++++++++++
 FEXCore/Source/Interface/Core/LookupCache.cpp   |  7 +++++--
 FEXCore/include/FEXCore/Core/Context.h          |  3 +++
 FEXCore/include/FEXCore/fextl/memory_resource.h |  9 +++++++++
 4 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 3b4437b8a1197d3871f7db5357c5fa6280f1a8cd..e18bac36fab7752f1b78b4c9603e1f370a5c3113 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -509,6 +509,19 @@ void ContextImpl::ClearCodeCache(FEXCore::Core::InternalThreadState* Thread, boo
     // Clear L1+L2 cache of this thread, and clear L3 cache across any threads using it
     auto lk = Thread->LookupCache->AcquireWriteLock();
     Thread->LookupCache->ClearCache(lk);
+
+    // Nothing refers to the code any more, so the buffer starts over: the next block
+    // overwrites the old ones instead of leaving them behind until the buffer fills
+    // and a larger one replaces it. Only this thread may use the buffer, because another
+    // thread's lookup caches and call stack would still name the code being overwritten.
+    {
+      std::scoped_lock CodeLock {CodeBufferWriteMutex};
+      LatestOffset = 0;
+    }
+
+    // The decoder remembers the executable range it last asked the host for, and a host
+    // that tracks which pages hold code has dropped that page with the code.
+    Thread->FrontendDecoder->ResetExecutableRangeCache();
   }
   Allocator::VirtualDontNeed(Thread->CallRetStackBase, FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE);
 }
diff --git a/FEXCore/Source/Interface/Core/LookupCache.cpp b/FEXCore/Source/Interface/Core/LookupCache.cpp
index e7af8fa1bf8ed74c72e2ccfe8b66f99e31292c7b..17bbcc9f34297694da0c78825ce5498766f4d0b7 100644
--- a/FEXCore/Source/Interface/Core/LookupCache.cpp
+++ b/FEXCore/Source/Interface/Core/LookupCache.cpp
@@ -104,10 +104,13 @@ void LookupCache::ClearCache(const LookupCacheWriteLockToken& lk) {
 }
 
 void GuestToHostMap::ClearCache(const LookupCacheWriteLockToken&) {
-  // Allocate a new pointer from the BlockLinks pma again.
+  // The links are gone with the code. Return the arena they were allocated from
+  // before allocating the map again, or each clear would leave its links behind.
+  BlockLinks_mbr.release();
   BlockLinks = BlockLinks_pma->new_object<BlockLinksMapType>();
-  // All code is gone, clear the block list
+  // All code is gone, clear the block list and the pages that listed it
   BlockList.clear();
+  CodePages.clear();
 }
 
 } // namespace FEXCore
diff --git a/FEXCore/include/FEXCore/Core/Context.h b/FEXCore/include/FEXCore/Core/Context.h
index cad519d27b8f2ee450637072c94e4290d443687a..2e58a206a89b449700152bb1fabe4747b2537a71 100644
--- a/FEXCore/include/FEXCore/Core/Context.h
+++ b/FEXCore/include/FEXCore/Core/Context.h
@@ -182,6 +182,9 @@ public:
   virtual void SetCodeMapWriter(fextl::unique_ptr<CodeMapWriter>) = 0;
   virtual void FlushAndCloseCodeMap() = 0;
 
+  // Drops every translation. A new code buffer, twice the size of the last up to a limit, is the default.
+  // Without one the translations go and the buffer starts over, which is only correct when no other
+  // thread executes in it or caches its code.
   FEX_DEFAULT_VISIBILITY virtual void ClearCodeCache(FEXCore::Core::InternalThreadState* Thread, bool NewCodeBuffer = true) = 0;
   FEX_DEFAULT_VISIBILITY virtual void InvalidateCodeBuffersCodeRange(uint64_t Start, uint64_t Length) = 0;
   FEX_DEFAULT_VISIBILITY virtual void
diff --git a/FEXCore/include/FEXCore/fextl/memory_resource.h b/FEXCore/include/FEXCore/fextl/memory_resource.h
index 686feec9f47941baecb0228c9576dc816da736cb..797b2eac0ea757499e3faf55ac8aea82dc4eb1b7 100644
--- a/FEXCore/include/FEXCore/fextl/memory_resource.h
+++ b/FEXCore/include/FEXCore/fextl/memory_resource.h
@@ -38,6 +38,15 @@ namespace pmr {
     explicit named_monotonic_page_buffer_resource(const char* Name)
       : Name {Name} {}
 
+    // The resource owns its buffers: a copy would free them twice, and a resource
+    // that dies without freeing them leaves them mapped for the life of the process.
+    named_monotonic_page_buffer_resource(const named_monotonic_page_buffer_resource&) = delete;
+    named_monotonic_page_buffer_resource& operator=(const named_monotonic_page_buffer_resource&) = delete;
+
+    ~named_monotonic_page_buffer_resource() override {
+      release();
+    }
+
     void release() noexcept {
       for (auto& Iter : Buffers) {
         FEXCore::Allocator::VirtualFree(Iter.Buffer, Iter.BufferSize);
