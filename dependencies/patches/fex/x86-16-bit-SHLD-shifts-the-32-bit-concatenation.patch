From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 4 Oct 2026 23:02:26 +0900
Subject: [PATCH] x86: 16-bit SHLD shifts the 32-bit concatenation

A 16-bit SHLD's masked count reaches 31. FEXCore cleared CF for an
immediate count of 16 and filled the result with zeros for counts
above 16. Both forms now shift the 32-bit concatenation of the
destination and the source, so the bits shifted in past the source's
width are the source's own and CF is the last bit shifted out.
---
 .../Interface/Core/OpcodeDispatcher.cpp       | 36 ++++++++++++-------
 1 file changed, 23 insertions(+), 13 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index 71f734532beb084431783a6cbf5195c2bc9dada8..f1a848c376110fc3603320aa17ae7b4656c7eedb 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -1505,14 +1505,23 @@ void OpDispatchBuilder::SHLDOp(OpcodeArgs) {
     Shift = _And(OpSize::i64Bit, Shift, _InlineConstant(0x1F));
   }
 
-  // a64 masks the bottom bits, so if we're using a native 32/64-bit shift, we
-  // can negate to do the subtract (it's congruent), which saves a constant.
-  auto ShiftRight = Size >= 32 ? _Neg(OpSize::i64Bit, Shift) : Sub(OpSize::i64Bit, Constant(Size), Shift);
+  Ref Res {};
+  if (Size == 16) {
+    // A 16-bit SHLD shifts the 32-bit concatenation of Dest and Src, so a
+    // count above 16 shifts Src's own bits into the result, and bit 16 of
+    // the result is the last bit shifted out, which the flags take as CF.
+    auto Concat = _Orlshl(OpSize::i64Bit, Src, Dest, 16);
+    Res = _Lshr(OpSize::i64Bit, _Lshl(OpSize::i64Bit, Concat, Shift), Constant(16));
+  } else {
+    // a64 masks the bottom bits, so if we're using a native 32/64-bit shift, we
+    // can negate to do the subtract (it's congruent), which saves a constant.
+    auto ShiftRight = _Neg(OpSize::i64Bit, Shift);
 
-  auto Tmp1 = _Lshl(OpSize::i64Bit, Dest, Shift);
-  auto Tmp2 = _Lshr(Size == 64 ? OpSize::i64Bit : OpSize::i32Bit, Src, ShiftRight);
+    auto Tmp1 = _Lshl(OpSize::i64Bit, Dest, Shift);
+    auto Tmp2 = _Lshr(Size == 64 ? OpSize::i64Bit : OpSize::i32Bit, Src, ShiftRight);
 
-  Ref Res = _Or(OpSize::i64Bit, Tmp1, Tmp2);
+    Res = _Or(OpSize::i64Bit, Tmp1, Tmp2);
+  }
 
   // If shift count was zero then output doesn't change
   // Needs to be checked for the 32bit operand case
@@ -1538,19 +1547,20 @@ void OpDispatchBuilder::SHLDImmediateOp(OpcodeArgs) {
   if (Shift != 0) {
     Ref Res {};
     if (Size < 32) {
-      Ref ShiftLeft = Constant(Shift);
-      auto ShiftRight = Size - Shift;
-
-      auto Tmp1 = _Lshl(OpSize::i64Bit, Dest, ShiftLeft);
-      Ref Tmp2 = ShiftRight ? _Lshr(OpSize::i32Bit, Src, Constant(ShiftRight)) : Src;
-
-      Res = _Or(OpSize::i64Bit, Tmp1, Tmp2);
+      // A 16-bit SHLD shifts the 32-bit concatenation of Dest and Src, so a
+      // count of 16 or more shifts Src's own bits into the result and CF.
+      auto Concat = _Orlshl(OpSize::i64Bit, Src, Dest, 16);
+      Res = _Lshr(OpSize::i64Bit, _Lshl(OpSize::i64Bit, Concat, Constant(Shift)), Constant(16));
     } else {
       // 32-bit and 64-bit SHLD behaves like an EXTR where the lower bits are filled from the source.
       Res = _Extr(OpSizeFromSrc(Op), Dest, Src, Size - Shift);
     }
 
     CalculateFlags_ShiftLeftImmediate(OpSizeFromSrc(Op), Res, Dest, Shift);
+    if (Size < 32 && Shift >= Size) {
+      // Bit 16 of the result is the last bit shifted out.
+      SetCFDirect(Res, Size, true);
+    }
     CalculateDeferredFlags();
     StoreResultGPR(Op, Res);
   } else if (Shift == 0 && Size == 32) {
