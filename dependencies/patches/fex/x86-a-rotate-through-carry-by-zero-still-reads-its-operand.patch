From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 5 Oct 2026 18:34:54 +0900
Subject: [PATCH] x86: a rotate through carry by zero still reads its operand

RCL and RCR of a byte or word branch over the whole operation when the
masked count is zero, its memory read included. Hardware reads the
operand for any count, so a zero rotate of an unmapped operand faults;
the zero-count path now reads it too.
---
 FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp | 4 ++--
 FEXCore/Source/Interface/Core/OpcodeDispatcher.h   | 8 ++++++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index a2f0001623e4b70249355934a15e3d95693ee160..b056e20dc1dde5b82f699bd7a58a4abfc0b873e6 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -2409,7 +2409,7 @@ void OpDispatchBuilder::RCRSmallerOp(OpcodeArgs) {
       auto NewOF = _XorShift(OpSize::i32Bit, Res, Res, ShiftType::LSR, 1);
       SetRFLAG<FEXCore::X86State::RFLAG_OF_RAW_LOC>(NewOF, Size - 2, true);
     }
-  });
+  }, &OpDispatchBuilder::ZeroShiftReadDest);
 }
 
 void OpDispatchBuilder::RCLOp1Bit(OpcodeArgs) {
@@ -2579,7 +2579,7 @@ void OpDispatchBuilder::RCLSmallerOp(OpcodeArgs) {
       auto NewOF = _XorShift(OpSize::i64Bit, NewCF, Res, ShiftType::LSR, Size - 1);
       SetRFLAG<FEXCore::X86State::RFLAG_OF_RAW_LOC>(NewOF, 0, true);
     }
-  });
+  }, &OpDispatchBuilder::ZeroShiftReadDest);
 }
 
 void OpDispatchBuilder::BTOp(OpcodeArgs, uint32_t SrcIndex, BTAction Action) {
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index 265e7c94bca35010f24b4bec1f908b4c1d680c73..45486dba92b93bdf71f36eca840c93dd5e6103dd 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -2316,6 +2316,14 @@ private:
 
   using ZeroShiftFunctionPtr = void (OpDispatchBuilder::*)(FEXCore::X86Tables::DecodedOp Op);
 
+  // A rotate by zero leaves its operand unchanged but still reads it, so a
+  // memory operand faults as it would for any count.
+  void ZeroShiftReadDest(FEXCore::X86Tables::DecodedOp Op) {
+    if (!Op->Dest.IsGPR()) {
+      LoadSourceGPR(Op, Op->Dest, Op->Flags);
+    }
+  }
+
   template<typename F>
   void Calculate_ShiftVariable(FEXCore::X86Tables::DecodedOp Op, Ref Shift, F&& Calculate,
                                std::optional<ZeroShiftFunctionPtr> ZeroShiftResult = std::nullopt) {
