 .../Core/OpcodeDispatcher/SecondaryTables.h   |  4 ++-
 .../Interface/Core/X86Tables/BaseTables.cpp   |  2 +-
 .../Core/X86Tables/PrimaryGroupTables.cpp     |  6 ++--
 .../Core/X86Tables/SecondaryGroupTables.cpp   | 14 ++++-----
 .../Core/X86Tables/SecondaryTables.cpp        | 11 ++++---
 6 files changed, 41 insertions(+), 26 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index 4bbc4fbe8b5aaa1543bc7b0d918b0adf2cd6e8f2..19620ecd29c14b7cfca30683a49ee15d7755d740 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -1396,6 +1396,26 @@ void OpDispatchBuilder::MOVSegOp(OpcodeArgs, bool ToSeg) {
   // The loads here also load the selector, NOT the base
 
   if (ToSeg) {
+    // CPL3 can't write to CS, and the encodings past GS name no register:
+    // both are undefined before the source is read.
+    switch (Op->Dest.Data.GPR.GPR) {
+    case FEXCore::X86State::REG_RCX: // CS
+    case FEXCore::X86State::REG_R9:  // CS
+      UnimplementedOp(Op);
+      return;
+    case FEXCore::X86State::REG_RAX:
+    case FEXCore::X86State::REG_R8:
+    case FEXCore::X86State::REG_RBX:
+    case FEXCore::X86State::REG_R11:
+    case FEXCore::X86State::REG_RDX:
+    case FEXCore::X86State::REG_R10:
+    case FEXCore::X86State::REG_RBP:
+    case FEXCore::X86State::REG_R13:
+    case FEXCore::X86State::REG_RSP:
+    case FEXCore::X86State::REG_R12: break;
+    default: UnimplementedOp(Op); return;
+    }
+
     Ref Src = LoadSourceGPR_WithOpSize(Op, Op->Src[0], OpSize::i16Bit, Op->Flags);
 
     switch (Op->Dest.Data.GPR.GPR) {
@@ -1409,16 +1429,6 @@ void OpDispatchBuilder::MOVSegOp(OpcodeArgs, bool ToSeg) {
       _StoreContextGPR(OpSize::i16Bit, Src, offsetof(FEXCore::Core::CPUState, ds_idx));
       UpdatePrefixFromSegment(Src, FEXCore::X86Tables::DecodeFlags::FLAG_DS_PREFIX);
       break;
-    case FEXCore::X86State::REG_RCX: // CS
-    case FEXCore::X86State::REG_R9:  // CS
-      // CPL3 can't write to this
-      Break(FEXCore::IR::BreakDefinition {
-        .ErrorRegister = 0,
-        .Signal = SIGILL,
-        .TrapNumber = 0,
-        .si_code = 0,
-      });
-      break;
     case FEXCore::X86State::REG_RDX: // SS
     case FEXCore::X86State::REG_R10: // SS
       _StoreContextGPR(OpSize::i16Bit, Src, offsetof(FEXCore::Core::CPUState, ss_idx));
