From 5ea5fc30e9093154d2d22a1f6316867f0fedaf7f Mon Sep 17 00:00:00 2001
From: Christian Beier <info@christianbeier.net>
Date: Tue, 19 May 2026 20:11:50 +0200
Subject: [PATCH] libvncserver: bail out of update sending if client state
 RFB_SHUTDOWN

Prevents multiple rfbCloseClient() calls (which are not idempotent).
---
 src/libvncserver/rfbserver.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/libvncserver/rfbserver.c b/src/libvncserver/rfbserver.c
index 22af22d7d..5cb42654e 100644
--- a/src/libvncserver/rfbserver.c
+++ b/src/libvncserver/rfbserver.c
@@ -3976,7 +3976,7 @@ rfbSendExtDesktopSize(rfbClientPtr cl,
 rfbBool
 rfbSendUpdateBuf(rfbClientPtr cl)
 {
-    if(cl->sock<0)
+    if(cl->sock<0 || cl->state == RFB_SHUTDOWN)
       return FALSE;
 
     if (rfbWriteExact(cl, cl->updateBuf, cl->ublen) < 0) {
