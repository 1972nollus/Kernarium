From 875e7bfab4e80e3188e2ee3c5462afc15adeff07 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 23:01:37 +0900
Subject: [PATCH] apple: resolve GL facade through packaged ANGLE

---
 src/dispatch_common.c | 36 ++++++++++++++++++++++++------------
 1 file changed, 24 insertions(+), 12 deletions(-)

diff --git a/src/dispatch_common.c b/src/dispatch_common.c
index 6fb7f02..705a8fd 100644
--- a/src/dispatch_common.c
+++ b/src/dispatch_common.c
@@ -175,18 +175,15 @@
 
 #if defined(__APPLE__)
 #include <TargetConditionals.h>
-#if TARGET_OS_OSX
-#define GLX_LIB "/opt/X11/lib/libGL.1.dylib"
-#define EGL_LIB "EGL.framework/Versions/Current/EGL"
-#define OPENGL_LIB "/System/Library/Frameworks/OpenGL.framework/Versions/Current/OpenGL"
-#define GLES1_LIB "GLESv1_CM.framework/Versions/Current/GLESv1_CM"
-#define GLES2_LIB "GLESv2.framework/Versions/Current/GLESv2"
-#elif TARGET_OS_IPHONE
-#define GLX_LIB "/opt/X11/lib/libGL.1.dylib"
-#define EGL_LIB "EGL.framework/EGL"
-#define OPENGL_LIB "/System/Library/Frameworks/OpenGL.framework/Versions/Current/OpenGL"
-#define GLES1_LIB "GLESv1_CM.framework/GLESv1_CM"
-#define GLES2_LIB "GLESv2.framework/GLESv2"
+#if TARGET_OS_OSX || TARGET_OS_IPHONE
+/* linux-um-darwin ships one authenticated flat ANGLE framework layout on
+ * every Apple platform. Resolve every GL API through that product's rpath;
+ * never retain CGL/OpenGL.framework as a hidden fallback. */
+#define EGL_LIB "@rpath/EGL.framework/EGL"
+#define GLX_LIB "@rpath/GLESv2.framework/GLESv2"
+#define OPENGL_LIB "@rpath/GLESv2.framework/GLESv2"
+#define GLES1_LIB "@rpath/GLESv2.framework/GLESv2"
+#define GLES2_LIB "@rpath/GLESv2.framework/GLESv2"
 #else
 #error "This Apple platform is not supported."
 #endif
@@ -713,23 +710,34 @@ epoxy_gl_dlsym(const char *name)
 void *
 epoxy_gles1_dlsym(const char *name)
 {
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    return epoxy_get_proc_address(name);
+#else
     if (epoxy_current_context_is_glx()) {
         return epoxy_get_proc_address(name);
     } else {
         get_dlopen_handle(&api.gles1_handle, GLES1_LIB, true, true);
         return do_dlsym(&api.gles1_handle, name, true);
     }
+#endif
 }
 
 void *
 epoxy_gles2_dlsym(const char *name)
 {
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    /* ANGLE's iOS facade exports core GLES symbols, but those exports are not
+     * the context dispatch used by its EGL implementation.  Resolve through
+     * EGL so libepoxy observes the selected packaged ANGLE context. */
+    return epoxy_get_proc_address(name);
+#else
     if (epoxy_current_context_is_glx()) {
         return epoxy_get_proc_address(name);
     } else {
         get_dlopen_handle(&api.gles2_handle, GLES2_LIB, true, true);
         return do_dlsym(&api.gles2_handle, name, true);
     }
+#endif
 }
 
 /**
@@ -745,6 +753,9 @@ epoxy_gles2_dlsym(const char *name)
 void *
 epoxy_gles3_dlsym(const char *name)
 {
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    return epoxy_get_proc_address(name);
+#else
     if (epoxy_current_context_is_glx()) {
         return epoxy_get_proc_address(name);
     } else {
@@ -757,6 +768,7 @@ epoxy_gles3_dlsym(const char *name)
 
         return epoxy_get_proc_address(name);
     }
+#endif
 }
 
 /**
