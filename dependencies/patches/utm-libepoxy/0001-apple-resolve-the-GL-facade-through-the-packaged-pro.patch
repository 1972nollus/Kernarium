From add184831becc6eda8f408c7d72e44b83d0df5a2 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 23:01:37 +0900
Subject: [PATCH] apple: resolve the GL facade through the packaged provider

---
 meson.build           |  4 ++++
 meson_options.txt     |  5 +++++
 src/dispatch_common.c | 52 +++++++++++++++++++++++++++++++++----------
 3 files changed, 49 insertions(+), 12 deletions(-)

diff --git a/meson.build b/meson.build
index 68882ec..4cd5f04 100644
--- a/meson.build
+++ b/meson.build
@@ -72,6 +72,10 @@ endif
 conf.set10('ENABLE_GLX', build_glx)
 conf.set10('ENABLE_EGL', build_egl)
 conf.set10('ENABLE_X11', enable_x11)
+# linux-um-darwin packages exactly one GL provider per Apple product, and
+# libepoxy resolves the GL facade through that product alone.
+conf.set10('EPOXY_APPLE_PROVIDER_MESA',
+           get_option('apple-gl-provider') == 'zink-kosmickrisp')
 
 # Compiler flags, taken from the Xorg macros
 if cc.get_id() == 'msvc'
diff --git a/meson_options.txt b/meson_options.txt
index dc30e68..240be45 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -19,3 +19,8 @@ option('tests',
        type: 'boolean',
        value: true,
        description: 'Build the test suite')
+option('apple-gl-provider',
+       type: 'combo',
+       choices: [ 'angle-metal', 'zink-kosmickrisp' ],
+       value: 'angle-metal',
+       description: 'Packaged Apple GL provider libepoxy dispatches through')
diff --git a/src/dispatch_common.c b/src/dispatch_common.c
index 6fb7f02..9b8cfd2 100644
--- a/src/dispatch_common.c
+++ b/src/dispatch_common.c
@@ -175,18 +175,25 @@
 
 #if defined(__APPLE__)
 #include <TargetConditionals.h>
-#if TARGET_OS_OSX
-#define GLX_LIB "/opt/X11/lib/libGL.1.dylib"
-#define EGL_LIB "EGL.framework/Versions/Current/EGL"
-#define OPENGL_LIB "/System/Library/Frameworks/OpenGL.framework/Versions/Current/OpenGL"
-#define GLES1_LIB "GLESv1_CM.framework/Versions/Current/GLESv1_CM"
-#define GLES2_LIB "GLESv2.framework/Versions/Current/GLESv2"
-#elif TARGET_OS_IPHONE
-#define GLX_LIB "/opt/X11/lib/libGL.1.dylib"
-#define EGL_LIB "EGL.framework/EGL"
-#define OPENGL_LIB "/System/Library/Frameworks/OpenGL.framework/Versions/Current/OpenGL"
-#define GLES1_LIB "GLESv1_CM.framework/GLESv1_CM"
-#define GLES2_LIB "GLESv2.framework/GLESv2"
+#if TARGET_OS_OSX || TARGET_OS_IPHONE
+/* linux-um-darwin packages exactly one GL provider per Apple product and
+ * resolves every GL API through that product's rpath; CGL and
+ * OpenGL.framework are never retained as a hidden fallback. Mesa's Apple
+ * build is EGL-only and exports no desktop GL entry points of its own, so
+ * its GL facade is resolved through eglGetProcAddress instead. */
+#if EPOXY_APPLE_PROVIDER_MESA
+#define EGL_LIB "@rpath/MesaEGL.framework/MesaEGL"
+#define GLX_LIB "@rpath/MesaEGL.framework/MesaEGL"
+#define OPENGL_LIB "@rpath/MesaEGL.framework/MesaEGL"
+#define GLES1_LIB "@rpath/MesaEGL.framework/MesaEGL"
+#define GLES2_LIB "@rpath/MesaEGL.framework/MesaEGL"
+#else
+#define EGL_LIB "@rpath/EGL.framework/EGL"
+#define GLX_LIB "@rpath/GLESv2.framework/GLESv2"
+#define OPENGL_LIB "@rpath/GLESv2.framework/GLESv2"
+#define GLES1_LIB "@rpath/GLESv2.framework/GLESv2"
+#define GLES2_LIB "@rpath/GLESv2.framework/GLESv2"
+#endif
 #else
 #error "This Apple platform is not supported."
 #endif
@@ -705,31 +712,48 @@ epoxy_load_gl(void)
 void *
 epoxy_gl_dlsym(const char *name)
 {
+#if defined(__APPLE__) && EPOXY_APPLE_PROVIDER_MESA && PLATFORM_HAS_EGL
+    /* Mesa's Apple build exposes desktop GL only through its EGL entry
+     * point; the packaged library exports no GL symbols to resolve. */
+    return eglGetProcAddress(name);
+#else
     epoxy_load_gl();
 
     return do_dlsym(&api.gl_handle, name, true);
+#endif
 }
 
 void *
 epoxy_gles1_dlsym(const char *name)
 {
+#if defined(__APPLE__) && (TARGET_OS_IPHONE || EPOXY_APPLE_PROVIDER_MESA)
+    return epoxy_get_proc_address(name);
+#else
     if (epoxy_current_context_is_glx()) {
         return epoxy_get_proc_address(name);
     } else {
         get_dlopen_handle(&api.gles1_handle, GLES1_LIB, true, true);
         return do_dlsym(&api.gles1_handle, name, true);
     }
+#endif
 }
 
 void *
 epoxy_gles2_dlsym(const char *name)
 {
+#if defined(__APPLE__) && (TARGET_OS_IPHONE || EPOXY_APPLE_PROVIDER_MESA)
+    /* ANGLE's iOS facade exports core GLES symbols, but those exports are not
+     * the context dispatch used by its EGL implementation.  Resolve through
+     * EGL so libepoxy observes the selected packaged ANGLE context. */
+    return epoxy_get_proc_address(name);
+#else
     if (epoxy_current_context_is_glx()) {
         return epoxy_get_proc_address(name);
     } else {
         get_dlopen_handle(&api.gles2_handle, GLES2_LIB, true, true);
         return do_dlsym(&api.gles2_handle, name, true);
     }
+#endif
 }
 
 /**
@@ -745,6 +769,9 @@ epoxy_gles2_dlsym(const char *name)
 void *
 epoxy_gles3_dlsym(const char *name)
 {
+#if defined(__APPLE__) && (TARGET_OS_IPHONE || EPOXY_APPLE_PROVIDER_MESA)
+    return epoxy_get_proc_address(name);
+#else
     if (epoxy_current_context_is_glx()) {
         return epoxy_get_proc_address(name);
     } else {
@@ -757,6 +784,7 @@ epoxy_gles3_dlsym(const char *name)
 
         return epoxy_get_proc_address(name);
     }
+#endif
 }
 
 /**
