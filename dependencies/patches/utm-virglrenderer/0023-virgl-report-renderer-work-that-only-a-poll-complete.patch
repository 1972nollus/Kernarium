From f0565f0c6281178985718f09dd1e4cf6d3eb94b8 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 12 Sep 2026 21:26:14 +0900
Subject: [PATCH 23/33] virgl: report renderer work that only a poll completes

A guest blocked on a query result spins on the buffer the host fills and
issues no further commands. The caller therefore has no fence of its own
left to drive the scan that finally completes the query, and the query
waits forever even though the GL work behind it finished.

Export whether the renderer still holds such work so a caller can keep
polling on its own until the renderer is idle again.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/virglrenderer.c        |  5 +++++
 src/virglrenderer.h        |  6 ++++++
 src/vrend/vrend_renderer.c | 10 ++++++++++
 src/vrend/vrend_renderer.h |  1 +
 4 files changed, 22 insertions(+)

diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index 6eac683..ba56e6d 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -795,6 +795,11 @@ void virgl_renderer_poll(void)
    virgl_context_foreach(&args);
 }
 
+bool virgl_renderer_has_pending_work(void)
+{
+   return state.vrend_initialized && vrend_renderer_has_pending_work();
+}
+
 void virgl_renderer_cleanup(UNUSED void *cookie)
 {
    TRACE_FUNC();
diff --git a/src/virglrenderer.h b/src/virglrenderer.h
index e5f0efd..953b088 100644
--- a/src/virglrenderer.h
+++ b/src/virglrenderer.h
@@ -177,6 +177,12 @@ struct virgl_renderer_callbacks {
 VIRGL_EXPORT int virgl_renderer_init(void *cookie, int flags, struct virgl_renderer_callbacks *cb);
 VIRGL_EXPORT void virgl_renderer_poll(void); /* force fences */
 
+/* True while the renderer holds work that completes only when it is polled,
+ * such as a query result a guest is blocked on. The caller keeps polling
+ * while this reports true even when it has no outstanding fence of its own.
+ */
+VIRGL_EXPORT bool virgl_renderer_has_pending_work(void);
+
 /* we need to give qemu the cursor resource contents */
 VIRGL_EXPORT void *virgl_renderer_get_cursor_data(uint32_t resource_id, uint32_t *width, uint32_t *height);
 
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index cfa0088..e2b0142 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -7507,6 +7507,16 @@ void vrend_renderer_poll(void) {
    }
 }
 
+/* Work the renderer owns that no guest fence will drive to completion.
+ * A guest blocked on a query result spins on the buffer the host fills and
+ * issues no further commands, so the caller has to keep polling on its own
+ * until the renderer reports that it is idle again.
+ */
+bool vrend_renderer_has_pending_work(void)
+{
+   return atomic_load(&vrend_state.has_waiting_queries);
+}
+
 static void wait_sync(struct vrend_fence *fence)
 {
    struct vrend_context *ctx = fence->ctx;
diff --git a/src/vrend/vrend_renderer.h b/src/vrend/vrend_renderer.h
index 95872c2..4fb216d 100644
--- a/src/vrend/vrend_renderer.h
+++ b/src/vrend/vrend_renderer.h
@@ -611,6 +611,7 @@ bool format_is_copy_compatible(enum virgl_formats src, enum virgl_formats dst,
 void vrend_renderer_prepare_reset(void);
 void vrend_renderer_reset(void);
 void vrend_renderer_poll(void);
+bool vrend_renderer_has_pending_work(void);
 int vrend_renderer_get_poll_fd(void);
 
 unsigned vrend_context_has_debug_flag(const struct vrend_context *ctx,
