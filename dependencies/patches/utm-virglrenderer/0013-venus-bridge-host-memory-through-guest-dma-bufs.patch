+   if (physical_dev->EXT_external_memory_metal) {
+      dev->GetMemoryMetalHandlePropertiesEXT =
+         (PFN_vkGetMemoryMetalHandlePropertiesEXT)vk->GetDeviceProcAddr(
+            dev->base.handle.device,
+            "vkGetMemoryMetalHandlePropertiesEXT");
+      dev->GetMemoryMetalHandleEXT =
+         (PFN_vkGetMemoryMetalHandleEXT)vk->GetDeviceProcAddr(
+            dev->base.handle.device, "vkGetMemoryMetalHandleEXT");
+      if (!dev->GetMemoryMetalHandlePropertiesEXT ||
+          !dev->GetMemoryMetalHandleEXT) {
+         struct vn_device_proc_table *dev_vk = &dev->proc_table;
+         dev_vk->DestroyDevice(dev->base.handle.device, NULL);
+         free(exts);
+         free(dev);
+         args->ret = VK_ERROR_EXTENSION_NOT_PRESENT;
+         return;
+      }
+   }
+
    free(exts);
 
    args->ret = vkr_device_create_queues(ctx, dev, args->pCreateInfo->queueCreateInfoCount,
