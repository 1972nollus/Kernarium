From 3bc3ee9befd702dcce60092e3eebc163d0c7c072 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 13 Sep 2026 07:07:05 +0900
Subject: [PATCH 31/31] vrend: advertise a texture buffer alignment the
 protocol can carry

A texture buffer view crosses the protocol as a first and last element,
so the guest's byte offset is divided by the texel size on the way out
and multiplied back on the way in. A guest that offsets an rgb32 view
by the host's own 16-byte alignment therefore asks the host for byte
12, which is not 16-byte aligned, and glTexBufferRange answers
GL_INVALID_VALUE: KHR-GL46.direct_state_access.textures_buffer_rgb32ui
lost its sampler view and drew from nothing.

Report an alignment that is a multiple of both the host's and of every
texel size GL gives a buffer format, so that a legal guest offset is
always a whole number of texels and always aligned on the host. 48 is
the least common multiple of 1, 2, 3, 4, 6, 8, 12 and 16.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/vrend/vrend_renderer.c | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 7c93362..4aff18d 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -13226,6 +13226,18 @@ static void vrend_renderer_fill_caps_v1(int gl_ver, int gles_ver, union virgl_ca
    }
 }
 
+/* The smallest alignment that satisfies both a and b. */
+static unsigned lcm_alignment(unsigned a, unsigned b)
+{
+   unsigned x = a, y = b;
+   while (y) {
+      const unsigned t = x % y;
+      x = y;
+      y = t;
+   }
+   return x ? a / x * b : b;
+}
+
 static void vrend_renderer_fill_caps_v2(int gl_ver, int gles_ver,  union virgl_caps *caps)
 {
    GLint max;
@@ -13438,7 +13450,19 @@ angle_done:
    }
 
    if (has_feature(feat_texture_buffer_range)) {
-      glGetIntegerv(GL_TEXTURE_BUFFER_OFFSET_ALIGNMENT, (GLint*)&caps->v2.texture_buffer_offset_alignment);
+      GLint host_alignment = 1;
+      glGetIntegerv(GL_TEXTURE_BUFFER_OFFSET_ALIGNMENT, &host_alignment);
+
+      /* The protocol carries a texture buffer view's range in texels, so a
+       * byte offset the guest picks has to divide evenly by the texel size to
+       * survive the round trip as well as satisfy the host's own alignment.
+       * 48 is the least common multiple of the texel sizes GL gives the
+       * buffer formats (1, 2, 3, 4, 6, 8, 12 and 16 bytes); without it a
+       * guest that legally offsets an rgb32 view by the host's 16 bytes asks
+       * the host for byte 12, which the host then rejects.
+       */
+      caps->v2.texture_buffer_offset_alignment =
+         lcm_alignment(host_alignment > 0 ? (unsigned)host_alignment : 1u, 48u);
    }
 
    if (has_feature(feat_ssbo)) {
