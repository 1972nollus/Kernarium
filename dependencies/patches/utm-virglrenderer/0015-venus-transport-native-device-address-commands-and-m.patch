diff --git a/meson.build b/meson.build
index 8563881..9800461 100644
--- a/meson.build
+++ b/meson.build
@@ -373,17 +373,73 @@ if metal_dep.found() and with_host_darwin
 endif
 
 if with_venus
-   venus_dep = []
+   fs = import('fs')
+   venus_protocol_dir = get_option('venus-protocol-dir')
+   vulkan_include_dir = get_option('vulkan-include-dir')
+   if not fs.is_absolute(venus_protocol_dir) or not fs.is_absolute(vulkan_include_dir)
+      error('Venus requires explicit absolute generated protocol and Vulkan include directories')
+   endif
+   venus_headers = []
+   foreach header : [
+      'vn_protocol_renderer.h',
+      'vn_protocol_renderer_acceleration_structure.h',
+      'vn_protocol_renderer_buffer.h',
+      'vn_protocol_renderer_buffer_view.h',
+      'vn_protocol_renderer_command_buffer.h',
+      'vn_protocol_renderer_command_pool.h',
+      'vn_protocol_renderer_cs.h',
+      'vn_protocol_renderer_defines.h',
+      'vn_protocol_renderer_descriptor_heap.h',
+      'vn_protocol_renderer_descriptor_pool.h',
+      'vn_protocol_renderer_descriptor_set.h',
+      'vn_protocol_renderer_descriptor_set_layout.h',
+      'vn_protocol_renderer_descriptor_update_template.h',
+      'vn_protocol_renderer_device.h',
+      'vn_protocol_renderer_device_memory.h',
+      'vn_protocol_renderer_dispatches.h',
+      'vn_protocol_renderer_event.h',
+      'vn_protocol_renderer_fence.h',
+      'vn_protocol_renderer_framebuffer.h',
+      'vn_protocol_renderer_handles.h',
+      'vn_protocol_renderer_host_copy.h',
+      'vn_protocol_renderer_image.h',
+      'vn_protocol_renderer_image_view.h',
+      'vn_protocol_renderer_info.h',
+      'vn_protocol_renderer_instance.h',
+      'vn_protocol_renderer_pipeline.h',
+      'vn_protocol_renderer_pipeline_cache.h',
+      'vn_protocol_renderer_pipeline_layout.h',
+      'vn_protocol_renderer_private_data_slot.h',
+      'vn_protocol_renderer_query_pool.h',
+      'vn_protocol_renderer_queue.h',
+      'vn_protocol_renderer_render_pass.h',
+      'vn_protocol_renderer_sampler.h',
+      'vn_protocol_renderer_sampler_ycbcr_conversion.h',
+      'vn_protocol_renderer_semaphore.h',
+      'vn_protocol_renderer_shader_module.h',
+      'vn_protocol_renderer_structs.h',
+      'vn_protocol_renderer_transport.h',
+      'vn_protocol_renderer_types.h',
+      'vn_protocol_renderer_util.h',
+   ]
+      venus_headers += files(venus_protocol_dir / header)
+   endforeach
+   foreach header : ['vulkan/vulkan.h', 'vulkan/vulkan_core.h', 'vulkan/vulkan_metal.h']
+      venus_headers += files(vulkan_include_dir / header)
+   endforeach
+   venus_dep = [declare_dependency(
+      sources : venus_headers,
+      include_directories : include_directories(venus_protocol_dir,
+         vulkan_include_dir, vulkan_include_dir / 'vulkan'),
+   )]
    if get_option('vulkan-dload')
       conf_data.set('ENABLE_VULKAN_DLOAD', 1)
    elif with_host_darwin
-      vulkan_include_dir = get_option('vulkan-include-dir')
       vulkan_library_file = get_option('vulkan-library-file')
       if vulkan_include_dir == '' or vulkan_library_file == ''
          error('Darwin Venus requires explicit Vulkan headers and provider binary')
       endif
       venus_dep += declare_dependency(
-         compile_args : ['-I' + vulkan_include_dir],
          link_args : [vulkan_library_file],
       )
    else
