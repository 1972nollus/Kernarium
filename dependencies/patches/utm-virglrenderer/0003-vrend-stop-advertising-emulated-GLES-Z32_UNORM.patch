From 6ea917c4cdad8d83691cc231cb28e4c8c5084dbe Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 22 Aug 2026 05:26:27 +0900
Subject: [PATCH 03/32] vrend: stop advertising emulated GLES Z32_UNORM

OpenGL ES has no normalized 32-bit depth renderbuffer format. The existing GLES table nevertheless advertised Z32_UNORM by backing it with a 24-bit depth texture. Mesa then exposed 32-bit EGL depth configurations whose precision and component type did not match their backing storage, causing valid GLES framebuffer blits to fail format validation.

Drop that false GLES capability. Real Z32_FLOAT support remains advertised through the common depth table, while desktop GL retains its native Z32_UNORM entry.
---
 src/vrend/vrend_formats.c | 12 ++++--------
 1 file changed, 4 insertions(+), 8 deletions(-)

diff --git a/src/vrend/vrend_formats.c b/src/vrend/vrend_formats.c
index 8566fd3..985cbfb 100644
--- a/src/vrend/vrend_formats.c
+++ b/src/vrend/vrend_formats.c
@@ -97,10 +97,6 @@ static struct vrend_format_table gl_z32_format[] = {
    { VIRGL_FORMAT_Z32_UNORM, GL_DEPTH_COMPONENT32, GL_DEPTH_COMPONENT, GL_UNSIGNED_INT, NO_SWIZZLE, view_class_unsupported },
 };
 
-static struct vrend_format_table gles_z32_format[] = {
-   { VIRGL_FORMAT_Z32_UNORM, GL_DEPTH_COMPONENT24, GL_DEPTH_COMPONENT, GL_UNSIGNED_INT, NO_SWIZZLE, view_class_unsupported },
-};
-
 static struct vrend_format_table rg_base_formats[] = {
   { VIRGL_FORMAT_R8_UNORM, GL_R8, GL_RED, GL_UNSIGNED_BYTE, NO_SWIZZLE, view_class_8 },
   { VIRGL_FORMAT_R8G8_UNORM, GL_RG8, GL_RG, GL_UNSIGNED_BYTE, NO_SWIZZLE, view_class_16 },
@@ -608,11 +604,11 @@ void vrend_build_format_list_gles(void)
    */
   add_formats(gles_bgra_formats);
 
-  /* The Z32 format is required, but OpenGL ES does not support
-   * using it as a depth buffer. We just fake support with Z24
-   * and hope nobody notices.
+  /* GLES has no normalized 32-bit depth format.  Do not advertise Z32_UNORM
+   * by silently backing it with Z24: that makes the guest expose a 32-bit EGL
+   * depth config whose actual precision and component type do not match.
+   * Z32_FLOAT remains available through the common depth-format table.
    */
-  add_formats(gles_z32_format);
   add_formats(gles_bit10_formats);
 
   if (epoxy_has_gl_extension("GL_KHR_texture_compression_astc_ldr"))
