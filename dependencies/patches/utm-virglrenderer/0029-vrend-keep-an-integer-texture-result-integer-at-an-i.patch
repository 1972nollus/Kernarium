From e5a29dafb718571a6bd6f5fc7e3ade3a011bfd76 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 13 Sep 2026 02:23:35 +0900
Subject: [PATCH 29/29] vrend: keep an integer texture result integer at an
 integer destination

An integer sampler returns integers, and a TGSI destination that is a
float register needs the result bit cast before it can be stored, so
translate_tex() asks for intBitsToFloat or uintBitsToFloat. The test
that decides whether the destination is already integer compared the
destination conversion against the scalar INT alone, so every vector
integer destination -- IVEC4 and UVEC4, which is what a pure-integer
colour attachment gives a fragment output -- looked like a float one.
The emitted store then read as uvec4(uintBitsToFloat(textureGather())),
which bit casts the texels to float and converts those floats back to
integers numerically, so the attachment received the rounded magnitude
of a bit pattern instead of the texels.

Test every integer type qualifier, not the scalar alone, so an integer
destination stores the sampler result unchanged.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/vrend/vrend_shader.c | 27 +++++++++++++++++++++++----
 1 file changed, 23 insertions(+), 4 deletions(-)

diff --git a/src/vrend/vrend_shader.c b/src/vrend/vrend_shader.c
index 868121d..5eb19bd 100644
--- a/src/vrend/vrend_shader.c
+++ b/src/vrend/vrend_shader.c
@@ -481,6 +481,23 @@ static inline bool prefer_generic_io_block(const struct dump_ctx *ctx, enum io_t
    }
 }
 
+static inline bool type_qualifier_is_integer(enum vrend_type_qualifier key)
+{
+   switch (key) {
+   case INT:
+   case IVEC2:
+   case IVEC3:
+   case IVEC4:
+   case UINT:
+   case UVEC2:
+   case UVEC3:
+   case UVEC4:
+      return true;
+   default:
+      return false;
+   }
+}
+
 static inline const char *get_string(enum vrend_type_qualifier key)
 {
    if (key >= ARRAY_SIZE(conversion_table)) {
@@ -3169,15 +3186,17 @@ static void translate_tex(struct dump_ctx *ctx,
 
    is_shad = samplertype_is_shadow(inst->Texture.Texture);
 
+   /* An integer sampler returns integers, and the destination only needs the
+    * bit cast to float when it is itself a float register. Casting the bits
+    * to float and then constructing an integer destination from that float
+    * is a numeric conversion, which loses the value. */
    switch (ctx->samplers[sinfo->sreg_index].tgsi_sampler_return) {
    case TGSI_RETURN_TYPE_SINT:
-      /* if dstconv isn't an int */
-      if (dinfo->dstconv != INT)
+      if (!type_qualifier_is_integer(dinfo->dstconv))
          dtypeprefix = INT_BITS_TO_FLOAT;
       break;
    case TGSI_RETURN_TYPE_UINT:
-      /* if dstconv isn't an int */
-      if (dinfo->dstconv != INT)
+      if (!type_qualifier_is_integer(dinfo->dstconv))
          dtypeprefix = UINT_BITS_TO_FLOAT;
       break;
    default:
