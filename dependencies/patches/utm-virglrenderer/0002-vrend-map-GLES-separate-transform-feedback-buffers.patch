From df7aff7eacc0a5f64a22c6e512e7f30db74db9f8 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 22 Aug 2026 03:01:50 +0900
Subject: [PATCH 02/27] vrend: map GLES separate transform feedback buffers

---
 src/vrend/vrend_renderer.c | 75 +++++++++++++++++++++++++++-----------
 tests/test_virgl_cmd.c     | 58 ++++++++++++++++++-----------
 2 files changed, 90 insertions(+), 43 deletions(-)

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 86498a9..273e3f2 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -1654,12 +1654,36 @@ static char *get_skip_str(int *skip_val)
    return start_skip;
 }
 
+static bool stream_out_uses_gles_separate_attribs(const struct vrend_shader_info *sinfo)
+{
+   const struct pipe_stream_output_info *so = &sinfo->so_info;
+
+   if (!vrend_state.use_gles || has_feature(feat_transform_feedback3) ||
+       so->num_outputs < 2 || !sinfo->so_names)
+      return false;
+
+   /* GLES 3.0 has no ARB_transform_feedback3 skip or next-buffer tokens.
+    * Its separate-attribs mode exactly represents the Gallium layout when
+    * each varying completely and contiguously owns its corresponding buffer. */
+   for (unsigned i = 0; i < so->num_outputs; i++) {
+      const struct pipe_stream_output *output = &so->output[i];
+
+      if (!sinfo->so_names[i] || output->output_buffer != i ||
+          output->dst_offset != 0 || output->stream != 0 ||
+          so->stride[i] != output->num_components)
+         return false;
+   }
+
+   return true;
+}
+
 static void set_stream_out_varyings(ASSERTED struct vrend_sub_context *sub_ctx,
                                     int prog_id,
                                     struct vrend_shader_info *sinfo)
 {
    struct pipe_stream_output_info *so = &sinfo->so_info;
    char *varyings[PIPE_MAX_SHADER_OUTPUTS*2];
+   const bool separate_attribs = stream_out_uses_gles_separate_attribs(sinfo);
    int j;
    unsigned i, n_outputs = 0;
    int last_buffer = 0;
@@ -1671,43 +1695,52 @@ static void set_stream_out_varyings(ASSERTED struct vrend_sub_context *sub_ctx,
 
    VREND_DEBUG_EXT(dbg_shader_streamout, sub_ctx->parent, dump_stream_out(so));
 
-   for (i = 0; i < so->num_outputs; i++) {
-      if (last_buffer != so->output[i].output_buffer) {
+   if (separate_attribs) {
+      for (i = 0; i < so->num_outputs && n_outputs < ARRAY_SIZE(varyings); i++)
+         varyings[n_outputs++] = strdup(sinfo->so_names[i]);
+   } else {
+      for (i = 0; i < so->num_outputs; i++) {
+         if (last_buffer != so->output[i].output_buffer) {
+
+            skip = so->stride[last_buffer] - buf_offset;
+            while (skip && n_outputs < ARRAY_SIZE(varyings)) {
+               start_skip = get_skip_str(&skip);
+               if (start_skip)
+                  varyings[n_outputs++] = start_skip;
+            }
+            for (j = last_buffer; j < so->output[i].output_buffer && n_outputs < ARRAY_SIZE(varyings); j++)
+               varyings[n_outputs++] = strdup("gl_NextBuffer");
+            last_buffer = so->output[i].output_buffer;
+            buf_offset = 0;
+         }
 
-         skip = so->stride[last_buffer] - buf_offset;
+         skip = so->output[i].dst_offset - buf_offset;
          while (skip && n_outputs < ARRAY_SIZE(varyings)) {
             start_skip = get_skip_str(&skip);
             if (start_skip)
                varyings[n_outputs++] = start_skip;
          }
-         for (j = last_buffer; j < so->output[i].output_buffer && n_outputs < ARRAY_SIZE(varyings); j++)
-            varyings[n_outputs++] = strdup("gl_NextBuffer");
-         last_buffer = so->output[i].output_buffer;
-         buf_offset = 0;
+         buf_offset = so->output[i].dst_offset;
+
+         buf_offset += so->output[i].num_components;
+         if (sinfo->so_names[i] && n_outputs < ARRAY_SIZE(varyings))
+            varyings[n_outputs++] = strdup(sinfo->so_names[i]);
       }
+   }
 
-      skip = so->output[i].dst_offset - buf_offset;
+   if (!separate_attribs) {
+      skip = so->stride[last_buffer] - buf_offset;
       while (skip && n_outputs < ARRAY_SIZE(varyings)) {
          start_skip = get_skip_str(&skip);
          if (start_skip)
             varyings[n_outputs++] = start_skip;
       }
-      buf_offset = so->output[i].dst_offset;
-
-      buf_offset += so->output[i].num_components;
-      if (sinfo->so_names[i] && n_outputs < ARRAY_SIZE(varyings))
-         varyings[n_outputs++] = strdup(sinfo->so_names[i]);
-   }
-
-   skip = so->stride[last_buffer] - buf_offset;
-   while (skip && n_outputs < ARRAY_SIZE(varyings)) {
-      start_skip = get_skip_str(&skip);
-      if (start_skip)
-         varyings[n_outputs++] = start_skip;
    }
 
    glTransformFeedbackVaryings(prog_id, n_outputs,
-                               (const GLchar **)varyings, GL_INTERLEAVED_ATTRIBS_EXT);
+                               (const GLchar **)varyings,
+                               separate_attribs ? GL_SEPARATE_ATTRIBS_EXT :
+                                                  GL_INTERLEAVED_ATTRIBS_EXT);
 
    for (i = 0; i < n_outputs; i++)
       if (varyings[i])
