From 96ed7dcc366175b3ee5c7be673e10b9827842fbe Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 12 Sep 2026 21:38:45 +0900
Subject: [PATCH 24/28] vrend: stop a context error from stranding the guest

A command that reports a context error aborts the rest of its buffer and
leaves the context in error for good: every later submit fails the
context switch, every later transfer answers EINVAL, and the guest
receives nothing. A guest blocked on a query result or a readback spins
on the buffer the host is meant to write and issues no further command,
so a single unsupported command hangs the guest instead of failing the
work that used it. On a desktop GL host this costs a whole conformance
run.

Clear the error with the buffer that carried it, and answer a waiting
query whose context can no longer run with the invalid result rather
than dropping it. The error stays in the log and the dispatch still
fails; what no longer happens is the guest waiting forever.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/vrend/vrend_decode.c   |  5 +++++
 src/vrend/vrend_renderer.c | 23 ++++++++++++++++++++++-
 src/vrend/vrend_renderer.h |  2 ++
 3 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/src/vrend/vrend_decode.c b/src/vrend/vrend_decode.c
index d154feb..b460307 100644
--- a/src/vrend/vrend_decode.c
+++ b/src/vrend/vrend_decode.c
@@ -2089,6 +2089,7 @@ static int vrend_decode_ctx_submit_cmd(struct virgl_context *ctx,
       /* check if the guest is doing something bad */
       if (buf_offset > buf_total) {
          vrend_report_buffer_error(gdctx->grctx, 0);
+         vrend_clear_context_error(gdctx->grctx);
          break;
       }
 
@@ -2105,6 +2106,10 @@ static int vrend_decode_ctx_submit_cmd(struct virgl_context *ctx,
                gdctx->base.ctx_id, vrend_get_comand_name(cmd), ret);
          if (ret == EINVAL)
             vrend_report_buffer_error(gdctx->grctx, *buf);
+         /* The rest of this buffer is abandoned, but the context keeps
+          * serving the guest: see vrend_clear_context_error().
+          */
+         vrend_clear_context_error(gdctx->grctx);
          return ret;
       }
    }
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index e2b0142..6ec1e87 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -1199,6 +1199,19 @@ void vrend_report_context_error_internal(const char *fname, struct vrend_context
                value);
 }
 
+/* Drop the error state once the command buffer that reported it has been
+ * abandoned. The error itself stays visible in the log and in the failed
+ * dispatch the caller returns; what must not survive is a context that
+ * refuses every later command, because a guest blocked on a query result or
+ * a readback spins on the buffer the host writes and issues nothing more.
+ * One unsupported command then costs the guest its work, not its context.
+ */
+void vrend_clear_context_error(struct vrend_context *ctx)
+{
+   if (ctx)
+      ctx->in_error = false;
+}
+
 #define CORE_PROFILE_WARN_NONE 0
 #define CORE_PROFILE_WARN_STIPPLE 1
 #define CORE_PROFILE_WARN_POLYGON_MODE 2
@@ -12277,7 +12290,7 @@ static bool vrend_check_query(struct vrend_query *query)
    /* We got a boolean, but the client wanted the actual number of samples
     * blow the number up so that the client doesn't think it was just one pixel
     * and discards an object that might be bigger */
-   if (query->fake_samples_passed) {
+   if (query->fake_samples_passed && !query->invalid) {
       vrend_update_oq_samples_multiplier(query->ctx);
       state.result *= query->ctx->sub->fake_occlusion_query_samples_passed_multiplier;
    }
@@ -12348,6 +12361,14 @@ static void vrend_renderer_check_queries(void)
       if (!vrend_hw_switch_context_with_sub(query->ctx, query->sub_ctx_id)) {
          virgl_warn("Failed to switch to context (%d) with sub (%d) for query %u\n",
                       query->ctx->ctx_id, query->sub_ctx_id, query->id);
+         /* A context that reported an error can no longer run GL, but a guest
+          * blocked on this result spins on the buffer the host writes and
+          * never issues another command. Answer it with the invalid result so
+          * the guest makes progress and the failure surfaces as a wrong
+          * result rather than a hang.
+          */
+         query->invalid = true;
+         vrend_check_query(query);
       }
       else if (!vrend_check_query(query)) {
          continue;
diff --git a/src/vrend/vrend_renderer.h b/src/vrend/vrend_renderer.h
index 4fb216d..caa88fe 100644
--- a/src/vrend/vrend_renderer.h
+++ b/src/vrend/vrend_renderer.h
@@ -597,6 +597,8 @@ void vrend_report_context_error_internal(const char *fname, struct vrend_context
 #define vrend_report_buffer_error(ctx, cmd) \
     vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_CMD_BUFFER, cmd)
 
+void vrend_clear_context_error(struct vrend_context *ctx);
+
 void vrend_fb_bind_texture(struct vrend_resource *res,
                            GLuint idx,
                            GLint level, GLint layer);
