From 97b35e32c8219bdde628ae433022e0d0fb960d60 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 13 Aug 2026 00:00:00 +0900
Subject: [PATCH 01/27] vrend: support GLES 3.0 MSAA on iOS Metal

OpenGL ES 3.0 requires multisampled renderbuffers but does not gain
multisampled textures until ES 3.1.  The ANGLE Metal backend used on iOS
implements that ES 3.0 contract.  Teach vrend to probe multisample support per
renderbuffer format and use renderbuffer storage for two-dimensional
multisample render targets when multisample texture storage is unavailable.

This lets the guest advertise the actual multisample formats and sample count
instead of forcing max_samples to one.  The existing desktop GL path is left
unchanged.

Simulator Metal also rejects the nominal native RGB565 pixel format.  Use an
RGBA8 native texture when no packed guest-memory layout is involved, matching
ANGLE's existing Simulator format emulation, and otherwise fall back from the
native sharing path.
---
 src/vrend/vrend_decode.c   |  4 +-
 src/vrend/vrend_formats.c  | 42 ++++++++++++++------
 src/vrend/vrend_metal.m    | 22 ++++++++---
 src/vrend/vrend_renderer.c | 81 ++++++++++++++++++++++++++++++++++----
 src/vrend/vrend_renderer.h |  1 +
 tests/test_virgl_cmd.c     | 40 +++++++++++++++++++
 6 files changed, 164 insertions(+), 26 deletions(-)

diff --git a/src/vrend/vrend_decode.c b/src/vrend/vrend_decode.c
index 7774a25..d154feb 100644
--- a/src/vrend/vrend_decode.c
+++ b/src/vrend/vrend_decode.c
@@ -652,7 +652,9 @@ static int vrend_decode_create_surface_common(struct vrend_context *ctx, const u
    uint32_t res_handle = get_buf_entry(buf, VIRGL_OBJ_SURFACE_RES_HANDLE);
 
    struct vrend_resource *res = vrend_renderer_ctx_res_lookup(ctx, res_handle);
-   if (!res || !res->gl_id) {
+   if (!res || (!res->gl_id &&
+                !(has_bit(res->storage_bits, VREND_STORAGE_GL_RENDERBUFFER) &&
+                  res->rbo_id))) {
       vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_RESOURCE, res_handle);
       return EINVAL;
    }
diff --git a/src/vrend/vrend_formats.c b/src/vrend/vrend_formats.c
index 40ed4d5..8566fd3 100644
--- a/src/vrend/vrend_formats.c
+++ b/src/vrend/vrend_formats.c
@@ -650,25 +650,43 @@ void vrend_check_texture_multisample(struct vrend_format_table *table,
 {
    bool is_desktop_gl = epoxy_is_desktop_gl();
    for (int i = 0; i < VIRGL_FORMAT_MAX_EXTENDED; i++) {
+      bool use_renderbuffer = !is_desktop_gl && epoxy_gl_version() >= 30 &&
+                              !enable_storage;
       bool function_available =
-         (table[i].flags & VIRGL_TEXTURE_CAN_TEXTURE_STORAGE) ? enable_storage : is_desktop_gl;
+         use_renderbuffer ||
+         ((table[i].flags & VIRGL_TEXTURE_CAN_TEXTURE_STORAGE) ? enable_storage : is_desktop_gl);
 
       if (table[i].internalformat != 0 &&
           !(table[i].flags & VIRGL_TEXTURE_CAN_MULTISAMPLE) &&
           function_available) {
-         GLuint tex_id;
-         glGenTextures(1, &tex_id);
-         glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, tex_id);
-         if (table[i].flags & VIRGL_TEXTURE_CAN_TEXTURE_STORAGE) {
-            glTexStorage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, 2,
-                                      table[i].internalformat, 32, 32, GL_TRUE);
+         while (glGetError() != GL_NO_ERROR)
+            ;
+
+         if (use_renderbuffer) {
+            GLuint rbo_id;
+            glGenRenderbuffers(1, &rbo_id);
+            glBindRenderbuffer(GL_RENDERBUFFER, rbo_id);
+            glRenderbufferStorageMultisample(GL_RENDERBUFFER, 4,
+                                             table[i].internalformat, 32, 32);
+            if (glGetError() == GL_NO_ERROR)
+               table[i].flags |= VIRGL_TEXTURE_CAN_MULTISAMPLE;
+            glBindRenderbuffer(GL_RENDERBUFFER, 0);
+            glDeleteRenderbuffers(1, &rbo_id);
          } else {
-            glTexImage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, 2,
-                                    table[i].internalformat, 32, 32, GL_TRUE);
+            GLuint tex_id;
+            glGenTextures(1, &tex_id);
+            glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, tex_id);
+            if (table[i].flags & VIRGL_TEXTURE_CAN_TEXTURE_STORAGE) {
+               glTexStorage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, 2,
+                                         table[i].internalformat, 32, 32, GL_TRUE);
+            } else {
+               glTexImage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, 2,
+                                       table[i].internalformat, 32, 32, GL_TRUE);
+            }
+            if (glGetError() == GL_NO_ERROR)
+               table[i].flags |= VIRGL_TEXTURE_CAN_MULTISAMPLE;
+            glDeleteTextures(1, &tex_id);
          }
-         if (glGetError() == GL_NO_ERROR)
-            table[i].flags |= VIRGL_TEXTURE_CAN_MULTISAMPLE;
-         glDeleteTextures(1, &tex_id);
       }
    }
 }
