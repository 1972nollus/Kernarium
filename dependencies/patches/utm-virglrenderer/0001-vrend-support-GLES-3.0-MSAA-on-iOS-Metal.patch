-static MTLTextureDescriptor *new_descriptor(const struct vrend_metal_texture_description *desc)
+static MTLTextureDescriptor *new_descriptor(const struct vrend_metal_texture_description *desc,
+                                             bool allow_rgb565_emulation)
 {
    MTLPixelFormat pixel_format;
 
-   if (!virgl_format_to_metal_format(desc->format, &pixel_format)) {
+#if TARGET_OS_SIMULATOR
+   /* Simulator Metal rejects its nominal B5G6R5 format.  Native textures
+    * have no packed guest-memory layout, so use RGBA8 and let ANGLE expose
+    * RGB565 semantics.  A shared-memory texture cannot change bytes per
+    * pixel and must fall back to the non-native path instead. */
+   if (desc->format == VIRGL_FORMAT_B5G6R5_UNORM) {
+      if (!allow_rgb565_emulation)
+         return NULL;
+      pixel_format = MTLPixelFormatRGBA8Unorm;
+   } else
+#endif
+   if (!virgl_format_to_metal_format(desc->format, &pixel_format))
       return NULL;
-   }
 
    MTLTextureDescriptor *descriptor = [MTLTextureDescriptor new];
    descriptor.textureType = MTLTextureType2D;
@@ -111,7 +123,7 @@ bool virgl_metal_create_texture(MTLDevice_id device,
                                 MTLTexture_id *tex)
 {
    id<MTLDevice> mtl_device = (id<MTLDevice>)device;
-   MTLTextureDescriptor *descriptor = new_descriptor(desc);
+   MTLTextureDescriptor *descriptor = new_descriptor(desc, true);
    if (descriptor) {
       *tex = [mtl_device newTextureWithDescriptor:descriptor];
       [descriptor release];
@@ -128,7 +140,7 @@ bool virgl_metal_create_texture_from_shm(MTLDevice_id device,
