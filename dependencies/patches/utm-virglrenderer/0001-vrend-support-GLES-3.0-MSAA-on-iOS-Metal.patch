    *tex = nil;
    if (!mtl_device || !descriptor) {
       [descriptor release];
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index e6ae007..86498a9 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -1492,7 +1492,7 @@ static bool vrend_compile_shader(struct vrend_sub_context *sub_ctx,
 
    shader->id = glCreateShader(conv_shader_type(shader->sel->type));
    glShaderSource(shader->id, shader->glsl_strings.num_strings, shader_parts, NULL);
-   
+
    /* Free temporary modified shader strings */
    for (int i = 0; i < shader->glsl_strings.num_strings; i++) {
       if (modified_shaders[i])
@@ -3084,6 +3084,15 @@ void vrend_fb_bind_texture_id(struct vrend_resource *res,
          attachment = GL_DEPTH_ATTACHMENT;
    }
 
+   if (has_bit(res->storage_bits, VREND_STORAGE_GL_RENDERBUFFER)) {
+      glFramebufferRenderbuffer(GL_FRAMEBUFFER, attachment,
+                                GL_RENDERBUFFER, res->rbo_id);
+      if (attachment == GL_DEPTH_ATTACHMENT)
+         glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_STENCIL_ATTACHMENT,
+                                   GL_RENDERBUFFER, 0);
+      return;
+   }
+
    switch (res->target) {
    case GL_TEXTURE_1D_ARRAY:
    case GL_TEXTURE_2D_ARRAY:
@@ -8876,6 +8885,47 @@ static int vrend_resource_alloc_texture(struct vrend_resource *gr,
    const bool format_can_texture_storage = has_feature(feat_texture_storage) &&
         (tex_conv_table[format].flags & VIRGL_TEXTURE_CAN_TEXTURE_STORAGE);
 
+   /* ES 3.0 exposes multisampled renderbuffers, while multisampled textures
+    * require ES 3.1.  WebGL renderbuffers are PIPE_TEXTURE_2D resources and
+    * resolve through the framebuffer blit path, so preserve real MSAA on an
+    * ES 3.0 host by storing those resources in GL renderbuffers. */
+   if (!image_oes && vrend_state.use_gles && pr->nr_samples > 1 &&
+       pr->target == PIPE_TEXTURE_2D &&
+       !has_feature(feat_storage_multisample)) {
+      GLenum error;
+
+      internalformat = tex_conv_table[format].internalformat;
+      if (internalformat == 0 ||
+          !(tex_conv_table[format].flags & VIRGL_TEXTURE_CAN_MULTISAMPLE)) {
+         virgl_error("Unsupported multisample renderbuffer format is %d\n", format);
+         return EINVAL;
+      }
+
+      while (glGetError() != GL_NO_ERROR)
+         ;
+      gr->target = GL_RENDERBUFFER;
+      gr->storage_bits |= VREND_STORAGE_GL_RENDERBUFFER;
+      glGenRenderbuffers(1, &gr->rbo_id);
+      glBindRenderbuffer(GL_RENDERBUFFER, gr->rbo_id);
+      glRenderbufferStorageMultisample(GL_RENDERBUFFER, pr->nr_samples,
+                                       internalformat, pr->width0, pr->height0);
+      error = glGetError();
+      glBindRenderbuffer(GL_RENDERBUFFER, 0);
+      if (error != GL_NO_ERROR) {
+         virgl_error("Could not allocate multisample renderbuffer: 0x%x\n", error);
+         glDeleteRenderbuffers(1, &gr->rbo_id);
+         gr->rbo_id = 0;
+         gr->storage_bits &= ~VREND_STORAGE_GL_RENDERBUFFER;
+         return EINVAL;
+      }
+
+      gt->state.max_lod = -1;
+      gt->cur_swizzle[0] = gt->cur_swizzle[1] = gt->cur_swizzle[2] = gt->cur_swizzle[3] = -1;
+      gt->cur_base = -1;
+      gt->cur_max = 10000;
+      return 0;
+   }
+
    if (format_can_texture_storage)
       gr->storage_bits |= VREND_STORAGE_GL_IMMUTABLE;
 
@@ -11136,6 +11186,12 @@ void vrend_renderer_resource_copy_region(struct vrend_context *ctx,
                                                      comp_flags) &&
                            src_res->base.nr_samples == dst_res->base.nr_samples;
 
+   if (allow_copy_image &&
+       (has_bit(src_res->storage_bits, VREND_STORAGE_GL_RENDERBUFFER) ||
+        has_bit(dst_res->storage_bits, VREND_STORAGE_GL_RENDERBUFFER))) {
+      allow_copy_image = false;
+   }
+
    /* ANGLE/Metal on macOS returns GL_INVALID_ENUM for multisample copy_image
     * targets when running in GLES mode. Prefer the blit fallback instead.
     */
@@ -11235,6 +11291,9 @@ static inline bool texture_view_compatible(enum virgl_formats src, enum virgl_fo
 
 static GLuint vrend_make_view(struct vrend_resource *res, enum virgl_formats format)
 {
+   if (has_bit(res->storage_bits, VREND_STORAGE_GL_RENDERBUFFER))
