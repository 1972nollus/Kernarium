From 7d560e8267b82a494e6c7cee959601f7c4a4c117 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 12 Sep 2026 10:46:23 +0900
Subject: [PATCH 17/30] vrend: scope the Apple GL workarounds to Apple's own
 driver

The Apple workarounds in vrend are all properties of Apple's own OpenGL
implementation, which stops at 4.1: it lacks GL_ARB_copy_image and
glCopyBufferSubData, crashes above 64 combined texture image units, and
needs its GLSL level pinned so the guest does not fall back to GL 2.1.
They were written when a desktop GL context on macOS could only come
from that driver, so they test the platform rather than the host stack.

A desktop context on macOS can now come from Mesa instead, which
implements all of the above and reports OpenGL 4.6. Applying the
workarounds to it capped the caps sent to the guest at GLSL 4.10 and
cleared copy-image support, so the guest driver saw a 4.1 host however
capable the real one was.

Record whether the host desktop context is Apple's own driver -- no
other desktop implementation on the platform reports below 4.2 -- and
gate the four workarounds on that instead of on __APPLE__. The GLES
provider keeps the copy-image fallback it already had, so ANGLE on macOS
and iOS is unaffected, and the legacy desktop stack keeps every
workaround it needs.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/vrend/vrend_renderer.c | 32 +++++++++++++++++---------------
 1 file changed, 17 insertions(+), 15 deletions(-)

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 96e3f81..24e4c59 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -393,6 +393,9 @@ struct global_renderer_state {
    bool finishing : 1;
    bool use_gles : 1;
    bool use_core_profile : 1;
+   /* Apple's own desktop OpenGL, which stops at 4.1 and needs workarounds a
+    * newer desktop context from Mesa does not. */
+   bool use_apple_legacy_gl : 1;
    bool use_external_blob : 1;
    bool use_integer : 1;
    /* these appeared broken on at least one driver */
@@ -7875,8 +7878,14 @@ int vrend_renderer_init(const struct vrend_if_cbs *cbs, uint32_t flags)
                  gles ? gl_ver : 0);
 
 #ifdef __APPLE__
-   /* macOS core GL 4.1 lacks GL_ARB_copy_image; force fallback paths. */
-   clear_feature(feat_copy_image);
+   /* Apple's own OpenGL stops at 4.1, so any newer desktop context comes from
+    * Mesa and behaves like every other conformant driver. */
+   vrend_state.use_apple_legacy_gl = !gles && gl_ver < 42;
+
+   /* Apple's GLES provider and its 4.1 desktop GL lack a usable
+    * GL_ARB_copy_image; force fallback paths for those alone. */
+   if (gles || vrend_state.use_apple_legacy_gl)
+      clear_feature(feat_copy_image);
 #endif
 
    if (!vrend_winsys_has_gl_colorspace())
@@ -7890,12 +7899,10 @@ int vrend_renderer_init(const struct vrend_if_cbs *cbs, uint32_t flags)
    glGetIntegerv(GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS,
                  (GLint*)&vrend_state.max_texture_units);
 
-#ifdef __APPLE__
    /* Bug in Apple CGL which crashes if this is > 64 due to a invalid LSL */
-   if (!gles && vrend_state.max_texture_units > 64) {
+   if (vrend_state.use_apple_legacy_gl && vrend_state.max_texture_units > 64) {
       vrend_state.max_texture_units = 64;
    }
-#endif
 
    /* Mesa clamps this value to 8 anyway, so just make sure that this side
     * doesn't exceed the number to be on the save side when using 8-bit masks
@@ -10917,18 +10924,14 @@ static void vrend_resource_buffer_copy(UNUSED struct vrend_context *ctx,
    glBindBuffer(GL_COPY_READ_BUFFER, src_res->gl_id);
    glBindBuffer(GL_COPY_WRITE_BUFFER, dst_res->gl_id);
 
-#ifdef __APPLE__
    /* Apple CGL does not implement glCopyBufferSubData */
-   if (!vrend_state.use_gles) {
+   if (vrend_state.use_apple_legacy_gl) {
       void *src = glMapBufferRange(GL_COPY_READ_BUFFER, srcx, width, GL_MAP_READ_BIT);
       glBufferSubData(GL_COPY_WRITE_BUFFER, dstx, width, src);
       glUnmapBuffer(GL_COPY_READ_BUFFER);
    } else {
       glCopyBufferSubData(GL_COPY_READ_BUFFER, GL_COPY_WRITE_BUFFER, srcx, dstx, width);
    }
-#else
-   glCopyBufferSubData(GL_COPY_READ_BUFFER, GL_COPY_WRITE_BUFFER, srcx, dstx, width);
-#endif
    glBindBuffer(GL_COPY_READ_BUFFER, 0);
    glBindBuffer(GL_COPY_WRITE_BUFFER, 0);
 }
@@ -12704,15 +12707,14 @@ static int get_glsl_version(void)
 static void vrend_fill_caps_glsl_version(int gl_ver, int gles_ver,
                                          union virgl_caps *caps)
 {
-#ifdef __APPLE__
-   /* macOS Metal reports GL 4.1 core but Mesa needs explicit GLSL 4.10.
-    * Force this for any desktop GL context on macOS to avoid fallback to GL 2.1.
+   /* Apple's own desktop GL reports 4.1 core but Mesa needs an explicit GLSL
+    * 4.10 to avoid falling back to GL 2.1. A Mesa host context follows the
+    * generic rules below and can reach GLSL 4.60.
     */
-   if (gl_ver >= 30 && gles_ver == 0) {
+   if (vrend_state.use_apple_legacy_gl && gl_ver >= 30 && gles_ver == 0) {
       caps->v1.glsl_level = 410;
       return;
    }
-#endif
 
    if (gles_ver > 0) {
       caps->v1.glsl_level = 120;
