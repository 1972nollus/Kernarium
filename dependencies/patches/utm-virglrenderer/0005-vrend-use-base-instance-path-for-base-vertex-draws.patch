From 923536914fe1e77a63f61ebc43c822c130bab683 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 2 Sep 2026 02:34:09 +0900
Subject: [PATCH 05/20] vrend: use base-instance path for base-vertex draws

---
 src/vrend/vrend_renderer.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 06d45fd..96e3f81 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -6311,6 +6311,16 @@ int vrend_draw_vbo(struct vrend_context *ctx,
                                                              info->instance_count, info->index_bias, info->start_instance);
             } else if (has_feature(feat_draw_elements_base_vertex)) {
                glDrawElementsInstancedBaseVertex(mode, info->count, elsz, (void *)(uintptr_t)sub_ctx->ib.offset, info->instance_count, info->index_bias);
+            } else if (has_feature(feat_base_instance)) {
+               /*
+                * GL_EXT_base_instance exposes the combined base-vertex and
+                * base-instance entry point without necessarily exposing
+                * GL_EXT_draw_elements_base_vertex.  A zero base instance is
+                * equivalent to the base-vertex-only instanced draw.
+                */
+               glDrawElementsInstancedBaseVertexBaseInstance(mode, info->count, elsz,
+                                                             (void *)(uintptr_t)sub_ctx->ib.offset,
+                                                             info->instance_count, info->index_bias, 0);
             } else {
                return EINVAL;
             }
@@ -6320,6 +6330,11 @@ int vrend_draw_vbo(struct vrend_context *ctx,
             } else {
                glDrawElementsBaseVertex(mode, info->count, elsz, (void *)(uintptr_t)sub_ctx->ib.offset, info->index_bias);
             }
+         } else if (has_feature(feat_base_instance)) {
+            /* One instance preserves non-instanced gl_InstanceID semantics. */
+            glDrawElementsInstancedBaseVertexBaseInstance(mode, info->count, elsz,
+                                                          (void *)(uintptr_t)sub_ctx->ib.offset,
+                                                          1, info->index_bias, 0);
          } else {
             return EINVAL;
          }
