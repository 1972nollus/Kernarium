From e0a96c4064b3bea1dd4f9284e1c887f8a8193ead Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 12 Sep 2026 21:55:42 +0900
Subject: [PATCH 26/26] vrend: declare integer shader types on a desktop core
 profile

use_integer() asks the GL vendor string whether the emitted shaders
should declare integer fragment outputs and vertex inputs, and only
ARM and ANGLE answer yes. On every other host the emitter writes a
float output into a pure-integer colour attachment, which a core
profile leaves undefined and a conformant driver reads back as zero.
Every GL45-ES31 builtin_functions case whose executor output is an
int or a uint fails this way, while the float outputs of the same
draw are correct.

The profile, not the vendor, decides: ask for the integer types on a
desktop core profile and leave the GLES hosts on the list they have.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/vrend/vrend_renderer.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 6ec1e87..18334a4 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -7784,6 +7784,16 @@ static bool use_integer(void) {
    if (getenv("VIRGL_USE_INTEGER"))
       return true;
 
+   /* A desktop core profile requires a fragment output and a vertex input to
+    * carry the same base type as the colour attachment and the attribute
+    * respectively: a float output written into an integer attachment is
+    * undefined, and a conformant driver hands the reader zeroes. The vendor
+    * list below predates hosts that enforce it, so ask for the integer types
+    * wherever the profile demands them.
+    */
+   if (vrend_state.use_core_profile && !vrend_state.use_gles)
+      return true;
+
    const char * a = (const char *) glGetString(GL_VENDOR);
    return a && !(strcmp(a, "ARM") && strcmp(a, "Google Inc. (Apple)"));
 }
