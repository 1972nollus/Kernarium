diff --git a/src/venus/vkr_host_memory.c b/src/venus/vkr_host_memory.c
new file mode 100644
index 0000000..0e36494
--- /dev/null
+++ b/src/venus/vkr_host_memory.c
@@ -0,0 +1,68 @@
+/*
+ * Copyright 2026 The linux-um-darwin Authors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vkr_host_memory.h"
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "util/anon_file.h"
+
+struct vkr_host_shm *
+vkr_host_shm_alloc(uint64_t size, uint64_t alignment)
+{
+   const uint64_t page_size = (uint64_t)getpagesize();
+   if (alignment < page_size)
+      alignment = page_size;
+   if (!alignment || size > UINT64_MAX - alignment + 1)
+      return NULL;
+
+   const uint64_t remainder = size % alignment;
+   const uint64_t aligned_size = remainder ? size + alignment - remainder : size;
+   if (!aligned_size || aligned_size > SIZE_MAX || aligned_size > INT64_MAX)
+      return NULL;
+
+   int fd = os_create_anonymous_file((off_t)aligned_size, "vkr-host-mem");
+   if (fd < 0)
+      return NULL;
+
+   void *ptr = mmap(NULL, (size_t)aligned_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   if (ptr == MAP_FAILED) {
+      close(fd);
+      return NULL;
+   }
+
+   if ((uintptr_t)ptr % alignment) {
+      munmap(ptr, (size_t)aligned_size);
+      close(fd);
+      return NULL;
+   }
+
+   struct vkr_host_shm *shm = calloc(1, sizeof(*shm));
+   if (!shm) {
+      munmap(ptr, (size_t)aligned_size);
+      close(fd);
+      return NULL;
+   }
+
+   shm->fd = fd;
+   shm->ptr = ptr;
+   shm->size = (size_t)aligned_size;
+   return shm;
+}
+
+void
+vkr_host_shm_free(struct vkr_host_shm *shm)
+{
+   if (!shm)
+      return;
+   if (shm->ptr)
+      munmap(shm->ptr, shm->size);
+   if (shm->fd >= 0)
+      close(shm->fd);
+   free(shm);
+}
diff --git a/src/venus/vkr_host_memory.h b/src/venus/vkr_host_memory.h
new file mode 100644
index 0000000..55c2f5c
--- /dev/null
+++ b/src/venus/vkr_host_memory.h
@@ -0,0 +1,24 @@
+/*
+ * Copyright 2026 The linux-um-darwin Authors
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VKR_HOST_MEMORY_H
+#define VKR_HOST_MEMORY_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct vkr_host_shm {
+   int fd;
+   void *ptr;
+   size_t size;
+};
+
+struct vkr_host_shm *
+vkr_host_shm_alloc(uint64_t size, uint64_t alignment);
+
+void
+vkr_host_shm_free(struct vkr_host_shm *shm);
+
+#endif /* VKR_HOST_MEMORY_H */
