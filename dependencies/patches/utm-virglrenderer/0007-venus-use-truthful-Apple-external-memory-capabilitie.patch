-struct vkr_mtl_shm *
-vkr_mtl_shm_alloc(void *mtl_device, uint64_t size)
-{
-   if (!mtl_device)
-      return NULL;
-
-   const size_t page_size = getpagesize();
-   const size_t aligned_size = (size + page_size - 1) & ~(page_size - 1);
-
-   int shm_fd = os_create_anonymous_file(aligned_size, "vkr-metal-mem");
-   if (shm_fd < 0)
