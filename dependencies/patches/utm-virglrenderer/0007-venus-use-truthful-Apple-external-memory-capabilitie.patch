-                                                    length:aligned_size
-                                                   options:MTLResourceStorageModeShared
-                                               deallocator:nil];
-   if (!buffer) {
-      munmap(shm_ptr, aligned_size);
-      close(shm_fd);
-      return NULL;
-   }
-
-   struct vkr_mtl_shm *shm = calloc(1, sizeof(*shm));
-   if (!shm) {
-      CFRelease(buffer);
-      munmap(shm_ptr, aligned_size);
-      close(shm_fd);
-      return NULL;
-   }
-
-   shm->shm_fd = shm_fd;
-   shm->shm_ptr = shm_ptr;
-   shm->shm_size = aligned_size;
-   shm->mtl_buffer = (void *)buffer;
-   return shm;
-}
-
-void
-vkr_mtl_shm_free(struct vkr_mtl_shm *shm)
-{
