+#include <CoreMedia/CoreMedia.h>
+
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "pipe/p_video_enums.h"
+#include "vrend_video_h264.h"
+
+static void test_annexb_conversion(void)
+{
+   static const uint8_t annexb[] = {
+      0, 0, 0, 1, 0x67, 0x64, 0, 0x33,
+      0, 0, 1, 0x68, 0xee, 0x3c, 0x80,
+      0, 0, 1, 0x65, 0xb2, 0x40,
+   };
+   static const uint8_t expected[] = {
+      0, 0, 0, 3, 0x65, 0xb2, 0x40,
+   };
+   uint8_t *avcc = NULL;
+   size_t avcc_size = 0;
+   uint32_t pps_id = 0;
+
+   assert(vrend_video_h264_annexb_to_avcc(
+             annexb, sizeof(annexb), &avcc, &avcc_size, &pps_id) == 0);
+   assert(pps_id == 3);
+   assert(avcc_size == sizeof(expected));
+   assert(memcmp(avcc, expected, sizeof(expected)) == 0);
+   free(avcc);
+}
+
+static void test_parameter_sets(void)
+{
+   struct virgl_h264_picture_desc desc = {0};
+   struct vrend_h264_parameter_sets sets = {0};
+   struct vrend_h264_parameter_sets effective_reference_sets = {0};
+   const uint8_t *pointers[2];
+   size_t sizes[2];
+   CMVideoDimensions dimensions;
+   CMVideoFormatDescriptionRef format = NULL;
+
+   desc.base.profile = PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN;
+   desc.base.entry_point = PIPE_VIDEO_ENTRYPOINT_BITSTREAM;
+   desc.pps.sps.level_idc = 40;
+   desc.pps.sps.chroma_format_idc = 1;
+   desc.pps.sps.frame_mbs_only_flag = 1;
+   desc.pps.sps.direct_8x8_inference_flag = 1;
+   desc.pps.sps.max_num_ref_frames = 4;
+   desc.pps.deblocking_filter_control_present_flag = 1;
+
+   assert(vrend_video_h264_build_parameter_sets(
+             desc.base.profile, 1920, 1080, 3, &desc, &sets) == 0);
+   assert(sets.sps_size > 4 && sets.sps[0] == 0x67);
+   assert(sets.pps_size > 2 && sets.pps[0] == 0x68);
+
+   pointers[0] = sets.sps;
+   pointers[1] = sets.pps;
+   sizes[0] = sets.sps_size;
+   sizes[1] = sets.pps_size;
+   assert(CMVideoFormatDescriptionCreateFromH264ParameterSets(
+             kCFAllocatorDefault, 2, pointers, sizes, 4, &format) == noErr);
+   assert(format != NULL);
+   dimensions = CMVideoFormatDescriptionGetDimensions(format);
+   assert(dimensions.width == 1920);
+   assert(dimensions.height == 1080);
+   CFRelease(format);
+
+   desc.num_ref_idx_l0_active_minus1 = 2;
+   desc.num_ref_idx_l1_active_minus1 = 1;
+   assert(vrend_video_h264_build_parameter_sets(
+             desc.base.profile, 1920, 1080, 3, &desc,
+             &effective_reference_sets) == 0);
+   assert(effective_reference_sets.pps_size != sets.pps_size ||
+          memcmp(effective_reference_sets.pps, sets.pps,
+                 sets.pps_size) != 0);
+
+   desc.pps.num_ref_idx_l0_default_active_minus1 = 7;
+   desc.pps.num_ref_idx_l1_default_active_minus1 = 7;
+   assert(vrend_video_h264_build_parameter_sets(
+             desc.base.profile, 1920, 1080, 3, &desc, &sets) == 0);
+   assert(sets.pps_size == effective_reference_sets.pps_size);
+   assert(memcmp(sets.pps, effective_reference_sets.pps,
+                 sets.pps_size) == 0);
+
+   assert(vrend_video_h264_build_parameter_sets(
+             desc.base.profile, 1921, 1080, 3, &desc, &sets) == -1);
+}
+
+int main(void)
+{
+   test_annexb_conversion();
+   test_parameter_sets();
+   return 0;
+}
