+
+#include "vrend_video_h264.h"
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "pipe/p_video_enums.h"
+
+struct rbsp_writer {
+   uint8_t data[VREND_H264_PARAMETER_SET_MAX_SIZE];
+   size_t bit_count;
+   bool failed;
+};
+
+struct bit_reader {
+   const uint8_t *data;
+   size_t size;
+   size_t bit_offset;
+};
+
+static const uint8_t zigzag_4x4[16] = {
+   0, 1, 4, 8, 5, 2, 3, 6,
+   9, 12, 13, 10, 7, 11, 14, 15,
+};
+
+static const uint8_t zigzag_8x8[64] = {
+   0, 1, 8, 16, 9, 2, 3, 10,
+   17, 24, 32, 25, 18, 11, 4, 5,
+   12, 19, 26, 33, 40, 48, 41, 34,
+   27, 20, 13, 6, 7, 14, 21, 28,
+   35, 42, 49, 56, 57, 50, 43, 36,
+   29, 22, 15, 23, 30, 37, 44, 51,
+   58, 59, 52, 45, 38, 31, 39, 46,
+   53, 60, 61, 54, 47, 55, 62, 63,
+};
+
+static void rbsp_put_bit(struct rbsp_writer *writer, uint32_t bit)
+{
+   const size_t byte = writer->bit_count / 8;
+   const unsigned shift = 7 - (writer->bit_count % 8);
+
+   if (byte >= sizeof(writer->data)) {
+      writer->failed = true;
+      return;
+   }
+
+   if ((writer->bit_count % 8) == 0)
+      writer->data[byte] = 0;
+   writer->data[byte] |= (bit & 1U) << shift;
+   writer->bit_count++;
+}
+
+static void rbsp_put_bits(struct rbsp_writer *writer,
+                          uint32_t value,
+                          unsigned count)
+{
+   while (count > 0) {
+      count--;
+      rbsp_put_bit(writer, value >> count);
+   }
+}
+
+static void rbsp_put_ue(struct rbsp_writer *writer, uint32_t value)
+{
+   uint64_t code = (uint64_t)value + 1;
+   unsigned bits = 0;
+   uint64_t remaining = code;
+
+   while (remaining) {
+      bits++;
+      remaining >>= 1;
+   }
+   for (unsigned i = 1; i < bits; i++)
+      rbsp_put_bit(writer, 0);
+   for (unsigned i = bits; i > 0; i--)
+      rbsp_put_bit(writer, (uint32_t)(code >> (i - 1)));
+}
+
+static void rbsp_put_se(struct rbsp_writer *writer, int32_t value)
+{
+   uint32_t code;
+
+   if (value <= 0)
+      code = (uint32_t)(-(int64_t)value * 2);
+   else
+      code = (uint32_t)((int64_t)value * 2 - 1);
+   rbsp_put_ue(writer, code);
+}
+
+static void rbsp_finish(struct rbsp_writer *writer)
+{
+   rbsp_put_bit(writer, 1);
+   while (writer->bit_count % 8)
+      rbsp_put_bit(writer, 0);
+}
+
+static int rbsp_to_nal(uint8_t nal_header,
+                       const struct rbsp_writer *writer,
+                       uint8_t *nal,
+                       size_t *nal_size)
+{
+   size_t output = 0;
+   unsigned zero_count = 0;
+   const size_t rbsp_size = writer->bit_count / 8;
+
+   if (writer->failed || !nal || !nal_size)
+      return -1;
+
+   nal[output++] = nal_header;
+   for (size_t i = 0; i < rbsp_size; i++) {
+      const uint8_t byte = writer->data[i];
+
+      if (zero_count >= 2 && byte <= 3) {
+         if (output >= VREND_H264_PARAMETER_SET_MAX_SIZE)
+            return -1;
+         nal[output++] = 3;
+         zero_count = 0;
+      }
+      if (output >= VREND_H264_PARAMETER_SET_MAX_SIZE)
+         return -1;
+      nal[output++] = byte;
+      zero_count = byte == 0 ? zero_count + 1 : 0;
+   }
+
+   *nal_size = output;
+   return 0;
+}
+
+static bool h264_profile(uint32_t profile,
+                         uint8_t *profile_idc,
+                         uint8_t *constraints)
+{
+   switch (profile) {
+   case PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE:
+      *profile_idc = 66;
+      *constraints = 0x80;
+      return true;
+   case PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE:
+      *profile_idc = 66;
+      *constraints = 0xc0;
+      return true;
+   case PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN:
+      *profile_idc = 77;
+      *constraints = 0x40;
+      return true;
+   case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH:
+      *profile_idc = 100;
+      *constraints = 0;
+      return true;
+   default:
+      return false;
+   }
+}
+
+static bool matrix_is_valid(const uint8_t *matrix, size_t size)
+{
+   for (size_t i = 0; i < size; i++) {
+      if (matrix[i] == 0)
+         return false;
+   }
+   return true;
+}
+
+static void rbsp_put_scaling_list(struct rbsp_writer *writer,
+                                  const uint8_t *matrix,
+                                  const uint8_t *scan,
+                                  size_t size)
+{
+   int last_scale = 8;
+
+   for (size_t i = 0; i < size; i++) {
+      int next_scale = matrix[scan[i]];
+      int delta = next_scale - last_scale;
+
+      if (delta > 127)
+         delta -= 256;
+      else if (delta < -128)
+         delta += 256;
+      rbsp_put_se(writer, delta);
+      last_scale = next_scale;
+   }
+}
+
+static bool pps_matrices_are_valid(const struct virgl_h264_pps *pps)
+{
+   for (unsigned i = 0; i < 6; i++) {
+      if (!matrix_is_valid(pps->ScalingList4x4[i], 16))
+         return false;
+   }
+   if (pps->transform_8x8_mode_flag) {
+      for (unsigned i = 0; i < 2; i++) {
+         if (!matrix_is_valid(pps->ScalingList8x8[i], 64))
+            return false;
+      }
+   }
+   return true;
+}
+
+int vrend_video_h264_build_parameter_sets(
+   uint32_t profile,
+   uint32_t width,
+   uint32_t height,
+   uint32_t pps_id,
+   const struct virgl_h264_picture_desc *desc,
+   struct vrend_h264_parameter_sets *sets)
+{
+   struct rbsp_writer sps_writer = {0};
+   struct rbsp_writer pps_writer = {0};
+   const struct virgl_h264_sps *sps;
+   const struct virgl_h264_pps *pps;
+   uint8_t profile_idc;
+   uint8_t constraints;
+   uint32_t max_refs;
+   uint32_t coded_width;
+   uint32_t coded_height;
+   uint32_t map_unit_height;
+   bool has_frame_crop;
+   bool has_pps_extension;
+   bool has_pps_matrices;
+
+   if (!desc || !sets || !width || !height || (width & 1) || (height & 1) ||
+       pps_id > 255 ||
+       !h264_profile(profile, &profile_idc, &constraints))
+      return -1;
+
+   sps = &desc->pps.sps;
+   pps = &desc->pps;
+   if (sps->chroma_format_idc != 1 || sps->separate_colour_plane_flag ||
+       sps->bit_depth_luma_minus8 || sps->bit_depth_chroma_minus8 ||
+       sps->log2_max_frame_num_minus4 > 12 ||
+       sps->log2_max_pic_order_cnt_lsb_minus4 > 12 ||
+       sps->pic_order_cnt_type > 2 || !sps->frame_mbs_only_flag ||
+       pps->num_slice_groups_minus1)
+      return -1;
+
+   rbsp_put_bits(&sps_writer, profile_idc, 8);
+   rbsp_put_bits(&sps_writer, constraints, 8);
+   rbsp_put_bits(&sps_writer, sps->level_idc ? sps->level_idc : 51, 8);
+   rbsp_put_ue(&sps_writer, 0);
+   if (profile_idc == 100) {
+      rbsp_put_ue(&sps_writer, sps->chroma_format_idc);
+      rbsp_put_ue(&sps_writer, sps->bit_depth_luma_minus8);
+      rbsp_put_ue(&sps_writer, sps->bit_depth_chroma_minus8);
+      rbsp_put_bit(&sps_writer, 0);
+      rbsp_put_bit(&sps_writer, 0);
+   }
+   rbsp_put_ue(&sps_writer, sps->log2_max_frame_num_minus4);
+   rbsp_put_ue(&sps_writer, sps->pic_order_cnt_type);
+   if (sps->pic_order_cnt_type == 0) {
+      rbsp_put_ue(&sps_writer, sps->log2_max_pic_order_cnt_lsb_minus4);
+   } else if (sps->pic_order_cnt_type == 1) {
+      rbsp_put_bit(&sps_writer, sps->delta_pic_order_always_zero_flag);
+      rbsp_put_se(&sps_writer, sps->offset_for_non_ref_pic);
+      rbsp_put_se(&sps_writer, sps->offset_for_top_to_bottom_field);
+      rbsp_put_ue(&sps_writer, sps->num_ref_frames_in_pic_order_cnt_cycle);
+      for (unsigned i = 0; i < sps->num_ref_frames_in_pic_order_cnt_cycle; i++)
+         rbsp_put_se(&sps_writer, sps->offset_for_ref_frame[i]);
+   }
+   max_refs = sps->max_num_ref_frames ? sps->max_num_ref_frames :
+              desc->num_ref_frames;
+   rbsp_put_ue(&sps_writer, max_refs);
+   rbsp_put_bit(&sps_writer, 0);
+   coded_width = (width + 15) & ~15U;
+   rbsp_put_ue(&sps_writer, coded_width / 16 - 1);
+   map_unit_height = 16 * (2 - sps->frame_mbs_only_flag);
+   coded_height = (height + map_unit_height - 1) /
+                  map_unit_height * map_unit_height;
+   rbsp_put_ue(&sps_writer, coded_height / map_unit_height - 1);
+   rbsp_put_bit(&sps_writer, sps->frame_mbs_only_flag);
+   rbsp_put_bit(&sps_writer, sps->direct_8x8_inference_flag);
+   has_frame_crop = coded_width != width || coded_height != height;
+   rbsp_put_bit(&sps_writer, has_frame_crop);
+   if (has_frame_crop) {
+      rbsp_put_ue(&sps_writer, 0);
+      rbsp_put_ue(&sps_writer, (coded_width - width) / 2);
+      rbsp_put_ue(&sps_writer, 0);
+      rbsp_put_ue(&sps_writer, (coded_height - height) / 2);
+   }
+   rbsp_put_bit(&sps_writer, 0);
+   rbsp_finish(&sps_writer);
+   if (rbsp_to_nal(0x67, &sps_writer, sets->sps, &sets->sps_size) != 0)
+      return -1;
+
+   rbsp_put_ue(&pps_writer, pps_id);
+   rbsp_put_ue(&pps_writer, 0);
+   rbsp_put_bit(&pps_writer, pps->entropy_coding_mode_flag);
+   rbsp_put_bit(&pps_writer,
+                pps->bottom_field_pic_order_in_frame_present_flag);
+   rbsp_put_ue(&pps_writer, pps->num_slice_groups_minus1);
+   /*
+    * Gallium's VA frontend provides the effective reference counts from the
+    * slice parameter buffer, but VA-API does not expose the defaults from the
+    * original PPS.  Using the effective counts as the synthesized defaults
+    * parses both kinds of slices correctly: slices without an override use
+    * these values, while slices with an override carry their own values.
+    */
+   rbsp_put_ue(&pps_writer, desc->num_ref_idx_l0_active_minus1);
+   rbsp_put_ue(&pps_writer, desc->num_ref_idx_l1_active_minus1);
+   rbsp_put_bit(&pps_writer, pps->weighted_pred_flag);
+   rbsp_put_bits(&pps_writer, pps->weighted_bipred_idc, 2);
+   rbsp_put_se(&pps_writer, pps->pic_init_qp_minus26);
+   rbsp_put_se(&pps_writer, pps->pic_init_qs_minus26);
+   rbsp_put_se(&pps_writer, pps->chroma_qp_index_offset);
+   rbsp_put_bit(&pps_writer, pps->deblocking_filter_control_present_flag);
+   rbsp_put_bit(&pps_writer, pps->constrained_intra_pred_flag);
+   rbsp_put_bit(&pps_writer, pps->redundant_pic_cnt_present_flag);
+
+   has_pps_extension = profile_idc == 100 || pps->transform_8x8_mode_flag ||
+                       pps->second_chroma_qp_index_offset !=
+                          pps->chroma_qp_index_offset;
+   if (has_pps_extension) {
+      has_pps_matrices = pps_matrices_are_valid(pps);
+      rbsp_put_bit(&pps_writer, pps->transform_8x8_mode_flag);
+      rbsp_put_bit(&pps_writer, has_pps_matrices);
+      if (has_pps_matrices) {
+         for (unsigned i = 0; i < 6; i++) {
+            rbsp_put_bit(&pps_writer, 1);
+            rbsp_put_scaling_list(&pps_writer, pps->ScalingList4x4[i],
+                                  zigzag_4x4, 16);
+         }
+         if (pps->transform_8x8_mode_flag) {
+            for (unsigned i = 0; i < 2; i++) {
+               rbsp_put_bit(&pps_writer, 1);
+               rbsp_put_scaling_list(&pps_writer, pps->ScalingList8x8[i],
+                                     zigzag_8x8, 64);
+            }
+         }
+      }
+      rbsp_put_se(&pps_writer, pps->second_chroma_qp_index_offset);
+   }
+   rbsp_finish(&pps_writer);
+   return rbsp_to_nal(0x68, &pps_writer, sets->pps, &sets->pps_size);
+}
+
+static bool bit_reader_get_bit(struct bit_reader *reader, uint32_t *bit)
+{
+   if (reader->bit_offset >= reader->size * 8)
+      return false;
+   *bit = (reader->data[reader->bit_offset / 8] >>
+           (7 - reader->bit_offset % 8)) & 1U;
+   reader->bit_offset++;
+   return true;
+}
+
+static bool bit_reader_get_ue(struct bit_reader *reader, uint32_t *value)
+{
+   unsigned zeros = 0;
+   uint32_t bit = 0;
+   uint64_t suffix = 0;
+
+   while (bit_reader_get_bit(reader, &bit) && bit == 0) {
+      if (++zeros > 31)
+         return false;
+   }
+   if (bit == 0)
+      return false;
+   for (unsigned i = 0; i < zeros; i++) {
+      if (!bit_reader_get_bit(reader, &bit))
+         return false;
+      suffix = (suffix << 1) | bit;
+   }
+   suffix += ((uint64_t)1 << zeros) - 1;
+   if (suffix > UINT32_MAX)
+      return false;
+   *value = (uint32_t)suffix;
+   return true;
+}
+
+static bool h264_slice_pps_id(const uint8_t *nal,
+                              size_t nal_size,
+                              uint32_t *pps_id)
+{
+   uint8_t rbsp[128];
+   size_t rbsp_size = 0;
+   unsigned zero_count = 0;
+   struct bit_reader reader;
+   uint32_t ignored;
+
+   if (nal_size < 2 || ((nal[0] & 0x1f) != 1 && (nal[0] & 0x1f) != 5))
+      return false;
+
+   for (size_t i = 1; i < nal_size && rbsp_size < sizeof(rbsp); i++) {
+      if (zero_count >= 2 && nal[i] == 3) {
+         zero_count = 0;
+         continue;
+      }
+      rbsp[rbsp_size++] = nal[i];
+      zero_count = nal[i] == 0 ? zero_count + 1 : 0;
+   }
+   reader = (struct bit_reader){.data = rbsp, .size = rbsp_size};
+   return bit_reader_get_ue(&reader, &ignored) &&
+          bit_reader_get_ue(&reader, &ignored) &&
+          bit_reader_get_ue(&reader, pps_id);
+}
+
+static bool find_start_code(const uint8_t *data,
+                            size_t size,
+                            size_t from,
+                            size_t *offset,
+                            size_t *length)
+{
+   for (size_t i = from; i + 2 < size; i++) {
+      if (data[i] != 0 || data[i + 1] != 0)
+         continue;
+      if (data[i + 2] == 1) {
+         *offset = i;
+         *length = 3;
+         return true;
+      }
+      if (i + 3 < size && data[i + 2] == 0 && data[i + 3] == 1) {
+         *offset = i;
+         *length = 4;
+         return true;
+      }
+   }
+   return false;
+}
+
+static int append_avcc_nal(uint8_t *output,
+                           size_t capacity,
+                           size_t *output_size,
+                           const uint8_t *nal,
+                           size_t nal_size,
+                           uint32_t *pps_id,
+                           bool *found_slice)
+{
+   uint32_t length;
+   const uint8_t nal_type = nal_size ? nal[0] & 0x1f : 0;
+
+   if (!nal_size)
+      return 0;
+   if ((nal_type == 1 || nal_type == 5) && !*found_slice) {
+      if (!h264_slice_pps_id(nal, nal_size, pps_id))
+         return -1;
+      *found_slice = true;
+   }
+   if (nal_type == 7 || nal_type == 8)
+      return 0;
+   if (nal_size > UINT32_MAX || *output_size > capacity - 4 ||
+       nal_size > capacity - *output_size - 4)
+      return -1;
+
+   length = (uint32_t)nal_size;
+   output[(*output_size)++] = length >> 24;
+   output[(*output_size)++] = length >> 16;
+   output[(*output_size)++] = length >> 8;
+   output[(*output_size)++] = length;
+   memcpy(output + *output_size, nal, nal_size);
+   *output_size += nal_size;
+   return 0;
+}
+
+int vrend_video_h264_annexb_to_avcc(const uint8_t *annexb,
+                                    size_t annexb_size,
+                                    uint8_t **avcc,
+                                    size_t *avcc_size,
+                                    uint32_t *pps_id)
+{
+   uint8_t *output;
+   size_t capacity;
+   size_t output_size = 0;
+   size_t start;
+   size_t start_length;
+   bool found_slice = false;
+
+   if (!annexb || !annexb_size || !avcc || !avcc_size || !pps_id ||
+       annexb_size > (SIZE_MAX - 16) / 2)
+      return -1;
+
+   capacity = annexb_size * 2 + 16;
+   output = malloc(capacity);
+   if (!output)
+      return -1;
+
+   if (!find_start_code(annexb, annexb_size, 0, &start, &start_length)) {
+      if (append_avcc_nal(output, capacity, &output_size,
+                          annexb, annexb_size, pps_id, &found_slice) != 0)
+         goto fail;
+   } else {
+      while (true) {
+         const size_t nal_start = start + start_length;
+         size_t next;
+         size_t next_length;
+         size_t nal_end;
+
+         if (find_start_code(annexb, annexb_size, nal_start,
+                             &next, &next_length)) {
+            nal_end = next;
+         } else {
+            nal_end = annexb_size;
+         }
+         while (nal_end > nal_start && annexb[nal_end - 1] == 0)
+            nal_end--;
+         if (append_avcc_nal(output, capacity, &output_size,
+                             annexb + nal_start, nal_end - nal_start,
+                             pps_id, &found_slice) != 0)
+            goto fail;
+         if (nal_end == annexb_size)
+            break;
+         start = next;
+         start_length = next_length;
+      }
+   }
+
+   if (!found_slice || !output_size)
+      goto fail;
+   *avcc = output;
+   *avcc_size = output_size;
+   return 0;
+
+fail:
+   free(output);
+   return -1;
+}
