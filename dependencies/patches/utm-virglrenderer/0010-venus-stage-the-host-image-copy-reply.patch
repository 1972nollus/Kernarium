From e9789110401c406a6fdb46ea21d75ca664f86336 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 30 Aug 2026 08:00:36 +0900
Subject: [PATCH 10/27] venus: stage the host image copy reply

vkCopyImageToMemoryMESA points the driver straight at the reply blob so the
temporary allocation and copy are skipped.  That blob is guest-visible
shared memory whose length the guest chose, and Vulkan bounds the write by
the region's minimum footprint, so the fast path is only safe while the
driver honours that bound.  MoltenVK does not always: a copy whose own
layout is wider runs past the blob and corrupts whatever follows the reply
stream, which a guest must not be able to cause.

Stage the copy in renderer memory and publish exactly the bytes the guest
allocated.  A driver which wrote beyond them is reported with the request
that produced it, so the offending layout can be identified rather than
inferred from where the corruption happened to land.
---
 src/venus/vkr_host_copy.c | 77 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 76 insertions(+), 1 deletion(-)

diff --git a/src/venus/vkr_host_copy.c b/src/venus/vkr_host_copy.c
index cd5a317..44d84ab 100644
--- a/src/venus/vkr_host_copy.c
+++ b/src/venus/vkr_host_copy.c
@@ -5,6 +5,10 @@
 
 #include "vkr_host_copy.h"
 
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
 #include "venus-protocol/vn_protocol_renderer_host_copy.h"
 
 #include "vkr_context.h"
@@ -33,6 +37,28 @@ vkr_dispatch_vkTransitionImageLayout(UNUSED struct vn_dispatch_context *dispatch
       vk->TransitionImageLayout(args->device, args->transitionCount, args->pTransitions);
 }
 
+/* The reply blob is guest-visible shared memory whose length the guest chose.
+ * Vulkan bounds a host image copy by the region's minimum footprint, so the
+ * renderer normally lets the driver write that blob in place.  A driver whose
+ * own layout is wider writes past it and corrupts whatever follows the reply
+ * stream, which is not a failure the guest can be allowed to cause.  Stage the
+ * copy in renderer memory, publish exactly the bytes the guest allocated, and
+ * report a driver which wrote beyond them.
+ */
+#define VKR_HOST_COPY_STAGING_MARGIN (16u * 1024u * 1024u)
+#define VKR_HOST_COPY_POISON_BYTES (1u * 1024u * 1024u)
+#define VKR_HOST_COPY_POISON 0xa5
+
+static size_t
+vkr_host_copy_overrun(const uint8_t *margin)
+{
+   for (size_t index = VKR_HOST_COPY_POISON_BYTES; index > 0; index--) {
+      if (margin[index - 1] != VKR_HOST_COPY_POISON)
+         return index;
+   }
+   return 0;
+}
+
 static void
 vkr_dispatch_vkCopyImageToMemoryMESA(UNUSED struct vn_dispatch_context *dispatch,
                                      struct vn_command_vkCopyImageToMemoryMESA *args)
@@ -43,9 +69,21 @@ vkr_dispatch_vkCopyImageToMemoryMESA(UNUSED struct vn_dispatch_context *dispatch
    vn_replace_vkCopyImageToMemoryMESA_args_handle(args);
 
    const VkCopyImageToMemoryInfoMESA *info = args->pCopyImageToMemoryInfo;
+   void *staging = NULL;
+
+   if (args->pData && args->dataSize) {
+      staging = malloc(args->dataSize + VKR_HOST_COPY_STAGING_MARGIN);
+      if (!staging) {
+         args->ret = VK_ERROR_OUT_OF_HOST_MEMORY;
+         return;
+      }
+      memset((uint8_t *)staging + args->dataSize, VKR_HOST_COPY_POISON,
+             VKR_HOST_COPY_POISON_BYTES);
+   }
+
    const VkImageToMemoryCopy local_region = {
       .sType = VK_STRUCTURE_TYPE_IMAGE_TO_MEMORY_COPY,
-      .pHostPointer = args->pData,
+      .pHostPointer = staging ? staging : args->pData,
       .memoryRowLength = info->memoryRowLength,
       .memoryImageHeight = info->memoryImageHeight,
       .imageSubresource = info->imageSubresource,
@@ -61,6 +99,43 @@ vkr_dispatch_vkCopyImageToMemoryMESA(UNUSED struct vn_dispatch_context *dispatch
       .pRegions = &local_region,
    };
    args->ret = vk->CopyImageToMemory(args->device, &local_info);
+
+   if (staging) {
+      const size_t overrun =
+         vkr_host_copy_overrun((const uint8_t *)staging + args->dataSize);
+
+      if (overrun) {
+         static uint32_t reported;
+
+         if (reported < 16) {
+            const char *path = getenv("VKR_HOST_COPY_LOG");
+            FILE *sink = path ? fopen(path, "ae") : stderr;
+
+            reported++;
+            fprintf(sink ? sink : stderr,
+                    "host image copy wrote %zu bytes past the %zu the guest "
+                    "allocated: image %" PRIu64 " flags %#x layout %d "
+                    "rowLength %u imageHeight %u aspect %#x level %u "
+                    "layer %u+%u offset %d,%d,%d extent %ux%ux%u\n",
+                    overrun, args->dataSize,
+                    (uint64_t)(uintptr_t)info->srcImage, info->flags,
+                    (int)info->srcImageLayout, info->memoryRowLength,
+                    info->memoryImageHeight, info->imageSubresource.aspectMask,
+                    info->imageSubresource.mipLevel,
+                    info->imageSubresource.baseArrayLayer,
+                    info->imageSubresource.layerCount, info->imageOffset.x,
+                    info->imageOffset.y, info->imageOffset.z,
+                    info->imageExtent.width, info->imageExtent.height,
+                    info->imageExtent.depth);
+            if (sink && sink != stderr)
+               fclose(sink);
+            else
+               fflush(stderr);
+         }
+      }
+      memcpy(args->pData, staging, args->dataSize);
+      free(staging);
+   }
 }
 
 static void
