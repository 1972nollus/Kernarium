diff --git a/tests/test_vrend_video_h264.c b/tests/test_vrend_video_h264.c
new file mode 100644
index 0000000..2d2aec2
--- /dev/null
+++ b/tests/test_vrend_video_h264.c
@@ -0,0 +1,174 @@
+/**************************************************************************
+ *
+ * Copyright (C) 2026 Linux-UM Darwin contributors
+ *
