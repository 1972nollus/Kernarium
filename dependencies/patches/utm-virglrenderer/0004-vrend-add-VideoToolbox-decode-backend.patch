diff --git a/src/vrend/vrend_video_h264.c b/src/vrend/vrend_video_h264.c
new file mode 100644
index 0000000..5352a6e
--- /dev/null
+++ b/src/vrend/vrend_video_h264.c
@@ -0,0 +1,560 @@
+/**************************************************************************
