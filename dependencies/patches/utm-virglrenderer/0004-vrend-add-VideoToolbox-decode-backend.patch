+
+#include <CoreMedia/CoreMedia.h>
+
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <assert.h>
+#include <string.h>
+
+#include "pipe/p_video_enums.h"
+#include "vrend_video_h265.h"
+
+static void test_annexb_conversion(void)
+{
+   static const uint8_t annexb[] = {
+      0, 0, 0, 1, 0x40, 0x01, 0x0c,
+      0, 0, 1, 0x42, 0x01, 0x01,
+      0, 0, 1, 0x44, 0x01, 0xc0,
+      0, 0, 1, 0x26, 0x01, 0x88,
+   };
+   static const uint8_t expected[] = {
+      0, 0, 0, 3, 0x26, 0x01, 0x88,
+   };
+   uint8_t output[sizeof(expected)];
+   size_t output_size = 0;
+   uint32_t pps_id = 0;
+
+   assert(vrend_video_h265_annexb_to_hvcc_buffer(
+             annexb, sizeof(annexb), output, sizeof(output),
+             &output_size, &pps_id) == 0);
+   assert(pps_id == 3);
+   assert(output_size == sizeof(expected));
+   assert(memcmp(output, expected, sizeof(expected)) == 0);
+   assert(vrend_video_h265_annexb_to_hvcc_buffer(
+             annexb, sizeof(annexb), output, sizeof(output) - 1,
+             &output_size, &pps_id) == -1);
+}
+
+static void fill_descriptor(struct virgl_h265_picture_desc *desc,
+                            uint32_t profile,
+                            uint8_t bit_depth_minus8)
+{
+   desc->base.profile = profile;
+   desc->base.entry_point = PIPE_VIDEO_ENTRYPOINT_BITSTREAM;
+   desc->pps.sps.pic_width_in_luma_samples = 1920;
+   desc->pps.sps.pic_height_in_luma_samples = 1080;
+   desc->pps.sps.chroma_format_idc = 1;
+   desc->pps.sps.bit_depth_luma_minus8 = bit_depth_minus8;
+   desc->pps.sps.bit_depth_chroma_minus8 = bit_depth_minus8;
+   desc->pps.sps.log2_max_pic_order_cnt_lsb_minus4 = 4;
+   desc->pps.sps.sps_max_dec_pic_buffering_minus1 = 4;
+   desc->pps.sps.log2_min_luma_coding_block_size_minus3 = 0;
+   desc->pps.sps.log2_diff_max_min_luma_coding_block_size = 3;
+   desc->pps.sps.log2_min_transform_block_size_minus2 = 0;
+   desc->pps.sps.log2_diff_max_min_transform_block_size = 3;
+   desc->pps.sps.sample_adaptive_offset_enabled_flag = 1;
+   desc->pps.sps.sps_temporal_mvp_enabled_flag = 1;
+   desc->pps.sps.strong_intra_smoothing_enabled_flag = 1;
+   desc->pps.sign_data_hiding_enabled_flag = 1;
+   desc->pps.cu_qp_delta_enabled_flag = 1;
+   desc->pps.diff_cu_qp_delta_depth = 1;
+   desc->pps.weighted_pred_flag = 1;
+   desc->pps.entropy_coding_sync_enabled_flag = 1;
+   desc->pps.pps_loop_filter_across_slices_enabled_flag = 1;
+}
+
+static void validate_parameter_sets(uint32_t profile, uint8_t bit_depth)
+{
+   struct virgl_h265_picture_desc desc = {0};
+   struct vrend_h265_parameter_sets sets = {0};
+   const uint8_t *pointers[3];
+   size_t sizes[3];
+   CMVideoDimensions dimensions;
+   CMVideoFormatDescriptionRef format = NULL;
+
+   fill_descriptor(&desc, profile, bit_depth);
+   assert(vrend_video_h265_build_parameter_sets(
+             profile, 120, 1920, 1080, 3, &desc, &sets) == 0);
+   assert(sets.vps_size > 4 && ((sets.vps[0] >> 1) & 0x3f) == 32);
+   assert(sets.sps_size > 4 && ((sets.sps[0] >> 1) & 0x3f) == 33);
+   assert(sets.pps_size > 2 && ((sets.pps[0] >> 1) & 0x3f) == 34);
+   pointers[0] = sets.vps;
+   pointers[1] = sets.sps;
+   pointers[2] = sets.pps;
+   sizes[0] = sets.vps_size;
+   sizes[1] = sets.sps_size;
+   sizes[2] = sets.pps_size;
+   assert(CMVideoFormatDescriptionCreateFromHEVCParameterSets(
+             kCFAllocatorDefault, 3, pointers, sizes, 4, NULL,
+             &format) == noErr);
+   assert(format != NULL);
+   dimensions = CMVideoFormatDescriptionGetDimensions(format);
+   assert(dimensions.width == 1920);
+   assert(dimensions.height == 1080);
+   CFRelease(format);
+}
+
+int main(void)
+{
+   struct virgl_h265_picture_desc invalid = {0};
+   struct vrend_h265_parameter_sets sets = {0};
+
+   test_annexb_conversion();
+   validate_parameter_sets(PIPE_VIDEO_PROFILE_HEVC_MAIN, 0);
+   validate_parameter_sets(PIPE_VIDEO_PROFILE_HEVC_MAIN_10, 2);
+   fill_descriptor(&invalid, PIPE_VIDEO_PROFILE_HEVC_MAIN, 2);
+   assert(vrend_video_h265_build_parameter_sets(
+             invalid.base.profile, 120, 1920, 1080, 0,
+             &invalid, &sets) == -1);
+   return 0;
+}
