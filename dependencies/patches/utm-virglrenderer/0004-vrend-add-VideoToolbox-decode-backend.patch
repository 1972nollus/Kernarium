+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ *
+ **************************************************************************/
+
+#include "vrend_video_h265.h"
+
+#include <stdbool.h>
+#include <string.h>
+
+#include "pipe/p_video_enums.h"
+
+struct rbsp_writer {
+   uint8_t data[VREND_H265_PARAMETER_SET_MAX_SIZE];
+   size_t bit_count;
+   bool failed;
+};
+
+struct bit_reader {
+   const uint8_t *data;
+   size_t size;
+   size_t bit_offset;
+};
+
+static void rbsp_put_bit(struct rbsp_writer *writer, uint32_t bit)
+{
+   const size_t byte = writer->bit_count / 8;
+   const unsigned shift = 7 - (writer->bit_count % 8);
+
+   if (byte >= sizeof(writer->data)) {
+      writer->failed = true;
+      return;
+   }
+   if ((writer->bit_count % 8) == 0)
+      writer->data[byte] = 0;
+   writer->data[byte] |= (bit & 1U) << shift;
+   writer->bit_count++;
+}
+
+static void rbsp_put_bits(struct rbsp_writer *writer,
+                          uint64_t value,
+                          unsigned count)
+{
+   while (count > 0) {
+      count--;
+      rbsp_put_bit(writer, (uint32_t)(value >> count));
+   }
+}
+
+static void rbsp_put_ue(struct rbsp_writer *writer, uint32_t value)
+{
+   const uint64_t code = (uint64_t)value + 1;
+   uint64_t remaining = code;
+   unsigned bits = 0;
+
+   while (remaining) {
+      bits++;
+      remaining >>= 1;
+   }
+   for (unsigned i = 1; i < bits; i++)
+      rbsp_put_bit(writer, 0);
+   rbsp_put_bits(writer, code, bits);
+}
+
+static void rbsp_put_se(struct rbsp_writer *writer, int32_t value)
+{
+   const uint32_t code = value <= 0 ? (uint32_t)(-(int64_t)value * 2) :
+                                      (uint32_t)((int64_t)value * 2 - 1);
+   rbsp_put_ue(writer, code);
+}
+
+static void rbsp_finish(struct rbsp_writer *writer)
+{
+   rbsp_put_bit(writer, 1);
+   while (writer->bit_count % 8)
+      rbsp_put_bit(writer, 0);
+}
+
+static int rbsp_to_nal(uint8_t nal_type,
+                       const struct rbsp_writer *writer,
+                       uint8_t *nal,
+                       size_t *nal_size)
+{
+   size_t output = 0;
+   unsigned zero_count = 0;
+   const size_t rbsp_size = writer->bit_count / 8;
+
+   if (writer->failed || !nal || !nal_size)
+      return -1;
+   nal[output++] = nal_type << 1;
+   nal[output++] = 1;
+   for (size_t i = 0; i < rbsp_size; i++) {
+      const uint8_t byte = writer->data[i];
+
+      if (zero_count >= 2 && byte <= 3) {
+         if (output >= VREND_H265_PARAMETER_SET_MAX_SIZE)
+            return -1;
+         nal[output++] = 3;
+         zero_count = 0;
+      }
+      if (output >= VREND_H265_PARAMETER_SET_MAX_SIZE)
+         return -1;
+      nal[output++] = byte;
+      zero_count = byte == 0 ? zero_count + 1 : 0;
+   }
+   *nal_size = output;
+   return 0;
+}
+
+static bool h265_profile(uint32_t profile,
+                         uint8_t *profile_idc,
+                         uint8_t bit_depth_minus8)
+{
+   switch (profile) {
+   case PIPE_VIDEO_PROFILE_HEVC_MAIN:
+      if (bit_depth_minus8 != 0)
+         return false;
+      *profile_idc = 1;
+      return true;
+   case PIPE_VIDEO_PROFILE_HEVC_MAIN_10:
+      if (bit_depth_minus8 != 0 && bit_depth_minus8 != 2)
+         return false;
+      *profile_idc = 2;
+      return true;
+   default:
+      return false;
+   }
+}
+
+static uint8_t h265_level_idc(uint32_t level)
+{
+   if (!level)
+      return 153;
+   if (level < 90)
+      level *= 3;
+   return level <= UINT8_MAX ? (uint8_t)level : 153;
+}
+
+static void rbsp_put_profile_tier_level(struct rbsp_writer *writer,
+                                        uint8_t profile_idc,
+                                        uint8_t level_idc)
+{
+   uint32_t compatibility = 1U << (31 - profile_idc);
+
+   if (profile_idc == 1)
+      compatibility |= 1U << (31 - 2);
+   rbsp_put_bits(writer, 0, 2);
+   rbsp_put_bit(writer, 0);
+   rbsp_put_bits(writer, profile_idc, 5);
+   rbsp_put_bits(writer, compatibility, 32);
+   rbsp_put_bit(writer, 1);
+   rbsp_put_bit(writer, 0);
+   rbsp_put_bit(writer, 0);
+   rbsp_put_bit(writer, 1);
+   rbsp_put_bits(writer, 0, 44);
+   rbsp_put_bits(writer, level_idc, 8);
+}
+
+static bool matrix_is_valid(const uint8_t *matrix, size_t size)
+{
+   for (size_t i = 0; i < size; i++) {
+      if (!matrix[i])
+         return false;
+   }
+   return true;
+}
+
+static void rbsp_put_scaling_matrix(struct rbsp_writer *writer,
+                                    const uint8_t *matrix,
+                                    size_t size,
+                                    int dc)
+{
+   int next_coef = 8;
+
+   rbsp_put_bit(writer, 1);
+   if (dc >= 0) {
+      rbsp_put_se(writer, dc - 8);
+      next_coef = dc;
+   }
+   for (size_t i = 0; i < size; i++) {
+      int delta = (int)matrix[i] - next_coef;
+
+      if (delta > 127)
+         delta -= 256;
+      else if (delta < -128)
+         delta += 256;
+      rbsp_put_se(writer, delta);
+      next_coef = matrix[i];
+   }
+}
+
+static void rbsp_put_scaling_lists(struct rbsp_writer *writer,
+                                   const struct virgl_h265_sps *sps)
+{
+   for (unsigned size_id = 0; size_id < 4; size_id++) {
+      const unsigned step = size_id == 3 ? 3 : 1;
+
+      for (unsigned matrix_id = 0; matrix_id < 6; matrix_id += step) {
+         const uint8_t *matrix;
+         size_t count;
+         int dc = -1;
+
+         if (size_id == 0) {
+            matrix = sps->ScalingList4x4[matrix_id];
+            count = 16;
+         } else if (size_id == 1) {
+            matrix = sps->ScalingList8x8[matrix_id];
+            count = 64;
+         } else if (size_id == 2) {
+            matrix = sps->ScalingList16x16[matrix_id];
+            count = 64;
+            dc = sps->ScalingListDCCoeff16x16[matrix_id];
+         } else {
+            const unsigned index = matrix_id / 3;
+            matrix = sps->ScalingList32x32[index];
+            count = 64;
+            dc = sps->ScalingListDCCoeff32x32[index];
+         }
+         if (!matrix_is_valid(matrix, count) || (dc == 0 && size_id > 1)) {
+            rbsp_put_bit(writer, 0);
+            rbsp_put_ue(writer, 0);
+         } else {
+            rbsp_put_scaling_matrix(writer, matrix, count, dc);
+         }
+      }
+   }
+}
+
+static bool long_term_is_current(const struct virgl_h265_picture_desc *desc,
+                                 unsigned reference)
+{
+   for (unsigned i = 0; i < desc->NumPocLtCurr && i < 8; i++) {
+      if (desc->RefPicSetLtCurr[i] == reference)
+         return true;
+   }
+   return false;
+}
+
+static void rbsp_put_short_term_sets(struct rbsp_writer *writer,
+                                     unsigned count)
+{
+   for (unsigned i = 0; i < count; i++) {
+      if (i != 0)
+         rbsp_put_bit(writer, 0);
+      rbsp_put_ue(writer, 0);
+      rbsp_put_ue(writer, 0);
+   }
+}
+
+int vrend_video_h265_build_parameter_sets(
+   uint32_t profile,
+   uint32_t level,
+   uint32_t width,
+   uint32_t height,
+   uint32_t pps_id,
+   const struct virgl_h265_picture_desc *desc,
+   struct vrend_h265_parameter_sets *sets)
+{
+   struct rbsp_writer vps = {0};
+   struct rbsp_writer sps_writer = {0};
+   struct rbsp_writer pps_writer = {0};
+   const struct virgl_h265_sps *sps;
+   const struct virgl_h265_pps *pps;
+   uint8_t profile_idc;
+   uint8_t level_idc;
+   unsigned poc_bits;
+
+   if (!desc || !sets || !width || !height || pps_id > 63)
+      return -1;
+   sps = &desc->pps.sps;
+   pps = &desc->pps;
+   if (!h265_profile(profile, &profile_idc, sps->bit_depth_luma_minus8) ||
+       sps->chroma_format_idc != 1 || sps->separate_colour_plane_flag ||
+       sps->bit_depth_chroma_minus8 != sps->bit_depth_luma_minus8 ||
+       sps->pic_width_in_luma_samples != width ||
+       sps->pic_height_in_luma_samples != height ||
+       sps->log2_max_pic_order_cnt_lsb_minus4 > 12 ||
+       sps->num_short_term_ref_pic_sets > 64 ||
+       sps->num_long_term_ref_pics_sps > 16 ||
+       pps->num_tile_columns_minus1 >= 20 ||
+       pps->num_tile_rows_minus1 >= 22)
+      return -1;
+   level_idc = h265_level_idc(level);
+   poc_bits = sps->log2_max_pic_order_cnt_lsb_minus4 + 4;
+
+   rbsp_put_bits(&vps, 0, 4);
+   rbsp_put_bit(&vps, 1);
+   rbsp_put_bit(&vps, 1);
+   rbsp_put_bits(&vps, 0, 6);
+   rbsp_put_bits(&vps, 0, 3);
+   rbsp_put_bit(&vps, 1);
+   rbsp_put_bits(&vps, 0xffff, 16);
+   rbsp_put_profile_tier_level(&vps, profile_idc, level_idc);
+   rbsp_put_bit(&vps, 1);
+   rbsp_put_ue(&vps, sps->sps_max_dec_pic_buffering_minus1);
+   rbsp_put_ue(&vps, sps->sps_max_dec_pic_buffering_minus1);
+   rbsp_put_ue(&vps, 0);
+   rbsp_put_bits(&vps, 0, 6);
+   rbsp_put_ue(&vps, 0);
+   rbsp_put_bit(&vps, 0);
+   rbsp_put_bit(&vps, 0);
+   rbsp_finish(&vps);
+   if (rbsp_to_nal(32, &vps, sets->vps, &sets->vps_size) != 0)
+      return -1;
+
+   rbsp_put_bits(&sps_writer, 0, 4);
+   rbsp_put_bits(&sps_writer, 0, 3);
+   rbsp_put_bit(&sps_writer, 1);
+   rbsp_put_profile_tier_level(&sps_writer, profile_idc, level_idc);
+   rbsp_put_ue(&sps_writer, 0);
+   rbsp_put_ue(&sps_writer, sps->chroma_format_idc);
+   rbsp_put_ue(&sps_writer, width);
+   rbsp_put_ue(&sps_writer, height);
+   rbsp_put_bit(&sps_writer, 0);
+   rbsp_put_ue(&sps_writer, sps->bit_depth_luma_minus8);
+   rbsp_put_ue(&sps_writer, sps->bit_depth_chroma_minus8);
+   rbsp_put_ue(&sps_writer, sps->log2_max_pic_order_cnt_lsb_minus4);
+   rbsp_put_bit(&sps_writer, 1);
+   rbsp_put_ue(&sps_writer, sps->sps_max_dec_pic_buffering_minus1);
+   rbsp_put_ue(&sps_writer, sps->sps_max_dec_pic_buffering_minus1);
+   rbsp_put_ue(&sps_writer, 0);
+   rbsp_put_ue(&sps_writer, sps->log2_min_luma_coding_block_size_minus3);
+   rbsp_put_ue(&sps_writer,
+               sps->log2_diff_max_min_luma_coding_block_size);
+   rbsp_put_ue(&sps_writer, sps->log2_min_transform_block_size_minus2);
+   rbsp_put_ue(&sps_writer,
+               sps->log2_diff_max_min_transform_block_size);
+   rbsp_put_ue(&sps_writer, sps->max_transform_hierarchy_depth_inter);
+   rbsp_put_ue(&sps_writer, sps->max_transform_hierarchy_depth_intra);
+   rbsp_put_bit(&sps_writer, sps->scaling_list_enabled_flag);
+   if (sps->scaling_list_enabled_flag) {
+      rbsp_put_bit(&sps_writer, 1);
+      rbsp_put_scaling_lists(&sps_writer, sps);
+   }
+   rbsp_put_bit(&sps_writer, sps->amp_enabled_flag);
+   rbsp_put_bit(&sps_writer, sps->sample_adaptive_offset_enabled_flag);
+   rbsp_put_bit(&sps_writer, sps->pcm_enabled_flag);
+   if (sps->pcm_enabled_flag) {
+      rbsp_put_bits(&sps_writer, sps->pcm_sample_bit_depth_luma_minus1, 4);
+      rbsp_put_bits(&sps_writer, sps->pcm_sample_bit_depth_chroma_minus1, 4);
+      rbsp_put_ue(&sps_writer,
+                  sps->log2_min_pcm_luma_coding_block_size_minus3);
+      rbsp_put_ue(&sps_writer,
+                  sps->log2_diff_max_min_pcm_luma_coding_block_size);
+      rbsp_put_bit(&sps_writer, sps->pcm_loop_filter_disabled_flag);
+   }
+   rbsp_put_ue(&sps_writer, sps->num_short_term_ref_pic_sets);
+   rbsp_put_short_term_sets(&sps_writer, sps->num_short_term_ref_pic_sets);
+   rbsp_put_bit(&sps_writer, sps->long_term_ref_pics_present_flag);
+   if (sps->long_term_ref_pics_present_flag) {
+      unsigned emitted = 0;
+
+      rbsp_put_ue(&sps_writer, sps->num_long_term_ref_pics_sps);
+      for (unsigned i = 0; i < 16 &&
+                           emitted < sps->num_long_term_ref_pics_sps; i++) {
+         if (!desc->IsLongTerm[i])
+            continue;
+         rbsp_put_bits(&sps_writer, (uint32_t)desc->PicOrderCntVal[i],
+                       poc_bits);
+         rbsp_put_bit(&sps_writer, long_term_is_current(desc, i));
+         emitted++;
+      }
+      while (emitted++ < sps->num_long_term_ref_pics_sps) {
+         rbsp_put_bits(&sps_writer, 0, poc_bits);
+         rbsp_put_bit(&sps_writer, 0);
+      }
+   }
+   rbsp_put_bit(&sps_writer, sps->sps_temporal_mvp_enabled_flag);
+   rbsp_put_bit(&sps_writer, sps->strong_intra_smoothing_enabled_flag);
+   rbsp_put_bit(&sps_writer, 0);
+   rbsp_put_bit(&sps_writer, 0);
+   rbsp_finish(&sps_writer);
+   if (rbsp_to_nal(33, &sps_writer, sets->sps, &sets->sps_size) != 0)
+      return -1;
+
+   rbsp_put_ue(&pps_writer, pps_id);
+   rbsp_put_ue(&pps_writer, 0);
+   rbsp_put_bit(&pps_writer, pps->dependent_slice_segments_enabled_flag);
+   rbsp_put_bit(&pps_writer, pps->output_flag_present_flag);
+   rbsp_put_bits(&pps_writer, pps->num_extra_slice_header_bits, 3);
+   rbsp_put_bit(&pps_writer, pps->sign_data_hiding_enabled_flag);
+   rbsp_put_bit(&pps_writer, pps->cabac_init_present_flag);
+   rbsp_put_ue(&pps_writer, pps->num_ref_idx_l0_default_active_minus1);
+   rbsp_put_ue(&pps_writer, pps->num_ref_idx_l1_default_active_minus1);
+   rbsp_put_se(&pps_writer, pps->init_qp_minus26);
+   rbsp_put_bit(&pps_writer, pps->constrained_intra_pred_flag);
+   rbsp_put_bit(&pps_writer, pps->transform_skip_enabled_flag);
+   rbsp_put_bit(&pps_writer, pps->cu_qp_delta_enabled_flag);
+   if (pps->cu_qp_delta_enabled_flag)
+      rbsp_put_ue(&pps_writer, pps->diff_cu_qp_delta_depth);
+   rbsp_put_se(&pps_writer, pps->pps_cb_qp_offset);
+   rbsp_put_se(&pps_writer, pps->pps_cr_qp_offset);
+   rbsp_put_bit(&pps_writer,
+                pps->pps_slice_chroma_qp_offsets_present_flag);
+   rbsp_put_bit(&pps_writer, pps->weighted_pred_flag);
+   rbsp_put_bit(&pps_writer, pps->weighted_bipred_flag);
+   rbsp_put_bit(&pps_writer, pps->transquant_bypass_enabled_flag);
+   rbsp_put_bit(&pps_writer, pps->tiles_enabled_flag);
+   rbsp_put_bit(&pps_writer, pps->entropy_coding_sync_enabled_flag);
+   if (pps->tiles_enabled_flag) {
+      rbsp_put_ue(&pps_writer, pps->num_tile_columns_minus1);
+      rbsp_put_ue(&pps_writer, pps->num_tile_rows_minus1);
+      rbsp_put_bit(&pps_writer, pps->uniform_spacing_flag);
+      if (!pps->uniform_spacing_flag) {
+         for (unsigned i = 0; i < pps->num_tile_columns_minus1; i++)
+            rbsp_put_ue(&pps_writer, pps->column_width_minus1[i]);
+         for (unsigned i = 0; i < pps->num_tile_rows_minus1; i++)
+            rbsp_put_ue(&pps_writer, pps->row_height_minus1[i]);
+      }
+      rbsp_put_bit(&pps_writer,
+                   pps->loop_filter_across_tiles_enabled_flag);
+   }
+   rbsp_put_bit(&pps_writer,
+                pps->pps_loop_filter_across_slices_enabled_flag);
+   rbsp_put_bit(&pps_writer, pps->deblocking_filter_control_present_flag);
+   if (pps->deblocking_filter_control_present_flag) {
+      rbsp_put_bit(&pps_writer,
+                   pps->deblocking_filter_override_enabled_flag);
+      rbsp_put_bit(&pps_writer, pps->pps_deblocking_filter_disabled_flag);
+      if (!pps->pps_deblocking_filter_disabled_flag) {
+         rbsp_put_se(&pps_writer, pps->pps_beta_offset_div2);
+         rbsp_put_se(&pps_writer, pps->pps_tc_offset_div2);
+      }
+   }
+   rbsp_put_bit(&pps_writer, 0);
+   rbsp_put_bit(&pps_writer, pps->lists_modification_present_flag);
+   rbsp_put_ue(&pps_writer, pps->log2_parallel_merge_level_minus2);
+   rbsp_put_bit(&pps_writer,
+                pps->slice_segment_header_extension_present_flag);
+   rbsp_put_bit(&pps_writer, 0);
+   rbsp_finish(&pps_writer);
+   return rbsp_to_nal(34, &pps_writer, sets->pps, &sets->pps_size);
+}
+
+static bool bit_reader_get_bit(struct bit_reader *reader, uint32_t *bit)
+{
+   if (reader->bit_offset >= reader->size * 8)
+      return false;
+   *bit = (reader->data[reader->bit_offset / 8] >>
+           (7 - reader->bit_offset % 8)) & 1U;
+   reader->bit_offset++;
+   return true;
+}
+
+static bool bit_reader_get_ue(struct bit_reader *reader, uint32_t *value)
+{
+   unsigned zeros = 0;
+   uint32_t bit = 0;
+   uint64_t suffix = 0;
+
+   while (bit_reader_get_bit(reader, &bit) && bit == 0) {
+      if (++zeros > 31)
+         return false;
+   }
+   if (bit == 0)
+      return false;
+   for (unsigned i = 0; i < zeros; i++) {
+      if (!bit_reader_get_bit(reader, &bit))
+         return false;
+      suffix = (suffix << 1) | bit;
+   }
+   suffix += ((uint64_t)1 << zeros) - 1;
+   if (suffix > UINT32_MAX)
+      return false;
+   *value = (uint32_t)suffix;
+   return true;
+}
+
+static bool h265_slice_pps_id(const uint8_t *nal,
+                              size_t nal_size,
+                              uint32_t *pps_id)
+{
+   uint8_t rbsp[128];
+   size_t rbsp_size = 0;
+   unsigned zero_count = 0;
+   struct bit_reader reader;
+   uint32_t bit;
+   const unsigned nal_type = nal_size >= 2 ? (nal[0] >> 1) & 0x3f : 64;
+
+   if (nal_type > 31)
+      return false;
+   for (size_t i = 2; i < nal_size && rbsp_size < sizeof(rbsp); i++) {
+      if (zero_count >= 2 && nal[i] == 3) {
+         zero_count = 0;
+         continue;
+      }
+      rbsp[rbsp_size++] = nal[i];
+      zero_count = nal[i] == 0 ? zero_count + 1 : 0;
+   }
+   reader = (struct bit_reader){.data = rbsp, .size = rbsp_size};
+   if (!bit_reader_get_bit(&reader, &bit))
+      return false;
+   if (nal_type >= 16 && nal_type <= 23 &&
+       !bit_reader_get_bit(&reader, &bit))
+      return false;
+   return bit_reader_get_ue(&reader, pps_id);
+}
+
+static bool find_start_code(const uint8_t *data,
+                            size_t size,
+                            size_t from,
+                            size_t *offset,
+                            size_t *length)
+{
+   for (size_t i = from; i + 2 < size; i++) {
+      if (data[i] != 0 || data[i + 1] != 0)
+         continue;
+      if (data[i + 2] == 1) {
+         *offset = i;
+         *length = 3;
+         return true;
+      }
+      if (i + 3 < size && data[i + 2] == 0 && data[i + 3] == 1) {
+         *offset = i;
+         *length = 4;
+         return true;
+      }
+   }
+   return false;
+}
+
+static int append_hvcc_nal(uint8_t *output,
+                           size_t capacity,
+                           size_t *output_size,
+                           const uint8_t *nal,
+                           size_t nal_size,
+                           uint32_t *pps_id,
+                           bool *found_slice)
+{
+   uint32_t length;
+   const unsigned nal_type = nal_size >= 2 ? (nal[0] >> 1) & 0x3f : 64;
+
+   if (!nal_size)
+      return 0;
+   if (nal_type <= 31 && !*found_slice) {
+      if (!h265_slice_pps_id(nal, nal_size, pps_id))
+         return -1;
+      *found_slice = true;
+   }
+   if (nal_type >= 32 && nal_type <= 37)
+      return 0;
+   if (nal_size > UINT32_MAX || capacity < 4 ||
+       *output_size > capacity - 4 ||
+       nal_size > capacity - *output_size - 4)
+      return -1;
+   length = (uint32_t)nal_size;
+   output[(*output_size)++] = length >> 24;
+   output[(*output_size)++] = length >> 16;
+   output[(*output_size)++] = length >> 8;
+   output[(*output_size)++] = length;
+   memcpy(output + *output_size, nal, nal_size);
+   *output_size += nal_size;
+   return 0;
+}
+
+int vrend_video_h265_annexb_to_hvcc_buffer(
+   const uint8_t *annexb,
+   size_t annexb_size,
+   uint8_t *hvcc,
+   size_t hvcc_capacity,
+   size_t *hvcc_size,
+   uint32_t *pps_id)
+{
+   size_t output_size = 0;
+   size_t start;
+   size_t start_length;
+   bool found_slice = false;
+
+   if (!annexb || !annexb_size || !hvcc || !hvcc_capacity || !hvcc_size ||
+       !pps_id)
+      return -1;
+   if (!find_start_code(annexb, annexb_size, 0, &start, &start_length)) {
+      if (append_hvcc_nal(hvcc, hvcc_capacity, &output_size,
+                          annexb, annexb_size, pps_id, &found_slice) != 0)
+         return -1;
+   } else {
+      while (true) {
+         const size_t nal_start = start + start_length;
+         size_t next;
+         size_t next_length;
+         size_t nal_end;
+
+         if (find_start_code(annexb, annexb_size, nal_start,
+                             &next, &next_length))
+            nal_end = next;
+         else
+            nal_end = annexb_size;
+         while (nal_end > nal_start && annexb[nal_end - 1] == 0)
+            nal_end--;
+         if (append_hvcc_nal(hvcc, hvcc_capacity, &output_size,
+                             annexb + nal_start, nal_end - nal_start,
+                             pps_id, &found_slice) != 0)
+            return -1;
+         if (nal_end == annexb_size)
+            break;
+         start = next;
+         start_length = next_length;
+      }
+   }
+   if (!found_slice || !output_size)
+      return -1;
+   *hvcc_size = output_size;
+   return 0;
+}
