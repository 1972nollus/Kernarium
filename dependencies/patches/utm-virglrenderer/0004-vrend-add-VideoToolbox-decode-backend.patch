+   (void)source_frame_refcon;
+   (void)status;
+   (void)info_flags;
+   (void)image;
+   (void)presentation_time_stamp;
+   (void)presentation_duration;
+}
+
+static bool probe_h264_high10_hardware(void)
+{
+#if !TARGET_OS_OSX
+   if (@available(iOS 17.0, tvOS 17.0, *)) {
+#endif
+   /* A representative 64x64 x264 High10 sequence header.  In particular,
+    * this covers CABAC and 8x8 transforms that a family-level H.264 probe
+    * can accept even when the hardware does not implement High10. */
+   static const uint8_t sps[] = {
+      0x67, 0x6e, 0x00, 0x0a, 0xa6, 0xcd, 0x94, 0x42,
+      0x6c, 0x04, 0x40, 0x00, 0x00, 0x03, 0x00, 0x40,
+      0x00, 0x00, 0x1e, 0x03, 0xc4, 0x89, 0x65, 0x80,
+   };
+   static const uint8_t pps[] = {
+      0x68, 0xeb, 0xe3, 0xcb, 0x22, 0xc0,
+   };
+   const uint8_t *parameter_sets[] = {sps, pps};
+   const size_t parameter_set_sizes[] = {sizeof(sps), sizeof(pps)};
+   const void *decoder_keys[] = {
+      kVTVideoDecoderSpecification_RequireHardwareAcceleratedVideoDecoder,
+   };
+   const void *decoder_values[] = {kCFBooleanTrue};
+   int32_t pixel_format =
+      kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange;
+   VTDecompressionOutputCallbackRecord callback = {
+      .decompressionOutputCallback = h264_high10_probe_output,
+      .decompressionOutputRefCon = NULL,
+   };
+   CMVideoFormatDescriptionRef format = NULL;
+   CFDictionaryRef decoder_specification = NULL;
+   CFNumberRef pixel_format_number = NULL;
+   CFDictionaryRef image_attributes = NULL;
+   VTDecompressionSessionRef session = NULL;
+   CFTypeRef using_hardware = NULL;
+   OSStatus status;
+   bool supported = false;
+
+   status = CMVideoFormatDescriptionCreateFromH264ParameterSets(
+      kCFAllocatorDefault, ARRAY_SIZE(parameter_sets), parameter_sets,
+      parameter_set_sizes, 4, &format);
+   if (status != noErr)
+      goto out;
+   decoder_specification = CFDictionaryCreate(
+      kCFAllocatorDefault, decoder_keys, decoder_values,
+      ARRAY_SIZE(decoder_keys), &kCFTypeDictionaryKeyCallBacks,
+      &kCFTypeDictionaryValueCallBacks);
+   pixel_format_number = CFNumberCreate(kCFAllocatorDefault,
+                                        kCFNumberSInt32Type,
+                                        &pixel_format);
+   if (pixel_format_number) {
+      const void *image_keys[] = {kCVPixelBufferPixelFormatTypeKey};
+      const void *image_values[] = {pixel_format_number};
+
+      image_attributes = CFDictionaryCreate(
+         kCFAllocatorDefault, image_keys, image_values,
+         ARRAY_SIZE(image_keys), &kCFTypeDictionaryKeyCallBacks,
+         &kCFTypeDictionaryValueCallBacks);
+   }
+   if (!decoder_specification || !image_attributes)
+      goto out;
+   status = VTDecompressionSessionCreate(
+      kCFAllocatorDefault, format, decoder_specification, image_attributes,
+      &callback, &session);
+   if (status != noErr)
+      goto out;
+   status = VTSessionCopyProperty(
+      session,
+      kVTDecompressionPropertyKey_UsingHardwareAcceleratedVideoDecoder,
+      kCFAllocatorDefault, &using_hardware);
+   if (status != noErr || using_hardware != kCFBooleanTrue)
+      goto out;
+   supported = true;
+
+out:
+   if (using_hardware)
+      CFRelease(using_hardware);
+   if (session) {
+      VTDecompressionSessionInvalidate(session);
+      CFRelease(session);
+   }
+   if (image_attributes)
+      CFRelease(image_attributes);
+   if (pixel_format_number)
+      CFRelease(pixel_format_number);
+   if (decoder_specification)
+      CFRelease(decoder_specification);
+   if (format)
+      CFRelease(format);
+   return supported;
+#if !TARGET_OS_OSX
+   }
+   return false;
+#endif
+}
+
+static bool reserve_buffer(uint8_t **buffer,
+                           size_t *capacity,
+                           size_t required)
+{
+   uint8_t *grown;
+   size_t new_capacity;
+
+   if (required <= *capacity)
+      return true;
+   new_capacity = *capacity ? *capacity : 4096;
+   while (new_capacity < required) {
+      if (new_capacity > SIZE_MAX / 2) {
+         new_capacity = required;
+         break;
+      }
+      new_capacity *= 2;
+   }
+   grown = realloc(*buffer, new_capacity);
+   if (!grown)
+      return false;
+   *buffer = grown;
+   *capacity = new_capacity;
+   return true;
+}
+
+static int report_decode_failure(struct vrend_video_codec *codec,
+                                 const char *stage)
+{
+   if (codec && !codec->reported_decode_failure) {
+      codec->reported_decode_failure = true;
+      virgl_warn("VideoToolbox decode failed: profile=%u stage=%s\n",
+                 (unsigned)codec->profile, stage);
+   }
+   return -1;
+}
