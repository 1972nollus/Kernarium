+static struct vrend_video_codec *get_video_codec(
+   struct vrend_video_context *ctx, uint32_t handle)
+{
+   list_for_each_entry(struct vrend_video_codec, codec, &ctx->codecs, head) {
+      if (codec->handle == handle)
+         return codec;
+   }
+   return NULL;
+}
+
+static struct vrend_video_buffer *get_video_buffer(
+   struct vrend_video_context *ctx, uint32_t handle)
+{
+   list_for_each_entry(struct vrend_video_buffer, buffer, &ctx->buffers, head) {
+      if (buffer->handle == handle)
+         return buffer;
+   }
+   return NULL;
+}
+
+static bool is_h264_profile(uint32_t profile)
+{
+   switch (profile) {
+   case PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE:
+   case PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE:
+   case PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN:
+   case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH:
+   case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH10:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static bool is_hevc_profile(uint32_t profile)
+{
+   return profile == PIPE_VIDEO_PROFILE_HEVC_MAIN ||
+          profile == PIPE_VIDEO_PROFILE_HEVC_MAIN_10;
+}
+
+static bool is_jpeg_profile(uint32_t profile)
+{
+   return profile == PIPE_VIDEO_PROFILE_JPEG_BASELINE;
+}
+
+static bool is_10_bit_profile(uint32_t profile)
+{
+   return profile == PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH10 ||
+          profile == PIPE_VIDEO_PROFILE_HEVC_MAIN_10;
+}
+
+static bool is_supported_profile(uint32_t profile)
+{
+   if (profile == PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH10)
+      return h264_high10_initialized;
+   return (h264_initialized && is_h264_profile(profile)) ||
+          (hevc_initialized && is_hevc_profile(profile)) ||
+          (jpeg_initialized && is_jpeg_profile(profile));
+}
+
+static const char *codec_family_name(uint32_t profile)
+{
+   if (is_hevc_profile(profile))
+      return "HEVC";
+   if (is_jpeg_profile(profile))
+      return "JPEG";
+   return "H.264";
+}
+
+static uint32_t max_width_for_profile(uint32_t profile)
+{
+   if (is_hevc_profile(profile))
+      return VREND_VT_HEVC_MAX_WIDTH;
+   if (is_jpeg_profile(profile))
+      return VREND_VT_JPEG_MAX_WIDTH;
+   return VREND_VT_H264_MAX_WIDTH;
+}
+
+static uint32_t max_height_for_profile(uint32_t profile)
+{
+   if (is_hevc_profile(profile))
+      return VREND_VT_HEVC_MAX_HEIGHT;
+   if (is_jpeg_profile(profile))
+      return VREND_VT_JPEG_MAX_HEIGHT;
+   return VREND_VT_H264_MAX_HEIGHT;
+}
+
+static void destroy_session(struct vrend_video_codec *codec)
+{
+   if (codec->session) {
+      VTDecompressionSessionInvalidate(codec->session);
+      CFRelease(codec->session);
+      codec->session = NULL;
+   }
+   if (codec->format) {
+      CFRelease(codec->format);
+      codec->format = NULL;
+   }
+   memset(&codec->parameter_sets, 0, sizeof(codec->parameter_sets));
+}
+
+static bool hardware_requirement_is_available(void)
+{
+#if TARGET_OS_OSX
+   return true;
+#else
+   if (@available(iOS 17.0, tvOS 17.0, *))
+      return true;
+   return false;
+#endif
+}
+
+int vrend_video_init(int drm_fd)
+{
+   (void)drm_fd;
+   if (!hardware_requirement_is_available())
+      return -1;
+   h264_initialized = VTIsHardwareDecodeSupported(kCMVideoCodecType_H264);
+   h264_high10_initialized = h264_initialized && !TARGET_OS_OSX &&
+                              probe_h264_high10_hardware();
+   hevc_initialized = VTIsHardwareDecodeSupported(kCMVideoCodecType_HEVC);
+   jpeg_initialized = VTIsHardwareDecodeSupported(kCMVideoCodecType_JPEG);
+   video_initialized = h264_initialized || hevc_initialized ||
+                       jpeg_initialized;
+   return video_initialized ? 0 : -1;
+}
+
+void vrend_video_fini(void)
+{
+   video_initialized = false;
+   h264_initialized = false;
+   h264_high10_initialized = false;
+   hevc_initialized = false;
+   jpeg_initialized = false;
+}
+
+static void fill_video_cap(struct virgl_video_caps *cap, uint32_t profile)
+{
+   memset(cap, 0, sizeof(*cap));
+   cap->profile = profile;
+   cap->entrypoint = PIPE_VIDEO_ENTRYPOINT_BITSTREAM;
+   cap->max_level = is_hevc_profile(profile) ? 186 :
+                    is_jpeg_profile(profile) ? 0 : 51;
+   cap->max_width = max_width_for_profile(profile);
+   cap->max_height = max_height_for_profile(profile);
+   cap->prefered_format = is_10_bit_profile(profile) ? VIRGL_FORMAT_P010 :
+                                                       VIRGL_FORMAT_NV12;
+   cap->max_macroblocks =
+      cap->max_width * cap->max_height / (16 * 16);
+   cap->npot_texture = 1;
+   cap->supports_progressive = 1;
+}
+
+int vrend_video_fill_caps(union virgl_caps *caps)
+{
+   static const uint32_t profiles[] = {
+      PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE,
+      PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE,
+      PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN,
+      PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH,
+      PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH10,
+      PIPE_VIDEO_PROFILE_HEVC_MAIN,
+      PIPE_VIDEO_PROFILE_HEVC_MAIN_10,
+      PIPE_VIDEO_PROFILE_JPEG_BASELINE,
+   };
+
+   if (!caps)
+      return -1;
+   caps->v2.num_video_caps = 0;
+   if (!video_initialized)
+      return -1;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(profiles); i++) {
+      if (!is_supported_profile(profiles[i]))
+         continue;
+      fill_video_cap(&caps->v2.video_caps[caps->v2.num_video_caps],
+                     profiles[i]);
+      caps->v2.num_video_caps++;
+   }
+   return 0;
+}
+
+struct vrend_video_context *vrend_video_create_context(struct vrend_context *ctx)
+{
+   struct vrend_video_context *video_ctx = calloc(1, sizeof(*video_ctx));
+
+   if (!video_ctx)
+      return NULL;
+   video_ctx->ctx = ctx;
+   list_inithead(&video_ctx->codecs);
+   list_inithead(&video_ctx->buffers);
+   return video_ctx;
+}
+
+static void destroy_video_codec(struct vrend_video_codec *codec)
+{
+   if (!codec)
+      return;
+   list_del(&codec->head);
+   destroy_session(codec);
+   free(codec->sample_data);
+   free(codec->annexb);
+   free(codec);
+}
+
+static void release_metal_sources(struct vrend_video_buffer *buffer)
+{
+   for (unsigned i = 0; i < VREND_VT_METAL_PLANE_COUNT; i++) {
+      if (buffer->metal_planes[i].source) {
+         CFRelease(buffer->metal_planes[i].source);
+         buffer->metal_planes[i].source = NULL;
+      }
+   }
+}
+
+static bool retire_metal_copy(struct vrend_video_buffer *buffer)
+{
+   GLenum wait_result = GL_ALREADY_SIGNALED;
+
+   if (buffer->metal_fence) {
+      do {
+         wait_result = glClientWaitSync(buffer->metal_fence, 0,
+                                        1000000000ULL);
+      } while (wait_result == GL_TIMEOUT_EXPIRED);
+      glDeleteSync(buffer->metal_fence);
+      buffer->metal_fence = NULL;
+      if (wait_result == GL_WAIT_FAILED)
+         glFinish();
+   }
+   release_metal_sources(buffer);
+   return wait_result != GL_WAIT_FAILED;
+}
+
+static void destroy_video_buffer(struct vrend_video_buffer *buffer)
+{
+   if (!buffer)
+      return;
+   retire_metal_copy(buffer);
+   for (unsigned i = 0; i < VREND_VT_METAL_PLANE_COUNT; i++) {
+      if (buffer->metal_planes[i].texture)
+         glDeleteTextures(1, &buffer->metal_planes[i].texture);
+   }
+   free(buffer->chroma_scratch);
+   list_del(&buffer->head);
+   free(buffer);
+}
+
+void vrend_video_destroy_context(struct vrend_video_context *ctx)
+{
+   if (!ctx)
+      return;
+   list_for_each_entry_safe(struct vrend_video_codec, codec,
+                            &ctx->codecs, head)
+      destroy_video_codec(codec);
+   list_for_each_entry_safe(struct vrend_video_buffer, buffer,
+                            &ctx->buffers, head)
+      destroy_video_buffer(buffer);
+   if (ctx->metal_cache) {
+      CVMetalTextureCacheFlush(ctx->metal_cache, 0);
+      CFRelease(ctx->metal_cache);
+   }
+   free(ctx);
+}
+
+int vrend_video_create_codec(struct vrend_video_context *ctx,
+                             uint32_t handle,
+                             uint32_t profile,
+                             uint32_t entrypoint,
+                             uint32_t chroma_format,
+                             uint32_t level,
+                             uint32_t width,
+                             uint32_t height,
+                             uint32_t max_ref,
+                             uint32_t flags)
+{
+   struct vrend_video_codec *codec;
+
+   (void)max_ref;
+   (void)flags;
+
+   if (!video_initialized || !ctx)
+      return -1;
+   if (get_video_codec(ctx, handle))
+      return 0;
+   if (!is_supported_profile(profile) ||
+       entrypoint != PIPE_VIDEO_ENTRYPOINT_BITSTREAM ||
+       chroma_format != PIPE_VIDEO_CHROMA_FORMAT_420 || !width || !height ||
+       width > max_width_for_profile(profile) ||
+       height > max_height_for_profile(profile))
+      return -1;
+
+   codec = calloc(1, sizeof(*codec));
+   if (!codec)
+      return -1;
+   codec->handle = handle;
+   codec->profile = profile;
+   codec->level = level;
+   codec->width = width;
+   codec->height = height;
+   codec->ctx = ctx;
+   list_add(&codec->head, &ctx->codecs);
+   return 0;
+}
+
+void vrend_video_destroy_codec(struct vrend_video_context *ctx,
+                               uint32_t handle)
+{
+   if (ctx)
+      destroy_video_codec(get_video_codec(ctx, handle));
+}
+
+int vrend_video_create_buffer(struct vrend_video_context *ctx,
+                              uint32_t handle,
+                              uint32_t format,
+                              uint32_t width,
+                              uint32_t height,
+                              uint32_t *res_handles,
+                              unsigned int num_res)
+{
+   struct vrend_video_buffer *buffer;
+
+   if (!ctx)
+      return -1;
+   if (get_video_buffer(ctx, handle))
+      return 0;
+   const bool valid_nv12 = format == VIRGL_FORMAT_NV12 && num_res == 2;
+   const bool valid_iyuv = format == VIRGL_FORMAT_IYUV && num_res == 3;
+   const bool valid_p010 = format == VIRGL_FORMAT_P010 && num_res == 2;
+   bool valid_handles = res_handles != NULL;
+
+   for (unsigned i = 0; valid_handles && i < num_res; i++)
+      valid_handles = res_handles[i] != 0;
+   if ((!valid_nv12 && !valid_iyuv && !valid_p010) || !width || !height ||
+       !valid_handles)
+      return -1;
+
+   buffer = calloc(1, sizeof(*buffer));
+   if (!buffer)
+      return -1;
+   buffer->handle = handle;
+   buffer->format = format;
+   buffer->width = width;
+   buffer->height = height;
+   buffer->num_planes = num_res;
+   memcpy(buffer->plane_handles, res_handles,
+          num_res * sizeof(buffer->plane_handles[0]));
+   buffer->ctx = ctx;
+   list_add(&buffer->head, &ctx->buffers);
+   return 0;
+}
+
+void vrend_video_destroy_buffer(struct vrend_video_context *ctx,
+                                uint32_t handle)
+{
+   if (ctx)
+      destroy_video_buffer(get_video_buffer(ctx, handle));
+}
+
+int vrend_video_begin_frame(struct vrend_video_context *ctx,
+                            uint32_t cdc_handle,
+                            uint32_t tgt_handle)
+{
+   return ctx && get_video_codec(ctx, cdc_handle) &&
+          get_video_buffer(ctx, tgt_handle) ? 0 : -1;
+}
+
+static void decompression_output(void *decompression_output_refcon,
+                                 void *source_frame_refcon,
+                                 OSStatus status,
+                                 VTDecodeInfoFlags info_flags,
+                                 CVImageBufferRef image,
+                                 CMTime presentation_time_stamp,
+                                 CMTime presentation_duration)
+{
+   struct decoded_frame *frame = source_frame_refcon;
+
+   (void)decompression_output_refcon;
+   (void)info_flags;
+   (void)presentation_time_stamp;
+   (void)presentation_duration;
+
+   frame->status = status;
+   if (status == noErr && image)
+      frame->image = CVPixelBufferRetain(image);
+}
+
+static CFDictionaryRef create_decoder_specification(void)
+{
+#if !TARGET_OS_OSX
+   if (@available(iOS 17.0, tvOS 17.0, *)) {
+#endif
+   const void *keys[] = {
+      kVTVideoDecoderSpecification_RequireHardwareAcceleratedVideoDecoder,
+   };
+   const void *values[] = {kCFBooleanTrue};
+
+   return CFDictionaryCreate(kCFAllocatorDefault, keys, values,
+                             ARRAY_SIZE(keys),
+                             &kCFTypeDictionaryKeyCallBacks,
+                             &kCFTypeDictionaryValueCallBacks);
+#if !TARGET_OS_OSX
+   }
+   return NULL;
+#endif
+}
+
+static CFDictionaryRef create_image_attributes(uint32_t profile,
+                                               uint32_t width,
+                                               uint32_t height)
+{
+   int32_t pixel_format = is_10_bit_profile(profile) ?
+      kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange :
+      kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+   int32_t image_width = width;
+   int32_t image_height = height;
+   CFNumberRef pixel_format_number;
+   CFNumberRef width_number;
+   CFNumberRef height_number;
+   CFDictionaryRef io_surface_properties;
+   CFDictionaryRef attributes;
+   const void *keys[] = {
+      kCVPixelBufferPixelFormatTypeKey,
+      kCVPixelBufferWidthKey,
+      kCVPixelBufferHeightKey,
+      kCVPixelBufferIOSurfacePropertiesKey,
+      kCVPixelBufferMetalCompatibilityKey,
+   };
+   const void *values[ARRAY_SIZE(keys)];
+
+   pixel_format_number = CFNumberCreate(kCFAllocatorDefault,
+                                        kCFNumberSInt32Type, &pixel_format);
+   width_number = CFNumberCreate(kCFAllocatorDefault,
+                                 kCFNumberSInt32Type, &image_width);
+   height_number = CFNumberCreate(kCFAllocatorDefault,
+                                  kCFNumberSInt32Type, &image_height);
+   io_surface_properties = CFDictionaryCreate(
+      kCFAllocatorDefault, NULL, NULL, 0,
+      &kCFTypeDictionaryKeyCallBacks,
+      &kCFTypeDictionaryValueCallBacks);
+   if (!pixel_format_number || !width_number || !height_number ||
+       !io_surface_properties) {
+      if (pixel_format_number)
+         CFRelease(pixel_format_number);
+      if (width_number)
+         CFRelease(width_number);
+      if (height_number)
+         CFRelease(height_number);
+      if (io_surface_properties)
+         CFRelease(io_surface_properties);
+      return NULL;
+   }
+
+   values[0] = pixel_format_number;
+   values[1] = width_number;
+   values[2] = height_number;
+   values[3] = io_surface_properties;
+   values[4] = kCFBooleanTrue;
+   attributes = CFDictionaryCreate(kCFAllocatorDefault, keys, values,
+                                   ARRAY_SIZE(keys),
+                                   &kCFTypeDictionaryKeyCallBacks,
+                                   &kCFTypeDictionaryValueCallBacks);
+   CFRelease(pixel_format_number);
+   CFRelease(width_number);
+   CFRelease(height_number);
+   CFRelease(io_surface_properties);
+   return attributes;
+}
+
+static bool h264_parameter_sets_match(
+   const struct vrend_h264_parameter_sets *left,
+   const struct vrend_h264_parameter_sets *right)
+{
+   return left->sps_size == right->sps_size &&
+          left->pps_size == right->pps_size &&
+          memcmp(left->sps, right->sps, left->sps_size) == 0 &&
+          memcmp(left->pps, right->pps, left->pps_size) == 0;
+}
+
+static bool h265_parameter_sets_match(
+   const struct vrend_h265_parameter_sets *left,
+   const struct vrend_h265_parameter_sets *right)
+{
+   return left->vps_size == right->vps_size &&
+          left->sps_size == right->sps_size &&
+          left->pps_size == right->pps_size &&
+          memcmp(left->vps, right->vps, left->vps_size) == 0 &&
+          memcmp(left->sps, right->sps, left->sps_size) == 0 &&
+          memcmp(left->pps, right->pps, left->pps_size) == 0;
+}
+
+static bool parameter_sets_match(struct vrend_video_codec *codec,
+                                 const void *sets)
+{
+   if (is_jpeg_profile(codec->profile))
+      return codec->session != NULL;
+   if (is_hevc_profile(codec->profile)) {
+      return h265_parameter_sets_match(&codec->parameter_sets.h265,
+                                       sets);
+   }
+   return h264_parameter_sets_match(&codec->parameter_sets.h264, sets);
+}
+
+static void store_parameter_sets(struct vrend_video_codec *codec,
+                                 const void *sets)
+{
+   if (is_jpeg_profile(codec->profile))
+      return;
+   if (is_hevc_profile(codec->profile))
+      codec->parameter_sets.h265 =
+         *(const struct vrend_h265_parameter_sets *)sets;
+   else
+      codec->parameter_sets.h264 =
+         *(const struct vrend_h264_parameter_sets *)sets;
+}
+
+static OSStatus create_format_description(
+   struct vrend_video_codec *codec,
+   const void *sets,
+   CMVideoFormatDescriptionRef *format)
+{
+   if (is_jpeg_profile(codec->profile)) {
+      return CMVideoFormatDescriptionCreate(
+         kCFAllocatorDefault, kCMVideoCodecType_JPEG,
+         (int32_t)codec->width, (int32_t)codec->height, NULL, format);
+   }
+   if (is_hevc_profile(codec->profile)) {
+      const struct vrend_h265_parameter_sets *h265_sets = sets;
+      const uint8_t *pointers[] = {
+         h265_sets->vps, h265_sets->sps, h265_sets->pps,
+      };
+      const size_t sizes[] = {
+         h265_sets->vps_size, h265_sets->sps_size, h265_sets->pps_size,
+      };
+
+      return CMVideoFormatDescriptionCreateFromHEVCParameterSets(
+         kCFAllocatorDefault, ARRAY_SIZE(pointers), pointers, sizes, 4,
+         NULL, format);
+   }
+
+   const struct vrend_h264_parameter_sets *h264_sets = sets;
+   const uint8_t *pointers[] = {h264_sets->sps, h264_sets->pps};
+   const size_t sizes[] = {h264_sets->sps_size, h264_sets->pps_size};
+   return CMVideoFormatDescriptionCreateFromH264ParameterSets(
+      kCFAllocatorDefault, ARRAY_SIZE(pointers), pointers, sizes, 4,
+      format);
+}
+
+static int create_session(struct vrend_video_codec *codec,
+                          const void *sets)
+{
+   VTDecompressionOutputCallbackRecord callback = {
+      .decompressionOutputCallback = decompression_output,
+      .decompressionOutputRefCon = codec,
+   };
+   CFDictionaryRef decoder_specification = NULL;
+   CFDictionaryRef image_attributes = NULL;
+   CFTypeRef using_hardware = NULL;
+   OSStatus status;
+
+   destroy_session(codec);
+   status = create_format_description(codec, sets, &codec->format);
+   if (status != noErr)
+      goto fail;
+
+   decoder_specification = create_decoder_specification();
+   image_attributes = create_image_attributes(codec->profile, codec->width,
+                                              codec->height);
+   if (!decoder_specification || !image_attributes)
+      goto fail;
+   status = VTDecompressionSessionCreate(
+      kCFAllocatorDefault, codec->format, decoder_specification,
+      image_attributes, &callback, &codec->session);
+   CFRelease(decoder_specification);
+   CFRelease(image_attributes);
+   decoder_specification = NULL;
+   image_attributes = NULL;
+   if (status != noErr)
+      goto fail;
+
+   status = noErr;
+#if TARGET_OS_OSX
+   status = VTSessionCopyProperty(
+      codec->session,
+      kVTDecompressionPropertyKey_UsingHardwareAcceleratedVideoDecoder,
+      kCFAllocatorDefault, &using_hardware);
+#else
+   if (@available(iOS 17.0, tvOS 17.0, *)) {
+      status = VTSessionCopyProperty(
+         codec->session,
+         kVTDecompressionPropertyKey_UsingHardwareAcceleratedVideoDecoder,
+         kCFAllocatorDefault, &using_hardware);
+   }
+#endif
+   if ((status != noErr || using_hardware != kCFBooleanTrue) &&
+       !(is_jpeg_profile(codec->profile) &&
+         status == kVTPropertyNotSupportedErr)) {
+      if (using_hardware)
+         CFRelease(using_hardware);
+      goto fail;
+   }
+   if (using_hardware)
+      CFRelease(using_hardware);
+   store_parameter_sets(codec, sets);
+   virgl_info("VideoToolbox %s hardware decoder active: "
+              "profile=%u size=%ux%u\n",
+              codec_family_name(codec->profile), (unsigned)codec->profile,
+              (unsigned)codec->width,
+              (unsigned)codec->height);
+   return 0;
+
+fail:
+   virgl_warn("VideoToolbox %s session creation failed: status=%d\n",
+              codec_family_name(codec->profile), (int)status);
+   if (decoder_specification)
+      CFRelease(decoder_specification);
+   if (image_attributes)
+      CFRelease(image_attributes);
+   destroy_session(codec);
+   return -1;
+}
+
+static int ensure_session(struct vrend_video_codec *codec,
+                          const void *sets)
+{
+   CMVideoFormatDescriptionRef format = NULL;
+   OSStatus status;
+
+   if (codec->session && parameter_sets_match(codec, sets))
+      return 0;
+   if (!codec->session)
+      return create_session(codec, sets);
+
+   status = create_format_description(codec, sets, &format);
+   if (status != noErr || !format)
+      return -1;
+   if (!VTDecompressionSessionCanAcceptFormatDescription(codec->session,
+                                                          format)) {
+      CFRelease(format);
+      return create_session(codec, sets);
+   }
+
+   CFRelease(codec->format);
+   codec->format = format;
+   store_parameter_sets(codec, sets);
+   return 0;
+}
+
+#ifdef ENABLE_METAL
+static bool ensure_metal_cache(struct vrend_video_context *ctx)
+{
+   id<MTLDevice> device;
+   int64_t usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+   CFNumberRef usage_number = NULL;
+   CFDictionaryRef cache_attributes = NULL;
+   CVReturn status = kCVReturnError;
+
+   if (ctx->metal_cache)
+      return true;
+   if (ctx->metal_cache_attempted)
+      return false;
+   ctx->metal_cache_attempted = true;
+
+   device = (id<MTLDevice>)virgl_egl_metal_get_device(egl);
+   if (!device)
+      return false;
+
+   usage_number = CFNumberCreate(kCFAllocatorDefault,
+                                 kCFNumberSInt64Type, &usage);
+   if (usage_number) {
+      const void *keys[] = {kCVMetalTextureUsage};
+      const void *values[] = {usage_number};
+
+      cache_attributes = CFDictionaryCreate(
+         kCFAllocatorDefault, keys, values, ARRAY_SIZE(keys),
+         &kCFTypeDictionaryKeyCallBacks,
+         &kCFTypeDictionaryValueCallBacks);
+   }
+   if (cache_attributes) {
+      status = CVMetalTextureCacheCreate(kCFAllocatorDefault,
+                                         cache_attributes, device, NULL,
+                                         &ctx->metal_cache);
+   }
+   if (cache_attributes)
+      CFRelease(cache_attributes);
+   if (usage_number)
+      CFRelease(usage_number);
+   return status == kCVReturnSuccess && ctx->metal_cache;
+}
+
+static bool ensure_metal_scratch(struct vrend_video_buffer *target)
+{
+   GLuint textures[VREND_VT_METAL_PLANE_COUNT] = {0};
+
+   if (target->metal_planes[0].texture && target->metal_planes[1].texture)
+      return true;
+
+   glGenTextures(VREND_VT_METAL_PLANE_COUNT, textures);
+   for (unsigned i = 0; i < VREND_VT_METAL_PLANE_COUNT; i++) {
+      glBindTexture(GL_TEXTURE_2D, textures[i]);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+   }
+   glBindTexture(GL_TEXTURE_2D, 0);
+   if (glGetError() != GL_NO_ERROR)
+      goto fail;
+
+   for (unsigned i = 0; i < VREND_VT_METAL_PLANE_COUNT; i++) {
+      target->metal_planes[i].texture = textures[i];
+   }
+   return true;
+
+fail:
+   glDeleteTextures(VREND_VT_METAL_PLANE_COUNT, textures);
+   return false;
+}
+
+static bool validate_metal_destination(struct vrend_video_buffer *target,
+                                       unsigned plane,
+                                       enum virgl_formats expected_format,
+                                       size_t width,
+                                       size_t height,
+                                       struct vrend_resource **resource_out)
+{
+   struct vrend_resource *resource;
+
+   if (plane >= target->num_planes || width > INT_MAX || height > INT_MAX)
+      return false;
+   resource = vrend_renderer_ctx_res_lookup(
+      target->ctx->ctx, target->plane_handles[plane]);
+   if (!resource || !resource->gl_id ||
+       !has_bit(resource->storage_bits, VREND_STORAGE_GL_TEXTURE) ||
+       resource->base.target != PIPE_TEXTURE_2D ||
+       resource->target != GL_TEXTURE_2D ||
+       resource->base.format != expected_format ||
+       resource->base.depth0 != 1 || resource->base.last_level != 0 ||
+       resource->base.nr_samples > 1 ||
+       width > resource->base.width0 || height > resource->base.height0)
+      return false;
+   *resource_out = resource;
+   return true;
+}
+
+static bool copy_metal_plane(struct vrend_video_metal_plane *plane,
+                             GLuint framebuffer,
+                             EGLImageKHR image,
+                             struct vrend_resource *destination,
+                             size_t width,
+                             size_t height,
+                             bool *copy_issued)
+{
+   GLenum framebuffer_status;
+   GLenum error;
+
+   *copy_issued = false;
+   glBindTexture(GL_TEXTURE_2D, plane->texture);
+   glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, (GLeglImageOES)image);
+   if (glGetError() != GL_NO_ERROR)
+      return false;
+
+   glBindFramebuffer(GL_READ_FRAMEBUFFER, framebuffer);
+   glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                          GL_TEXTURE_2D, plane->texture, 0);
+   framebuffer_status = glCheckFramebufferStatus(GL_READ_FRAMEBUFFER);
+   error = glGetError();
+   if (framebuffer_status != GL_FRAMEBUFFER_COMPLETE || error != GL_NO_ERROR)
+      return false;
+
+   glBindTexture(GL_TEXTURE_2D, destination->gl_id);
+   glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0,
+                       (GLsizei)width, (GLsizei)height);
+   *copy_issued = true;
+   return glGetError() == GL_NO_ERROR;
+}
+
+static int copy_biplanar_with_metal(struct vrend_video_buffer *target,
+                                    CVPixelBufferRef image)
+{
+   enum virgl_formats virgl_formats[VREND_VT_METAL_PLANE_COUNT];
+   MTLPixelFormat metal_formats[VREND_VT_METAL_PLANE_COUNT];
+   struct vrend_video_context *ctx = target->ctx;
+   struct vrend_resource *destinations[VREND_VT_METAL_PLANE_COUNT] = {0};
+   CVMetalTextureRef cv_textures[VREND_VT_METAL_PLANE_COUNT] = {0};
+   EGLImageKHR egl_images[VREND_VT_METAL_PLANE_COUNT] = {
+      EGL_NO_IMAGE_KHR,
+      EGL_NO_IMAGE_KHR,
+   };
+   size_t widths[VREND_VT_METAL_PLANE_COUNT];
+   size_t heights[VREND_VT_METAL_PLANE_COUNT];
+   GLuint framebuffer = 0;
+   id<MTLDevice> device;
+   const OSType pixel_format = CVPixelBufferGetPixelFormatType(image);
+   const bool p010 = target->format == VIRGL_FORMAT_P010;
+   bool copy_issued = false;
+   unsigned copied_planes = 0;
+   int result = -1;
+
+   const bool compatible_pixel_format = p010 ?
+      pixel_format == kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange :
+      (pixel_format == kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange ||
+       pixel_format == kCVPixelFormatType_420YpCbCr8BiPlanarFullRange);
+   if (!compatible_pixel_format ||
+       (target->format != VIRGL_FORMAT_NV12 && !p010) ||
+       target->num_planes != 2 ||
+       !CVPixelBufferIsPlanar(image) ||
+       CVPixelBufferGetPlaneCount(image) < VREND_VT_METAL_PLANE_COUNT ||
+       !ensure_metal_cache(ctx))
+      return -1;
+   if (p010) {
+      virgl_formats[0] = VIRGL_FORMAT_R16_UNORM;
+      virgl_formats[1] = VIRGL_FORMAT_R16G16_UNORM;
+      metal_formats[0] = MTLPixelFormatR16Unorm;
+      metal_formats[1] = MTLPixelFormatRG16Unorm;
+   } else {
+      virgl_formats[0] = VIRGL_FORMAT_R8_UNORM;
+      virgl_formats[1] = VIRGL_FORMAT_R8G8_UNORM;
+      metal_formats[0] = MTLPixelFormatR8Unorm;
+      metal_formats[1] = MTLPixelFormatRG8Unorm;
+   }
+   device = (id<MTLDevice>)virgl_egl_metal_get_device(egl);
+   if (!device)
+      return -1;
+
+   for (unsigned i = 0; i < VREND_VT_METAL_PLANE_COUNT; i++) {
+      widths[i] = CVPixelBufferGetWidthOfPlane(image, i);
+      heights[i] = CVPixelBufferGetHeightOfPlane(image, i);
+      if (!widths[i] || !heights[i] ||
+          !validate_metal_destination(target, i, virgl_formats[i],
+                                      widths[i], heights[i],
+                                      &destinations[i]))
+         return -1;
+   }
+   if (!retire_metal_copy(target) || !ensure_metal_scratch(target))
+      return -1;
+   /* Framebuffer names are not shared between guest subcontexts. Keep this
+    * container local to the active subcontext; the scratch textures persist
+    * safely in the shared object group. */
+   glGenFramebuffers(1, &framebuffer);
+   if (!framebuffer || glGetError() != GL_NO_ERROR)
+      goto out;
+
+   for (unsigned i = 0; i < VREND_VT_METAL_PLANE_COUNT; i++) {
+      CVReturn status = CVMetalTextureCacheCreateTextureFromImage(
+         kCFAllocatorDefault, ctx->metal_cache, image, NULL,
+         metal_formats[i], widths[i], heights[i], i, &cv_textures[i]);
+      id<MTLTexture> texture = cv_textures[i] ?
+         CVMetalTextureGetTexture(cv_textures[i]) : nil;
+
+      if (status != kCVReturnSuccess || !texture ||
+          texture.device != device || texture.textureType != MTLTextureType2D ||
+          texture.pixelFormat != metal_formats[i] ||
+          texture.width != widths[i] || texture.height != heights[i] ||
+          !(texture.usage & MTLTextureUsageRenderTarget))
+         goto out;
+      egl_images[i] = virgl_egl_metal_image_from_texture(
+         egl, (MTLTexture_id)texture);
+      if (egl_images[i] == EGL_NO_IMAGE_KHR)
+         goto out;
+   }
+
+   for (unsigned i = 0; i < VREND_VT_METAL_PLANE_COUNT; i++) {
+      bool plane_copy_issued;
+
+      if (!copy_metal_plane(&target->metal_planes[i], framebuffer,
+                            egl_images[i],
+                            destinations[i], widths[i], heights[i],
+                            &plane_copy_issued)) {
+         copy_issued |= plane_copy_issued;
+         break;
+      }
+      copy_issued = true;
+      copied_planes++;
+   }
+   glBindTexture(GL_TEXTURE_2D, 0);
+   glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+
+   if (copy_issued) {
+      target->metal_fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+      if (!target->metal_fence) {
+         /* This is an error-only safety path: CoreVideo may not recycle the
+          * source IOSurfaces until the already queued copies complete. */
+         glFinish();
+         goto out;
+      }
+      glFlush();
+      for (unsigned i = 0; i < VREND_VT_METAL_PLANE_COUNT; i++) {
+         target->metal_planes[i].source = cv_textures[i];
+         cv_textures[i] = NULL;
+      }
+   }
+   if (copied_planes == VREND_VT_METAL_PLANE_COUNT)
+      result = 0;
+
+out:
+   glBindTexture(GL_TEXTURE_2D, 0);
+   glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+   if (framebuffer)
+      glDeleteFramebuffers(1, &framebuffer);
+   for (unsigned i = 0; i < VREND_VT_METAL_PLANE_COUNT; i++) {
+      if (egl_images[i] != EGL_NO_IMAGE_KHR)
+         virgl_egl_image_destroy(egl, egl_images[i]);
+      if (cv_textures[i])
+         CFRelease(cv_textures[i]);
+   }
+   if (++ctx->metal_cache_frames == VREND_VT_METAL_CACHE_FLUSH_INTERVAL) {
+      CVMetalTextureCacheFlush(ctx->metal_cache, 0);
+      ctx->metal_cache_frames = 0;
+   }
+   return result;
+}
+#endif
+
+static int upload_plane(struct vrend_video_buffer *target,
+                        unsigned target_plane,
+                        enum virgl_formats expected_format,
+                        size_t width,
+                        size_t height,
+                        size_t row_bytes,
+                        void *base)
+{
+   struct vrend_resource *resource;
+   struct pipe_box box;
+   struct iovec iov;
+   struct vrend_transfer_info info;
+   int result;
+
+   if (target_plane >= target->num_planes || !base || width > INT_MAX ||
+       height > INT_MAX || row_bytes > UINT32_MAX ||
+       (height && row_bytes > UINT32_MAX / height))
+      return -1;
+   resource = vrend_renderer_ctx_res_lookup(
+      target->ctx->ctx, target->plane_handles[target_plane]);
+   if (!resource || resource->base.format != expected_format ||
+       width > resource->base.width0 || height > resource->base.height0)
+      return -1;
+
+   box = (struct pipe_box){
+      .x = 0,
+      .y = 0,
+      .z = 0,
+      .width = (int)width,
+      .height = (int)height,
+      .depth = 1,
+   };
+   iov = (struct iovec){
+      .iov_base = base,
+      .iov_len = row_bytes * height,
+   };
+   info = (struct vrend_transfer_info){
+      .level = 0,
+      .stride = (uint32_t)row_bytes,
+      .layer_stride = (uint32_t)(row_bytes * height),
+      .iovec_cnt = 1,
+      .iovec = &iov,
+      .offset = 0,
+      .box = &box,
+      .synchronized = true,
+   };
+   result = vrend_renderer_transfer_iov(
+      target->ctx->ctx, target->plane_handles[target_plane], &info,
+      VIRGL_TRANSFER_TO_HOST);
+   return result;
+}
+
+static int upload_decoded_frame_cpu(struct vrend_video_buffer *target,
+                                    CVPixelBufferRef image)
+{
+   const OSType pixel_format = CVPixelBufferGetPixelFormatType(image);
+   const bool p010 =
+      pixel_format == kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange;
+   uint8_t *u_plane;
+   uint8_t *v_plane;
+   CVReturn lock_status;
+   int result = -1;
+
+   if (!p010 &&
+       pixel_format != kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange &&
+       pixel_format != kCVPixelFormatType_420YpCbCr8BiPlanarFullRange)
+      return -1;
+   if (!CVPixelBufferIsPlanar(image) ||
+       CVPixelBufferGetPlaneCount(image) < 2)
+      return -1;
+
+   lock_status = CVPixelBufferLockBaseAddress(image,
+                                               kCVPixelBufferLock_ReadOnly);
+   if (lock_status != kCVReturnSuccess)
+      return -1;
+
+   const size_t y_width = CVPixelBufferGetWidthOfPlane(image, 0);
+   const size_t y_height = CVPixelBufferGetHeightOfPlane(image, 0);
+   const size_t y_row_bytes = CVPixelBufferGetBytesPerRowOfPlane(image, 0);
+   void *y_base = CVPixelBufferGetBaseAddressOfPlane(image, 0);
+   const size_t chroma_width = CVPixelBufferGetWidthOfPlane(image, 1);
+   const size_t chroma_height = CVPixelBufferGetHeightOfPlane(image, 1);
+   const size_t chroma_row_bytes =
+      CVPixelBufferGetBytesPerRowOfPlane(image, 1);
+   uint8_t *chroma_base = CVPixelBufferGetBaseAddressOfPlane(image, 1);
+
+   if (p010) {
+      if (target->format != VIRGL_FORMAT_P010 || target->num_planes != 2 ||
+          upload_plane(target, 0, VIRGL_FORMAT_R16_UNORM,
+                       y_width, y_height, y_row_bytes, y_base) != 0)
+         goto out;
+      result = upload_plane(target, 1, VIRGL_FORMAT_R16G16_UNORM,
+                            chroma_width, chroma_height, chroma_row_bytes,
+                            chroma_base);
+      goto out;
+   }
+
+   if (upload_plane(target, 0, VIRGL_FORMAT_R8_UNORM, y_width, y_height,
+                    y_row_bytes, y_base) != 0)
+      goto out;
+   if (target->format == VIRGL_FORMAT_NV12 && target->num_planes == 2) {
+      result = upload_plane(target, 1, VIRGL_FORMAT_R8G8_UNORM,
+                            chroma_width, chroma_height, chroma_row_bytes,
+                            chroma_base);
+      goto out;
+   }
+
+   if (target->format != VIRGL_FORMAT_IYUV || target->num_planes != 3 ||
+       !chroma_base || chroma_width > SIZE_MAX / 2 ||
+       chroma_row_bytes < chroma_width * 2 ||
+       (chroma_height && chroma_width > SIZE_MAX / chroma_height))
+      goto out;
+   const size_t chroma_size = chroma_width * chroma_height;
+   if (chroma_size > SIZE_MAX / 2 ||
+       !reserve_buffer(&target->chroma_scratch,
+                       &target->chroma_scratch_capacity,
+                       chroma_size * 2))
+      goto out;
+   u_plane = target->chroma_scratch;
+   v_plane = u_plane + chroma_size;
+   for (size_t y = 0; y < chroma_height; y++) {
+      const uint8_t *source_row = chroma_base + y * chroma_row_bytes;
+      uint8_t *u_row = u_plane + y * chroma_width;
+      uint8_t *v_row = v_plane + y * chroma_width;
+
+      for (size_t x = 0; x < chroma_width; x++) {
+         u_row[x] = source_row[x * 2];
+         v_row[x] = source_row[x * 2 + 1];
+      }
+   }
+   if (upload_plane(target, 1, VIRGL_FORMAT_R8_UNORM, chroma_width,
+                    chroma_height, chroma_width, u_plane) != 0)
+      goto out;
+   result = upload_plane(target, 2, VIRGL_FORMAT_R8_UNORM, chroma_width,
+                         chroma_height, chroma_width, v_plane);
+
+out:
+   CVPixelBufferUnlockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+   return result;
+}
+
+static int upload_decoded_frame(struct vrend_video_buffer *target,
+                                CVPixelBufferRef image)
+{
+   struct vrend_video_context *ctx = target->ctx;
+
+   if (target->format == VIRGL_FORMAT_NV12 ||
+       target->format == VIRGL_FORMAT_P010) {
+#ifdef ENABLE_METAL
+      if (!ctx->metal_copy_disabled) {
+         if (copy_biplanar_with_metal(target, image) == 0) {
+            if (!ctx->reported_metal_active) {
+               ctx->reported_metal_active = true;
+               virgl_info("VideoToolbox bi-planar Metal copy active\n");
+            }
+            return 0;
+         }
+         ctx->metal_copy_disabled = true;
+      }
+#endif
+      if (target->format == VIRGL_FORMAT_P010 && !ctx->reported_p010_cpu) {
+         ctx->reported_p010_cpu = true;
+         virgl_info("VideoToolbox P010 CPU upload active\n");
+      } else if (target->format == VIRGL_FORMAT_NV12 &&
+                 !ctx->reported_metal_fallback) {
+         ctx->reported_metal_fallback = true;
+         virgl_warn("VideoToolbox bi-planar Metal copy unavailable; "
+                    "using CPU upload\n");
+      }
+   }
+   return upload_decoded_frame_cpu(target, image);
+}
+
+static int decode_frame(struct vrend_video_codec *codec,
+                        struct vrend_video_buffer *target,
+                        const uint8_t *sample_data,
+                        size_t sample_data_size)
+{
+   CMBlockBufferRef block = NULL;
+   CMSampleBufferRef sample = NULL;
+   const CMSampleTimingInfo timing = {
+      .duration = kCMTimeInvalid,
+      .presentationTimeStamp = kCMTimeInvalid,
+      .decodeTimeStamp = kCMTimeInvalid,
+   };
+   const size_t sample_size = sample_data_size;
+   struct decoded_frame frame = {.status = noErr, .image = NULL};
+   VTDecodeInfoFlags info_flags = 0;
+   OSStatus status;
+   int result = -1;
+
+   status = CMBlockBufferCreateWithMemoryBlock(
+      kCFAllocatorDefault, (void *)sample_data, sample_data_size,
+      kCFAllocatorNull, NULL, 0, sample_data_size, 0, &block);
+   if (status != noErr)
+      goto out;
+   status = CMSampleBufferCreateReady(
+      kCFAllocatorDefault, block, codec->format, 1, 1, &timing,
+      1, &sample_size, &sample);
+   if (status != noErr)
+      goto out;
+
+   status = VTDecompressionSessionDecodeFrame(
+      codec->session, sample, 0, &frame, &info_flags);
+   if (status != noErr || frame.status != noErr || !frame.image ||
+       (info_flags & kVTDecodeInfo_FrameDropped)) {
+      if (!codec->reported_decode_failure) {
+         virgl_warn("VideoToolbox frame decode rejected: profile=%u "
+                    "status=%d callback=%d image=%s flags=0x%x\n",
+                    (unsigned)codec->profile, (int)status,
+                    (int)frame.status, frame.image ? "yes" : "no",
+                    (unsigned)info_flags);
+      }
+      goto out;
+   }
+   result = upload_decoded_frame(target, frame.image);
+   if (result != 0 && !codec->reported_decode_failure) {
+      virgl_warn("VideoToolbox frame upload rejected: profile=%u "
+                 "target-format=%u pixel-format=0x%08x\n",
+                 (unsigned)codec->profile, (unsigned)target->format,
+                 (unsigned)CVPixelBufferGetPixelFormatType(frame.image));
+   }
+   if (result == 0 && !codec->reported_decoded_frame) {
+      codec->reported_decoded_frame = true;
+      virgl_info("VideoToolbox %s hardware decoder produced its first "
+                 "decoded frame\n", codec_family_name(codec->profile));
+   }
+
+out:
+   if (frame.image)
+      CVPixelBufferRelease(frame.image);
+   if (sample)
+      CFRelease(sample);
+   if (block)
+      CFRelease(block);
+   return result;
+}
+
+int vrend_video_decode_bitstream(struct vrend_video_context *ctx,
+                                 uint32_t cdc_handle,
+                                 uint32_t tgt_handle,
+                                 uint32_t desc_handle,
+                                 unsigned num_buffers,
+                                 const uint32_t *buffer_handles,
+                                 const uint32_t *buffer_sizes)
+{
+   struct vrend_video_codec *codec;
+   struct vrend_video_buffer *target;
+   struct vrend_resource *resource;
+   union virgl_picture_desc desc;
+   union {
+      struct vrend_h264_parameter_sets h264;
+      struct vrend_h265_parameter_sets h265;
+   } parameter_sets = {0};
+   const void *selected_parameter_sets = NULL;
+   size_t annexb_size = 0;
+   size_t sample_data_capacity;
+   size_t sample_data_size = 0;
+   uint32_t pps_id = 0;
+   int result = -1;
+
+   if (!ctx || !num_buffers || !buffer_handles || !buffer_sizes)
+      return -1;
+   codec = get_video_codec(ctx, cdc_handle);
+   target = get_video_buffer(ctx, tgt_handle);
+   if (!codec || !target)
+      return -1;
+   if (is_10_bit_profile(codec->profile) !=
+       (target->format == VIRGL_FORMAT_P010))
+      return report_decode_failure(codec, "target-format");
+
+   for (unsigned i = 0; i < num_buffers; i++) {
+      if (buffer_sizes[i] > SIZE_MAX - annexb_size)
+         return report_decode_failure(codec, "bitstream-size-overflow");
+      annexb_size += buffer_sizes[i];
+   }
+   if (!annexb_size)
+      return report_decode_failure(codec, "empty-bitstream");
+   if (!reserve_buffer(&codec->annexb, &codec->annexb_capacity,
+                       annexb_size))
+      return report_decode_failure(codec, "bitstream-allocation");
+
+   size_t offset = 0;
+   for (unsigned i = 0; i < num_buffers; i++) {
+      resource = vrend_renderer_ctx_res_lookup(ctx->ctx, buffer_handles[i]);
+      if (!resource || buffer_sizes[i] > resource->base.width0) {
+         report_decode_failure(codec, "bitstream-resource");
+         goto out;
+      }
+      if (vrend_read_from_iovec(resource->iov, resource->num_iovs, 0,
+                                (char *)codec->annexb + offset,
+                                buffer_sizes[i]) != buffer_sizes[i]) {
+         report_decode_failure(codec, "bitstream-read");
+         goto out;
+      }
+      offset += buffer_sizes[i];
+   }
+
+   resource = vrend_renderer_ctx_res_lookup(ctx->ctx, desc_handle);
+   if (!resource) {
+      report_decode_failure(codec, "descriptor-resource");
+      goto out;
+   }
+   memset(&desc, 0, sizeof(desc));
+   size_t desc_size = MIN2(resource->base.width0, sizeof(desc));
+   if (vrend_read_from_iovec(resource->iov, resource->num_iovs, 0,
+                             (char *)&desc, desc_size) != desc_size) {
+      report_decode_failure(codec, "descriptor-read");
+      goto out;
+   }
+   if (desc.base.profile != codec->profile ||
+       desc.base.entry_point != PIPE_VIDEO_ENTRYPOINT_BITSTREAM ||
+       (is_h264_profile(codec->profile) && desc.h264.field_pic_flag)) {
+      report_decode_failure(codec, "descriptor-validation");
+      goto out;
+   }
+
+   if (is_jpeg_profile(codec->profile)) {
+      size_t jpeg_offset = 0;
+
+      while (jpeg_offset + 1 < annexb_size &&
+             (codec->annexb[jpeg_offset] != 0xff ||
+              codec->annexb[jpeg_offset + 1] != 0xd8))
+         jpeg_offset++;
+      if (jpeg_offset + 1 >= annexb_size) {
+         report_decode_failure(codec, "jpeg-start-of-image");
+         goto out;
+      }
+      if (ensure_session(codec, NULL) != 0) {
+         report_decode_failure(codec, "session-creation");
+         goto out;
+      }
+      result = decode_frame(codec, target, codec->annexb + jpeg_offset,
+                            annexb_size - jpeg_offset);
+      if (result != 0)
+         report_decode_failure(codec, "frame-decode-or-upload");
+      goto out;
+   }
+
+   if (annexb_size > (SIZE_MAX - 16) / 2) {
+      report_decode_failure(codec, "sample-data-size-overflow");
+      goto out;
+   }
+   sample_data_capacity = annexb_size * 2 + 16;
+   if (!reserve_buffer(&codec->sample_data, &codec->sample_data_capacity,
+                       sample_data_capacity)) {
+      report_decode_failure(codec, "sample-data-allocation");
+      goto out;
+   }
+   if (is_hevc_profile(codec->profile)) {
+      if (vrend_video_h265_annexb_to_hvcc_buffer(
+             codec->annexb, annexb_size, codec->sample_data,
+             codec->sample_data_capacity, &sample_data_size,
+             &pps_id) != 0 ||
+          vrend_video_h265_build_parameter_sets(
+             codec->profile, codec->level, codec->width, codec->height,
+             pps_id, &desc.h265, &parameter_sets.h265) != 0) {
+         report_decode_failure(codec, "hevc-bitstream-preparation");
+         goto out;
+      }
+      selected_parameter_sets = &parameter_sets.h265;
+   } else {
+      if (vrend_video_h264_annexb_to_avcc_buffer(
+             codec->annexb, annexb_size, codec->sample_data,
+             codec->sample_data_capacity, &sample_data_size,
+             &pps_id) != 0 ||
+          vrend_video_h264_build_parameter_sets(
+             codec->profile, codec->width, codec->height, pps_id,
+             &desc.h264, &parameter_sets.h264) != 0) {
+         report_decode_failure(codec, "h264-bitstream-preparation");
+         goto out;
+      }
+      selected_parameter_sets = &parameter_sets.h264;
+   }
+   if (!selected_parameter_sets) {
+      report_decode_failure(codec, "parameter-set-synthesis");
+      goto out;
+   }
+   if (ensure_session(codec, selected_parameter_sets) != 0) {
+      report_decode_failure(codec, "session-creation");
+      goto out;
+   }
+   result = decode_frame(codec, target, codec->sample_data,
+                         sample_data_size);
+   if (result != 0)
+      report_decode_failure(codec, "frame-decode-or-upload");
+
+out:
+   return result;
+}
+
+int vrend_video_encode_bitstream(struct vrend_video_context *ctx,
+                                 uint32_t cdc_handle,
+                                 uint32_t src_handle,
+                                 uint32_t dest_handle,
+                                 uint32_t desc_handle,
+                                 uint32_t feed_handle)
+{
+   (void)ctx;
+   (void)cdc_handle;
+   (void)src_handle;
+   (void)dest_handle;
+   (void)desc_handle;
+   (void)feed_handle;
+   return -1;
+}
+
+int vrend_video_end_frame(struct vrend_video_context *ctx,
+                          uint32_t cdc_handle,
+                          uint32_t tgt_handle)
+{
+   return ctx && get_video_codec(ctx, cdc_handle) &&
+          get_video_buffer(ctx, tgt_handle) ? 0 : -1;
+}
