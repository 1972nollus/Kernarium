From aba8604d5e08eb2926467e871fb0224381878c71 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 24 Aug 2026 23:41:18 +0900
Subject: [PATCH 08/30] util: fall back to app tmpdir for iOS shmem

---
 src/mesa/util/anon_file.c | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/mesa/util/anon_file.c b/src/mesa/util/anon_file.c
index c363891..abeebf9 100644
--- a/src/mesa/util/anon_file.c
+++ b/src/mesa/util/anon_file.c
@@ -54,7 +54,7 @@
 #endif
 
 #if !(defined(__FreeBSD__) || defined(HAVE_MEMFD_CREATE) ||                    \
-      defined(HAVE_MKOSTEMP) || defined(__ANDROID__) || defined(__APPLE__))
+      defined(HAVE_MKOSTEMP) || defined(__ANDROID__))
 static int
 set_cloexec_or_close(int fd)
 {
@@ -79,7 +79,7 @@ err:
 #endif
 
 #if !(defined(__FreeBSD__) || defined(HAVE_MEMFD_CREATE) ||                    \
-      defined(__ANDROID__) || defined(__APPLE__))
+      defined(__ANDROID__))
 static int
 create_tmpfile_cloexec(char *tmpname)
 {
@@ -179,6 +179,24 @@ os_create_anonymous_file(off_t size, const char *debug_name)
      if (errno != EEXIST)
        break;
    }
+
+   /* A physical iOS App Sandbox denies ungrouped POSIX shared-memory names.
+    * The descriptor is still transferable over SCM_RIGHTS when it comes from
+    * an unlinked file in the app's private temporary directory, so do not
+    * require an otherwise-unnecessary application-group entitlement. */
+   if (fd < 0 && !group) {
+     const char *tmpdir = getenv("TMPDIR");
+     if (tmpdir && tmpdir[0]) {
+       char *tmpname;
+       const char *separator = tmpdir[strlen(tmpdir) - 1] == '/' ? "" : "/";
+       if (asprintf(&tmpname, "%s%svirgl-shared-XXXXXX", tmpdir, separator) >= 0) {
+         fd = create_tmpfile_cloexec(tmpname);
+         const int saved_errno = errno;
+         free(tmpname);
+         errno = saved_errno;
+       }
+     }
+   }
 #elif defined(__OpenBSD__)
    char template[] = "/tmp/mesa-XXXXXXXXXX";
    fd = shm_mkstemp(template);
