+// Test that a primitives-written query counts only draws inside its scope when transform feedback
+// was already active, including a pause before the first queried draw and the feedback-before-query
+// end order.
+TEST_P(TransformFeedbackTest, QueryScopeAcrossPauseResume)
+{
+    const std::vector<std::string> tfVaryings = {"gl_Position"};
+    compileDefaultProgram(tfVaryings, GL_INTERLEAVED_ATTRIBS);
+
+    glUseProgram(mProgram);
+    glBindBufferBase(GL_TRANSFORM_FEEDBACK_BUFFER, 0, mTransformFeedbackBuffer);
+    glBeginTransformFeedback(GL_POINTS);
+
+    // This draw precedes the query and must not contribute to its result.
+    glDrawArrays(GL_POINTS, 0, 1);
+
+    GLQuery primitivesWrittenQuery;
+    glBeginQuery(GL_TRANSFORM_FEEDBACK_PRIMITIVES_WRITTEN, primitivesWrittenQuery);
+    glPauseTransformFeedback();
+
+    // A paused draw is also outside the set of primitives written by transform feedback.
+    glDrawArrays(GL_POINTS, 0, 4);
+
+    glResumeTransformFeedback();
+    glDrawArrays(GL_POINTS, 0, 2);
+
+    glEndTransformFeedback();
+    glEndQuery(GL_TRANSFORM_FEEDBACK_PRIMITIVES_WRITTEN);
+
+    GLuint primitivesWritten = 0;
+    glGetQueryObjectuiv(primitivesWrittenQuery, GL_QUERY_RESULT_EXT, &primitivesWritten);
+    EXPECT_GL_NO_ERROR();
+    EXPECT_EQ(2u, primitivesWritten);
+}
+
 // Test that rebinding a buffer with the same offset resets the offset (no longer appending from the
 // old position)
 TEST_P(TransformFeedbackTest, BufferRebinding)
