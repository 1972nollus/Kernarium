From 8d692a4029b2d49902a571294ba0bd7f000ea5cb Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 23:58:50 +0900
Subject: [PATCH 4/9] Metal: accept the arm64 macOS product baseline

---
 .../ThirdParty/ANGLE/src/common/apple_platform_utils.mm  | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/Source/ThirdParty/ANGLE/src/common/apple_platform_utils.mm b/Source/ThirdParty/ANGLE/src/common/apple_platform_utils.mm
index 20af932d94..daf48b7f71 100644
--- a/Source/ThirdParty/ANGLE/src/common/apple_platform_utils.mm
+++ b/Source/ThirdParty/ANGLE/src/common/apple_platform_utils.mm
@@ -98,6 +98,12 @@ bool IsMetalRendererAvailable()
 #if defined(ANGLE_PLATFORM_MACOS) || defined(ANGLE_PLATFORM_MACCATALYST)
                 // Old Macs, such as MacBookPro11,4, cannot use ANGLE's Metal backend.
                 // This check can be removed once they are no longer supported.
+#    if defined(__arm64__)
+                // linux-um-darwin supports arm64 macOS 14 or newer. Every
+                // machine in that product contract has the required Metal
+                // baseline once a system default device exists.
+                gpuFamilySufficient = true;
+#    else
                 if (ANGLE_APPLE_AVAILABLE_XCI(10.15, 13.1, 13))
                 {
                     if ([device supportsFamily:MTLGPUFamilyMac2])
@@ -110,9 +116,10 @@ bool IsMetalRendererAvailable()
                     const NSUInteger macFamily2v1 = 10005;
                     ANGLE_APPLE_ALLOW_DEPRECATED_BEGIN
                     if ([device supportsFeatureSet:static_cast<MTLFeatureSet>(macFamily2v1)])
-                        gpuFamilySufficient = true;
+                    gpuFamilySufficient = true;
                     ANGLE_APPLE_ALLOW_DEPRECATED_END
                 }
+#    endif
 #elif ANGLE_PLATFORM_IOS_FAMILY && !ANGLE_PLATFORM_IOS_FAMILY_SIMULATOR
                 // Hardcode constant to sidestep compiler errors. Call will
                 // return false on older macOS versions.
