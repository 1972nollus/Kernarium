+bool CompileAndGetRequiresStrictMath(const std::string &shaderString, bool *requiresStrictMathOut)
+{
+    ShBuiltInResources resources;
+    InitBuiltInResources(&resources);
+    resources.FragmentPrecisionHigh = 1;
+
+    TCompiler *translator =
+        ConstructCompiler(GL_FRAGMENT_SHADER, SH_GLES3_SPEC, SH_MSL_METAL_OUTPUT);
+    if (!translator->Init(resources))
+    {
+        SafeDelete(translator);
+        return false;
+    }
+
+    const char *shaderStrings[]    = {shaderString.c_str()};
+    ShCompileOptions options       = {};
+    options.objectCode             = true;
+    options.rescopeGlobalVariables = true;
+    const bool compiled            = translator->compile(shaderStrings, 1, options);
+    if (compiled)
+    {
+        TranslatorMSL *translatorMSL = translator->getAsTranslatorMSL();
+        ASSERT(translatorMSL != nullptr);
+        *requiresStrictMathOut = translatorMSL->getTranslatorMetalReflection()->requiresStrictMath;
+    }
+    SafeDelete(translator);
+    return compiled;
+}
+
+TEST_F(MSLOutputTest, NonFiniteOperationsRequireStrictMath)
+{
+    constexpr char kNonFiniteLiteralShader[] = R"(#version 300 es
+        precision highp float;
+        uniform float zero;
+        out vec4 outColor;
+        void main()
+        {
+            outColor = vec4(1.0e2048 - zero);
+        })";
+    constexpr char kClassificationShader[]   = R"(#version 300 es
+        precision highp float;
+        uniform float value;
+        out vec4 outColor;
+        void main()
+        {
+            outColor = isinf(value) ? vec4(1.0) : vec4(0.0);
+        })";
+    constexpr char kFiniteShader[]           = R"(#version 300 es
+        precision highp float;
+        uniform float value;
+        out vec4 outColor;
+        void main()
+        {
+            outColor = vec4(value);
+        })";
+
+    bool requiresStrictMath = false;
+    ASSERT_TRUE(CompileAndGetRequiresStrictMath(kNonFiniteLiteralShader, &requiresStrictMath));
+    EXPECT_TRUE(requiresStrictMath);
+
+    requiresStrictMath = false;
+    ASSERT_TRUE(CompileAndGetRequiresStrictMath(kClassificationShader, &requiresStrictMath));
+    EXPECT_TRUE(requiresStrictMath);
+
+    requiresStrictMath = true;
+    ASSERT_TRUE(CompileAndGetRequiresStrictMath(kFiniteShader, &requiresStrictMath));
+    EXPECT_FALSE(requiresStrictMath);
+}
+
 // Boolean mix selects components and must not perform arithmetic on their bit patterns.  In
 // particular, integer values carried through uintBitsToFloat may be subnormal floats that Metal
 // arithmetic is permitted to flush to zero.
