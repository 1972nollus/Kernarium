From b2710939ab8d7b8800af99fcc2322e86c55b9351 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 22 Aug 2026 10:43:36 +0900
Subject: [PATCH 8/9] Metal: enable texture swizzles on arm64 Simulator

---
 .../ANGLE/src/libANGLE/renderer/metal/DisplayMtl.mm          | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Source/ThirdParty/ANGLE/src/libANGLE/renderer/metal/DisplayMtl.mm b/Source/ThirdParty/ANGLE/src/libANGLE/renderer/metal/DisplayMtl.mm
index 75013aedf0..a3fad0c794 100644
--- a/Source/ThirdParty/ANGLE/src/libANGLE/renderer/metal/DisplayMtl.mm
+++ b/Source/ThirdParty/ANGLE/src/libANGLE/renderer/metal/DisplayMtl.mm
@@ -1275,8 +1275,11 @@ void DisplayMtl::initializeFeatures()
     ANGLE_FEATURE_CONDITION((&mFeatures), hasShaderStencilOutput,
                             supportsMetal2_1() && !isIntel() && !isNVIDIA());
 
+    // Modern arm64 Simulator runtimes implement swizzled Metal texture views.  ANGLE needs
+    // those views to preserve GLES legacy alpha, luminance, and depth sampling semantics.
     ANGLE_FEATURE_CONDITION((&mFeatures), hasTextureSwizzle,
-                            supportsMetal2_2() && supportsEitherGPUFamily(3, 2) && !isSimulator);
+                            supportsMetal2_2() &&
+                                (supportsEitherGPUFamily(3, 2) || (isSimulator && isARM)));
 
     ANGLE_FEATURE_CONDITION((&mFeatures), avoidStencilTextureSwizzle, isIntel());
 
