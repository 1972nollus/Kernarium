From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 28 Aug 2026 15:31:43 +0900
Subject: [PATCH] Add file-only GPT core library for iOS

---
 Makefile.kernarium    |  31 +++++++
 diskio-unix.cc        |  29 +++++-
 guid.cc               |   2 +-
 kernarium_gptfdisk.cc | 200 ++++++++++++++++++++++++++++++++++++++++++
 kernarium_gptfdisk.h  |  52 +++++++++++
 support.h             |   7 +-
 6 files changed, 316 insertions(+), 5 deletions(-)
 create mode 100644 Makefile.kernarium
 create mode 100644 kernarium_gptfdisk.cc
 create mode 100644 kernarium_gptfdisk.h

diff --git a/Makefile.kernarium b/Makefile.kernarium
new file mode 100644
index 0000000000000000000000000000000000000000..ff07aae1f57f26bd5c786e591bdcbbe99cd2dc68
--- /dev/null
+++ b/Makefile.kernarium
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+CXX ?= c++
+AR ?= ar
+RANLIB ?= ranlib
+BUILD_DIR ?= build-kernarium
+LIBRARY ?= $(BUILD_DIR)/libkernarium_gptfdisk.a
+
+CORE_SOURCES = \
+	attributes.cc basicmbr.cc bsd.cc crc32.cc diskio.cc diskio-unix.cc \
+	gpt.cc gptpart.cc guid.cc mbr.cc mbrpart.cc parttypes.cc support.cc \
+	kernarium_gptfdisk.cc
+CORE_OBJECTS = $(CORE_SOURCES:%.cc=$(BUILD_DIR)/%.o)
+
+CPPFLAGS += -DKERNARIUM_GPTFDISK_FILE_ONLY=1
+CXXFLAGS += -O2 -fPIC -fvisibility=hidden -std=c++17
+
+.PHONY: all clean
+
+all: $(LIBRARY)
+
+$(LIBRARY): $(CORE_OBJECTS)
+	$(AR) crs $@ $(CORE_OBJECTS)
+	$(RANLIB) $@
+
+$(BUILD_DIR)/%.o: %.cc
+	@mkdir -p $(BUILD_DIR)
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@
+
+clean:
+	rm -rf $(BUILD_DIR)
