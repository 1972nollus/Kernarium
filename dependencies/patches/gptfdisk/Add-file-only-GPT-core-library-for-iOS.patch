diff --git a/kernarium_gptfdisk.cc b/kernarium_gptfdisk.cc
new file mode 100644
index 0000000000000000000000000000000000000000..8499080944df2c72fdfde882c7df7fb909ac5429
--- /dev/null
+++ b/kernarium_gptfdisk.cc
@@ -0,0 +1,200 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "kernarium_gptfdisk.h"
+
+#include <exception>
+#include <iostream>
+#include <mutex>
+#include <sstream>
+#include <string>
+
+#include "gpt.h"
+
+namespace {
+
+std::mutex gptfdiskMutex;
+
+class ScopedOutputCapture {
+public:
+   ScopedOutputCapture() : oldCout(std::cout.rdbuf(output.rdbuf())),
+                           oldCerr(std::cerr.rdbuf(output.rdbuf())) {}
+   ~ScopedOutputCapture() {
+      std::cout.rdbuf(oldCout);
+      std::cerr.rdbuf(oldCerr);
+   }
+
+private:
+   std::ostringstream output;
+   std::streambuf *oldCout;
+   std::streambuf *oldCerr;
+};
+
+class KernariumGPTData : public GPTData {
+public:
+   bool PartitionIsUsed(uint32_t index) {
+      return (index < numParts) && partitions[index].IsUsed();
+   }
+
+   bool GrowPartition(uint32_t index, uint64_t newLastLBA) {
+      if ((index >= numParts) || !partitions[index].IsUsed())
+         return false;
+      partitions[index].SetLastLBA(newLastLBA);
+      return true;
+   }
+};
+
+void SetError(char *error, size_t errorSize, const char *message) {
+   if ((error == NULL) || (errorSize == 0))
+      return;
+   size_t length = 0;
+   while ((message[length] != '\0') && (length + 1 < errorSize)) {
+      error[length] = message[length];
+      length++;
+   }
+   error[length] = '\0';
+}
+
+int Load(const char *path, uint32_t partitionNumber, KernariumGPTData *gpt,
+         uint32_t *index, char *error, size_t errorSize) {
+   if ((path == NULL) || (path[0] == '\0') || (gpt == NULL) ||
+       (index == NULL) || (partitionNumber == 0)) {
+      SetError(error, errorSize, "invalid GPT fdisk argument");
+      return KERNARIUM_GPTFDISK_INVALID_ARGUMENT;
+   }
+
+   gpt->BeQuiet(1);
+   if (!gpt->LoadPartitions(path)) {
+      SetError(error, errorSize, "could not read disk image");
+      return KERNARIUM_GPTFDISK_IO_ERROR;
+   }
+   if (gpt->WhichWasUsed() != use_gpt) {
+      SetError(error, errorSize, "disk image does not contain a usable GPT");
+      return KERNARIUM_GPTFDISK_INVALID_GPT;
+   }
+
+   *index = partitionNumber - 1;
+   if (!gpt->ValidPartNum(*index) || !gpt->PartitionIsUsed(*index)) {
+      SetError(error, errorSize, "requested GPT partition does not exist");
+      return KERNARIUM_GPTFDISK_INVALID_PARTITION;
+   }
+   return KERNARIUM_GPTFDISK_OK;
+}
+
+void FillInfo(KernariumGPTData &gpt, uint32_t index,
+              kernarium_gptfdisk_partition_info *info) {
+   if (info == NULL)
+      return;
+   info->disk_lbas = gpt.GetSecondHeaderLBA() + 1;
+   info->first_lba = gpt[index].GetFirstLBA();
+   info->last_lba = gpt[index].GetLastLBA();
+   info->backup_header_lba = gpt.GetSecondHeaderLBA();
+   info->block_size = gpt.GetBlockSize();
+}
+
+int ReadPartition(const char *path, uint32_t partitionNumber,
+                  kernarium_gptfdisk_partition_info *info,
+                  char *error, size_t errorSize) {
+   KernariumGPTData gpt;
+   uint32_t index = 0;
+   const int result = Load(path, partitionNumber, &gpt, &index, error, errorSize);
+   if (result != KERNARIUM_GPTFDISK_OK)
+      return result;
+   FillInfo(gpt, index, info);
+   SetError(error, errorSize, "");
+   return KERNARIUM_GPTFDISK_OK;
+}
+
+int GrowPartition(const char *path, uint32_t partitionNumber,
+                  uint64_t trailingFreeBytes,
+                  kernarium_gptfdisk_partition_info *info,
+                  char *error, size_t errorSize) {
+   KernariumGPTData gpt;
+   uint32_t index = 0;
+   int result = Load(path, partitionNumber, &gpt, &index, error, errorSize);
+   if (result != KERNARIUM_GPTFDISK_OK)
+      return result;
+
+   const uint32_t blockSize = gpt.GetBlockSize();
+   if ((blockSize == 0) || (trailingFreeBytes < blockSize) ||
+       ((trailingFreeBytes % blockSize) != 0)) {
+      SetError(error, errorSize,
+               "trailing free space must be a positive multiple of the block size");
+      return KERNARIUM_GPTFDISK_INVALID_ARGUMENT;
+   }
+
+   const uint64_t oldBackupHeader = gpt.GetSecondHeaderLBA();
+   gpt.MoveSecondHeaderToEnd();
+   const uint64_t trailingLBAs = trailingFreeBytes / blockSize;
+   if (gpt.GetSecondHeaderLBA() <= trailingLBAs) {
+      SetError(error, errorSize, "disk image is too small for the requested GPT layout");
+      return KERNARIUM_GPTFDISK_INVALID_ARGUMENT;
+   }
+   const uint64_t desiredLastLBA = gpt.GetSecondHeaderLBA() - trailingLBAs;
+   const uint64_t currentLastLBA = gpt[index].GetLastLBA();
+   if (desiredLastLBA < currentLastLBA) {
+      SetError(error, errorSize, "GPT partition resizing would shrink existing data");
+      return KERNARIUM_GPTFDISK_WOULD_SHRINK;
+   }
+   if (desiredLastLBA > gpt.GetLastUsableLBA()) {
+      SetError(error, errorSize, "requested partition end exceeds usable GPT space");
+      return KERNARIUM_GPTFDISK_INVALID_ARGUMENT;
+   }
+
+   for (uint32_t other = 0; other < gpt.GetNumParts(); other++) {
+      if ((other == index) || !gpt.PartitionIsUsed(other))
+         continue;
+      if ((gpt[other].GetFirstLBA() <= desiredLastLBA) &&
+          (gpt[other].GetLastLBA() >= gpt[index].GetFirstLBA())) {
+         SetError(error, errorSize, "growing partition would overlap another GPT partition");
+         return KERNARIUM_GPTFDISK_OVERLAP;
+      }
+   }
+
+   if ((desiredLastLBA != currentLastLBA) &&
+       !gpt.GrowPartition(index, desiredLastLBA)) {
+      SetError(error, errorSize, "could not update requested GPT partition");
+      return KERNARIUM_GPTFDISK_INTERNAL_ERROR;
+   }
+   if ((desiredLastLBA != currentLastLBA) ||
+       (oldBackupHeader != gpt.GetSecondHeaderLBA())) {
+      if (!gpt.SaveGPTData(1)) {
+         SetError(error, errorSize, "could not write resized GPT");
+         return KERNARIUM_GPTFDISK_WRITE_ERROR;
+      }
+   }
+
+   return ReadPartition(path, partitionNumber, info, error, errorSize);
+}
+
+} // namespace
+
+int kernarium_gptfdisk_read_partition(
+   const char *path, uint32_t partition_number,
+   kernarium_gptfdisk_partition_info *info, char *error, size_t error_size) {
+   std::lock_guard<std::mutex> lock(gptfdiskMutex);
+   ScopedOutputCapture capture;
+   try {
+      return ReadPartition(path, partition_number, info, error, error_size);
+   } catch (const std::exception &exception) {
+      SetError(error, error_size, exception.what());
+   } catch (...) {
+      SetError(error, error_size, "unexpected GPT fdisk failure");
+   }
+   return KERNARIUM_GPTFDISK_INTERNAL_ERROR;
+}
+
+int kernarium_gptfdisk_grow_partition_to_fill(
+   const char *path, uint32_t partition_number, uint64_t trailing_free_bytes,
+   kernarium_gptfdisk_partition_info *info, char *error, size_t error_size) {
+   std::lock_guard<std::mutex> lock(gptfdiskMutex);
+   ScopedOutputCapture capture;
+   try {
+      return GrowPartition(path, partition_number, trailing_free_bytes, info,
+                           error, error_size);
+   } catch (const std::exception &exception) {
+      SetError(error, error_size, exception.what());
+   } catch (...) {
+      SetError(error, error_size, "unexpected GPT fdisk failure");
+   }
+   return KERNARIUM_GPTFDISK_INTERNAL_ERROR;
+}
diff --git a/kernarium_gptfdisk.h b/kernarium_gptfdisk.h
new file mode 100644
index 0000000000000000000000000000000000000000..f1769e3fe67228c4cabb6f8f3108d66aa6b14587
--- /dev/null
+++ b/kernarium_gptfdisk.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#ifndef KERNARIUM_GPTFDISK_H
+#define KERNARIUM_GPTFDISK_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+   KERNARIUM_GPTFDISK_OK = 0,
+   KERNARIUM_GPTFDISK_INVALID_ARGUMENT = 1,
+   KERNARIUM_GPTFDISK_IO_ERROR = 2,
+   KERNARIUM_GPTFDISK_INVALID_GPT = 3,
+   KERNARIUM_GPTFDISK_INVALID_PARTITION = 4,
+   KERNARIUM_GPTFDISK_WOULD_SHRINK = 5,
+   KERNARIUM_GPTFDISK_OVERLAP = 6,
+   KERNARIUM_GPTFDISK_WRITE_ERROR = 7,
+   KERNARIUM_GPTFDISK_INTERNAL_ERROR = 8,
+};
+
+typedef struct kernarium_gptfdisk_partition_info {
+   uint64_t disk_lbas;
+   uint64_t first_lba;
+   uint64_t last_lba;
+   uint64_t backup_header_lba;
+   uint32_t block_size;
+} kernarium_gptfdisk_partition_info;
+
+int kernarium_gptfdisk_read_partition(
+   const char *path,
+   uint32_t partition_number,
+   kernarium_gptfdisk_partition_info *info,
+   char *error,
+   size_t error_size);
+
+int kernarium_gptfdisk_grow_partition_to_fill(
+   const char *path,
+   uint32_t partition_number,
+   uint64_t trailing_free_bytes,
+   kernarium_gptfdisk_partition_info *info,
+   char *error,
+   size_t error_size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
