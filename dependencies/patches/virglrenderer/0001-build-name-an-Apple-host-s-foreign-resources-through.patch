From 000b8339e1c120f3f8ea3cc265fe414f7d018a5c Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 13 Sep 2026 23:51:15 +0900
Subject: [PATCH 01/50] build: name an Apple host's foreign resources through
 Metal

An Apple host has neither GBM nor dma-buf, so a blob another renderer
context exported is named by a Metal object or by an anonymous
shared-memory file rather than by a DRM handle. The renderer needs the
Metal framework to hold and compare those names, and it needs a
configuration flag it can compile that code against.

Detect the framework on Darwin and publish ENABLE_METAL, so the Venus
and vrend paths that carry Apple-native resource handles compile only
where those handles exist.
---
 config.h.meson    |  1 +
 meson.build       | 11 +++++++++++
 src/meson.build   |  7 +++++++
 src/virgl_metal.h | 19 +++++++++++++++++++
 src/virgl_metal.m | 22 ++++++++++++++++++++++
 5 files changed, 60 insertions(+)
 create mode 100644 src/virgl_metal.h
 create mode 100644 src/virgl_metal.m

diff --git a/config.h.meson b/config.h.meson
index 3f894fd4..d32d76aa 100644
--- a/config.h.meson
+++ b/config.h.meson
@@ -45,6 +45,7 @@
 #mesondefine ENABLE_DRM_PANFROST
 #mesondefine ENABLE_DRM_I915
 #mesondefine ENABLE_LIBDRM
+#mesondefine ENABLE_METAL
 #mesondefine ENABLE_RENDER_SERVER
 #mesondefine ENABLE_SAME_PROCESS_RENDER_SERVER
 #mesondefine ENABLE_RENDER_SERVER_WORKER_PROCESS
diff --git a/meson.build b/meson.build
index 235d7986..18e8b7a2 100644
--- a/meson.build
+++ b/meson.build
@@ -219,6 +219,17 @@ if cc.has_header('linux/udmabuf.h')
    conf_data.set('HAVE_LINUX_UDMABUF_H', 1)
 endif
 
+# An Apple host has no GBM and no dma-buf: a resource another context exported
+# is named by a Metal object or by an anonymous shared-memory file instead, and
+# the renderer needs the Metal framework to hold and compare those names.
+metal_dep = not_found
+if with_host_darwin
+   metal_dep = dependency('appleframeworks', modules : ['Metal'], required : false)
+   if metal_dep.found()
+      conf_data.set('ENABLE_METAL', 1)
+   endif
+endif
+
 foreach b : ['bswap32', 'bswap64', 'clz', 'clzll', 'expect', 'ffs', 'ffsll',
              'popcount', 'popcountll', 'types_compatible_p', 'unreachable']
   if cc.has_function(b)
diff --git a/src/meson.build b/src/meson.build
index f4a2272d..c9567159 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -216,6 +216,13 @@ if with_venus and gbm_dep.found()
    virgl_sources += vrend_venus_interop_sources
 endif
 
+if metal_dep.found()
+   virgl_sources += ['virgl_metal.m']
+   # Foundation carries the Objective-C runtime the retain/release helpers use.
+   virgl_depends += [metal_dep,
+                     dependency('appleframeworks', modules : ['Foundation'])]
+endif
+
 if with_venus
    virgl_sources += venus_sources
    virgl_sources += venus_codegen
diff --git a/src/virgl_metal.h b/src/virgl_metal.h
new file mode 100644
index 00000000..e1894e4c
--- /dev/null
+++ b/src/virgl_metal.h
@@ -0,0 +1,19 @@
+/*
+ * Copyright 2026 Yi Xie
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef VIRGL_METAL_H
+#define VIRGL_METAL_H
+
+/*
+ * An Apple host names a foreign resource with a Metal object -- a MTLHeap a
+ * Vulkan renderer exported, or a MTLTexture a presenter will scan out -- and
+ * that name has to outlive the guest-visible file descriptor it travels
+ * beside. Retain and release it without naming its Objective-C type, so the
+ * C sources that only pass the name around need no Objective-C at all.
+ */
+void *virgl_metal_retain_object(void *object);
+
+void virgl_metal_release_object(void *object);
+
+#endif /* VIRGL_METAL_H */
diff --git a/src/virgl_metal.m b/src/virgl_metal.m
new file mode 100644
index 00000000..214cc92f
--- /dev/null
+++ b/src/virgl_metal.m
@@ -0,0 +1,22 @@
+/*
+ * Copyright 2026 Yi Xie
+ * SPDX-License-Identifier: MIT
+ */
+
+#import <Foundation/Foundation.h>
+
+#include "virgl_metal.h"
+
+void *virgl_metal_retain_object(void *object)
+{
+   id metal_object = (id)object;
+
+   return [metal_object retain];
+}
+
+void virgl_metal_release_object(void *object)
+{
+   id metal_object = (id)object;
+
+   [metal_object release];
+}
