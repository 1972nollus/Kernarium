+static void
+vkr_dispatch_vkCreatePipelineBinariesKHR(
+   struct vn_dispatch_context *dispatch,
+   struct vn_command_vkCreatePipelineBinariesKHR *args)
+{
+   TRACE_FUNC();
+   struct vkr_context *ctx = dispatch->data;
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   struct object_array arr;
+
+   /* The count is an in-out parameter, and the driver asks how many binaries
+    * a pipeline has before it names any, so a query carries no handles and
+    * creates no objects. */
+   if (!args->pBinaries->pPipelineBinaries) {
+      vn_replace_vkCreatePipelineBinariesKHR_args_handle(args);
+      args->ret = vk->CreatePipelineBinariesKHR(args->device, args->pCreateInfo, NULL,
+                                                args->pBinaries);
+      return;
+   }
+
+   const uint32_t count = args->pBinaries->pipelineBinaryCount;
+   if (!object_array_init(ctx, &arr, count, VK_OBJECT_TYPE_PIPELINE_BINARY_KHR,
+                          sizeof(struct vkr_pipeline_binary),
+                          sizeof(*args->pBinaries->pPipelineBinaries),
+                          args->pBinaries->pPipelineBinaries)) {
+      args->ret = VK_ERROR_OUT_OF_HOST_MEMORY;
+      return;
+   }
+
+   VkPipelineBinaryHandlesInfoKHR handles = *args->pBinaries;
+   handles.pPipelineBinaries = arr.handle_storage;
+
+   vn_replace_vkCreatePipelineBinariesKHR_args_handle(args);
+   args->ret =
+      vk->CreatePipelineBinariesKHR(args->device, args->pCreateInfo, NULL, &handles);
+   if (args->ret != VK_SUCCESS && args->ret != VK_INCOMPLETE) {
+      object_array_fini(&arr);
+      return;
+   }
+
+   /* The driver may have produced fewer binaries than the guest offered
+    * handles for; the objects it did not fill are not created. */
+   args->pBinaries->pipelineBinaryCount = handles.pipelineBinaryCount;
+
+   for (uint32_t i = 0; i < count; i++) {
+      struct vkr_pipeline_binary *obj = arr.objects[i];
+
+      obj->base.handle.pipeline_binary =
+         i < handles.pipelineBinaryCount
+            ? ((VkPipelineBinaryKHR *)arr.handle_storage)[i]
+            : VK_NULL_HANDLE;
+
+      if (obj->base.handle.pipeline_binary == VK_NULL_HANDLE) {
+         free(obj);
+         arr.objects[i] = NULL;
+         args->pBinaries->pPipelineBinaries[i] = VK_NULL_HANDLE;
+      } else {
+         vkr_device_add_object(ctx, dev, &obj->base);
+      }
+   }
+
+   arr.objects_stolen = true;
+   object_array_fini(&arr);
+}
+
+static void
+vkr_dispatch_vkDestroyPipelineBinaryKHR(
+   struct vn_dispatch_context *dispatch,
+   struct vn_command_vkDestroyPipelineBinaryKHR *args)
+{
+   struct vkr_context *ctx = dispatch->data;
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   struct vkr_pipeline_binary *obj =
+      vkr_pipeline_binary_from_handle(args->pipelineBinary);
+   if (!obj)
+      return;
+
+   vn_replace_vkDestroyPipelineBinaryKHR_args_handle(args);
+   vk->DestroyPipelineBinaryKHR(args->device, args->pipelineBinary, NULL);
+
+   vkr_device_remove_object(ctx, dev, &obj->base);
+}
+
+static void
+vkr_dispatch_vkGetPipelineKeyKHR(UNUSED struct vn_dispatch_context *dispatch,
+                                 struct vn_command_vkGetPipelineKeyKHR *args)
+{
+   TRACE_FUNC();
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+
+   /* A pipeline key is derived from the pipeline create info the caller
+    * chains onto VkPipelineCreateInfoKHR, and the driver reads that chain
+    * without checking it.  The protocol carries the chain, so a request that
+    * still arrives empty is one the driver cannot be handed.  Only a key for
+    * the device itself names no pipeline, and the specification does not give
+    * this command such a form.  VK_ERROR_UNKNOWN, not one of the
+    * out-of-memory codes the command otherwise returns: an out-of-memory
+    * result tells a caller that retrying may work and makes a test suite
+    * abandon its whole run, while this request can never be served. */
+   if (args->pPipelineCreateInfo == NULL ||
+       args->pPipelineCreateInfo->pNext == NULL) {
+      args->ret = VK_ERROR_UNKNOWN;
+      return;
+   }
+
+   vn_replace_vkGetPipelineKeyKHR_args_handle(args);
+   args->ret = vk->GetPipelineKeyKHR(args->device, args->pPipelineCreateInfo,
+                                     args->pPipelineKey);
+}
+
+static void
+vkr_dispatch_vkGetPipelineBinaryDataKHR(
+   UNUSED struct vn_dispatch_context *dispatch,
+   struct vn_command_vkGetPipelineBinaryDataKHR *args)
+{
+   TRACE_FUNC();
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+
+   /* The data size is in-out, and this is the one command whose out value can
+    * exceed the in value: a buffer smaller than the binary is answered with
+    * VK_ERROR_NOT_ENOUGH_SPACE_KHR, the size the caller needs, and no data.
+    * The reply's blob is measured by the size the driver reports, while the
+    * room for it was reserved from the size the driver was offered, so a grown
+    * size describes a blob neither side has: it runs past the reply region the
+    * guest set and past the guest's own buffer.  The specification writes no
+    * data in that case, so the reply carries no blob and the guest reads only
+    * the size it asked for.
+    */
+   const size_t offered =
+      args->pPipelineBinaryDataSize ? *args->pPipelineBinaryDataSize : 0;
+
+   vn_replace_vkGetPipelineBinaryDataKHR_args_handle(args);
+   args->ret = vk->GetPipelineBinaryDataKHR(args->device, args->pInfo,
+                                            args->pPipelineBinaryKey,
+                                            args->pPipelineBinaryDataSize,
+                                            args->pPipelineBinaryData);
+
+   if (args->pPipelineBinaryData && *args->pPipelineBinaryDataSize > offered)
+      args->pPipelineBinaryData = NULL;
+}
+
+static void
+vkr_dispatch_vkReleaseCapturedPipelineDataKHR(
+   UNUSED struct vn_dispatch_context *dispatch,
+   struct vn_command_vkReleaseCapturedPipelineDataKHR *args)
+{
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+
+   vn_replace_vkReleaseCapturedPipelineDataKHR_args_handle(args);
+   args->ret = vk->ReleaseCapturedPipelineDataKHR(args->device, args->pInfo, NULL);
+}
+
 void
 vkr_context_init_shader_module_dispatch(struct vkr_context *ctx)
 {
@@ -247,3 +404,19 @@ vkr_context_init_pipeline_dispatch(struct vkr_context *ctx)
    dispatch->dispatch_vkGetRayTracingShaderGroupStackSizeKHR =
       vkr_dispatch_vkGetRayTracingShaderGroupStackSizeKHR;
 }
+
+void
+vkr_context_init_pipeline_binary_dispatch(struct vkr_context *ctx)
+{
+   struct vn_dispatch_context *dispatch = &ctx->dispatch;
+
+   dispatch->dispatch_vkCreatePipelineBinariesKHR =
+      vkr_dispatch_vkCreatePipelineBinariesKHR;
+   dispatch->dispatch_vkDestroyPipelineBinaryKHR =
+      vkr_dispatch_vkDestroyPipelineBinaryKHR;
+   dispatch->dispatch_vkGetPipelineKeyKHR = vkr_dispatch_vkGetPipelineKeyKHR;
+   dispatch->dispatch_vkGetPipelineBinaryDataKHR =
+      vkr_dispatch_vkGetPipelineBinaryDataKHR;
+   dispatch->dispatch_vkReleaseCapturedPipelineDataKHR =
+      vkr_dispatch_vkReleaseCapturedPipelineDataKHR;
+}
