From 8f2485b3afff5738bd816901b94ee22370bc0af2 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 23 Aug 2026 06:27:17 +0900
Subject: [PATCH 02/49] venus: require an explicit Darwin Vulkan provider

---
 meson.build              | 10 ++++++++++
 meson_options.txt        | 14 ++++++++++++++
 src/venus/vkr_instance.c | 10 +++++++---
 3 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/meson.build b/meson.build
index 18e8b7a..ced2650 100644
--- a/meson.build
+++ b/meson.build
@@ -383,6 +383,16 @@ if with_venus
    venus_dep = [dep_venus_protocol]
    if get_option('vulkan-dload')
       conf_data.set('ENABLE_VULKAN_DLOAD', 1)
+   elif with_host_darwin
+      vulkan_include_dir = get_option('vulkan-include-dir')
+      vulkan_library_file = get_option('vulkan-library-file')
+      if vulkan_include_dir == '' or vulkan_library_file == ''
+         error('Darwin Venus requires explicit Vulkan headers and provider binary')
+      endif
+      venus_dep += declare_dependency(
+         compile_args : ['-I' + vulkan_include_dir],
+         link_args : [vulkan_library_file],
+      )
    else
       venus_dep += dependency('vulkan')
    endif
diff --git a/meson_options.txt b/meson_options.txt
index 9d2955d..c594cb5 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -52,6 +52,20 @@ option(
   description : 'enable loading libvulkan dynamically at runtime instead of linking to it at build-time'
 )
 
+option(
+  'vulkan-include-dir',
+  type : 'string',
+  value : '',
+  description : 'authenticated Vulkan include directory for a directly linked Darwin provider'
+)
+
+option(
+  'vulkan-library-file',
+  type : 'string',
+  value : '',
+  description : 'authenticated Vulkan provider binary for a directly linked Darwin provider'
+)
+
 option(
   'vulkan-preload',
   type : 'boolean',
diff --git a/src/venus/vkr_instance.c b/src/venus/vkr_instance.c
index d90f6cb..8191b37 100644
--- a/src/venus/vkr_instance.c
+++ b/src/venus/vkr_instance.c
@@ -198,11 +198,15 @@ vkr_dispatch_vkCreateInstance(struct vn_dispatch_context *dispatch,
    }
 
 #ifdef __APPLE__
+   /* A directly linked portability implementation does not necessarily expose
+    * the loader-owned VK_KHR_portability_enumeration extension.  The flag is
+    * still harmless and required when a loader is introduced by an embedder;
+    * enable the extension itself only when the selected provider advertises
+    * it. */
+   create_info->flags |= VK_INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR;
    if (vkr_library_has_portability_enumeration(
-          vk->EnumerateInstanceExtensionProperties)) {
-      create_info->flags |= VK_INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR;
+          vk->EnumerateInstanceExtensionProperties))
       ext_names[ext_count++] = VK_KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME;
-   }
 
    /* The Metal shared-memory allocator exports the underlying MTLDevice via
     * vkExportMetalObjectsEXT (see vkr_metal_get_device).  VK_EXT_metal_objects
