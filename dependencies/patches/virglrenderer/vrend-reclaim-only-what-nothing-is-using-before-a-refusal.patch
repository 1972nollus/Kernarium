From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 9 Nov 2026 11:12:32 +0900
Subject: [PATCH] vrend: reclaim only what nothing is using before a refusal

When the host driver refuses a resource's storage, the renderer gave
back what every context held for completed work and everything the host
drivers cached, then made the resource once more. A context that is
still drawing frees its batch states and buffers at every submission
and takes them again for the next frame, so the reclaim freed storage
that context allocated again at once: the retried resource took the
room, the context's storage came back, and an Android guest drawing
WebGL at the full budget went past it by about 100 MiB.

virgl_renderer_set_context_quiet_query() gives the renderer the host's
word on which contexts are quiet, nothing having run on them for a
while and no fence of theirs outstanding. The reclaim flushes, finishes
and trims only those, frees only the shared-memory segments whose
fences have signalled, and asks the host drivers only for what they
have cached and not used for a second (VKR_CACHED_MEMORY_IDLE_NS for
the Vulkan devices' command storage). A refusal then stays a refusal
for a workload that is drawing. Without a query every context is
visited, as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/venus/vkr_renderer.c   |  2 +-
 src/venus/vkr_renderer.h   | 10 ++++++--
 src/virglrenderer.c        | 14 +++++++++++
 src/virglrenderer.h        | 13 ++++++++++
 src/vrend/vrend_renderer.c | 50 ++++++++++++++++++++++++++------------
 src/vrend/vrend_renderer.h |  3 +++
 6 files changed, 74 insertions(+), 18 deletions(-)

diff --git a/src/venus/vkr_renderer.c b/src/venus/vkr_renderer.c
index 8936b38d60ff6d15f185e18b9b996780cb74923e..a8486d004a551eeb953ab3902a75e283d877d5e8 100644
--- a/src/venus/vkr_renderer.c
+++ b/src/venus/vkr_renderer.c
@@ -144,7 +144,7 @@ vkr_renderer_get_imported_host_memory(void)
 uint64_t
 vkr_renderer_release_cached_memory(void)
 {
-   return kk_release_cached_memory();
+   return kk_release_idle_cached_memory(VKR_CACHED_MEMORY_IDLE_NS);
 }
 
 uint64_t
diff --git a/src/venus/vkr_renderer.h b/src/venus/vkr_renderer.h
index a5815912cb918406ace6dd96c1a6242db51df57d..da6106e3dc0098750896116d68e7208982c46b9a 100644
--- a/src/venus/vkr_renderer.h
+++ b/src/venus/vkr_renderer.h
@@ -87,8 +87,14 @@ vkr_renderer_get_device_memory_headroom(void);
 uint64_t
 vkr_renderer_get_imported_host_memory(void);
 
-/* Frees what the process's Vulkan devices keep for reuse and no recording
- * holds, and returns how many bytes that gave back. Takes no lock of a device.
+/* How long the process's Vulkan devices must have kept storage for reuse
+ * before a reclaim frees it: a device that is still recording takes it again
+ * within a frame or two. */
+#define VKR_CACHED_MEMORY_IDLE_NS (1000ull * 1000 * 1000)
+
+/* Frees what the process's Vulkan devices keep for reuse and have not used
+ * for VKR_CACHED_MEMORY_IDLE_NS, and returns how many bytes that gave back.
+ * Takes no lock of a device.
  */
 uint64_t
 vkr_renderer_release_cached_memory(void);
diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index 083774c3ffc08a6f511d0d83be0727b8076efac6..e5abea2d435442ccf5bdc28fd0eda78f228b5cbd 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -492,6 +492,20 @@ void virgl_renderer_context_poll(uint32_t ctx_id)
    ctx->retire_fences(ctx);
 }
 
+void
+virgl_renderer_set_context_quiet_query(bool (*quiet)(void *data,
+                                                     uint32_t ctx_id),
+                                       void *data)
+{
+   TRACE_FUNC();
+#ifdef ENABLE_VREND
+   vrend_renderer_set_context_quiet_query(quiet, data);
+#else
+   (void)quiet;
+   (void)data;
+#endif
+}
+
 void virgl_renderer_context_trim(uint32_t ctx_id)
 {
    TRACE_FUNC();
diff --git a/src/virglrenderer.h b/src/virglrenderer.h
index 9335e0ce538787484b4fc3257d6f0030ee5d8c17..49c22f5ed98560b693d64e7bdcabecac258cae32 100644
--- a/src/virglrenderer.h
+++ b/src/virglrenderer.h
@@ -506,6 +506,19 @@ VIRGL_EXPORT int virgl_renderer_context_get_poll_fd(uint32_t ctx_id);
  * thread that runs the renderer. */
 VIRGL_EXPORT void virgl_renderer_context_trim(uint32_t ctx_id);
 
+/* Tell the renderer how to learn which contexts the host finds quiet: nothing
+ * ran on them for a while and no fence they asked for is outstanding.  When
+ * the host driver refuses a resource's storage, the renderer gives back what
+ * its quiet contexts hold for completed work and what the host drivers have
+ * cached and not used for a while, and makes the resource once more; a
+ * context that is still drawing keeps its storage.  Without a query every
+ * context is visited.  `quiet` runs on the thread that runs the renderer,
+ * with no lock of the renderer held; NULL clears it. */
+VIRGL_EXPORT void
+virgl_renderer_set_context_quiet_query(bool (*quiet)(void *data,
+                                                     uint32_t ctx_id),
+                                       void *data);
+
 /* Map a resource to an specific userspace address. If successful, the
  * mapping is owned by the caller and is its responsibility to unmap
  * the resource by its own means (i.e. overriding the map with
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index de9472ddd03a793a7356ca0825881be246d5bc1f..abad7c183ae1e4fcc353b9820e57240aa9c441ae 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -13409,9 +13409,23 @@ static uint64_t vrend_monotonic_ns(void)
    return (uint64_t)now.tv_sec * 1000000000ull + (uint64_t)now.tv_nsec;
 }
 
-/* Runs `fn` once for each GL context of every vrend context, with that GL
- * context current, and leaves current what was current when it was called.
- * A context in error has no GL context to use and is skipped. */
+/* The host's word on which contexts are quiet, which a reclaim asks before it
+ * visits a context; without it every context is visited. */
+static bool (*vrend_context_quiet)(void *data, uint32_t ctx_id);
+static void *vrend_context_quiet_data;
+
+void vrend_renderer_set_context_quiet_query(bool (*quiet)(void *data,
+                                                          uint32_t ctx_id),
+                                            void *data)
+{
+   vrend_context_quiet = quiet;
+   vrend_context_quiet_data = quiet ? data : NULL;
+}
+
+/* Runs `fn` once for each GL context of every vrend context the host finds
+ * quiet, with that GL context current, and leaves current what was current
+ * when it was called.  A context in error has no GL context to use and is
+ * skipped. */
 static void vrend_for_each_gl_context(void (*fn)(void))
 {
    struct vrend_context *current = vrend_state.current_ctx;
@@ -13419,6 +13433,9 @@ static void vrend_for_each_gl_context(void (*fn)(void))
    list_for_each_entry(struct vrend_context, ctx, &vrend_state.contexts, all_head) {
       if (!ctx->sub || (ctx->ctx_id != 0 && ctx->in_error))
          continue;
+      if (vrend_context_quiet &&
+          !vrend_context_quiet(vrend_context_quiet_data, ctx->ctx_id))
+         continue;
 
       struct vrend_sub_context *selected = ctx->sub;
       list_for_each_entry(struct vrend_sub_context, sub, &ctx->sub_ctxs, head) {
@@ -13452,17 +13469,19 @@ static void vrend_reclaim_trim(void)
 #endif
 }
 
-/* Gives back everything the renderer can reach that holds storage for work
- * that has completed or is about to: it flushes every GL context so that what
- * glthread and the threaded context still queue (the deletes of resources the
- * guest has released among it) reaches the driver, waits for the GPU to
- * finish that work, trims every context so the driver drops the references
- * its completed batches kept, frees the shared-memory segments that were
- * waiting behind a fence (the GPU is idle now, as that drain requires), and
- * then asks the host drivers to free what they cache for reuse.  Returns
- * false when a reclaim a moment ago did not help and nothing has been
- * destroyed since: there is nothing new to give back.  The host then waits,
- * for a moment at most, for what was freed to count in its budget. */
+/* Gives back what the renderer can reach that holds storage for work that has
+ * completed or is about to, and that nothing is using: it flushes every GL
+ * context of a quiet vrend context so that what glthread and the threaded
+ * context still queue (the deletes of resources the guest has released among
+ * it) reaches the driver, waits for the GPU to finish that work, trims those
+ * contexts so the driver drops the references their completed batches kept,
+ * frees the shared-memory segments whose fences have signalled, and then asks
+ * the host drivers to free what they cache and have not used for a while.
+ * A context that is still drawing keeps its storage: it would allocate it
+ * again at once, past the refusal.  Returns false when a reclaim a moment ago
+ * did not help and nothing has been destroyed since: there is nothing new to
+ * give back.  The host then waits, for a moment at most, for what was freed
+ * to count in its budget. */
 static bool vrend_reclaim_host_memory(void)
 {
    if (vrend_state.reclaim_futile_ns &&
@@ -13475,7 +13494,8 @@ static bool vrend_reclaim_host_memory(void)
    vrend_for_each_gl_context(vrend_reclaim_flush);
    vrend_for_each_gl_context(vrend_reclaim_finish);
    vrend_for_each_gl_context(vrend_reclaim_trim);
-   vrend_drain_retired_shm(true);
+   /* Only the contexts the host found quiet were finished. */
+   vrend_drain_retired_shm(!vrend_context_quiet);
 #ifdef HAVE_EPOXY_EGL_H
    virgl_egl_release_cached_memory(egl);
 #endif
