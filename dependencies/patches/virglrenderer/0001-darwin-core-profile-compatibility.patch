+/*
+ * Mesa exposes VAProfileNone for its shader-based video post-processing even
+ * when the virgl capset advertises no hardware codecs.  Its virgl driver then
+ * wraps the ordinary plane resources in CREATE/DESTROY_VIDEO_BUFFER commands.
+ * A renderer without a VA backend has no host video surface to create, and
+ * none is needed for that guest-side shader path.  Accept just the validated
+ * buffer lifecycle while continuing to reject every codec and frame command.
+ */
+static int vrend_decode_no_video_create_buffer(struct vrend_context *ctx,
+                                               const uint32_t *buf,
+                                               uint32_t length)
+{
+   (void)ctx;
+   (void)buf;
+   return length < VIRGL_CREATE_VIDEO_BUFFER_MIN_SIZE ? EINVAL : 0;
+}
+
+static int vrend_decode_no_video_destroy_buffer(struct vrend_context *ctx,
+                                                const uint32_t *buf,
+                                                uint32_t length)
+{
+   (void)ctx;
+   (void)buf;
+   return length < VIRGL_DESTROY_VIDEO_BUFFER_MIN_SIZE ? EINVAL : 0;
+}
