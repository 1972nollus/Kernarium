From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 27 Sep 2026 14:02:27 +0900
Subject: [PATCH] vrend: refuse a sub-context the host cannot give a GL context

vrend_renderer_create_sub_ctx() took whatever create_gl_context() returned
and went on. When the host could not create the context, it made the null
context current, which releases the thread's current context rather than
failing, then issued GL on a thread with none and registered the
sub-context with no context behind it. Every later command decoded on
that sub-context ran the same way. A guest context whose creation failed
this way reached get_glsl_version() with nothing current before it could
report the failure, and a failed CREATE_SUB_CTX reported success.

Return whether the sub-context exists. A failed CREATE_SUB_CTX now fails
its command with ENOMEM, abandoning the rest of that buffer, and leaves the
guest context on its current sub-context. A guest context whose first
sub-context cannot be created fails its creation and releases what it had
set up, since vrend_destroy_context() needs a sub-context to make current.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/vrend/vrend_decode.c   |  4 +++-
 src/vrend/vrend_renderer.c | 30 ++++++++++++++++++++++++++----
 src/vrend/vrend_renderer.h |  2 +-
 3 files changed, 30 insertions(+), 6 deletions(-)

diff --git a/src/vrend/vrend_decode.c b/src/vrend/vrend_decode.c
index f70eda6f737e2fab568d98813ebed5182f304e32..a2bd100ba1820a833bed30040e0c7606ca57ca0b 100644
--- a/src/vrend/vrend_decode.c
+++ b/src/vrend/vrend_decode.c
@@ -1232,7 +1232,9 @@ static int vrend_decode_create_sub_ctx(struct vrend_context *ctx, const uint32_t
 
    uint32_t ctx_sub_id = get_buf_entry(buf, 1);
 
-   vrend_renderer_create_sub_ctx(ctx, ctx_sub_id);
+   /* The guest's request is well formed; the host could not serve it. */
+   if (!vrend_renderer_create_sub_ctx(ctx, ctx_sub_id))
+      return ENOMEM;
    return 0;
 }
 
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 7bba85f7932e498b7f1c31f9d1f62735d05bb351..7168c37eb0e0052ce21a080785faea4425656a54 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -8476,7 +8476,17 @@ struct vrend_context *vrend_create_context(int id, uint32_t nlen, const char *de
    grctx->shader_cfg.has_vs_layer = has_feature(feat_vs_layer_viewport);
    grctx->shader_cfg.has_vs_viewport_index = has_feature(feat_vs_viewport_index);
 
-   vrend_renderer_create_sub_ctx(grctx, 0);
+   if (!vrend_renderer_create_sub_ctx(grctx, 0)) {
+      /* With no sub-context there is nothing vrend_destroy_context() could
+       * make current, so undo only what was set up above.
+       */
+#ifdef ENABLE_VIDEO
+      vrend_video_destroy_context(grctx->video);
+#endif
+      vrend_ctx_resource_fini_table(grctx->res_hash);
+      FREE(grctx);
+      return NULL;
+   }
    vrend_renderer_set_sub_ctx(grctx, 0);
 
    int glver = get_glsl_version();
@@ -13972,26 +13982,37 @@ void vrend_renderer_get_cap_set(uint32_t cap_set, uint32_t *max_ver,
    }
 }
 
-void vrend_renderer_create_sub_ctx(struct vrend_context *ctx, int sub_ctx_id)
+bool vrend_renderer_create_sub_ctx(struct vrend_context *ctx, int sub_ctx_id)
 {
    struct virgl_gl_ctx_param ctx_params;
    GLuint i;
 
    list_for_each_entry(struct vrend_sub_context, sub, &ctx->sub_ctxs, head) {
       if (sub->sub_ctx_id == sub_ctx_id) {
-         return;
+         return true;
       }
    }
 
    struct vrend_sub_context *sub = CALLOC_STRUCT(vrend_sub_context);
    if (!sub)
-      return;
+      return false;
 
    ctx_params.shared = (ctx->ctx_id == 0 && sub_ctx_id == 0) ? false : true;
    ctx_params.major_ver = vrend_state.gl_major_ver;
    ctx_params.minor_ver = vrend_state.gl_minor_ver;
    ctx_params.compat_ctx = !vrend_state.use_core_profile && !vrend_state.use_gles;
    sub->gl_context = vrend_clicbs->create_gl_context(0, &ctx_params);
+   if (!sub->gl_context) {
+      /* Every GL call below, and every command later decoded on this
+       * sub-context, needs a current GL context. Making the missing one
+       * current would release the thread's context instead, and the
+       * renderer would go on issuing GL on a thread with none.
+       */
+      virgl_error("context %d: host GL context for sub-context %d unavailable\n",
+                  ctx->ctx_id, sub_ctx_id);
+      FREE(sub);
+      return false;
+   }
    sub->parent = ctx;
    vrend_clicbs->make_current(sub->gl_context);
 
@@ -14038,6 +14059,7 @@ void vrend_renderer_create_sub_ctx(struct vrend_context *ctx, int sub_ctx_id)
       ctx->sub0 = sub;
 
    vrend_set_tweak_from_env(&ctx->sub->tweaks);
+   return true;
 }
 
 unsigned vrend_context_has_debug_flag(const struct vrend_context *ctx, enum virgl_debug_flags flag)
diff --git a/src/vrend/vrend_renderer.h b/src/vrend/vrend_renderer.h
index a8072a9286e3794ec62036a316d0d115bfbdf2fa..f90870f13a8979eb773d464078ce855aee7a4959 100644
--- a/src/vrend/vrend_renderer.h
+++ b/src/vrend/vrend_renderer.h
@@ -604,7 +604,7 @@ void vrend_renderer_resource_get_info(struct pipe_resource *pres,
 void vrend_renderer_get_cap_set(uint32_t cap_set, uint32_t *max_ver,
                                 uint32_t *max_size);
 
-void vrend_renderer_create_sub_ctx(struct vrend_context *ctx, int sub_ctx_id);
+bool vrend_renderer_create_sub_ctx(struct vrend_context *ctx, int sub_ctx_id);
 void vrend_renderer_destroy_sub_ctx(struct vrend_context *ctx, int sub_ctx_id);
 void vrend_renderer_set_sub_ctx(struct vrend_context *ctx, int sub_ctx_id);
 
