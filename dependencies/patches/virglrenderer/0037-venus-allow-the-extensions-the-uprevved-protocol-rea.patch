From 6475c896ce1a81518e63fcd878cae83aaa353aca Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 12:27:55 +0900
Subject: [PATCH 37/46] venus: allow the extensions the uprevved protocol
 reaches

venus-protocol 1.1.3 gives VK_KHR_maintenance9, VK_KHR_unified_image_layouts
and VK_EXT_vertex_attribute_robustness an extension index and codecs for their
capability structures. None of the three defines a command, so the renderer
carries a device that offers them by forwarding the physical device query,
and the only thing it withheld was a place in the allowlist.

maintenance9 is mandatory in VP_ANDROID_17_requirements and the host driver
this renderer runs on advertises all three.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/venus/vkr_common.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/venus/vkr_common.c b/src/venus/vkr_common.c
index 25634a5..497a672 100644
--- a/src/venus/vkr_common.c
+++ b/src/venus/vkr_common.c
@@ -124,6 +124,7 @@ static const struct vn_info_extension_table vkr_extension_table = {
    .KHR_fragment_shading_rate = true,
    .KHR_maintenance7 = true,
    .KHR_maintenance8 = true,
+   .KHR_maintenance9 = true,
    .KHR_maintenance10 = true,
    .KHR_pipeline_library = true,
    .KHR_ray_query = true,
@@ -139,6 +140,7 @@ static const struct vn_info_extension_table vkr_extension_table = {
    .KHR_shader_relaxed_extended_instruction = true,
    .KHR_shader_subgroup_uniform_control_flow = true,
    .KHR_shader_untyped_pointers = true,
+   .KHR_unified_image_layouts = true,
    .KHR_workgroup_memory_explicit_layout = true,
    /* EXT extensions */
    .EXT_attachment_feedback_loop_dynamic_state = true,
@@ -204,6 +206,7 @@ static const struct vn_info_extension_table vkr_extension_table = {
    .EXT_shader_uniform_buffer_unsized_array = true,
    .EXT_transform_feedback = true,
    .EXT_vertex_attribute_divisor = true,
+   .EXT_vertex_attribute_robustness = true,
    .EXT_vertex_input_dynamic_state = true,
    .EXT_ycbcr_image_arrays = true,
    /* vendor extensions */
