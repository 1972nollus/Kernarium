From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 27 Sep 2026 19:53:22 +0900
Subject: [PATCH] vrend: import a Venus Metal-heap blob from its heap, not its
 name

A Venus context that allocates a swapchain image's memory out of a Metal heap
exports it as a shared-memory file of the right size that only names the
heap: the renderer finds the heap again through that file's identity, and
the file itself holds none of the pixels. The virgl import took it for an
ordinary shared-memory blob, since that is the file type it carries, mapped
it and sampled zeroes, so a Vulkan window under a compositor on Virgl was
black.

Import such a blob from the heap instead. The rows of a linear image or a
buffer are the heap's own bytes, which a buffer placed over the whole
shared-storage heap shows to the CPU; that mapping then takes the ordinary
shared-memory import, aliased where the driver can and copied from before
each read where it cannot. An optimal image's bytes are not rows, so its
texture, which the exporter published for scanout, is read into pages the
resource owns before each read. A blob whose heap cannot be found or read
keeps the previous import.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/virgl_metal.h          |  27 ++++++
 src/virgl_metal.m          |  47 +++++++++
 src/vrend/vrend_renderer.c | 189 +++++++++++++++++++++++++++++++------
 src/vrend/vrend_renderer.h |   7 ++
 4 files changed, 240 insertions(+), 30 deletions(-)

diff --git a/src/virgl_metal.h b/src/virgl_metal.h
index e1894e4c988a40668fc31073517293d106566255..5ff41395ca8d8d84353d18f030928b900d0e685a 100644
--- a/src/virgl_metal.h
+++ b/src/virgl_metal.h
@@ -5,6 +5,9 @@
 #ifndef VIRGL_METAL_H
 #define VIRGL_METAL_H
 
+#include <stdbool.h>
+#include <stdint.h>
+
 /*
  * An Apple host names a foreign resource with a Metal object -- a MTLHeap a
  * Vulkan renderer exported, or a MTLTexture a presenter will scan out -- and
@@ -16,4 +19,28 @@ void *virgl_metal_retain_object(void *object);
 
 void virgl_metal_release_object(void *object);
 
+/*
+ * A blob a Venus context allocated out of a Metal heap keeps its bytes in
+ * that heap; the shared-memory file it travels as only names the heap. A
+ * placement heap with shared storage shows those bytes to the CPU through a
+ * buffer placed over all of it. Return that buffer, with one reference the
+ * caller releases, and its contents and length; NULL where the heap is not
+ * one the CPU can read.
+ */
+void *virgl_metal_heap_map(void *heap, void **contents, uint64_t *length);
+
+/* Whether a texture stores its first level as rows in a buffer, so that the
+ * bytes behind it read as an image without the GPU's help. */
+bool virgl_metal_texture_is_linear(void *texture);
+
+/*
+ * Copy the first level of a texture the CPU can read into rows of
+ * bytes_per_row bytes, whatever its tiling. False where it cannot be read.
+ */
+bool virgl_metal_texture_read(void *texture,
+                              void *destination,
+                              uint32_t bytes_per_row,
+                              uint32_t width,
+                              uint32_t height);
+
 #endif /* VIRGL_METAL_H */
diff --git a/src/virgl_metal.m b/src/virgl_metal.m
index 214cc92fad41187f41186f01d6ae7c5d606a433e..f5ac6f698afdbd8e5171839b4ca6c77fa41a7c70 100644
--- a/src/virgl_metal.m
+++ b/src/virgl_metal.m
@@ -4,6 +4,7 @@
  */
 
 #import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
 
 #include "virgl_metal.h"
 
@@ -20,3 +21,49 @@ void virgl_metal_release_object(void *object)
 
    [metal_object release];
 }
+
+void *virgl_metal_heap_map(void *heap, void **contents, uint64_t *length)
+{
+   id<MTLHeap> metal_heap = (id<MTLHeap>)heap;
+
+   if (metal_heap.type != MTLHeapTypePlacement ||
+       metal_heap.storageMode != MTLStorageModeShared)
+      return NULL;
+
+   id<MTLBuffer> buffer = [metal_heap newBufferWithLength:metal_heap.size
+                                                  options:metal_heap.resourceOptions
+                                                   offset:0];
+   if (!buffer)
+      return NULL;
+
+   *contents = buffer.contents;
+   *length = buffer.length;
+   return buffer;
+}
+
+bool virgl_metal_texture_is_linear(void *texture)
+{
+   id<MTLTexture> metal_texture = (id<MTLTexture>)texture;
+
+   return metal_texture.buffer != nil;
+}
+
+bool virgl_metal_texture_read(void *texture,
+                              void *destination,
+                              uint32_t bytes_per_row,
+                              uint32_t width,
+                              uint32_t height)
+{
+   id<MTLTexture> metal_texture = (id<MTLTexture>)texture;
+
+   if (metal_texture.storageMode != MTLStorageModeShared ||
+       metal_texture.textureType != MTLTextureType2D ||
+       width > metal_texture.width || height > metal_texture.height)
+      return false;
+
+   [metal_texture getBytes:destination
+               bytesPerRow:bytes_per_row
+                fromRegion:MTLRegionMake2D(0, 0, width, height)
+               mipmapLevel:0];
+   return true;
+}
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index fa32c6de74464161081d4c24f776c029ad96c7cb..b227606ba3eca6e2e04141f5d651a57c3609924b 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -64,6 +64,9 @@
 #include "virgl_hw.h"
 #include "virgl_resource.h"
 #include "virglrenderer.h"
+#ifdef ENABLE_METAL
+#include "virgl_metal.h"
+#endif
 #include "virgl_protocol.h"
 #include "virgl_fence.h"
 #include "virtgpu_drm.h"
@@ -9428,37 +9431,25 @@ static void *vrend_resource_alias_shm(struct vrend_resource *gr,
                                             offset);
 }
 
-/* Map an exporter's shared-memory blob and give this resource a texture over
- * it, aliasing the pages where the driver can and copying where it cannot. */
-static int vrend_resource_import_shm(struct vrend_resource *gr,
-                                     struct virgl_resource *res,
-                                     uint32_t format,
-                                     uint32_t stride,
-                                     uint32_t offset)
+/* Give this resource a texture over an exporter's mapped bytes, aliasing the
+ * pages where the driver can and copying from them where it cannot. The
+ * caller keeps the mapping when this fails. */
+static int vrend_resource_attach_mapping(struct vrend_resource *gr,
+                                         void *map,
+                                         uint64_t size,
+                                         uint32_t format,
+                                         uint32_t stride,
+                                         uint32_t offset)
 {
-   void *map;
-   int ret;
-
-   if (res->fd < 0 || !res->map_size)
-      return EINVAL;
-
-   map = mmap(NULL, res->map_size, PROT_READ, MAP_SHARED, res->fd, 0);
-   if (map == MAP_FAILED) {
-      virgl_error("%s: cannot map the exporter's %" PRIu64 " byte segment: %s\n",
-                  __func__, (uint64_t)res->map_size, strerror(errno));
-      return EINVAL;
-   }
-
    /* Aliasing is the whole point: a texture over the exporter's own pages
     * needs no refresh at all, so the presenting X server reads the guest's
     * frame where the guest wrote it. */
    void *image = vrend_resource_alias_shm(gr, map, format, stride, offset);
 
-   ret = vrend_resource_alloc_texture(gr, format, image);
+   int ret = vrend_resource_alloc_texture(gr, format, image);
    if (ret) {
       if (image)
          virgl_egl_host_pointer_image_destroy(egl, image);
-      munmap(map, res->map_size);
       return ret;
    }
 
@@ -9467,7 +9458,7 @@ static int vrend_resource_import_shm(struct vrend_resource *gr,
                  __func__, gr->base.width0, gr->base.height0);
       gr->shm_import_image = image;
       gr->shm_import_map = map;
-      gr->shm_import_size = res->map_size;
+      gr->shm_import_size = size;
       gr->shm_import_stride = stride;
       gr->shm_import_offset = offset;
       gr->shm_import_format = format;
@@ -9484,15 +9475,129 @@ static int vrend_resource_import_shm(struct vrend_resource *gr,
    /* Pinning the exporter's segment turns the refresh into a GPU-side copy of
     * its own pages; an unpinnable segment falls back to a client-memory
     * upload. This is the same pinning the export direction uses. */
-   gr->shm_import_pbo = vrend_shm_pin_pbo(map, res->map_size);
+   gr->shm_import_pbo = vrend_shm_pin_pbo(map, size);
 
    gr->shm_import_map = map;
-   gr->shm_import_size = res->map_size;
+   gr->shm_import_size = size;
    gr->shm_import_stride = stride;
    gr->shm_import_offset = offset;
    gr->shm_import_format = format;
    return 0;
 }
+
+/* Map an exporter's shared-memory blob and give this resource a texture over
+ * it. */
+static int vrend_resource_import_shm(struct vrend_resource *gr,
+                                     struct virgl_resource *res,
+                                     uint32_t format,
+                                     uint32_t stride,
+                                     uint32_t offset)
+{
+   if (res->fd < 0 || !res->map_size)
+      return EINVAL;
+
+   void *map = mmap(NULL, res->map_size, PROT_READ, MAP_SHARED, res->fd, 0);
+   if (map == MAP_FAILED) {
+      virgl_error("%s: cannot map the exporter's %" PRIu64 " byte segment: %s\n",
+                  __func__, (uint64_t)res->map_size, strerror(errno));
+      return EINVAL;
+   }
+
+   int ret = vrend_resource_attach_mapping(gr, map, res->map_size, format,
+                                           stride, offset);
+   if (ret)
+      munmap(map, res->map_size);
+   return ret;
+}
+
+/* An optimal image's bytes are not rows, so every refresh reads its texture
+ * into pages this resource owns, laid out at the texture's own width. */
+static int vrend_resource_import_native_texture(struct vrend_resource *gr,
+                                                void *texture,
+                                                uint32_t format)
+{
+   const uint32_t blocksize = util_format_get_blocksize(format);
+   const uint32_t stride = gr->base.width0 * blocksize;
+   const uint64_t page_size = (uint64_t)getpagesize();
+   const uint64_t size =
+      ((uint64_t)stride * gr->base.height0 + page_size - 1) & ~(page_size - 1);
+   if (!size)
+      return EINVAL;
+
+   void *map = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON,
+                    -1, 0);
+   if (map == MAP_FAILED)
+      return ENOMEM;
+
+   int ret = vrend_resource_alloc_texture(gr, format, NULL);
+   if (ret) {
+      munmap(map, size);
+      return ret;
+   }
+
+   gr->native_import_texture = texture;
+   gr->shm_import_pbo = vrend_shm_pin_pbo(map, size);
+   gr->shm_import_map = map;
+   gr->shm_import_size = size;
+   gr->shm_import_stride = stride;
+   gr->shm_import_offset = 0;
+   gr->shm_import_format = format;
+   return 0;
+}
+
+/* A Venus context that allocated a blob out of a Metal heap exports it as a
+ * shared-memory file that only names the heap, so mapping the file shows none
+ * of the pixels. Read them where they are: the rows of a linear image or a
+ * buffer are the heap's own bytes, which import like any other segment, and
+ * an optimal image is read through the texture its exporter published.
+ * ENOTSUP leaves the caller to the file itself. */
+static int vrend_resource_import_native(struct vrend_resource *gr,
+                                        struct virgl_resource *res,
+                                        uint32_t format,
+                                        uint32_t stride,
+                                        uint32_t offset)
+{
+   enum virgl_resource_native_handle_type type;
+   void *heap = NULL;
+   const uint64_t id = virgl_resource_native_acquire(res->fd, &type, &heap);
+   if (!id)
+      return ENOTSUP;
+   if (type != VIRGL_RESOURCE_NATIVE_HANDLE_METAL_HEAP || !heap) {
+      virgl_resource_native_release(id);
+      return ENOTSUP;
+   }
+
+   int ret;
+   void *texture = virgl_resource_native_acquire_metal_texture(
+      id, offset, gr->base.width0, gr->base.height0);
+   if (texture && !virgl_metal_texture_is_linear(texture)) {
+      ret = vrend_resource_import_native_texture(gr, texture, format);
+      if (ret)
+         virgl_metal_release_object(texture);
+   } else {
+      if (texture)
+         virgl_metal_release_object(texture);
+      void *contents = NULL;
+      uint64_t length = 0;
+      void *buffer = virgl_metal_heap_map(heap, &contents, &length);
+      ret = buffer ? vrend_resource_attach_mapping(gr, contents, length,
+                                                   format, stride, offset)
+                   : ENOTSUP;
+      if (ret) {
+         if (buffer)
+            virgl_metal_release_object(buffer);
+      } else {
+         gr->native_import_buffer = buffer;
+      }
+   }
+
+   if (ret) {
+      virgl_resource_native_release(id);
+      return ret;
+   }
+   gr->native_import_id = id;
+   return 0;
+}
 #endif
 
 void vrend_resource_sync_shm_import(struct vrend_resource *res)
@@ -9513,6 +9618,15 @@ void vrend_resource_sync_shm_import(struct vrend_resource *res)
    if (!blocksize || needed > res->shm_import_size)
       return;
 
+#ifdef ENABLE_METAL
+   if (res->native_import_texture &&
+       !virgl_metal_texture_read(res->native_import_texture,
+                                 (char *)res->shm_import_map +
+                                    res->shm_import_offset,
+                                 stride, width, height))
+      return;
+#endif
+
    glBindTexture(res->target, res->gl_id);
    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
    if (stride % blocksize == 0)
@@ -9543,9 +9657,18 @@ void vrend_renderer_resource_destroy(struct vrend_resource *res)
    if (res->shm_export_dirty)
       list_del(&res->shm_export_head);
    /* A borrowed mapping belongs to this resource's own segment, which the
-    * retire path below unmaps once the GPU is done with the pinned pages. */
-   if (res->shm_import_map && !res->shm_import_borrowed)
+    * retire path below unmaps once the GPU is done with the pinned pages, and
+    * a Metal heap's mapping is the buffer released below. */
+   if (res->shm_import_map && !res->shm_import_borrowed &&
+       !res->native_import_buffer)
       munmap(res->shm_import_map, res->shm_import_size);
+#ifdef ENABLE_METAL
+   if (res->native_import_buffer)
+      virgl_metal_release_object(res->native_import_buffer);
+   if (res->native_import_texture)
+      virgl_metal_release_object(res->native_import_texture);
+   virgl_resource_native_release(res->native_import_id);
+#endif
 
    if (has_bit(res->storage_bits, VREND_STORAGE_GL_TEXTURE)) {
       glDeleteTextures(1, &res->gl_id);
@@ -14245,9 +14368,15 @@ vrend_renderer_pipe_resource_set_type(struct vrend_context *ctx,
             virgl_warn("%s: ignoring plane_count = %d and using the first one\n",
                        __func__, args->plane_count);
          }
-         int ret = vrend_resource_import_shm(gr, res, args->format,
-                                             args->plane_strides[0],
-                                             args->plane_offsets[0]);
+         int ret = ENOTSUP;
+         if (res->native_resource_id)
+            ret = vrend_resource_import_native(gr, res, args->format,
+                                               args->plane_strides[0],
+                                               args->plane_offsets[0]);
+         if (ret == ENOTSUP)
+            ret = vrend_resource_import_shm(gr, res, args->format,
+                                            args->plane_strides[0],
+                                            args->plane_offsets[0]);
          if (ret) {
             FREE(gr);
             return ret;
diff --git a/src/vrend/vrend_renderer.h b/src/vrend/vrend_renderer.h
index f90870f13a8979eb773d464078ce855aee7a4959..8ceede88cd29a2534454b2acaeca42767752995c 100644
--- a/src/vrend/vrend_renderer.h
+++ b/src/vrend/vrend_renderer.h
@@ -136,6 +136,13 @@ struct vrend_resource {
     * segment -- the export direction -- so the teardown leaves it to the
     * segment's owner instead of unmapping it twice. */
    bool shm_import_borrowed;
+   /* A blob a Venus context allocated out of a Metal heap: the registry
+    * reference that keeps the heap alive, and either the buffer over the
+    * heap that shm_import_map points into or the optimal texture each
+    * refresh reads into this resource's own shm_import_map pages. */
+   uint64_t native_import_id;
+   void *native_import_buffer;
+   void *native_import_texture;
 
    /* GL wrote this exported resource since its segment was last updated. */
    bool shm_export_dirty;
