index e51745c46fc874e9b02aeb6cd34670c9ee1826db..1d5ef95f99008216aadc31b8686ce4314798cf2e 100644
--- a/src/vrend/vrend_winsys_egl.h
+++ b/src/vrend/vrend_winsys_egl.h
@@ -86,6 +86,7 @@ void *virgl_egl_image_from_gbm_bo(struct virgl_egl *egl, struct gbm_bo *bo);
 void *virgl_egl_aux_plane_image_from_gbm_bo(struct virgl_egl *egl, struct gbm_bo *bo, int plane);
 #endif
 
+bool virgl_egl_trim_context(struct virgl_egl *egl);
