From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 31 Oct 2026 10:52:39 +0900
Subject: [PATCH] vrend: trim a context the host found idle

virgl_renderer_context_trim(ctx_id) is how the host tells the renderer that a
guest context has made no submission for a while and has no fence left to
retire.  The context's GL contexts then run what glthread and the threaded
context still have queued behind a glFlush, and the host driver is asked
(eglTrimContextMESA, where EGL_MESA_context_trim is advertised) to release
what it keeps for completed work.  Without that, the references a driver holds
until the context next submits stay for as long as the guest stays quiet,
which for a compositor or a launcher is minutes.

Every sub context of the context is visited, and the guest's choice of the
current one is restored.  Nothing waits for the GPU.  A context that is not a
GL context, or an error context, ignores the call.  The vtable entry is
optional.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/virgl_context.h          |  4 ++++
 src/virglrenderer.c          | 10 ++++++++++
 src/virglrenderer.h          |  9 +++++++++
 src/vrend/vrend_decode.c     |  8 ++++++++
 src/vrend/vrend_renderer.c   | 22 ++++++++++++++++++++++
 src/vrend/vrend_renderer.h   |  2 ++
 src/vrend/vrend_winsys_egl.c | 17 +++++++++++++++++
 src/vrend/vrend_winsys_egl.h |  1 +
 8 files changed, 73 insertions(+)

diff --git a/src/virgl_context.h b/src/virgl_context.h
index 25bc10603f0a6bc80db759af8911cba2186e74a3..822917cc32d88d6b02c0c9d88d2495f3546e55ae 100644
--- a/src/virgl_context.h
+++ b/src/virgl_context.h
@@ -129,6 +129,10 @@ struct virgl_context {
                        uint32_t ring_idx,
                        uint64_t fence_id);
 
+   /* Optional.  The host found the context idle: release what it holds for
+    * completed work.  Never waits for the GPU. */
+   void (*trim)(struct virgl_context *ctx);
+
    /* For DRM native contexts, return the device fd: */
    int (*get_device_fd)(struct virgl_context *ctx);
 
diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index c13846ab9dd420ed8112d761f062d7ec3b6aaa0a..f9d1e6e5948d6445702723d5331b549cf32ecd92 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -458,6 +458,16 @@ void virgl_renderer_context_poll(uint32_t ctx_id)
    ctx->retire_fences(ctx);
 }
 
+void virgl_renderer_context_trim(uint32_t ctx_id)
+{
+   TRACE_FUNC();
+   struct virgl_context *ctx = virgl_context_lookup(ctx_id);
+   if (!ctx || !ctx->trim)
+      return;
+
+   ctx->trim(ctx);
+}
+
 int virgl_renderer_context_get_poll_fd(uint32_t ctx_id)
 {
    struct virgl_context *ctx = virgl_context_lookup(ctx_id);
diff --git a/src/virglrenderer.h b/src/virglrenderer.h
index 88372ec8bc0b688810895001081f6d9d20bd5ff4..70085259bf47ebb119c3034e64e94821d432f0d2 100644
--- a/src/virglrenderer.h
+++ b/src/virglrenderer.h
@@ -487,6 +487,15 @@ VIRGL_EXPORT int virgl_renderer_context_create_fence(uint32_t ctx_id,
 VIRGL_EXPORT void virgl_renderer_context_poll(uint32_t ctx_id); /* force fences */
 VIRGL_EXPORT int virgl_renderer_context_get_poll_fd(uint32_t ctx_id);
 
+/* Tell the renderer that a context has been idle for a while: the host has
+ * seen no command from it and every fence it asked for has retired. The
+ * renderer flushes what the context's GL contexts still hold back and asks
+ * the host GL driver to release what they keep for completed work. It
+ * never waits for the GPU, and the context stays usable. A context that
+ * has nothing to trim, or is not a GL context, ignores it. Call it from
+ * the thread that runs the renderer. */
+VIRGL_EXPORT void virgl_renderer_context_trim(uint32_t ctx_id);
+
 /* Map a resource to an specific userspace address. If successful, the
  * mapping is owned by the caller and is its responsibility to unmap
  * the resource by its own means (i.e. overriding the map with
diff --git a/src/vrend/vrend_decode.c b/src/vrend/vrend_decode.c
index e76f006d2a577f714399b7271b4a46ab6eabaf42..05fa41fca31d80f89ed6b206d5732c102766492e 100644
--- a/src/vrend/vrend_decode.c
+++ b/src/vrend/vrend_decode.c
@@ -1700,6 +1700,13 @@ static void vrend_decode_ctx_detach_resource(struct virgl_context *ctx,
    vrend_renderer_detach_res_ctx(dctx->grctx, res);
 }
 
+static void vrend_decode_ctx_trim(struct virgl_context *ctx)
+{
+   TRACE_FUNC();
+   struct vrend_decode_ctx *dctx = (struct vrend_decode_ctx *)ctx;
+   vrend_renderer_context_trim(dctx->grctx);
+}
+
 static int vrend_decode_ctx_transfer_3d(struct virgl_context *ctx,
                                         struct virgl_resource *res,
                                         const struct vrend_transfer_info *info,
@@ -2220,4 +2227,5 @@ static void vrend_decode_ctx_init_base(struct vrend_decode_ctx *dctx,
    ctx->get_fencing_fd = vrend_decode_ctx_get_fencing_fd;
    ctx->retire_fences = vrend_decode_ctx_retire_fences;
    ctx->submit_fence = vrend_decode_ctx_submit_fence;
+   ctx->trim = vrend_decode_ctx_trim;
 }
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 224d99df8d68dd777752cfb653b3d5793110d1bc..42b7031ca765c586becf4151af2e631a77fd380a 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -13109,6 +13109,28 @@ bool vrend_hw_switch_context(struct vrend_context *ctx, bool now)
    return true;
 }
 
+/* The host found the context idle.  Each of its GL contexts runs what it
+ * still has queued behind a glFlush, and then the host GL driver is asked to
+ * release what the context keeps for work that has completed: references a
+ * driver holds until the context next submits, which a context that has gone
+ * quiet never does.  The guest's selection of a sub context is untouched. */
+void vrend_renderer_context_trim(struct vrend_context *ctx)
+{
+   if (!ctx || ctx->in_error || !ctx->sub)
+      return;
+
+   struct vrend_sub_context *selected = ctx->sub;
+   list_for_each_entry(struct vrend_sub_context, sub, &ctx->sub_ctxs, head) {
+      if (!vrend_hw_switch_context_with_sub(ctx, sub->sub_ctx_id))
+         continue;
+      glFlush();
+#ifdef HAVE_EPOXY_EGL_H
+      virgl_egl_trim_context(egl);
+#endif
+   }
+   vrend_hw_switch_context_with_sub(ctx, selected->sub_ctx_id);
+}
+
 static void vrend_finish_context_switch(struct vrend_context *ctx)
 {
    if (ctx->ctx_switch_pending == false)
diff --git a/src/vrend/vrend_renderer.h b/src/vrend/vrend_renderer.h
index a2440259de2f14a96f7bb58de2e6af14ffe99a7c..65d7558ba2b368b2230ec68b5ee372a812309f63 100644
--- a/src/vrend/vrend_renderer.h
+++ b/src/vrend/vrend_renderer.h
@@ -598,6 +598,8 @@ void vrend_renderer_get_rect(struct pipe_resource *pres,
                              uint32_t offset,
                              int x, int y, int width, int height);
 
+void vrend_renderer_context_trim(struct vrend_context *ctx);
+
 void vrend_renderer_attach_res_ctx(struct vrend_context *ctx,
                                    struct virgl_resource *res);
 void vrend_renderer_detach_res_ctx(struct vrend_context *ctx,
diff --git a/src/vrend/vrend_winsys_egl.c b/src/vrend/vrend_winsys_egl.c
index 7efb9592d04f2213f50868ed828af67c9a54798b..eaaba2840b343f4a6624a2003f290f24aa585ff1 100644
--- a/src/vrend/vrend_winsys_egl.c
+++ b/src/vrend/vrend_winsys_egl.c
@@ -75,6 +75,7 @@
 #define EGL_EXT_PLATFORM_DEVICE                BIT(12)
 #define EGL_MESA_IMAGE_HOST_POINTER            BIT(13)
 #define EGL_MESA_GL_INTEROP                    BIT(14)
+#define EGL_MESA_CONTEXT_TRIM                  BIT(15)
 
 static const struct {
    uint32_t bit;
@@ -94,6 +95,7 @@ static const struct {
    { EGL_EXT_PLATFORM_DEVICE, "EGL_EXT_platform_device" },
    { EGL_MESA_IMAGE_HOST_POINTER, "EGL_MESA_image_host_pointer" },
    { EGL_MESA_GL_INTEROP, "EGL_MESA_gl_interop" },
+   { EGL_MESA_CONTEXT_TRIM, "EGL_MESA_context_trim" },
 };
 
 struct egl_funcs {
@@ -939,6 +941,21 @@ void *virgl_egl_aux_plane_image_from_gbm_bo(struct virgl_egl *egl, struct gbm_bo
 #define EGL_HOST_POINTER_SIZE_MESA   0x3296
 #endif
 
+/* EGL_MESA_context_trim: ask the host driver to release what the current
+ * context holds for completed work.  It is the host's to ignore: a driver
+ * without the extension simply keeps its references. */
+bool virgl_egl_trim_context(struct virgl_egl *egl)
+{
+   typedef EGLBoolean (*trim_context_proc)(void);
+   static trim_context_proc trim_context;
+
+   if (!egl || !has_bit(egl->extension_bits, EGL_MESA_CONTEXT_TRIM))
+      return false;
+   if (!trim_context)
+      trim_context = (trim_context_proc)eglGetProcAddress("eglTrimContextMESA");
+   return trim_context && trim_context();
+}
+
 bool virgl_egl_supports_host_pointer_image(struct virgl_egl *egl)
 {
    return has_bit(egl->extension_bits, EGL_MESA_IMAGE_HOST_POINTER);
