From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 00:01:38 +0900
Subject: [PATCH] apple: resolve the GL facade through the packaged Mesa
 provider

libepoxy assumes an Apple host reaches GL through CGL and
OpenGL.framework, and it compiles EGL out of the platform entirely.
linux-um-darwin packages exactly one GL provider per Apple product --
Mesa, built as MesaEGL.framework -- and that build is EGL-only: it
exports no desktop GL or GLES entry points of its own, and every GL API
is reached through eglGetProcAddress.

Let EGL exist on Apple, point every library name at the packaged
provider's rpath so no system OpenGL is retained as a hidden fallback,
and resolve the GL, GLES1, GLES2 and GLES3 facades through EGL rather
than through dlsym on a library that exports nothing.
---
 src/dispatch_common.c | 32 ++++++++++++++++++++++++++++----
 src/dispatch_common.h |  4 +++-
 2 files changed, 31 insertions(+), 5 deletions(-)

diff --git a/src/dispatch_common.c b/src/dispatch_common.c
index 153eb7c5f485224610f8e8c962e82d30c5b42206..dc649cd96b5857c97884fb9230896d1629f2c802 100644
--- a/src/dispatch_common.c
+++ b/src/dispatch_common.c
@@ -174,10 +174,16 @@
 #include "dispatch_common.h"
 
 #if defined(__APPLE__)
-#define GLX_LIB "/opt/X11/lib/libGL.1.dylib"
-#define OPENGL_LIB "/System/Library/Frameworks/OpenGL.framework/Versions/Current/OpenGL"
-#define GLES1_LIB "libGLESv1_CM.so"
-#define GLES2_LIB "libGLESv2.so"
+/* linux-um-darwin packages exactly one GL provider per Apple product and
+ * resolves every GL API through that product's rpath; CGL and
+ * OpenGL.framework are never retained as a hidden fallback. Mesa's Apple
+ * build is EGL-only and exports no desktop GL entry points of its own, so
+ * its GL facade is resolved through eglGetProcAddress instead. */
+#define EGL_LIB "@rpath/MesaEGL.framework/MesaEGL"
+#define GLX_LIB "@rpath/MesaEGL.framework/MesaEGL"
+#define OPENGL_LIB "@rpath/MesaEGL.framework/MesaEGL"
+#define GLES1_LIB "@rpath/MesaEGL.framework/MesaEGL"
+#define GLES2_LIB "@rpath/MesaEGL.framework/MesaEGL"
 #elif defined(__ANDROID__)
 #define GLX_LIB "libGLESv2.so"
 #define EGL_LIB "libEGL.so"
@@ -697,31 +703,45 @@ epoxy_load_gl(void)
 void *
 epoxy_gl_dlsym(const char *name)
 {
+#if defined(__APPLE__) && PLATFORM_HAS_EGL
+    /* The packaged Mesa provider exposes desktop GL only through its EGL
+     * entry point; the library exports no GL symbols to resolve. */
+    return eglGetProcAddress(name);
+#else
     epoxy_load_gl();
 
     return do_dlsym(&api.gl_handle, name, true);
+#endif
 }
 
 void *
 epoxy_gles1_dlsym(const char *name)
 {
+#if defined(__APPLE__) && PLATFORM_HAS_EGL
+    return epoxy_get_proc_address(name);
+#else
     if (epoxy_current_context_is_glx()) {
         return epoxy_get_proc_address(name);
     } else {
         get_dlopen_handle(&api.gles1_handle, GLES1_LIB, true, true);
         return do_dlsym(&api.gles1_handle, name, true);
     }
+#endif
 }
 
 void *
 epoxy_gles2_dlsym(const char *name)
 {
+#if defined(__APPLE__) && PLATFORM_HAS_EGL
+    return epoxy_get_proc_address(name);
+#else
     if (epoxy_current_context_is_glx()) {
         return epoxy_get_proc_address(name);
     } else {
         get_dlopen_handle(&api.gles2_handle, GLES2_LIB, true, true);
         return do_dlsym(&api.gles2_handle, name, true);
     }
+#endif
 }
 
 /**
@@ -737,6 +757,9 @@ epoxy_gles2_dlsym(const char *name)
 void *
 epoxy_gles3_dlsym(const char *name)
 {
+#if defined(__APPLE__) && PLATFORM_HAS_EGL
+    return epoxy_get_proc_address(name);
+#else
     if (epoxy_current_context_is_glx()) {
         return epoxy_get_proc_address(name);
     } else {
@@ -749,6 +772,7 @@ epoxy_gles3_dlsym(const char *name)
 
         return epoxy_get_proc_address(name);
     }
+#endif
 }
 
 /**
diff --git a/src/dispatch_common.h b/src/dispatch_common.h
index a136943194b2ca05470b83819ecfc60c148e565f..a5ede977653cb921fd78d695001345c9d642cb27 100644
--- a/src/dispatch_common.h
+++ b/src/dispatch_common.h
@@ -28,7 +28,9 @@
 #define PLATFORM_HAS_GLX ENABLE_GLX
 #define PLATFORM_HAS_WGL 1
 #elif defined(__APPLE__)
-#define PLATFORM_HAS_EGL 0 
+/* linux-um-darwin packages Mesa as the one GL provider on Apple, and Mesa's
+ * Apple build is EGL-only: EGL is how every GL entry point is reached. */
+#define PLATFORM_HAS_EGL ENABLE_EGL
 #define PLATFORM_HAS_GLX ENABLE_GLX
 #define PLATFORM_HAS_WGL 0
 #elif defined(ANDROID)
