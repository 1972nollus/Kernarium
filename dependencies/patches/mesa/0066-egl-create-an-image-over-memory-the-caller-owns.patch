 src/egl/drivers/dri2/egl_dri2.c      | 47 ++++++++++++++++
 src/egl/main/eglapi.c                |  4 +-
 src/egl/main/egldisplay.h            |  1 +
 src/egl/main/eglimage.c              | 44 +++++++++++++++
