From 35db8fd41f79af77d2a75d6fff20429df007a6f2 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 11:24:15 +0900
Subject: [PATCH 78/78] kosmickrisp: implement VK_EXT_image_drm_format_modifier

The Android 2025 baseline that VP_ANDROID_17_requirements inherits makes this
extension mandatory, and the guest Venus driver uses it as the other of the two
conditions for offering VK_ANDROID_native_buffer and the Android hardware
buffer import.

The driver already sized and validated VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT
images: the layout code treats every non-optimal tiling as linear, the image
format query restricts a modifier image to a single 2D level and layer, and its
memory requirements ask for a dedicated allocation. What was missing was the
extension itself, so nothing could ask for one.

Metal describes no tiling an agent outside this driver could agree on, so
DRM_FORMAT_MOD_LINEAR is the only modifier offered, the way lavapipe does it on
a platform without real modifiers. A modifier image is then exactly a linear
image with a name for its layout, and that decides the rest: the modifier is
reported for the formats linear tiling supports and with linear tiling's
feature set, the image format query answers about linear tiling once it has
seen a supported modifier, and an explicit plane layout is accepted only where
it matches the layout Metal's own alignment rule produces, because this driver
cannot lay a texture out any other way.

The modifier is kept in struct kk_image rather than struct vk_image, whose
drm_format_mod field the common runtime carries only on Linux and the BSDs.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/kosmickrisp/vulkan/kk_format.c          |  47 +++++++
 src/kosmickrisp/vulkan/kk_image.c           | 137 +++++++++++++++++++-
 src/kosmickrisp/vulkan/kk_image.h           |   8 ++
 src/kosmickrisp/vulkan/kk_physical_device.c |   1 +
 4 files changed, 188 insertions(+), 5 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_format.c b/src/kosmickrisp/vulkan/kk_format.c
index 6512a40d..c7a7066d 100644
--- a/src/kosmickrisp/vulkan/kk_format.c
+++ b/src/kosmickrisp/vulkan/kk_format.c
@@ -16,6 +16,9 @@
 
 #include "vk_enum_defines.h"
 #include "vk_format.h"
+#include "vk_util.h"
+
+#include "drm-uapi/drm_fourcc.h"
 
 #define MTL_FMT_ALL_NO_ATOMIC(width)                                           \
    .bit_widths = width, .filter = 1u, .write = 1u, .color = 1u, .blend = 1u,   \
@@ -412,6 +415,50 @@ kk_GetPhysicalDeviceFormatProperties2(VkPhysicalDevice physicalDevice,
          break;
       }
 
+      /* Metal describes no tiling that an agent outside this driver could
+       * agree on, so DRM_FORMAT_MOD_LINEAR is the only modifier offered, and
+       * it is offered exactly for the formats a linear image can use. */
+      case VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT: {
+         VkDrmFormatModifierPropertiesListEXT *list = (void *)ext;
+         VK_OUTARRAY_MAKE_TYPED(VkDrmFormatModifierPropertiesEXT, out,
+                                list->pDrmFormatModifierProperties,
+                                &list->drmFormatModifierCount);
+         if (linear2 != 0) {
+            vk_outarray_append_typed(VkDrmFormatModifierPropertiesEXT, &out,
+                                     mod)
+            {
+               *mod = (VkDrmFormatModifierPropertiesEXT){
+                  .drmFormatModifier = DRM_FORMAT_MOD_LINEAR,
+                  .drmFormatModifierPlaneCount =
+                     vk_format_get_plane_count(format),
+                  .drmFormatModifierTilingFeatures =
+                     vk_format_features2_to_features(linear2),
+               };
+            }
+         }
+         break;
+      }
+
+      case VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_2_EXT: {
+         VkDrmFormatModifierPropertiesList2EXT *list = (void *)ext;
+         VK_OUTARRAY_MAKE_TYPED(VkDrmFormatModifierProperties2EXT, out,
+                                list->pDrmFormatModifierProperties,
+                                &list->drmFormatModifierCount);
+         if (linear2 != 0) {
+            vk_outarray_append_typed(VkDrmFormatModifierProperties2EXT, &out,
+                                     mod)
+            {
+               *mod = (VkDrmFormatModifierProperties2EXT){
+                  .drmFormatModifier = DRM_FORMAT_MOD_LINEAR,
+                  .drmFormatModifierPlaneCount =
+                     vk_format_get_plane_count(format),
+                  .drmFormatModifierTilingFeatures = linear2,
+               };
+            }
+         }
+         break;
+      }
+
       default:
          vk_debug_ignored_stype(ext->sType);
          break;
diff --git a/src/kosmickrisp/vulkan/kk_image.c b/src/kosmickrisp/vulkan/kk_image.c
index 0bc236ea..038735f8 100644
--- a/src/kosmickrisp/vulkan/kk_image.c
+++ b/src/kosmickrisp/vulkan/kk_image.c
@@ -21,6 +21,8 @@
 #include "vk_format.h"
 #include "wsi_common_private.h"
 
+#include "drm-uapi/drm_fourcc.h"
+
 #include <vulkan/vulkan_metal.h>
 
 static VkFormatFeatureFlags2
@@ -30,6 +32,16 @@ kk_get_image_plane_format_features(struct kk_physical_device *pdev,
 {
    VkFormatFeatureFlags2 features = 0;
 
+   /* DRM_FORMAT_MOD_LINEAR is the only modifier this driver exposes, because
+    * Metal describes no tiling an outside agent could agree on. A modifier
+    * image is therefore laid out exactly like a linear one and has exactly a
+    * linear image's capabilities. */
+   if (tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT) {
+      if (drm_format_mod != DRM_FORMAT_MOD_LINEAR)
+         return 0;
+      tiling = VK_IMAGE_TILING_LINEAR;
+   }
+
    /* Metal does not support linear tiling for compressed formats */
    if (tiling == VK_IMAGE_TILING_LINEAR && vk_format_is_compressed(vk_format))
       return 0;
@@ -233,6 +245,34 @@ kk_GetPhysicalDeviceImageFormatProperties2(
    memset(&pImageFormatProperties->imageFormatProperties, 0,
           sizeof(pImageFormatProperties->imageFormatProperties));
 
+   /* A modifier image is a linear image with an agreed layout, and
+    * DRM_FORMAT_MOD_LINEAR is the only modifier this driver offers. Every
+    * limit a linear image has applies, so ask the rest of this function about
+    * linear tiling once the modifier is known to be one we support. */
+   uint64_t drm_format_mod = DRM_FORMAT_MOD_INVALID;
+   VkImageTiling tiling = pImageFormatInfo->tiling;
+   if (tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT) {
+      const VkPhysicalDeviceImageDrmFormatModifierInfoEXT *mod_info =
+         vk_find_struct_const(pImageFormatInfo->pNext,
+                              PHYSICAL_DEVICE_IMAGE_DRM_FORMAT_MODIFIER_INFO_EXT);
+      if (mod_info == NULL ||
+          mod_info->drmFormatModifier != DRM_FORMAT_MOD_LINEAR)
+         return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+      /* This driver has one queue family, so a concurrent modifier image can
+       * only name that family. */
+      if (mod_info->sharingMode == VK_SHARING_MODE_CONCURRENT) {
+         for (uint32_t i = 0; i < mod_info->queueFamilyIndexCount; i++) {
+            if (mod_info->pQueueFamilyIndices[i] != 0)
+               return VK_ERROR_FORMAT_NOT_SUPPORTED;
+         }
+      }
+
+      drm_format_mod = mod_info->drmFormatModifier;
+   }
+   const bool linear_layout = tiling == VK_IMAGE_TILING_LINEAR ||
+                              tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+
    /* Metal does not support depth/stencil textures that are not 2D (we make 1D
     * textures 2D) */
    if (vk_format_is_depth_or_stencil(pImageFormatInfo->format) &&
@@ -257,22 +297,21 @@ kk_GetPhysicalDeviceImageFormatProperties2(
    VkFormatFeatureFlags2 features;
    if (ycbcr_info == NULL) {
       features = kk_get_image_plane_format_features(
-         pdev, pImageFormatInfo->format, pImageFormatInfo->tiling, 0u);
+         pdev, pImageFormatInfo->format, tiling, drm_format_mod);
    } else {
       features = ~0ull;
       assert(ycbcr_info->n_planes > 0);
       for (uint8_t plane = 0; plane < ycbcr_info->n_planes; plane++) {
          const VkFormat plane_format = ycbcr_info->planes[plane].format;
          features &= kk_get_image_plane_format_features(
-            pdev, plane_format, pImageFormatInfo->tiling, 0u);
+            pdev, plane_format, tiling, drm_format_mod);
       }
    }
 
    if (features == 0)
       return VK_ERROR_FORMAT_NOT_SUPPORTED;
 
-   if (pImageFormatInfo->tiling == VK_IMAGE_TILING_LINEAR &&
-       pImageFormatInfo->type == VK_IMAGE_TYPE_3D)
+   if (linear_layout && pImageFormatInfo->type == VK_IMAGE_TYPE_3D)
       return VK_ERROR_FORMAT_NOT_SUPPORTED;
 
    /* TODO_KOSMICKRISP Linear images cannot be used as color attachments as long
@@ -281,7 +320,7 @@ kk_GetPhysicalDeviceImageFormatProperties2(
     * used as an input attachment, and Metal disallows arrays for linear
     * textures.
     */
-   if (pImageFormatInfo->tiling == VK_IMAGE_TILING_LINEAR &&
+   if (linear_layout &&
        (pImageFormatInfo->usage &
         (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
          VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)))
@@ -533,6 +572,48 @@ kk_image_init(struct kk_device *dev, struct kk_image *image,
 {
    vk_image_init(&dev->vk, &image->vk, pCreateInfo);
 
+   image->drm_format_mod = DRM_FORMAT_MOD_INVALID;
+
+   const VkImageDrmFormatModifierExplicitCreateInfoEXT *mod_explicit = NULL;
+
+   /* DRM_FORMAT_MOD_LINEAR is the only one offered, so both ways of
+    * asking for a modifier image can only arrive at it, and an explicit
+    * layout is honoured only where it agrees with the layout this driver
+    * would compute for the same image. */
+   if (pCreateInfo->tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT) {
+      const VkImageDrmFormatModifierListCreateInfoEXT *mod_list =
+         vk_find_struct_const(pCreateInfo->pNext,
+                              IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT);
+      mod_explicit = vk_find_struct_const(
+         pCreateInfo->pNext,
+         IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT);
+
+      if (mod_list != NULL) {
+         bool found = false;
+         for (uint32_t i = 0; i < mod_list->drmFormatModifierCount; i++) {
+            if (mod_list->pDrmFormatModifiers[i] == DRM_FORMAT_MOD_LINEAR)
+               found = true;
+         }
+         if (!found) {
+            vk_image_finish(&image->vk);
+            return vk_errorf(dev, VK_ERROR_INITIALIZATION_FAILED,
+                             "no supported DRM format modifier in the list");
+         }
+      } else if (mod_explicit != NULL) {
+         if (mod_explicit->drmFormatModifier != DRM_FORMAT_MOD_LINEAR) {
+            vk_image_finish(&image->vk);
+            return vk_errorf(dev, VK_ERROR_INITIALIZATION_FAILED,
+                             "unsupported DRM format modifier");
+         }
+      } else {
+         vk_image_finish(&image->vk);
+         return vk_errorf(dev, VK_ERROR_INITIALIZATION_FAILED,
+                          "modifier tiling needs a modifier list or layout");
+      }
+
+      image->drm_format_mod = DRM_FORMAT_MOD_LINEAR;
+   }
+
    if ((image->vk.usage & (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
                            VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)) &&
        image->vk.samples > 1) {
@@ -585,6 +666,52 @@ kk_image_init(struct kk_device *dev, struct kk_image *image,
       }
    }
 
+   /* An explicit layout describes memory this driver did not lay out. Metal
+    * fixes a linear texture's row pitch through its own alignment rule, so
+    * the only explicit layout that can be bound here is the one this driver
+    * would have produced; anything else has to be refused rather than
+    * silently ignored. */
+   if (mod_explicit != NULL) {
+      if (mod_explicit->drmFormatModifierPlaneCount != image->plane_count) {
+         vk_image_finish(&image->vk);
+         return vk_errorf(dev, VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT,
+                          "explicit layout describes %u planes, image has %u",
+                          mod_explicit->drmFormatModifierPlaneCount,
+                          (unsigned)image->plane_count);
+      }
+
+      for (uint8_t plane = 0; plane < image->plane_count; plane++) {
+         const struct kk_image_layout *layout = &image->planes[plane].layout;
+         const VkSubresourceLayout *given = &mod_explicit->pPlaneLayouts[plane];
+
+         if (given->offset != 0 || given->rowPitch != layout->linear_stride_B ||
+             (given->size != 0 && given->size != layout->size_B) ||
+             given->arrayPitch != 0 || given->depthPitch != 0) {
+            vk_image_finish(&image->vk);
+            return vk_errorf(
+               dev, VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT,
+               "plane %u wants offset %llu pitch %llu, Metal lays it out at "
+               "offset 0 pitch %u",
+               (unsigned)plane, (unsigned long long)given->offset,
+               (unsigned long long)given->rowPitch,
+               (unsigned)layout->linear_stride_B);
+         }
+      }
+   }
+
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_GetImageDrmFormatModifierPropertiesEXT(
+   VkDevice device, VkImage _image,
+   VkImageDrmFormatModifierPropertiesEXT *pProperties)
+{
+   VK_FROM_HANDLE(kk_image, image, _image);
+
+   assert(image->vk.tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT);
+   pProperties->drmFormatModifier = image->drm_format_mod;
+
    return VK_SUCCESS;
 }
 
diff --git a/src/kosmickrisp/vulkan/kk_image.h b/src/kosmickrisp/vulkan/kk_image.h
index 33afaa67..8f4e3b4e 100644
--- a/src/kosmickrisp/vulkan/kk_image.h
+++ b/src/kosmickrisp/vulkan/kk_image.h
@@ -52,6 +52,14 @@ struct kk_image {
 
    uint8_t plane_count;
    struct kk_image_plane planes[3];
+
+   /* VK_EXT_image_drm_format_modifier.
+    *
+    * DRM_FORMAT_MOD_INVALID unless the image was created with
+    * VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT.  The common runtime carries
+    * this field only on Linux and the BSDs, so this driver keeps its own.
+    */
+   uint64_t drm_format_mod;
 };
 
 #define kk_foreach_slice(ndx, image, subresource_member)                       \
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index 0d716fc1..ce2b4046 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -181,6 +181,7 @@ kk_get_device_extensions(const struct kk_instance *instance,
       .EXT_metal_objects = true,
       .EXT_hdr_metadata = true,
       .EXT_image_2d_view_of_3d = true,
+      .EXT_image_drm_format_modifier = true,
       .EXT_legacy_vertex_attributes = true,
       .EXT_load_store_op_none = true,
       .EXT_memory_budget = true,
