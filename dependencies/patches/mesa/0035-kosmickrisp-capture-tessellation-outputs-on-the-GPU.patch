+/* TES has already produced a decomposed point/line/triangle list in primitive
+ * order. Pull its current record directly instead of evaluating all corners of
+ * a synthetic GS and selecting one. Keep the Poly pre-GS program as the sole
+ * owner of primitive counts, buffer capacity, offsets and overflow queries. */
+static nir_shader *
+kk_create_tes_transform_feedback_raster(
+   const nir_shader *tes, enum mesa_prim primitive,
+   const struct kk_polygon_point_output *outputs)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_VERTEX, tes->options, "tes_transform_feedback_raster");
+   nir_shader *nir = b.shader;
+   nir->info.outputs_written = tes->info.outputs_written;
+   nir->info.clip_distance_array_size = tes->info.clip_distance_array_size;
+   nir->info.cull_distance_array_size = tes->info.cull_distance_array_size;
+
+   nir_def *vp = nir_load_vertex_param_buffer_poly(&b);
+   nir_def *gp = nir_load_geometry_param_buffer_poly(&b);
+   nir_def *vertex = nir_load_vertex_id(&b);
+   nir_def *instance = nir_load_instance_id(&b);
+   nir_def *record = nir_iadd(
+      &b, vertex, nir_imul(&b, instance, poly_input_vertices(&b, vp)));
+   nir_def *values[NUM_TOTAL_VARYING_SLOTS] = {0};
+   u_foreach_bit64(location, tes->info.outputs_written) {
+      const struct kk_polygon_point_output *output = &outputs[location];
+      assert(output->components && output->type != nir_type_invalid);
+      nir_def *addr = poly_vertex_output_address(
+         &b, vp, nir_imm_int64(&b, tes->info.outputs_written), record,
+         nir_imm_int(&b, location));
+      values[location] = nir_load_global(
+         &b, output->components, nir_alu_type_get_type_size(output->type),
+         addr, .align_mul = 4);
+   }
+
+   const struct nir_xfb_info *xfb = tes->xfb_info;
+   const unsigned vertices_per_primitive = mesa_vertices_per_prim(primitive);
+   nir_def *input_primitives = kk_load_xfb_geometry_param(
+      &b, gp, offsetof(struct poly_geometry_params, grid[0]), 32);
+   nir_def *index = nir_iadd(
+      &b, vertex, nir_imul_imm(
+         &b, nir_imul(&b, instance, input_primitives), vertices_per_primitive));
+   nir_def *capacity = kk_load_xfb_geometry_param(
+      &b, gp, offsetof(struct poly_geometry_params, xfb_verts[0]), 32);
+   nir_push_if(&b, nir_ult(&b, index, capacity));
+   for (unsigned i = 0; i < xfb->output_count; ++i) {
+      const nir_xfb_output_info output = xfb->outputs[i];
+      if (xfb->buffer_to_stream[output.buffer] != 0)
+         continue;
+
+      nir_def *value = values[output.location];
+      value = value ? nir_pad_vector_imm_int(&b, value, 0, 4)
+                    : nir_imm_ivec4(&b, 0, 0, 0, 0);
+      nir_def *addr = poly_xfb_vertex_address(
+         &b, gp, index, nir_imm_int(&b, output.buffer),
+         nir_imm_int(&b, xfb->buffers[output.buffer].stride),
+         nir_imm_int(&b, output.offset));
+      nir_store_global(&b, nir_channels(&b, value, output.component_mask), addr);
+   }
+   nir_pop_if(&b, NULL);
+
+   /* The following raster-only flat override must not alter these raw stores. */
+   u_foreach_bit64(location, tes->info.outputs_written) {
+      const struct kk_polygon_point_output *output = &outputs[location];
+      nir_store_output(
+         &b, values[location], nir_imm_int(&b, 0),
+         .write_mask = output->component_mask, .src_type = output->type,
+         .io_semantics = (nir_io_semantics){
+            .location = location, .num_slots = 1,
+         });
+   }
+   if (primitive == MESA_PRIM_POINTS)
+      nir_lower_default_point_size(nir);
+   nir_shader_gather_info(nir, b.impl);
+   return nir;
+}
