From 86da343ff9a1bfe8d5a930769bcbcb4f813a8d60 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 14:09:51 +0900
Subject: [PATCH 80/83] kosmickrisp: implement VK_EXT_image_compression_control

VP_ANDROID_17_requirements makes this extension and its swapchain companion
mandatory. Both are queries: an application asks what compression an image
would get and may ask for a different one, and an implementation that
compresses nothing it can describe still has to answer.

Metal is exactly that implementation. It decides for itself whether a
texture's contents are compressed, never reports it, and offers no fixed-rate
control, so this driver answers every compression query with
VK_IMAGE_COMPRESSION_DISABLED_EXT and VK_IMAGE_COMPRESSION_FIXED_RATE_NONE_EXT
from one helper, and refuses a format query that insists on an explicit fixed
rate. A VkImageCompressionControlEXT asking for the default or for compression
to be disabled is accepted, because there is nothing to turn off; the common
runtime already reads it out of the image creation chain.

The swapchain companion needs nothing further here: Mesa's common WSI forwards
the control into swapchain image creation and fills the compression properties
of a surface format as soon as the device advertises the first extension.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/kosmickrisp/vulkan/kk_image.c           | 19 +++++++++++++++++++
 src/kosmickrisp/vulkan/kk_image.h           | 17 +++++++++++++++++
 src/kosmickrisp/vulkan/kk_physical_device.c | 10 ++++++++++
 3 files changed, 46 insertions(+)

diff --git a/src/kosmickrisp/vulkan/kk_image.c b/src/kosmickrisp/vulkan/kk_image.c
index 038735f8..345f4ed3 100644
--- a/src/kosmickrisp/vulkan/kk_image.c
+++ b/src/kosmickrisp/vulkan/kk_image.c
@@ -245,6 +245,15 @@ kk_GetPhysicalDeviceImageFormatProperties2(
    memset(&pImageFormatProperties->imageFormatProperties, 0,
           sizeof(pImageFormatProperties->imageFormatProperties));
 
+   /* Metal decides for itself whether a texture's contents are compressed and
+    * offers no way to ask for a fixed rate, so this driver reports no
+    * compression and refuses a format query that insists on one. */
+   const VkImageCompressionControlEXT *compression_info =
+      vk_find_struct_const(pImageFormatInfo->pNext, IMAGE_COMPRESSION_CONTROL_EXT);
+   if (compression_info != NULL &&
+       (compression_info->flags & VK_IMAGE_COMPRESSION_FIXED_RATE_EXPLICIT_EXT))
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
    /* A modifier image is a linear image with an agreed layout, and
     * DRM_FORMAT_MOD_LINEAR is the only modifier this driver offers. Every
     * limit a linear image has applies, so ask the rest of this function about
@@ -547,6 +556,11 @@ kk_GetPhysicalDeviceImageFormatProperties2(
          host_props->identicalMemoryLayout = host_props->optimalDeviceAccess;
          break;
       }
+      case VK_STRUCTURE_TYPE_IMAGE_COMPRESSION_PROPERTIES_EXT: {
+         VkImageCompressionPropertiesEXT *compression_props = (void *)s;
+         *compression_props = kk_image_compression_properties();
+         break;
+      }
       default:
          vk_debug_ignored_stype(s->sType);
          break;
@@ -949,6 +963,11 @@ kk_get_image_subresource_layout(struct kk_device *dev, struct kk_image *image,
    if (memcpy_size) {
       memcpy_size->size = pLayout->subresourceLayout.size;
    }
+
+   VkImageCompressionPropertiesEXT *compression_props =
+      vk_find_struct(pLayout, IMAGE_COMPRESSION_PROPERTIES_EXT);
+   if (compression_props)
+      *compression_props = kk_image_compression_properties();
 }
 
 VKAPI_ATTR void VKAPI_CALL
diff --git a/src/kosmickrisp/vulkan/kk_image.h b/src/kosmickrisp/vulkan/kk_image.h
index 8f4e3b4e..9b9e9280 100644
--- a/src/kosmickrisp/vulkan/kk_image.h
+++ b/src/kosmickrisp/vulkan/kk_image.h
@@ -62,6 +62,23 @@ struct kk_image {
    uint64_t drm_format_mod;
 };
 
+/* VK_EXT_image_compression_control.
+ *
+ * Metal chooses for itself whether a texture's contents are compressed, never
+ * says so, and offers no fixed-rate control, so every query this driver
+ * answers reports the same thing: no compression the application can observe
+ * or ask for.
+ */
+static inline VkImageCompressionPropertiesEXT
+kk_image_compression_properties(void)
+{
+   return (VkImageCompressionPropertiesEXT){
+      .sType = VK_STRUCTURE_TYPE_IMAGE_COMPRESSION_PROPERTIES_EXT,
+      .imageCompressionFlags = VK_IMAGE_COMPRESSION_DISABLED_EXT,
+      .imageCompressionFixedRateFlags = VK_IMAGE_COMPRESSION_FIXED_RATE_NONE_EXT,
+   };
+}
+
 #define kk_foreach_slice(ndx, image, subresource_member)                       \
    for (uint32_t ndx = region->subresource_member.baseArrayLayer;              \
         ndx < (region->subresource_member.baseArrayLayer +                     \
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index 5749fb5e..cb199e69 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -181,6 +181,8 @@ kk_get_device_extensions(const struct kk_instance *instance,
       .EXT_metal_objects = true,
       .EXT_hdr_metadata = true,
       .EXT_image_2d_view_of_3d = true,
+      .EXT_image_compression_control = true,
+      .EXT_image_compression_control_swapchain = true,
       .EXT_image_drm_format_modifier = true,
       .EXT_legacy_vertex_attributes = true,
       .EXT_load_store_op_none = true,
@@ -495,6 +497,14 @@ kk_get_device_features(
       .image2DViewOf3D = true,
       .sampler2DViewOf3D = true,
 
+      /* VK_EXT_image_compression_control and its swapchain companion.
+       * Metal never tells the driver whether it compressed a texture and
+       * offers no fixed-rate control, so every query answers "no
+       * compression"; the control an application passes is accepted and
+       * honoured by there being nothing to turn off. */
+      .imageCompressionControl = true,
+      .imageCompressionControlSwapchain = true,
+
       /* VK_EXT_legacy_vertex_attributes */
       .legacyVertexAttributes = true,
 
