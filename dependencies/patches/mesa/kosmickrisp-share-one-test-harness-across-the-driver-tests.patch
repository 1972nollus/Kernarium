diff --git a/src/kosmickrisp/vulkan/tests/kk_test.h b/src/kosmickrisp/vulkan/tests/kk_test.h
new file mode 100644
index 0000000000000000000000000000000000000000..98add21f8648293da17291265213bc20073b31f3
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/kk_test.h
@@ -0,0 +1,75 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Checks shared by the KosmicKrisp tests.  Each one names the failed
+ * expression and aborts, in every build: assert() compiles away under NDEBUG,
+ * and some checks - a wait for Metal to finish with a stack-allocated
+ * completion, for example - have to run for the test to be safe at all.
+ *
+ * LOAD_I and LOAD_D fetch an entry point into a local of the same name from
+ * the `instance` or `device` in scope and fail when the driver lacks it. */
+
+#pragma once
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include <vulkan/vulkan_core.h>
+
+#define CHECK(condition)                                                       \
+   do {                                                                        \
+      if (!(condition)) {                                                      \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,      \
+                 #condition);                                                  \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+#define VK_CHECK(expr)                                                         \
+   do {                                                                        \
+      VkResult result_ = (expr);                                               \
+      if (result_ != VK_SUCCESS) {                                             \
+         fprintf(stderr, "%s:%d: %s = %d\n", __FILE__, __LINE__, #expr,        \
+                 result_);                                                     \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+#ifdef __cplusplus
+
+/* The C++ tests report an operation and its result and exit with status 1. */
+static inline void
+require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      fprintf(stderr, "%s: %d\n", operation, value);
+      exit(1);
+   }
+}
+
+template <typename T>
+static inline T
+load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                           \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+#else
+
+#define LOAD_I(name)                                                           \
+   PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name);       \
+   CHECK(name)
+#define LOAD_D(name)                                                           \
+   PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name);           \
+   CHECK(name)
+
+#endif
