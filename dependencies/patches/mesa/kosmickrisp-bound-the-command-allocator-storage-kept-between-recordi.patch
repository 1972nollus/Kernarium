+            .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+            .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT};
+         CHECK(vkBeginCommandBuffer(commands[3], &sentinel_begin) ==
+               VK_SUCCESS);
+         vkCmdFillBuffer(commands[3], buffer, 0, 4096, 0);
+         CHECK(vkEndCommandBuffer(commands[3]) == VK_SUCCESS);
+         VkSubmitInfo sentinel = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+                                  .commandBufferCount = 1,
+                                  .pCommandBuffers = &commands[3]};
+         CHECK(vkQueueSubmit(queue, 1, &sentinel, VK_NULL_HANDLE) ==
+               VK_SUCCESS);
