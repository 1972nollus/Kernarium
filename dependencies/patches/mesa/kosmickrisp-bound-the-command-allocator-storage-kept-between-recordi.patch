diff --git a/src/kosmickrisp/vulkan/tests/test_command_allocator_budget.c b/src/kosmickrisp/vulkan/tests/test_command_allocator_budget.c
new file mode 100644
index 0000000000000000000000000000000000000000..3a28c2753c1dfd09668affcd82812d82300431d1
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_command_allocator_budget.c
@@ -0,0 +1,343 @@
+/* SPDX-License-Identifier: MIT */
+
+/* A Metal command allocator keeps its storage at its high-water mark when it
+ * is reset. After one large recording has completed, neither the device's
+ * allocator cache nor a reset command buffer may keep that storage beyond
+ * KK_COMMAND_ALLOCATOR_RETAIN_MAX_B, or the process stays charged for its
+ * largest recording ever. A command buffer that records nothing holds no
+ * allocator at all, so idle command buffers cannot pin the cached storage.
+ */
+
+#define VK_NO_PROTOTYPES
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+#include "kosmickrisp/vulkan/kk_device.h"
+#include "kosmickrisp/bridge/mtl_command_buffer.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+#define CHECK(x)                                                               \
+   do {                                                                        \
+      if (!(x)) {                                                              \
+         fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x);               \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+#define LOAD_I(name)                                                           \
+   PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name);       \
+   CHECK(name)
+#define LOAD_D(name)                                                           \
+   PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name);           \
+   CHECK(name)
+
+/* Each pass and fill costs about 0.28 MiB of allocator storage, so this
+ * recording grows its allocator well past the retained budget. */
+#define PASSES 400u
+
+static uint64_t
+gfx_allocator_bytes(VkCommandBuffer commands)
+{
+   struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(commands);
+   return cmd->gfx.allocator
+             ? mtl_command_allocator_allocated_size(cmd->gfx.allocator)
+             : 0u;
+}
+
+static bool
+holds_no_allocator(VkCommandBuffer commands)
+{
+   struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(commands);
+   return !cmd->gfx.allocator && !cmd->cmp[0].allocator &&
+          !cmd->cmp[1].allocator;
+}
+
+static void
+cache_state(struct kk_device *dev, unsigned *count, uint64_t *bytes)
+{
+   struct kk_command_allocator_cache *cache = dev->allocator_cache;
+   simple_mtx_lock(&cache->mutex);
+   *count = cache->count;
+   *bytes = cache->bytes;
+   uint64_t sum = 0;
+   for (unsigned i = 0; i < cache->count; i++) {
+      CHECK(cache->sizes[i] <= KK_COMMAND_ALLOCATOR_RECYCLE_MAX_B);
+      sum += cache->sizes[i];
+   }
+   CHECK(sum == cache->bytes);
+   simple_mtx_unlock(&cache->mutex);
+}
+
+int
+main(void)
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   VkInstanceCreateInfo ici = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+                               .pApplicationInfo = &app};
+   CHECK(vkCreateInstance(&ici, NULL, &instance) == VK_SUCCESS);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+
+   uint32_t count = 1;
+   VkPhysicalDevice physical;
+   CHECK(vkEnumeratePhysicalDevices(instance, &count, &physical) == VK_SUCCESS);
+   CHECK(count == 1);
+   uint32_t family_count = 0;
+   vkGetPhysicalDeviceQueueFamilyProperties(physical, &family_count, NULL);
+   VkQueueFamilyProperties *families = calloc(family_count, sizeof(*families));
+   CHECK(families);
+   vkGetPhysicalDeviceQueueFamilyProperties(physical, &family_count, families);
+   uint32_t family = 0;
+   while (family < family_count &&
+          !(families[family].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+      family++;
+   CHECK(family < family_count);
+   free(families);
+
+   float priority = 1;
+   VkDeviceQueueCreateInfo qci = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = family,
+      .queueCount = 1,
+      .pQueuePriorities = &priority};
+   VkPhysicalDeviceVulkan13Features features13 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
+      .dynamicRendering = VK_TRUE};
+   VkDeviceCreateInfo dci = {.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+                             .pNext = &features13,
+                             .queueCreateInfoCount = 1,
+                             .pQueueCreateInfos = &qci};
+   VkDevice device;
+   CHECK(vkCreateDevice(physical, &dci, NULL, &device) == VK_SUCCESS);
+   struct kk_device *dev = kk_device_from_handle(device);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkGetDeviceQueue);
+   LOAD_D(vkCreateImage);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkGetImageMemoryRequirements);
+   LOAD_D(vkAllocateMemory);
+   LOAD_D(vkFreeMemory);
+   LOAD_D(vkBindImageMemory);
+   LOAD_D(vkCreateImageView);
+   LOAD_D(vkDestroyImageView);
+   LOAD_D(vkCreateBuffer);
+   LOAD_D(vkDestroyBuffer);
+   LOAD_D(vkGetBufferMemoryRequirements);
+   LOAD_D(vkBindBufferMemory);
+   LOAD_D(vkCreateCommandPool);
+   LOAD_D(vkDestroyCommandPool);
+   LOAD_D(vkAllocateCommandBuffers);
+   LOAD_D(vkBeginCommandBuffer);
+   LOAD_D(vkEndCommandBuffer);
+   LOAD_D(vkResetCommandBuffer);
+   LOAD_D(vkCmdBeginRendering);
+   LOAD_D(vkCmdEndRendering);
+   LOAD_D(vkCmdFillBuffer);
+   LOAD_D(vkQueueSubmit);
+   LOAD_D(vkQueueWaitIdle);
+
+   VkQueue queue;
