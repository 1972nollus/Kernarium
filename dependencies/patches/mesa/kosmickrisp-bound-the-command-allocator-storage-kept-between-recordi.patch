@@ -309,8 +309,10 @@ kk_command_allocator_cache_take(struct kk_command_allocator_cache *cache)
    mtl_command_allocator *allocator = NULL;
 
    simple_mtx_lock(&cache->mutex);
-   if (cache->count)
+   if (cache->count) {
       allocator = cache->entries[--cache->count];
