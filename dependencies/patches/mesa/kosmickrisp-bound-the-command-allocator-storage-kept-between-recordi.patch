    mtl_command_allocator_reset(allocator);
+   const uint64_t size = mtl_command_allocator_allocated_size(allocator);
 
    simple_mtx_lock(&cache->mutex);
-   if (cache->count < KK_COMMAND_ALLOCATOR_CACHE_MAX) {
+   if (cache->count < KK_COMMAND_ALLOCATOR_CACHE_MAX &&
+       size <= KK_COMMAND_ALLOCATOR_RECYCLE_MAX_B &&
+       size <= KK_COMMAND_ALLOCATOR_RETAIN_MAX_B - cache->bytes) {
+      cache->sizes[cache->count] = size;
       cache->entries[cache->count++] = allocator;
+      cache->bytes += size;
       allocator = NULL;
    }
    simple_mtx_unlock(&cache->mutex);
diff --git a/src/kosmickrisp/vulkan/kk_device.h b/src/kosmickrisp/vulkan/kk_device.h
index 16ec133e7201e835ec4678e0340a00a572616b12..a9635df0591c0604cb4981db654b585ea6ed10c3 100644
--- a/src/kosmickrisp/vulkan/kk_device.h
+++ b/src/kosmickrisp/vulkan/kk_device.h
@@ -92,14 +92,28 @@ struct kk_precompiled_cache {
  * callback after the device is gone, and the callback must be able to return
  * its allocators somewhere. It therefore holds no Vulkan pointers, exactly
  * like the queue's feedback block.
+ *
+ * A reset keeps an allocator's storage at its high-water mark, so one large
+ * recording would otherwise stay charged to the process for as long as its
+ * allocators are cached, and every recording that takes one of them keeps
+ * that storage for as long as it records, however little it needs. The cache
+ * therefore recycles only allocators no larger than
+ * KK_COMMAND_ALLOCATOR_RECYCLE_MAX_B, keeps at most
+ * KK_COMMAND_ALLOCATOR_RETAIN_MAX_B of storage, and releases every other
+ * allocator, which returns its storage to the kernel. A steady GL desktop's
+ * recordings stay near 11 MiB.
  */
 #define KK_COMMAND_ALLOCATOR_CACHE_MAX 24
+#define KK_COMMAND_ALLOCATOR_RECYCLE_MAX_B (16ull << 20)
+#define KK_COMMAND_ALLOCATOR_RETAIN_MAX_B (64ull << 20)
 
 struct kk_command_allocator_cache {
    int refcount;
    simple_mtx_t mutex;
    unsigned count;
+   uint64_t bytes;
    mtl_command_allocator *entries[KK_COMMAND_ALLOCATOR_CACHE_MAX];
+   uint64_t sizes[KK_COMMAND_ALLOCATOR_CACHE_MAX];
 };
 
 struct kk_command_allocator_cache *kk_command_allocator_cache_create(void);
