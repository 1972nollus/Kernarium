diff --git a/src/kosmickrisp/vulkan/tests/test_command_completion.m b/src/kosmickrisp/vulkan/tests/test_command_completion.m
new file mode 100644
index 00000000..bc5b601a
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_command_completion.m
@@ -0,0 +1,254 @@
+/* SPDX-License-Identifier: MIT */
+
+#define VK_NO_PROTOTYPES
+#include "kosmickrisp/vulkan/kk_queue.h"
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+#include "kosmickrisp/vulkan/kk_cmd_pool.h"
+#include "kosmickrisp/bridge/mtl_bridge.h"
+#include <Foundation/Foundation.h>
+#include <Metal/Metal.h>
+#include <dispatch/dispatch.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+static size_t
+live_objects(NSPointerArray *objects)
+{
+   /* Loading a weak reference may temporarily retain it. Drain those retains
+    * on each poll so the observer cannot keep the objects it measures alive. */
+   @autoreleasepool {
+      size_t live = 0;
+      for (NSUInteger i = 0; i < objects.count; i++)
+         live += [objects pointerAtIndex:i] != NULL;
+      return live;
+   }
+}
+
+static uint64_t
+monotonic_ns(void)
+{
+   struct timespec now;
+   CHECK(clock_gettime(CLOCK_MONOTONIC, &now) == 0);
+   return now.tv_sec * 1000000000ull + now.tv_nsec;
+}
+
+static void
+wait_released(NSPointerArray *objects)
+{
+   uint64_t deadline = monotonic_ns() + 5000000000ull;
+   while (live_objects(objects) && monotonic_ns() < deadline)
+      usleep(1000);
+   CHECK(live_objects(objects) == 0);
+}
+
+static NSPointerArray *
+watch_recording(VkCommandBuffer command)
+{
+   struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(command);
+   NSPointerArray *objects = [NSPointerArray weakObjectsPointerArray];
+   [objects addPointer:cmd->cmp[0].allocator];
+   [objects addPointer:cmd->gfx.allocator];
+   [objects addPointer:cmd->cmp[1].allocator];
+   util_dynarray_foreach(&cmd->submit_cmd_bufs, mtl_command_buffer *, cb)
+      [objects addPointer:*cb];
+   CHECK(objects.count > 3);
+   CHECK(live_objects(objects) == objects.count);
+   return objects;
+}
+
+static void
+run(bool one_time)
+{
+   @autoreleasepool {
+      VkInstance instance = VK_NULL_HANDLE;
+      LOAD_I(vkCreateInstance);
+      VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                              .apiVersion = VK_API_VERSION_1_3};
+      VkInstanceCreateInfo ici = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+                                  .pApplicationInfo = &app};
+      CHECK(vkCreateInstance(&ici, NULL, &instance) == VK_SUCCESS);
+      LOAD_I(vkDestroyInstance);
+      LOAD_I(vkEnumeratePhysicalDevices);
+      LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+      LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+      LOAD_I(vkCreateDevice);
+      LOAD_I(vkGetDeviceProcAddr);
+      uint32_t count = 1;
+      VkPhysicalDevice physical;
+      CHECK(vkEnumeratePhysicalDevices(instance, &count, &physical) == VK_SUCCESS);
+      CHECK(count == 1);
+      uint32_t family_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &family_count, NULL);
+      VkQueueFamilyProperties *families = calloc(family_count, sizeof(*families));
+      CHECK(families);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &family_count, families);
+      uint32_t family = 0;
+      while (family < family_count && !(families[family].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         family++;
+      CHECK(family < family_count);
+      free(families);
+      float priority = 1;
+      VkDeviceQueueCreateInfo qci = {.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+         .queueFamilyIndex = family, .queueCount = 1, .pQueuePriorities = &priority};
+      VkDeviceCreateInfo dci = {.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+         .queueCreateInfoCount = 1, .pQueueCreateInfos = &qci};
+      VkDevice device;
+      CHECK(vkCreateDevice(physical, &dci, NULL, &device) == VK_SUCCESS);
+      LOAD_D(vkDestroyDevice); LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkCreateCommandPool); LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkAllocateCommandBuffers);
+      LOAD_D(vkBeginCommandBuffer); LOAD_D(vkEndCommandBuffer);
+      LOAD_D(vkCreateBuffer); LOAD_D(vkDestroyBuffer); LOAD_D(vkGetBufferMemoryRequirements);
+      LOAD_D(vkAllocateMemory); LOAD_D(vkFreeMemory); LOAD_D(vkBindBufferMemory);
+      LOAD_D(vkMapMemory); LOAD_D(vkUnmapMemory); LOAD_D(vkCmdFillBuffer);
+      LOAD_D(vkQueueSubmit); LOAD_D(vkCreateFence); LOAD_D(vkWaitForFences); LOAD_D(vkDestroyFence);
+      VkQueue queue;
+      vkGetDeviceQueue(device, family, 0, &queue);
+      VkBufferCreateInfo bci = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+         .size = 4096, .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT};
+      VkBuffer buffer;
+      CHECK(vkCreateBuffer(device, &bci, NULL, &buffer) == VK_SUCCESS);
+      VkMemoryRequirements requirements;
+      vkGetBufferMemoryRequirements(device, buffer, &requirements);
+      VkPhysicalDeviceMemoryProperties properties;
+      vkGetPhysicalDeviceMemoryProperties(physical, &properties);
+      uint32_t type = 0;
+      const VkMemoryPropertyFlags required = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+      while (type < properties.memoryTypeCount &&
+             (!(requirements.memoryTypeBits & (1u << type)) ||
+              (properties.memoryTypes[type].propertyFlags & required) != required))
+         type++;
+      CHECK(type < properties.memoryTypeCount);
+      VkMemoryAllocateInfo mai = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+         .allocationSize = requirements.size, .memoryTypeIndex = type};
+      VkDeviceMemory memory;
+      CHECK(vkAllocateMemory(device, &mai, NULL, &memory) == VK_SUCCESS);
+      CHECK(vkBindBufferMemory(device, buffer, memory, 0) == VK_SUCCESS);
+      uint32_t *mapped;
+      CHECK(vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0, (void **)&mapped) == VK_SUCCESS);
+      /* Install a private queue before recording or submitting any work.
+       * Delayed feedback tests the distinct GPU-fence and host-callback clocks. */
+      struct kk_device *dev = kk_device_from_handle(device);
+      dispatch_queue_t feedback_queue = dispatch_queue_create(
+         "kosmickrisp.test.delayed-feedback", DISPATCH_QUEUE_SERIAL);
+      NSPointerArray *weak_feedback_queue = [NSPointerArray weakObjectsPointerArray];
+      [weak_feedback_queue addPointer:feedback_queue];
+      MTL4CommandQueueDescriptor *descriptor = [MTL4CommandQueueDescriptor new];
+      descriptor.feedbackQueue = feedback_queue;
+      id<MTL4CommandQueue> native_queue = [(id<MTLDevice>)dev->mtl_handle
+         newMTL4CommandQueueWithDescriptor:descriptor error:NULL];
+      /* Keep dispatch ownership separate from descriptor teardown. */
+      descriptor.feedbackQueue = NULL;
+      [descriptor release];
+      CHECK(native_queue != nil);
+      mtl_command_queue_remove_residency_set(dev->queue.mtl_handle,
+                                             dev->residency_set.handle);
+      mtl_release(dev->queue.mtl_handle);
+      mtl_release(dev->queue.feedback->queue);
+      dev->queue.mtl_handle = (mtl_command_queue *)native_queue;
+      dev->queue.feedback->queue = mtl_retain(native_queue);
+      mtl_command_queue_add_residency_set(dev->queue.mtl_handle,
+                                          dev->residency_set.handle);
+      NSPointerArray *weak_queue = [NSPointerArray weakObjectsPointerArray];
+      [weak_queue addPointer:native_queue];
+
+      VkCommandPoolCreateInfo pci = {.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+         .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT, .queueFamilyIndex = family};
+      VkCommandPool pool;
+      CHECK(vkCreateCommandPool(device, &pci, NULL, &pool) == VK_SUCCESS);
+      VkCommandBufferAllocateInfo cai = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+         .commandPool = pool, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY, .commandBufferCount = 1};
+      VkCommandBuffer command;
+      CHECK(vkAllocateCommandBuffers(device, &cai, &command) == VK_SUCCESS);
+      VkCommandBufferBeginInfo begin = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+         .flags = one_time ? VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT : 0};
+      const unsigned rounds = one_time ? 3 : 1;
+      for (unsigned round = 0; round < rounds; round++) {
+         CHECK(vkBeginCommandBuffer(command, &begin) == VK_SUCCESS);
+         uint32_t value = 0x13579bdf + round;
+         memset(mapped, 0, 4096);
+         vkCmdFillBuffer(command, buffer, 0, 4096, value);
+         CHECK(vkEndCommandBuffer(command) == VK_SUCCESS);
+         NSPointerArray *objects = watch_recording(command);
+         dispatch_semaphore_t gate = dispatch_semaphore_create(0);
+         dispatch_async(feedback_queue, ^{
+            CHECK(dispatch_semaphore_wait(gate,
+               dispatch_time(DISPATCH_TIME_NOW, 30000000000ull)) == 0);
+         });
+         VkFenceCreateInfo fci = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+         VkFence fence;
+         CHECK(vkCreateFence(device, &fci, NULL, &fence) == VK_SUCCESS);
+         VkSubmitInfo submit = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+            .commandBufferCount = 1, .pCommandBuffers = &command};
+         CHECK(vkQueueSubmit(queue, 1, &submit, fence) == VK_SUCCESS);
+         CHECK(vkWaitForFences(device, 1, &fence, VK_TRUE, 10000000000ull) == VK_SUCCESS);
+         for (unsigned i = 0; i < 1024; i++)
+            CHECK(mapped[i] == value);
+         vkDestroyFence(device, fence, NULL);
+         CHECK(live_objects(objects) == objects.count);
+         struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(command);
+         CHECK((cmd->gfx.allocator == NULL) == one_time);
+         CHECK((cmd->cmp[0].allocator == NULL) == one_time);
+         CHECK((cmd->cmp[1].allocator == NULL) == one_time);
+
+         if (round + 1 == rounds) {
+            /* Retain the real reporter context exactly as commit registration
+             * does. Synthetic feedback exercises late errors without a GPU hang. */
+            mtl_feedback_handler_callback callback = dev->queue.feedback_callback;
+            struct kk_queue_feedback *late_success =
+               kk_queue_feedback_ref(dev->queue.feedback);
+            struct kk_queue_feedback *late_error =
+               kk_queue_feedback_ref(dev->queue.feedback);
+            if (!one_time) {
+               struct mtl_feedback_data live_error = {
+                  .user_data = kk_queue_feedback_ref(dev->queue.feedback),
+                  .error = MTL_COMMAND_QUEUE_ERROR_INTERNAL,
+                  .error_message = "synthetic feedback before Vulkan teardown"};
+               callback(&live_error);
+               CHECK(p_atomic_read(&dev->vk._lost.lost) > 0);
+            }
+            vkDestroyCommandPool(device, pool, NULL);
+            vkUnmapMemory(device, memory);
+            vkDestroyBuffer(device, buffer, NULL);
+            vkFreeMemory(device, memory, NULL);
+            vkDestroyDevice(device, NULL);
+            vkDestroyInstance(instance, NULL);
+            if (one_time)
+               CHECK(live_objects(objects) == objects.count);
+            CHECK(late_error->device == NULL);
+            CHECK(live_objects(weak_queue) == 1);
+            struct mtl_feedback_data success = {.user_data = late_success,
+               .error = MTL_COMMAND_QUEUE_ERROR_NONE};
+            callback(&success);
+            struct mtl_feedback_data error = {.user_data = late_error,
+               .error = MTL_COMMAND_QUEUE_ERROR_INTERNAL,
+               .error_message = "synthetic feedback after Vulkan teardown"};
+            callback(&error);
+         }
+
+         dispatch_semaphore_signal(gate);
+         wait_released(objects);
+         dispatch_release(gate);
+         /* In early rounds the same Vulkan command buffer is still allocated.
+          * Begin must recreate native allocators and produce correct GPU data. */
+      }
+      wait_released(weak_queue);
+      dispatch_release(feedback_queue);
+      wait_released(weak_feedback_queue);
+   }
+}
+
+int main(void)
+{
+   run(false);
+   run(true);
+   return 0;
+}
