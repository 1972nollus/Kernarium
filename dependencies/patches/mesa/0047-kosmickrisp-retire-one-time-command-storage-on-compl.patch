 src/kosmickrisp/vulkan/kk_queue.h             |  20 ++
 src/kosmickrisp/vulkan/meson.build            |  22 ++
 .../vulkan/tests/test_command_completion.m    | 254 ++++++++++++++++++
 4 files changed, 423 insertions(+), 25 deletions(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_command_completion.m

