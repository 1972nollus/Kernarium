--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -21,38 +21,101 @@
 
 #include <stdio.h>
 
+static void
+kk_queue_feedback_unref(struct kk_queue_feedback *feedback)
+{
+   if (p_atomic_dec_zero(&feedback->refcount)) {
+      mtl_release(feedback->queue);
+      simple_mtx_destroy(&feedback->mutex);
+      free(feedback);
+   }
+}
+
 static void
 commit_callback(struct mtl_feedback_data *data)
 {
-   if (data->error == MTL_COMMAND_QUEUE_ERROR_NONE)
-      return;
+   struct kk_queue_feedback *feedback = data->user_data;
+   if (data->error != MTL_COMMAND_QUEUE_ERROR_NONE) {
+      char report[KK_QUEUE_ERROR_REPORT_SIZE];
+      kk_queue_error_describe(report, sizeof(report), data);
+      fprintf(stderr, "KosmicKrisp %s\n", report);
+
+      /* Device teardown clears this pointer under the same lock. Never carry
+       * a Vulkan pointer outside the lock into an asynchronous callback. */
+      if (kk_queue_error_is_device_lost(data)) {
+         simple_mtx_lock(&feedback->mutex);
+         if (feedback->device)
+            vk_device_set_lost(&feedback->device->vk, "Metal %s", report);
+         simple_mtx_unlock(&feedback->mutex);
+      }
+   }
+
+   if (feedback->submit_timing) {
+      /* These host-second timestamps cover the entire committed Metal batch.
+       * The immutable identifier remains usable after Vulkan device teardown. */
+      fprintf(stderr,
+              "KK_SUBMIT_TIMING device=%p gpu_start_s=%.17g gpu_end_s=%.17g error=%u\n",
+              (void *)feedback->device_id, data->gpu_start, data->gpu_end,
+              (unsigned)data->error);
+   }
+   kk_queue_feedback_unref(feedback);
+}
 
-   struct kk_device *dev = (struct kk_device *)data->user_data;
-   char report[KK_QUEUE_ERROR_REPORT_SIZE];
+/* One-time Vulkan recordings do not need their native command storage after
+ * GPU completion. This batch contains no Vulkan device or command buffer
+ * pointers, because either object can die before Metal dispatches feedback. */
+struct kk_completed_recording {
+   int refcount;
+   struct util_dynarray command_buffers;
+   mtl_command_allocator *allocators[3];
+   mtl_command_queue *queue;
+};
 
-   kk_queue_error_describe(report, sizeof(report), data);
-   fprintf(stderr, "KosmicKrisp %s\n", report);
+static void
+kk_completed_recording_unref(struct kk_completed_recording *recording)
+{
+   if (!p_atomic_dec_zero(&recording->refcount))
+      return;
 
-   /* A timeout Metal accounted for from start to finish leaves a live queue
-    * behind, so losing the device would discard every result that follows one
-    * contended submission. */
-   if (kk_queue_error_is_device_lost(data))
-      vk_device_set_lost(&dev->vk, "Metal %s", report);
+   util_dynarray_foreach(&recording->command_buffers, mtl_command_buffer *, cb)
+      mtl_release(*cb);
+   util_dynarray_fini(&recording->command_buffers);
+   for (unsigned i = 0; i < ARRAY_SIZE(recording->allocators); i++)
+      mtl_release(recording->allocators[i]);
+   mtl_release(recording->queue);
+   free(recording);
 }
 
 static void
-commit_timing_callback(struct mtl_feedback_data *data)
+kk_completed_recording_callback(struct mtl_feedback_data *data)
 {
-   commit_callback(data);
+   kk_completed_recording_unref(data->user_data);
+}
 
-   /* These host-second timestamps cover the entire committed Metal batch,
-    * including copies and clears. They are not Vulkan timestamp queries.
-    * The device address is an opaque identifier; do not dereference it here.
-    * KosmicKrisp exposes one command queue per device.
-    */
-   fprintf(stderr,
-           "KK_SUBMIT_TIMING device=%p gpu_start_s=%.17g gpu_end_s=%.17g error=%u\n",
-           data->user_data, data->gpu_start, data->gpu_end, (unsigned)data->error);
+static struct kk_completed_recording *
+kk_detach_completed_recording(struct kk_cmd_buffer *cmd,
+                              mtl_command_queue *queue)
+{
+   struct kk_completed_recording *recording = calloc(1, sizeof(*recording));
+   if (!recording)
+      return NULL;
+
+   /* Commit can dispatch feedback before returning. Keep the pointer array
+    * alive for both the submitter and the completion callback. Retaining the
+    * native queue keeps its feedback service alive through Vulkan teardown. */
+   recording->refcount = 2;
+   recording->queue = mtl_retain(queue);
+   recording->command_buffers = cmd->submit_cmd_bufs;
+   cmd->submit_cmd_bufs = UTIL_DYNARRAY_INIT;
+
+   struct kk_encoder_state *encoders[] = {&cmd->cmp[0], &cmd->gfx,
+                                          &cmd->cmp[1]};
+   for (unsigned i = 0; i < ARRAY_SIZE(encoders); i++) {
+      assert(encoders[i]->encoder == NULL && encoders[i]->cmd_buf == NULL);
+      recording->allocators[i] = encoders[i]->allocator;
+      encoders[i]->allocator = NULL;
+   }
+   return recording;
 }
 
 static void
@@ -119,10 +182,25 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
             return vk_queue_set_lost(&queue->vk,
                                      "Failed to allocate Metal commit options");
 
-         mtl_commit_options_add_feedback_handler(options,
-                                                 queue->feedback_callback, dev);
+         struct kk_completed_recording *recording = NULL;
+         if (cmd_buffer->one_time_submit) {
+            recording = kk_detach_completed_recording(cmd_buffer,
+                                                      queue->mtl_handle);
+            if (!recording) {
+               mtl_release(options);
+               return vk_queue_set_lost(&queue->vk,
+                                        "Failed to allocate Metal completion storage");
+            }
+            mtl_commit_options_add_feedback_handler(
+               options, kk_completed_recording_callback, recording);
+         }
+         mtl_commit_options_add_feedback_handler(
+            options, queue->feedback_callback,
+            kk_queue_feedback_ref(queue->feedback));
          mtl_command_queue_commit(queue->mtl_handle, cmds, count, options);
          mtl_release(options);
+         if (recording)
+            kk_completed_recording_unref(recording);
       }
 
       if (cmd_buffer->drawable) {
@@ -177,11 +255,29 @@ kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
    if (result != VK_SUCCESS)
       return result;
 
+   queue->feedback = calloc(1, sizeof(*queue->feedback));
+   if (!queue->feedback) {
+      vk_queue_finish(&queue->vk);
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+   queue->feedback->refcount = 1;
+   simple_mtx_init(&queue->feedback->mutex, mtx_plain);
+   queue->feedback->device = dev;
+   queue->feedback->device_id = (uintptr_t)dev;
+   queue->feedback->submit_timing = KK_DEBUG(SUBMIT_TIMING);
+   queue->feedback_callback = commit_callback;
+
    queue->mtl_handle = mtl_new_command_queue(dev->mtl_handle);
+   if (!queue->mtl_handle) {
+      kk_queue_feedback_unref(queue->feedback);
+      vk_queue_finish(&queue->vk);
+      return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   }
+   /* Pending reports must keep the native feedback service alive even when
+    * their command buffers use the reusable-recording path. */
+   queue->feedback->queue = mtl_retain(queue->mtl_handle);
    mtl_command_queue_add_residency_set(queue->mtl_handle,
                                        dev->residency_set.handle);
-   queue->feedback_callback = KK_DEBUG(SUBMIT_TIMING) ? commit_timing_callback
-                                                    : commit_callback;
 
    queue->vk.driver_submit = kk_queue_submit;
 
@@ -191,6 +287,12 @@ kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
 void
 kk_queue_finish(struct kk_device *dev, struct kk_queue *queue)
 {
+   simple_mtx_lock(&queue->feedback->mutex);
+   queue->feedback->device = NULL;
+   simple_mtx_unlock(&queue->feedback->mutex);
+   kk_queue_feedback_unref(queue->feedback);
+   queue->feedback = NULL;
+
    mtl_command_queue_remove_residency_set(queue->mtl_handle,
                                           dev->residency_set.handle);
    mtl_release(queue->mtl_handle);
diff --git a/src/kosmickrisp/vulkan/kk_queue.h b/src/kosmickrisp/vulkan/kk_queue.h
index 98535222..f35020cb 100644
--- a/src/kosmickrisp/vulkan/kk_queue.h
+++ b/src/kosmickrisp/vulkan/kk_queue.h
@@ -13,11 +13,31 @@
 #include "kosmickrisp/bridge/mtl_types.h"
 
 #include "vk_queue.h"
+#include "util/simple_mtx.h"
+
+/* Feedback can run after Vulkan device teardown. Only access device while
+ * holding mutex; device_id is an immutable identifier for independent logs. */
+struct kk_queue_feedback {
+   int refcount;
+   simple_mtx_t mutex;
+   struct kk_device *device;
+   mtl_command_queue *queue;
+   uintptr_t device_id;
+   bool submit_timing;
+};
+
+static inline struct kk_queue_feedback *
+kk_queue_feedback_ref(struct kk_queue_feedback *feedback)
+{
+   p_atomic_inc(&feedback->refcount);
+   return feedback;
+}
 
 struct kk_queue {
    struct vk_queue vk;
    struct mtl_command_queue *mtl_handle;
    mtl_feedback_handler_callback feedback_callback;
+   struct kk_queue_feedback *feedback;
 };
 
 static inline struct kk_device *
