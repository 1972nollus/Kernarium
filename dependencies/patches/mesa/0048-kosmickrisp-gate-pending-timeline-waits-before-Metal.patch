From ad24436a16e5a88f1a0d50b386eec1c72dd64fb5 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 9 Sep 2026 05:25:04 +0900
Subject: [PATCH 48/49] kosmickrisp: gate pending timeline waits before Metal
 submission

Use on-demand common submission for unsatisfied timeline waits so Metal cannot retire a native event wait before the host signals it. Move reusable binary payloads correctly and stop the worker before device resource destruction.

Keep absolute CPU wait deadlines while observing device loss, wake queue drains when submission fails, and allow lost-device cleanup of pending submissions. Cover delayed host signals, mixed binary waits, and loss during waits and drain.
---
 src/kosmickrisp/vulkan/kk_device.c            |  18 +-
 src/kosmickrisp/vulkan/kk_physical_device.c   |   1 +
 src/kosmickrisp/vulkan/kk_queue.c             |   4 +-
 src/kosmickrisp/vulkan/kk_sync.c              |  72 +++-
 src/kosmickrisp/vulkan/kk_sync.h              |   3 +
 src/kosmickrisp/vulkan/meson.build            |  57 +++
 .../vulkan/tests/test_timeline_host_wait.cpp  | 348 ++++++++++++++++++
 .../vulkan/tests/test_timeline_wait_loss.c    | 182 +++++++++
 src/vulkan/runtime/vk_queue.c                 |  25 +-
 9 files changed, 677 insertions(+), 33 deletions(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_timeline_host_wait.cpp
 create mode 100644 src/kosmickrisp/vulkan/tests/test_timeline_wait_loss.c

diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index 09c0985..fe6f29d 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -298,6 +298,13 @@ kk_CreateDevice(VkPhysicalDevice physicalDevice,
    if (result != VK_SUCCESS)
       goto fail_alloc;
 
+   /* CPU gating of unsatisfied timeline waits is required for correctness:
+    * Metal may retire a pending GPU event wait after a finite delay. Keep the
+    * common runtime's immediate fast path for satisfied waits, but do not let
+    * MESA_VK_ENABLE_SUBMIT_THREAD=false disable assisted submission. */
+   if (dev->vk.submit_mode == VK_QUEUE_SUBMIT_MODE_IMMEDIATE)
+      dev->vk.submit_mode = VK_QUEUE_SUBMIT_MODE_THREADED_ON_DEMAND;
+
    dev->vk.shader_ops = &kk_device_shader_ops;
    dev->mtl_handle = pdev->mtl_dev_handle;
    dev->vk.command_buffer_ops = &kk_cmd_buffer_ops;
@@ -393,6 +400,12 @@ kk_DestroyDevice(VkDevice _device, const VkAllocationCallbacks *pAllocator)
       mtl_stop_gpu_capture();
    }
 
+   /* Stop submission before freeing resources the worker may still use. */
+   if (dev->has_queue) {
+      kk_queue_finish(dev, &dev->queue);
+      dev->has_queue = false;
+   }
+
    /* Meta first since it may destroy Vulkan objects */
    kk_device_finish_meta(dev);
    kk_device_finish_lib(dev);
@@ -403,11 +416,6 @@ kk_DestroyDevice(VkDevice _device, const VkAllocationCallbacks *pAllocator)
    if (dev->heap)
       kk_destroy_bo(dev, dev->heap);
 
-   if (dev->has_queue) {
-      kk_queue_finish(dev, &dev->queue);
-      dev->has_queue = false;
-   }
-
    /* Release the residency set last once all BOs are released. */
    assert(list_is_empty(&dev->address_space.allocations));
    simple_mtx_destroy(&dev->address_space.mutex);
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index 28294b6..ef60081 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -1188,6 +1188,7 @@ kk_enumerate_physical_devices(struct vk_instance *_instance)
    assert(pdev->queue_family_count <= ARRAY_SIZE(pdev->queue_families));
 
    pdev->sync_binary_type = vk_sync_binary_get_type(&kk_sync_type);
+   pdev->sync_binary_type.sync.move = kk_sync_binary_move;
    unsigned st_idx = 0;
    pdev->sync_types[st_idx++] = &kk_sync_type;
    pdev->sync_types[st_idx++] = &pdev->sync_binary_type.sync;
diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index c4c41ae..9ee88f6 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -287,6 +287,9 @@ kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
 void
 kk_queue_finish(struct kk_device *dev, struct kk_queue *queue)
 {
+   /* Drain and join the submit worker before releasing its native resources. */
+   vk_queue_finish(&queue->vk);
+
    simple_mtx_lock(&queue->feedback->mutex);
    queue->feedback->device = NULL;
    simple_mtx_unlock(&queue->feedback->mutex);
@@ -296,5 +299,4 @@ kk_queue_finish(struct kk_device *dev, struct kk_queue *queue)
    mtl_command_queue_remove_residency_set(queue->mtl_handle,
                                           dev->residency_set.handle);
    mtl_release(queue->mtl_handle);
-   vk_queue_finish(&queue->vk);
 }
diff --git a/src/kosmickrisp/vulkan/kk_sync.c b/src/kosmickrisp/vulkan/kk_sync.c
index f44200c..4e1e0bd 100644
--- a/src/kosmickrisp/vulkan/kk_sync.c
+++ b/src/kosmickrisp/vulkan/kk_sync.c
@@ -7,6 +7,7 @@
 #include "kk_sync.h"
 
 #include "kk_device.h"
+#include "vk_sync_binary.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
 
@@ -60,34 +61,65 @@ kk_timeline_wait(struct vk_device *device, struct vk_sync *sync,
    struct kk_sync_timeline *timeline =
       container_of(sync, struct kk_sync_timeline, base);
 
-   /* abs_timeout_ns is the point in time when we should stop waiting, not the
-    * absolute time in ns. Therefore, we need to compute the delta from now to
-    * when we should stop waiting and convert to ms for Metal to be happy
-    * (Similar to what dzn does).
-    */
-   uint64_t timeout_ms = 0u;
-   if (abs_timeout_ns == OS_TIMEOUT_INFINITE) {
-      timeout_ms = OS_TIMEOUT_INFINITE;
-   } else {
-      uint64_t cur_time = os_time_get_nano();
-      uint64_t rel_timeout_ns =
-         abs_timeout_ns > cur_time ? abs_timeout_ns - cur_time : 0;
-
-      timeout_ms =
-         (rel_timeout_ns / 1000000) + (rel_timeout_ns % 1000000 ? 1 : 0);
+   for (;;) {
+      if (vk_device_is_lost_no_report(device))
+         return VK_ERROR_DEVICE_LOST;
+
+      /* Metal takes relative milliseconds; Vulkan provides an absolute
+       * nanosecond deadline. Recompute after every pending-wait slice. */
+      uint64_t timeout_ms;
+      if (abs_timeout_ns == OS_TIMEOUT_INFINITE) {
+         timeout_ms = OS_TIMEOUT_INFINITE;
+      } else {
+         uint64_t now = os_time_get_nano();
+         uint64_t remaining_ns =
+            abs_timeout_ns > now ? abs_timeout_ns - now : 0;
+         timeout_ms = remaining_ns / 1000000 +
+                      (remaining_ns % 1000000 ? 1 : 0);
+      }
+
+      /* Both the submit worker and QueueWaitIdle can wait indefinitely.
+       * Periodically observe device loss without changing their deadline. */
+      timeout_ms = MIN2(timeout_ms, 100);
+      int completed = mtl_shared_event_wait_until_signaled_value(
+         timeline->mtl_handle, wait_value, timeout_ms);
+      if (vk_device_is_lost_no_report(device))
+         return VK_ERROR_DEVICE_LOST;
+      if (completed)
+         return VK_SUCCESS;
+      if (abs_timeout_ns != OS_TIMEOUT_INFINITE &&
+          os_time_get_nano() >= abs_timeout_ns)
+         return VK_TIMEOUT;
    }
-   int completed = mtl_shared_event_wait_until_signaled_value(
-      timeline->mtl_handle, wait_value, timeout_ms);
+}
+
+VkResult
+kk_sync_binary_move(struct vk_device *device, struct vk_sync *dst_sync,
+                    struct vk_sync *src_sync)
+{
+   struct vk_sync_binary *dst = vk_sync_as_binary(dst_sync);
+   struct vk_sync_binary *src = vk_sync_as_binary(src_sync);
+   assert(dst && src);
+   struct kk_sync_timeline *dst_timeline =
+      container_of(&dst->timeline, struct kk_sync_timeline, base);
+   struct kk_sync_timeline *src_timeline =
+      container_of(&src->timeline, struct kk_sync_timeline, base);
 
-   return completed != 0 ? VK_SUCCESS : VK_TIMEOUT;
+   /* Move only the Metal payload and its current point, never the common sync
+    * headers. Reset the recycled destination payload for future source use. */
+   SWAP(dst_timeline->mtl_handle, src_timeline->mtl_handle);
+   SWAP(dst->next_point, src->next_point);
+   return vk_sync_reset(device, src_sync);
 }
 
 const struct vk_sync_type kk_sync_type = {
    .size = sizeof(struct kk_sync_timeline),
+   /* Metal GPU event waits cannot remain pending indefinitely. Assisted
+    * submission waits for completion on the CPU before enqueueing native work;
+    * completing a time point also satisfies VK_SYNC_WAIT_PENDING. */
    .features = VK_SYNC_FEATURE_TIMELINE | VK_SYNC_FEATURE_GPU_WAIT |
                VK_SYNC_FEATURE_CPU_WAIT | VK_SYNC_FEATURE_CPU_SIGNAL |
-               VK_SYNC_FEATURE_WAIT_PENDING |
-               VK_SYNC_FEATURE_WAIT_BEFORE_SIGNAL,
+               VK_SYNC_FEATURE_WAIT_PENDING,
    .init = kk_timeline_init,
    .finish = kk_timeline_finish,
    .signal = kk_timeline_signal,
diff --git a/src/kosmickrisp/vulkan/kk_sync.h b/src/kosmickrisp/vulkan/kk_sync.h
index da4f149..fd9081e 100644
--- a/src/kosmickrisp/vulkan/kk_sync.h
+++ b/src/kosmickrisp/vulkan/kk_sync.h
