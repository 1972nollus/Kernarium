+++ b/src/vulkan/runtime/vk_queue.c
@@ -729,6 +729,18 @@ done:
    return result;
 }
 
+static int
+vk_queue_submit_thread_fail(struct vk_queue *queue, const char *message)
+{
+   /* A drain may already be sleeping while the worker detects device loss.
+    * Publish the failure and wake it under the same mutex as its condition. */
+   mtx_lock(&queue->submit.mutex);
+   vk_queue_set_lost(queue, "%s", message);
+   cnd_broadcast(&queue->submit.pop);
+   mtx_unlock(&queue->submit.mutex);
+   return 1;
+}
+
 static int
 vk_queue_submit_thread_func(void *_data)
 {
@@ -742,8 +754,7 @@ vk_queue_submit_thread_func(void *_data)
          int ret = cnd_wait(&queue->submit.push, &queue->submit.mutex);
          if (ret == thrd_error) {
             mtx_unlock(&queue->submit.mutex);
-            vk_queue_set_lost(queue, "cnd_wait failed");
-            return 1;
+            return vk_queue_submit_thread_fail(queue, "cnd_wait failed");
          }
          continue;
       }
@@ -759,14 +770,12 @@ vk_queue_submit_thread_func(void *_data)
                                  submit->wait_count, submit->waits,
                                  VK_SYNC_WAIT_PENDING, UINT64_MAX);
       if (unlikely(result != VK_SUCCESS)) {
-         vk_queue_set_lost(queue, "Wait for time points failed");
-         return 1;
+         return vk_queue_submit_thread_fail(queue, "Wait for time points failed");
       }
 
       result = vk_queue_submit_final(queue, submit);
       if (unlikely(result != VK_SUCCESS)) {
-         vk_queue_set_lost(queue, "queue::driver_submit failed");
-         return 1;
+         return vk_queue_submit_thread_fail(queue, "queue::driver_submit failed");
       }
 
       /* Do all our cleanup of individual fences etc. outside the lock.
@@ -822,7 +831,9 @@ vk_queue_stop_submit_thread(struct vk_queue *queue)
 
    thrd_join(queue->submit.thread, NULL);
 
-   assert(list_is_empty(&queue->submit.submits));
+   /* Failed submissions are released by vk_queue_finish after the join. */
+   assert(list_is_empty(&queue->submit.submits) ||
+          vk_device_is_lost_no_report(queue->base.device));
    queue->submit.mode = VK_QUEUE_SUBMIT_MODE_IMMEDIATE;
 }
 
