index c4c41aea..e4ad0842 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -217,6 +217,9 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
          container_of(signal->sync, struct kk_sync_timeline, base);
       mtl_signal_event(queue->mtl_handle, sync->mtl_handle,
                        signal->signal_value);
+      /* The signal is now ordered on the native timeline, so later waits on
