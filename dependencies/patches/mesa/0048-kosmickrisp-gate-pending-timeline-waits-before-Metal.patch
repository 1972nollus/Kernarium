 struct kk_sync_timeline {
    struct vk_sync base;
    mtl_shared_event *mtl_handle;
+   /* Highest value whose signal operation has already been performed on the
+    * CPU or enqueued on the queue's Metal timeline. Any wait at or below it
+    * is pending in the common runtime's sense. */
+   uint64_t pending_value;
 };
 
 extern const struct vk_sync_type kk_sync_type;
 
+VkResult kk_sync_binary_move(struct vk_device *device, struct vk_sync *dst,
+                             struct vk_sync *src);
