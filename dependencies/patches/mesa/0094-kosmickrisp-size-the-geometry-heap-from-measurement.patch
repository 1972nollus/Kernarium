From f0e96f3a85310f82619b8287893e6df9f66e558d Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 18 Sep 2026 17:57:39 +0900
Subject: [PATCH 094/103] kosmickrisp: size the geometry heap from measurement

The per-device geometry heap was a fixed 128 MiB placement heap, taken whole
the first time a command buffer draws through it. The size was a placeholder,
not a bound, and a Venus host pays all of it once per guest VkDevice, so the
cost scales with however many devices a guest keeps alive.

Measured instead. The heaviest single command buffer across the CTS
tessellation, geometry, draw and rasterization groups asks the heap for
1.53 MiB. One mebibyte fails those groups and two passes them, so the floor
sits between the two. Sixteen leaves an order of magnitude over the measured
peak and ran a full released mustpass fraction clean.

Demand is linear in patches and primitives, which the API does not bound, so no
fixed size is safe for every application. MESA_KK_HEAP_SIZE_MIB raises it
without a rebuild.
---
 src/kosmickrisp/vulkan/kk_cmd_draw.c | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 4f867705..77900462 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -26,6 +26,8 @@
 
 #include "util/u_math.h"
 
+#include <stdlib.h>
+
 #include "poly/geometry.h"
 #include "poly/tessellator.h"
 
@@ -1117,7 +1119,24 @@ kk_init_heap(const void *data)
    struct kk_cmd_buffer *cmd = (struct kk_cmd_buffer *)data;
    struct kk_device *dev = kk_cmd_buffer_device(cmd);
 
-   size_t size = 128 * 1024 * 1024;
+   /* Measured, not guessed. The heaviest command buffer in the CTS
+    * tessellation, geometry, draw and rasterization groups asks this heap for
+    * 1.53 MiB; 1 MiB fails those groups and 2 MiB passes them. Sixteen gives an
+    * order of magnitude over the measured peak. The previous 128 MiB was a
+    * placeholder, and a Venus host pays the whole of it once per guest
+    * VkDevice.
+    *
+    * Demand is linear in patches and primitives, which the API does not bound,
+    * so no fixed size is safe for every application, and an overrun ends as a
+    * GPU-side abort rather than a diagnosable error. MESA_KK_HEAP_SIZE_MIB
+    * raises the size without a rebuild. */
+   size_t size = 16 * 1024 * 1024;
+   const char *size_override = getenv("MESA_KK_HEAP_SIZE_MIB");
+   if (size_override != NULL) {
+      long requested = strtol(size_override, NULL, 10);
+      if (requested > 0)
+         size = (size_t)requested * 1024 * 1024;
+   }
    kk_alloc_bo(dev, &dev->vk.base, size, 0, &dev->heap);
 
    struct poly_heap *map = (struct poly_heap *)dev->heap->cpu;
