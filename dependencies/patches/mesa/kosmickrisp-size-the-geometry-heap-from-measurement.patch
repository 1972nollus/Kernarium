+/* The pinned heap's GPU address, for a stage about to reserve from it. A
+ * draw pins the heap before recording its stages, but a render encoder that
+ * restarts between the entries of a multi-draw begins a segment that pins it
+ * again. */
+static uint64_t
+kk_heap(struct kk_cmd_buffer *cmd)
+{
+   if (!cmd->heap_in_segment && !kk_heap_prepare(cmd, 0))
+      return 0;
+
+   return cmd->heap->bo->gpu;
+}
