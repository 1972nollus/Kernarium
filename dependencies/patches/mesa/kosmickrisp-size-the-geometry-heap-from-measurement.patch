+++ b/src/kosmickrisp/vulkan/tests/test_heap_growth.c
@@ -0,0 +1,502 @@
+/* SPDX-License-Identifier: MIT */
+
+/* The geometry heap grows for draws that need more than it holds.
+ *
+ * A direct draw whose reservations the host can bound, a triangle fan the
+ * driver unrolls through the heap or a tessellated draw at the level-64
+ * maximum, renders whole on its first submission. An indirect draw is sized
+ * only on the GPU: its first submission loses its output, which the device
+ * reports, and a later submission of the same command buffer renders whole.
+ * Each case runs on a device of its own at the default 16 MiB and reports the
+ * heap it leaves. A device that never draws through the heap has none. */
+
+#define VK_NO_PROTOTYPES
+#include "kk_bo.h"
+#include "kk_device.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define VK_CHECK(x) CHECK((x) == VK_SUCCESS)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+static const uint32_t fullscreen_spirv[] =
+#include "statistics_shaders/fullscreen.vert.h"
+   ;
+static const uint32_t point_spirv[] =
+#include "geometry_draw_size_shaders/points.vert.h"
+   ;
+static const uint32_t control_spirv[] =
+#include "heap_growth_shaders/level64.tesc.h"
+   ;
+static const uint32_t evaluation_spirv[] =
+#include "heap_growth_shaders/tile.tese.h"
+   ;
+static const uint32_t red_spirv[] =
+#include "alpha_to_coverage_shaders/a2c_red.frag.h"
+   ;
+
+/* A 16 x 16 grid of 4 x 4 tiles, one per patch. */
+#define EXTENT 64u
+#define TILE_TEXELS 16u
+/* 2,000,000 vertices unroll to 1,999,998 triangles of three 4-byte indices,
+ * 24 MB, past the 16 MiB default. */
+#define FAN_VERTICES 2000000u
+
+enum draw_kind {
+   /* A triangle list, which needs no heap. */
+   LIST,
+   /* A triangle fan, which the driver unrolls through the heap. */
+   FAN,
+   /* One-vertex quad patches at level 64, each covering its own tile. */
+   TESS,
+};
+
+struct outcome {
+   uint32_t red[2];
+   uint64_t heap_B;
+   bool loss_reported;
+};
+
+/* Draws count vertices, and then second more in the same render pass when it
+ * is not zero, indirectly or not, and submits the command buffer the given
+ * number of times. */
+static struct outcome
+run(VkInstance instance, VkPhysicalDevice physical, enum draw_kind kind,
+    uint32_t count, uint32_t second, bool indirect, unsigned submissions)
+{
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   const float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   VkPhysicalDeviceVulkan13Features features13 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
+      .dynamicRendering = VK_TRUE,
+   };
+   VkPhysicalDeviceFeatures features = {
+      .tessellationShader = kind == TESS,
+   };
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &features13,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+      .pEnabledFeatures = &features,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   VK_CHECK(vkCreateDevice(physical, &device_info, NULL, &device));
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkGetDeviceQueue);
+   LOAD_D(vkCreateShaderModule);
+   LOAD_D(vkDestroyShaderModule);
+   LOAD_D(vkCreatePipelineLayout);
+   LOAD_D(vkDestroyPipelineLayout);
+   LOAD_D(vkCreateGraphicsPipelines);
+   LOAD_D(vkDestroyPipeline);
+   LOAD_D(vkCreateImage);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkGetImageMemoryRequirements);
+   LOAD_D(vkAllocateMemory);
+   LOAD_D(vkFreeMemory);
+   LOAD_D(vkBindImageMemory);
+   LOAD_D(vkCreateImageView);
+   LOAD_D(vkDestroyImageView);
+   LOAD_D(vkCreateBuffer);
+   LOAD_D(vkDestroyBuffer);
+   LOAD_D(vkGetBufferMemoryRequirements);
+   LOAD_D(vkBindBufferMemory);
+   LOAD_D(vkMapMemory);
+   LOAD_D(vkCreateCommandPool);
+   LOAD_D(vkDestroyCommandPool);
+   LOAD_D(vkAllocateCommandBuffers);
+   LOAD_D(vkBeginCommandBuffer);
+   LOAD_D(vkEndCommandBuffer);
+   LOAD_D(vkCmdBeginRendering);
+   LOAD_D(vkCmdEndRendering);
+   LOAD_D(vkCmdBindPipeline);
+   LOAD_D(vkCmdDraw);
+   LOAD_D(vkCmdDrawIndirect);
+   LOAD_D(vkCmdPipelineBarrier);
+   LOAD_D(vkCmdCopyImageToBuffer);
+   LOAD_D(vkQueueSubmit);
+   LOAD_D(vkQueueWaitIdle);
+   VkQueue queue = VK_NULL_HANDLE;
+   vkGetDeviceQueue(device, 0, 0, &queue);
+   VkPhysicalDeviceMemoryProperties memory_properties;
+   vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+
+   const VkFormat format = VK_FORMAT_R8G8B8A8_UNORM;
+   VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = format,
+      .extent = {EXTENT, EXTENT, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage =
+         VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+   };
+   VkImage image = VK_NULL_HANDLE;
+   VK_CHECK(vkCreateImage(device, &image_info, NULL, &image));
+   VkMemoryRequirements image_requirements;
+   vkGetImageMemoryRequirements(device, image, &image_requirements);
+   uint32_t image_type = 0u;
+   while (image_type < memory_properties.memoryTypeCount &&
+          !(image_requirements.memoryTypeBits & (1u << image_type)))
+      image_type++;
+   CHECK(image_type < memory_properties.memoryTypeCount);
+   VkMemoryAllocateInfo image_allocate = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = image_requirements.size,
+      .memoryTypeIndex = image_type,
+   };
+   VkDeviceMemory image_memory = VK_NULL_HANDLE;
+   VK_CHECK(vkAllocateMemory(device, &image_allocate, NULL, &image_memory));
+   VK_CHECK(vkBindImageMemory(device, image, image_memory, 0));
+   VkImageViewCreateInfo view_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .image = image,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = format,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+   };
+   VkImageView view = VK_NULL_HANDLE;
+   VK_CHECK(vkCreateImageView(device, &view_info, NULL, &view));
+
+   /* One host-visible buffer holds the pixels and, after them, the indirect
+    * draw. */
+   const VkDeviceSize pixels_B = EXTENT * EXTENT * 4u;
+   VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = pixels_B + sizeof(VkDrawIndirectCommand),
+      .usage =
+         VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT,
+   };
+   VkBuffer buffer = VK_NULL_HANDLE;
+   VK_CHECK(vkCreateBuffer(device, &buffer_info, NULL, &buffer));
+   VkMemoryRequirements buffer_requirements;
+   vkGetBufferMemoryRequirements(device, buffer, &buffer_requirements);
+   const VkMemoryPropertyFlags host =
+      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   uint32_t buffer_type = 0u;
+   while (buffer_type < memory_properties.memoryTypeCount &&
+          (!(buffer_requirements.memoryTypeBits & (1u << buffer_type)) ||
+           (memory_properties.memoryTypes[buffer_type].propertyFlags & host) !=
+              host))
+      buffer_type++;
+   CHECK(buffer_type < memory_properties.memoryTypeCount);
+   VkMemoryAllocateInfo buffer_allocate = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = buffer_requirements.size,
+      .memoryTypeIndex = buffer_type,
+   };
+   VkDeviceMemory buffer_memory = VK_NULL_HANDLE;
+   VK_CHECK(vkAllocateMemory(device, &buffer_allocate, NULL, &buffer_memory));
+   VK_CHECK(vkBindBufferMemory(device, buffer, buffer_memory, 0));
+   uint8_t *pixels = NULL;
+   VK_CHECK(vkMapMemory(device, buffer_memory, 0, VK_WHOLE_SIZE, 0,
+                        (void **)&pixels));
+   const VkDrawIndirectCommand draw = {count, 1, 0, 0};
+   memcpy(pixels + pixels_B, &draw, sizeof(draw));
+
+   const uint32_t *codes[4] = {
+      kind == TESS ? point_spirv : fullscreen_spirv,
+      control_spirv,
+      evaluation_spirv,
+      red_spirv,
+   };
+   const size_t sizes[4] = {
+      kind == TESS ? sizeof(point_spirv) : sizeof(fullscreen_spirv),
+      sizeof(control_spirv),
+      sizeof(evaluation_spirv),
+      sizeof(red_spirv),
+   };
+   const VkShaderStageFlagBits stage_bits[4] = {
+      VK_SHADER_STAGE_VERTEX_BIT,
+      VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT,
+      VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT,
+      VK_SHADER_STAGE_FRAGMENT_BIT,
+   };
+   VkShaderModule modules[4] = {VK_NULL_HANDLE};
+   VkPipelineShaderStageCreateInfo stages[4];
+   uint32_t stage_count = 0u;
+   for (uint32_t i = 0u; i < 4u; i++) {
+      if (kind != TESS && (i == 1u || i == 2u))
+         continue;
+      VkShaderModuleCreateInfo module_info = {
+         .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+         .codeSize = sizes[i],
+         .pCode = codes[i],
+      };
+      VK_CHECK(vkCreateShaderModule(device, &module_info, NULL, &modules[i]));
+      stages[stage_count++] = (VkPipelineShaderStageCreateInfo){
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .stage = stage_bits[i],
+         .module = modules[i],
+         .pName = "main",
+      };
+   }
+   VkPipelineLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+   };
+   VkPipelineLayout layout = VK_NULL_HANDLE;
+   VK_CHECK(vkCreatePipelineLayout(device, &layout_info, NULL, &layout));
+   VkPipelineVertexInputStateCreateInfo vertex_input = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO,
+   };
+   VkPipelineInputAssemblyStateCreateInfo assembly = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+      .topology = kind == TESS  ? VK_PRIMITIVE_TOPOLOGY_PATCH_LIST
+                  : kind == FAN ? VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN
+                                : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
+   };
+   VkPipelineTessellationStateCreateInfo tessellation = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_TESSELLATION_STATE_CREATE_INFO,
+      .patchControlPoints = 1,
+   };
+   VkViewport viewport = {0, 0, EXTENT, EXTENT, 0, 1};
+   VkRect2D scissor = {{0, 0}, {EXTENT, EXTENT}};
+   VkPipelineViewportStateCreateInfo viewport_state = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+      .viewportCount = 1,
+      .pViewports = &viewport,
+      .scissorCount = 1,
+      .pScissors = &scissor,
+   };
+   VkPipelineRasterizationStateCreateInfo raster = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+      .polygonMode = VK_POLYGON_MODE_FILL,
+      .cullMode = VK_CULL_MODE_NONE,
+      .lineWidth = 1,
+   };
+   VkPipelineMultisampleStateCreateInfo multisample = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+      .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT,
+   };
+   VkPipelineColorBlendAttachmentState blend_attachment = {
+      .colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+                        VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT,
+   };
+   VkPipelineColorBlendStateCreateInfo blend = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+      .attachmentCount = 1,
+      .pAttachments = &blend_attachment,
+   };
+   VkPipelineRenderingCreateInfo rendering_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+      .colorAttachmentCount = 1,
+      .pColorAttachmentFormats = &format,
+   };
+   VkGraphicsPipelineCreateInfo pipeline_info = {
+      .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+      .pNext = &rendering_info,
+      .stageCount = stage_count,
+      .pStages = stages,
+      .pVertexInputState = &vertex_input,
+      .pInputAssemblyState = &assembly,
+      .pTessellationState = kind == TESS ? &tessellation : NULL,
+      .pViewportState = &viewport_state,
+      .pRasterizationState = &raster,
+      .pMultisampleState = &multisample,
+      .pColorBlendState = &blend,
+      .layout = layout,
+   };
+   VkPipeline pipeline = VK_NULL_HANDLE;
+   VK_CHECK(vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                      &pipeline_info, NULL, &pipeline));
+
+   VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = 0,
+   };
+   VkCommandPool pool = VK_NULL_HANDLE;
+   VK_CHECK(vkCreateCommandPool(device, &pool_info, NULL, &pool));
+   VkCommandBufferAllocateInfo command_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   VkCommandBuffer commands = VK_NULL_HANDLE;
+   VK_CHECK(vkAllocateCommandBuffers(device, &command_info, &commands));
+   /* Not one-time: a second submission records the commands again. */
+   VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+   };
+   VK_CHECK(vkBeginCommandBuffer(commands, &begin));
+   VkRenderingAttachmentInfo color_attachment = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+      .imageView = view,
+      .imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+      .loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR,
+      .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+   };
+   VkRenderingInfo rendering = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+      .renderArea = scissor,
+      .layerCount = 1,
+      .colorAttachmentCount = 1,
+      .pColorAttachments = &color_attachment,
+   };
+   vkCmdBeginRendering(commands, &rendering);
+   vkCmdBindPipeline(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+   if (indirect)
+      vkCmdDrawIndirect(commands, buffer, pixels_B, 1, 0);
+   else
+      vkCmdDraw(commands, count, 1, 0, 0);
+   if (second != 0u)
+      vkCmdDraw(commands, second, 1, 0, 0);
+   vkCmdEndRendering(commands);
+   VkImageMemoryBarrier to_transfer = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+      .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = image,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+   };
+   vkCmdPipelineBarrier(commands, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1,
+                        &to_transfer);
+   VkBufferImageCopy copy = {
+      .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+      .imageExtent = {EXTENT, EXTENT, 1},
+   };
+   vkCmdCopyImageToBuffer(commands, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                          buffer, 1, &copy);
+   VK_CHECK(vkEndCommandBuffer(commands));
+
+   struct outcome outcome = {0};
+   VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &commands,
+   };
+   for (unsigned s = 0u; s < submissions; s++) {
+      memset(pixels, 0, (size_t)pixels_B);
+      VK_CHECK(vkQueueSubmit(queue, 1, &submit, VK_NULL_HANDLE));
+      VK_CHECK(vkQueueWaitIdle(queue));
+      for (uint32_t texel = 0u; texel < EXTENT * EXTENT; texel++) {
+         if (pixels[texel * 4u] == 255u && pixels[texel * 4u + 1u] == 0u &&
+             pixels[texel * 4u + 3u] == 255u)
+            outcome.red[s]++;
+      }
+   }
+
+   /* Freeing the command buffer reads the refusals of the last submission. */
+   vkDestroyCommandPool(device, pool, NULL);
+   struct kk_device *dev = kk_device_from_handle(device);
+   outcome.heap_B = dev->heap ? dev->heap->bo->size_B : 0u;
+   outcome.loss_reported = dev->heap_loss_reported;
+
+   vkDestroyPipeline(device, pipeline, NULL);
+   vkDestroyPipelineLayout(device, layout, NULL);
+   for (uint32_t i = 0u; i < 4u; i++) {
+      if (modules[i] != VK_NULL_HANDLE)
+         vkDestroyShaderModule(device, modules[i], NULL);
+   }
+   vkDestroyBuffer(device, buffer, NULL);
+   vkFreeMemory(device, buffer_memory, NULL);
+   vkDestroyImageView(device, view, NULL);
+   vkDestroyImage(device, image, NULL);
+   vkFreeMemory(device, image_memory, NULL);
+   vkDestroyDevice(device, NULL);
+   return outcome;
+}
+
+static const char *const kind_names[] = {"list", "fan", "tess"};
+
+static struct outcome
+report(VkInstance instance, VkPhysicalDevice physical, enum draw_kind kind,
+       uint32_t count, uint32_t second, bool indirect, unsigned submissions)
+{
+   struct outcome outcome =
+      run(instance, physical, kind, count, second, indirect, submissions);
+   printf("%s %s %u", indirect ? "indirect" : "direct", kind_names[kind],
+          count);
+   if (second != 0u)
+      printf(" then %u", second);
+   printf(":");
+   for (unsigned s = 0u; s < submissions; s++)
+      printf(" submission %u %u red,", s + 1u, outcome.red[s]);
+   printf(" heap %llu MiB%s\n", (unsigned long long)(outcome.heap_B >> 20),
+          outcome.loss_reported ? ", loss reported" : "");
+   return outcome;
+}
+
+int
+main(void)
+{
+   setvbuf(stdout, NULL, _IONBF, 0);
+   unsetenv("MESA_KK_HEAP_SIZE_MIB");
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   VK_CHECK(vkCreateInstance(&instance_info, NULL, &instance));
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   uint32_t count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   VkResult enumerated =
+      vkEnumeratePhysicalDevices(instance, &count, &physical);
+   CHECK((enumerated == VK_SUCCESS || enumerated == VK_INCOMPLETE) && count);
+
+   const uint32_t full = EXTENT * EXTENT;
+
+   /* A device that never draws through the heap allocates none, and one
+    * whose draws fit keeps the 16 MiB it started with. */
+   struct outcome o = report(instance, physical, LIST, 3, 0, false, 1);
+   CHECK(o.red[0] == full && o.heap_B == 0u && !o.loss_reported);
+   o = report(instance, physical, FAN, 3, 0, false, 1);
+   CHECK(o.red[0] == full && o.heap_B == 16u << 20 && !o.loss_reported);
+
+   /* The fan's unroll needs 24 MB. Direct, it grows the heap first; indirect,
+    * only the GPU knows its size, so the first submission loses it. */
+   o = report(instance, physical, FAN, FAN_VERTICES, 0, false, 1);
+   CHECK(o.red[0] == full && o.heap_B > 16u << 20 && !o.loss_reported);
+   o = report(instance, physical, FAN, FAN_VERTICES, 0, true, 2);
+   CHECK(o.red[0] < full && o.red[1] == full && o.heap_B > 16u << 20 &&
+         o.loss_reported);
+
+   /* 130 patches at level 64 need 17.2 MB and 256 need 33.8 MB. */
+   const uint32_t patches[2] = {130u, 256u};
+   for (unsigned i = 0u; i < 2u; i++) {
+      const uint32_t tiles = patches[i] * TILE_TEXELS;
+      o = report(instance, physical, TESS, patches[i], 0, false, 1);
+      CHECK(o.red[0] == tiles && o.heap_B > 16u << 20 && !o.loss_reported);
+      o = report(instance, physical, TESS, patches[i], 0, true, 2);
+      CHECK(o.red[0] < tiles && o.red[1] == tiles && o.heap_B > 16u << 20 &&
+            o.loss_reported);
+   }
+
+   /* 100 and then 120 patches each fit the 16 MiB heap but not together. The
+    * second draw moves the render pass to a grown heap instead of being lost:
+    * it covers 120 tiles, the first 100 of them the first draw's. */
+   o = report(instance, physical, TESS, 100u, 120u, false, 1);
+   CHECK(o.red[0] == 120u * TILE_TEXELS && o.heap_B > 16u << 20 &&
+         !o.loss_reported);
+
+   vkDestroyInstance(instance, NULL);
+   printf("the geometry heap grows for the draws that need it\n");
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_heap_size_override.c b/src/kosmickrisp/vulkan/tests/test_heap_size_override.c
new file mode 100644
index 0000000000000000000000000000000000000000..74f4550aa8d23cdff7c39cc3e36adde362e813e0
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_heap_size_override.c
@@ -0,0 +1,418 @@
+/* SPDX-License-Identifier: MIT */
+
+/* The device heap the emulated stages allocate from is sized by
+ * MESA_KK_HEAP_SIZE_MIB when it is set. The size reaches the GPU allocator as
+ * a 32-bit bound, so only 1 to 4095 MiB can be honoured: a value that wraps
+ * the byte count to zero, one Metal refuses and one past 4 GiB must all fall
+ * back to the default instead of crashing the first draw that needs the heap
+ * or leaving the GPU a bound larger than the heap. Each case draws a triangle
+ * fan, which is unrolled through the heap, on a device of its own. */
+
+#define VK_NO_PROTOTYPES
+#include "kk_bo.h"
+#include "kk_device.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+static const uint32_t vertex_spirv[] =
+#include "statistics_shaders/fullscreen.vert.h"
+   ;
+static const uint32_t fragment_spirv[] =
+#include "alpha_to_coverage_shaders/a2c_red.frag.h"
+   ;
+
+#define EXTENT      32u
+#define DEFAULT_MIB 16u
+
+/* The header the driver writes at the start of the heap: struct poly_heap. */
+struct heap_header {
+   uint64_t base;
+   uint32_t bottom;
+   uint32_t size;
+   uint32_t refusals;
+   uint32_t refused_units;
+   uint32_t pad[2];
+};
+
+static const struct {
+   const char *value;
+   uint32_t mib;
+} cases[] = {
+   {NULL, DEFAULT_MIB},
+   {"2", 2u},
+   {"0", DEFAULT_MIB},
+   {"-8", DEFAULT_MIB},
+   /* 2^44 MiB is 2^64 bytes, which wraps to zero. */
+   {"17592186044416", DEFAULT_MIB},
+   /* Far more than Metal will make. */
+   {"1000000", DEFAULT_MIB},
+   /* Past the 32-bit bound. */
+   {"4096", DEFAULT_MIB},
+};
+
+static uint32_t
+draw_fan(VkInstance instance, VkPhysicalDevice physical, uint32_t *heap_size)
+{
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   const float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   VkPhysicalDeviceVulkan13Features features13 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
+      .dynamicRendering = VK_TRUE,
+   };
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &features13,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   CHECK(vkCreateDevice(physical, &device_info, NULL, &device) == VK_SUCCESS);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkGetDeviceQueue);
+   LOAD_D(vkCreateShaderModule);
+   LOAD_D(vkDestroyShaderModule);
+   LOAD_D(vkCreatePipelineLayout);
+   LOAD_D(vkDestroyPipelineLayout);
+   LOAD_D(vkCreateGraphicsPipelines);
+   LOAD_D(vkDestroyPipeline);
+   LOAD_D(vkCreateImage);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkGetImageMemoryRequirements);
+   LOAD_D(vkAllocateMemory);
+   LOAD_D(vkFreeMemory);
+   LOAD_D(vkBindImageMemory);
+   LOAD_D(vkCreateImageView);
+   LOAD_D(vkDestroyImageView);
+   LOAD_D(vkCreateBuffer);
+   LOAD_D(vkDestroyBuffer);
+   LOAD_D(vkGetBufferMemoryRequirements);
+   LOAD_D(vkBindBufferMemory);
+   LOAD_D(vkMapMemory);
+   LOAD_D(vkCreateCommandPool);
+   LOAD_D(vkDestroyCommandPool);
+   LOAD_D(vkAllocateCommandBuffers);
+   LOAD_D(vkBeginCommandBuffer);
+   LOAD_D(vkEndCommandBuffer);
+   LOAD_D(vkCmdBeginRendering);
+   LOAD_D(vkCmdEndRendering);
+   LOAD_D(vkCmdBindPipeline);
+   LOAD_D(vkCmdDraw);
+   LOAD_D(vkCmdPipelineBarrier);
+   LOAD_D(vkCmdCopyImageToBuffer);
+   LOAD_D(vkQueueSubmit);
+   LOAD_D(vkQueueWaitIdle);
+   VkQueue queue = VK_NULL_HANDLE;
+   vkGetDeviceQueue(device, 0, 0, &queue);
+   VkPhysicalDeviceMemoryProperties memory_properties;
+   vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+
+   const VkFormat format = VK_FORMAT_R8G8B8A8_UNORM;
+   VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = format,
+      .extent = {EXTENT, EXTENT, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage =
+         VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+   };
+   VkImage image = VK_NULL_HANDLE;
+   CHECK(vkCreateImage(device, &image_info, NULL, &image) == VK_SUCCESS);
+   VkMemoryRequirements image_requirements;
+   vkGetImageMemoryRequirements(device, image, &image_requirements);
+   uint32_t image_type = 0u;
+   while (image_type < memory_properties.memoryTypeCount &&
+          !(image_requirements.memoryTypeBits & (1u << image_type)))
+      image_type++;
+   CHECK(image_type < memory_properties.memoryTypeCount);
+   VkMemoryAllocateInfo image_allocate = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = image_requirements.size,
+      .memoryTypeIndex = image_type,
+   };
+   VkDeviceMemory image_memory = VK_NULL_HANDLE;
+   CHECK(vkAllocateMemory(device, &image_allocate, NULL, &image_memory) ==
+         VK_SUCCESS);
+   CHECK(vkBindImageMemory(device, image, image_memory, 0) == VK_SUCCESS);
+   VkImageViewCreateInfo view_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .image = image,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = format,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+   };
+   VkImageView view = VK_NULL_HANDLE;
+   CHECK(vkCreateImageView(device, &view_info, NULL, &view) == VK_SUCCESS);
+
+   VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = EXTENT * EXTENT * 4u,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+   };
+   VkBuffer buffer = VK_NULL_HANDLE;
+   CHECK(vkCreateBuffer(device, &buffer_info, NULL, &buffer) == VK_SUCCESS);
+   VkMemoryRequirements buffer_requirements;
+   vkGetBufferMemoryRequirements(device, buffer, &buffer_requirements);
+   const VkMemoryPropertyFlags host =
+      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   uint32_t buffer_type = 0u;
+   while (buffer_type < memory_properties.memoryTypeCount &&
+          (!(buffer_requirements.memoryTypeBits & (1u << buffer_type)) ||
+           (memory_properties.memoryTypes[buffer_type].propertyFlags & host) !=
+              host))
+      buffer_type++;
+   CHECK(buffer_type < memory_properties.memoryTypeCount);
+   VkMemoryAllocateInfo buffer_allocate = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = buffer_requirements.size,
+      .memoryTypeIndex = buffer_type,
+   };
+   VkDeviceMemory buffer_memory = VK_NULL_HANDLE;
+   CHECK(vkAllocateMemory(device, &buffer_allocate, NULL, &buffer_memory) ==
+         VK_SUCCESS);
+   CHECK(vkBindBufferMemory(device, buffer, buffer_memory, 0) == VK_SUCCESS);
+   uint8_t *pixels = NULL;
+   CHECK(vkMapMemory(device, buffer_memory, 0, VK_WHOLE_SIZE, 0,
+                     (void **)&pixels) == VK_SUCCESS);
+   memset(pixels, 0, (size_t)buffer_info.size);
+
+   VkShaderModuleCreateInfo module_info = {
+      .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+      .codeSize = sizeof(vertex_spirv),
+      .pCode = vertex_spirv,
+   };
+   VkShaderModule vertex_module = VK_NULL_HANDLE;
+   CHECK(vkCreateShaderModule(device, &module_info, NULL, &vertex_module) ==
+         VK_SUCCESS);
+   module_info.codeSize = sizeof(fragment_spirv);
+   module_info.pCode = fragment_spirv;
+   VkShaderModule fragment_module = VK_NULL_HANDLE;
+   CHECK(vkCreateShaderModule(device, &module_info, NULL, &fragment_module) ==
+         VK_SUCCESS);
+   VkPipelineLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+   };
+   VkPipelineLayout layout = VK_NULL_HANDLE;
+   CHECK(vkCreatePipelineLayout(device, &layout_info, NULL, &layout) ==
+         VK_SUCCESS);
+   VkPipelineShaderStageCreateInfo stages[2] = {
+      {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+       .stage = VK_SHADER_STAGE_VERTEX_BIT,
+       .module = vertex_module,
+       .pName = "main"},
+      {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+       .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+       .module = fragment_module,
+       .pName = "main"},
+   };
+   VkPipelineVertexInputStateCreateInfo vertex_input = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO,
+   };
+   /* Metal has no fans, so the driver unrolls this one through the heap. */
+   VkPipelineInputAssemblyStateCreateInfo assembly = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+      .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN,
+   };
+   VkViewport viewport = {0, 0, EXTENT, EXTENT, 0, 1};
+   VkRect2D scissor = {{0, 0}, {EXTENT, EXTENT}};
+   VkPipelineViewportStateCreateInfo viewport_state = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+      .viewportCount = 1,
+      .pViewports = &viewport,
+      .scissorCount = 1,
+      .pScissors = &scissor,
+   };
+   VkPipelineRasterizationStateCreateInfo raster = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+      .polygonMode = VK_POLYGON_MODE_FILL,
+      .cullMode = VK_CULL_MODE_NONE,
+      .lineWidth = 1,
+   };
+   VkPipelineMultisampleStateCreateInfo multisample = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+      .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT,
+   };
+   VkPipelineColorBlendAttachmentState blend_attachment = {
+      .colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+                        VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT,
+   };
+   VkPipelineColorBlendStateCreateInfo blend = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+      .attachmentCount = 1,
+      .pAttachments = &blend_attachment,
+   };
+   VkPipelineRenderingCreateInfo rendering_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+      .colorAttachmentCount = 1,
+      .pColorAttachmentFormats = &format,
+   };
+   VkGraphicsPipelineCreateInfo pipeline_info = {
+      .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+      .pNext = &rendering_info,
+      .stageCount = 2,
+      .pStages = stages,
+      .pVertexInputState = &vertex_input,
+      .pInputAssemblyState = &assembly,
+      .pViewportState = &viewport_state,
+      .pRasterizationState = &raster,
+      .pMultisampleState = &multisample,
+      .pColorBlendState = &blend,
+      .layout = layout,
+   };
+   VkPipeline pipeline = VK_NULL_HANDLE;
+   CHECK(vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                   NULL, &pipeline) == VK_SUCCESS);
+
+   VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = 0,
+   };
+   VkCommandPool pool = VK_NULL_HANDLE;
+   CHECK(vkCreateCommandPool(device, &pool_info, NULL, &pool) == VK_SUCCESS);
+   VkCommandBufferAllocateInfo command_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   VkCommandBuffer commands = VK_NULL_HANDLE;
+   CHECK(vkAllocateCommandBuffers(device, &command_info, &commands) ==
+         VK_SUCCESS);
+   VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   CHECK(vkBeginCommandBuffer(commands, &begin) == VK_SUCCESS);
+   VkRenderingAttachmentInfo color_attachment = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+      .imageView = view,
+      .imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+      .loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR,
+      .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+   };
+   VkRenderingInfo rendering = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+      .renderArea = scissor,
+      .layerCount = 1,
+      .colorAttachmentCount = 1,
+      .pColorAttachments = &color_attachment,
+   };
+   vkCmdBeginRendering(commands, &rendering);
+   vkCmdBindPipeline(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+   vkCmdDraw(commands, 3, 1, 0, 0);
+   vkCmdEndRendering(commands);
+   VkImageMemoryBarrier to_transfer = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+      .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = image,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+   };
+   vkCmdPipelineBarrier(commands, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1,
+                        &to_transfer);
+   VkBufferImageCopy copy = {
+      .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+      .imageExtent = {EXTENT, EXTENT, 1},
+   };
+   vkCmdCopyImageToBuffer(commands, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                          buffer, 1, &copy);
+   CHECK(vkEndCommandBuffer(commands) == VK_SUCCESS);
+   VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &commands,
+   };
+   CHECK(vkQueueSubmit(queue, 1, &submit, VK_NULL_HANDLE) == VK_SUCCESS);
+   CHECK(vkQueueWaitIdle(queue) == VK_SUCCESS);
+
+   uint32_t red = 0u;
+   for (uint32_t texel = 0u; texel < EXTENT * EXTENT; texel++) {
+      if (pixels[texel * 4u] == 255u && pixels[texel * 4u + 1u] == 0u &&
+          pixels[texel * 4u + 3u] == 255u)
+         red++;
+   }
+
+   /* The draw needed the heap, so it exists, and the bound the GPU allocator
+    * checks against is what was allocated less the header. */
+   struct kk_device *dev = kk_device_from_handle(device);
+   CHECK(dev->heap != NULL);
+   const struct heap_header *header = dev->heap->bo->cpu;
+   CHECK(sizeof(*header) == 32u);
+   *heap_size = header->size + (uint32_t)sizeof(*header);
+   CHECK(dev->heap->bo->size_B >= *heap_size);
+
+   vkDestroyCommandPool(device, pool, NULL);
+   vkDestroyPipeline(device, pipeline, NULL);
+   vkDestroyPipelineLayout(device, layout, NULL);
+   vkDestroyShaderModule(device, fragment_module, NULL);
+   vkDestroyShaderModule(device, vertex_module, NULL);
+   vkDestroyBuffer(device, buffer, NULL);
+   vkFreeMemory(device, buffer_memory, NULL);
+   vkDestroyImageView(device, view, NULL);
+   vkDestroyImage(device, image, NULL);
+   vkFreeMemory(device, image_memory, NULL);
+   vkDestroyDevice(device, NULL);
+   return red;
+}
+
+int
+main(void)
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   CHECK(vkCreateInstance(&instance_info, NULL, &instance) == VK_SUCCESS);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   uint32_t count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   VkResult enumerated =
+      vkEnumeratePhysicalDevices(instance, &count, &physical);
+   CHECK((enumerated == VK_SUCCESS || enumerated == VK_INCOMPLETE) && count);
+
+   for (unsigned i = 0u; i < sizeof(cases) / sizeof(cases[0]); i++) {
+      if (cases[i].value != NULL)
+         setenv("MESA_KK_HEAP_SIZE_MIB", cases[i].value, 1);
+      else
+         unsetenv("MESA_KK_HEAP_SIZE_MIB");
+      uint32_t heap_size = 0u;
+      const uint32_t red = draw_fan(instance, physical, &heap_size);
+      fprintf(stderr, "MESA_KK_HEAP_SIZE_MIB=%s: heap %u bytes, %u of %u red\n",
+              cases[i].value ? cases[i].value : "(unset)", heap_size, red,
+              EXTENT * EXTENT);
+      CHECK(heap_size == cases[i].mib * 1024u * 1024u);
+      CHECK(red == EXTENT * EXTENT);
+   }
+
+   vkDestroyInstance(instance, NULL);
+   printf("every heap-size override is bounded\n");
+   return 0;
+}
