+kk_heap_data(struct kk_cmd_buffer *cmd)
+{
+   if (cmd->heap == NULL)
+      return (struct kk_addr_range){0};
+
+   return (struct kk_addr_range){
+      .addr = cmd->heap->bo->gpu + sizeof(struct poly_heap),
+      .range = cmd->heap->bo->size_B - sizeof(struct poly_heap),
+   };
 }
 
