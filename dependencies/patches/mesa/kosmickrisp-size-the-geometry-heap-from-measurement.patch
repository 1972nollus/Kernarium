 src/kosmickrisp/vulkan/meson.build            |  20 +
 .../vulkan/tests/test_heap_size_override.c    | 415 ++++++++++++++++++
 3 files changed, 491 insertions(+), 3 deletions(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_heap_size_override.c

diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 4bf9f43214a715fafce2a8bfe2bf4a6eb0aed6f2..c6ae810c4a40fc5ee55ad41ba77d1947c9327f8e 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -27,6 +27,8 @@
 
 #include "util/u_math.h"
 
+#include <stdlib.h>
+
 #include "poly/geometry.h"
 #include "poly/tessellator.h"
 
@@ -1134,8 +1136,32 @@ kk_init_heap(const void *data)
    struct kk_cmd_buffer *cmd = (struct kk_cmd_buffer *)data;
    struct kk_device *dev = kk_cmd_buffer_device(cmd);
 
-   size_t size = 128 * 1024 * 1024;
-   kk_alloc_bo(dev, &dev->vk.base, size, 0, &dev->heap);
+   /* Measured, not guessed. The heaviest command buffer in the CTS
+    * tessellation, geometry, draw and rasterization groups asks this heap for
+    * 1.53 MiB; 1 MiB fails those groups and 2 MiB passes them. Sixteen gives an
+    * order of magnitude over the measured peak. The previous 128 MiB was a
+    * placeholder, and a Venus host pays the whole of it once per guest
+    * VkDevice.
+    *
+    * Demand is linear in patches and primitives, which the API does not bound,
+    * so no fixed size is safe for every application. A reservation the heap
+    * cannot hold empties its draw, with no diagnostic. MESA_KK_HEAP_SIZE_MIB
+    * raises the size without a rebuild. The GPU allocator bounds the heap with
+    * a 32-bit size, so only 1 to 4095 MiB is honoured and any other value
+    * keeps the default. */
+   size_t size = 16 * 1024 * 1024;
+   const char *size_override = getenv("MESA_KK_HEAP_SIZE_MIB");
+   if (size_override != NULL) {
+      long requested = strtol(size_override, NULL, 10);
+      if (requested >= 1 && requested <= 4095)
+         size = (size_t)requested * 1024 * 1024;
+   }
+   /* A device Metal refuses the heap keeps none, and every draw that needs it
+    * fails its recording instead; see kk_heap_ready(). */
+   if (kk_alloc_bo(dev, &dev->vk.base, size, 0, &dev->heap) != VK_SUCCESS) {
+      dev->heap = NULL;
+      return;
+   }
 
    struct poly_heap *map = (struct poly_heap *)dev->heap->cpu;
 
@@ -1146,12 +1172,30 @@ kk_init_heap(const void *data)
    };
 }
 
+/* Whether the device heap exists, creating it on first use. Without it the
+ * recording fails, and the draw that asked must record nothing. */
+static bool
+kk_heap_ready(struct kk_cmd_buffer *cmd)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   util_call_once_data(&dev->heap_init_once, kk_init_heap, cmd);
+   if (dev->heap == NULL) {
+      vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      return false;
+   }
+   return true;
+}
+
 static uint64_t
 kk_heap(struct kk_cmd_buffer *cmd)
 {
    struct kk_device *dev = kk_cmd_buffer_device(cmd);
 
-   util_call_once_data(&dev->heap_init_once, kk_init_heap, cmd);
+   /* kk_draw_flushed() skips a draw whose heap is missing before any of its
+    * stages asks for it. */
+   if (!kk_heap_ready(cmd))
+      return 0;
 
    /* We need to free all allocations after each command buffer execution */
    if (!cmd->uses_heap) {
@@ -3473,6 +3517,15 @@ kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
        requires_index_promotion(data) || requires_unroll_robustness(cmd, data) ||
        requires_unroll_restart(cmd, data) || rewrite_direct_provoking ||
        (discard_adjacency && !emulate_line_raster));
+   /* Every stage the driver emulates, and every unroll, allocates from the
+    * device heap. */
+   const bool needs_heap = requires_unroll || tess || emulate_geometry ||
+                           emulate_transform_feedback ||
+                           emulate_line_raster || emulate_polygon_points ||
+                           materialize_line_raster;
+   if (needs_heap && !kk_heap_ready(cmd))
+      return;
+
    if (requires_unroll) {
       data->line_raster_runs =
          emulate_line_raster &&
