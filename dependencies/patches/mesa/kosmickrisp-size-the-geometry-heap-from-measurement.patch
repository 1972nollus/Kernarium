+/* Takes the refusals the GPU counted in a heap since the host last read them,
+ * asks the next pin to grow the heap by what they needed, and logs the first
+ * loss. Called with heap_lock held. */
+static void
+kk_heap_observe_locked(struct kk_device *dev, struct kk_geometry_heap *heap)
+{
+   static_assert(offsetof(struct poly_heap, refused_units) ==
+                    offsetof(struct poly_heap, refusals) + 4,
+                 "adjacent counters");
+   const uint32_t *counters =
+      (const uint32_t *)((const uint8_t *)heap->bo->cpu +
+                         offsetof(struct poly_heap, refusals));
+   const uint32_t refusals = p_atomic_read(&counters[0]);
+   const uint32_t new_refusals = refusals - heap->seen_refusals;
+   if (new_refusals == 0)
+      return;
+
+   const uint32_t units = p_atomic_read(&counters[1]);
+   const uint64_t refused_B =
+      (uint64_t)(uint32_t)(units - heap->seen_refused_units) * 16u;
+   heap->seen_refusals = refusals;
+   heap->seen_refused_units = units;
+   dev->heap_wanted_B =
+      MAX2(dev->heap_wanted_B, heap->usable_B + refused_B);
+
+   if (!dev->heap_loss_reported) {
+      dev->heap_loss_reported = true;
+      fprintf(stderr,
+              "KosmicKrisp's %u MiB geometry heap refused a reservation, and "
+              "the draw that made it lost its output; later command buffers "
+              "get a heap of up to %u MiB, which MESA_KK_HEAP_SIZE_MIB "
+              "raises\n",
+              (unsigned)((heap->usable_B + sizeof(struct poly_heap)) >> 20),
+              (unsigned)(dev->heap_cap_B >> 20));
+   }
+}
+
+/* Replaces the device's heap with one whose usable size exceeds want_B, at
+ * least twice the old size and at most the cap, and returns the old heap when
+ * nothing else holds it, for the caller to free once it has unlocked. When
+ * Metal refuses the larger heap the device keeps the one it has and stops
+ * growing. Called with heap_lock held. */
+static struct kk_geometry_heap *
+kk_heap_grow_locked(struct kk_device *dev, uint64_t want_B)
+{
+   struct kk_geometry_heap *old = dev->heap;
+   const uint64_t old_B = old->usable_B + sizeof(struct poly_heap);
+   if (want_B < old->usable_B || old_B >= dev->heap_cap_B)
+      return NULL;
+
+   /* The GPU grants a reservation only if it ends before the usable size. */
+   uint64_t size_B =
+      MAX2(old_B * 2u,
+           util_next_power_of_two64(want_B + sizeof(struct poly_heap) + 16u));
+   size_B = MIN2(size_B, dev->heap_cap_B);
+
+   struct kk_geometry_heap *heap = kk_geometry_heap_create(dev, size_B);
+   if (heap == NULL) {
+      dev->heap_cap_B = old_B;
+      return NULL;
+   }
+
+   dev->heap = heap;
+   assert(old->refcount > 0);
+   return --old->refcount == 0 ? old : NULL;
+}
