+/* SPDX-License-Identifier: MIT */
+#version 450
+/* Each patch covers its own tile of a 16 x 16 grid over the framebuffer. */
+layout(quads, equal_spacing, ccw) in;
+void main()
+{
+   vec2 tile = vec2(gl_PrimitiveID % 16, gl_PrimitiveID / 16);
+   gl_Position = vec4((tile + gl_TessCoord.xy) / 8.0 - 1.0, 0.5, 1.0);
+}
