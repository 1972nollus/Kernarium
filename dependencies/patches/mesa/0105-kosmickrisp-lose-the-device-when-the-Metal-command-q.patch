From ba6022c050f0c500514e7303def43d14fb743cf3 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 20 Sep 2026 12:03:45 +0900
Subject: [PATCH 105/107] kosmickrisp: lose the device when the Metal command
 queue stops

A signal this driver hands Metal is delivered by the queue it was enqueued
on, so a queue that stops running work never delivers it and never says so.
Nothing else notices: the queue reports nothing further, so the retirement
that replaces a failed queue never triggers, the failure count the signal
recovery keys on stays zero, and every waiter blocks -- in this process, in
the renderer's per-ring sync thread, and through the guest protocol in the
guest.  An iPad Vulkan CTS fraction spent 2,700 seconds in that state, paying
thirty seconds of host escape for every test case, with not one line from the
driver.

The one bound that could have caught it, kk_timeline_recover_lost_signal,
called kk_queue_complete_owed_signals, whose body runs only while a reported
failure is outstanding.  That is right for what it repairs -- a signal a
failure destroyed -- and exactly wrong here, because no failure was reported.

Split the two cases where the evidence separates them.  A queue carrying a
reported failure destroyed the signal, and the repair is unchanged.  A queue
that has reported no failure destroyed nothing, so it accepted the signal and
stopped: that is the disposition kk_queue_error.h already gives a queue that
stops reporting, and the device is lost, with a report naming the value, the
bound and how many submissions the queue has not answered for.  The bound for
losing a device is three times the one for completing a value, because it is
final and must not be reached by a queue that is merely busy.
---
 src/kosmickrisp/vulkan/kk_queue.c | 17 +++++++++++
 src/kosmickrisp/vulkan/kk_queue.h | 11 ++++++++
 src/kosmickrisp/vulkan/kk_sync.c  | 47 +++++++++++++++++++++++++++++--
 3 files changed, 73 insertions(+), 2 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 20ab672..60f612e 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -92,6 +92,23 @@ kk_queue_has_failed(struct kk_queue *queue)
    return failed;
 }
 
+bool
+kk_queue_failure_outstanding(struct kk_queue *queue, uint64_t *unreported)
+{
+   struct kk_queue_feedback *feedback = queue->feedback;
+   if (!feedback) {
+      *unreported = 0u;
+      return false;
+   }
+
+   simple_mtx_lock(&feedback->signal_mutex);
+   bool outstanding = feedback->failures > 0u;
+   *unreported = feedback->last_serial - feedback->reported;
+   simple_mtx_unlock(&feedback->signal_mutex);
+
+   return outstanding;
+}
+
 /* Metal reports a failure against one submission, but the work it kills
  * behind that submission does not always arrive as a report of its own. A
  * signal enqueued after the reported one can therefore go missing with
diff --git a/src/kosmickrisp/vulkan/kk_queue.h b/src/kosmickrisp/vulkan/kk_queue.h
index 5e3f724..97b1723 100644
--- a/src/kosmickrisp/vulkan/kk_queue.h
+++ b/src/kosmickrisp/vulkan/kk_queue.h
@@ -101,6 +101,17 @@ uint64_t kk_queue_complete_owed_signals(struct kk_queue *queue,
  * so it needs this to know that waiting longer cannot produce it. */
 bool kk_queue_has_failed(struct kk_queue *queue);
 
+/* Whether Metal has reported a failure this queue has not been retired for
+ * yet, and, through unreported, how many submissions it has taken and not
+ * answered for.
+ *
+ * The two together say what an undelivered signal means. A queue carrying a
+ * reported failure destroyed the signal, and completing it is the repair. A
+ * queue that has reported no failure destroyed nothing: it accepted the signal
+ * and then stopped, and unreported says how much work it is sitting on. */
+bool kk_queue_failure_outstanding(struct kk_queue *queue,
+                                  uint64_t *unreported);
+
 VkResult kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
                        const VkDeviceQueueCreateInfo *pCreateInfo,
                        uint32_t index_in_family);
diff --git a/src/kosmickrisp/vulkan/kk_sync.c b/src/kosmickrisp/vulkan/kk_sync.c
index 91435c9..c7aa7be 100644
--- a/src/kosmickrisp/vulkan/kk_sync.c
+++ b/src/kosmickrisp/vulkan/kk_sync.c
@@ -95,10 +95,25 @@ kk_timeline_get_value(struct vk_device *device, struct vk_sync *sync,
  *
  * The bound is two orders of magnitude over any submission that runs to
  * completion on the tightest device this driver targets, whose GPU stops a
- * command buffer after tens of milliseconds, and it costs nothing at all on a
- * queue that has never failed. */
+ * command buffer after tens of milliseconds. */
 static const uint64_t kk_lost_signal_timeout_ns = 10ull * 1000000000ull;
 
+/* A queue that has reported no failure destroyed nothing, so a signal it
+ * accepted and has not delivered means it has stopped running work rather than
+ * that something took the signal away. Nothing restarts a Metal command queue
+ * and nothing else will notice: the queue reports nothing further, so the
+ * retirement that replaces a failed queue never triggers, and every waiter -
+ * here, in the renderer's per-ring sync thread, and through the guest protocol
+ * in another process - waits on it forever. That is device loss, and it is the
+ * disposition kk_queue_error.h already gives a queue that stops reporting.
+ *
+ * Losing a device ends a workload, so this bound is three times the one above:
+ * the repair there completes one value and the queue carries on, while this
+ * one is final and must not be reached by a queue that is merely busy. Nothing
+ * else in the process is waiting on this queue by then either, because a
+ * KosmicKrisp device submits from one queue in order. */
+static const uint64_t kk_stopped_queue_timeout_ns = 30ull * 1000000000ull;
+
 static void
 kk_timeline_recover_lost_signal(struct kk_device *dev,
                                 struct kk_sync_timeline *timeline,
@@ -123,6 +138,34 @@ kk_timeline_recover_lost_signal(struct kk_device *dev,
       timeline->overdue_since = now;
       return;
    }
+   uint64_t unreported = 0u;
+   if (!kk_queue_failure_outstanding(&dev->queue, &unreported)) {
+      if (now - timeline->overdue_since < kk_stopped_queue_timeout_ns)
+         return;
+
+      timeline->overdue_since = 0u;
+      /* Say this on stderr as well as through the device. Losing a device is
+       * the one disposition a run cannot recover from, and the runtime's own
+       * report goes to the Mesa log, which this product leaves muted. */
+      fprintf(stderr,
+              "KosmicKrisp the Metal command queue stopped making progress: "
+              "it accepted a timeline signal for value %" PRIu64
+              ", has not delivered it in %" PRIu64
+              " s, has reported no failure, and holds %" PRIu64
+              " submission(s) it has not answered for. Losing the device\n",
+              wait_value, kk_stopped_queue_timeout_ns / 1000000000ull,
+              unreported);
+      vk_device_set_lost(
+         &dev->vk,
+         "the Metal command queue stopped making progress: it accepted a "
+         "timeline signal for value %" PRIu64
+         ", has not delivered it in %" PRIu64
+         " s, has reported no failure, and holds %" PRIu64
+         " submission(s) it has not answered for",
+         wait_value, kk_stopped_queue_timeout_ns / 1000000000ull, unreported);
+      return;
+   }
+
    if (now - timeline->overdue_since < kk_lost_signal_timeout_ns)
       return;
 
