From 31c28520e3f52920be6fbbcaf78ec23ec63812f7 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 18 Sep 2026 20:44:48 +0900
Subject: [PATCH 96/99] kosmickrisp: use wide buffer accesses where NIR proves
 the alignment

Every global load and store is emitted through MSL's packed vector types.
Packed is the safe default -- it aliases a scalar array, so any alignment
works -- but it also costs the shader one access per component, because the
compiler cannot assume the address is aligned enough for a wide one.

NIR already carries the alignment it proved for each access. Where that
alignment covers the unpacked vector, emit the unpacked type and let one
access cover the whole vector. Two- and four-component vectors only: an
unpacked three-component vector occupies four lanes, so a wide access would
read or write past the value.

This matters most in a loop over a storage buffer, which is where a shader
spends its time. dEQP-VK.spirv_assembly.type.vec4.i64 loops over arrays of
i64vec4, whose std430 alignment is the full 32 bytes.
---
 src/kosmickrisp/compiler/nir_to_msl.c | 74 +++++++++++++++++++++------
 1 file changed, 58 insertions(+), 16 deletions(-)

diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index 0c9b4d05..a256223c 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -1089,14 +1089,35 @@ image_coord_swizzle(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
    texture_src_coord_swizzle(ctx, &instr->src[1], comps, is_cube, is_array);
 }
 
+/* MSL's unpacked vector types carry their natural alignment, so one access
+ * covers the whole vector; the packed forms alias a scalar array and cost an
+ * access per component.  Packed is the safe default because a shader address
+ * is only as aligned as NIR can prove, so ask NIR.  A three-component vector
+ * stays packed whatever the alignment: unpacked occupies four lanes, and a
+ * wide access would read or write the fourth.
+ */
+static bool
+msl_access_is_wide(unsigned bit_size, unsigned component_count, unsigned align)
+{
+   if (bit_size < 8u || (component_count != 2u && component_count != 4u))
+      return false;
+   return align >= (bit_size / 8u) * component_count;
+}
+
+static unsigned
+msl_intrinsic_align(nir_intrinsic_instr *instr)
+{
+   return nir_intrinsic_has_align(instr) ? nir_intrinsic_align(instr) : 1u;
+}
+
 /* Non-packed types have stricter alignment requirements that packed types.
  * This helps us build a packed format for storage.
  */
 static void
 src_to_packed(struct nir_to_msl_ctx *ctx, nir_src *src, const char *type,
-              uint32_t component_count)
+              uint32_t component_count, bool wide)
 {
-   if (component_count == 1) {
+   if (component_count == 1 || wide) {
       P(ctx, "%s(", type);
    } else {
       P(ctx, "packed_%s(", type);
@@ -1112,10 +1133,12 @@ src_to_packed(struct nir_to_msl_ctx *ctx, nir_src *src, const char *type,
 static void
 src_to_packed_load(struct nir_to_msl_ctx *ctx, nir_src *src,
                    const char *addressing, const char *type,
-                   uint32_t component_count)
+                   uint32_t component_count, bool wide)
 {
    if (component_count == 1) {
       P(ctx, "*(%s %s*)(", addressing, type);
+   } else if (wide) {
+      P(ctx, "(*(%s %s*)", addressing, type);
    } else {
       P(ctx, "%s(*(%s packed_%s*)", type, addressing, type);
    }
@@ -1130,10 +1153,13 @@ src_to_packed_load(struct nir_to_msl_ctx *ctx, nir_src *src,
 static void
 src_to_packed_load_offset(struct nir_to_msl_ctx *ctx, nir_src *src,
                           nir_src *offset, const char *addressing,
-                          const char *type, uint32_t component_count)
+                          const char *type, uint32_t component_count,
+                          bool wide)
 {
    if (component_count == 1) {
       P(ctx, "*(%s %s*)((", addressing, type);
+   } else if (wide) {
+      P(ctx, "(*(%s %s*)(", addressing, type);
    } else {
       P(ctx, "%s(*(%s packed_%s*)(", type, addressing, type);
    }
@@ -1204,9 +1230,9 @@ src_to_coherent_store(struct nir_to_msl_ctx *ctx, nir_src *address,
 static void
 src_to_packed_store(struct nir_to_msl_ctx *ctx, nir_src *src,
                     const char *addressing, const char *type,
-                    uint32_t num_components)
+                    uint32_t num_components, bool wide)
 {
-   if (num_components == 1) {
+   if (num_components == 1 || wide) {
       P_IND(ctx, "(*(%s %s*)", addressing, type);
    } else {
       P_IND(ctx, "(*(%s packed_%s*)", addressing, type);
@@ -1650,7 +1676,10 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
          P(ctx, ";\n");
       } else {
          src_to_packed_load(ctx, &instr->src[0], addressing, type,
-                            instr->def.num_components);
+                            instr->def.num_components,
+                            msl_access_is_wide(instr->def.bit_size,
+                                               instr->def.num_components,
+                                               msl_intrinsic_align(instr)));
          P(ctx, ";\n");
       }
       break;
@@ -1658,7 +1687,10 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
    case nir_intrinsic_load_global_constant: {
       src_to_packed_load(ctx, &instr->src[0], "constant",
                          msl_type_for_def(ctx->types, &instr->def),
-                         instr->def.num_components);
+                         instr->def.num_components,
+                         msl_access_is_wide(instr->def.bit_size,
+                                            instr->def.num_components,
+                                            msl_intrinsic_align(instr)));
       P(ctx, ";\n");
       break;
    }
@@ -1669,7 +1701,10 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
       P(ctx, " ? ");
       src_to_packed_load_offset(ctx, &instr->src[0], &instr->src[1], "constant",
                                 msl_type_for_def(ctx->types, &instr->def),
-                                instr->def.num_components);
+                                instr->def.num_components,
+                                msl_access_is_wide(instr->def.bit_size,
+                                                   instr->def.num_components,
+                                                   msl_intrinsic_align(instr)));
       P(ctx, " : 0;\n");
       break;
    }
@@ -1693,10 +1728,13 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
          src_to_msl(ctx, &instr->src[1]);
          P(ctx, ", memory_order_relaxed);\n");
       } else {
-         src_to_packed_load_offset(ctx, &instr->src[0], &instr->src[1],
-                                   addressing,
-                                   msl_type_for_def(ctx->types, &instr->def),
-                                   instr->def.num_components);
+         src_to_packed_load_offset(
+            ctx, &instr->src[0], &instr->src[1], addressing,
+            msl_type_for_def(ctx->types, &instr->def),
+            instr->def.num_components,
+            msl_access_is_wide(instr->def.bit_size,
+                               instr->def.num_components,
+                               msl_intrinsic_align(instr)));
       }
       P(ctx, ";\n");
       break;
@@ -1728,7 +1766,7 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
          src_to_msl(ctx, &instr->src[1]);
          P(ctx, ", ")
          src_to_packed(ctx, &instr->src[0], type,
-                       instr->src[0].ssa->num_components);
+                       instr->src[0].ssa->num_components, false);
          P(ctx, ", memory_order_relaxed);\n");
       } else if (msl_coherent_access_is_atomic(ctx->disabled_workarounds,
                                                ctx->types, instr)) {
@@ -1739,13 +1777,17 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
             nir_intrinsic_write_mask(instr),
             instr->src[0].ssa->num_components);
       } else {
+         const bool wide =
+            msl_access_is_wide(instr->src[0].ssa->bit_size,
+                               instr->src[0].ssa->num_components,
+                               msl_intrinsic_align(instr));
          src_to_packed_store(ctx, &instr->src[1], addressing, type,
-                             instr->src[0].ssa->num_components);
+                             instr->src[0].ssa->num_components, wide);
          writemask_to_msl(ctx, nir_intrinsic_write_mask(instr),
                           instr->num_components);
          P(ctx, " = ")
          src_to_packed(ctx, &instr->src[0], type,
-                       instr->src[0].ssa->num_components);
+                       instr->src[0].ssa->num_components, wide);
          writemask_to_msl(ctx, nir_intrinsic_write_mask(instr),
                           instr->num_components);
          P(ctx, ";\n");
