 struct kk_buffer_image_copy_info {
    struct mtl_buffer_image_copy mtl_data;
    size_t buffer_slice_size_B;
@@ -145,6 +173,164 @@ kk_CmdCopyImageToBuffer2(VkCommandBuffer commandBuffer,
