+VKAPI_ATTR void VKAPI_CALL
+kk_CmdCopyMemoryKHR(VkCommandBuffer commandBuffer,
+                    const VkCopyDeviceMemoryInfoKHR *pCopyMemoryInfo)
+{
+   if (!pCopyMemoryInfo)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   mtl_compute_encoder *encoder = cs_get_compute(cmd, true);
+
+   for (uint32_t i = 0; i < pCopyMemoryInfo->regionCount; i++) {
+      const VkDeviceMemoryCopyKHR *region = &pCopyMemoryInfo->pRegions[i];
+      if (region->srcRange.size == 0)
+         continue;
+
+      struct kk_device_address src, dst;
+
+      if (!kk_cmd_resolve_address(cmd, region->srcRange, &src) ||
+          !kk_cmd_resolve_address(cmd, region->dstRange, &dst))
+         return;
+
+      mtl_copy_from_buffer_to_buffer(encoder, src.buffer, src.offset,
+                                     dst.buffer, dst.offset,
+                                     region->srcRange.size);
+   }
+}
