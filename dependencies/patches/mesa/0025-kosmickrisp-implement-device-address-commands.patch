+bool
+kk_cmd_resolve_address(struct kk_cmd_buffer *cmd, VkDeviceAddressRangeKHR range,
+                       struct kk_device_address *resolved)
+{
+   if (likely(kk_device_resolve_address(kk_cmd_buffer_device(cmd), range,
+                                        resolved)))
+      return true;
+
+   vk_command_buffer_set_error(&cmd->vk, VK_ERROR_VALIDATION_FAILED_EXT);
+   return false;
+}
+
+void
+kk_cmd_reference_address(struct kk_cmd_buffer *cmd,
+                         VkDeviceAddressRangeKHR range)
+{
+   struct kk_device_address resolved;
+   kk_cmd_resolve_address(cmd, range, &resolved);
+}
+
+void
+kk_cmd_reference_dependency_info(struct kk_cmd_buffer *cmd,
+                                 const VkDependencyInfo *dependency)
+{
+   const VkMemoryRangeBarriersInfoKHR *ranges = vk_find_struct_const(
+      dependency->pNext, MEMORY_RANGE_BARRIERS_INFO_KHR);
+   if (!ranges)
+      return;
+
+   for (uint32_t i = 0; i < ranges->memoryRangeBarrierCount; i++)
+      kk_cmd_reference_address(cmd, ranges->pMemoryRangeBarriers[i].addressRange);
+}
