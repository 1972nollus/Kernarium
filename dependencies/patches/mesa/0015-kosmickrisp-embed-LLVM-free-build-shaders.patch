Subject: [PATCH 15/71] kosmickrisp: embed LLVM-free build shaders

---
 meson.build                       |   1 -
 src/compiler/spirv/meson.build    |   1 +
 src/kosmickrisp/libkk/libkk.spv   | Bin 0 -> 380208 bytes
 src/kosmickrisp/libkk/meson.build |  20 ++++----------------
 src/poly/cl/libpoly.spv           | Bin 0 -> 67100 bytes
 src/poly/cl/meson.build           |  18 +++---------------
 6 files changed, 8 insertions(+), 32 deletions(-)
 create mode 100644 src/kosmickrisp/libkk/libkk.spv
 create mode 100644 src/poly/cl/libpoly.spv

diff --git a/meson.build b/meson.build
index d6e3a8be..0b9b3b62 100644
--- a/meson.build
+++ b/meson.build
@@ -959,7 +959,6 @@ with_driver_using_cl = [
   with_gallium_panfrost, with_panfrost_vk,
   with_gallium_rusticl,
   with_nouveau_vk, with_imagination_vk,
-  with_kosmickrisp_vk,
 ].contains(true)
 
 if get_option('mesa-clc') == 'system'
diff --git a/src/compiler/spirv/meson.build b/src/compiler/spirv/meson.build
index b49d3af6..83e72020 100644
--- a/src/compiler/spirv/meson.build
+++ b/src/compiler/spirv/meson.build
@@ -79,6 +79,7 @@ spirv2nir = executable(
 )
 
 if get_option('mesa-clc') != 'system' and (with_driver_using_cl or \
+                                           with_kosmickrisp_vk or \
                                            get_option('install-mesa-clc'))
    prog_vtn_bindgen2 = executable(
      'vtn_bindgen2',
diff --git a/src/kosmickrisp/libkk/libkk.spv b/src/kosmickrisp/libkk/libkk.spv
new file mode 100644
