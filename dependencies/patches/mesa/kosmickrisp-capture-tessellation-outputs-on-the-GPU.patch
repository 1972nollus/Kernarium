diff --git a/src/kosmickrisp/libkk/kk_tessellator.h b/src/kosmickrisp/libkk/kk_tessellator.h
index 5d687f40a3ab7ff0ace370f94882993923730d88..58a668b71f8b99b3814283dfae078a3e6f2f379c 100644
--- a/src/kosmickrisp/libkk/kk_tessellator.h
+++ b/src/kosmickrisp/libkk/kk_tessellator.h
@@ -7,6 +7,7 @@
 
 #pragma once
 
+#include "poly/geometry.h"
 #include "poly/tessellator.h"
 
 #define libkk_tessellate(context, grid, barrier, prim, mode, state)            \
@@ -18,3 +19,36 @@
       assert(prim == TESS_PRIMITIVE_ISOLINES);                                 \
       libkk_tess_isoline(context, grid, barrier, state, mode);                 \
    }
+
+/* A tessellated draw sizes its patch buffers from application draw words:
+ * the TCS outputs, then each patch's coordinate allocation and index count,
+ * for every patch of every instance. The command pool, the GPU heap and the
+ * dispatches address them in 32 bits, so a product that does not fit would
+ * wrap into a small allocation the TCS and the tessellator write far past.
+ * Returns false for such a draw, and otherwise the unrolled patch count and
+ * the buffers' total size. The TCS grid, `patches` times the output patch
+ * size per instance, has to fit as well. OpenCL and C both size from here.
+ */
+static inline bool
+kk_tess_patch_buffers_size(uint32_t patches, uint32_t instances,
+                           uint32_t tcs_stride_el, uint32_t output_patch_size,
+                           uint32_t *unrolled_patches, uint32_t *size_B)
+{
+   uint32_t tcs_threads, tcs_el, tcs_B, patch_B;
+
+   if (!poly_u32_checked_mul(patches, instances, unrolled_patches))
+      return false;
+
+   /* No patch at all launches nothing, whatever one instance would need. */
+   if (*unrolled_patches == 0) {
+      *size_B = 0;
+      return true;
+   }
+
+   return poly_u32_checked_mul(patches, output_patch_size, &tcs_threads) &&
+          poly_u32_checked_mul(*unrolled_patches, tcs_stride_el, &tcs_el) &&
+          poly_u32_checked_mul(tcs_el, sizeof(uint32_t), &tcs_B) &&
+          poly_u32_checked_mul(*unrolled_patches, 2 * sizeof(uint32_t),
+                               &patch_B) &&
+          poly_u32_checked_add(tcs_B, patch_B, size_B);
+}
