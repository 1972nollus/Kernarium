+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd -- "$(dirname -- "$0")"
+for shader in wide.tesc wide.tese; do
+   glslc -O --target-env=vulkan1.3 -mfmt=c "$shader" -o "$shader.h"
+done
diff --git a/src/kosmickrisp/vulkan/tests/tess_draw_size_shaders/wide.tesc b/src/kosmickrisp/vulkan/tests/tess_draw_size_shaders/wide.tesc
