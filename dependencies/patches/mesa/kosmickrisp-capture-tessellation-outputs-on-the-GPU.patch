+#include "kk_tessellator.h"
 #include "poly/geometry.h"
 #include "poly/tessellator.h"
 
 KERNEL(1)
 libkk_tess_setup_indirect(
    global struct poly_tess_params *p,
-   global uint32_t *grids /* output: VS then TCS then tess */,
+   global uint32_t *grids /* 6-word exact-thread records: VS, TCS, tess */,
    global struct poly_vertex_params *vp /* output */, global uint32_t *indirect,
    uint64_t in_index_buffer, uint32_t in_index_buffer_range_el,
    uint32_t in_index_size_B, uint64_t vertex_outputs /* bitfield */,
@@ -22,6 +23,27 @@ libkk_tess_setup_indirect(
    uint count = indirect[0], instance_count = indirect[1];
    unsigned in_patches = count / p->input_patch_size;
 
+   /* The draw words are application data, so size every buffer and grid
+    * before writing any state; the arithmetic below then cannot wrap. A
+    * draw whose sizes do not fit 32 bits launches nothing: its three grids
+    * stay empty, the prefix sum sees no patch and writes an empty draw, and
+    * no statistic counts it. */
+   unsigned unrolled_patches;
+   uint32_t patch_buffers_B, vertices, vb_B, blob_B;
+   if (!kk_tess_patch_buffers_size(in_patches, instance_count,
+                                   p->tcs_stride_el, p->output_patch_size,
+                                   &unrolled_patches, &patch_buffers_B) ||
+       !poly_u32_checked_mul(count, instance_count, &vertices) ||
+       !poly_u32_checked_mul(vertices, util_bitcount64(vertex_outputs) * 16,
+                             &vb_B) ||
+       !poly_u32_checked_add(patch_buffers_B, vb_B, &blob_B) ||
+       !poly_heap_size_can_align(blob_B)) {
+      for (uint i = 0; i < 18; ++i)
+         grids[i] = 0;
+      p->nr_patches = 0;
+      return;
+   }
+
    /* TCS invocation counter increments once per-patch */
    if (tcs_statistic) {
       poly_atomic_add_u64(tcs_statistic,
@@ -29,7 +51,6 @@ libkk_tess_setup_indirect(
    }
 
    size_t draw_stride = 5 * sizeof(uint32_t);
-   unsigned unrolled_patches = in_patches * instance_count;
 
    uint32_t alloc = 0;
    uint32_t tcs_out_offs = alloc;
@@ -81,14 +102,23 @@ libkk_tess_setup_indirect(
    grids[0] = count;
    grids[1] = instance_count;
    grids[2] = 1;
+   grids[3] = 64;
+   grids[4] = 1;
+   grids[5] = 1;
 
    /* TCS grid size */
-   grids[3] = in_patches * p->output_patch_size;
-   grids[4] = instance_count;
-   grids[5] = 1;
+   grids[6] = in_patches * p->output_patch_size;
+   grids[7] = instance_count;
+   grids[8] = 1;
+   grids[9] = p->output_patch_size;
+   grids[10] = 1;
+   grids[11] = 1;
 
    /* Tess grid size */
-   grids[6] = unrolled_patches;
-   grids[7] = 1;
-   grids[8] = 1;
+   grids[12] = unrolled_patches;
+   grids[13] = 1;
+   grids[14] = 1;
+   grids[15] = 1;
+   grids[16] = 1;
+   grids[17] = 1;
 }
