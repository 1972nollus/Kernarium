diff --git a/src/kosmickrisp/libkk/kk_geometry.cl b/src/kosmickrisp/libkk/kk_geometry.cl
index 05c74af00b90cdf0bedad40a618f37336599897b..e488291ef6ba441f9d4669466605958f67f1f1a8 100644
--- a/src/kosmickrisp/libkk/kk_geometry.cl
+++ b/src/kosmickrisp/libkk/kk_geometry.cl
@@ -410,6 +410,15 @@ libkk_prefix_sum_tess(global struct poly_tess_params *p,
    poly_prefix_sum(scratch, p->counts, p->nr_patches, 1 /* words */,
                    0 /* word */, 1024);
 
+   /* The per-patch index counts follow the application's tessellation
+    * levels, so their 32-bit running sum can wrap, and it wrapped exactly
+    * where it decreases. Count the decreases across the group. */
+   barrier(CLK_GLOBAL_MEM_FENCE | CLK_LOCAL_MEM_FENCE);
+   uint wraps = 0;
+   for (uint i = cl_local_id.x + 1; i < p->nr_patches; i += 1024)
+      wraps += p->counts[i] < p->counts[i - 1];
+   wraps = poly_work_group_scan_inclusive_add(wraps, scratch)[1];
+
    /* After prefix summing, we know the total # of indices, so allocate the
     * index buffer now. Elect a thread for the allocation.
     */
@@ -420,15 +429,24 @@ libkk_prefix_sum_tess(global struct poly_tess_params *p,
    /* The last element of an inclusive prefix sum is the total sum */
    uint total = p->nr_patches > 0 ? p->counts[p->nr_patches - 1] : 0;
 
-   /* Allocate 4-byte indices */
+   /* Allocate 4-byte indices, unless their size does not fit the 32 bits
+    * the heap addresses. Then draw nothing and write no index either: the
+    * tessellator skips every patch once nr_patches is zero. */
    uint32_t elsize_B = sizeof(uint32_t);
-   uint32_t size_B = total * elsize_B;
+   uint32_t size_B;
+   global uint32_t *desc = p->out_draws;
+   if (wraps || !poly_u32_checked_mul(total, elsize_B, &size_B) ||
+       !poly_heap_size_can_align(size_B)) {
+      p->nr_patches = 0;
+      for (uint i = 0; i < 5; ++i)
+         desc[i] = 0;
+      return;
+   }
+
    uint alloc_B = poly_heap_alloc_offs(p->heap, size_B);
    p->index_buffer = (global uint32_t *)(((uintptr_t)p->heap->base) + alloc_B);
 
    /* ...and now we can generate the API indexed draw */
-   global uint32_t *desc = p->out_draws;
-
    desc[0] = total;              /* count */
    desc[1] = 1;                  /* instance_count */
    desc[2] = alloc_B / elsize_B; /* start */
diff --git a/src/kosmickrisp/libkk/kk_tessellation.cl b/src/kosmickrisp/libkk/kk_tessellation.cl
index 0e8c1a91ac9c44e0d171a36fc287baba12c23610..8c633622ac8d69119a7668481a11ed08d010e364 100644
--- a/src/kosmickrisp/libkk/kk_tessellation.cl
+++ b/src/kosmickrisp/libkk/kk_tessellation.cl
