+/* The grid covers every patch the setup sized. libkk_prefix_sum_tess clears
+ * nr_patches when the patches' indices cannot be addressed, so the pass that
+ * writes them then writes nothing. */
+
 KERNEL(1)
 libkk_tess_isoline(constant struct poly_tess_params *p,
                    enum poly_tess_mode tess_mode)
 {
    uint patch = cl_global_id.x;
+   if (patch >= p->nr_patches)
+      return;
    poly_tess_isoline_process(p, patch, tess_mode);
 }
 
@@ -19,6 +25,8 @@ libkk_tess_tri(constant struct poly_tess_params *p,
                enum poly_tess_mode tess_mode)
 {
    uint patch = cl_global_id.x;
+   if (patch >= p->nr_patches)
+      return;
    poly_tess_tri_process(p, patch, tess_mode);
 }
 
@@ -27,5 +35,7 @@ libkk_tess_quad(constant struct poly_tess_params *p,
                 enum poly_tess_mode tess_mode)
 {
    uint patch = cl_global_id.x;
+   if (patch >= p->nr_patches)
+      return;
    poly_tess_quad_process(p, patch, tess_mode);
