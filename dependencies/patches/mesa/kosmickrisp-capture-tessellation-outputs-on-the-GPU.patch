+++ b/src/kosmickrisp/vulkan/tests/test_tess_draw_size.cpp
@@ -0,0 +1,354 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A direct tessellated draw sizes the TCS output, patch coordinate and index
+ * count buffers at recording time: every patch of every instance needs the
+ * TCS's whole output patch.  Vulkan puts no bound on a draw's vertex or
+ * instance count, so a large enough draw makes that size overflow the 32 bits
+ * the upload allocator and the GPU address it in.  The draw must then fail
+ * the command buffer instead of handing the TCS and the tessellator a
+ * truncated buffer to write gigabytes past.  The test only records:
+ * submitting the unfixed case would corrupt GPU memory.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                             \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "geometry_draw_size_shaders/points.vert.h"
+;
+static const uint32_t control_spirv[] =
+#include "tess_draw_size_shaders/wide.tesc.h"
+;
+static const uint32_t evaluation_spirv[] =
+#include "tess_draw_size_shaders/wide.tese.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "geometry_draw_size_shaders/green.frag.h"
+;
+
+/* The compiled wide.tesc stores six tessellation levels and 32 vertices of
+ * 15 four-word output slots, 1926 words per patch, and each patch also needs
+ * a coordinate allocation and an index count.  Every vertex is a patch, so
+ * the first draw whose buffers need 2^32 bytes leaves a wrapped size of a
+ * few kilobytes.  Fewer slots would let that draw fit and fail this test. */
+static constexpr uint64_t patch_bytes = 1926 * 4 + 2 * 4;
+static constexpr uint32_t first_overflowing_draw =
+   uint32_t(((UINT64_C(1) << 32) + patch_bytes - 1) / patch_bytes);
+
+int main()
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "tess-draw-size";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceFeatures);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t physical_count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, &physical);
+   require((result == VK_SUCCESS || result == VK_INCOMPLETE) && physical_count,
+           "physical device", result);
+
+   VkPhysicalDeviceFeatures features{};
+   vkGetPhysicalDeviceFeatures(physical, &features);
+   require(features.tessellationShader, "tessellation shaders");
+   uint32_t queue_count = 0;
+   vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+   std::vector<VkQueueFamilyProperties> queues(queue_count);
+   vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count,
+                                            queues.data());
+   uint32_t queue = 0;
+   while (queue < queue_count &&
+          !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+      ++queue;
+   require(queue < queue_count, "graphics queue");
+   float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+   queue_info.queueFamilyIndex = queue;
+   queue_info.queueCount = 1;
+   queue_info.pQueuePriorities = &priority;
+   VkPhysicalDeviceFeatures enabled{};
+   enabled.tessellationShader = VK_TRUE;
+   VkPhysicalDeviceVulkan13Features features13{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+   features13.dynamicRendering = VK_TRUE;
+   VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+   device_info.pNext = &features13;
+   device_info.queueCreateInfoCount = 1;
+   device_info.pQueueCreateInfos = &queue_info;
+   device_info.pEnabledFeatures = &enabled;
+   VkDevice device = VK_NULL_HANDLE;
+   result = vkCreateDevice(physical, &device_info, nullptr, &device);
+   require(result == VK_SUCCESS, "create device", result);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkCreateShaderModule);
+   LOAD_D(vkDestroyShaderModule);
+   LOAD_D(vkCreatePipelineLayout);
+   LOAD_D(vkDestroyPipelineLayout);
+   LOAD_D(vkCreateGraphicsPipelines);
+   LOAD_D(vkDestroyPipeline);
+   LOAD_D(vkCreateCommandPool);
+   LOAD_D(vkDestroyCommandPool);
+   LOAD_D(vkAllocateCommandBuffers);
+   LOAD_D(vkResetCommandBuffer);
+   LOAD_D(vkBeginCommandBuffer);
+   LOAD_D(vkEndCommandBuffer);
+   LOAD_D(vkCmdBeginRendering);
+   LOAD_D(vkCmdEndRendering);
+   LOAD_D(vkCmdBindPipeline);
+   LOAD_D(vkCmdSetViewport);
+   LOAD_D(vkCmdSetScissor);
+   LOAD_D(vkCmdDraw);
+   LOAD_D(vkCreateImage);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkCreateImageView);
+   LOAD_D(vkDestroyImageView);
+   LOAD_D(vkGetImageMemoryRequirements);
+   LOAD_D(vkAllocateMemory);
+   LOAD_D(vkFreeMemory);
+   LOAD_D(vkBindImageMemory);
+
+   constexpr uint32_t extent = 8;
+   constexpr VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+   VkImageCreateInfo image_info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+   image_info.imageType = VK_IMAGE_TYPE_2D;
+   image_info.format = color_format;
+   image_info.extent = {extent, extent, 1};
+   image_info.mipLevels = 1;
+   image_info.arrayLayers = 1;
+   image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+   image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+   image_info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+   VkImage image = VK_NULL_HANDLE;
+   result = vkCreateImage(device, &image_info, nullptr, &image);
+   require(result == VK_SUCCESS, "create image", result);
+   VkMemoryRequirements requirements{};
+   vkGetImageMemoryRequirements(device, image, &requirements);
+   VkPhysicalDeviceMemoryProperties memory_properties{};
+   vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+   uint32_t type = 0;
+   while (type < memory_properties.memoryTypeCount &&
+          !(requirements.memoryTypeBits & (1u << type)))
+      ++type;
+   require(type < memory_properties.memoryTypeCount, "memory type");
+   VkMemoryAllocateInfo memory_info{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+   memory_info.allocationSize = requirements.size;
+   memory_info.memoryTypeIndex = type;
+   VkDeviceMemory memory = VK_NULL_HANDLE;
+   result = vkAllocateMemory(device, &memory_info, nullptr, &memory);
+   require(result == VK_SUCCESS, "allocate image", result);
+   result = vkBindImageMemory(device, image, memory, 0);
+   require(result == VK_SUCCESS, "bind image", result);
+   VkImageViewCreateInfo view_info{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+   view_info.image = image;
+   view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+   view_info.format = color_format;
+   view_info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+   VkImageView view = VK_NULL_HANDLE;
+   result = vkCreateImageView(device, &view_info, nullptr, &view);
+   require(result == VK_SUCCESS, "create view", result);
+
+   auto make_module = [&](const uint32_t *code, size_t size) {
+      VkShaderModuleCreateInfo module_info{
+         VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+      module_info.codeSize = size;
+      module_info.pCode = code;
+      VkShaderModule module = VK_NULL_HANDLE;
+      result = vkCreateShaderModule(device, &module_info, nullptr, &module);
+      require(result == VK_SUCCESS, "create module", result);
+      return module;
+   };
+   VkShaderModule modules[4] = {
+      make_module(vertex_spirv, sizeof(vertex_spirv)),
+      make_module(control_spirv, sizeof(control_spirv)),
+      make_module(evaluation_spirv, sizeof(evaluation_spirv)),
+      make_module(fragment_spirv, sizeof(fragment_spirv)),
+   };
+   const VkShaderStageFlagBits stage_bits[4] = {
+      VK_SHADER_STAGE_VERTEX_BIT,
+      VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT,
+      VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT,
+      VK_SHADER_STAGE_FRAGMENT_BIT,
+   };
+   VkPipelineShaderStageCreateInfo stages[4]{};
+   for (unsigned i = 0; i < 4; ++i) {
+      stages[i].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[i].stage = stage_bits[i];
+      stages[i].module = modules[i];
+      stages[i].pName = "main";
+   }
+
+   VkPipelineLayoutCreateInfo layout_info{
+      VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+   VkPipelineLayout layout = VK_NULL_HANDLE;
+   result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+   require(result == VK_SUCCESS, "create layout", result);
+
+   VkPipelineVertexInputStateCreateInfo vertex_input{
+      VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+   VkPipelineInputAssemblyStateCreateInfo assembly{
+      VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+   assembly.topology = VK_PRIMITIVE_TOPOLOGY_PATCH_LIST;
+   VkPipelineTessellationStateCreateInfo tessellation{
+      VK_STRUCTURE_TYPE_PIPELINE_TESSELLATION_STATE_CREATE_INFO};
+   tessellation.patchControlPoints = 1;
+   VkPipelineViewportStateCreateInfo viewport_state{
+      VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+   viewport_state.viewportCount = 1;
+   viewport_state.scissorCount = 1;
+   VkPipelineRasterizationStateCreateInfo raster{
+      VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+   raster.polygonMode = VK_POLYGON_MODE_FILL;
+   raster.cullMode = VK_CULL_MODE_NONE;
+   raster.lineWidth = 1.0f;
+   VkPipelineMultisampleStateCreateInfo multisample{
+      VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+   multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+   VkPipelineColorBlendAttachmentState blend_attachment{};
+   blend_attachment.colorWriteMask = 0xf;
+   VkPipelineColorBlendStateCreateInfo blend{
+      VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+   blend.attachmentCount = 1;
+   blend.pAttachments = &blend_attachment;
+   const VkDynamicState dynamic_states[] = {VK_DYNAMIC_STATE_VIEWPORT,
+                                            VK_DYNAMIC_STATE_SCISSOR};
+   VkPipelineDynamicStateCreateInfo dynamic{
+      VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+   dynamic.dynamicStateCount = 2;
+   dynamic.pDynamicStates = dynamic_states;
+   VkPipelineRenderingCreateInfo rendering_info{
+      VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+   rendering_info.colorAttachmentCount = 1;
+   rendering_info.pColorAttachmentFormats = &color_format;
+   VkGraphicsPipelineCreateInfo pipeline_info{
+      VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+   pipeline_info.pNext = &rendering_info;
+   pipeline_info.stageCount = 4;
+   pipeline_info.pStages = stages;
+   pipeline_info.pVertexInputState = &vertex_input;
+   pipeline_info.pInputAssemblyState = &assembly;
+   pipeline_info.pTessellationState = &tessellation;
+   pipeline_info.pViewportState = &viewport_state;
+   pipeline_info.pRasterizationState = &raster;
+   pipeline_info.pMultisampleState = &multisample;
+   pipeline_info.pColorBlendState = &blend;
+   pipeline_info.pDynamicState = &dynamic;
+   pipeline_info.layout = layout;
+   VkPipeline pipeline = VK_NULL_HANDLE;
+   result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                      nullptr, &pipeline);
+   require(result == VK_SUCCESS, "create pipeline", result);
+
+   VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+   pool_info.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+   pool_info.queueFamilyIndex = queue;
+   VkCommandPool pool = VK_NULL_HANDLE;
+   result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+   require(result == VK_SUCCESS, "create command pool", result);
+   VkCommandBufferAllocateInfo allocate{
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+   allocate.commandPool = pool;
+   allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+   allocate.commandBufferCount = 1;
+   VkCommandBuffer command = VK_NULL_HANDLE;
+   result = vkAllocateCommandBuffers(device, &allocate, &command);
+   require(result == VK_SUCCESS, "allocate command buffer", result);
+
+   /* Records one draw of `patches` single-vertex patches and returns what
+    * ending the recording reports. */
+   auto record = [&](uint32_t patches) {
+      result = vkResetCommandBuffer(command, 0);
+      require(result == VK_SUCCESS, "reset command buffer", result);
+      VkCommandBufferBeginInfo begin{
+         VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+      begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      result = vkBeginCommandBuffer(command, &begin);
+      require(result == VK_SUCCESS, "begin command buffer", result);
+      VkRenderingAttachmentInfo attachment{
+         VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+      attachment.imageView = view;
+      attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+      attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      VkRenderingInfo rendering{VK_STRUCTURE_TYPE_RENDERING_INFO};
+      rendering.renderArea = {{0, 0}, {extent, extent}};
+      rendering.layerCount = 1;
+      rendering.colorAttachmentCount = 1;
+      rendering.pColorAttachments = &attachment;
+      vkCmdBeginRendering(command, &rendering);
+      vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+      const VkViewport viewport{0.0f, 0.0f, float(extent), float(extent),
+                                0.0f, 1.0f};
+      const VkRect2D scissor{{0, 0}, {extent, extent}};
+      vkCmdSetViewport(command, 0, 1, &viewport);
+      vkCmdSetScissor(command, 0, 1, &scissor);
+      vkCmdDraw(command, patches, 1, 0, 0);
+      vkCmdEndRendering(command);
+      return vkEndCommandBuffer(command);
+   };
+
+   result = record(3);
+   require(result == VK_SUCCESS, "record a small tessellated draw", result);
+   result = record(first_overflowing_draw);
+   require(result == VK_ERROR_OUT_OF_DEVICE_MEMORY,
+           "record a draw whose patch buffers need 2^32 bytes", result);
+   result = record(first_overflowing_draw + 1u);
+   require(result == VK_ERROR_OUT_OF_DEVICE_MEMORY,
+           "record a draw whose patch buffers need more than 2^32 bytes",
+           result);
+   result = record(3);
+   require(result == VK_SUCCESS, "record a small draw after a refused one",
+           result);
+
+   vkDestroyCommandPool(device, pool, nullptr);
+   vkDestroyPipeline(device, pipeline, nullptr);
+   vkDestroyPipelineLayout(device, layout, nullptr);
+   for (VkShaderModule module : modules)
+      vkDestroyShaderModule(device, module, nullptr);
+   vkDestroyImageView(device, view, nullptr);
+   vkDestroyImage(device, image, nullptr);
+   vkFreeMemory(device, memory, nullptr);
+   vkDestroyDevice(device, nullptr);
+   vkDestroyInstance(instance, nullptr);
+   std::printf("oversized tessellated draws fail their command buffer\n");
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_tess_setup_gpu.c b/src/kosmickrisp/vulkan/tests/test_tess_setup_gpu.c
new file mode 100644
index 0000000000000000000000000000000000000000..80494a40ca8d8bd30de52b67225f320f028caa1c
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_tess_setup_gpu.c
@@ -0,0 +1,293 @@
+/* SPDX-License-Identifier: MIT */
+
+/* Launch only the production tessellation setup and index prefix sum. An
+ * indirect draw's words and the per-patch index counts are application data;
+ * sizes that do not fit 32 bits must launch nothing rather than wrap into a
+ * small allocation. Every case here stays within a bounded heap even with the
+ * sizes wrapped, so an unchecked kernel reports a wrong result instead of
+ * faulting, and no oversized stage is ever dispatched. */
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+#include "kosmickrisp/vulkan/kk_device.h"
+#include "kosmickrisp/vulkan/kk_entrypoints.h"
+#include "poly/tessellator.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(condition)                                                       \
+   do {                                                                        \
+      if (!(condition)) {                                                      \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,      \
+                 #condition);                                                  \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+#define VK_CHECK(expr)                                                         \
+   do {                                                                        \
+      VkResult result_ = (expr);                                               \
+      if (result_ != VK_SUCCESS) {                                             \
+         fprintf(stderr, "%s:%d: %s = %d\n", __FILE__, __LINE__, #expr,        \
+                 result_);                                                     \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+enum { HEAP_SIZE = 2 << 20, HEAP_BOTTOM = 16 };
+
+struct setup_case {
+   const char *name;
+   uint32_t count, instances;
+   uint32_t input_patch_size, output_patch_size, tcs_stride_el;
+   uint64_t outputs;
+   bool valid;
+};
+
+struct sum_case {
+   const char *name;
+   uint32_t patches;
+   uint32_t head_count, head_value, tail_value;
+   bool valid;
+};
+
+struct context {
+   VkDevice device;
+   VkQueue queue;
+   VkCommandBuffer command;
+   const struct vk_device_dispatch_table *api;
+};
+
+static struct kk_cmd_buffer *
+begin(struct context *ctx)
+{
+   const VkCommandBufferBeginInfo info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   VK_CHECK(ctx->api->BeginCommandBuffer(ctx->command, &info));
+   return kk_cmd_buffer_from_handle(ctx->command);
+}
+
+static void
+submit(struct context *ctx)
+{
+   VK_CHECK(ctx->api->EndCommandBuffer(ctx->command));
+   const VkSubmitInfo info = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &ctx->command,
+   };
+   VK_CHECK(ctx->api->QueueSubmit(ctx->queue, 1, &info, VK_NULL_HANDLE));
+   VK_CHECK(ctx->api->QueueWaitIdle(ctx->queue));
+}
+
+static struct kk_ptr
+heap(struct kk_cmd_buffer *cmd)
+{
+   struct kk_ptr storage = kk_pool_alloc(cmd, HEAP_SIZE, 16);
+   CHECK(storage.gpu);
+   const struct poly_heap data = {
+      .base = storage.gpu,
+      .bottom = HEAP_BOTTOM,
+      .size = HEAP_SIZE,
+   };
+   return kk_pool_upload(cmd, &data, sizeof(data), 4);
+}
+
+static void
+check_setup(struct context *ctx, const struct setup_case *test)
+{
+   struct kk_cmd_buffer *cmd = begin(ctx);
+   const uint32_t local[3] = {64, 1, 1};
+   struct poly_vertex_params vertex;
+   poly_vertex_params_init(&vertex, test->outputs, local);
+   struct kk_ptr heap_ptr = heap(cmd);
+   const struct poly_tess_params tess = {
+      .heap = heap_ptr.gpu,
+      .input_patch_size = test->input_patch_size,
+      .output_patch_size = test->output_patch_size,
+      .tcs_stride_el = test->tcs_stride_el,
+   };
+   struct kk_ptr p = kk_pool_upload(cmd, &tess, sizeof(tess), 8);
+   struct kk_ptr vp = kk_pool_upload(cmd, &vertex, sizeof(vertex), 8);
+   const uint32_t draw_words[4] = {test->count, test->instances, 0, 0};
+   struct kk_ptr draw = kk_pool_upload(cmd, draw_words, sizeof(draw_words), 4);
+   uint32_t guard[18];
+   memset(guard, 0xa5, sizeof(guard));
+   struct kk_ptr grids = kk_pool_upload(cmd, guard, sizeof(guard), 4);
+   const uint64_t zero = 0;
+   struct kk_ptr statistic = kk_pool_upload(cmd, &zero, sizeof(zero), 8);
+   CHECK(heap_ptr.cpu && p.cpu && vp.cpu && draw.cpu && grids.cpu &&
+         statistic.cpu);
+   const struct libkk_tess_setup_indirect_args args = {
+      .p = p.gpu,
+      .grids = grids.gpu,
+      .vp = vp.gpu,
+      .indirect = draw.gpu,
+      .vertex_outputs = test->outputs,
+      .tcs_statistic = statistic.gpu,
+   };
+   libkk_tess_setup_indirect_struct(cmd, kk_grid_1d(1), true, args);
+   submit(ctx);
+
+   const struct poly_tess_params *actual = p.cpu;
+   const struct poly_heap *actual_heap = heap_ptr.cpu;
+   const uint32_t *actual_grids = grids.cpu;
+   const uint32_t in_patches = test->count / test->input_patch_size;
+   const uint32_t patches = in_patches * test->instances;
+   const uint32_t expected[18] = {
+      test->count, test->instances, 1, 64, 1, 1,
+      in_patches * test->output_patch_size, test->instances, 1,
+      test->output_patch_size, 1, 1,
+      patches, 1, 1, 1, 1, 1,
+   };
+   for (unsigned i = 0; i < 18; i++)
+      CHECK(actual_grids[i] == (test->valid ? expected[i] : 0));
+   CHECK(actual->nr_patches == (test->valid ? patches : 0));
+   CHECK(*(const uint64_t *)statistic.cpu ==
+         (test->valid ? (uint64_t)in_patches * test->instances : 0));
+   if (test->valid) {
+      const uint32_t size_B =
+         patches * (test->tcs_stride_el * 4 + 8) +
+         test->count * test->instances *
+            util_bitcount64(test->outputs) * 16;
+      CHECK(actual_heap->bottom == HEAP_BOTTOM + align(size_B, 16));
+   } else {
+      CHECK(actual_heap->bottom == HEAP_BOTTOM);
+   }
+   printf("tessellation setup PASS %s\n", test->name);
+}
+
+static void
+check_sum(struct context *ctx, const struct sum_case *test)
+{
+   struct kk_cmd_buffer *cmd = begin(ctx);
+   struct kk_ptr heap_ptr = heap(cmd);
+   struct kk_ptr counts =
+      kk_pool_alloc(cmd, test->patches * sizeof(uint32_t), 4);
+   struct kk_ptr out_draw = kk_pool_alloc(cmd, 5 * sizeof(uint32_t), 4);
+   CHECK(heap_ptr.cpu && counts.cpu && out_draw.cpu);
+   uint32_t *count_words = counts.cpu;
+   uint64_t total = 0;
+   for (uint32_t i = 0; i < test->patches; i++) {
+      count_words[i] = i < test->head_count ? test->head_value
+                                            : test->tail_value;
+      total += count_words[i];
+   }
+   memset(out_draw.cpu, 0xa5, 5 * sizeof(uint32_t));
+   const struct poly_tess_params tess = {
+      .heap = heap_ptr.gpu,
+      .counts = counts.gpu,
+      .out_draws = out_draw.gpu,
+      .nr_patches = test->patches,
+   };
+   struct kk_ptr p = kk_pool_upload(cmd, &tess, sizeof(tess), 8);
+   CHECK(p.cpu);
+   libkk_prefix_sum_tess(cmd, kk_grid_1d(1024u), true, p.gpu, 0, 0, false);
+   submit(ctx);
+
+   const struct poly_tess_params *actual = p.cpu;
+   const struct poly_heap *actual_heap = heap_ptr.cpu;
+   const uint32_t *desc = out_draw.cpu;
+   if (test->valid) {
+      CHECK(total * 4 <= HEAP_SIZE - HEAP_BOTTOM);
+      CHECK(actual->nr_patches == test->patches);
+      CHECK(desc[0] == total && desc[1] == 1 &&
+            desc[2] == HEAP_BOTTOM / 4 && desc[3] == 0 && desc[4] == 0);
+      CHECK(actual_heap->bottom ==
+            HEAP_BOTTOM + align((uint32_t)total * 4, 16));
+   } else {
+      CHECK(actual->nr_patches == 0);
+      for (unsigned i = 0; i < 5; i++)
+         CHECK(desc[i] == 0);
+      CHECK(actual_heap->bottom == HEAP_BOTTOM);
+   }
+   printf("tessellation prefix sum PASS %s\n", test->name);
+}
+
+int
+main(void)
+{
+   const VkApplicationInfo app = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .apiVersion = VK_API_VERSION_1_3,
+   };
+   const VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   VkInstance instance;
+   VK_CHECK(kk_CreateInstance(&instance_info, NULL, &instance));
+   PFN_vkEnumeratePhysicalDevices enumerate =
+      (PFN_vkEnumeratePhysicalDevices)kk_GetInstanceProcAddr(
+         instance, "vkEnumeratePhysicalDevices");
+   uint32_t count = 1;
+   VkPhysicalDevice physical;
+   VK_CHECK(enumerate(instance, &count, &physical));
+   CHECK(count == 1);
+   const float priority = 1;
+   const VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   const VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+   };
+   struct context ctx = {0};
+   VK_CHECK(kk_CreateDevice(physical, &device_info, NULL, &ctx.device));
+   ctx.api = &kk_device_from_handle(ctx.device)->exposed_dispatch_table;
+   ctx.api->GetDeviceQueue(ctx.device, 0, 0, &ctx.queue);
+   const VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = 0,
+   };
+   VkCommandPool pool;
+   VK_CHECK(ctx.api->CreateCommandPool(ctx.device, &pool_info, NULL, &pool));
+   const VkCommandBufferAllocateInfo allocation = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   VK_CHECK(ctx.api->AllocateCommandBuffers(ctx.device, &allocation,
+                                            &ctx.command));
+
+   /* The wrapped sizes are small: 2^16 x 2^16 patches wrap to none, 2^16
+    * patches of 2^16 TCS words wrap the TCS buffer to nothing, and 2^22
+    * vertices of 64 outputs wrap the vertex buffer to nothing. */
+   const struct setup_case setups[] = {
+      {"patches", 6, 2, 3, 3, 10, 1, true},
+      {"no-complete-patch", 2, 5, 3, 3, 10, 1, true},
+      {"empty-instances", 6, 0, 3, 3, 10, 1, true},
+      {"patch-count-overflow", 1u << 16, 1u << 16, 1, 1, 1, 0, false},
+      {"tcs-size-overflow", 1u << 16, 1, 1, 1, 1u << 14, 0, false},
+      {"vertex-size-overflow", 1u << 22, 1, 32, 1, 1, UINT64_MAX, false},
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(setups); i++) {
+      VK_CHECK(ctx.api->ResetCommandPool(ctx.device, pool, 0));
+      check_setup(&ctx, &setups[i]);
+   }
+
+   /* 2^32 of the 32-bit sum is lost when it wraps, so each wrapping case
+    * leaves a small total an unchecked allocation would accept. */
+   const struct sum_case sums[] = {
+      {"counts", 4, 1, 3, 6, true},
+      {"counts-past-one-group", 3000, 0, 0, 1, true},
+      {"sum-wraps", 3, 2, 0x80000000u, 16, false},
+      {"sum-wraps-past-one-group", 2049, 2048, 1u << 21, 8, false},
+      {"size-overflow", 1, 1, 1u << 30, 0, false},
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(sums); i++) {
+      VK_CHECK(ctx.api->ResetCommandPool(ctx.device, pool, 0));
+      check_sum(&ctx, &sums[i]);
+   }
+
+   ctx.api->DestroyCommandPool(ctx.device, pool, NULL);
+   ctx.api->DestroyDevice(ctx.device, NULL);
+   kk_DestroyInstance(instance, NULL);
+   return 0;
+}
