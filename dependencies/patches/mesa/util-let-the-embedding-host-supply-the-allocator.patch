diff --git a/src/util/tests/u_host_heap_test.cpp b/src/util/tests/u_host_heap_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c34fe61f43253fab86b4504514feb03444857fbe
--- /dev/null
+++ b/src/util/tests/u_host_heap_test.cpp
@@ -0,0 +1,370 @@
+/* SPDX-License-Identifier: MIT */
+
+/* The framework-local allocator of u_host_heap.h. The test executable links
+ * u_host_heap.c as a whole, as the shared libraries do, so every allocation
+ * in this process -- gtest's included -- takes the path being tested. The
+ * allocator can be installed once per process, so the tests share one
+ * installation and run in the order they are written: what a process does
+ * before installation, then installation, then the routing afterwards. */
+
+#include <gtest/gtest.h>
+
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+
+#include <malloc/malloc.h>
+
+#include "util/u_host_heap.h"
+
+namespace {
+
+/* The host's side: a separate malloc zone, so that a block's origin can be
+ * read back with malloc_zone_from_ptr, and counters that name what was
+ * called. Callbacks that meet a pointer from another zone pass it on to that
+ * zone, as a host passes it to libSystem. They use the zone API only, because
+ * free and malloc are the definitions under test. */
+struct host_state {
+   malloc_zone_t *zone;
+   std::atomic<long> mallocs, callocs, reallocs, memaligns, frees;
+   std::atomic<size_t> last_alignment;
+   std::atomic<bool> fail_next;
+};
+
+host_state *
+state()
+{
+   static host_state *s = [] {
+      host_state *created = new host_state();
+      created->zone = malloc_create_zone(0, 0);
+      return created;
+   }();
+   return s;
+}
+
+bool
+fails(void *data)
+{
+   return static_cast<host_state *>(data)->fail_next.exchange(false);
+}
+
+void *
+host_malloc(void *data, size_t size)
+{
+   auto *s = static_cast<host_state *>(data);
+   s->mallocs++;
+   return fails(data) ? nullptr : malloc_zone_malloc(s->zone, size);
+}
+
+void *
+host_calloc(void *data, size_t count, size_t size)
+{
+   auto *s = static_cast<host_state *>(data);
+   s->callocs++;
+   return fails(data) ? nullptr : malloc_zone_calloc(s->zone, count, size);
+}
+
+void *
+host_realloc(void *data, void *ptr, size_t size)
+{
+   auto *s = static_cast<host_state *>(data);
+   s->reallocs++;
+   if (fails(data))
+      return nullptr;
+   malloc_zone_t *from = ptr ? malloc_zone_from_ptr(ptr) : s->zone;
+   if (from == s->zone || !from)
+      return malloc_zone_realloc(s->zone, ptr, size);
+
+   /* A block of another zone moves into the host's. */
+   void *moved = malloc_zone_malloc(s->zone, size);
+   if (moved) {
+      size_t old = malloc_size(ptr);
+      memcpy(moved, ptr, old < size ? old : size);
+      malloc_zone_free(from, ptr);
+   }
+   return moved;
+}
+
+void *
+host_memalign(void *data, size_t alignment, size_t size)
+{
+   auto *s = static_cast<host_state *>(data);
+   s->memaligns++;
+   s->last_alignment = alignment;
+   return fails(data) ? nullptr : malloc_zone_memalign(s->zone, alignment, size);
+}
+
+void
+host_free(void *data, void *ptr)
+{
+   auto *s = static_cast<host_state *>(data);
+   s->frees++;
+   malloc_zone_free(malloc_zone_from_ptr(ptr), ptr);
+}
+
+mesa_host_allocator
+host_allocator()
+{
+   return mesa_host_allocator{host_malloc, host_calloc, host_realloc,
+                              host_memalign, host_free, state()};
+}
+
+struct counts {
+   long mallocs, callocs, reallocs, memaligns, frees;
+};
+
+counts
+snapshot()
+{
+   host_state *s = state();
+   return counts{s->mallocs, s->callocs, s->reallocs, s->memaligns, s->frees};
+}
+
+bool
+in_host_zone(const void *ptr)
+{
+   return malloc_zone_from_ptr(ptr) == state()->zone;
+}
+
+bool
+in_default_zone(const void *ptr)
+{
+   return malloc_zone_from_ptr(ptr) == malloc_default_zone();
+}
+
+/* Made before the allocator is installed, freed after. */
+void *block_from_before_installation;
+
+bool
+install()
+{
+   static bool installed = [] {
+      mesa_host_allocator allocator = host_allocator();
+      return mesa_set_host_allocator(&allocator);
+   }();
+   return installed;
+}
+
+} /* namespace */
+
+TEST(u_host_heap, forwards_to_libmalloc_before_installation)
+{
+   void *p = malloc(100);
+   ASSERT_NE(p, nullptr);
+   EXPECT_TRUE(in_default_zone(p));
+
+   p = realloc(p, 5000);
+   ASSERT_NE(p, nullptr);
+   EXPECT_TRUE(in_default_zone(p));
+   free(p);
+
+   p = calloc(10, 10);
+   ASSERT_NE(p, nullptr);
+   EXPECT_TRUE(in_default_zone(p));
+   for (int i = 0; i < 100; i++)
+      EXPECT_EQ(static_cast<char *>(p)[i], 0);
+   free(p);
+
+   void *aligned = nullptr;
+   ASSERT_EQ(posix_memalign(&aligned, 256, 10), 0);
+   EXPECT_EQ(reinterpret_cast<uintptr_t>(aligned) % 256, 0u);
+   EXPECT_TRUE(in_default_zone(aligned));
+   free(aligned);
+
+   aligned = aligned_alloc(64, 128);
+   ASSERT_NE(aligned, nullptr);
+   EXPECT_EQ(reinterpret_cast<uintptr_t>(aligned) % 64, 0u);
+   free(aligned);
+
+   block_from_before_installation = malloc(64);
+   ASSERT_NE(block_from_before_installation, nullptr);
+   memset(block_from_before_installation, 0x5a, 64);
+}
+
+TEST(u_host_heap, refuses_what_libc_refuses)
+{
+   free(nullptr);
+
+   void *p = realloc(nullptr, 32);
+   ASSERT_NE(p, nullptr);
+   free(p);
+
+   void *untouched = &p;
+   EXPECT_EQ(posix_memalign(&untouched, 3, 16), EINVAL);
+   EXPECT_EQ(posix_memalign(&untouched, 0, 16), EINVAL);
+   EXPECT_EQ(posix_memalign(&untouched, sizeof(void *) * 3, 16), EINVAL);
+   EXPECT_EQ(untouched, static_cast<void *>(&p));
+
+   /* Variables, so that the compiler does not fold the calls. */
+   volatile size_t not_a_power = 24, zero = 0, huge = SIZE_MAX / 2;
+   errno = 0;
+   EXPECT_EQ(aligned_alloc(not_a_power, 24), nullptr);
+   EXPECT_EQ(errno, EINVAL);
+   errno = 0;
+   EXPECT_EQ(aligned_alloc(zero, 24), nullptr);
+   EXPECT_EQ(errno, EINVAL);
+
+   errno = 0;
+   EXPECT_EQ(calloc(huge, 4), nullptr);
+   EXPECT_EQ(errno, ENOMEM);
+}
+
+TEST(u_host_heap, installs_once)
+{
+   mesa_host_allocator incomplete = host_allocator();
+   incomplete.free = nullptr;
+   EXPECT_FALSE(mesa_set_host_allocator(&incomplete));
+   EXPECT_FALSE(mesa_set_host_allocator(nullptr));
+
+   /* A refusal does not use up the installation. */
+   EXPECT_TRUE(install());
+
+   mesa_host_allocator again = host_allocator();
+   EXPECT_FALSE(mesa_set_host_allocator(&again));
+}
+
+TEST(u_host_heap, routes_every_entry_point_to_the_host)
+{
+   ASSERT_TRUE(install());
+
+   counts before = snapshot();
+   void *p = malloc(100);
+   counts after = snapshot();
+   ASSERT_NE(p, nullptr);
+   EXPECT_TRUE(in_host_zone(p));
+   EXPECT_EQ(after.mallocs - before.mallocs, 1);
+
+   before = snapshot();
+   p = realloc(p, 4000);
+   after = snapshot();
+   ASSERT_NE(p, nullptr);
+   EXPECT_TRUE(in_host_zone(p));
+   EXPECT_EQ(after.reallocs - before.reallocs, 1);
+
+   before = snapshot();
+   free(p);
+   after = snapshot();
+   EXPECT_EQ(after.frees - before.frees, 1);
+
+   before = snapshot();
+   p = calloc(8, 16);
+   after = snapshot();
+   ASSERT_NE(p, nullptr);
+   EXPECT_TRUE(in_host_zone(p));
+   EXPECT_EQ(after.callocs - before.callocs, 1);
+   free(p);
+
+   void *aligned = nullptr;
+   before = snapshot();
+   ASSERT_EQ(posix_memalign(&aligned, 512, 10), 0);
+   after = snapshot();
+   EXPECT_EQ(after.memaligns - before.memaligns, 1);
+   EXPECT_EQ(state()->last_alignment, 512u);
+   EXPECT_EQ(reinterpret_cast<uintptr_t>(aligned) % 512, 0u);
+   EXPECT_TRUE(in_host_zone(aligned));
+   free(aligned);
+
+   before = snapshot();
+   aligned = aligned_alloc(4, 24);
+   after = snapshot();
+   ASSERT_NE(aligned, nullptr);
+   EXPECT_EQ(after.memaligns - before.memaligns, 1);
+   EXPECT_EQ(state()->last_alignment, sizeof(void *));
+   free(aligned);
+
+   /* free passed as a function pointer is the same definition. */
+   void (*volatile destroy)(void *) = free;
+   p = malloc(24);
+   before = snapshot();
+   destroy(p);
+   after = snapshot();
+   EXPECT_EQ(after.frees - before.frees, 1);
+
+   before = snapshot();
+   free(nullptr);
+   after = snapshot();
+   EXPECT_EQ(after.frees - before.frees, 0);
+}
+
+TEST(u_host_heap, hands_a_block_it_did_not_make_to_the_host_free)
+{
+   ASSERT_TRUE(install());
+   ASSERT_NE(block_from_before_installation, nullptr);
+   EXPECT_TRUE(in_default_zone(block_from_before_installation));
+
+   counts before = snapshot();
+   free(block_from_before_installation);
+   counts after = snapshot();
+   EXPECT_EQ(after.frees - before.frees, 1);
+
+   /* libSystem makes it, not the host: strdup allocates inside libSystem. */
+   char *copy = strdup("a block libSystem made for the caller");
+   ASSERT_NE(copy, nullptr);
+   EXPECT_TRUE(in_default_zone(copy));
+   copy = static_cast<char *>(realloc(copy, 200));
+   ASSERT_NE(copy, nullptr);
+   EXPECT_TRUE(in_host_zone(copy));
+   EXPECT_STREQ(copy, "a block libSystem made for the caller");
+   free(copy);
+}
+
+TEST(u_host_heap, reports_failure_as_enomem)
+{
+   ASSERT_TRUE(install());
+
+   state()->fail_next = true;
+   errno = 0;
+   EXPECT_EQ(malloc(16), nullptr);
+   EXPECT_EQ(errno, ENOMEM);
+
+   state()->fail_next = true;
+   errno = 0;
+   EXPECT_EQ(calloc(2, 8), nullptr);
+   EXPECT_EQ(errno, ENOMEM);
+
+   void *p = malloc(16);
+   ASSERT_NE(p, nullptr);
+   state()->fail_next = true;
+   errno = 0;
+   EXPECT_EQ(realloc(p, 4096), nullptr);
+   EXPECT_EQ(errno, ENOMEM);
+   free(p);
+
+   void *aligned = &p;
+   state()->fail_next = true;
+   EXPECT_EQ(posix_memalign(&aligned, 64, 64), ENOMEM);
+   EXPECT_EQ(aligned, static_cast<void *>(&p));
+
+   state()->fail_next = true;
+   errno = 0;
+   EXPECT_EQ(aligned_alloc(64, 64), nullptr);
+   EXPECT_EQ(errno, ENOMEM);
+}
+
+TEST(u_host_heap, takes_a_block_from_one_thread_and_frees_it_on_another)
+{
+   ASSERT_TRUE(install());
+
+   constexpr int count = 1000;
+   static void *blocks[count];
+   counts before = snapshot();
+
+   std::thread producer([] {
+      for (int i = 0; i < count; i++)
+         blocks[i] = malloc(16 + i);
+   });
+   producer.join();
+
+   std::thread consumer([] {
+      for (int i = 0; i < count; i++)
+         free(blocks[i]);
+   });
+   consumer.join();
+
+   counts after = snapshot();
+   EXPECT_EQ(after.mallocs - before.mallocs, count);
+   EXPECT_EQ(after.frees - before.frees, count);
+}
diff --git a/src/util/u_host_heap.c b/src/util/u_host_heap.c
new file mode 100644
index 0000000000000000000000000000000000000000..a8637d81b7b162c6a009906d52532bd32c7d160a
--- /dev/null
+++ b/src/util/u_host_heap.c
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: MIT */
+
+/* The framework-local allocator of u_host_heap.h. This file is compiled with
+ * -fno-builtin, so that the compiler cannot turn a call in it into a call to
+ * the function it is defining, and linked as a whole into each shared library
+ * that takes its allocator from the host. */
+
+#include "util/u_host_heap.h"
+
+#include <errno.h>
+#include <malloc/malloc.h>
+#include <stdlib.h>
+
+#define HIDDEN __attribute__((visibility("hidden")))
+
+static struct mesa_host_allocator storage;
+static bool claimed;
+static const struct mesa_host_allocator *installed;
+
+static inline const struct mesa_host_allocator *
+host(void)
+{
+   return __atomic_load_n(&installed, __ATOMIC_ACQUIRE);
+}
+
+PUBLIC bool
+mesa_set_host_allocator(const struct mesa_host_allocator *allocator)
+{
+   if (!allocator || !allocator->malloc || !allocator->calloc ||
+       !allocator->realloc || !allocator->memalign || !allocator->free)
+      return false;
+
+   if (__atomic_exchange_n(&claimed, true, __ATOMIC_ACQ_REL))
+      return false;
+
+   storage = *allocator;
+   __atomic_store_n(&installed, &storage, __ATOMIC_RELEASE);
+   return true;
+}
+
+static inline void *
+checked(void *ptr)
+{
+   if (!ptr)
+      errno = ENOMEM;
+   return ptr;
+}
+
+static void *
+host_memalign(size_t alignment, size_t size)
+{
+   const struct mesa_host_allocator *a = host();
+   if (a)
+      return a->memalign(a->data, alignment, size);
+   return malloc_zone_memalign(malloc_default_zone(), alignment, size);
+}
+
+HIDDEN void *
+malloc(size_t size)
+{
+   const struct mesa_host_allocator *a = host();
+   if (!a)
+      return malloc_zone_malloc(malloc_default_zone(), size);
+   return checked(a->malloc(a->data, size));
+}
+
+HIDDEN void *
+calloc(size_t count, size_t size)
+{
+   const struct mesa_host_allocator *a = host();
+   if (!a)
+      return malloc_zone_calloc(malloc_default_zone(), count, size);
+   return checked(a->calloc(a->data, count, size));
+}
+
+HIDDEN void *
+realloc(void *ptr, size_t size)
+{
+   const struct mesa_host_allocator *a = host();
+   if (a)
+      return checked(a->realloc(a->data, ptr, size));
+
+   malloc_zone_t *zone = ptr ? malloc_zone_from_ptr(ptr) : NULL;
+   return malloc_zone_realloc(zone ? zone : malloc_default_zone(), ptr, size);
+}
+
+HIDDEN int
+posix_memalign(void **out, size_t alignment, size_t size)
+{
+   if (alignment < sizeof(void *) || (alignment & (alignment - 1)))
+      return EINVAL;
+
+   void *ptr = host_memalign(alignment, size);
+   if (!ptr)
+      return ENOMEM;
+
+   *out = ptr;
+   return 0;
+}
+
+HIDDEN void *
+aligned_alloc(size_t alignment, size_t size)
+{
+   if (alignment == 0 || (alignment & (alignment - 1))) {
+      errno = EINVAL;
+      return NULL;
+   }
+
+   return checked(host_memalign(alignment < sizeof(void *) ?
+                                sizeof(void *) : alignment, size));
+}
+
+HIDDEN void
+free(void *ptr)
+{
+   if (!ptr)
+      return;
+
+   const struct mesa_host_allocator *a = host();
+   if (a) {
+      a->free(a->data, ptr);
+      return;
+   }
+
+   /* A pointer libmalloc does not know is its to report, as it is for free. */
+   malloc_zone_t *zone = malloc_zone_from_ptr(ptr);
+   malloc_zone_free(zone ? zone : malloc_default_zone(), ptr);
+}
