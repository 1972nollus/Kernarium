index 0000000000000000000000000000000000000000..e51dfb985c35986abccddee872280c784e812e39
--- /dev/null
+++ b/src/util/u_host_heap.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: MIT */
+
+#ifndef U_HOST_HEAP_H
+#define U_HOST_HEAP_H
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "util/macros.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* An embedding host's allocator for the memory Mesa allocates for itself.
+ *
+ * Built with -Dhost-heap=true on Darwin, each shared library that links
+ * u_host_heap.c as a whole defines malloc, calloc, realloc, posix_memalign,
+ * aligned_alloc and free for itself, with hidden visibility. The static
+ * linker then binds every reference to them inside that image to those
+ * definitions -- calls, functions whose address is taken (a destructor or a
+ * callback argument) and inline code from Mesa's headers alike -- while every
+ * other image keeps libSystem's. C++ new and delete stay libc++'s, and
+ * libSystem's own allocations (strdup, asprintf, realpath, open_memstream)
+ * stay libSystem's.
+ *
+ * Until a host installs an allocator the definitions forward to libmalloc's
+ * public zone API, so a build that never installs one behaves as before.
+ * mesa_set_host_allocator is exported by every such image, and a host that
+ * links several of them must install the same allocator into all of them
+ * before any of them allocates a block it keeps, because a block taken from
+ * the host's allocator by one image can be freed by another.
+ *
+ * The callbacks must:
+ *  - be thread safe and callable on any thread at any time, a thread that is
+ *    exiting included, and after the host's static destructors have run;
+ *  - behave as libSystem's allocator does on Darwin: 16-byte alignment,
+ *    malloc(0) returning a unique pointer, realloc(NULL, n) acting as
+ *    malloc(n), and calloc failing when count * size overflows;
+ *  - accept in free and realloc a pointer they did not allocate, one made
+ *    before installation or by libSystem for Mesa, and pass it to libSystem.
+ *
+ * free is never called with NULL. A callback reports failure by returning
+ * NULL; the definitions set errno to ENOMEM for it.
+ */
+struct mesa_host_allocator {
+   void *(*malloc)(void *data, size_t size);
+   void *(*calloc)(void *data, size_t count, size_t size);
+   void *(*realloc)(void *data, void *ptr, size_t size);
+   /* alignment is a power of two and at least sizeof(void *). */
+   void *(*memalign)(void *data, size_t alignment, size_t size);
+   void (*free)(void *data, void *ptr);
+   void *data;
+};
+
+/* Install the allocator, once per image. The structure is copied. Returns
+ * false, and installs nothing, when an allocator is already installed or when
+ * a callback is NULL. */
+PUBLIC bool
+mesa_set_host_allocator(const struct mesa_host_allocator *allocator);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* U_HOST_HEAP_H */
