diff --git a/src/kosmickrisp/vulkan/tests/test_image_extent.c b/src/kosmickrisp/vulkan/tests/test_image_extent.c
new file mode 100644
index 00000000..b34363d6
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_image_extent.c
@@ -0,0 +1,112 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_image_extent.h"
+
+#include <assert.h>
+
+static struct kk_image_extent
+usable(void)
+{
+   return (struct kk_image_extent){
+      .width_px = 64u,
+      .height_px = 64u,
+      .depth_px = 1u,
+      .layers = 1u,
+      .levels = 1u,
+      .sample_count_sa = 1u,
+   };
+}
+
+/* The ordinary image every CTS case creates has to stay creatable. */
+static void
+check_a_usable_extent_is_accepted(void)
+{
+   struct kk_image_extent extent = usable();
+   assert(kk_image_extent_is_creatable(&extent));
+
+   extent.depth_px = 16u;
+   extent.layers = 6u;
+   extent.levels = 7u;
+   extent.sample_count_sa = 4u;
+   assert(kk_image_extent_is_creatable(&extent));
+
+   /* A one texel image is legal and must not be mistaken for a degenerate
+    * one. */
+   struct kk_image_extent single = usable();
+   single.width_px = 1u;
+   single.height_px = 1u;
+   assert(kk_image_extent_is_creatable(&single));
+}
+
+/* Metal answers a descriptor with a zero size field by asserting inside
+ * -[MTLTextureDescriptorInternal validateWithDevice:], which ends the host
+ * process. Two campaign shards died that way immediately after a command
+ * queue timeout, on a descriptor whose width and height were both zero, so
+ * every size field has to be refused before it reaches Metal. */
+static void
+check_every_zero_field_is_refused(void)
+{
+   struct kk_image_extent zero_width = usable();
+   zero_width.width_px = 0u;
+   assert(!kk_image_extent_is_creatable(&zero_width));
+
+   struct kk_image_extent zero_height = usable();
+   zero_height.height_px = 0u;
+   assert(!kk_image_extent_is_creatable(&zero_height));
+
+   /* The exact shape the campaign aborted on. */
+   struct kk_image_extent campaign = usable();
+   campaign.width_px = 0u;
+   campaign.height_px = 0u;
+   assert(!kk_image_extent_is_creatable(&campaign));
+
+   struct kk_image_extent zero_depth = usable();
+   zero_depth.depth_px = 0u;
+   assert(!kk_image_extent_is_creatable(&zero_depth));
+
+   struct kk_image_extent zero_layers = usable();
+   zero_layers.layers = 0u;
+   assert(!kk_image_extent_is_creatable(&zero_layers));
+
+   struct kk_image_extent zero_levels = usable();
+   zero_levels.levels = 0u;
+   assert(!kk_image_extent_is_creatable(&zero_levels));
+
+   struct kk_image_extent zero_samples = usable();
+   zero_samples.sample_count_sa = 0u;
+   assert(!kk_image_extent_is_creatable(&zero_samples));
+
+   struct kk_image_extent nothing = {0};
+   assert(!kk_image_extent_is_creatable(&nothing));
+}
+
+/* A chroma plane divides the image extent, so an image Vulkan accepts can
+ * still produce a degenerate plane. */
+static void
+check_a_subsampled_plane_can_be_refused(void)
+{
+   const uint32_t width_px = 1u;
+   const uint32_t height_px = 1u;
+
+   struct kk_image_extent luma = usable();
+   luma.width_px = width_px;
+   luma.height_px = height_px;
+   assert(kk_image_extent_is_creatable(&luma));
+
+   struct kk_image_extent chroma = usable();
+   chroma.width_px = width_px / 2u;
+   chroma.height_px = height_px / 2u;
+   assert(!kk_image_extent_is_creatable(&chroma));
+}
+
+int
+main(void)
+{
+   check_a_usable_extent_is_accepted();
+   check_every_zero_field_is_refused();
+   check_a_subsampled_plane_can_be_refused();
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_queue_error.c b/src/kosmickrisp/vulkan/tests/test_queue_error.c
new file mode 100644
index 00000000..1e333fd2
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_queue_error.c
@@ -0,0 +1,278 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_queue_error.h"
+
+#include <assert.h>
+#include <string.h>
+
+static struct mtl_feedback_data
+feedback(enum mtl_command_queue_error error, const char *message,
+         double gpu_start, double gpu_end)
+{
+   return (struct mtl_feedback_data){
+      .user_data = NULL,
+      .error_message = message,
+      .gpu_start = gpu_start,
+      .gpu_end = gpu_end,
+      .error = error,
+   };
+}
+
+static void
+describe(char *buffer, size_t size, enum mtl_command_queue_error error,
+         const char *message, double gpu_start, double gpu_end)
+{
+   struct mtl_feedback_data data = feedback(error, message, gpu_start, gpu_end);
+
+   memset(buffer, 0x7f, size);
+   kk_queue_error_describe(buffer, size, &data);
+}
+
+/* Every code Metal can report must name itself. The enumeration belongs to
+ * Metal: device removal (4) is deprecated rather than absent, and a newer
+ * system can report a code this driver predates. */
+static void
+check_every_error_is_named(void)
+{
+   static const enum mtl_command_queue_error modeled[] = {
+      MTL_COMMAND_QUEUE_ERROR_NONE,
+      MTL_COMMAND_QUEUE_ERROR_TIMEOUT,
+      MTL_COMMAND_QUEUE_ERROR_NOT_PERMITTED,
+      MTL_COMMAND_QUEUE_ERROR_OUT_OF_MEMORY,
+      MTL_COMMAND_QUEUE_ERROR_ACCESS_REVOKED,
+      MTL_COMMAND_QUEUE_ERROR_INTERNAL,
+   };
+
+   for (unsigned i = 0u; i < sizeof(modeled) / sizeof(modeled[0]); ++i) {
+      const char *name = kk_queue_error_name(modeled[i]);
+      assert(name != NULL);
+      assert(strncmp(name, "MTL_COMMAND_QUEUE_ERROR_", 24u) == 0);
+      assert(strcmp(name, "MTL_COMMAND_QUEUE_ERROR_UNKNOWN") != 0);
+   }
+
+   for (unsigned code = 0u; code < 32u; ++code) {
+      const char *name =
+         kk_queue_error_name((enum mtl_command_queue_error)code);
+      assert(name != NULL);
+      assert(strncmp(name, "MTL_COMMAND_QUEUE_ERROR_", 24u) == 0);
+   }
+
+   /* Deprecated device removal and any future code still describe
+    * themselves instead of leaving the error path without a name. */
+   assert(strcmp(kk_queue_error_name((enum mtl_command_queue_error)4),
+                 "MTL_COMMAND_QUEUE_ERROR_UNKNOWN") == 0);
+   assert(strcmp(kk_queue_error_name((enum mtl_command_queue_error)7),
+                 "MTL_COMMAND_QUEUE_ERROR_UNKNOWN") == 0);
+}
+
+/* A timeout whose submission never reached the GPU is a stalled queue, not a
+ * workload that runs too long, and the report has to say which one it saw. */
+static void
+check_unexecuted_timeout_is_distinguished(void)
+{
+   char report[KK_QUEUE_ERROR_REPORT_SIZE];
+
+   describe(report, sizeof(report), MTL_COMMAND_QUEUE_ERROR_TIMEOUT,
+            "The operation couldn't be completed.", 0.0, 0.0);
+
+   assert(strstr(report, "MTL_COMMAND_QUEUE_ERROR_TIMEOUT") != NULL);
+   assert(strstr(report, "(code 1)") != NULL);
+   assert(strstr(report, "The operation couldn't be completed.") != NULL);
+   assert(strstr(report, "the GPU never started this submission") != NULL);
+   assert(strstr(report, "accounted for") == NULL);
+   assert(strstr(report, "the device is lost") != NULL);
+}
+
+/* A timeout Metal accounted for from start to finish leaves a live queue
+ * behind: the measured case executed for 0.177804 s while a 0.452050 s
+ * submission on the same host succeeded, and a shard carrying six such reports
+ * resolved all 3,906 of its cases. Losing the device throws away that queue
+ * and every result that would follow it, so the report must not. */
+static void
+check_accounted_timeout_keeps_the_device(void)
+{
+   struct mtl_feedback_data data = feedback(
+      MTL_COMMAND_QUEUE_ERROR_TIMEOUT,
+      "The operation couldn't be completed. (MTL4CommandQueueErrorDomain "
+      "error 1.)",
+      582690.09828587505, 582690.27608987503);
+   char report[KK_QUEUE_ERROR_REPORT_SIZE];
+
+   assert(kk_queue_error_has_execution_interval(&data));
+   assert(!kk_queue_error_is_device_lost(&data));
+
+   memset(report, 0x7f, sizeof(report));
+   kk_queue_error_describe(report, sizeof(report), &data);
+   /* The report has to keep the doubt with the submission rather than claim
+    * the results are good. */
+   assert(strstr(report, "the device survives") != NULL);
+   assert(strstr(report, "results are in doubt") != NULL);
+   assert(strstr(report, "the device is lost") == NULL);
+}
+
+/* A timeout the GPU never started or never finished is the queue itself
+ * stopping, and that must still lose the device. */
+static void
+check_unfinished_timeout_loses_the_device(void)
+{
+   /* Never scheduled. */
+   struct mtl_feedback_data never =
+      feedback(MTL_COMMAND_QUEUE_ERROR_TIMEOUT, "timed out", 0.0, 0.0);
+   /* Started and abandoned, so Metal has no completion timestamp. */
+   struct mtl_feedback_data abandoned =
+      feedback(MTL_COMMAND_QUEUE_ERROR_TIMEOUT, "timed out", 582690.5, 0.0);
+   /* Accounted for without measurable execution. */
+   struct mtl_feedback_data instant = feedback(MTL_COMMAND_QUEUE_ERROR_TIMEOUT,
+                                               "timed out", 582690.5, 582690.5);
+
+   assert(!kk_queue_error_has_execution_interval(&never));
+   assert(!kk_queue_error_has_execution_interval(&abandoned));
+   assert(!kk_queue_error_has_execution_interval(&instant));
+   assert(kk_queue_error_is_device_lost(&never));
+   assert(kk_queue_error_is_device_lost(&abandoned));
+   assert(kk_queue_error_is_device_lost(&instant));
+}
+
+/* Only a timeout can be survivable. Every other failure loses work, so a
+ * complete execution interval must not excuse it, and a successful commit is
+ * never a loss. */
+static void
+check_only_timeouts_can_be_survived(void)
+{
+   static const enum mtl_command_queue_error fatal[] = {
+      MTL_COMMAND_QUEUE_ERROR_NOT_PERMITTED,
+      MTL_COMMAND_QUEUE_ERROR_OUT_OF_MEMORY,
+      MTL_COMMAND_QUEUE_ERROR_ACCESS_REVOKED,
+      MTL_COMMAND_QUEUE_ERROR_INTERNAL,
+      (enum mtl_command_queue_error)4, /* deprecated device removal */
+      (enum mtl_command_queue_error)7, /* a code this driver predates */
+   };
+
+   for (unsigned i = 0u; i < sizeof(fatal) / sizeof(fatal[0]); ++i) {
+      struct mtl_feedback_data ran =
+         feedback(fatal[i], "failed", 582690.09828587505, 582690.27608987503);
+      assert(kk_queue_error_has_execution_interval(&ran));
+      assert(kk_queue_error_is_device_lost(&ran));
+   }
+
+   struct mtl_feedback_data ok =
+      feedback(MTL_COMMAND_QUEUE_ERROR_NONE, NULL, 582690.5, 582690.6);
+   assert(!kk_queue_error_is_device_lost(&ok));
+}
+
+/* A campaign timeout measured 0.177804 s of GPU execution while a submission
+ * on another device completed successfully over the same interval, so the
+ * report has to carry both the duration and the raw host GPU clock that lines
+ * one process up against another. */
+static void
+check_executed_timeout_reports_its_interval(void)
+{
+   char report[KK_QUEUE_ERROR_REPORT_SIZE];
+
+   describe(report, sizeof(report), MTL_COMMAND_QUEUE_ERROR_TIMEOUT, "hung",
+            582690.09828587505, 582690.27608987503);
+
+   assert(strstr(report, "the GPU accounted for 0.177804 s of execution") !=
+          NULL);
+   assert(strstr(report, "gpu_start_s=582690.09828587505") != NULL);
+   assert(strstr(report, "gpu_end_s=582690.27608987503") != NULL);
+   assert(strstr(report, "never started") == NULL);
+}
+
+/* A submission Metal never scheduled has no host GPU clock reading, so a zero
+ * start is not an interval however the end reads. */
+static void
+check_unscheduled_submission_has_no_interval(void)
+{
+   struct mtl_feedback_data data =
+      feedback(MTL_COMMAND_QUEUE_ERROR_TIMEOUT, "timed out", 0.0, 582690.5);
+
+   assert(!kk_queue_error_has_execution_interval(&data));
+   assert(kk_queue_error_is_device_lost(&data));
+}
+
+/* Metal reports start == end for a submission it accounted for but did not
+ * run long enough to measure; that is neither of the two cases above. */
+static void
+check_degenerate_interval_is_not_claimed_as_execution(void)
+{
+   char report[KK_QUEUE_ERROR_REPORT_SIZE];
+
+   describe(report, sizeof(report), MTL_COMMAND_QUEUE_ERROR_INTERNAL, "oops",
+            582313.5, 582313.5);
+
+   assert(strstr(report, "no execution interval") != NULL);
+   assert(strstr(report, "never started") == NULL);
+   assert(strstr(report, "accounted for") == NULL);
+}
+
+/* Metal supplies no localized description for some failures. */
+static void
+check_missing_message_is_named(void)
+{
+   char report[KK_QUEUE_ERROR_REPORT_SIZE];
+
+   describe(report, sizeof(report), MTL_COMMAND_QUEUE_ERROR_OUT_OF_MEMORY,
+            NULL, 0.0, 0.0);
+   assert(strstr(report, "message: (none)") != NULL);
+   assert(strstr(report, "(null)") == NULL);
+
+   describe(report, sizeof(report), MTL_COMMAND_QUEUE_ERROR_OUT_OF_MEMORY, "",
+            0.0, 0.0);
+   assert(strstr(report, "message: (none)") != NULL);
+}
+
+/* The report is written by an asynchronous Metal feedback handler, so it must
+ * stay inside the caller's buffer and stay NUL terminated. */
+static void
+check_report_is_bounded(void)
+{
+   char report[KK_QUEUE_ERROR_REPORT_SIZE + 1u];
+   char small[24];
+
+   static char long_message[2u * KK_QUEUE_ERROR_REPORT_SIZE];
+   memset(long_message, 'x', sizeof(long_message) - 1u);
+
+   describe(report, KK_QUEUE_ERROR_REPORT_SIZE,
+            MTL_COMMAND_QUEUE_ERROR_TIMEOUT, long_message, 0.0, 0.0);
+   report[KK_QUEUE_ERROR_REPORT_SIZE] = '\0';
+   assert(strlen(report) < KK_QUEUE_ERROR_REPORT_SIZE);
+
+   /* Metal owns the only unbounded field, so truncating it must not cost the
+    * reader the error, the execution interval or the disposition. */
+   assert(strstr(report, "MTL_COMMAND_QUEUE_ERROR_TIMEOUT") != NULL);
+   assert(strstr(report, "the GPU never started this submission") != NULL);
+   assert(strstr(report, "the device is lost") != NULL);
+
+   describe(small, sizeof(small), MTL_COMMAND_QUEUE_ERROR_TIMEOUT, "message",
+            0.0, 0.0);
+   assert(strlen(small) < sizeof(small));
+
+   /* A zero sized or absent buffer must not be written at all. */
+   struct mtl_feedback_data data = {
+      .error = MTL_COMMAND_QUEUE_ERROR_TIMEOUT,
+   };
+   char guard = 0x5a;
+   kk_queue_error_describe(&guard, 0u, &data);
+   assert(guard == 0x5a);
+   kk_queue_error_describe(NULL, sizeof(report), &data);
+}
+
+int
+main(void)
+{
+   check_every_error_is_named();
+   check_unexecuted_timeout_is_distinguished();
+   check_accounted_timeout_keeps_the_device();
+   check_unfinished_timeout_loses_the_device();
+   check_only_timeouts_can_be_survived();
+   check_executed_timeout_reports_its_interval();
+   check_unscheduled_submission_has_no_interval();
+   check_degenerate_interval_is_not_claimed_as_execution();
+   check_missing_message_is_named();
+   check_report_is_bounded();
+   return 0;
+}
