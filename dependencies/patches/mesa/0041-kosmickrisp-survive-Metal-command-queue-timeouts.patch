@@ -0,0 +1,34 @@
+/*
+ * Copyright 2026 LunarG, Inc.
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef KK_IMAGE_EXTENT_H
+#define KK_IMAGE_EXTENT_H 1
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* The size fields of one Metal texture descriptor. */
+struct kk_image_extent {
+   uint32_t width_px;
+   uint32_t height_px;
+   uint32_t depth_px;
+   uint32_t layers;
+   uint32_t levels;
+   uint32_t sample_count_sa;
+};
+
+/* Whether Metal will accept a texture descriptor of this size.
+ *
+ * Metal validates a texture descriptor with an assertion that ends the
+ * process, and it validates one for a heap size query just as it does for
+ * texture creation, so a zero in any of these fields costs the host rather
+ * than the Vulkan call. Vulkan already requires every one of them to be at
+ * least one, so refusing is invisible to a conforming caller. This driver
+ * serves a guest across a protocol, and a guest that has just lost its Vulkan
+ * device is exactly where an out-of-contract image arrives.
+ */
+bool kk_image_extent_is_creatable(const struct kk_image_extent *extent);
+
+#endif /* KK_IMAGE_EXTENT_H */
