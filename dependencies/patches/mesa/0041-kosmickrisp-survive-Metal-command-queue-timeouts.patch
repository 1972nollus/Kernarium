diff --git a/src/kosmickrisp/vulkan/kk_queue_error.c b/src/kosmickrisp/vulkan/kk_queue_error.c
new file mode 100644
index 00000000..b9fb4fd1
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_queue_error.c
@@ -0,0 +1,102 @@
+/*
+ * Copyright 2026 LunarG, Inc.
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kk_queue_error.h"
+
+#include <math.h>
+#include <stdio.h>
+
+const char *
+kk_queue_error_name(enum mtl_command_queue_error error)
+{
+   switch (error) {
+   case MTL_COMMAND_QUEUE_ERROR_NONE:
+      return "MTL_COMMAND_QUEUE_ERROR_NONE";
+   case MTL_COMMAND_QUEUE_ERROR_TIMEOUT:
+      return "MTL_COMMAND_QUEUE_ERROR_TIMEOUT";
+   case MTL_COMMAND_QUEUE_ERROR_NOT_PERMITTED:
+      return "MTL_COMMAND_QUEUE_ERROR_NOT_PERMITTED";
+   case MTL_COMMAND_QUEUE_ERROR_OUT_OF_MEMORY:
+      return "MTL_COMMAND_QUEUE_ERROR_OUT_OF_MEMORY";
+   case MTL_COMMAND_QUEUE_ERROR_ACCESS_REVOKED:
+      return "MTL_COMMAND_QUEUE_ERROR_ACCESS_REVOKED";
+   case MTL_COMMAND_QUEUE_ERROR_INTERNAL:
+      return "MTL_COMMAND_QUEUE_ERROR_INTERNAL";
+   }
+
+   /* Metal owns this enumeration. Device removal (4) is deprecated rather than
+    * absent, and a newer system can report a code this driver predates, so an
+    * unmodeled value must still describe itself instead of leaving the error
+    * path without a name. */
+   return "MTL_COMMAND_QUEUE_ERROR_UNKNOWN";
+}
+
+bool
+kk_queue_error_has_execution_interval(const struct mtl_feedback_data *data)
+{
+   return isfinite(data->gpu_start) && isfinite(data->gpu_end) &&
+          data->gpu_start > 0.0 && data->gpu_end > data->gpu_start;
+}
+
+bool
+kk_queue_error_is_device_lost(const struct mtl_feedback_data *data)
+{
+   if (data->error == MTL_COMMAND_QUEUE_ERROR_NONE)
+      return false;
+
+   /* A timeout is the one failure that leaves a live queue behind, and only
+    * when Metal accounted for the submission from start to finish. Anything
+    * else stopped the queue. */
+   if (data->error != MTL_COMMAND_QUEUE_ERROR_TIMEOUT)
+      return true;
+
+   return !kk_queue_error_has_execution_interval(data);
+}
+
+void
+kk_queue_error_describe(char *buffer, size_t size,
+                        const struct mtl_feedback_data *data)
+{
+   if (buffer == NULL || size == 0u)
+      return;
+
+   char execution[96];
+
+   if (kk_queue_error_has_execution_interval(data)) {
+      snprintf(execution, sizeof(execution),
+               "the GPU accounted for %.6f s of execution",
+               data->gpu_end - data->gpu_start);
+   } else if (data->gpu_start == 0.0 && data->gpu_end == 0.0) {
+      snprintf(execution, sizeof(execution),
+               "the GPU never started this submission");
+   } else {
+      snprintf(execution, sizeof(execution),
+               "the GPU reported no execution interval for this submission");
+   }
+
+   /* State the disposition the caller acts on, so a report can never claim
+    * something other than what happened to the device. */
+   const char *disposition =
+      kk_queue_error_is_device_lost(data)
+         ? "the queue stopped making progress and the device is lost"
+         : "the device survives and only this submission's results are in "
+           "doubt";
+
+   const char *message =
+      (data->error_message != NULL && data->error_message[0] != '\0')
+         ? data->error_message
+         : "(none)";
+
+   /* The timestamps are the raw host GPU clock, so two processes that fail at
+    * once can be lined up against each other directly. Metal's own text goes
+    * last: it is the only unbounded part, and truncating it must not take the
+    * disposition with it. */
+   snprintf(buffer, size,
+            "command queue error: %s (code %u), %s "
+            "(gpu_start_s=%.17g gpu_end_s=%.17g), so %s, message: %s",
+            kk_queue_error_name(data->error), (unsigned)data->error, execution,
+            data->gpu_start, data->gpu_end, disposition, message);
+}
diff --git a/src/kosmickrisp/vulkan/kk_queue_error.h b/src/kosmickrisp/vulkan/kk_queue_error.h
new file mode 100644
index 00000000..f8e2b9c1
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_queue_error.h
@@ -0,0 +1,57 @@
+/*
+ * Copyright 2026 LunarG, Inc.
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef KK_QUEUE_ERROR_H
+#define KK_QUEUE_ERROR_H 1
+
+#include "kosmickrisp/bridge/mtl_types.h"
+
+#include <stdbool.h>
+
+/* Upper bound on one report, including the terminating NUL. */
+#define KK_QUEUE_ERROR_REPORT_SIZE 512u
+
+/* Stable name for any Metal command queue error, including codes this driver
+ * does not model. Never returns NULL. */
+const char *kk_queue_error_name(enum mtl_command_queue_error error);
+
+/* Whether Metal accounted for this submission from a start to a later end.
+ * Metal leaves both timestamps at zero for a submission the GPU never
+ * scheduled, and reports a start without a later end for one it never
+ * finished; either way the queue stopped making progress on it. */
+bool
+kk_queue_error_has_execution_interval(const struct mtl_feedback_data *data);
+
+/* Whether this failure destroyed the device.
+ *
+ * A Metal command queue timeout says one submission exceeded the time the
+ * system allows, not that the device is broken. On a contended host the queue
+ * keeps accepting and completing work after such a report, and how long the
+ * GPU ran does not predict it: a submission executing for a fraction of a
+ * second is reported while a longer one on the same GPU succeeds. Losing the
+ * device would throw away a live queue and every result that would follow it,
+ * so a timeout Metal accounted for from start to finish is reported and
+ * survived. What such a report puts in doubt is that one submission's
+ * contents, which the driver cannot repair and Vulkan cannot express short of
+ * device loss; the work itself is where that shows.
+ *
+ * Every other error, and a timeout for a submission the GPU never started or
+ * never finished, means the queue stopped making progress. That is the hang,
+ * and it stays device loss.
+ */
+bool kk_queue_error_is_device_lost(const struct mtl_feedback_data *data);
+
+/* Describe one failed Metal commit into buffer without allocating.
+ *
+ * Metal reports a commit failure asynchronously, long after the submission
+ * that caused it returned, so this report is the only evidence the failure
+ * leaves behind. It therefore always states what Metal accounted for, and
+ * closes with the disposition kk_queue_error_is_device_lost() chose, so the
+ * report and the action can never disagree.
+ */
+void kk_queue_error_describe(char *buffer, size_t size,
+                             const struct mtl_feedback_data *data);
+
+#endif /* KK_QUEUE_ERROR_H */
