diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 5ddfada86b6bdd7f86be41081aaa625b1e9185f3..e7312b15a81ccc5cf0eca46b1e742231fa43d2f0 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -348,6 +348,23 @@ kk_queue_submission_new(struct kk_queue_feedback *feedback, uint64_t serial)
    return submission;
 }
 
+/* The storage of a probe's empty command buffer, which the GPU is done with
+ * when Metal reports the commit. */
+struct kk_queue_probe_storage {
+   mtl_command_allocator *allocator;
+   mtl_command_buffer *command_buffer;
+};
+
+static void
+kk_queue_probe_done(struct mtl_feedback_data *data)
+{
+   struct kk_queue_probe_storage *storage = data->user_data;
+
+   mtl_release(storage->command_buffer);
+   mtl_release(storage->allocator);
+   free(storage);
+}
+
 static void
 commit_callback(struct mtl_feedback_data *data)
 {
@@ -433,6 +450,78 @@ commit_callback(struct mtl_feedback_data *data)
    kk_queue_feedback_unref(feedback);
 }
 
+bool
+kk_queue_probe(struct kk_queue *queue)
+{
+   struct kk_queue_feedback *feedback = queue->feedback;
+   if (!feedback)
+      return false;
+
+   /* The submit thread owns the queue while it submits, and a submission has
+    * a commit to report on, so there is nothing to ask. Taken for the whole
+    * probe, this also keeps the queue from being replaced under it. */
+   if (mtx_trylock(&queue->submit_mutex) != thrd_success)
+      return false;
+
+   bool probed = false;
+   struct kk_device *dev = kk_queue_device(queue);
+   const uint64_t now = os_time_get_nano();
+
+   simple_mtx_lock(&feedback->signal_mutex);
+   const bool due = feedback->reported == feedback->last_serial &&
+                    (feedback->probed_at == 0u ||
+                     now - feedback->probed_at >= KK_QUEUE_PROBE_DELAY_NS);
+   if (due)
+      feedback->probed_at = now;
+   simple_mtx_unlock(&feedback->signal_mutex);
+   if (!due)
+      goto out;
+
+   /* Everything the probe needs exists before it is committed, so a failure to
+    * make any of it costs nothing the queue's accounting has seen. */
+   mtl_command_allocator *allocator =
+      mtl_new_command_allocator(dev->mtl_handle);
+   mtl_command_buffer *command_buffer =
+      allocator ? mtl_new_command_buffer(dev->mtl_handle) : NULL;
+   mtl_commit_options *options =
+      command_buffer ? mtl_new_commit_options() : NULL;
+   struct kk_queue_probe_storage *storage =
+      options ? malloc(sizeof(*storage)) : NULL;
+   struct kk_queue_submission *submission =
+      storage ? kk_queue_submission_new(feedback, 0u) : NULL;
+   if (!submission) {
+      if (storage)
+         free(storage);
+      if (options)
+         mtl_release(options);
+      if (command_buffer)
+         mtl_release(command_buffer);
+      if (allocator)
+         mtl_release(allocator);
+      goto out;
+   }
+   storage->allocator = allocator;
+   storage->command_buffer = command_buffer;
+   mtl_begin_command_buffer(command_buffer, allocator);
+   mtl_end_command_buffer(command_buffer);
+
+   /* An ordinary submission with an ordinary report: it takes a serial, and
+    * the queue is not retired and the probe not counted answered until Metal
+    * has reported it. */
+   submission->serial = kk_queue_reserve_serial(feedback);
+   mtl_commit_options_add_feedback_handler(options, kk_queue_probe_done,
+                                           storage);
+   mtl_commit_options_add_feedback_handler(options, queue->feedback_callback,
+                                           submission);
+   mtl_command_queue_commit(queue->mtl_handle, &command_buffer, 1, options);
+   mtl_release(options);
+   probed = true;
+
+out:
+   mtx_unlock(&queue->submit_mutex);
+   return probed;
+}
+
 /* A submitted recording's native command storage. Metal cannot run a
  * recording twice, so every submission detaches the storage from its Vulkan
  * command buffer, and the storage goes back once the GPU is done with it
@@ -667,9 +756,8 @@ kk_commit_parts_free(struct kk_commit_part *parts, uint32_t count)
 }
 
 static VkResult
-kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
+kk_queue_submit_locked(struct kk_queue *queue, struct vk_queue_submit *submit)
 {
-   struct kk_queue *queue = container_of(vk_queue, struct kk_queue, vk);
    struct kk_device *dev = kk_queue_device(queue);
 
    if (vk_queue_is_lost(&queue->vk))
@@ -825,6 +913,17 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
    return VK_SUCCESS;
 }
 
+static VkResult
+kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
+{
+   struct kk_queue *queue = container_of(vk_queue, struct kk_queue, vk);
+
+   mtx_lock(&queue->submit_mutex);
+   VkResult result = kk_queue_submit_locked(queue, submit);
+   mtx_unlock(&queue->submit_mutex);
+   return result;
+}
+
 VkResult
 kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
               const VkDeviceQueueCreateInfo *pCreateInfo,
@@ -864,6 +963,7 @@ kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
       return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
    }
    queue->feedback->refcount = 1;
+   mtx_init(&queue->submit_mutex, mtx_plain);
    simple_mtx_init(&queue->feedback->mutex, mtx_plain);
    simple_mtx_init(&queue->feedback->signal_mutex, mtx_plain);
    util_dynarray_init(&queue->feedback->signals, NULL);
@@ -879,6 +979,7 @@ kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
          mtl_release(queue->mtl_handle);
       if (queue->layer_order_event)
          mtl_release(queue->layer_order_event);
+      mtx_destroy(&queue->submit_mutex);
       kk_queue_feedback_unref(queue->feedback);
       vk_queue_finish(&queue->vk);
       return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
@@ -910,4 +1011,5 @@ kk_queue_finish(struct kk_device *dev, struct kk_queue *queue)
                                           dev->residency_set.handle);
    mtl_release(queue->mtl_handle);
    mtl_release(queue->layer_order_event);
+   mtx_destroy(&queue->submit_mutex);
 }
diff --git a/src/kosmickrisp/vulkan/kk_queue.h b/src/kosmickrisp/vulkan/kk_queue.h
index f3f129f7ba523dfbbf5df7eda2c3e07010a33733..dd4f1556f802147a40451c711c8df1c1c82f88b7 100644
--- a/src/kosmickrisp/vulkan/kk_queue.h
+++ b/src/kosmickrisp/vulkan/kk_queue.h
@@ -56,6 +56,8 @@ struct kk_queue_feedback {
     * Unlike failures, this is never cleared: a GPU write destroyed by a
     * failure stays destroyed after the queue that lost it is retired. */
    bool ever_failed;
+   /* When the queue was last probed (see kk_queue_probe), zero for never. */
+   uint64_t probed_at;
 };
 
 /* Per-submission feedback payload. Metal reports a failure against one
@@ -75,6 +77,10 @@ kk_queue_feedback_ref(struct kk_queue_feedback *feedback)
 
 struct kk_queue {
    struct vk_queue vk;
+   /* Held while the submit thread submits, so that anyone else who commits to
+    * the queue (kk_queue_probe) neither interleaves with a submission nor
+    * races the queue's replacement. */
+   mtx_t submit_mutex;
    struct mtl_command_queue *mtl_handle;
    mtl_feedback_handler_callback feedback_callback;
    struct kk_queue_feedback *feedback;
@@ -121,8 +127,9 @@ struct kk_queue_progress kk_queue_get_progress(struct kk_queue *queue);
  *
  * The two together say what an undelivered signal means. A queue carrying a
  * reported failure destroyed the signal, and completing it is the repair. A
- * queue that has reported no failure destroyed nothing: it accepted the signal
- * and then stopped, and unreported says how much work it is sitting on. */
+ * queue that has reported no failure destroyed nothing, unless it is failing
+ * without saying so (see kk_queue_probe): it accepted the signal and then
+ * stopped, and unreported says how much work it is sitting on. */
 bool kk_queue_failure_outstanding(struct kk_queue *queue,
                                   uint64_t *unreported);
 
@@ -136,6 +143,33 @@ bool kk_queue_failure_outstanding(struct kk_queue *queue,
  * failed. */
 #define KK_LOST_WORK_TIMEOUT_NS (10ull * 1000000000ull)
 
+/* How long a timeline signal the queue took stays undelivered, on a queue that
+ * has reported no failure and holds no work it has not answered for, before
+ * the waiter asks the queue whether it is failing without saying so. The
+ * bound is a tenth of the one for losing the device, and a probe costs one
+ * empty command buffer, so a queue that is only held up by a wait the host
+ * has not released is asked repeatedly and lost nothing. */
+#define KK_QUEUE_PROBE_DELAY_NS (1ull * 1000000000ull)
+
+/* Commits an empty command buffer to the queue, behind everything it holds,
+ * and lets the queue's report on it say whether the queue still runs work.
+ *
+ * Metal reports a failure through the feedback of a commit, and a signal
+ * enqueued on a queue without a command buffer behind it has no feedback. A
+ * queue that rejects every submission, as iOS makes the queue of an app it has
+ * denied the GPU, therefore drops such a signal without a word: the failure
+ * count stays zero and the queue holds nothing it has not answered for, which
+ * is how a queue that stopped looks, and a waiter on the signal would lose the
+ * device for it. The probe gives the queue something to report. A queue that
+ * rejects it reports a failure, and the failure releases the waiters it owes
+ * as any other does. A queue that runs it says nothing, and one held up behind
+ * a wait only the host can release answers once the host does.
+ *
+ * At most one probe per KK_QUEUE_PROBE_DELAY_NS, and none while the queue holds
+ * a submission it has not answered for, which is the probe itself, or while the
+ * submit thread is submitting. Returns whether it committed one. */
+bool kk_queue_probe(struct kk_queue *queue);
+
 /* How long a queue that has reported no failure may hold work it does not
  * answer for before a waiter on that work concludes the queue has stopped.
  * Such a queue destroyed nothing; it stopped running work. Nothing restarts a
diff --git a/src/kosmickrisp/vulkan/kk_sync.c b/src/kosmickrisp/vulkan/kk_sync.c
index 24c13070a3d16bc3f9ef0b10f5eb0120e1729e35..9796a7cd193ad9483e489864b8313145b5b30736 100644
--- a/src/kosmickrisp/vulkan/kk_sync.c
+++ b/src/kosmickrisp/vulkan/kk_sync.c
@@ -138,6 +138,7 @@ kk_timeline_recover_lost_signal(struct kk_device *dev,
    const uint64_t bound = failure_outstanding ? KK_LOST_WORK_TIMEOUT_NS
                                               : KK_STOPPED_QUEUE_TIMEOUT_NS;
    bool expired = false;
+   uint64_t overdue = 0u;
    simple_mtx_lock(&timeline->overdue_mutex);
    /* Read the time under the lock: another waiter may start the clock after
     * an earlier reading, and the elapsed time must never go negative. */
@@ -145,11 +146,30 @@ kk_timeline_recover_lost_signal(struct kk_device *dev,
    if (timeline->overdue_since == 0u || timeline->stalled_value != signaled) {
       timeline->stalled_value = signaled;
       timeline->overdue_since = now;
-   } else if (now - timeline->overdue_since >= bound) {
-      timeline->overdue_since = 0u;
-      expired = true;
+   } else {
+      overdue = now - timeline->overdue_since;
+      if (overdue >= bound) {
+         timeline->overdue_since = 0u;
+         expired = true;
+      }
    }
    simple_mtx_unlock(&timeline->overdue_mutex);
+
+   /* No failure reported and nothing held that the queue has not answered for
+    * is also how a queue looks that rejects everything it is given and drops
+    * a signal without a commit behind it, which is not a stopped queue and
+    * must not cost the device. Give the queue something to report, and a
+    * failure it reports releases this waiter as any other does. */
+   if (!expired && !failure_outstanding && unreported == 0u &&
+       overdue >= KK_QUEUE_PROBE_DELAY_NS && kk_queue_probe(&dev->queue)) {
+      fprintf(stderr,
+              "KosmicKrisp probing the Metal command queue: it accepted a "
+              "timeline signal for value %" PRIu64
+              ", has not delivered it in %" PRIu64
+              " ms, has reported no failure and holds no work it has not "
+              "answered for\n",
+              wait_value, overdue / 1000000ull);
+   }
    if (!expired)
       return;
 
