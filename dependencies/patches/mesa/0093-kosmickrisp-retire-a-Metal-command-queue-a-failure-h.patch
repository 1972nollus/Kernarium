 src/kosmickrisp/vulkan/kk_queue.c | 107 ++++++++++++++++++++++++++----
 src/kosmickrisp/vulkan/kk_queue.h |   4 ++
 2 files changed, 99 insertions(+), 12 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index e073e6bf..9933c76b 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -187,6 +187,69 @@ kk_queue_resolve_if_drained(struct kk_queue_feedback *feedback)
       kk_queue_signals_make_good(feedback, UINT64_MAX);
 }
 
+/* Metal does not revive a command queue that has killed a submission. It
+ * admits each later commit and reports it failed in well under a millisecond,
+ * with the same timeout code and no execution, for as long as the queue
+ * exists: a survived timeout leaves a queue that accepts work and runs none of
+ * it. Nothing in Metal 4 resets one, so the only repair is to stop using it and
+ * commit to a replacement.
+ *
+ * The replacement is made here, on the queue's own submit thread, so nothing
+ * observes a half-swapped handle, and only once Metal has reported every
+ * submission the retired queue was given. Waiting for that is what keeps the
+ * driver's single-queue ordering intact: no submission is ever split across the
+ * two queues, and the retired queue has no report left that could arrive after
+ * its signals were made good. A queue that never drains is a queue that stopped
+ * reporting, which is device loss and is handled as such.
+ */
+static bool
+kk_queue_replace_retired(struct kk_queue *queue)
+{
+   struct kk_queue_feedback *feedback = queue->feedback;
+   struct kk_device *dev = kk_queue_device(queue);
+
+   simple_mtx_lock(&feedback->signal_mutex);
+   bool retire =
+      feedback->poisoned && feedback->reported == feedback->last_serial;
+   simple_mtx_unlock(&feedback->signal_mutex);
+   if (!retire)
+      return true;
+
+   mtl_command_queue *replacement = mtl_new_command_queue(dev->mtl_handle);
+   if (!replacement)
+      return false;
+   mtl_command_queue_add_residency_set(replacement, dev->residency_set.handle);
+
+   /* The retired queue answered for everything it was given, so anything it
+    * still owes it destroyed. Make those signals good before its records are
+    * dropped with it, or a waiter would block on a queue that no longer
+    * exists. */
+   kk_queue_signals_make_good(feedback, UINT64_MAX);
+
+   mtl_command_queue *retired = queue->mtl_handle;
+   queue->mtl_handle = replacement;
+
+   simple_mtx_lock(&feedback->signal_mutex);
+   mtl_command_queue *retired_service = feedback->queue;
+   feedback->queue = mtl_retain(replacement);
+   feedback->poisoned = false;
+   /* The replacement owes nothing, so the recovery rules go back to sleep. */
+   feedback->failures = 0u;
+   simple_mtx_unlock(&feedback->signal_mutex);
+
+   mtl_release(retired_service);
+   mtl_command_queue_remove_residency_set(retired, dev->residency_set.handle);
+   mtl_release(retired);
+
+   /* A queue is only ever retired because Metal failed one of its
+    * submissions, which it has already reported, so this line says what
+    * happened to the queue rather than announcing a new problem. */
+   fprintf(stderr,
+           "KosmicKrisp retired the Metal command queue a failure had left "
+           "rejecting every submission, and committed to a new one\n");
+   return true;
+}
+
 static struct kk_queue_submission *
 kk_queue_submission_new(struct kk_queue_feedback *feedback, uint64_t serial)
 {
@@ -205,24 +268,37 @@ commit_callback(struct mtl_feedback_data *data)
    struct kk_queue_submission *submission = data->user_data;
    struct kk_queue_feedback *feedback = submission->feedback;
 
+   char report[KK_QUEUE_ERROR_REPORT_SIZE];
+   const bool failed = data->error != MTL_COMMAND_QUEUE_ERROR_NONE;
+   /* A lost queue owes every signal it still holds, because it runs nothing
+    * further. A survivable failure owes only the signals ordered behind the
+    * submission it names. */
+   const bool lost = failed && kk_queue_error_is_device_lost(data);
+
+   if (failed)
+      kk_queue_error_describe(report, sizeof(report), data);
+
    /* A serial is reserved immediately before its commit, so a submission the
-    * queue is still holding always keeps this below last_serial. */
+    * queue is still holding always keeps this below last_serial.
+    *
+    * Publish the report together with the failure it carries. Retirement reads
+    * both under this lock and acts once the queue is poisoned and has answered
+    * for everything it was given, so a report published ahead of its own
+    * failure lets a failing queue look drained and healthy: it is replaced,
+    * the replacement's state is cleared, and the failure then lands on the
+    * queue that replaced it.
+    */
    simple_mtx_lock(&feedback->signal_mutex);
    ++feedback->reported;
+   if (failed) {
+      ++feedback->failures;
+      /* Survived or not, this queue runs nothing more that can be trusted. */
+      feedback->poisoned = true;
+   }
    simple_mtx_unlock(&feedback->signal_mutex);
 
-   if (data->error != MTL_COMMAND_QUEUE_ERROR_NONE) {
-      char report[KK_QUEUE_ERROR_REPORT_SIZE];
-      kk_queue_error_describe(report, sizeof(report), data);
+   if (failed) {
       fprintf(stderr, "KosmicKrisp %s\n", report);
-
-      /* A lost queue owes every signal it still holds, because it runs
-       * nothing further. A survivable failure owes only the signals ordered
-       * behind the submission it names. */
-      bool lost = kk_queue_error_is_device_lost(data);
-      simple_mtx_lock(&feedback->signal_mutex);
-      ++feedback->failures;
-      simple_mtx_unlock(&feedback->signal_mutex);
       unsigned made_good = kk_queue_signals_make_good(
          feedback, lost ? UINT64_MAX : submission->serial);
       if (made_good)
@@ -355,6 +431,13 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
    if (vk_queue_is_lost(&queue->vk))
       return VK_ERROR_DEVICE_LOST;
 
+   /* A queue Metal has already failed accepts work and runs none of it, so it
+    * is replaced before anything is enqueued on it. */
+   if (!kk_queue_replace_retired(queue))
+      return vk_queue_set_lost(&queue->vk,
+                               "Failed to replace the Metal command queue a "
+                               "failure retired");
+
    for (struct vk_sync_wait *wait = submit->waits,
                             *end = submit->waits + submit->wait_count;
         wait != end; ++wait) {
diff --git a/src/kosmickrisp/vulkan/kk_queue.h b/src/kosmickrisp/vulkan/kk_queue.h
index da5cfbc1..573787d4 100644
--- a/src/kosmickrisp/vulkan/kk_queue.h
+++ b/src/kosmickrisp/vulkan/kk_queue.h
@@ -48,6 +48,10 @@ struct kk_queue_feedback {
     * has never failed owes nothing it has not delivered, so the recovery
     * below stays out of the way until one does. */
    uint32_t failures;
+   /* Metal rejects every submission a command queue receives after that queue
+    * has killed one, so a survived failure retires the native queue. Set by
+    * the report, acted on by the submit thread. */
+   bool poisoned;
 };
 
