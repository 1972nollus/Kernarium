diff --git a/src/gallium/drivers/zink/zink_program.c b/src/gallium/drivers/zink/zink_program.c
index ecfab4f8f7c231e5b02c33c59717b8b25d799b94..591c5039acbd151ecf1153aed8fa9e6cf220c3d4 100644
