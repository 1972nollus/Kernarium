@@ -1850,10 +1856,99 @@ deinit_program(struct zink_screen *screen, struct zink_program *pg)
    zink_descriptor_program_deinit(screen, pg);
 }
 
+/* Frees everything only a bound program could use, and leaves what
+ * gfx_shader_prune() and zink_destroy_gfx_program() still read. */
+static void
+release_gfx_program_state(struct zink_screen *screen,
+                          struct zink_gfx_program *prog)
+{
+   util_queue_fence_wait(&prog->base.cache_fence);
+   for (int i = 0; i < ARRAY_SIZE(prog->pipelines); ++i) {
+      hash_table_foreach(&prog->pipelines[i], entry) {
+         struct zink_gfx_pipeline_cache_entry *pc_entry = entry->data;
+
+         util_queue_fence_wait(&pc_entry->fence);
+         VKSCR(DestroyPipeline)(screen->dev, pc_entry->pipeline, NULL);
+         VKSCR(DestroyPipeline)(screen->dev, pc_entry->gpl.unoptimized_pipeline, NULL);
+         free(pc_entry);
+      }
+      _mesa_hash_table_clear(&prog->pipelines[i], NULL);
+   }
+   memset(prog->last_finalized_hash, 0, sizeof(prog->last_finalized_hash));
+   memset(prog->last_pipeline, 0, sizeof(prog->last_pipeline));
+   if (prog->base.pipeline_cache) {
+      VKSCR(DestroyPipelineCache)(screen->dev, prog->base.pipeline_cache, NULL);
+      prog->base.pipeline_cache = VK_NULL_HANDLE;
+   }
+   if (!prog->is_separable) {
+      for (int i = 0; i < MESA_SHADER_MESH_STAGES; ++i) {
+         destroy_shader_cache(screen, &prog->shader_cache[i][0][0]);
+         destroy_shader_cache(screen, &prog->shader_cache[i][0][1]);
+         destroy_shader_cache(screen, &prog->shader_cache[i][1][0]);
+         destroy_shader_cache(screen, &prog->shader_cache[i][1][1]);
+         blob_finish(&prog->blobs[i]);
+         blob_init(&prog->blobs[i]);
+      }
+   }
+   /* the libraries of a shader set only this program still names */
+   if (prog->libs) {
+      zink_gfx_lib_cache_unref(screen, prog->libs);
+      prog->libs = NULL;
+   }
+}
+
+/* A gfx program is reachable only through the context that created it, but
+ * its shaders keep it alive, and the screen's live shader cache shares a
+ * shader with every context that compiles the same source.  So when a context
+ * is destroyed, each of its programs that has a shader another live context
+ * still uses would keep every pipeline it built, and all the driver state
+ * behind them, for as long as that shader lives, although nothing can bind
+ * the program again.  A host that serves many short-lived clients through one
+ * screen, as virglrenderer does, then grows with every client it ever served.
+ * Free its pipelines, shader variants and libraries now; the program itself
+ * still goes with its last shader.
+ */
+void
+zink_context_release_programs(struct zink_context *ctx)
+{
+   struct zink_screen *screen = zink_screen(ctx->base.screen);
+   struct util_dynarray held;
+   util_dynarray_init(&held, NULL);
+
+   simple_mtx_lock(&screen->program_owner_lock);
+   list_for_each_entry_safe(struct zink_program, pg, &ctx->gfx_programs, ctx_link) {
+      list_del(&pg->ctx_link);
+      pg->orphaned = true;
+      /* a program whose last reference is gone is already being destroyed */
+      int32_t count = p_atomic_read(&pg->reference.count);
+      while (count > 0) {
+         int32_t seen = p_atomic_cmpxchg(&pg->reference.count, count, count + 1);
+         if (seen == count)
+            break;
+         count = seen;
+      }
+      if (count > 0)
+         util_dynarray_append(&held, (struct zink_gfx_program *)pg);
+   }
+   simple_mtx_unlock(&screen->program_owner_lock);
+
+   util_dynarray_foreach(&held, struct zink_gfx_program *, entry) {
+      struct zink_gfx_program *prog = *entry;
+      release_gfx_program_state(screen, prog);
+      zink_gfx_program_reference(screen, &prog, NULL);
+   }
+   util_dynarray_fini(&held);
+}
+
 void
 zink_destroy_gfx_program(struct zink_screen *screen,
                          struct zink_gfx_program *prog)
 {
+   simple_mtx_lock(&screen->program_owner_lock);
+   if (!prog->base.orphaned)
+      list_del(&prog->base.ctx_link);
+   simple_mtx_unlock(&screen->program_owner_lock);
+
    if (prog->is_separable)
       zink_gfx_program_reference(screen, &prog->full_prog, NULL);
    for (int i = 0; i < ARRAY_SIZE(prog->pipelines); ++i) {
