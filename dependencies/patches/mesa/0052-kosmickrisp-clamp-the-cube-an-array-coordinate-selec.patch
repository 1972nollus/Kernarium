diff --git a/src/kosmickrisp/vulkan/tests/test_non_seamless_cube_lowering.c b/src/kosmickrisp/vulkan/tests/test_non_seamless_cube_lowering.c
new file mode 100644
index 00000000..e082731d
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_non_seamless_cube_lowering.c
@@ -0,0 +1,267 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Metal samples cube maps seamlessly, so a VK_EXT_non_seamless_cube_map
+ * sampler is served by sampling the same storage through a 2D array alias of
+ * the constituent faces.  Vulkan rounds a cube array coordinate to the nearest
+ * even integer and clamps it against the cube count *before* the six faces are
+ * indexed, so the lowering has to clamp there too: scaling an out of range
+ * coordinate by six first and leaving the product for the 2D array alias to
+ * clamp lands the sample on the last face of the last cube instead of on the
+ * selected face of it.
+ */
+
+#include "kosmickrisp/vulkan/kk_descriptor_set_layout.h"
+#include "kosmickrisp/vulkan/kk_descriptor_types.h"
+#include "kosmickrisp/vulkan/kk_shader.h"
+#include "vulkan/runtime/vk_pipeline.h"
+
+#include "compiler/glsl_types.h"
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(condition)                                                      \
+   do {                                                                       \
+      if (!(condition)) {                                                      \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,      \
+                 #condition);                                                  \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+struct lowering_stats {
+   /* Samples rewritten onto the 2D array alias of the cube faces. */
+   unsigned lowered_samples;
+   /* Samples left on the native cube path. */
+   unsigned cube_samples;
+   /* Coordinates scaled by the six faces of a cube. */
+   unsigned face_scales;
+   /* ... of those, the ones that clamp the rounded coordinate first. */
+   unsigned clamped_face_scales;
+   /* ... and the ones that scale a bare rounded coordinate, the defect. */
+   unsigned unclamped_face_scales;
+   /* Size queries against the 2D array alias. */
+   unsigned array_size_queries;
+};
+
+static nir_alu_instr *
+alu_source(nir_def *def, nir_op op)
+{
+   nir_instr *parent = nir_def_instr(def);
+   if (parent->type != nir_instr_type_alu)
+      return NULL;
+
+   nir_alu_instr *alu = nir_instr_as_alu(parent);
+   return alu->op == op ? alu : NULL;
+}
+
+static bool
+is_float_immediate(nir_def *def, double value)
+{
+   if (!nir_src_is_const(nir_src_for_ssa(def)))
+      return false;
+
+   return nir_src_as_float(nir_src_for_ssa(def)) == value;
+}
+
+/* fclamp() is fmin(fmax(x, lo), hi), and the rounded coordinate has to sit
+ * underneath both of them. */
+static bool
+scales_a_clamped_coordinate(nir_def *scaled)
+{
+   nir_alu_instr *min = alu_source(scaled, nir_op_fmin);
+   if (min == NULL)
+      return false;
+
+   nir_alu_instr *max = alu_source(min->src[0].src.ssa, nir_op_fmax);
+   if (max == NULL)
+      return false;
+
+   return alu_source(max->src[0].src.ssa, nir_op_fround_even) != NULL;
+}
+
+static void
+collect_stats(nir_shader *shader, struct lowering_stats *stats)
+{
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_tex) {
+               nir_tex_instr *tex = nir_instr_as_tex(instr);
+
+               if (tex->op == nir_texop_txs) {
+                  if (tex->sampler_dim == GLSL_SAMPLER_DIM_2D && tex->is_array)
+                     stats->array_size_queries++;
+                  continue;
+               }
+
+               if (tex->sampler_dim == GLSL_SAMPLER_DIM_CUBE)
+                  stats->cube_samples++;
+               else if (tex->sampler_dim == GLSL_SAMPLER_DIM_2D &&
+                        tex->is_array)
+                  stats->lowered_samples++;
+               continue;
+            }
+
+            if (instr->type != nir_instr_type_alu)
+               continue;
+
+            nir_alu_instr *alu = nir_instr_as_alu(instr);
+            if (alu->op != nir_op_fmul)
+               continue;
+
+            for (unsigned i = 0; i < 2; i++) {
+               if (!is_float_immediate(alu->src[i].src.ssa, 6.0))
+                  continue;
+
+               nir_def *scaled = alu->src[1 - i].src.ssa;
+               stats->face_scales++;
+               if (scales_a_clamped_coordinate(scaled))
+                  stats->clamped_face_scales++;
+               else if (alu_source(scaled, nir_op_fround_even) != NULL)
+                  stats->unclamped_face_scales++;
+               break;
+            }
+         }
+      }
+   }
+}
+
+static nir_shader *
+build_cube_sample(bool is_array, bool is_shadow)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_FRAGMENT, &kk_nir_options, "non-seamless cube lowering test");
+
+   const struct glsl_type *sampler_type =
+      glsl_sampler_type(GLSL_SAMPLER_DIM_CUBE, is_shadow, is_array,
+                        GLSL_TYPE_FLOAT);
+   nir_variable *variable =
+      nir_variable_create(b.shader, nir_var_uniform, sampler_type, "sampler");
+   variable->data.descriptor_set = 0;
+   variable->data.binding = 0;
+
+   nir_deref_instr *deref = nir_build_deref_var(&b, variable);
+   nir_def *frag = nir_load_frag_coord(&b);
+   const unsigned components = is_array ? 4 : 3;
+   nir_def *coord = nir_trim_vector(&b, frag, components);
+
+   nir_tex_instr *tex = nir_tex_instr_create(b.shader, is_shadow ? 4 : 3);
+   tex->op = nir_texop_tex;
+   tex->sampler_dim = GLSL_SAMPLER_DIM_CUBE;
+   tex->is_array = is_array;
+   tex->is_shadow = is_shadow;
+   tex->dest_type = nir_type_float32;
+   tex->coord_components = components;
+   tex->src[0] = nir_tex_src_for_ssa(nir_tex_src_coord, coord);
+   tex->src[1] = nir_tex_src_for_ssa(nir_tex_src_texture_deref, &deref->def);
+   tex->src[2] = nir_tex_src_for_ssa(nir_tex_src_sampler_deref, &deref->def);
+   if (is_shadow) {
+      tex->src[3] =
+         nir_tex_src_for_ssa(nir_tex_src_comparator, nir_imm_float(&b, 0.5f));
+   }
+   nir_def_init(&tex->instr, &tex->def, 4, 32);
+   nir_builder_instr_insert(&b, &tex->instr);
+
+   nir_variable *color = nir_variable_create(b.shader, nir_var_shader_out,
+                                             glsl_vec4_type(), "color");
+   color->data.location = FRAG_RESULT_DATA0;
+   nir_store_var(&b, color, &tex->def, 0xf);
+
+   return b.shader;
+}
+
+/* The descriptor lowering has to run first: it is what recognises the sampler
+ * as possibly non-seamless and attaches the 2D array alias. */
+static void
+lower(nir_shader *shader)
+{
+   struct kk_descriptor_set_layout *layout =
+      calloc(1, sizeof(*layout) + sizeof(layout->binding[0]));
+   CHECK(layout != NULL);
+   layout->binding_count = 1;
+   layout->binding[0] = (struct kk_descriptor_set_binding_layout){
+      .type = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+      .array_size = 1,
+      .stride = sizeof(struct kk_sampled_image_descriptor),
+   };
+   struct vk_descriptor_set_layout *set_layouts[] = {&layout->vk};
+   const struct vk_pipeline_robustness_state robustness = {
+      .uniform_buffers = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED,
+      .storage_buffers = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED,
+      .images = VK_PIPELINE_ROBUSTNESS_IMAGE_BEHAVIOR_DISABLED,
+   };
+
+   CHECK(kk_nir_lower_descriptors(shader, &robustness, 1, set_layouts, true));
+   nir_validate_shader(shader, "non-seamless cube descriptor lowering");
+   CHECK(kk_nir_lower_textures(shader));
+   nir_validate_shader(shader, "non-seamless cube texture lowering");
+   free(layout);
+}
+
+static void
+check_cube_array_clamps_the_cube(bool is_shadow)
+{
+   nir_shader *shader = build_cube_sample(true, is_shadow);
+   lower(shader);
+
+   struct lowering_stats stats = {0};
+   collect_stats(shader, &stats);
+
+   /* A sampler that is only known at draw time keeps both paths: the native
+    * cube sample and the lowered one against the face alias. */
+   CHECK(stats.lowered_samples == 1);
+   CHECK(stats.cube_samples == 1);
+
+   /* The cube the coordinate selects is rounded, clamped and only then scaled
+    * by the six faces.  A bare rounded coordinate reaching the scale is the
+    * defect this test pins. */
+   CHECK(stats.face_scales == 1);
+   CHECK(stats.clamped_face_scales == 1);
+   CHECK(stats.unclamped_face_scales == 0);
+
+   /* The clamp needs the cube count, which only the alias can report. */
+   CHECK(stats.array_size_queries >= 1);
+
+   ralloc_free(shader);
+   printf("non-seamless cube lowering PASS cube-array%s\n",
+          is_shadow ? "-shadow" : "");
+}
+
+static void
+check_cube_needs_no_layer(void)
+{
+   nir_shader *shader = build_cube_sample(false, false);
+   lower(shader);
+
+   struct lowering_stats stats = {0};
+   collect_stats(shader, &stats);
+
+   CHECK(stats.lowered_samples == 1);
+   CHECK(stats.cube_samples == 1);
+   /* A plain cube has exactly one cube, so nothing is scaled by its faces. */
+   CHECK(stats.face_scales == 0);
+
+   ralloc_free(shader);
+   printf("non-seamless cube lowering PASS cube\n");
+}
+
+int
+main(void)
+{
+   glsl_type_singleton_init_or_ref();
+
+   check_cube_array_clamps_the_cube(false);
+   check_cube_array_clamps_the_cube(true);
+   check_cube_needs_no_layer();
+
+   glsl_type_singleton_decref();
+   printf("non-seamless cube lowering PASS\n");
+   return 0;
+}
