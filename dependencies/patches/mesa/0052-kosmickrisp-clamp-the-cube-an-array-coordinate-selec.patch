 .../vulkan/kk_nir_lower_textures.c            |  83 ++++--
 src/kosmickrisp/vulkan/meson.build            |  22 ++
 .../tests/test_non_seamless_cube_lowering.c   | 267 ++++++++++++++++++
 3 files changed, 350 insertions(+), 22 deletions(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_non_seamless_cube_lowering.c

diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_textures.c b/src/kosmickrisp/vulkan/kk_nir_lower_textures.c
index 5ecfc974..b492059e 100644
--- a/src/kosmickrisp/vulkan/kk_nir_lower_textures.c
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_textures.c
@@ -27,6 +27,51 @@ struct cube_coord {
    nir_def *cube_layer_base;
 };
 
+/* Width, height and layer count of the same-format 2D array alias. */
+static nir_def *
+array_texture_size(nir_builder *b, nir_def *array_handle)
+{
+   nir_tex_instr *txs = nir_tex_instr_create(b->shader, 2);
+   txs->op = nir_texop_txs;
+   txs->sampler_dim = GLSL_SAMPLER_DIM_2D;
+   txs->is_array = true;
+   txs->dest_type = nir_type_int32;
+   txs->src[0] =
+      nir_tex_src_for_ssa(nir_tex_src_texture_handle, array_handle);
+   txs->src[1] =
+      nir_tex_src_for_ssa(nir_tex_src_lod, nir_imm_int(b, 0));
+   nir_def_init(&txs->instr, &txs->def, 3, 32);
+   nir_builder_instr_insert(b, &txs->instr);
+   return &txs->def;
+}
+
+static nir_def *
+array_texture_width(nir_builder *b, nir_def *array_handle)
+{
+   return nir_channel(b, array_texture_size(b, array_handle), 0);
+}
+
+/* First face of the cube an array coordinate selects.  Vulkan rounds the
+ * coordinate to the nearest even integer and clamps it against the cube count
+ * before the six faces are indexed, so the clamp has to happen here.  Scaling
+ * first and leaving the product to the 2D array alias to clamp instead lands
+ * an out of range coordinate on the last face of the last cube rather than on
+ * the selected face of the last cube. */
+static nir_def *
+cube_array_layer_base(nir_builder *b, nir_def *layer, nir_def *array_handle)
+{
+   nir_def *layer_count =
+      nir_channel(b, array_texture_size(b, array_handle), 2);
+   nir_def *max_cube =
+      nir_i2fN(b, nir_iadd_imm(b, nir_udiv_imm(b, layer_count, 6), -1),
+               layer->bit_size);
+   nir_def *cube =
+      nir_fclamp(b, nir_fround_even(b, layer),
+                 nir_imm_floatN_t(b, 0.0, layer->bit_size), max_cube);
+
+   return nir_fmul_imm(b, cube, 6.0);
+}
+
 static nir_def *
 cube_face_x(nir_builder *b, const struct cube_coord *coord)
 {
@@ -77,7 +122,8 @@ cube_face_z(nir_builder *b, const struct cube_coord *coord)
 }
 
 static nir_def *
-cube_to_array_coord(nir_builder *b, nir_def *coord, bool is_array)
+cube_to_array_coord(nir_builder *b, nir_def *coord, bool is_array,
+                    nir_def *array_handle)
 {
    struct cube_coord cube = {
       .x = nir_channel(b, coord, 0),
@@ -90,8 +136,8 @@ cube_to_array_coord(nir_builder *b, nir_def *coord, bool is_array)
    cube.abs_z = nir_fabs(b, cube.z);
 
    if (is_array) {
-      cube.cube_layer_base = nir_fmul_imm(
-         b, nir_fround_even(b, nir_channel(b, coord, 3)), 6.0);
+      cube.cube_layer_base =
+         cube_array_layer_base(b, nir_channel(b, coord, 3), array_handle);
    }
 
    nir_def *face_x = cube_face_x(b, &cube);
@@ -108,23 +154,6 @@ cube_to_array_coord(nir_builder *b, nir_def *coord, bool is_array)
                     nir_bcsel(b, use_y, face_y, face_z));
 }
 
-static nir_def *
-array_texture_width(nir_builder *b, nir_def *array_handle)
-{
-   nir_tex_instr *txs = nir_tex_instr_create(b->shader, 2);
-   txs->op = nir_texop_txs;
-   txs->sampler_dim = GLSL_SAMPLER_DIM_2D;
-   txs->is_array = true;
-   txs->dest_type = nir_type_int32;
-   txs->src[0] =
-      nir_tex_src_for_ssa(nir_tex_src_texture_handle, array_handle);
-   txs->src[1] =
-      nir_tex_src_for_ssa(nir_tex_src_lod, nir_imm_int(b, 0));
-   nir_def_init(&txs->instr, &txs->def, 3, 32);
-   nir_builder_instr_insert(b, &txs->instr);
-   return nir_channel(b, &txs->def, 0);
-}
-
 /* Derive the implicit cube LOD before selecting a face.  Derivatives of the
  * selected 2D coordinates are discontinuous across a quad that straddles a
  * face boundary, which can otherwise select a spuriously coarse mip. */
@@ -210,8 +239,18 @@ clone_non_seamless_sample(nir_builder *b, const nir_tex_instr *tex,
    int coord_src = nir_tex_instr_src_index(tex, nir_tex_src_coord);
    assert(coord_src >= 0);
    nir_def *cube_coord = tex->src[coord_src].src.ssa;
-   nir_def *coord = cube_to_array_coord(
-      b, cube_coord, tex->is_array);
+   /* A statically lowered sample already carries the 2D array alias as its
+    * texture handle; a dynamic one keeps the cube handle and passes the alias
+    * alongside it. */
+   nir_def *handle = array_handle;
+   if (handle == NULL) {
+      int tex_handle_src =
+         nir_tex_instr_src_index(tex, nir_tex_src_texture_handle);
+      assert(tex_handle_src >= 0);
+      handle = tex->src[tex_handle_src].src.ssa;
+   }
+   nir_def *coord =
+      cube_to_array_coord(b, cube_coord, tex->is_array, handle);
 
    nir_tex_instr *clone = clone_cube_sample(b, tex);
    clone->sampler_dim = GLSL_SAMPLER_DIM_2D;
