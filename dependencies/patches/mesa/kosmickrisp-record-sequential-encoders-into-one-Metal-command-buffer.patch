+    * while the main one is open runs before everything in it. The main
+    * command buffer therefore ends whenever later work has to follow what it
+    * holds; see cs_end_main. */
+   struct {
+      mtl_command_buffer *cmd_buf;
+      /* The open render encoder follows other encoders in cmd_buf. */
+      bool render_follows_work;
+      /* The last render encoder needed compute before its pass. */
+      bool render_needed_pre;
+   } main;
+
    void *drawable;
    mtl_argument_table *argument_table;
 
@@ -434,6 +462,10 @@ void kk_cmd_buffer_set_vertex_amplification(struct kk_cmd_buffer *cmd,
                                             uint32_t count);
 mtl_compute_encoder *cs_get_compute(struct kk_cmd_buffer *cmd, bool pre_gfx);
 void cs_end(struct kk_cmd_buffer *cmd);
+void cs_flush(struct kk_cmd_buffer *cmd);
+/* Re-emits the graphics state of the draw being recorded into a render
+ * encoder that restarted after the draw flushed it. */
+void kk_flush_gfx_state(struct kk_cmd_buffer *cmd);
