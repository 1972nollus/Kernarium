diff --git a/src/kosmickrisp/vulkan/tests/test_command_buffer_consolidation.c b/src/kosmickrisp/vulkan/tests/test_command_buffer_consolidation.c
new file mode 100644
index 0000000000000000000000000000000000000000..0068732d8539535fee40f6adab9e5adbc12bca78
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_command_buffer_consolidation.c
@@ -0,0 +1,526 @@
+/* SPDX-License-Identifier: MIT */
+
+/* A recording that alternates transfers and render passes, as Zink's texture
+ * uploads between draws do, must not open a Metal command buffer per encoder:
+ * each command buffer's first render encoder costs megabytes of allocator
+ * storage until the submission completes, and a few hundred glyph uploads then
+ * exhaust an iOS app's memory limit.
+ *
+ * The first recording alternates a fill of the draw's vertex color with a
+ * render pass that adds that color, so every pass must see its own fill and
+ * the result of the passes before it. It must record into at most two Metal
+ * command buffers.
+ *
+ * The second recording writes a triangle fan's indices and then draws the fan
+ * in a cleared pass. Compute that must run before the pass unrolls the fan
+ * from those indices, but the index write already precedes the pass in the
+ * shared command buffer, so the pass is split there. The unroll must see the
+ * written indices, the clear must survive where the fan does not reach, and
+ * the fan must land.
+ */
+
+#define VK_NO_PROTOTYPES
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+#define CHECK(x)                                                               \
+   do {                                                                        \
+      if (!(x)) {                                                              \
+         fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x);               \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+#define LOAD_I(name)                                                           \
+   PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name);       \
+   CHECK(name)
+#define LOAD_D(name)                                                           \
+   PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name);           \
+   CHECK(name)
+
+static const uint32_t vertex_spirv[] =
+#include "command_buffer_shaders/color.vert.h"
+   ;
+static const uint32_t fragment_spirv[] =
+#include "command_buffer_shaders/color.frag.h"
+   ;
+
+#define EXTENT       64u
+#define PASSES       64u
+#define COLOR_STRIDE 16u
+
+static unsigned
+metal_command_buffers(VkCommandBuffer commands)
+{
+   struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(commands);
+   return util_dynarray_num_elements(&cmd->submit_cmd_bufs,
+                                     mtl_command_buffer *);
+}
+
+static uint32_t
+float_bits(float value)
+{
+   uint32_t bits;
+   memcpy(&bits, &value, sizeof(bits));
+   return bits;
+}
+
+int
+main(void)
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   VkInstanceCreateInfo ici = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+                               .pApplicationInfo = &app};
+   CHECK(vkCreateInstance(&ici, NULL, &instance) == VK_SUCCESS);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+
+   uint32_t count = 1;
+   VkPhysicalDevice physical;
+   CHECK(vkEnumeratePhysicalDevices(instance, &count, &physical) == VK_SUCCESS);
+   CHECK(count == 1);
+   uint32_t family_count = 0;
+   vkGetPhysicalDeviceQueueFamilyProperties(physical, &family_count, NULL);
+   VkQueueFamilyProperties *families = calloc(family_count, sizeof(*families));
+   CHECK(families);
+   vkGetPhysicalDeviceQueueFamilyProperties(physical, &family_count, families);
+   uint32_t family = 0;
+   while (family < family_count &&
+          !(families[family].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+      family++;
+   CHECK(family < family_count);
+   free(families);
+
+   float priority = 1;
+   VkDeviceQueueCreateInfo qci = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = family,
+      .queueCount = 1,
+      .pQueuePriorities = &priority};
+   VkPhysicalDeviceVulkan13Features features13 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
+      .dynamicRendering = VK_TRUE};
+   VkDeviceCreateInfo dci = {.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+                             .pNext = &features13,
+                             .queueCreateInfoCount = 1,
+                             .pQueueCreateInfos = &qci};
+   VkDevice device;
+   CHECK(vkCreateDevice(physical, &dci, NULL, &device) == VK_SUCCESS);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkGetDeviceQueue);
+   LOAD_D(vkCreateShaderModule);
+   LOAD_D(vkDestroyShaderModule);
+   LOAD_D(vkCreatePipelineLayout);
+   LOAD_D(vkDestroyPipelineLayout);
+   LOAD_D(vkCreateGraphicsPipelines);
+   LOAD_D(vkDestroyPipeline);
+   LOAD_D(vkCreateImage);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkGetImageMemoryRequirements);
+   LOAD_D(vkAllocateMemory);
+   LOAD_D(vkFreeMemory);
+   LOAD_D(vkBindImageMemory);
+   LOAD_D(vkCreateImageView);
+   LOAD_D(vkDestroyImageView);
+   LOAD_D(vkCreateBuffer);
+   LOAD_D(vkDestroyBuffer);
+   LOAD_D(vkGetBufferMemoryRequirements);
+   LOAD_D(vkBindBufferMemory);
+   LOAD_D(vkMapMemory);
+   LOAD_D(vkCreateCommandPool);
+   LOAD_D(vkDestroyCommandPool);
+   LOAD_D(vkAllocateCommandBuffers);
+   LOAD_D(vkBeginCommandBuffer);
+   LOAD_D(vkEndCommandBuffer);
+   LOAD_D(vkCmdBeginRendering);
+   LOAD_D(vkCmdEndRendering);
+   LOAD_D(vkCmdBindPipeline);
+   LOAD_D(vkCmdBindVertexBuffers);
+   LOAD_D(vkCmdBindIndexBuffer);
+   LOAD_D(vkCmdDraw);
+   LOAD_D(vkCmdDrawIndexed);
+   LOAD_D(vkCmdFillBuffer);
+   LOAD_D(vkCmdUpdateBuffer);
+   LOAD_D(vkCmdPipelineBarrier);
+   LOAD_D(vkCmdCopyImageToBuffer);
+   LOAD_D(vkQueueSubmit);
+   LOAD_D(vkQueueWaitIdle);
+
+   VkQueue queue;
+   vkGetDeviceQueue(device, family, 0, &queue);
+   VkPhysicalDeviceMemoryProperties memory_properties;
+   vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+
+#define FIND_MEMORY(bits, want)                                                \
+   ({                                                                          \
+      uint32_t found_ = UINT32_MAX;                                            \
+      for (uint32_t i_ = 0; i_ < memory_properties.memoryTypeCount; i_++) {   \
+         if (((bits) & (1u << i_)) &&                                          \
+             (memory_properties.memoryTypes[i_].propertyFlags & (want)) ==    \
+                (want)) {                                                      \
+            found_ = i_;                                                       \
+            break;                                                             \
+         }                                                                     \
+      }                                                                        \
+      CHECK(found_ != UINT32_MAX);                                             \
+      found_;                                                                  \
+   })
+
+   /* Render target. */
+   const VkFormat format = VK_FORMAT_R8G8B8A8_UNORM;
+   VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = format,
+      .extent = {EXTENT, EXTENT, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+               VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED};
+   VkImage image;
+   CHECK(vkCreateImage(device, &image_info, NULL, &image) == VK_SUCCESS);
+   VkMemoryRequirements image_requirements;
+   vkGetImageMemoryRequirements(device, image, &image_requirements);
+   VkMemoryAllocateInfo image_allocate = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = image_requirements.size,
+      .memoryTypeIndex = FIND_MEMORY(image_requirements.memoryTypeBits,
+                                     VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)};
+   VkDeviceMemory image_memory;
+   CHECK(vkAllocateMemory(device, &image_allocate, NULL, &image_memory) ==
+         VK_SUCCESS);
+   CHECK(vkBindImageMemory(device, image, image_memory, 0) == VK_SUCCESS);
+   VkImageViewCreateInfo view_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .image = image,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = format,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+   VkImageView view;
+   CHECK(vkCreateImageView(device, &view_info, NULL, &view) == VK_SUCCESS);
+
+   /* One host-visible buffer: per-pass vertex colors, vertex positions, fan
+    * indices, then the readback. */
+   const VkDeviceSize color_bytes = PASSES * COLOR_STRIDE;
+   const VkDeviceSize position_offset = color_bytes;
+   const VkDeviceSize position_bytes = 8 * 2 * sizeof(float);
+   const VkDeviceSize index_offset = position_offset + position_bytes;
+   const uint32_t fan_indices[4] = {0, 1, 2, 3};
+   const VkDeviceSize readback_offset = index_offset + sizeof(fan_indices);
+   const VkDeviceSize readback_bytes = EXTENT * EXTENT * 4;
+   VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = readback_offset + readback_bytes,
+      .usage = VK_BUFFER_USAGE_VERTEX_BUFFER_BIT |
+               VK_BUFFER_USAGE_INDEX_BUFFER_BIT |
+               VK_BUFFER_USAGE_TRANSFER_DST_BIT};
+   VkBuffer buffer;
+   CHECK(vkCreateBuffer(device, &buffer_info, NULL, &buffer) == VK_SUCCESS);
+   VkMemoryRequirements buffer_requirements;
+   vkGetBufferMemoryRequirements(device, buffer, &buffer_requirements);
+   VkMemoryAllocateInfo buffer_allocate = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = buffer_requirements.size,
+      .memoryTypeIndex = FIND_MEMORY(buffer_requirements.memoryTypeBits,
+                                     VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                        VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)};
+   VkDeviceMemory buffer_memory;
+   CHECK(vkAllocateMemory(device, &buffer_allocate, NULL, &buffer_memory) ==
+         VK_SUCCESS);
+   CHECK(vkBindBufferMemory(device, buffer, buffer_memory, 0) == VK_SUCCESS);
+   uint8_t *mapped;
+   CHECK(vkMapMemory(device, buffer_memory, 0, VK_WHOLE_SIZE, 0,
+                     (void **)&mapped) == VK_SUCCESS);
+   memset(mapped, 0, (size_t)buffer_info.size);
+   /* A triangle covering the target, then a fan over its left half. */
+   const float positions[8][2] = {
+      {-1, -1}, {3, -1}, {-1, 3}, {0, 0},
+      {-1, -1}, {0, -1}, {0, 1},  {-1, 1},
+   };
+   memcpy(mapped + position_offset, positions, sizeof(positions));
+
+   /* Pipelines: an additive triangle list and a replacing triangle fan. */
+   VkShaderModuleCreateInfo module_info = {
+      .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+      .codeSize = sizeof(vertex_spirv),
+      .pCode = vertex_spirv};
+   VkShaderModule vertex_module, fragment_module;
+   CHECK(vkCreateShaderModule(device, &module_info, NULL, &vertex_module) ==
+         VK_SUCCESS);
+   module_info.codeSize = sizeof(fragment_spirv);
+   module_info.pCode = fragment_spirv;
+   CHECK(vkCreateShaderModule(device, &module_info, NULL, &fragment_module) ==
+         VK_SUCCESS);
+   VkPipelineLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+   VkPipelineLayout layout;
+   CHECK(vkCreatePipelineLayout(device, &layout_info, NULL, &layout) ==
+         VK_SUCCESS);
+
+   VkPipelineShaderStageCreateInfo stages[2] = {
+      {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+       .stage = VK_SHADER_STAGE_VERTEX_BIT,
+       .module = vertex_module,
+       .pName = "main"},
+      {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+       .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+       .module = fragment_module,
+       .pName = "main"},
+   };
+   VkVertexInputBindingDescription bindings[2] = {
+      {0, COLOR_STRIDE, VK_VERTEX_INPUT_RATE_INSTANCE},
+      {1, 2 * sizeof(float), VK_VERTEX_INPUT_RATE_VERTEX},
+   };
+   VkVertexInputAttributeDescription attributes[2] = {
+      {0, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 0},
+      {1, 1, VK_FORMAT_R32G32_SFLOAT, 0},
+   };
+   VkPipelineVertexInputStateCreateInfo vertex_input = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO,
+      .vertexBindingDescriptionCount = 2,
+      .pVertexBindingDescriptions = bindings,
+      .vertexAttributeDescriptionCount = 2,
+      .pVertexAttributeDescriptions = attributes};
+   VkPipelineInputAssemblyStateCreateInfo assembly = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+      .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST};
+   VkViewport viewport = {0, 0, EXTENT, EXTENT, 0, 1};
+   VkRect2D scissor = {{0, 0}, {EXTENT, EXTENT}};
+   VkPipelineViewportStateCreateInfo viewport_state = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+      .viewportCount = 1,
+      .pViewports = &viewport,
+      .scissorCount = 1,
+      .pScissors = &scissor};
+   VkPipelineRasterizationStateCreateInfo raster = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+      .polygonMode = VK_POLYGON_MODE_FILL,
+      .cullMode = VK_CULL_MODE_NONE,
+      .frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE,
+      .lineWidth = 1};
+   VkPipelineMultisampleStateCreateInfo multisample = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+      .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT};
+   VkPipelineColorBlendAttachmentState blend_attachment = {
+      .blendEnable = VK_TRUE,
+      .srcColorBlendFactor = VK_BLEND_FACTOR_ONE,
+      .dstColorBlendFactor = VK_BLEND_FACTOR_ONE,
+      .colorBlendOp = VK_BLEND_OP_ADD,
+      .srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE,
+      .dstAlphaBlendFactor = VK_BLEND_FACTOR_ONE,
+      .alphaBlendOp = VK_BLEND_OP_ADD,
+      .colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+                        VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT};
+   VkPipelineColorBlendStateCreateInfo blend = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+      .attachmentCount = 1,
+      .pAttachments = &blend_attachment};
+   VkPipelineRenderingCreateInfo rendering_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+      .colorAttachmentCount = 1,
+      .pColorAttachmentFormats = &format};
+   VkGraphicsPipelineCreateInfo pipeline_info = {
+      .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+      .pNext = &rendering_info,
+      .stageCount = 2,
+      .pStages = stages,
+      .pVertexInputState = &vertex_input,
+      .pInputAssemblyState = &assembly,
+      .pViewportState = &viewport_state,
+      .pRasterizationState = &raster,
+      .pMultisampleState = &multisample,
+      .pColorBlendState = &blend,
+      .layout = layout};
+   VkPipeline additive, fan;
+   CHECK(vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                   NULL, &additive) == VK_SUCCESS);
+   assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN;
+   blend_attachment.blendEnable = VK_FALSE;
+   CHECK(vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                   NULL, &fan) == VK_SUCCESS);
+
+   VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = family};
+   VkCommandPool pool;
+   CHECK(vkCreateCommandPool(device, &pool_info, NULL, &pool) == VK_SUCCESS);
+   VkCommandBufferAllocateInfo command_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 2};
+   VkCommandBuffer commands[2];
+   CHECK(vkAllocateCommandBuffers(device, &command_info, commands) ==
+         VK_SUCCESS);
+   VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT};
+
+   VkMemoryBarrier fill_to_vertex = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT |
+                       VK_ACCESS_INDEX_READ_BIT};
+   VkImageMemoryBarrier to_transfer = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+      .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = image,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+   VkBufferImageCopy copy = {
+      .bufferOffset = readback_offset,
+      .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+      .imageExtent = {EXTENT, EXTENT, 1}};
+   VkRenderingAttachmentInfo color_attachment = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+      .imageView = view,
+      .imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+      .storeOp = VK_ATTACHMENT_STORE_OP_STORE};
+   VkRenderingInfo rendering = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+      .renderArea = scissor,
+      .layerCount = 1,
+      .colorAttachmentCount = 1,
+      .pColorAttachments = &color_attachment};
+   VkBuffer vertex_buffers[2] = {buffer, buffer};
+
+   /* Alternate a fill of pass i's color with pass i adding it. */
+   CHECK(vkBeginCommandBuffer(commands[0], &begin) == VK_SUCCESS);
+   for (uint32_t pass = 0; pass < PASSES; pass++) {
+      vkCmdFillBuffer(commands[0], buffer, pass * COLOR_STRIDE, COLOR_STRIDE,
+                      float_bits(1.0f / 255.0f));
+      vkCmdPipelineBarrier(commands[0], VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_VERTEX_INPUT_BIT, 0, 1,
+                           &fill_to_vertex, 0, NULL, 0, NULL);
+      color_attachment.loadOp =
+         pass ? VK_ATTACHMENT_LOAD_OP_LOAD : VK_ATTACHMENT_LOAD_OP_CLEAR;
+      vkCmdBeginRendering(commands[0], &rendering);
+      vkCmdBindPipeline(commands[0], VK_PIPELINE_BIND_POINT_GRAPHICS, additive);
+      VkDeviceSize offsets[2] = {pass * COLOR_STRIDE, position_offset};
+      vkCmdBindVertexBuffers(commands[0], 0, 2, vertex_buffers, offsets);
+      vkCmdDraw(commands[0], 3, 1, 0, 0);
+      vkCmdEndRendering(commands[0]);
+   }
+   vkCmdPipelineBarrier(commands[0],
+                        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1,
+                        &to_transfer);
+   vkCmdCopyImageToBuffer(commands[0], image,
+                          VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buffer, 1,
+                          &copy);
+   CHECK(vkEndCommandBuffer(commands[0]) == VK_SUCCESS);
+   const unsigned alternating = metal_command_buffers(commands[0]);
+   printf("%u fills and render passes recorded into %u Metal command "
+          "buffers\n",
+          PASSES, alternating);
+   CHECK(alternating <= 2);
+
+   VkSubmitInfo submit = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+                          .commandBufferCount = 1,
+                          .pCommandBuffers = &commands[0]};
+   CHECK(vkQueueSubmit(queue, 1, &submit, VK_NULL_HANDLE) == VK_SUCCESS);
+   CHECK(vkQueueWaitIdle(queue) == VK_SUCCESS);
+   for (uint32_t texel = 0; texel < EXTENT * EXTENT; texel++) {
+      const uint8_t *rgba = mapped + readback_offset + texel * 4;
+      if (rgba[0] != PASSES || rgba[1] != PASSES || rgba[2] != PASSES ||
+          rgba[3] != PASSES) {
+         fprintf(stderr, "texel %u is %u %u %u %u, not %u from each pass\n",
+                 texel, rgba[0], rgba[1], rgba[2], rgba[3], PASSES);
+         abort();
+      }
+   }
+
+   /* Index and color writes, then a cleared pass whose fan needs compute
+    * before the pass. The indices are zero until the recording writes them. */
+   memset(mapped + readback_offset, 0, (size_t)readback_bytes);
+   CHECK(vkBeginCommandBuffer(commands[1], &begin) == VK_SUCCESS);
+   vkCmdUpdateBuffer(commands[1], buffer, index_offset, sizeof(fan_indices),
+                     fan_indices);
+   vkCmdFillBuffer(commands[1], buffer, 0, COLOR_STRIDE, float_bits(1.0f));
+   vkCmdPipelineBarrier(commands[1], VK_PIPELINE_STAGE_TRANSFER_BIT,
+                        VK_PIPELINE_STAGE_VERTEX_INPUT_BIT, 0, 1,
+                        &fill_to_vertex, 0, NULL, 0, NULL);
+   color_attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+   color_attachment.clearValue.color = (VkClearColorValue){{0, 0, 1, 1}};
+   to_transfer.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+   VkImageMemoryBarrier to_attachment = to_transfer;
+   to_attachment.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+   to_attachment.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+   to_attachment.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+   to_attachment.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+   vkCmdPipelineBarrier(commands[1], VK_PIPELINE_STAGE_TRANSFER_BIT,
+                        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0, 0,
+                        NULL, 0, NULL, 1, &to_attachment);
+   vkCmdBeginRendering(commands[1], &rendering);
+   vkCmdBindPipeline(commands[1], VK_PIPELINE_BIND_POINT_GRAPHICS, fan);
+   VkDeviceSize fan_offsets[2] = {0, position_offset + 4 * 2 * sizeof(float)};
+   vkCmdBindVertexBuffers(commands[1], 0, 2, vertex_buffers, fan_offsets);
+   vkCmdBindIndexBuffer(commands[1], buffer, index_offset,
+                        VK_INDEX_TYPE_UINT32);
+   vkCmdDrawIndexed(commands[1], 4, 1, 0, 0, 0);
+   vkCmdDrawIndexed(commands[1], 4, 1, 0, 0, 0);
+   vkCmdEndRendering(commands[1]);
+   to_transfer.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+   vkCmdPipelineBarrier(commands[1],
+                        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1,
+                        &to_transfer);
+   vkCmdCopyImageToBuffer(commands[1], image,
+                          VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buffer, 1,
+                          &copy);
+   CHECK(vkEndCommandBuffer(commands[1]) == VK_SUCCESS);
+   printf("an index write and a fan pass recorded into %u Metal command "
+          "buffers\n",
+          metal_command_buffers(commands[1]));
+
+   submit.pCommandBuffers = &commands[1];
+   CHECK(vkQueueSubmit(queue, 1, &submit, VK_NULL_HANDLE) == VK_SUCCESS);
+   CHECK(vkQueueWaitIdle(queue) == VK_SUCCESS);
+   for (uint32_t y = 0; y < EXTENT; y++) {
+      for (uint32_t x = 0; x < EXTENT; x++) {
+         const uint8_t *rgba = mapped + readback_offset + (y * EXTENT + x) * 4;
+         const uint8_t expected[4] = {x < EXTENT / 2 ? 255 : 0,
+                                      x < EXTENT / 2 ? 255 : 0, 255, 255};
+         if (memcmp(rgba, expected, 4)) {
+            fprintf(stderr, "texel %u,%u is %u %u %u %u, not %u %u %u %u\n", x,
+                    y, rgba[0], rgba[1], rgba[2], rgba[3], expected[0],
+                    expected[1], expected[2], expected[3]);
+            abort();
+         }
+      }
+   }
+
+   vkDestroyCommandPool(device, pool, NULL);
+   vkDestroyPipeline(device, fan, NULL);
+   vkDestroyPipeline(device, additive, NULL);
+   vkDestroyPipelineLayout(device, layout, NULL);
+   vkDestroyShaderModule(device, fragment_module, NULL);
+   vkDestroyShaderModule(device, vertex_module, NULL);
+   vkDestroyBuffer(device, buffer, NULL);
+   vkFreeMemory(device, buffer_memory, NULL);
+   vkDestroyImageView(device, view, NULL);
+   vkDestroyImage(device, image, NULL);
+   vkFreeMemory(device, image_memory, NULL);
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+   printf("command buffer consolidation ok\n");
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_query_pool_lifetime.c b/src/kosmickrisp/vulkan/tests/test_query_pool_lifetime.c
new file mode 100644
index 0000000000000000000000000000000000000000..a9bcbd944cc487f8f5fa32a8567119ff796fffd5
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_query_pool_lifetime.c
@@ -0,0 +1,224 @@
+/* SPDX-License-Identifier: MIT */
+
+/* A command buffer may still be recording when the application destroys a
+ * timestamp query pool it wrote to: the buffer becomes invalid, and resetting,
+ * beginning or freeing it is what is left to do with it.  The recording's
+ * open encoders still carry the pool's pending resolves, and closing them
+ * names the pool's counter heap and availability buffer.  Those must still be
+ * alive then.  Meson runs this with NSZombieEnabled, so a message to a
+ * released Metal object aborts instead of reading freed memory silently. */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan_core.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+int
+main(void)
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   CHECK(vkCreateInstance(&instance_info, NULL, &instance) == VK_SUCCESS);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   VkResult enumerated =
+      vkEnumeratePhysicalDevices(instance, &count, &physical);
+   CHECK((enumerated == VK_SUCCESS || enumerated == VK_INCOMPLETE) && count);
+   uint32_t family_count = 0;
+   vkGetPhysicalDeviceQueueFamilyProperties(physical, &family_count, NULL);
+   VkQueueFamilyProperties *families = calloc(family_count, sizeof(*families));
+   CHECK(families);
+   vkGetPhysicalDeviceQueueFamilyProperties(physical, &family_count, families);
+   uint32_t family = 0;
+   while (family < family_count &&
+          !(families[family].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+      family++;
+   CHECK(family < family_count);
+   CHECK(families[family].timestampValidBits > 0);
+   free(families);
+   float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = family,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   VkPhysicalDeviceVulkan13Features features13 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
+      .dynamicRendering = VK_TRUE,
+      .synchronization2 = VK_TRUE,
+   };
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &features13,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   CHECK(vkCreateDevice(physical, &device_info, NULL, &device) == VK_SUCCESS);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkCreateQueryPool);
+   LOAD_D(vkDestroyQueryPool);
+   LOAD_D(vkCreateCommandPool);
+   LOAD_D(vkDestroyCommandPool);
+   LOAD_D(vkAllocateCommandBuffers);
+   LOAD_D(vkFreeCommandBuffers);
+   LOAD_D(vkResetCommandBuffer);
+   LOAD_D(vkBeginCommandBuffer);
+   LOAD_D(vkEndCommandBuffer);
+   LOAD_D(vkCmdWriteTimestamp2);
+   LOAD_D(vkCmdBeginRendering);
+   LOAD_D(vkCmdEndRendering);
+   LOAD_D(vkCreateImage);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkGetImageMemoryRequirements);
+   LOAD_D(vkAllocateMemory);
+   LOAD_D(vkFreeMemory);
+   LOAD_D(vkBindImageMemory);
+   LOAD_D(vkCreateImageView);
+   LOAD_D(vkDestroyImageView);
+
+   /* A render pass, so a timestamp can also take the render-stage path. */
+   VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .extent = {8, 8, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,
+   };
+   VkImage image = VK_NULL_HANDLE;
+   CHECK(vkCreateImage(device, &image_info, NULL, &image) == VK_SUCCESS);
+   VkMemoryRequirements requirements;
+   vkGetImageMemoryRequirements(device, image, &requirements);
+   VkPhysicalDeviceMemoryProperties properties;
+   vkGetPhysicalDeviceMemoryProperties(physical, &properties);
+   uint32_t type = 0;
+   while (type < properties.memoryTypeCount &&
+          !(requirements.memoryTypeBits & (1u << type)))
+      type++;
+   CHECK(type < properties.memoryTypeCount);
+   VkMemoryAllocateInfo memory_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = requirements.size,
+      .memoryTypeIndex = type,
+   };
+   VkDeviceMemory memory = VK_NULL_HANDLE;
+   CHECK(vkAllocateMemory(device, &memory_info, NULL, &memory) == VK_SUCCESS);
+   CHECK(vkBindImageMemory(device, image, memory, 0) == VK_SUCCESS);
+   VkImageViewCreateInfo view_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .image = image,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = image_info.format,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+   };
+   VkImageView view = VK_NULL_HANDLE;
+   CHECK(vkCreateImageView(device, &view_info, NULL, &view) == VK_SUCCESS);
+   VkRenderingAttachmentInfo attachment = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+      .imageView = view,
+      .imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+      .loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR,
+      .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+   };
+   VkRenderingInfo rendering = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+      .renderArea = {{0, 0}, {8, 8}},
+      .layerCount = 1,
+      .colorAttachmentCount = 1,
+      .pColorAttachments = &attachment,
+   };
+
+   VkQueryPoolCreateInfo query_info = {
+      .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+      .queryType = VK_QUERY_TYPE_TIMESTAMP,
+      .queryCount = 4,
+   };
+   VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+      .queueFamilyIndex = family,
+   };
+   VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+   };
+
+   /* How the recording is thrown away after its query pool is gone: reset,
+    * begun again, freed, or freed with its command pool. */
+   for (unsigned way = 0; way < 4; way++) {
+      VkCommandPool pool = VK_NULL_HANDLE;
+      CHECK(vkCreateCommandPool(device, &pool_info, NULL, &pool) == VK_SUCCESS);
+      VkCommandBufferAllocateInfo allocate = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+         .commandPool = pool,
+         .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+         .commandBufferCount = 1,
+      };
+      VkCommandBuffer command = VK_NULL_HANDLE;
+      CHECK(vkAllocateCommandBuffers(device, &allocate, &command) ==
+            VK_SUCCESS);
+      VkQueryPool queries = VK_NULL_HANDLE;
+      CHECK(vkCreateQueryPool(device, &query_info, NULL, &queries) ==
+            VK_SUCCESS);
+
+      CHECK(vkBeginCommandBuffer(command, &begin) == VK_SUCCESS);
+      /* Outside a render pass: a compute-lane sample. */
+      vkCmdWriteTimestamp2(command, VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT,
+                           queries, 0);
+      /* Inside one: a render-stage sample and a bottom-of-pipe one. */
+      vkCmdBeginRendering(command, &rendering);
+      vkCmdWriteTimestamp2(command, VK_PIPELINE_STAGE_2_VERTEX_SHADER_BIT,
+                           queries, 1);
+      vkCmdWriteTimestamp2(command, VK_PIPELINE_STAGE_2_BOTTOM_OF_PIPE_BIT,
+                           queries, 2);
+      /* Left open: the recording is abandoned inside its render pass. */
+
+      vkDestroyQueryPool(device, queries, NULL);
+
+      switch (way) {
+      case 0:
+         CHECK(vkResetCommandBuffer(command, 0) == VK_SUCCESS);
+         break;
+      case 1:
+         CHECK(vkBeginCommandBuffer(command, &begin) == VK_SUCCESS);
+         CHECK(vkEndCommandBuffer(command) == VK_SUCCESS);
+         break;
+      case 2:
+         vkFreeCommandBuffers(device, pool, 1, &command);
+         break;
+      default:
+         break;
+      }
+      vkDestroyCommandPool(device, pool, NULL);
+   }
+
+   vkDestroyImageView(device, view, NULL);
+   vkDestroyImage(device, image, NULL);
+   vkFreeMemory(device, memory, NULL);
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+   printf("recordings outlive the timestamp query pools they wrote to\n");
+   return 0;
+}
