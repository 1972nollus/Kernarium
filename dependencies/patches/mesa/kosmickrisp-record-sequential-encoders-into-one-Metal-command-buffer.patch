-kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
+kk_draw_flushed(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
 {
-   if (unlikely(cmd->state.dynamic_vertex_input_pipeline != NULL)) {
-      VkResult result = kk_resolve_dynamic_vertex_input_pipeline(cmd);
-      if (result != VK_SUCCESS) {
-         vk_command_buffer_set_error(&cmd->vk, result);
-         return;
-      }
-   }
-
-   kk_cmd_select_line_raster_variant(cmd);
-   data->upload_mask = build_per_draw_upload_mask(cmd);
-   kk_flush_gfx_state(cmd);
-
    data->restart = cmd->vk.dynamic_graphics_state.ia.primitive_restart_enable;
    data->restart_index =
       cmd->vk.dynamic_graphics_state.ia.primitive_restart_index;
@@ -3960,6 +3948,26 @@ kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
    }
 }
 
+static void
+kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
+{
+   if (unlikely(cmd->state.dynamic_vertex_input_pipeline != NULL)) {
+      VkResult result = kk_resolve_dynamic_vertex_input_pipeline(cmd);
+      if (result != VK_SUCCESS) {
+         vk_command_buffer_set_error(&cmd->vk, result);
+         return;
+      }
+   }
+
+   kk_cmd_select_line_raster_variant(cmd);
+   data->upload_mask = build_per_draw_upload_mask(cmd);
+   kk_flush_gfx_state(cmd);
+
+   cmd->state.gfx.draw_state_flushed = true;
+   kk_draw_flushed(cmd, data);
+   cmd->state.gfx.draw_state_flushed = false;
+}
