+static void kk_stop_encoder(struct kk_cmd_buffer *cmd,
+                            struct kk_encoder_state *es);
+
+static mtl_command_buffer *
+cs_open_main(struct kk_cmd_buffer *cmd)
+{
+   if (!cmd->main.cmd_buf) {
+      struct kk_device *dev = kk_cmd_buffer_device(cmd);
+      cmd->main.cmd_buf = mtl_new_command_buffer(dev->mtl_handle);
+      mtl_begin_command_buffer(cmd->main.cmd_buf, cmd->gfx.allocator);
+   }
+   return cmd->main.cmd_buf;
+}
+
+/* Appends the main command buffer, so that command buffers appended from now
+ * on run after everything recorded into it. */
+static void
+cs_end_main(struct kk_cmd_buffer *cmd)
+{
+   assert(cmd->gfx.encoder == NULL);
+   assert(!cmd->pre_gfx->in_main && !cmd->post_gfx->in_main);
+   if (!cmd->main.cmd_buf)
+      return;
+
+   mtl_end_command_buffer(cmd->main.cmd_buf);
+   util_dynarray_append(&cmd->submit_cmd_bufs, cmd->main.cmd_buf);
+   cmd->main.cmd_buf = NULL;
+}
+
 void
 cs_start_render(struct kk_cmd_buffer *cmd)
 {
-   struct kk_device *dev = kk_cmd_buffer_device(cmd);
    struct kk_graphics_state *state = &cmd->state.gfx;
    uint32_t view_mask = state->render.view_mask;
    assert(state->render_pass_descriptor);
 
-   cmd->gfx.cmd_buf = mtl_new_command_buffer(dev->mtl_handle);
-   mtl_begin_command_buffer(cmd->gfx.cmd_buf, cmd->gfx.allocator);
+   /* The main command buffer holds one open encoder at a time. */
+   if (cmd->pre_gfx->encoder && cmd->pre_gfx->in_main)
+      kk_stop_encoder(cmd, cmd->pre_gfx);
+
+   /* A pass that needed compute before it will likely need it again after a
+    * restart. Begin it at the start of a main command buffer, where that
+    * compute can precede it without splitting the pass.
+    *
+    * KK_WORKAROUND_18: a render encoder that follows other encoders in its
+    * command buffer drops the primitives of a draw that selects another
+    * layer, just as a later draw in one encoder does. Every encoder of a
+    * layered or multiview pass therefore starts a command buffer. */
+   if (cmd->main.render_needed_pre || state->render.layer_count > 1u ||
+       state->render.view_mask != 0u)
+      cs_end_main(cmd);
+   cmd->main.render_needed_pre = false;
+
+   cmd->main.render_follows_work = cmd->main.cmd_buf != NULL;
+   cmd->gfx.cmd_buf = cs_open_main(cmd);
+   cmd->gfx.in_main = true;
    cmd->gfx.encoder = mtl_new_render_command_encoder_with_descriptor(
       cmd->gfx.cmd_buf, state->render_pass_descriptor);
 
@@ -405,38 +451,67 @@ cs_get_render(struct kk_cmd_buffer *cmd)
 }
 
 static void
-kk_start_compute_encoder(struct kk_encoder_state *es, mtl_device *handle,
-                         mtl_argument_table *argument_table)
+kk_start_compute_encoder(struct kk_cmd_buffer *cmd,
+                         struct kk_encoder_state *es, bool in_main)
 {
-   es->cmd_buf = mtl_new_command_buffer(handle);
-   mtl_begin_command_buffer(es->cmd_buf, es->allocator);
+   if (in_main) {
+      es->cmd_buf = cs_open_main(cmd);
+   } else {
+      struct kk_device *dev = kk_cmd_buffer_device(cmd);
+      es->cmd_buf = mtl_new_command_buffer(dev->mtl_handle);
+      mtl_begin_command_buffer(es->cmd_buf, es->allocator);
+   }
+   es->in_main = in_main;
    es->encoder = mtl_new_compute_command_encoder(es->cmd_buf);
 
    /* Argument table won't ever change */
-   mtl_compute_set_argument_table(es->encoder, argument_table);
+   mtl_compute_set_argument_table(es->encoder, cmd->argument_table);
+}
+
+/* Compute that must precede a render encoder that other work in the main
+ * command buffer precedes: close the pass there and resume it at the start of
+ * a new main command buffer, which that compute can then precede. The pass
+ * descriptor loads every attachment once the pass has begun. */
+static void
+cs_split_render(struct kk_cmd_buffer *cmd)
+{
+   kk_stop_encoder(cmd, &cmd->gfx);
+   cs_end_main(cmd);
+   cs_start_render(cmd);
+   /* A draw being recorded flushed its state into the closed encoder and
+    * needs it in this one. Outside a draw the state need not be complete
+    * yet, a dynamic vertex input for one, and starting the encoder has
+    * marked all of it dirty for the next draw to flush. */
+   if (cmd->state.gfx.draw_state_flushed)
+      kk_flush_gfx_state(cmd);
 }
 
 mtl_compute_encoder *
 cs_get_compute(struct kk_cmd_buffer *cmd, bool pre_gfx)
 {
-   struct kk_device *dev = kk_cmd_buffer_device(cmd);
-   mtl_compute_encoder *encoder;
-   /* If we are not inside a render, we can just take pre_gfx. */
-   if (!cmd->gfx.encoder || pre_gfx) {
+   /* Outside a render encoder, compute runs in recording order: in the open
+    * pre-render encoder, or in the main command buffer. */
+   if (!cmd->gfx.encoder) {
+      if (!cmd->pre_gfx->encoder)
+         kk_start_compute_encoder(cmd, cmd->pre_gfx, true);
+      return cmd->pre_gfx->encoder;
+   }
+
+   if (pre_gfx) {
       if (!cmd->pre_gfx->encoder) {
-         kk_start_compute_encoder(cmd->pre_gfx, dev->mtl_handle,
-                                  cmd->argument_table);
+         /* Its own command buffer runs before the whole main one, which is
+          * sound only while the render encoder is the main one's first. */
+         if (cmd->main.render_follows_work)
+            cs_split_render(cmd);
+         kk_start_compute_encoder(cmd, cmd->pre_gfx, false);
       }
-      encoder = cmd->pre_gfx->encoder;
-   } else {
-      if (!cmd->post_gfx->encoder) {
-         kk_start_compute_encoder(cmd->post_gfx, dev->mtl_handle,
-                                  cmd->argument_table);
-      }
-      encoder = cmd->post_gfx->encoder;
+      cmd->main.render_needed_pre = true;
+      return cmd->pre_gfx->encoder;
    }
 
-   return encoder;
+   if (!cmd->post_gfx->encoder)
+      kk_start_compute_encoder(cmd, cmd->post_gfx, false);
+   return cmd->post_gfx->encoder;
 }
 
 static void
@@ -500,9 +575,12 @@ kk_stop_encoder(struct kk_cmd_buffer *cmd, struct kk_encoder_state *es)
 
    kk_encoder_state_clear_timestamps(es);
 
-   mtl_end_command_buffer(es->cmd_buf);
-
-   util_dynarray_append(&cmd->submit_cmd_bufs, es->cmd_buf);
+   /* The main command buffer stays open for the encoders after this one. */
+   if (!es->in_main) {
+      mtl_end_command_buffer(es->cmd_buf);
+      util_dynarray_append(&cmd->submit_cmd_bufs, es->cmd_buf);
+   }
+   es->in_main = false;
    es->cmd_buf = NULL;
 }
 
@@ -512,27 +590,39 @@ cs_end(struct kk_cmd_buffer *cmd)
    assert(cmd);
 
    if (cmd->pre_gfx->encoder) {
-      /* Submit pre_gfx now that its encoder is closed. Command buffers are
-       * appended here (rather than at creation) so submit_cmd_bufs stays in
-       * encode order: pre_gfx first, then gfx below. post_gfx is promoted into
-       * the pre_gfx slot with its encoder still open, so it is submitted by a
-       * later cs_end() and therefore always ends up after gfx. This is why
-       * every flush site calls cs_end() twice. */
+      /* Close pre_gfx. A command buffer of its own is appended now, before
+       * the main one, which is still open. post_gfx is promoted into the
+       * pre_gfx slot with its encoder still open, so it is submitted by a
+       * later cs_end() and therefore always ends up after the pass. */
       kk_stop_encoder(cmd, cmd->pre_gfx);
 
       SWAP(cmd->pre_gfx, cmd->post_gfx);
    } else if (cmd->post_gfx->encoder) {
       /* No pre_gfx, but a post_gfx exists (e.g. compute issued during a render
        * pass). Promote it so a later cs_end() closes and submits it after the
-       * gfx command buffer appended below. */
+       * pass. */
       SWAP(cmd->pre_gfx, cmd->post_gfx);
    }
 
    if (cmd->gfx.encoder) {
       kk_stop_encoder(cmd, &cmd->gfx);
+      /* Promoted post-render work follows the pass and precedes whatever is
+       * recorded next, so the pass's main command buffer ends here. */
+      if (cmd->pre_gfx->encoder)
+         cs_end_main(cmd);
    }
 }
 
+/* Closes every encoder and command buffer, in submission order. */
+void
+cs_flush(struct kk_cmd_buffer *cmd)
+{
+   /* Twice: the first promotes post-render work, the second closes it. */
+   cs_end(cmd);
+   cs_end(cmd);
+   cs_end_main(cmd);
+}
