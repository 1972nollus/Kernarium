@@ -350,6 +358,26 @@ struct kk_cmd_buffer {
    struct kk_encoder_state *pre_gfx;
    struct kk_encoder_state *post_gfx;
 
+   /* Work that runs in recording order shares one Metal command buffer on
+    * the gfx allocator: every render encoder, and every compute encoder opened
+    * while no render encoder is. Metal charges a command buffer's first render
+    * encoder megabytes of allocator storage, so a recording that alternates
