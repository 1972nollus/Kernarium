diff --git a/src/kosmickrisp/vulkan/tests/test_offline_device_library.c b/src/kosmickrisp/vulkan/tests/test_offline_device_library.c
new file mode 100644
index 0000000000000000000000000000000000000000..98225e1fb14ee77d8997328b9b0bc05f537d49cb
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_offline_device_library.c
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: MIT */
+/* The device library compiled offline must hold every program the driver
+ * dispatches, each named after its program index, and every one must build
+ * a compute pipeline. A missing or refused program silently falls back to
+ * compiling its MSL whenever a device is created, so device creation must
+ * also report that it built every program from the metallib.
+ */
+#define VK_NO_PROTOTYPES
+#include "kosmickrisp/vulkan/kk_device.h"
+#include "kosmickrisp/bridge/mtl_bridge.h"
+#include "kosmickrisp/bridge/mtl_compiler.h"
+#include "kosmickrisp/clc/kk_precompiled_shader.h"
+
+#include "kk_metallib.h"
+#include "libkk_shaders.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+#define CHECK(x)                                                               \
+   do {                                                                        \
+      if (!(x)) {                                                              \
+         fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x);               \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+static double
+now_ms(void)
+{
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return t.tv_sec * 1e3 + t.tv_nsec / 1e6;
+}
+
+int
+main(void)
+{
+#ifndef KK_HAVE_METALLIB
+   printf("this platform has no offline device library\n");
+   return 77;
+#else
+   CHECK(libkk_metallib_programs == LIBKK_NUM_PROGRAMS);
+   CHECK(libkk_metallib_size > 0);
+
+   PFN_vkCreateInstance vkCreateInstance =
+      (PFN_vkCreateInstance)vkGetInstanceProcAddr(NULL, "vkCreateInstance");
+   CHECK(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   VkInstanceCreateInfo ici = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+                               .pApplicationInfo = &app};
+   VkInstance instance;
+   CHECK(vkCreateInstance(&ici, NULL, &instance) == VK_SUCCESS);
+   PFN_vkEnumeratePhysicalDevices vkEnumeratePhysicalDevices =
+      (PFN_vkEnumeratePhysicalDevices)vkGetInstanceProcAddr(
+         instance, "vkEnumeratePhysicalDevices");
+   PFN_vkCreateDevice vkCreateDevice =
+      (PFN_vkCreateDevice)vkGetInstanceProcAddr(instance, "vkCreateDevice");
+   PFN_vkGetDeviceProcAddr vkGetDeviceProcAddr =
+      (PFN_vkGetDeviceProcAddr)vkGetInstanceProcAddr(instance,
+                                                     "vkGetDeviceProcAddr");
+   PFN_vkDestroyInstance vkDestroyInstance =
+      (PFN_vkDestroyInstance)vkGetInstanceProcAddr(instance,
+                                                   "vkDestroyInstance");
+   CHECK(vkEnumeratePhysicalDevices && vkCreateDevice && vkGetDeviceProcAddr &&
+         vkDestroyInstance);
+
+   uint32_t count = 1;
+   VkPhysicalDevice physical;
+   CHECK(vkEnumeratePhysicalDevices(instance, &count, &physical) == VK_SUCCESS);
+   CHECK(count == 1);
+   float priority = 1;
+   VkDeviceQueueCreateInfo qci = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority};
+   VkDeviceCreateInfo dci = {.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+                             .queueCreateInfoCount = 1,
+                             .pQueueCreateInfos = &qci};
+   VkDevice device;
+   double start = now_ms();
+   CHECK(vkCreateDevice(physical, &dci, NULL, &device) == VK_SUCCESS);
+   printf("vkCreateDevice took %.1f ms\n", now_ms() - start);
+   struct kk_device *dev = kk_device_from_handle(device);
+   /* Creating the device compiled no program's MSL. */
+   CHECK(dev->precompiled_cache.offline_count == LIBKK_NUM_PROGRAMS);
+   PFN_vkDestroyDevice vkDestroyDevice =
+      (PFN_vkDestroyDevice)vkGetDeviceProcAddr(device, "vkDestroyDevice");
+   CHECK(vkDestroyDevice);
+
+   start = now_ms();
+   mtl_library *library = mtl_new_library_with_data(
+      dev->mtl_handle, libkk_metallib, libkk_metallib_size);
+   CHECK(library);
+   for (unsigned i = 0; i < LIBKK_NUM_PROGRAMS; i++) {
+      const struct kk_precompiled_info *info =
+         (const void *)libkk_AppleSilicon[i];
+      char entry_point[32];
+      snprintf(entry_point, sizeof(entry_point), "libkk_%u", i);
+      mtl_function_descriptor *function =
+         mtl_new_library_function_descriptor(library, entry_point);
+      CHECK(function);
+      mtl_compute_pipeline_state *pipeline = mtl_new_compute_pipeline_state(
+         dev->mtl_compiler_handle, function,
+         info->workgroup_size[0] * info->workgroup_size[1] *
+            info->workgroup_size[2]);
+      if (!pipeline)
+         fprintf(stderr, "offline program %u builds no pipeline\n", i);
+      CHECK(pipeline);
+      mtl_release(pipeline);
+      mtl_release(function);
+      CHECK(dev->precompiled_cache.shaders[i].pipeline);
+   }
+   mtl_release(library);
+   printf("%u offline programs, %zu bytes, built in %.1f ms\n",
+          LIBKK_NUM_PROGRAMS, libkk_metallib_size, now_ms() - start);
+
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+   printf("offline device library ok\n");
+   return 0;
+#endif
+}
