+/* The device library compiled offline for this platform, if the build made
+ * one; see kk_metallib.py. Compiling the programs' MSL instead costs every
+ * process that creates a device a front-end compile until Metal's cache
+ * holds the result. */
+static mtl_library *
+open_offline_library(struct kk_device *dev)
+{
+#ifdef KK_HAVE_METALLIB
+   if (libkk_metallib_programs == LIBKK_NUM_PROGRAMS)
+      return mtl_new_library_with_data(dev->mtl_handle, libkk_metallib,
+                                       libkk_metallib_size);
+#endif
+   return NULL;
+}
+
+static mtl_compute_pipeline_state *
+build_program(struct kk_device *dev, mtl_library *library,
+              const char *entry_point, uint32_t local_size_threads)
+{
+   mtl_function_descriptor *function =
+      mtl_new_library_function_descriptor(library, entry_point);
+   mtl_compute_pipeline_state *pipeline = mtl_new_compute_pipeline_state(
+      dev->mtl_compiler_handle, function, local_size_threads);
+   mtl_release(function);
+   return pipeline;
+}
+
 static VkResult
 build_precompiled_shaders(struct kk_device *dev)
 {
+   mtl_library *offline = open_offline_library(dev);
+   dev->precompiled_cache.offline_count = 0u;
+
    uint32_t i = 0u;
    for (; i < LIBKK_NUM_PROGRAMS; ++i) {
       const uint32_t *bin = libkk_AppleSilicon[i];
       const struct kk_precompiled_info *info = (void *)bin;
       const char *msl = (const char *)bin + sizeof(*info);
-
-      mtl_library *library =
