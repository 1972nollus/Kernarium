 #ifdef HAVE_LIBDRM
 #include "drm-uapi/dma-buf.h"
@@ -3422,6 +3422,14 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
 
    u_trace_state_init();
 
+#ifdef ZINK_VULKAN_DIRECT_ENTRYPOINT
+   /* The packaged Vulkan implementation is a link-time dependency, so the
+    * dynamic linker has already resolved the one exported entry point. Its
+    * device counterpart is an instance-level query and is resolved once the
+    * instance exists.
+    */
+   screen->vk_GetInstanceProcAddr = vkGetInstanceProcAddr;
+#else
    screen->loader_lib = util_dl_open(VK_LIBNAME);
    if (!screen->loader_lib) {
       if (!screen->driver_name_is_inferred)
@@ -3437,6 +3445,7 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
          mesa_loge("ZINK: failed to get proc address");
       goto fail;
    }
+#endif
 
    if (config) {
       driParseConfigFiles(config->options, config->options_info,
@@ -3464,6 +3473,16 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
    screen->instance_info = &instance_info;
    simple_mtx_unlock(&instance_lock);
 
+#ifdef ZINK_VULKAN_DIRECT_ENTRYPOINT
+   screen->vk_GetDeviceProcAddr = (PFN_vkGetDeviceProcAddr)
+      screen->vk_GetInstanceProcAddr(screen->instance, "vkGetDeviceProcAddr");
+   if (!screen->vk_GetDeviceProcAddr) {
+      if (!screen->driver_name_is_inferred)
+         mesa_loge("ZINK: failed to get proc address");
+      goto fail;
+   }
+#endif
+
    if (zink_debug & ZINK_DEBUG_VALIDATION) {
       if (!screen->instance_info->have_layer_KHRONOS_validation &&
           !screen->instance_info->have_layer_LUNARG_standard_validation) {
