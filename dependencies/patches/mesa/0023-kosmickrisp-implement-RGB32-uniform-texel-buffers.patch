diff --git a/src/kosmickrisp/vulkan/tests/test_rgb32_texel_format.c b/src/kosmickrisp/vulkan/tests/test_rgb32_texel_format.c
new file mode 100644
index 00000000..c94eb370
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_rgb32_texel_format.c
@@ -0,0 +1,65 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_descriptor_types.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(condition)                                                     \
+   do {                                                                      \
+      if (!(condition)) {                                                    \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,   \
+                 #condition);                                                \
+         abort();                                                            \
+      }                                                                      \
+   } while (0)
+
+static void
+check_raw_format(VkFormat vk_format,
+                 enum kk_raw_texel_buffer_format expected_format)
+{
+   CHECK(kk_raw_texel_buffer_format(vk_format) == expected_format);
+
+   const VkFormatFeatureFlags2 features =
+      kk_raw_texel_buffer_format_features(vk_format);
+   CHECK(features == VK_FORMAT_FEATURE_2_UNIFORM_TEXEL_BUFFER_BIT);
+   CHECK(!(features & VK_FORMAT_FEATURE_2_STORAGE_TEXEL_BUFFER_BIT));
+
+   const uint32_t packed = kk_pack_raw_texel_buffer_format(expected_format);
+   CHECK(packed & KK_TEXEL_BUFFER_RAW_FORMAT_FLAG);
+   CHECK((packed & KK_TEXEL_BUFFER_RAW_FORMAT_MASK) == expected_format);
+
+   const struct kk_texel_buffer_descriptor desc = {
+      .raw_address = 0x123456789abcdef0ull,
+      .raw_format = packed,
+      .element_count = 37,
+   };
+   CHECK(desc.image_gpu_resource_id == 0x123456789abcdef0ull);
+   CHECK(desc.texel_offset == packed);
+   CHECK(desc.element_count == 37);
+}
+
+int
+main(void)
+{
+   check_raw_format(VK_FORMAT_R32G32B32_SFLOAT,
+                    KK_RAW_TEXEL_BUFFER_FORMAT_R32G32B32_FLOAT);
+   check_raw_format(VK_FORMAT_R32G32B32_SINT,
+                    KK_RAW_TEXEL_BUFFER_FORMAT_R32G32B32_SINT);
+   check_raw_format(VK_FORMAT_R32G32B32_UINT,
+                    KK_RAW_TEXEL_BUFFER_FORMAT_R32G32B32_UINT);
+
+   CHECK(kk_raw_texel_buffer_format(VK_FORMAT_R32G32B32A32_SFLOAT) ==
+         KK_RAW_TEXEL_BUFFER_FORMAT_NONE);
+   CHECK(kk_raw_texel_buffer_format_features(
+            VK_FORMAT_R32G32B32A32_SFLOAT) == 0);
+
+   /* Native texture offsets are bounded below bit 28. */
+   CHECK(!(KK_MAX_TEXEL_BUFFER_ELEMENTS &
+           KK_TEXEL_BUFFER_RAW_FORMAT_FLAG));
+
+   return 0;
+}
