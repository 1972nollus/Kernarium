@@ -526,6 +531,125 @@ lower_image_intrin(nir_builder *b, nir_intrinsic_instr *intr,
    return true;
 }
 
+static nir_def *
+load_raw_rgb32_texel(nir_builder *b, nir_tex_instr *tex,
+                     nir_deref_instr *texture_deref, nir_def *coord,
+                     const struct lower_descriptors_ctx *ctx)
+{
+   assert(coord->num_components == 1 && coord->bit_size == 32);
+   assert(tex->def.bit_size == 32);
+
+   nir_def *element_count = load_resource_deref_desc(
+      b, 1, 32, texture_deref,
+      offsetof(struct kk_texel_buffer_descriptor, element_count), ctx);
+
+   /* A signed negative coordinate is also out of range when compared as
+    * unsigned.  Keep the address calculation and the load inside this branch:
+    * robust access must reject the coordinate before multiplying it by the
+    * 12-byte texel stride.
+    */
+   nir_if *bounds_if = nir_push_if(b, nir_ult(b, coord, element_count));
+
+   nir_def *address = load_resource_deref_desc(
+      b, 1, 64, texture_deref,
+      offsetof(struct kk_texel_buffer_descriptor, raw_address), ctx);
+   address = nir_iadd(
+      b, address, nir_imul_imm(b, nir_u2u64(b, coord), 3 * sizeof(uint32_t)));
+
+   /* nir_to_msl emits this as one packed uint3/int3/float3 GPU load.  The
+    * texture destination type propagates through the phi and selects the
+    * correct interpretation without any numerical conversion.
+    */
+   nir_def *rgb = nir_load_global_constant(b, 3, 32, address,
+                                           .align_mul = sizeof(uint32_t));
+   const nir_alu_type base_type =
+      nir_alu_type_get_base_type(tex->dest_type);
+   nir_def *alpha = base_type == nir_type_float
+                       ? nir_imm_floatN_t(b, 1.0, tex->def.bit_size)
+                       : nir_imm_intN_t(b, 1, tex->def.bit_size);
+   nir_def *value = nir_vec4(b, nir_channel(b, rgb, 0),
+                             nir_channel(b, rgb, 1),
+                             nir_channel(b, rgb, 2), alpha);
+   value = nir_trim_vector(b, value, nir_tex_instr_result_size(tex));
+
+   /* Sparse buffer residency is not exposed, so a raw load is resident. */
+   if (tex->is_sparse) {
+      value = nir_pad_vector_imm_int(b, value, 0,
+                                     value->num_components + 1);
+   }
+
+   nir_push_else(b, bounds_if);
+   nir_def *zero =
+      nir_imm_zero(b, nir_tex_instr_dest_size(tex), tex->def.bit_size);
+   nir_pop_if(b, bounds_if);
+
+   return nir_if_phi(b, value, zero);
+}
+
+static nir_def *
+lower_buffer_texel_fetch(nir_builder *b, nir_tex_instr *tex,
+                         nir_deref_instr *texture_deref,
+                         struct lower_descriptors_ctx *ctx)
+{
+   assert(tex->op == nir_texop_txf);
+   assert(!tex->is_shadow && !tex->is_array);
+
+   const int coord_src_idx =
+      nir_tex_instr_src_index(tex, nir_tex_src_coord);
+   assert(coord_src_idx >= 0);
+   nir_def *coord = tex->src[coord_src_idx].src.ssa;
+
+   nir_def *offset_or_format = load_resource_deref_desc(
+      b, 1, 32, texture_deref,
+      offsetof(struct kk_texel_buffer_descriptor, raw_format), ctx);
+   nir_def *is_raw = nir_ine_imm(
+      b, nir_iand_imm(b, offset_or_format, KK_TEXEL_BUFFER_RAW_FORMAT_FLAG),
+      0);
+
+   /* The selected descriptor decides between a raw RGB32 load and the native
+    * Metal texture-buffer instruction.  This also supports non-uniformly
+    * indexed descriptor arrays without shader variants.
+    *
+    * The format and bounds branches invalidate any block indices and
+    * dominance an earlier pass left valid.
+    */
+   ctx->inserted_control_flow = true;
+   nir_if *format_if = nir_push_if(b, is_raw);
+   nir_def *raw =
+      load_raw_rgb32_texel(b, tex, texture_deref, coord, ctx);
+
+   nir_push_else(b, format_if);
+
+   nir_src_rewrite(&tex->src[coord_src_idx].src,
+                   nir_iadd(b, coord, offset_or_format));
+
+   nir_def *resource_addr = load_resource_addr(
+      b, 1, 64, texture_deref,
+      offsetof(struct kk_texel_buffer_descriptor, image_gpu_resource_id), ctx);
+   nir_def *handle = nir_load_texture_handle_kk(
+      b, 1, 64, resource_addr, .dest_type = tex->dest_type,
+      .image_dim = tex->sampler_dim, .image_array = tex->is_array);
+   nir_tex_instr_add_src(tex, nir_tex_src_texture_handle, handle);
+
+   nir_instr_remove(&tex->instr);
+   nir_builder_instr_insert(b, &tex->instr);
+   nir_block *native_block = nir_cursor_current_block(b->cursor);
+   nir_pop_if(b, format_if);
+
+   nir_def *phi = nir_if_phi(b, raw, &tex->def);
+
+   /* The global rewrite also reaches the phi itself; restore its native-path
+    * source to the original texture instruction afterwards.
+    */
+   nir_def_rewrite_uses(&tex->def, phi);
+   nir_phi_instr *phi_instr = nir_def_as_phi(phi);
+   nir_phi_src *native_src =
+      nir_phi_get_src_from_block(phi_instr, native_block);
+   nir_src_rewrite(&native_src->src, &tex->def);
+
+   return phi;
+}
+
 static bool
 try_lower_intrin(nir_builder *b, nir_intrinsic_instr *intrin,
                  const struct lower_descriptors_ctx *ctx)
@@ -572,7 +696,7 @@ try_lower_intrin(nir_builder *b, nir_intrinsic_instr *intrin,
 
 static bool
 lower_tex(nir_builder *b, nir_tex_instr *tex,
-          const struct lower_descriptors_ctx *ctx)
+          struct lower_descriptors_ctx *ctx)
 {
    b->cursor = nir_before_instr(&tex->instr);
 
@@ -598,6 +722,7 @@ lower_tex(nir_builder *b, nir_tex_instr *tex,
                     : NON_SEAMLESS_CUBE_NATIVE;
    if (tex->sampler_dim == GLSL_SAMPLER_DIM_BUF) {
       assert(plane == 0);
+      assert(sampler == NULL);
       if (tex->op == nir_texop_txs) {
          nir_def *element_count = load_resource_deref_desc(
             b, 1, 32, texture_deref,
@@ -606,15 +731,8 @@ lower_tex(nir_builder *b, nir_tex_instr *tex,
          return true;
       }
 
-      const int coord_src_idx =
-         nir_tex_instr_src_index(tex, nir_tex_src_coord);
-      assert(coord_src_idx >= 0);
-      nir_def *texel_offset = load_resource_deref_desc(
-         b, 1, 32, texture_deref,
-         offsetof(struct kk_texel_buffer_descriptor, texel_offset), ctx);
-      nir_src_rewrite(&tex->src[coord_src_idx].src,
-                      nir_iadd(b, tex->src[coord_src_idx].src.ssa,
-                               texel_offset));
+      lower_buffer_texel_fetch(b, tex, texture_deref, ctx);
+      return true;
    }
 
    /* LOD bias is passed in the descriptor set, rather than embedded into
@@ -846,7 +964,7 @@ lower_tex(nir_builder *b, nir_tex_instr *tex,
 static bool
 try_lower_descriptors_instr(nir_builder *b, nir_instr *instr, void *_data)
 {
-   const struct lower_descriptors_ctx *ctx = _data;
+   struct lower_descriptors_ctx *ctx = _data;
 
    switch (instr->type) {
    case nir_instr_type_tex:
@@ -858,6 +976,28 @@ try_lower_descriptors_instr(nir_builder *b, nir_instr *instr, void *_data)
    }
 }
 
+static bool
+lower_descriptors_impl(nir_function_impl *impl,
+                       struct lower_descriptors_ctx *ctx)
+{
+   nir_builder b = nir_builder_create(impl);
+   bool progress = false;
+
+   ctx->inserted_control_flow = false;
+   nir_foreach_block_safe(block, impl) {
+      nir_foreach_instr_safe(instr, block) {
+         progress |= try_lower_descriptors_instr(&b, instr, ctx);
+      }
+   }
+
+   /* Raw RGB32 texel fetches add blocks that cached block indices and
+    * dominance do not cover, so they must not survive this pass.
+    */
+   return nir_progress(progress, impl,
+                       ctx->inserted_control_flow ? nir_metadata_none
+                                                  : nir_metadata_control_flow);
+}
+
 static bool
 lower_ssbo_resource_index(nir_builder *b, nir_intrinsic_instr *intrin,
                           const struct lower_descriptors_ctx *ctx)
@@ -1041,8 +1181,9 @@ kk_nir_lower_descriptors(nir_shader *nir,
     * TODO: See if we can unify this, not sure if the fast path matters on
     * Apple. This is inherited from NVK.
     */
-   bool pass_lower_descriptors = nir_shader_instructions_pass(
-      nir, try_lower_descriptors_instr, nir_metadata_control_flow, &ctx);
+   bool pass_lower_descriptors = false;
+   nir_foreach_function_impl(impl, nir)
+      pass_lower_descriptors |= lower_descriptors_impl(impl, &ctx);
 
    bool pass_lower_ssbo = nir_shader_intrinsics_pass(
       nir, lower_ssbo_descriptor, nir_metadata_control_flow, &ctx);
