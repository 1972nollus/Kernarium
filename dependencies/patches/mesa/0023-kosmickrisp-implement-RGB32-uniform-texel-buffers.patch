diff --git a/src/kosmickrisp/vulkan/kk_buffer_view.c b/src/kosmickrisp/vulkan/kk_buffer_view.c
index 2a169448..4c8f4de9 100644
--- a/src/kosmickrisp/vulkan/kk_buffer_view.c
+++ b/src/kosmickrisp/vulkan/kk_buffer_view.c
@@ -8,6 +8,7 @@
 #include "kk_buffer_view.h"
 
 #include "kk_buffer.h"
+#include "kk_descriptor_types.h"
 #include "kk_device.h"
 #include "kk_entrypoints.h"
 #include "kk_format.h"
@@ -47,6 +48,11 @@ kk_get_buffer_format_features(struct kk_physical_device *pdev,
          features |= VK_FORMAT_FEATURE_2_STORAGE_TEXEL_BUFFER_ATOMIC_BIT;
    }
 
+   /* Metal has no three-component 32-bit texture-buffer formats.  Read these
+    * through the raw GPU address carried by the ordinary texel descriptor.
+    */
+   features |= kk_raw_texel_buffer_format_features(vk_format);
+
    if (kk_vbo_supports_format(p_format))
       features |= VK_FORMAT_FEATURE_2_VERTEX_BUFFER_BIT;
 
@@ -67,6 +73,22 @@ kk_CreateBufferView(VkDevice _device, const VkBufferViewCreateInfo *pCreateInfo,
    enum pipe_format p_format = vk_format_to_pipe_format(view->vk.format);
    const struct kk_va_format *supported_format = kk_get_va_format(p_format);
 
+   struct kk_buffer *buffer =
+      container_of(view->vk.buffer, struct kk_buffer, vk);
+   const enum kk_raw_texel_buffer_format raw_format =
+      kk_raw_texel_buffer_format(view->vk.format);
+
+   if (raw_format != KK_RAW_TEXEL_BUFFER_FORMAT_NONE) {
+      assert(view->vk.elements <= UINT32_MAX);
+      view->texel_buffer_gpu_id =
+         vk_buffer_address(&buffer->vk, view->vk.offset);
+      view->texel_offset = kk_pack_raw_texel_buffer_format(raw_format);
+      *pBufferView = kk_buffer_view_to_handle(view);
+      return VK_SUCCESS;
+   }
+
+   assert(supported_format != NULL);
+
    /* If we reached here, we support reading at least */
    enum mtl_texture_usage usage = MTL_TEXTURE_USAGE_SHADER_READ;
    if (supported_format->texel_buffer.write)
@@ -85,8 +107,6 @@ kk_CreateBufferView(VkDevice _device, const VkBufferViewCreateInfo *pCreateInfo,
    assert(util_is_power_of_two_or_zero64(mtl_alignment_B));
    assert(mtl_alignment_B > 0);
 
-   struct kk_buffer *buffer =
-      container_of(view->vk.buffer, struct kk_buffer, vk);
    const uint64_t absolute_offset_B =
       kk_buffer_absolute_offset(buffer, view->vk.offset);
    const uint64_t aligned_offset_B = absolute_offset_B & ~(mtl_alignment_B - 1);
