+#include "kosmickrisp/vulkan/kk_shader.h"
+
+#include "compiler/glsl_types.h"
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "kosmickrisp/compiler/msl_private.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+#include "util/hash_table.h"
+#include "vulkan/runtime/vk_pipeline.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(condition)                                                     \
+   do {                                                                      \
+      if (!(condition)) {                                                    \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,   \
+                 #condition);                                                \
+         abort();                                                            \
+      }                                                                      \
+   } while (0)
+
+struct lowering_stats {
+   nir_intrinsic_instr *raw_load;
+   nir_tex_instr *native_fetch;
+   unsigned raw_loads;
+   unsigned native_fetches;
+   unsigned stride_multiplies;
+   bool saw_float_one;
+};
+
+static bool
+src_is_imm(nir_src src, uint64_t value)
+{
+   return nir_src_is_const(src) && nir_src_as_uint(src) == value;
+}
+
+static void
+collect_stats(nir_shader *shader, struct lowering_stats *stats)
+{
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic) {
+               nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+               if (intr->intrinsic == nir_intrinsic_load_global_constant &&
+                   intr->def.num_components == 3 &&
+                   intr->def.bit_size == 32) {
+                  stats->raw_load = intr;
+                  stats->raw_loads++;
+               }
+            } else if (instr->type == nir_instr_type_tex) {
+               nir_tex_instr *tex = nir_instr_as_tex(instr);
+               if (tex->sampler_dim == GLSL_SAMPLER_DIM_BUF &&
+                   tex->op == nir_texop_txf) {
+                  stats->native_fetch = tex;
+                  stats->native_fetches++;
+               }
+            } else if (instr->type == nir_instr_type_alu) {
+               nir_alu_instr *alu = nir_instr_as_alu(instr);
+               if (alu->op == nir_op_imul && alu->def.bit_size == 64 &&
+                   (src_is_imm(alu->src[0].src, 12) ||
+                    src_is_imm(alu->src[1].src, 12)))
+                  stats->stride_multiplies++;
+            } else if (instr->type == nir_instr_type_load_const) {
+               nir_load_const_instr *load = nir_instr_as_load_const(instr);
+               if (load->def.bit_size == 32 &&
+                   load->value[0].u32 == 0x3f800000u)
+                  stats->saw_float_one = true;
+            }
+         }
+      }
+   }
+}
+
+static void
+check_numeric_type(enum glsl_base_type base_type, nir_alu_type dest_type,
+                   bool descriptor_array)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_COMPUTE, &kk_nir_options, "RGB32 texel lowering test");
+   b.shader->info.workgroup_size[0] = 1;
+   b.shader->info.workgroup_size[1] = 1;
+   b.shader->info.workgroup_size[2] = 1;
+
+   const struct glsl_type *sampler_type = glsl_sampler_type(
+      GLSL_SAMPLER_DIM_BUF, false, false, base_type);
+   const unsigned array_size = descriptor_array ? 8 : 1;
+   const struct glsl_type *variable_type =
+      descriptor_array
+         ? glsl_array_type(sampler_type, array_size, 0)
+         : sampler_type;
+   nir_variable *variable = nir_variable_create(
+      b.shader, nir_var_uniform, variable_type, "texel_buffers");
+   variable->data.descriptor_set = 0;
+   variable->data.binding = 0;
+
+   nir_deref_instr *deref = nir_build_deref_var(&b, variable);
+   nir_def *invocation = nir_load_local_invocation_index(&b);
+   if (descriptor_array)
+      deref = nir_build_deref_array(&b, deref, invocation);
+
+   nir_tex_instr *tex = nir_tex_instr_create(b.shader, 2);
+   tex->sampler_dim = GLSL_SAMPLER_DIM_BUF;
+   tex->op = nir_texop_txf;
+   tex->src[0] = nir_tex_src_for_ssa(nir_tex_src_coord, invocation);
+   tex->src[1] =
+      nir_tex_src_for_ssa(nir_tex_src_texture_deref, &deref->def);
+   tex->dest_type = dest_type;
+   tex->texture_non_uniform = descriptor_array;
+   tex->coord_components = 1;
+   nir_def_init(&tex->instr, &tex->def, 4, 32);
+   nir_builder_instr_insert(&b, &tex->instr);
+
+   /* Give MSL type inference an application-like typed consumer so the test
+    * proves the raw load remains bit-preserving float, signed, or unsigned
+    * data instead of merely counting an untyped memory intrinsic.
+    */
+   nir_def *zero = nir_imm_zero(&b, 4, 32);
+   nir_def *typed_value = NULL;
+   switch (base_type) {
+   case GLSL_TYPE_FLOAT:
+      typed_value = nir_fadd(&b, &tex->def, zero);
+      break;
+   case GLSL_TYPE_INT:
+      typed_value = nir_imin(&b, &tex->def, zero);
+      break;
+   case GLSL_TYPE_UINT:
+      typed_value = nir_udiv_imm(&b, &tex->def, 3);
+      break;
+   default:
+      CHECK(false);
+   }
+   nir_store_global(&b, typed_value, nir_imm_int64(&b, 0x1000),
+                    .align_mul = sizeof(uint32_t));
+
+   struct kk_descriptor_set_layout *layout =
+      calloc(1, sizeof(*layout) + sizeof(layout->binding[0]));
+   CHECK(layout != NULL);
+   layout->binding_count = 1;
+   layout->binding[0] = (struct kk_descriptor_set_binding_layout){
+      .type = descriptor_array ? VK_DESCRIPTOR_TYPE_MUTABLE_EXT
+                               : VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER,
+      .array_size = array_size,
+      .offset = 0,
+      .stride = sizeof(struct kk_texel_buffer_descriptor),
+   };
+
+   struct vk_descriptor_set_layout *set_layouts[] = {&layout->vk};
+   const struct vk_pipeline_robustness_state robustness = {
+      .uniform_buffers =
+         VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED,
+      .storage_buffers =
+         VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED,
+      .images = VK_PIPELINE_ROBUSTNESS_IMAGE_BEHAVIOR_ROBUST_IMAGE_ACCESS_2,
+   };
+
+   /* Earlier vertex passes (including native point clipping) can leave valid
+    * block indices and dominance. Format selection and robust RGB32 loads add
+    * branches, so descriptor lowering must invalidate this cached CFG data.
+    */
+   nir_metadata_require(b.impl, nir_metadata_control_flow);
+   CHECK(kk_nir_lower_descriptors(b.shader, &robustness, 1, set_layouts,
+                                  false));
+   CHECK(!(b.impl->valid_metadata & nir_metadata_control_flow));
+   nir_metadata_require(b.impl, nir_metadata_control_flow);
+   nir_validate_shader(b.shader, "after RGB32 texel descriptor lowering");
+
+   struct lowering_stats stats = {};
+   collect_stats(b.shader, &stats);
+   CHECK(stats.raw_loads == 1);
+   CHECK(stats.native_fetches == 1);
+   CHECK(stats.stride_multiplies == 1);
+   CHECK(stats.raw_load != NULL && stats.native_fetch != NULL);
+   CHECK(nir_intrinsic_align_mul(stats.raw_load) == sizeof(uint32_t));
+   CHECK(!(nir_intrinsic_access(stats.raw_load) & ACCESS_CAN_SPECULATE));
+
+   /* The packed load is nested under format selection and the unsigned bounds
+    * branch.  The native fetch is the sibling format branch.
+    */
+   nir_cf_node *bounds_parent = stats.raw_load->instr.block->cf_node.parent;
+   CHECK(bounds_parent != NULL && bounds_parent->type == nir_cf_node_if);
+   CHECK(bounds_parent->parent != NULL &&
+         bounds_parent->parent->type == nir_cf_node_if);
+   CHECK(stats.native_fetch->instr.block->cf_node.parent ==
+         bounds_parent->parent);
+
+   bool has_texture_handle = false;
+   bool has_texture_deref = false;
+   for (unsigned i = 0; i < stats.native_fetch->num_srcs; i++) {
+      has_texture_handle |=
+         stats.native_fetch->src[i].src_type == nir_tex_src_texture_handle;
+      has_texture_deref |=
+         stats.native_fetch->src[i].src_type == nir_tex_src_texture_deref;
+   }
+   CHECK(has_texture_handle && !has_texture_deref);
+   CHECK(stats.saw_float_one == (base_type == GLSL_TYPE_FLOAT));
+
+   /* Match the production order: phis are removed and SSA is lowered before
+    * MSL infers the concrete packed-load type.
+    */
+   msl_optimize_nir(b.shader);
+   struct lowering_stats optimized_stats = {};
+   collect_stats(b.shader, &optimized_stats);
+   CHECK(optimized_stats.raw_loads == 1);
+
+   struct hash_table *types = msl_infer_types(b.shader);
+   const char *expected_raw_type =
+      base_type == GLSL_TYPE_FLOAT ? "float3"
+      : base_type == GLSL_TYPE_INT ? "int3"
+                                   : "uint3";
+   CHECK(strcmp(msl_type_for_def(types, &optimized_stats.raw_load->def),
+                expected_raw_type) == 0);
+   _mesa_hash_table_destroy(types, NULL);
+
+   free(layout);
+   ralloc_free(b.shader);
+}
+
+/* A texel-buffer size query lowers without branches, so the cached CFG data
+ * from earlier passes must remain valid.
+ */
+static void
+check_metadata_preserved_without_branches(void)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_COMPUTE, &kk_nir_options, "texel size lowering control");
+   b.shader->info.workgroup_size[0] = 1;
+   b.shader->info.workgroup_size[1] = 1;
+   b.shader->info.workgroup_size[2] = 1;
+
+   const struct glsl_type *sampler_type = glsl_sampler_type(
+      GLSL_SAMPLER_DIM_BUF, false, false, GLSL_TYPE_UINT);
+   nir_variable *variable = nir_variable_create(
+      b.shader, nir_var_uniform, sampler_type, "texel_buffer");
+   variable->data.descriptor_set = 0;
+   variable->data.binding = 0;
+
+   nir_deref_instr *deref = nir_build_deref_var(&b, variable);
+   nir_tex_instr *tex = nir_tex_instr_create(b.shader, 1);
+   tex->sampler_dim = GLSL_SAMPLER_DIM_BUF;
+   tex->op = nir_texop_txs;
+   tex->src[0] =
+      nir_tex_src_for_ssa(nir_tex_src_texture_deref, &deref->def);
+   tex->dest_type = nir_type_int32;
+   nir_def_init(&tex->instr, &tex->def, 1, 32);
+   nir_builder_instr_insert(&b, &tex->instr);
+   nir_store_global(&b, &tex->def, nir_imm_int64(&b, 0x1000),
+                    .align_mul = sizeof(uint32_t));
+
+   struct kk_descriptor_set_layout *layout =
+      calloc(1, sizeof(*layout) + sizeof(layout->binding[0]));
+   CHECK(layout != NULL);
+   layout->binding_count = 1;
+   layout->binding[0] = (struct kk_descriptor_set_binding_layout){
+      .type = VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER,
+      .array_size = 1,
+      .offset = 0,
+      .stride = sizeof(struct kk_texel_buffer_descriptor),
+   };
+
+   struct vk_descriptor_set_layout *set_layouts[] = {&layout->vk};
+   const struct vk_pipeline_robustness_state robustness = {
+      .uniform_buffers =
+         VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED,
+      .storage_buffers =
+         VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED,
+      .images = VK_PIPELINE_ROBUSTNESS_IMAGE_BEHAVIOR_ROBUST_IMAGE_ACCESS_2,
+   };
+
+   nir_metadata_require(b.impl, nir_metadata_control_flow);
+   CHECK(kk_nir_lower_descriptors(b.shader, &robustness, 1, set_layouts,
+                                  false));
+   CHECK((b.impl->valid_metadata & nir_metadata_control_flow) ==
+         nir_metadata_control_flow);
+   nir_validate_shader(b.shader, "after texel size descriptor lowering");
+
+   struct lowering_stats stats = {};
+   collect_stats(b.shader, &stats);
+   CHECK(stats.raw_loads == 0 && stats.native_fetches == 0);
+
+   free(layout);
+   ralloc_free(b.shader);
+}
+
+int
+main(void)
+{
+   glsl_type_singleton_init_or_ref();
+
+   check_numeric_type(GLSL_TYPE_FLOAT, nir_type_float32, false);
+   check_numeric_type(GLSL_TYPE_INT, nir_type_int32, false);
+   check_numeric_type(GLSL_TYPE_UINT, nir_type_uint32, false);
+   check_numeric_type(GLSL_TYPE_UINT, nir_type_uint32, true);
+   check_metadata_preserved_without_branches();
+
+   glsl_type_singleton_decref();
+   return 0;
+}
