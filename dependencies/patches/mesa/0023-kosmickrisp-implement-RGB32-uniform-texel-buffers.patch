diff --git a/src/kosmickrisp/vulkan/kk_descriptor_types.h b/src/kosmickrisp/vulkan/kk_descriptor_types.h
index 9b4a16df..9de73007 100644
--- a/src/kosmickrisp/vulkan/kk_descriptor_types.h
+++ b/src/kosmickrisp/vulkan/kk_descriptor_types.h
@@ -77,9 +77,61 @@ struct kk_storage_image_descriptor {
 static_assert(sizeof(struct kk_storage_image_descriptor) == 8,
               "kk_storage_image_descriptor has no holes");
 
+enum kk_raw_texel_buffer_format {
+   KK_RAW_TEXEL_BUFFER_FORMAT_NONE = 0,
+   KK_RAW_TEXEL_BUFFER_FORMAT_R32G32B32_FLOAT = 1,
+   KK_RAW_TEXEL_BUFFER_FORMAT_R32G32B32_SINT = 2,
+   KK_RAW_TEXEL_BUFFER_FORMAT_R32G32B32_UINT = 3,
+};
+
+/* Native texel buffers use this word as a small Metal texture offset.  A high
+ * bit therefore distinguishes raw-buffer formats without growing the 16-byte
+ * descriptor or specializing pipelines for a particular view format.
+ */
+#define KK_TEXEL_BUFFER_RAW_FORMAT_FLAG BITFIELD_BIT(31)
+#define KK_TEXEL_BUFFER_RAW_FORMAT_MASK BITFIELD_MASK(8)
+
+static inline enum kk_raw_texel_buffer_format
+kk_raw_texel_buffer_format(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_R32G32B32_SFLOAT:
+      return KK_RAW_TEXEL_BUFFER_FORMAT_R32G32B32_FLOAT;
+   case VK_FORMAT_R32G32B32_SINT:
+      return KK_RAW_TEXEL_BUFFER_FORMAT_R32G32B32_SINT;
+   case VK_FORMAT_R32G32B32_UINT:
+      return KK_RAW_TEXEL_BUFFER_FORMAT_R32G32B32_UINT;
+   default:
+      return KK_RAW_TEXEL_BUFFER_FORMAT_NONE;
+   }
+}
+
+static inline VkFormatFeatureFlags2
+kk_raw_texel_buffer_format_features(VkFormat format)
+{
+   return kk_raw_texel_buffer_format(format) !=
+             KK_RAW_TEXEL_BUFFER_FORMAT_NONE
+             ? VK_FORMAT_FEATURE_2_UNIFORM_TEXEL_BUFFER_BIT
+             : 0;
+}
+
+static inline uint32_t
+kk_pack_raw_texel_buffer_format(enum kk_raw_texel_buffer_format format)
+{
+   assert(format != KK_RAW_TEXEL_BUFFER_FORMAT_NONE);
+   assert((format & ~KK_TEXEL_BUFFER_RAW_FORMAT_MASK) == 0);
+   return KK_TEXEL_BUFFER_RAW_FORMAT_FLAG | format;
+}
+
 struct kk_texel_buffer_descriptor {
-   uint64_t image_gpu_resource_id;
-   uint32_t texel_offset;
+   union {
+      uint64_t image_gpu_resource_id;
+      uint64_t raw_address;
+   };
+   union {
+      uint32_t texel_offset;
+      uint32_t raw_format;
+   };
    uint32_t element_count;
 };
 
diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c b/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
