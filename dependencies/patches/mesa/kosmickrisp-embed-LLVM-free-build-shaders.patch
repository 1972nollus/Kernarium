diff --git a/src/poly/cl/meson.build b/src/poly/cl/meson.build
index 286dcf1c90e25046de23f180a41a162225aa1f61..d948b53154730495112f0d5123048cdf0af688d6 100644
--- a/src/poly/cl/meson.build
+++ b/src/poly/cl/meson.build
@@ -7,21 +7,10 @@ libpoly_shader_files = files(
   'tessellation.cl',
 )
 
-libpoly_shaders_spv = custom_target(
-  input : libpoly_shader_files,
-  output : 'libpoly.spv',
-  command : [
-    prog_mesa_clc, '-o', '@OUTPUT@', '--depfile', '@DEPFILE@',
-    libpoly_shader_files, '--',
-    '-I' + join_paths(meson.project_source_root(), 'include'),
-    '-I' + join_paths(meson.project_source_root(), 'src/compiler/libcl'),
-    '-I' + join_paths(meson.current_source_dir(), '.'),
-    '-I' + join_paths(meson.current_source_dir(), '../../'),
-    cl_args,
-    ],
-  depends : [],
-  depfile : 'libpoly_shaders.h.d',
-)
+# Keep the runtime dependency closure free of LLVM: libpoly.spv is prebuilt
+# mesa_clc output of libpoly_shader_files, generated and checked together with
+# libkk.spv under the contract in src/kosmickrisp/libkk/meson.build.
+libpoly_shaders_spv = files('libpoly.spv')
 
 libpoly_shaders = custom_target(
   input : libpoly_shaders_spv,
