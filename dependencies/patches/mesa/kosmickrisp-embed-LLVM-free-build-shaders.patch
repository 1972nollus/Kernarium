diff --git a/src/kosmickrisp/libkk/meson.build b/src/kosmickrisp/libkk/meson.build
index 04e175252552d8753677f09843d388450445e4de..236af5081351c89aa0748ac61dc69dbe092ccf8c 100644
--- a/src/kosmickrisp/libkk/meson.build
+++ b/src/kosmickrisp/libkk/meson.build
@@ -10,22 +10,17 @@ libkk_shader_files = files(
   'kk_tessellator.cl',
 )
 
-libkk_spv = custom_target(
-  input : libkk_shader_files,
-  output : 'libkk.spv',
-  command : [
-    prog_mesa_clc, '-o', '@OUTPUT@', '--depfile', '@DEPFILE@',
-    libkk_shader_files, '--',
-    '-I' + join_paths(meson.project_source_root(), 'include'),
-    '-I' + join_paths(meson.project_source_root(), 'src/compiler/libcl'),
-    '-I' + join_paths(meson.project_source_root(), 'src/poly/cl'),
-    '-I' + join_paths(meson.current_source_dir(), '.'),
-    '-I' + join_paths(meson.current_source_dir(), '../../'),
-    '-I' + join_paths(meson.current_source_dir(), 'shaders'),
-    cl_args,
-    ],
-  depfile : 'libkk_shaders.h.d',
-)
+# The Apple product build keeps LLVM out of its production dependency closure,
+# so libkk.spv is prebuilt mesa_clc output rather than a build step.  The
+# maintaining project's dependencies/kosmickrisp-spirv/generate.py produces it
+# from libkk_shader_files at the head of the maintained series: it builds
+# mesa_clc from that tree on the Debian toolchain its toolchain.tsv pins and
+# compiles with the include directories of the rule this replaced and the
+# release cl_args, whose NDEBUG compiles the shader assert()s out.  A later
+# topic that edits an input changes nothing until the blob is regenerated with
+# that script and amended into this topic; the project's tooling suite fails
+# until then.
+libkk_spv = files('libkk.spv')
 
 libkk = custom_target(
   input : libkk_spv,
