diff --git a/src/kosmickrisp/vulkan/tests/test_timeline_wait_loss.c b/src/kosmickrisp/vulkan/tests/test_timeline_wait_loss.c
index 7b8dd8bcb60bd1051f698a13ed8314483556d136..c83a22dcbe01e2832a88fcd6b77be6f966aca326 100644
--- a/src/kosmickrisp/vulkan/tests/test_timeline_wait_loss.c
+++ b/src/kosmickrisp/vulkan/tests/test_timeline_wait_loss.c
@@ -3,6 +3,7 @@
 #define VK_NO_PROTOTYPES
 #include "kk_device.h"
 #include "kk_queue.h"
+#include "kk_sync.h"
 #include "vk_semaphore.h"
 #include "vk_sync.h"
 #include "util/os_time.h"
@@ -32,6 +33,23 @@ wait_idle(void *data)
    return NULL;
 }
 
+struct stalled_wait {
+   struct kk_device *dev;
+   struct vk_sync *sync;
+   uint64_t value;
+   uint64_t deadline;
+   VkResult result;
+};
+
+static void *
+wait_stalled(void *data)
+{
+   struct stalled_wait *wait = data;
+   wait->result = vk_sync_wait(&wait->dev->vk, wait->sync, wait->value,
+                               VK_SYNC_WAIT_COMPLETE, wait->deadline);
+   return NULL;
+}
+
 static void *
 finish_queue(void *data)
 {
@@ -46,9 +64,11 @@ main(int argc, char **argv)
    CHECK(argc == 2);
    bool idle = strcmp(argv[1], "idle") == 0;
    bool drain = strcmp(argv[1], "drain") == 0;
-   CHECK(idle || drain || strcmp(argv[1], "pending") == 0);
+   bool stall = strcmp(argv[1], "stall") == 0;
+   bool query = strcmp(argv[1], "query") == 0;
+   CHECK(idle || drain || stall || query || strcmp(argv[1], "pending") == 0);
    /* In particular, a failed worker join must not strand the test runner. */
-   alarm(10);
+   alarm(stall || query ? 60 : 10);
    VkInstance instance = VK_NULL_HANDLE;
    LOAD_I(vkCreateInstance);
    VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
@@ -87,6 +107,7 @@ main(int argc, char **argv)
    };
    VkPhysicalDeviceVulkan12Features features = {
       .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES,
+      .hostQueryReset = VK_TRUE,
       .timelineSemaphore = VK_TRUE,
    };
    VkDeviceCreateInfo device_info = {
@@ -104,6 +125,10 @@ main(int argc, char **argv)
    LOAD_D(vkSignalSemaphore);
    LOAD_D(vkQueueSubmit);
    LOAD_D(vkQueueWaitIdle);
+   LOAD_D(vkCreateQueryPool);
+   LOAD_D(vkDestroyQueryPool);
+   LOAD_D(vkResetQueryPool);
+   LOAD_D(vkGetQueryPoolResults);
    VkQueue queue = VK_NULL_HANDLE;
    vkGetDeviceQueue(device, family, 0, &queue);
    VkSemaphoreTypeCreateInfo type = {
@@ -137,6 +162,86 @@ main(int argc, char **argv)
    CHECK(vk_sync_wait(&dev->vk, sync, 1, VK_SYNC_WAIT_PENDING, 0) == VK_SUCCESS);
    CHECK(vk_sync_wait(&dev->vk, sync, 1, VK_SYNC_WAIT_COMPLETE, 0) == VK_SUCCESS);
 
+   if (stall) {
+      /* The queue has taken responsibility for values up to 3 and delivers
+       * none of them, while it reports no failure: it has stopped. Two
+       * waiters on different values of the stalled timeline share one clock,
+       * so the stopped-queue bound ends both waits well before their own
+       * deadline instead of each waiter restarting the other's clock. */
+      kk_timeline_mark_pending(sync, 3);
+      uint64_t start = os_time_get_nano();
+      struct stalled_wait waits[2] = {
+         {.dev = dev, .sync = sync, .value = 2,
+          .deadline = start + 50000000000ull},
+         {.dev = dev, .sync = sync, .value = 3,
+          .deadline = start + 50000000000ull},
+      };
+      pthread_t threads[2];
+      for (unsigned i = 0; i < 2; i++)
+         CHECK(pthread_create(&threads[i], NULL, wait_stalled, &waits[i]) == 0);
+      for (unsigned i = 0; i < 2; i++) {
+         CHECK(pthread_join(threads[i], NULL) == 0);
+         CHECK(waits[i].result == VK_ERROR_DEVICE_LOST);
+      }
+      /* The loss comes from the bound, not from a clock that raced. */
+      uint64_t elapsed = os_time_get_nano() - start;
+      CHECK(elapsed >= 30000000000ull);
+      CHECK(elapsed < 45000000000ull);
+      kk_queue_finish(dev, &dev->queue);
+      dev->has_queue = false;
+      vkDestroySemaphore(device, semaphore, NULL);
+      vkDestroyDevice(device, NULL);
+      vkDestroyInstance(instance, NULL);
+      alarm(0);
+      printf("stall: waiters on two values of a stopped timeline lost the device\n");
+      return 0;
+   }
+
+   if (query) {
+      /* A query no submission has made available, on a queue that holds one
+       * submission it never answers for and reports no failure: it has
+       * stopped, so the wait for the query loses the device at the
+       * stopped-queue bound rather than spinning forever. */
+      VkQueryPoolCreateInfo pool_info = {
+         .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+         .queryType = VK_QUERY_TYPE_OCCLUSION,
+         .queryCount = 1,
+      };
+      VkQueryPool pool = VK_NULL_HANDLE;
+      CHECK(vkCreateQueryPool(device, &pool_info, NULL, &pool) == VK_SUCCESS);
+      vkResetQueryPool(device, pool, 0, 1);
+      uint64_t result = 0;
+      CHECK(vkGetQueryPoolResults(device, pool, 0, 1, sizeof(result), &result,
+                                  sizeof(result), VK_QUERY_RESULT_64_BIT) ==
+            VK_NOT_READY);
+      struct kk_queue_feedback *feedback = dev->queue.feedback;
+      simple_mtx_lock(&feedback->signal_mutex);
+      feedback->last_serial++;
+      simple_mtx_unlock(&feedback->signal_mutex);
+      uint64_t start = os_time_get_nano();
+      CHECK(vkGetQueryPoolResults(device, pool, 0, 1, sizeof(result), &result,
+                                  sizeof(result),
+                                  VK_QUERY_RESULT_64_BIT |
+                                     VK_QUERY_RESULT_WAIT_BIT) ==
+            VK_ERROR_DEVICE_LOST);
+      uint64_t elapsed = os_time_get_nano() - start;
+      CHECK(vk_device_is_lost(&dev->vk));
+      CHECK(elapsed >= 30000000000ull);
+      CHECK(elapsed < 45000000000ull);
+      simple_mtx_lock(&feedback->signal_mutex);
+      feedback->last_serial--;
+      simple_mtx_unlock(&feedback->signal_mutex);
+      vkDestroyQueryPool(device, pool, NULL);
+      kk_queue_finish(dev, &dev->queue);
+      dev->has_queue = false;
+      vkDestroySemaphore(device, semaphore, NULL);
+      vkDestroyDevice(device, NULL);
+      vkDestroyInstance(instance, NULL);
+      alarm(0);
+      printf("query: a query wait on a stopped queue lost the device\n");
+      return 0;
+   }
+
    uint64_t value = 2;
    VkTimelineSemaphoreSubmitInfo timeline = {
       .sType = VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO,
