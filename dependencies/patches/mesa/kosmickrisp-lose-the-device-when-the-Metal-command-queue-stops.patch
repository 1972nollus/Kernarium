 6 files changed, 263 insertions(+), 27 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_query_pool.c b/src/kosmickrisp/vulkan/kk_query_pool.c
index 9253e654e1a111b490e3997f4033998263be0f14..d3db04dcc394d077a6cc9c70f8240a50d14c3542 100644
--- a/src/kosmickrisp/vulkan/kk_query_pool.c
+++ b/src/kosmickrisp/vulkan/kk_query_pool.c
@@ -555,9 +555,14 @@ kk_query_wait_for_available(struct kk_device *dev, struct kk_query_pool *pool,
    /* WAIT has no timeout of its own. The queue's native completion handler
     * reports an actual device failure; a slow submission must not manufacture
     * one. What it cannot report is a GPU write it destroyed, so a queue that
-    * has failed bounds the wait and a queue that has not waits as long as it
-    * takes. */
+    * has failed bounds the wait. Nor does a queue report that it stopped: one
+    * that has never failed and holds work it answers for none of loses the
+    * device after the bound a timeline wait gives it. A queue holding nothing
+    * waits as long as it takes, since the query may belong to work that has
+    * not been submitted yet. */
    uint64_t unavailable_since = 0u;
+   uint64_t stalled_since = 0u;
+   uint64_t stalled_reported = 0u;
 
    for (;;) {
       if (kk_query_is_available(dev, pool, query))
@@ -567,17 +572,47 @@ kk_query_wait_for_available(struct kk_device *dev, struct kk_query_pool *pool,
       if (status != VK_SUCCESS)
          return status;
 
-      if (dev->has_queue && kk_queue_has_failed(&dev->queue)) {
-         uint64_t now = os_time_get_nano();
-         if (unavailable_since == 0u) {
-            unavailable_since = now;
-         } else if (now - unavailable_since >= kk_lost_query_timeout_ns) {
+      if (dev->has_queue) {
+         const struct kk_queue_progress progress =
+            kk_queue_get_progress(&dev->queue);
+         const uint64_t now = os_time_get_nano();
+         if (progress.ever_failed) {
+            if (unavailable_since == 0u) {
+               unavailable_since = now;
+            } else if (now - unavailable_since >= kk_lost_query_timeout_ns) {
+               fprintf(stderr,
+                       "KosmicKrisp gave up on a query a failed Metal "
+                       "submission never made available after %" PRIu64
+                       " s, so its caller is not held forever\n",
+                       kk_lost_query_timeout_ns / 1000000000ull);
+               return VK_ERROR_DEVICE_LOST;
+            }
+         } else if (progress.unreported == 0u) {
+            stalled_since = 0u;
+         } else if (stalled_since == 0u ||
+                    progress.reported != stalled_reported) {
+            stalled_since = now;
+            stalled_reported = progress.reported;
+         } else if (now - stalled_since >= KK_STOPPED_QUEUE_TIMEOUT_NS) {
+            /* Say this on stderr as well as through the device, as the
+             * timeline wait does: the runtime's own report goes to the Mesa
+             * log, which this product leaves muted. */
             fprintf(stderr,
-                    "KosmicKrisp gave up on a query a failed Metal submission "
-                    "never made available after %" PRIu64
-                    " s, so its caller is not held forever\n",
-                    kk_lost_query_timeout_ns / 1000000000ull);
-            return VK_ERROR_DEVICE_LOST;
+                    "KosmicKrisp the Metal command queue stopped making "
+                    "progress: a query stayed unavailable for %" PRIu64
+                    " s while the queue answered for none of the %" PRIu64
+                    " submission(s) it holds and reported no failure. Losing "
+                    "the device\n",
+                    KK_STOPPED_QUEUE_TIMEOUT_NS / 1000000000ull,
+                    progress.unreported);
+            return vk_device_set_lost(
+               &dev->vk,
+               "the Metal command queue stopped making progress: a query "
+               "stayed unavailable for %" PRIu64
+               " s while the queue answered for none of the %" PRIu64
+               " submission(s) it holds and reported no failure",
+               KK_STOPPED_QUEUE_TIMEOUT_NS / 1000000000ull,
+               progress.unreported);
          }
       }
 
diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 20ab672850c64e19b844451e99c5bff21abcbde7..2567bb2ed8048de8165d10ab51359eff628f348f 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -78,18 +78,38 @@ kk_queue_signals_make_good(struct kk_queue_feedback *feedback,
    return made_good;
 }
 
-bool
-kk_queue_has_failed(struct kk_queue *queue)
+struct kk_queue_progress
+kk_queue_get_progress(struct kk_queue *queue)
 {
+   struct kk_queue_progress progress = {0};
    struct kk_queue_feedback *feedback = queue->feedback;
    if (!feedback)
+      return progress;
+
+   simple_mtx_lock(&feedback->signal_mutex);
+   progress.ever_failed = feedback->ever_failed;
+   progress.reported = feedback->reported;
+   progress.unreported = feedback->last_serial - feedback->reported;
+   simple_mtx_unlock(&feedback->signal_mutex);
+
+   return progress;
+}
+
+bool
+kk_queue_failure_outstanding(struct kk_queue *queue, uint64_t *unreported)
+{
+   struct kk_queue_feedback *feedback = queue->feedback;
+   if (!feedback) {
+      *unreported = 0u;
       return false;
+   }
 
    simple_mtx_lock(&feedback->signal_mutex);
-   bool failed = feedback->ever_failed;
+   bool outstanding = feedback->failures > 0u;
+   *unreported = feedback->last_serial - feedback->reported;
    simple_mtx_unlock(&feedback->signal_mutex);
 
-   return failed;
+   return outstanding;
 }
 
 /* Metal reports a failure against one submission, but the work it kills
diff --git a/src/kosmickrisp/vulkan/kk_queue.h b/src/kosmickrisp/vulkan/kk_queue.h
index 5e3f724b1cae465ef2512d0d120b9a7a299546a8..bc7df38ef14f814ce8163480cf2b0b17feb3e9d6 100644
--- a/src/kosmickrisp/vulkan/kk_queue.h
+++ b/src/kosmickrisp/vulkan/kk_queue.h
@@ -93,13 +93,52 @@ kk_queue_device(struct kk_queue *queue)
 uint64_t kk_queue_complete_owed_signals(struct kk_queue *queue,
                                         mtl_shared_event *event);
 
-/* Whether Metal has ever failed a submission on this queue.
+/* What a caller waiting to observe a GPU write directly in memory, rather
+ * than through a timeline, can learn about whether the write is still coming.
+ * Nothing names such a write, so the queue's history is all it has. */
+struct kk_queue_progress {
+   /* Whether Metal has ever failed a submission on this queue. A failure
+    * destroys the work the submission had not run, so waiting longer cannot
+    * produce a write it took. */
+   bool ever_failed;
+   /* How many submissions the queue has answered for, and how many it has
+    * taken and not answered for yet. A queue that has never failed and holds
+    * unanswered work without answering for any more of it has stopped. */
+   uint64_t reported;
+   uint64_t unreported;
+};
+
+/* All three read together, so they describe one moment of the queue. */
+struct kk_queue_progress kk_queue_get_progress(struct kk_queue *queue);
+
+/* Whether Metal has reported a failure this queue has not been retired for
+ * yet, and, through unreported, how many submissions it has taken and not
+ * answered for.
+ *
+ * The two together say what an undelivered signal means. A queue carrying a
+ * reported failure destroyed the signal, and completing it is the repair. A
+ * queue that has reported no failure destroyed nothing: it accepted the signal
+ * and then stopped, and unreported says how much work it is sitting on. */
+bool kk_queue_failure_outstanding(struct kk_queue *queue,
+                                  uint64_t *unreported);
+
+/* How long a queue that has reported no failure may hold work it does not
+ * answer for before a waiter on that work concludes the queue has stopped.
+ * Such a queue destroyed nothing; it stopped running work. Nothing restarts a
+ * Metal command queue and nothing else will notice: the queue reports nothing
+ * further, so the retirement that replaces a failed queue never triggers, and
+ * every waiter - on a timeline or a query here, in the renderer's per-ring
+ * sync thread, and through the guest protocol in another process - waits on it
+ * forever. That is device loss, and it is the disposition kk_queue_error.h
+ * already gives a queue that stops reporting.
  *
- * A failure destroys the work the submission had not run, including GPU writes
- * a caller is waiting to observe directly in memory rather than through a
- * timeline. Such a caller cannot be told the write is gone - nothing names it -
- * so it needs this to know that waiting longer cannot produce it. */
-bool kk_queue_has_failed(struct kk_queue *queue);
+ * Losing a device ends a workload, so this bound is three times the one for
+ * completing a signal a failure destroyed (see kk_sync.c): that repair
+ * completes one value and the queue carries on, while this one is final and
+ * must not be reached by a queue that is merely busy. Nothing else in the
+ * process is waiting on this queue by then either, because a KosmicKrisp
+ * device submits from one queue in order. */
+#define KK_STOPPED_QUEUE_TIMEOUT_NS (30ull * 1000000000ull)
 
 VkResult kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
                        const VkDeviceQueueCreateInfo *pCreateInfo,
diff --git a/src/kosmickrisp/vulkan/kk_sync.c b/src/kosmickrisp/vulkan/kk_sync.c
index 2d97c1969c9c6dac825ed8b1a758f2d9e772b34b..bcc8fad68c98e609d57130e35ad0837f02221c86 100644
--- a/src/kosmickrisp/vulkan/kk_sync.c
+++ b/src/kosmickrisp/vulkan/kk_sync.c
@@ -109,8 +109,7 @@ kk_timeline_get_value(struct vk_device *device, struct vk_sync *sync,
  *
  * The bound is two orders of magnitude over any submission that runs to
  * completion on the tightest device this driver targets, whose GPU stops a
- * command buffer after tens of milliseconds, and it costs nothing at all on a
- * queue that has never failed. */
+ * command buffer after tens of milliseconds. */
 static const uint64_t kk_lost_signal_timeout_ns = 10ull * 1000000000ull;
 
 static void
@@ -134,6 +133,11 @@ kk_timeline_recover_lost_signal(struct kk_device *dev,
     * waiter that arrives behind a stall inherits the time already spent in
     * it. A waiter whose value has arrived leaves it alone, because the
     * timeline standing still says nothing about that waiter. */
+   uint64_t unreported = 0u;
+   const bool failure_outstanding =
+      kk_queue_failure_outstanding(&dev->queue, &unreported);
+   const uint64_t bound = failure_outstanding ? kk_lost_signal_timeout_ns
+                                              : KK_STOPPED_QUEUE_TIMEOUT_NS;
    bool expired = false;
    simple_mtx_lock(&timeline->overdue_mutex);
    /* Read the time under the lock: another waiter may start the clock after
@@ -142,7 +146,7 @@ kk_timeline_recover_lost_signal(struct kk_device *dev,
    if (timeline->overdue_since == 0u || timeline->stalled_value != signaled) {
       timeline->stalled_value = signaled;
       timeline->overdue_since = now;
-   } else if (now - timeline->overdue_since >= kk_lost_signal_timeout_ns) {
+   } else if (now - timeline->overdue_since >= bound) {
       timeline->overdue_since = 0u;
       expired = true;
    }
@@ -150,6 +154,29 @@ kk_timeline_recover_lost_signal(struct kk_device *dev,
    if (!expired)
       return;
 
+   if (!failure_outstanding) {
+      /* Say this on stderr as well as through the device. Losing a device is
+       * the one disposition a run cannot recover from, and the runtime's own
+       * report goes to the Mesa log, which this product leaves muted. */
+      fprintf(stderr,
+              "KosmicKrisp the Metal command queue stopped making progress: "
+              "it accepted a timeline signal for value %" PRIu64
+              ", has not delivered it in %" PRIu64
+              " s, has reported no failure, and holds %" PRIu64
+              " submission(s) it has not answered for. Losing the device\n",
+              wait_value, KK_STOPPED_QUEUE_TIMEOUT_NS / 1000000000ull,
+              unreported);
+      vk_device_set_lost(
+         &dev->vk,
+         "the Metal command queue stopped making progress: it accepted a "
+         "timeline signal for value %" PRIu64
+         ", has not delivered it in %" PRIu64
+         " s, has reported no failure, and holds %" PRIu64
+         " submission(s) it has not answered for",
+         wait_value, KK_STOPPED_QUEUE_TIMEOUT_NS / 1000000000ull, unreported);
+      return;
+   }
+
    uint64_t completed =
       kk_queue_complete_owed_signals(&dev->queue, timeline->mtl_handle);
    if (completed) {
diff --git a/src/kosmickrisp/vulkan/meson.build b/src/kosmickrisp/vulkan/meson.build
