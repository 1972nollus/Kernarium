+++ b/src/kosmickrisp/compiler/msl_nir_lower_common.c
@@ -620,6 +620,75 @@ msl_nir_lower_cull_distance_fs(nir_shader *s, unsigned nr_distances)
    return nir_progress(true, b->impl, nir_metadata_control_flow);
 }
 
+/* Carry a varying narrower than 32 bits in a 32-bit slot.
+ *
+ * Metal has no way to name the halves of a component, and a "half" varying
+ * does not carry an arbitrary bit pattern: the raster interface does not
+ * preserve every half denormal or NaN payload, which a 16-bit integer varying
+ * needs it to, because nir_opt_varyings gives every varying a float type of
+ * its size to help vectorization and the backend then transports the integer
+ * as the bits of a half.  A 32-bit slot does preserve every pattern, and a
+ * 16-bit varying already occupies a whole 32-bit slot here, so widening the
+ * value costs no varying space and puts 16-bit input and output on the same
+ * path the 32-bit varyings have always used.
+ *
+ * Widening a float converts rather than reinterprets, which is exact in both
+ * directions and leaves interpolation to run at the higher precision Vulkan
+ * allows; widening an integer is the ordinary zero or sign extension.
+ */
+static bool
+widen_narrow_varying(nir_builder *b, nir_intrinsic_instr *intrin, void *data)
+{
+   const mesa_shader_stage stage = b->shader->info.stage;
+   nir_alu_type type;
+   nir_def *value;
+
+   switch (intrin->intrinsic) {
+   case nir_intrinsic_store_output:
+      /* A fragment shader's outputs are render targets, not varyings. */
+      if (stage == MESA_SHADER_FRAGMENT)
+         return false;
+      if (nir_src_bit_size(intrin->src[0]) >= 32u)
+         return false;
+      type = nir_intrinsic_src_type(intrin);
+      b->cursor = nir_before_instr(&intrin->instr);
+      value = nir_convert_to_bit_size(b, intrin->src[0].ssa,
+                                      nir_alu_type_get_base_type(type), 32u);
+      nir_src_rewrite(&intrin->src[0], value);
+      nir_intrinsic_set_src_type(intrin,
+                                 nir_alu_type_get_base_type(type) | 32u);
+      return true;
+
+   case nir_intrinsic_load_input:
+   case nir_intrinsic_load_interpolated_input:
+      /* A vertex shader's inputs are attributes, which Metal fetches in the
+       * vertex format's own width. */
+      if (stage == MESA_SHADER_VERTEX)
+         return false;
+      if (intrin->def.bit_size >= 32u)
+         return false;
+      type = nir_intrinsic_dest_type(intrin);
+      intrin->def.bit_size = 32u;
+      nir_intrinsic_set_dest_type(intrin,
+                                  nir_alu_type_get_base_type(type) | 32u);
+      b->cursor = nir_after_instr(&intrin->instr);
+      value = nir_convert_to_bit_size(b, &intrin->def,
+                                      nir_alu_type_get_base_type(type), 16u);
+      nir_def_rewrite_uses_after(&intrin->def, value);
+      return true;
+
+   default:
+      return false;
+   }
+}
+
+void
+msl_nir_lower_narrow_varyings(nir_shader *nir)
+{
+   NIR_PASS(_, nir, nir_shader_intrinsics_pass, widen_narrow_varying,
+            nir_metadata_control_flow, NULL);
+}
+
