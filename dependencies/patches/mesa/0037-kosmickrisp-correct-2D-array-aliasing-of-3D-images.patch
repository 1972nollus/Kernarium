       mtl_texture *mtl_handle = image->planes[image_plane].mtl_handle;
       if (image->vk.image_type == VK_IMAGE_TYPE_3D &&
-          view->vk.view_type != VK_IMAGE_VIEW_TYPE_3D)
+          view->vk.view_type != VK_IMAGE_VIEW_TYPE_3D) {
