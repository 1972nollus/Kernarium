@@ -140,10 +140,24 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
             view_layout.swizzle.alpha = PIPE_SWIZZLE_0;
       }
 
+      /* Metal cannot view a 3D texture as a 2D array, so a non 3D view of a
