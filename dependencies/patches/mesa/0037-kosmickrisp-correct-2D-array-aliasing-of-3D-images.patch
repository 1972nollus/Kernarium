diff --git a/src/kosmickrisp/vulkan/kk_image_layout.h b/src/kosmickrisp/vulkan/kk_image_layout.h
index b49c188b..6b936653 100644
--- a/src/kosmickrisp/vulkan/kk_image_layout.h
+++ b/src/kosmickrisp/vulkan/kk_image_layout.h
@@ -12,6 +12,7 @@
 
 #include "util/format/u_formats.h"
 
+#include "util/bitscan.h"
 #include "util/format/u_format.h"
 #include "vk_image.h"
 
@@ -180,6 +181,20 @@ kk_image_layout_level_offsets_defined(const struct kk_image_layout *layout)
    return true;
 }
 
+/**
+ * Number of mip levels the auxiliary 2D array texture that aliases a 3D image
+ * can describe. Metal bounds a 2D array texture's mip count with its width and
+ * height, while a 3D texture's bound also considers its depth, so an image
+ * deeper than it is wide carries levels the alias has no room for.
+ */
+static inline uint8_t
+kk_image_layout_array_alias_levels(const struct kk_image_layout *layout)
+{
+   const uint32_t max_dim = MAX2(layout->width_px, layout->height_px);
+   const uint8_t alias_levels = util_logbase2(max_dim) + 1u;
+   return MIN2(layout->levels, alias_levels);
+}
+
 static inline uint32_t
 kk_get_layer_offset_B(const struct kk_image_layout *layout, unsigned z_px)
 {
