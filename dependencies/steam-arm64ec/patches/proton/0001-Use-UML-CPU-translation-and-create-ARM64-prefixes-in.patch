From d329b85765df877e98ec4c529673f8bf7baba81e Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 7 Sep 2026 16:43:38 +0900
Subject: [PATCH 1/2] Use UML CPU translation and create ARM64 prefixes in the
 guest

---
 Makefile.in            | 49 +++---------------------------------------
 proton                 | 36 ++++++++++++++++++-------------
 toolmanifest_arm64.vdf |  2 +-
 3 files changed, 25 insertions(+), 62 deletions(-)

diff --git a/Makefile.in b/Makefile.in
index 5e477c7..4b06622 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -844,51 +844,7 @@ $(OBJ)/.vkd3d-proton-post-source:
 	touch $@
 
 
-##
-## FEX
-##
-
-ifneq ($(findstring aarch64,$(unix_ARCHS)),)
-FEX_COMMON_CMAKE_ARGS = \
-  -DENABLE_FEXCORE_PROFILER=True -DCMAKE_BUILD_TYPE=Release -DENABLE_LTO=False \
-  -DBUILD_TESTING=False -DTUNE_CPU=none -DRANGES_NATIVE=OFF \
-  -DOVERRIDE_VERSION=$$(cat $(FEX_SRC)/.git_describe) \
-  -DOVERRIDE_HASH=$$(cat $(FEX_SRC)/.git_rev)
-
-FEX_CMAKE_ARGS = $(FEX_COMMON_CMAKE_ARGS) \
-  -DCMAKE_TOOLCHAIN_FILE=$(FEX_SRC)/Data/CMake/toolchain_mingw.cmake \
-
-FEX_aarch64_CMAKE_ARGS = -DMINGW_TRIPLE=aarch64-w64-mingw32 -DCMAKE_INSTALL_LIBDIR=$(FEX_aarch64_DST)/lib/wine/aarch64-windows
-FEX_arm64ec_CMAKE_ARGS = -DMINGW_TRIPLE=arm64ec-w64-mingw32 -DCMAKE_INSTALL_LIBDIR=$(FEX_arm64ec_DST)/lib/wine/aarch64-windows
-
-$(eval $(call rules-source,fex,$(SRCDIR)/FEX))
-$(eval $(call rules-cmake,fex,aarch64,windows))
-$(eval $(call rules-cmake,fex,arm64ec,windows))
-
-$(OBJ)/.fex-post-source:
-	git -C $(SRCDIR)/FEX describe --abbrev=7 > $(FEX_SRC)/.git_describe
-	git -C $(SRCDIR)/FEX rev-parse --short=7 HEAD > $(FEX_SRC)/.git_rev
-	touch $@
-
-FEX_UNIXLIB_CMAKE_ARGS = $(FEX_COMMON_CMAKE_ARGS)
-
-FEX_UNIXLIB_aarch64_CMAKE_ARGS = -DCMAKE_INSTALL_LIBDIR=$(FEX_UNIXLIB_aarch64_DST)/lib/wine/aarch64-unix
-
-$(eval $(call rules-source,fex_unixlib,$(SRCDIR)/FEX/Source/Windows/UnixLib))
-$(eval $(call rules-cmake,fex_unixlib,aarch64,unix))
-
-$(OBJ)/.fex_unixlib-post-source:
-	git -C $(SRCDIR)/FEX describe --abbrev=7 > $(FEX_UNIXLIB_SRC)/.git_describe
-	git -C $(SRCDIR)/FEX rev-parse --short=7 HEAD > $(FEX_UNIXLIB_SRC)/.git_rev
-	touch $@
-
-FEX_CONFIG_JSON := $(DST_DIR)/share/fex-emu/Config.json
-$(FEX_CONFIG_JSON): $(SRCDIR)/FEX_Config.json
-	mkdir -p $(dir $@)
-	cp -a $< $@
-
-default_pfx: fex $(FEX_CONFIG_JSON)
-endif
+# ARM64 CPU translation is provided by the UML host through Wine xtajit.
 
 
 ##
@@ -1349,7 +1305,8 @@ ifneq ($(findstring x86_64,$(unix_ARCHS)),)
 	python3 $(SRCDIR)/default_pfx.py $(abspath $(DIST_PREFIX)) $(abspath $(DST_DIR)) 0
 endif
 ifneq ($(findstring aarch64,$(unix_ARCHS)),)
-	python3 $(SRCDIR)/default_pfx.py $(abspath $(DIST_PREFIX_ARM64)) $(abspath $(DST_DIR)) 1
+	# The emulator bridge cannot run on the build host. Proton creates this
+	# prefix lazily on its first guest launch, using make_default_prefix().
 endif
 
 all-dist: default_pfx
diff --git a/proton b/proton
index 2463695..cf597fb 100755
--- a/proton
+++ b/proton
@@ -591,18 +591,32 @@ class Proton:
                             f.write(new_fixup_mtime + "\n")
 
     def missing_default_prefix(self):
-        '''Check if the default prefix dir is missing. Returns true if missing, false if present'''
+        if self.host_pe_arch == "aarch64-windows":
+            return not os.path.isfile(os.path.join(self.default_pfx_dir, ".uml-template-ready"))
         return not os.path.isdir(self.default_pfx_dir)
 
+    def initialize_guest_prefix(self, prefix):
+        # A cancelled Steam probe may leave wineboot running after its parent exits.
+        # Finish that work before forcing an update of every supported architecture.
+        local_env = dict(g_session.env)
+        local_env["WINEPREFIX"] = os.path.realpath(prefix)
+        local_env["WINEDEBUG"] = "-all"
+        commands = []
+        if os.path.isdir(local_env["WINEPREFIX"]):
+            commands.append([self.wineserver_bin, "-w"])
+        commands += [[self.wine_bin, "wineboot", "-u"], [self.wineserver_bin, "-w"]]
+        for command in commands:
+            subprocess.run(command, env=local_env, stderr=g_session.log_file,
+                           stdout=g_session.log_file, check=True, timeout=300)
+
     def make_default_prefix(self):
         with self.dist_lock:
-            local_env = dict(g_session.env)
             if self.missing_default_prefix():
-                #make default prefix
-                local_env["WINEPREFIX"] = self.default_pfx_dir
-                local_env["WINEDEBUG"] = "-all"
-                g_session.run_proc([self.wine_bin, "wineboot"], local_env)
-                g_session.run_proc([self.wineserver_bin, "-w"], local_env)
+                self.initialize_guest_prefix(self.default_pfx_dir)
+                # Publish only after Wine has flushed the complete registry to disk.
+                if self.host_pe_arch == "aarch64-windows":
+                    with open(os.path.join(self.default_pfx_dir, ".uml-template-ready"), "w"):
+                        pass
 
 class CompatData:
     def __init__(self, compatdata):
@@ -2038,14 +2052,6 @@ class Session:
                 # https://github.com/microsoft/mimalloc/issues/958
                 self.env["MIMALLOC_DISABLE_REDIRECT"] = "1"
 
-            if not 'FEX_APP_CONFIG' in self.env:
-                # custom per-app config driven by Steam env vars
-                app_config = self.generate_fex_app_config()
-                with open(g_compatdata.fex_config_file, 'w') as f:
-                    f.write(json.dumps(app_config, indent=2))
-                self.env['FEX_APP_CONFIG'] = g_compatdata.fex_config_file
-
-            self.env["FEX_APP_CONFIG_LOCATION"] = os.path.join(g_proton.dist_dir, "share/fex-emu/")
 
     def run_proc(self, args, local_env=None):
         if local_env is None:
