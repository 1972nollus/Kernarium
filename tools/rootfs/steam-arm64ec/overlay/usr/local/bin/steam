#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -eu
steam=${HOME:?}/.local/share/Steam
export LD_LIBRARY_PATH="$steam/steamrtarm64:$steam/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# See kernarium-webhelper/taskset: the client's web-helper launcher turns
# Mesa's Vulkan window system off, and this is the only hook it offers.
export PATH="/usr/local/libexec/kernarium-webhelper:$PATH"
python3 -B /usr/local/libexec/kernarium-compat.py
exec "$steam/steamrtarm64/steam" "$@"
