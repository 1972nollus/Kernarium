From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 1 Nov 2026 06:19:41 +0900
Subject: [PATCH] venus: observe device memory allocation results

vkAllocateMemory was asynchronous: the driver reported VK_SUCCESS before
the renderer had run the command. A host that bounds the device memory
it gives a guest refuses an allocation past that bound, and the refusal
had nowhere to go. The renderer never created the memory, so the first
command naming it (a bind, a map or the free) made the ring fatal and
the process aborted, after its fence waits had run into the host's
overdue-fence escape.

Always use the synchronous call, as for pipeline creation, so that the
application receives VK_ERROR_OUT_OF_DEVICE_MEMORY and the handle is
released locally. The renderer has then made the memory before any later
command or blob creation names it, so the ring-seqno wait those paths
needed goes with the asynchronous path. This costs one round trip per
allocation. VN_PERF=no_async_mem_alloc stays accepted and does nothing.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/virtio/vulkan/vn_device_memory.c | 69 ++++------------------------
 src/virtio/vulkan/vn_device_memory.h | 15 ------
 2 files changed, 10 insertions(+), 74 deletions(-)

diff --git a/src/virtio/vulkan/vn_device_memory.c b/src/virtio/vulkan/vn_device_memory.c
index db16eff7462f6c32905e4a3e32dc32fb21b63271..5e286a7e7ddacc4a6e507a3cc217f0708bdb190b 100644
--- a/src/virtio/vulkan/vn_device_memory.c
+++ b/src/virtio/vulkan/vn_device_memory.c
@@ -24,6 +24,13 @@
 
 /* device memory commands */
 
+/* The renderer may refuse an allocation the host cannot hold, and Vulkan has
+ * no way to fail one that has already been reported as made: a memory the
+ * guest believes exists and the renderer never created makes the first
+ * command that names it fatal to the whole ring. Wait for the renderer's
+ * answer instead, so that VK_ERROR_OUT_OF_DEVICE_MEMORY reaches the caller.
+ * This costs one round trip per allocation.
+ */
 static inline VkResult
 vn_device_memory_alloc_simple(struct vn_device *dev,
                               struct vn_device_memory *mem,
@@ -31,20 +38,8 @@ vn_device_memory_alloc_simple(struct vn_device *dev,
 {
    VkDevice dev_handle = vn_device_to_handle(dev);
    VkDeviceMemory mem_handle = vn_device_memory_to_handle(mem);
-   if (VN_PERF(NO_ASYNC_MEM_ALLOC)) {
-      return vn_call_vkAllocateMemory(dev->primary_ring, dev_handle,
-                                      alloc_info, NULL, &mem_handle);
-   }
-
-   struct vn_ring_submit_command ring_submit;
-   vn_submit_vkAllocateMemory(dev->primary_ring, 0, dev_handle, alloc_info,
-                              NULL, &mem_handle, &ring_submit);
-   if (!ring_submit.ring_seqno_valid)
-      return VK_ERROR_OUT_OF_HOST_MEMORY;
-
-   mem->bo_ring_seqno_valid = true;
-   mem->bo_ring_seqno = ring_submit.ring_seqno;
-   return VK_SUCCESS;
+   return vn_call_vkAllocateMemory(dev->primary_ring, dev_handle, alloc_info,
+                                   NULL, &mem_handle);
 }
 
 static inline void
@@ -56,47 +51,14 @@ vn_device_memory_free_simple(struct vn_device *dev,
    vn_async_vkFreeMemory(dev->primary_ring, dev_handle, mem_handle, NULL);
 }
 
-static bool
-vn_device_memory_needs_wait_alloc(struct vn_device *dev,
-                                  struct vn_device_memory *mem)
-{
-   if (!mem->bo_ring_seqno_valid)
-      return false;
-
-   /* fine to false it here since renderer submission failure is fatal */
-   mem->bo_ring_seqno_valid = false;
-
-   /* no need to wait for ring if
-    * - mem alloc is done upon bo map or export
-    * - mem import is done upon bo destroy
-    */
-   return !vn_ring_get_seqno_status(dev->primary_ring, mem->bo_ring_seqno);
-}
-
 static inline VkResult
 vn_device_memory_bo_init(struct vn_device *dev, struct vn_device_memory *mem)
 {
-   struct vn_renderer_submit_batch *batch = NULL;
-   struct vn_renderer_submit_batch local_batch;
-   uint32_t local_data[8];
-   if (vn_device_memory_needs_wait_alloc(dev, mem)) {
-      struct vn_cs_encoder local_enc =
-         VN_CS_ENCODER_INITIALIZER_LOCAL(local_data, sizeof(local_data));
-      vn_encode_vkWaitRingSeqnoMESA(&local_enc, 0,
-                                    vn_ring_get_id(dev->primary_ring),
-                                    mem->bo_ring_seqno);
-      local_batch = (struct vn_renderer_submit_batch){
-         .cs_data = local_data,
-         .cs_size = vn_cs_encoder_get_len(&local_enc),
-      };
-      batch = &local_batch;
-   }
-
    const struct vk_device_memory *mem_vk = &mem->base.vk;
    const VkMemoryType *mem_type = &dev->physical_device->memory_properties
                                       .memoryTypes[mem_vk->memory_type_index];
    return vn_renderer_bo_create_from_device_memory(
-      dev->renderer, batch, mem_vk->size, mem->base.id,
+      dev->renderer, NULL, mem_vk->size, mem->base.id,
       mem_type->propertyFlags, mem_vk->export_handle_types, &mem->base_bo);
 }
 
@@ -106,17 +68,6 @@ vn_device_memory_bo_fini(struct vn_device *dev, struct vn_device_memory *mem)
    if (!mem->base_bo)
       return;
 
-   if (vn_device_memory_needs_wait_alloc(dev, mem)) {
-      uint32_t local_data[8];
-      struct vn_cs_encoder local_enc =
-         VN_CS_ENCODER_INITIALIZER_LOCAL(local_data, sizeof(local_data));
-      vn_encode_vkWaitRingSeqnoMESA(&local_enc, 0,
-                                    vn_ring_get_id(dev->primary_ring),
-                                    mem->bo_ring_seqno);
-      vn_renderer_submit_simple(dev->renderer, local_data,
-                                vn_cs_encoder_get_len(&local_enc));
-   }
-
    vn_renderer_bo_unref(dev->renderer, mem->base_bo);
 }
 
diff --git a/src/virtio/vulkan/vn_device_memory.h b/src/virtio/vulkan/vn_device_memory.h
index d2b74b297febb823c988545eb4532278cb1a9ce1..1fe57e8553eec2c61abc5c004ba1b34b0ba5ef2a 100644
--- a/src/virtio/vulkan/vn_device_memory.h
+++ b/src/virtio/vulkan/vn_device_memory.h
@@ -19,21 +19,6 @@ struct vn_device_memory {
    /* non-NULL when mappable or external */
    struct vn_renderer_bo *base_bo;
 
-   /* ensure renderer side resource create is called after vkAllocateMemory
-    *
-    * 1. driver submits vkAllocateMemory (alloc) via ring for a ring seqno
-    * 2. driver submits via vq to wait for above ring to reach the seqno
-    * 3. driver creates virtgpu bo from renderer VkDeviceMemory
-    *
-    * ensure renderer side resource destroy is called after vkAllocateMemory
-    *
-    * 1. driver submits vkAllocateMemory (import) via ring for a ring seqno
-    * 2. driver submits via vq to wait for above ring to reach the seqno
-    * 3. driver destroys virtgpu bo
-    */
-   bool bo_ring_seqno_valid;
-   uint32_t bo_ring_seqno;
-
    /* ensure renderer side vkFreeMemory is called after vkGetMemoryFdKHR
     *
     * 1. driver creates virtgpu bo from renderer VkDeviceMemory
