+
+static inline uint32_t
+zink_dmabuf_queue_family(const struct zink_screen *screen)
+{
+   return screen->info.have_EXT_queue_family_foreign
+             ? VK_QUEUE_FAMILY_FOREIGN_EXT
+             : VK_QUEUE_FAMILY_EXTERNAL;
+}
