+
+int
+main(void)
+{
+   const VkImageCreateInfo base = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = VK_FORMAT_B8G8R8A8_UNORM,
+      .extent = {400, 300, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+   };
+   VkImageCreateInfo info = base;
+   uint32_t pitch = 0;
+   CHECK(vn_wsi_native_heap_row_pitch(&info, 573440, &pitch));
+   CHECK(pitch == 1600);
+   CHECK(vn_wsi_native_heap_row_pitch(&info, 480000, &pitch));
+   CHECK(!vn_wsi_native_heap_row_pitch(&info, 479999, &pitch));
+   CHECK(!vn_wsi_native_heap_row_pitch(&info, 0, &pitch));
+   CHECK(!vn_wsi_native_heap_row_pitch(&info, (uint64_t)UINT32_MAX + 1, &pitch));
+
+   static const struct {
+      VkFormat format;
+      uint32_t bytes_per_pixel;
+   } formats[] = {
+      {VK_FORMAT_R5G6B5_UNORM_PACK16, 2},
+      {VK_FORMAT_B5G6R5_UNORM_PACK16, 2},
+      {VK_FORMAT_R8G8B8A8_UNORM, 4},
+      {VK_FORMAT_R8G8B8A8_SRGB, 4},
+      {VK_FORMAT_B8G8R8A8_UNORM, 4},
+      {VK_FORMAT_B8G8R8A8_SRGB, 4},
+      {VK_FORMAT_A8B8G8R8_UNORM_PACK32, 4},
+      {VK_FORMAT_A8B8G8R8_SRGB_PACK32, 4},
+      {VK_FORMAT_A2R10G10B10_UNORM_PACK32, 4},
+      {VK_FORMAT_A2B10G10R10_UNORM_PACK32, 4},
+      {VK_FORMAT_R16G16B16A16_UNORM, 8},
+      {VK_FORMAT_R16G16B16A16_SFLOAT, 8},
+   };
+   for (unsigned i = 0; i < sizeof(formats) / sizeof(formats[0]); i++) {
+      info = base;
+      info.format = formats[i].format;
+      CHECK(vn_wsi_native_heap_row_pitch(&info, 400 * 300 * 8, &pitch));
+      CHECK(pitch == 400 * formats[i].bytes_per_pixel);
+      info.extent = (VkExtent3D){UINT16_MAX / formats[i].bytes_per_pixel,
+                                UINT16_MAX, 1};
+      CHECK(vn_wsi_native_heap_row_pitch(&info, UINT32_MAX, &pitch));
+      CHECK(pitch == info.extent.width * formats[i].bytes_per_pixel);
+      /* A row that no longer fits sixteen bits still has an envelope: only
+       * the legacy DRI3 v1.0 pixmap request is that narrow, and refusing the
+       * image would fail vkCreateSwapchainKHR on every window system.
+       */
+      info.extent.width++;
+      CHECK(vn_wsi_native_heap_row_pitch(&info, UINT32_MAX, &pitch));
+      CHECK(pitch == info.extent.width * formats[i].bytes_per_pixel);
+      CHECK(pitch > UINT16_MAX);
+      /* The allocation still has to cover that wider envelope. */
+      CHECK(!vn_wsi_native_heap_row_pitch(&info, (uint64_t)pitch *
+                                                       info.extent.height - 1,
+                                          &pitch));
+   }
+
+   /* A wide image still has an envelope, whatever the renderer can back. */
+   info = base;
+   info.format = VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+   info.extent = (VkExtent3D){16384, 16384, 1};
+   CHECK(vn_wsi_native_heap_row_pitch(&info, 16384ull * 16384u * 4u, &pitch));
+   CHECK(pitch == 16384 * 4);
+
+   /* The budget is what the surface advertises, and it must not be exceeded
+    * by an image at that advertised extent in any envelope format.
+    */
+   CHECK(!vn_wsi_native_image_within_budget(&info, 16384ull * 16384u * 4u));
+   for (unsigned i = 0; i < sizeof(formats) / sizeof(formats[0]); i++) {
+      info = base;
+      info.format = formats[i].format;
+      info.extent = (VkExtent3D){VN_WSI_NATIVE_MAX_IMAGE_DIMENSION,
+                                 VN_WSI_NATIVE_MAX_IMAGE_DIMENSION, 1};
+      const uint64_t size = (uint64_t)info.extent.width *
+                            info.extent.height * formats[i].bytes_per_pixel;
+      CHECK(size <= VN_WSI_NATIVE_MAX_IMAGE_SIZE);
+      CHECK(vn_wsi_native_image_within_budget(&info, size));
+      CHECK(vn_wsi_native_heap_row_pitch(&info, size, &pitch));
+      CHECK(pitch == info.extent.width * formats[i].bytes_per_pixel);
+      /* Padding the renderer adds on top of that envelope still fits. */
+      CHECK(vn_wsi_native_image_within_budget(&info, size + size / 4));
+   }
+
+   /* Each bound of the budget is refused on its own. */
+   info = base;
+   info.extent = (VkExtent3D){VN_WSI_NATIVE_MAX_IMAGE_DIMENSION,
+                              VN_WSI_NATIVE_MAX_IMAGE_DIMENSION, 1};
+   CHECK(vn_wsi_native_image_within_budget(&info,
+                                           VN_WSI_NATIVE_MAX_IMAGE_SIZE));
+   CHECK(!vn_wsi_native_image_within_budget(&info,
+                                            VN_WSI_NATIVE_MAX_IMAGE_SIZE + 1));
+   info.extent.width++;
+   CHECK(!vn_wsi_native_image_within_budget(&info, 4096));
+   info.extent.width--;
+   info.extent.height++;
+   CHECK(!vn_wsi_native_image_within_budget(&info, 4096));
+
+   /* The budget stays inside the renderer's one-gibibyte blob window. */
+   CHECK(VN_WSI_NATIVE_MAX_IMAGE_SIZE < 1024ull * 1024ull * 1024ull);
+   CHECK((uint64_t)VN_WSI_NATIVE_MAX_IMAGE_DIMENSION *
+            VN_WSI_NATIVE_MAX_IMAGE_DIMENSION * 8u <=
+         VN_WSI_NATIVE_MAX_IMAGE_SIZE);
+
+   static const VkFormat excluded[] = {
+      VK_FORMAT_UNDEFINED, VK_FORMAT_D32_SFLOAT, VK_FORMAT_BC1_RGBA_UNORM_BLOCK,
+      VK_FORMAT_G8_B8R8_2PLANE_420_UNORM, VK_FORMAT_R8G8B8_UNORM,
+   };
+   for (unsigned i = 0; i < sizeof(excluded) / sizeof(excluded[0]); i++) {
+      info = base;
+      info.format = excluded[i];
+      pitch = 0x12345678;
+      CHECK(!vn_wsi_native_heap_row_pitch(&info, UINT32_MAX, &pitch));
+      CHECK(pitch == 0x12345678);
+   }
+
+#define EXCLUDE(field, value)                                                 \
+   do {                                                                      \
+      info = base;                                                           \
+      info.field = value;                                                    \
+      CHECK(!vn_wsi_native_heap_row_pitch(&info, UINT32_MAX, &pitch));          \
+   } while (0)
+   EXCLUDE(imageType, VK_IMAGE_TYPE_1D);
+   EXCLUDE(imageType, VK_IMAGE_TYPE_3D);
+   EXCLUDE(tiling, VK_IMAGE_TILING_LINEAR);
+   EXCLUDE(tiling, VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT);
+   EXCLUDE(extent.width, 0);
+   EXCLUDE(extent.width, UINT32_MAX);
+   EXCLUDE(extent.height, 0);
+   EXCLUDE(extent.height, UINT16_MAX + 1);
+   EXCLUDE(extent.depth, 2);
+   EXCLUDE(mipLevels, 2);
+   EXCLUDE(arrayLayers, 2);
+   EXCLUDE(samples, VK_SAMPLE_COUNT_4_BIT);
+   EXCLUDE(flags, VK_IMAGE_CREATE_DISJOINT_BIT);
+   EXCLUDE(flags, VK_IMAGE_CREATE_SPARSE_BINDING_BIT);
+   EXCLUDE(flags, VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT);
+   EXCLUDE(flags, VK_IMAGE_CREATE_SPARSE_ALIASED_BIT);
+#undef EXCLUDE
+   /* Modifiers replace the native scanout path, so they are offered only
+    * where the renderer has no native heap to share.
+    */
+   CHECK(vn_wsi_native_offers_modifiers(true, false));
+   CHECK(!vn_wsi_native_offers_modifiers(true, true));
+   CHECK(!vn_wsi_native_offers_modifiers(false, false));
+   CHECK(!vn_wsi_native_offers_modifiers(false, true));
+
+   puts("Venus WSI native-heap envelope tests passed");
+   return 0;
+}
