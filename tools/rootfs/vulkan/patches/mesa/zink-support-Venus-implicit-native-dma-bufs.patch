+static inline bool
+zink_use_venus_implicit_dmabuf(const struct zink_screen *screen)
+{
+   return zink_driver_is_venus(screen) &&
+          screen->info.have_KHR_external_memory_fd &&
+          screen->info.have_EXT_external_memory_dma_buf &&
+          !screen->info.have_EXT_image_drm_format_modifier;
