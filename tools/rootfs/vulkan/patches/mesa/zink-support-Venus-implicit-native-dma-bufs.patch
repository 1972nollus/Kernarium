+static bool
+use_venus_implicit_dmabuf(struct zink_screen *screen,
+                          const struct pipe_resource *templ,
+                          const struct winsys_handle *whandle)
+{
+   if (!zink_use_venus_implicit_dmabuf(screen) ||
+       templ->target == PIPE_BUFFER)
+      return false;
+
+   if (whandle)
+      return whandle->type == WINSYS_HANDLE_TYPE_FD &&
+             whandle->modifier == DRM_FORMAT_MOD_INVALID;
+
+   return templ->bind & PIPE_BIND_SHARED;
+}
