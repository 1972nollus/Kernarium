 src/virtio/vulkan/meson.build                 | 7 +++++++
 src/virtio/vulkan/vn_acceleration_structure.c | 2 +-
 src/virtio/vulkan/vn_buffer.c                 | 4 ++--
 src/virtio/vulkan/vn_command_buffer.c         | 4 ++--
 src/virtio/vulkan/vn_common.c                 | 2 +-
 src/virtio/vulkan/vn_cs.h                     | 2 +-
 src/virtio/vulkan/vn_descriptor_heap.c        | 2 +-
 src/virtio/vulkan/vn_descriptor_set.c         | 8 ++++----
 src/virtio/vulkan/vn_device.c                 | 2 +-
 src/virtio/vulkan/vn_device_memory.c          | 4 ++--
 src/virtio/vulkan/vn_host_copy.c              | 2 +-
 src/virtio/vulkan/vn_image.c                  | 8 ++++----
 src/virtio/vulkan/vn_instance.c               | 6 +++---
 src/virtio/vulkan/vn_physical_device.c        | 2 +-
 src/virtio/vulkan/vn_pipeline.c               | 8 ++++----
 src/virtio/vulkan/vn_query_pool.c             | 2 +-
 src/virtio/vulkan/vn_queue.c                  | 4 ++--
 src/virtio/vulkan/vn_render_pass.c            | 4 ++--
 src/virtio/vulkan/vn_ring.c                   | 2 +-
 src/virtio/vulkan/vn_sync.c                   | 8 ++++----
 21 files changed, 52 insertions(+), 38 deletions(-)

diff --git a/meson.options b/meson.options
index 93a60e3..92dfd10 100644
--- a/meson.options
+++ b/meson.options
@@ -202,6 +202,13 @@ option(
   description : 'Location of D3D drivers. Default: $libdir/d3d',
 )
 
+option(
+  'venus-protocol-dir',
+  type : 'string',
+  value : '',
+  description : 'Absolute build directory containing the paired generated Venus driver headers',
+)
+
 option(
   'vulkan-drivers',
   type : 'array',
diff --git a/src/virtio/vulkan/meson.build b/src/virtio/vulkan/meson.build
index df85f0a..507d0b3 100644
--- a/src/virtio/vulkan/meson.build
+++ b/src/virtio/vulkan/meson.build
@@ -92,7 +92,14 @@ libvn_files = files(
   'vn_sync.c',
 )
 
+vn_protocol_dir = get_option('venus-protocol-dir')
+if not fs.is_absolute(vn_protocol_dir) or not fs.is_file(
+    vn_protocol_dir / 'vn_protocol_driver.h')
+  error('Virtio requires -Dvenus-protocol-dir pointing to the paired generated driver headers')
+endif
+
 vn_incs = [
+  include_directories(vn_protocol_dir),
   inc_include,
   inc_src,
   inc_virtio,
