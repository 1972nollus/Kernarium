From 481916374c9d5b746370e191ba18cc655d86e949 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 4 Sep 2026 00:21:56 +0900
Subject: [PATCH 04/24] venus: preserve renderer conformance version

The hard-coded 1.4.0.0 value is not a published conformance version recognized by Vulkan CTS 1.4.6.2, so the driver-properties self-test fails even when every functional case in the fraction passes.

The renderer properties already carry the backend conformance version. Keep that value instead of replacing it with a Venus-wide constant, allowing the reported version to track the actual renderer used by this transport.
---
 src/virtio/vulkan/vn_physical_device.c | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/src/virtio/vulkan/vn_physical_device.c b/src/virtio/vulkan/vn_physical_device.c
index f3581aa..77898b7 100644
--- a/src/virtio/vulkan/vn_physical_device.c
+++ b/src/virtio/vulkan/vn_physical_device.c
@@ -569,11 +569,6 @@ vn_physical_device_sanitize_properties(struct vn_physical_device *physical_dev)
    snprintf(props->driverInfo, sizeof(props->driverInfo),
             "Mesa " PACKAGE_VERSION MESA_GIT_SHA1);
 
-   props->conformanceVersion.major = 1;
-   props->conformanceVersion.minor = 4;
-   props->conformanceVersion.subminor = 0;
-   props->conformanceVersion.patch = 0;
-
    vn_physical_device_init_uuids(physical_dev);
 }
 
