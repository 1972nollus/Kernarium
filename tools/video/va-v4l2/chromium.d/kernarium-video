# Debian's /usr/bin/chromium sources every file in this directory. This one
# points Chromium's VA-API at the Virtio video driver (uml_drv_video.so).
# ../README.md owns the contract.

# libva maps the virtio_gpu DRM driver to Mesa's driver, which has nothing to
# offer here; naming ours scopes the choice to Chromium.
export LIBVA_DRIVER_NAME=uml
# The guest's render node is not a PCI device, so Chromium finds none unless it
# is told. Without a render node VA-API stays off.
CHROMIUM_FLAGS="$CHROMIUM_FLAGS --render-node-override=/dev/dri/renderD128"

# Chromium's own VA-API encode is opt-in. It encodes frames that live in GPU
# memory, which the guest's Mesa gbm cannot allocate as NV12 and whose
# GPU-written pixels the guest CPU cannot read; ../README.md owns the
# limitation. Set KERNARIUM_CHROMIUM_VIDEO_ENCODE=1 to turn the feature on.
if [ "${KERNARIUM_CHROMIUM_VIDEO_ENCODE:-}" = 1 ]; then
	CHROMIUM_FLAGS="$CHROMIUM_FLAGS --enable-features=AcceleratedVideoEncoder,ChromeOSHWVBREncoding"
fi
