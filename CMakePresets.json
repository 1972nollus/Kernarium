  "configurePresets": [
    {
      "name": "macos-unit-16k",
      "displayName": "macOS host unit tests (16 KiB)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/Apple.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UML_APPLE_PLATFORM": "macos",
        "UML_BUILD_CLI": false,
        "UML_BUILD_KERNEL_RUNNER": false,
        "UML_BUILD_NETWORK_PROVIDER": false,
        "UML_BUILD_GPU": false,
        "UML_BUILD_UNIT_TESTS": true,
        "UML_BUILD_INTEGRATION_TESTS": false,
        "UML_BUILD_TOOLING_TESTS": true,
        "UML_GADGET_ADD_SUB_IMMEDIATE_SUCCESSOR_HOIST": true,
        "UML_GADGET_EXACT_CACHE_VALIDATION": true,
        "UML_GADGET_SIMD_DESTINATION_RESIDENCY": true,
        "UML_JIT_CARRY_X8_X9_ACROSS_LINKS": false,
        "UML_JIT_SHARE_TRANSLATIONS_BETWEEN_EXECUTORS": true,
        "UML_GUEST_16K_PAGES": true
      }
    },
    {
      "name": "macos-unit-4k",
      "displayName": "macOS host unit tests (4 KiB)",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "macos-unit-gpu",
      "displayName": "macOS host GPU ownership tests",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_BUILD_GPU": true
      }
    },
    {
      "name": "macos-unit-gpu-asan-ubsan",
      "displayName": "macOS host GPU ownership tests with ASan/UBSan",
      "inherits": "macos-unit-gpu",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos-unit-gpu-venus",
