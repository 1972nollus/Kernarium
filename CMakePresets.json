{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-unit-16k",
      "displayName": "macOS host unit tests (16 KiB)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/Apple.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UML_APPLE_PLATFORM": "macos",
        "UML_BUILD_CLI": false,
        "UML_BUILD_KERNEL_RUNNER": false,
        "UML_BUILD_NETWORK_PROVIDER": false,
        "UML_BUILD_GPU": false,
        "UML_BUILD_UNIT_TESTS": true,
        "UML_BUILD_INTEGRATION_TESTS": false,
        "UML_BUILD_TOOLING_TESTS": true,
        "UML_GUEST_16K_PAGES": true
      }
    },
    {
      "name": "macos-unit-4k",
      "displayName": "macOS host unit tests (4 KiB)",
      "inherits": "macos-unit-16k",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "macos-unit-gpu",
      "displayName": "macOS host GPU ownership tests",
      "inherits": "macos-unit-16k",
      "cacheVariables": {
        "UML_BUILD_GPU": true
      }
    },
    {
      "name": "macos-unit-gpu-asan-ubsan",
      "displayName": "macOS host GPU ownership tests with ASan/UBSan",
      "inherits": "macos-unit-gpu",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos-unit-gpu-venus",
      "displayName": "macOS experimental Venus GPU tests (16 KiB)",
      "inherits": "macos-unit-gpu",
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "UML_DEPENDENCY_PREFIX": "${sourceDir}/.build/dependencies/macos-arm64-26",
        "UML_APPLE_GPU_DEPENDENCY_PREFIX": "${sourceDir}/.build/dependencies/apple-gpu-vulkan-experiment/macos-arm64"
      }
    },
    {
      "name": "macos-unit-gpu-venus-4k",
      "displayName": "macOS experimental Venus GPU tests (4 KiB)",
      "inherits": "macos-unit-gpu-venus",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "macos-unit-gpu-venus-asan-ubsan",
      "displayName": "macOS experimental Venus GPU tests with ASan/UBSan",
      "inherits": "macos-unit-gpu-venus",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos-tooling",
      "displayName": "macOS host tooling checks",
      "inherits": "macos-unit-16k",
      "cacheVariables": {
        "UML_BUILD_UNIT_TESTS": false
      }
    },
    {
      "name": "macos-integration",
      "displayName": "macOS guest integration tests",
      "inherits": "macos-unit-16k",
      "cacheVariables": {
        "UML_BUILD_CLI": true,
        "UML_BUILD_KERNEL_RUNNER": true,
        "UML_BUILD_NETWORK_PROVIDER": true,
        "UML_BUILD_GPU": true,
        "UML_BUILD_UNIT_TESTS": false,
        "UML_BUILD_INTEGRATION_TESTS": true,
        "UML_INTEGRATION_ROOTFS": "${sourceDir}/rootfs.erofs",
        "UML_KERNEL_PRODUCT": "mainline-6.18"
      }
    },
    {
      "name": "macos-integration-4k",
      "displayName": "macOS guest integration tests (4 KiB)",
      "inherits": "macos-integration",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "macos-x86_64",
      "displayName": "macOS x86_64 userspace compatibility product (4 KiB)",
      "inherits": "macos-unit-4k",
      "cacheVariables": {
        "UML_BUILD_CLI": true,
        "UML_BUILD_KERNEL_RUNNER": true,
        "UML_BUILD_NETWORK_PROVIDER": true,
        "UML_BUILD_GPU": true,
        "UML_BUILD_UNIT_TESTS": false,
        "UML_KERNEL_PRODUCT": "mainline-6.18",
        "UML_MAINLINE_KERNEL_SLICE": "x86_64"
      }
    },
    {
      "name": "macos-integration-venus",
      "displayName": "macOS experimental Venus guest integration tests (16 KiB)",
      "inherits": "macos-integration",
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "UML_DEPENDENCY_PREFIX": "${sourceDir}/.build/dependencies/macos-arm64-26",
        "UML_APPLE_GPU_DEPENDENCY_PREFIX": "${sourceDir}/.build/dependencies/apple-gpu-vulkan-experiment/macos-arm64"
      }
    },
    {
      "name": "macos-integration-venus-4k",
      "displayName": "macOS experimental Venus guest integration tests (4 KiB)",
      "inherits": "macos-integration-venus",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "macos-android17",
      "displayName": "macOS Android 17 guest executable",
      "inherits": "macos-unit-16k",
      "cacheVariables": {
        "UML_BUILD_ANDROID17_CLI": true,
        "UML_BUILD_KERNEL_RUNNER": true,
        "UML_BUILD_NETWORK_PROVIDER": true,
        "UML_BUILD_GPU": true,
        "UML_BUILD_AUDIO": true,
        "UML_BUILD_UNIT_TESTS": false,
        "UML_KERNEL_PRODUCT": "android-17"
      }
    },
    {
      "name": "macos-all",
      "displayName": "macOS unit and integration tests",
      "inherits": "macos-integration",
      "cacheVariables": {
        "UML_BUILD_UNIT_TESTS": true
      }
    },
    {
      "name": "macos-unit-16k-asan-ubsan",
      "displayName": "macOS unit tests with ASan/UBSan",
      "inherits": "macos-unit-16k",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos-unit-16k-tsan",
      "displayName": "macOS unit tests with TSan",
      "inherits": "macos-unit-16k",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "macos-loader-asan-ubsan",
      "displayName": "macOS embedded-loader ASan/UBSan gate",
      "inherits": "macos-tooling",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "UML_BUILD_KERNEL_RUNNER": true
      }
    },
    {
      "name": "ios-device",
      "displayName": "iOS device library",
      "inherits": "macos-unit-16k",
      "cacheVariables": {
        "UML_APPLE_PLATFORM": "ios",
        "UML_BUILD_UNIT_TESTS": false,
        "UML_BUILD_TOOLING_TESTS": false
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "iOS simulator library",
      "inherits": "macos-unit-16k",
      "cacheVariables": {
        "UML_APPLE_PLATFORM": "ios-simulator",
        "UML_BUILD_UNIT_TESTS": false,
        "UML_BUILD_TOOLING_TESTS": false
      }
    },
    {
      "name": "kernarium-ios-device",
      "displayName": "Kernarium iOS device runtime (16 KiB)",
      "inherits": "ios-device",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-device-16k",
      "cacheVariables": {
        "UML_BUILD_KERNEL_RUNNER": true,
        "UML_BUILD_NETWORK_PROVIDER": true,
        "UML_BUILD_GPU": true,
        "UML_BUILD_KERNARIUM_RUNTIME": true,
        "UML_APPLE_GPU_DEPENDENCY_PREFIX": "${sourceDir}/.build/dependencies/apple-gpu-vulkan-experiment/ios-device-arm64",
        "UML_IOS_NETWORK_DEPENDENCY_PREFIX": "${sourceDir}/.build/dependencies/ios-device-arm64/network"
      }
    },
    {
      "name": "kernarium-ios-device-4k",
      "displayName": "Kernarium iOS device runtime (4 KiB)",
      "inherits": "kernarium-ios-device",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-device-4k",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "kernarium-ios-device-automation",
      "displayName": "Kernarium iOS device automation runtime (16 KiB)",
      "inherits": "kernarium-ios-device",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-device-automation-16k",
      "cacheVariables": {
        "UML_KERNARIUM_AUTOMATION_HARNESS": true
      }
    },
    {
      "name": "kernarium-ios-device-automation-4k",
      "displayName": "Kernarium iOS device automation runtime (4 KiB)",
      "inherits": "kernarium-ios-device-automation",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-device-automation-4k",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "kernarium-ios-device-android",
      "displayName": "Kernarium iOS device Android runtime (16 KiB)",
      "inherits": "kernarium-ios-device",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-device-android-16k",
      "cacheVariables": {
        "UML_KERNEL_PRODUCT": "android-17"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "tooling-test-binaries",
      "configurePreset": "macos-tooling",
      "targets": ["tooling-test-binaries", "architecture-audit"]
    },
    {
      "name": "unit-test-binaries",
      "configurePreset": "macos-unit-16k",
      "targets": ["tooling-test-binaries", "unit-test-binaries", "architecture-audit"]
    },
    {
      "name": "unit-test-binaries-4k",
      "configurePreset": "macos-unit-4k",
      "targets": ["tooling-test-binaries", "unit-test-binaries", "architecture-audit"]
    },
    {
      "name": "gpu-unit-test-binaries",
      "configurePreset": "macos-unit-gpu",
      "targets": ["tooling-test-binaries", "gpu-unit-test-binaries", "architecture-audit"]
    },
    {
      "name": "gpu-unit-test-binaries-asan-ubsan",
      "configurePreset": "macos-unit-gpu-asan-ubsan",
      "targets": ["tooling-test-binaries", "gpu-unit-test-binaries", "architecture-audit"]
    },
    {
      "name": "gpu-venus-test-binaries",
      "configurePreset": "macos-unit-gpu-venus",
      "targets": ["tooling-test-binaries", "gpu-unit-test-binaries", "architecture-audit"]
    },
    {
      "name": "gpu-venus-test-binaries-4k",
      "configurePreset": "macos-unit-gpu-venus-4k",
      "targets": ["tooling-test-binaries", "gpu-unit-test-binaries", "architecture-audit"]
    },
    {
      "name": "gpu-venus-test-binaries-asan-ubsan",
      "configurePreset": "macos-unit-gpu-venus-asan-ubsan",
      "targets": ["tooling-test-binaries", "gpu-unit-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-integration",
      "configurePreset": "macos-integration",
      "targets": ["tooling-test-binaries", "integration-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-integration-4k",
      "configurePreset": "macos-integration-4k",
      "targets": ["tooling-test-binaries", "integration-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64",
      "targets": ["uml-darwin", "tooling-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-integration-venus",
      "configurePreset": "macos-integration-venus",
      "targets": ["tooling-test-binaries", "integration-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-integration-venus-4k",
      "configurePreset": "macos-integration-venus-4k",
      "targets": ["tooling-test-binaries", "integration-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-android17",
      "configurePreset": "macos-android17",
      "targets": ["uml-darwin-android17", "tooling-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-all",
      "configurePreset": "macos-all",
      "targets": ["tooling-test-binaries", "unit-test-binaries", "integration-test-binaries", "architecture-audit"]
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "macos-unit-16k-asan-ubsan",
      "targets": ["unit-test-binaries"]
    },
    {
      "name": "tsan",
      "configurePreset": "macos-unit-16k-tsan",
      "targets": ["unit-test-binaries"]
    },
    {
      "name": "loader-asan-ubsan",
      "configurePreset": "macos-loader-asan-ubsan",
      "targets": ["uml_embedded_kernel_serialization_tests", "architecture-audit"]
    },
    {
      "name": "ios-device",
      "configurePreset": "ios-device",
      "targets": ["uml_emulator", "architecture-audit"]
    },
    {
      "name": "ios-simulator",
      "configurePreset": "ios-simulator",
      "targets": ["uml_emulator", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-device",
      "configurePreset": "kernarium-ios-device",
      "targets": ["KernariumRuntime", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-device-4k",
      "configurePreset": "kernarium-ios-device-4k",
      "targets": ["KernariumRuntime", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-device-automation",
      "configurePreset": "kernarium-ios-device-automation",
      "targets": ["KernariumRuntime", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-device-automation-4k",
      "configurePreset": "kernarium-ios-device-automation-4k",
      "targets": ["KernariumRuntime", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-device-android",
      "configurePreset": "kernarium-ios-device-android",
      "targets": ["KernariumRuntime", "architecture-audit"]
    }
  ],
  "testPresets": [
    {
      "name": "test-defaults",
      "hidden": true,
      "description": "Output and resource settings for every test preset outside the unit-gpu family; unit-gpu owns the GPU name filter and has no parent",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "unit",
      "inherits": "test-defaults",
      "configurePreset": "macos-unit-16k",
      "filter": {
        "include": {
          "label": "^unit$"
        }
      },
      "execution": {
        "jobs": 10
      }
    },
    {
      "name": "unit-4k",
      "inherits": "test-defaults",
      "configurePreset": "macos-unit-4k",
      "filter": {
        "include": {
          "label": "^unit$"
        }
      },
      "execution": {
        "jobs": 10
      }
    },
    {
      "name": "unit-gpu",
      "configurePreset": "macos-unit-gpu",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^(gpu-device-command-atomicity|gpu-display-resize|gpu-host-gl-provider-lifetime|gpu-host-pointer-image|gpu-import-bounds|gpu-kosmickrisp-device-address-commands-capabilities|gpu-kosmickrisp-dynamic-logic-op-capabilities|gpu-kosmickrisp-external-image-alias|gpu-kosmickrisp-graphics-pipeline-library-capabilities|gpu-kosmickrisp-incremental-present-capabilities|gpu-kosmickrisp-legacy-vertex-attribute-capabilities|gpu-kosmickrisp-legacy-vertex-input-draws|gpu-kosmickrisp-non-seamless-cube-capabilities|gpu-kosmickrisp-rgb32-texel-capabilities|gpu-kosmickrisp-unused-attachments-capabilities|gpu-native-display-menu-teardown|gpu-native-metal-presentation|gpu-service-fd-ownership|gpu-service-stop-wake|gpu-transport-descriptor-ceiling|gpu-transport-wire-ownership|gpu-vnc-lifetime|gpu-vnc-product-readback|gpu-host-graphics-footprint|gpu-device-memory-pool|virtio-balloon-protocol|virtio-battery-protocol|virtio-console-protocol|virtio-input-protocol|virtio-sound-protocol|virtio-video-protocol|platform-video-decoder)$"
        }
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "unit-gpu-asan-ubsan",
      "inherits": "unit-gpu",
      "configurePreset": "macos-unit-gpu-asan-ubsan"
    },
    {
      "name": "unit-gpu-venus",
      "inherits": "unit-gpu",
      "configurePreset": "macos-unit-gpu-venus"
    },
    {
      "name": "unit-gpu-venus-4k",
      "inherits": "unit-gpu",
      "configurePreset": "macos-unit-gpu-venus-4k"
    },
    {
      "name": "unit-gpu-venus-asan-ubsan",
      "inherits": "unit-gpu",
      "configurePreset": "macos-unit-gpu-venus-asan-ubsan"
    },
    {
      "name": "tooling-gpu-vnc",
      "inherits": "test-defaults",
      "configurePreset": "macos-unit-gpu",
      "filter": {
        "include": {
          "name": "^virtio-gpu-vnc-smoke$"
        }
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "tooling-gpu-vnc-asan-ubsan",
      "inherits": "tooling-gpu-vnc",
      "configurePreset": "macos-unit-gpu-asan-ubsan"
    },
    {
      "name": "tooling-gpu-vnc-venus",
      "inherits": "tooling-gpu-vnc",
      "configurePreset": "macos-unit-gpu-venus"
    },
    {
      "name": "tooling-gpu-vnc-venus-4k",
      "inherits": "tooling-gpu-vnc",
      "configurePreset": "macos-unit-gpu-venus-4k"
    },
    {
      "name": "tooling-gpu-vnc-venus-asan-ubsan",
      "inherits": "tooling-gpu-vnc",
      "configurePreset": "macos-unit-gpu-venus-asan-ubsan"
    },
    {
      "name": "integration-fast",
      "inherits": "test-defaults",
      "configurePreset": "macos-integration",
      "filter": {
        "include": {
          "label": "^integration$"
        },
        "exclude": {
          "label": "pressure"
        }
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "integration-full",
      "inherits": "test-defaults",
      "configurePreset": "macos-integration",
      "filter": {
        "include": {
          "label": "^integration$"
        }
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "integration-fast-4k",
      "inherits": "integration-fast",
      "configurePreset": "macos-integration-4k"
    },
    {
      "name": "integration-fast-venus",
      "inherits": "integration-fast",
      "configurePreset": "macos-integration-venus"
    },
    {
      "name": "integration-fast-venus-4k",
      "inherits": "integration-fast",
      "configurePreset": "macos-integration-venus-4k"
    },
    {
      "name": "integration-full-4k",
      "inherits": "integration-full",
      "configurePreset": "macos-integration-4k"
    },
    {
      "name": "tooling",
      "inherits": "test-defaults",
      "configurePreset": "macos-tooling",
      "filter": {
        "include": {
          "label": "^tooling$"
        }
      },
      "execution": {
        "jobs": 10
      }
    },
    {
      "name": "tooling-unit",
      "inherits": "tooling",
      "configurePreset": "macos-unit-16k"
    },
    {
      "name": "tooling-unit-4k",
      "inherits": "tooling-unit",
      "configurePreset": "macos-unit-4k"
    },
    {
      "name": "tooling-integration",
      "inherits": "tooling",
      "configurePreset": "macos-integration",
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "tooling-integration-4k",
      "inherits": "tooling-integration",
      "configurePreset": "macos-integration-4k"
    },
    {
      "name": "tooling-integration-venus",
      "inherits": "tooling-integration",
      "configurePreset": "macos-integration-venus"
    },
    {
      "name": "tooling-integration-venus-4k",
      "inherits": "tooling-integration",
      "configurePreset": "macos-integration-venus-4k"
    },
    {
      "name": "tooling-all",
      "inherits": "tooling-unit",
      "configurePreset": "macos-all"
    },
    {
      "name": "all",
      "inherits": "test-defaults",
      "configurePreset": "macos-all",
      "filter": {
        "include": {
          "label": "^(unit|integration)$"
        }
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "unit-asan-ubsan",
      "inherits": "test-defaults",
      "configurePreset": "macos-unit-16k-asan-ubsan",
      "filter": {
        "include": {
          "label": "^unit$"
        }
      }
    },
    {
      "name": "unit-tsan",
      "inherits": "test-defaults",
      "configurePreset": "macos-unit-16k-tsan",
      "filter": {
        "include": {
          "label": "tsan"
        }
      },
      "execution": {
        "jobs": 3
      }
    },
    {
      "name": "loader-asan-ubsan",
      "inherits": "test-defaults",
      "configurePreset": "macos-loader-asan-ubsan",
      "filter": {
        "include": {
          "name": "^embedded-kernel-handle-serialization$"
        }
      },
      "execution": {
        "jobs": 1
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "check-tooling",
      "steps": [
        {"type": "configure", "name": "macos-tooling"},
        {"type": "build", "name": "tooling-test-binaries"},
        {"type": "test", "name": "tooling"}
      ]
    },
    {
      "name": "check-unit",
      "steps": [
        {"type": "configure", "name": "macos-unit-16k"},
        {"type": "build", "name": "unit-test-binaries"},
        {"type": "test", "name": "unit"},
        {"type": "test", "name": "tooling-unit"}
      ]
    },
    {
      "name": "check-unit-4k",
      "steps": [
        {"type": "configure", "name": "macos-unit-4k"},
        {"type": "build", "name": "unit-test-binaries-4k"},
        {"type": "test", "name": "unit-4k"},
        {"type": "test", "name": "tooling-unit-4k"}
      ]
    },
    {
      "name": "check-integration",
