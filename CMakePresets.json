{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-unit-16k",
      "displayName": "macOS host unit tests (16 KiB)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/Apple.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UML_APPLE_PLATFORM": "macos",
        "UML_BUILD_CLI": false,
        "UML_BUILD_KERNEL_RUNNER": false,
        "UML_BUILD_NETWORK_PROVIDER": false,
        "UML_BUILD_GPU": false,
        "UML_BUILD_UNIT_TESTS": true,
        "UML_BUILD_INTEGRATION_TESTS": false,
        "UML_BUILD_TOOLING_TESTS": true,
        "UML_GADGET_ADD_SUB_IMMEDIATE_SUCCESSOR_HOIST": true,
        "UML_GADGET_EXACT_CACHE_VALIDATION": true,
        "UML_GADGET_SIMD_DESTINATION_RESIDENCY": true,
        "UML_JIT_CARRY_X8_X9_ACROSS_LINKS": false,
        "UML_JIT_SHARE_TRANSLATIONS_BETWEEN_EXECUTORS": true,
        "UML_GUEST_16K_PAGES": true
      }
    },
    {
      "name": "macos-unit-4k",
      "displayName": "macOS host unit tests (4 KiB)",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "macos-unit-gpu",
      "displayName": "macOS host GPU ownership tests",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_BUILD_GPU": true
      }
    },
    {
      "name": "macos-unit-gpu-asan-ubsan",
      "displayName": "macOS host GPU ownership tests with ASan/UBSan",
      "inherits": "macos-unit-gpu",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos-tooling",
      "displayName": "macOS host tooling checks",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_BUILD_UNIT_TESTS": false,
        "UML_BUILD_INTEGRATION_TESTS": false,
        "UML_BUILD_TOOLING_TESTS": true
      }
    },
    {
      "name": "macos-integration",
      "displayName": "macOS guest integration tests",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_BUILD_CLI": true,
        "UML_BUILD_KERNEL_RUNNER": true,
        "UML_BUILD_NETWORK_PROVIDER": true,
        "UML_BUILD_GPU": true,
        "UML_BUILD_UNIT_TESTS": false,
        "UML_BUILD_INTEGRATION_TESTS": true,
        "UML_INTEGRATION_ROOTFS": "${sourceDir}/rootfs.erofs",
        "UML_KERNEL_PRODUCT": "mainline-6.18"
      }
    },
    {
      "name": "macos-integration-4k",
      "displayName": "macOS guest integration tests (4 KiB)",
      "inherits": "macos-integration",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "macos-jitprof",
      "displayName": "macOS JIT profiling emulator",
      "inherits": "macos-integration",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_ENABLE_RUNTIME_PROFILING": true
      }
    },
    {
      "name": "macos-android17",
      "displayName": "macOS Android 17 guest executable",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_BUILD_CLI": false,
        "UML_BUILD_ANDROID17_CLI": true,
        "UML_BUILD_KERNEL_RUNNER": true,
        "UML_BUILD_NETWORK_PROVIDER": true,
        "UML_BUILD_GPU": true,
        "UML_BUILD_AUDIO": true,
        "UML_BUILD_UNIT_TESTS": false,
        "UML_BUILD_INTEGRATION_TESTS": false,
        "UML_BUILD_TOOLING_TESTS": true,
        "UML_GUEST_16K_PAGES": true,
        "UML_KERNEL_PRODUCT": "android-17"
      }
    },
    {
      "name": "macos-all",
      "displayName": "macOS unit and integration tests",
      "inherits": "macos-integration",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_BUILD_UNIT_TESTS": true
      }
    },
    {
      "name": "macos-unit-16k-asan-ubsan",
      "displayName": "macOS unit tests with ASan/UBSan",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos-unit-16k-tsan",
      "displayName": "macOS unit tests with TSan",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "macos-loader-asan-ubsan",
      "displayName": "macOS embedded-loader ASan/UBSan gate",
      "inherits": "macos-tooling",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "UML_BUILD_KERNEL_RUNNER": true
      }
    },
    {
      "name": "ios-device",
      "displayName": "iOS device library",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_APPLE_PLATFORM": "ios",
        "UML_BUILD_UNIT_TESTS": false,
        "UML_BUILD_INTEGRATION_TESTS": false,
        "UML_BUILD_TOOLING_TESTS": false
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "iOS simulator library",
      "inherits": "macos-unit-16k",
      "binaryDir": "${sourceDir}/.build/presets/${presetName}",
      "cacheVariables": {
        "UML_APPLE_PLATFORM": "ios-simulator",
        "UML_BUILD_UNIT_TESTS": false,
        "UML_BUILD_INTEGRATION_TESTS": false,
        "UML_BUILD_TOOLING_TESTS": false
      }
    },
    {
      "name": "kernarium-ios-device",
      "displayName": "Kernarium iOS device runtime (16 KiB)",
      "inherits": "ios-device",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-device-16k",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UML_BUILD_KERNEL_RUNNER": true,
        "UML_BUILD_NETWORK_PROVIDER": true,
        "UML_BUILD_GPU": true,
        "UML_BUILD_KERNARIUM_RUNTIME": true,
        "UML_GUEST_16K_PAGES": true,
        "UML_APPLE_GPU_DEPENDENCY_PREFIX": "${sourceDir}/.build/dependencies/apple-gpu/ios-device-arm64",
        "UML_IOS_NETWORK_DEPENDENCY_PREFIX": "${sourceDir}/.build/dependencies/ios-device-arm64/network",
        "UML_KERNEL_PRODUCT": "mainline-6.18"
      }
    },
    {
      "name": "kernarium-ios-device-4k",
      "displayName": "Kernarium iOS device runtime (4 KiB)",
      "inherits": "kernarium-ios-device",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-device-4k",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "kernarium-ios-device-android",
      "displayName": "Kernarium iOS device Android runtime (16 KiB)",
      "inherits": "kernarium-ios-device",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-device-android-16k",
      "cacheVariables": {
        "UML_KERNEL_PRODUCT": "android-17"
      }
    },
    {
      "name": "kernarium-ios-simulator",
      "displayName": "Kernarium iOS Simulator runtime (16 KiB)",
      "inherits": "ios-simulator",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-simulator-16k",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UML_BUILD_KERNEL_RUNNER": true,
        "UML_BUILD_NETWORK_PROVIDER": true,
        "UML_BUILD_GPU": true,
        "UML_BUILD_KERNARIUM_RUNTIME": true,
        "UML_GUEST_16K_PAGES": true,
        "UML_APPLE_GPU_DEPENDENCY_PREFIX": "${sourceDir}/.build/dependencies/apple-gpu/ios-simulator-arm64",
        "UML_IOS_NETWORK_DEPENDENCY_PREFIX": "${sourceDir}/.build/dependencies/ios-simulator-arm64/network",
        "UML_KERNEL_PRODUCT": "mainline-6.18"
      }
    },
    {
      "name": "kernarium-ios-simulator-4k",
      "displayName": "Kernarium iOS Simulator runtime (4 KiB)",
      "inherits": "kernarium-ios-simulator",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-simulator-4k",
      "cacheVariables": {
        "UML_GUEST_16K_PAGES": false
      }
    },
    {
      "name": "kernarium-ios-simulator-android",
      "displayName": "Kernarium iOS Simulator Android runtime (16 KiB)",
      "inherits": "kernarium-ios-simulator",
      "binaryDir": "${sourceDir}/.build/kernarium-runtime-ios-simulator-android-16k",
      "cacheVariables": {
        "UML_KERNEL_PRODUCT": "android-17"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "tooling-test-binaries",
      "configurePreset": "macos-tooling",
      "targets": ["tooling-test-binaries", "architecture-audit"]
    },
    {
      "name": "unit-test-binaries",
      "configurePreset": "macos-unit-16k",
      "targets": ["tooling-test-binaries", "unit-test-binaries", "architecture-audit"]
    },
    {
      "name": "unit-test-binaries-4k",
      "configurePreset": "macos-unit-4k",
      "targets": ["tooling-test-binaries", "unit-test-binaries", "architecture-audit"]
    },
    {
      "name": "gpu-unit-test-binaries",
      "configurePreset": "macos-unit-gpu",
      "targets": ["tooling-test-binaries", "uml_gpu_device_atomicity_tests", "uml_gpu_host_gl_provider_tests", "uml_gpu_service_fd_tests", "uml_gpu_service_stop_wake_tests", "uml_gpu_transport_wire_tests", "uml_gpu_vnc_lifetime_tests", "uml_virtio_console_tests", "uml_virtio_input_tests", "uml_virtio_sound_tests", "architecture-audit"]
    },
    {
      "name": "gpu-unit-test-binaries-asan-ubsan",
      "configurePreset": "macos-unit-gpu-asan-ubsan",
      "targets": ["tooling-test-binaries", "uml_gpu_device_atomicity_tests", "uml_gpu_host_gl_provider_tests", "uml_gpu_service_fd_tests", "uml_gpu_service_stop_wake_tests", "uml_gpu_transport_wire_tests", "uml_gpu_vnc_lifetime_tests", "uml_virtio_console_tests", "uml_virtio_input_tests", "uml_virtio_sound_tests", "architecture-audit"]
    },
    {
      "name": "macos-integration",
      "configurePreset": "macos-integration",
      "targets": ["tooling-test-binaries", "integration-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-integration-4k",
      "configurePreset": "macos-integration-4k",
      "targets": ["tooling-test-binaries", "integration-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-jitprof",
      "configurePreset": "macos-jitprof",
      "targets": ["tooling-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-android17",
      "configurePreset": "macos-android17",
      "targets": ["uml-darwin-android17", "tooling-test-binaries", "architecture-audit"]
    },
    {
      "name": "macos-all",
      "configurePreset": "macos-all",
      "targets": ["tooling-test-binaries", "unit-test-binaries", "integration-test-binaries", "architecture-audit"]
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "macos-unit-16k-asan-ubsan",
      "targets": ["unit-test-binaries"]
    },
    {
      "name": "tsan",
      "configurePreset": "macos-unit-16k-tsan",
      "targets": ["unit-test-binaries"]
    },
    {
      "name": "loader-asan-ubsan",
      "configurePreset": "macos-loader-asan-ubsan",
      "targets": ["uml_embedded_kernel_serialization_tests", "architecture-audit"]
    },
    {
      "name": "ios-device",
      "configurePreset": "ios-device",
      "targets": ["uml_emulator", "architecture-audit"]
    },
    {
      "name": "ios-simulator",
      "configurePreset": "ios-simulator",
      "targets": ["uml_emulator", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-device",
      "configurePreset": "kernarium-ios-device",
      "targets": ["KernariumRuntime", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-device-4k",
      "configurePreset": "kernarium-ios-device-4k",
      "targets": ["KernariumRuntime", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-device-android",
      "configurePreset": "kernarium-ios-device-android",
      "targets": ["KernariumRuntime", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-simulator",
      "configurePreset": "kernarium-ios-simulator",
      "targets": ["KernariumRuntime", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-simulator-4k",
      "configurePreset": "kernarium-ios-simulator-4k",
      "targets": ["KernariumRuntime", "architecture-audit"]
    },
    {
      "name": "kernarium-ios-simulator-android",
      "configurePreset": "kernarium-ios-simulator-android",
      "targets": ["KernariumRuntime", "architecture-audit"]
    }
  ],
  "testPresets": [
    {
      "name": "unit",
      "configurePreset": "macos-unit-16k",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^unit$"
        }
      },
      "execution": {
        "jobs": 10,
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "unit-4k",
      "configurePreset": "macos-unit-4k",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^unit$"
        }
      },
      "execution": {
        "jobs": 10,
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "unit-gpu",
      "configurePreset": "macos-unit-gpu",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^(gpu-device-command-atomicity|gpu-host-gl-provider-lifetime|gpu-service-fd-ownership|gpu-service-stop-wake|gpu-transport-wire-ownership|gpu-vnc-lifetime|virtio-console-protocol|virtio-sound-protocol)$"
        }
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "unit-gpu-asan-ubsan",
      "inherits": "unit-gpu",
      "configurePreset": "macos-unit-gpu-asan-ubsan"
    },
    {
      "name": "tooling-gpu-vnc",
      "configurePreset": "macos-unit-gpu",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^virtio-gpu-vnc-smoke$"
        }
      },
      "execution": {
        "jobs": 1,
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "tooling-gpu-vnc-asan-ubsan",
      "inherits": "tooling-gpu-vnc",
      "configurePreset": "macos-unit-gpu-asan-ubsan"
    },
    {
      "name": "integration-fast",
      "configurePreset": "macos-integration",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^integration$"
        },
        "exclude": {
          "label": "pressure"
        }
      },
      "execution": {
        "jobs": 1,
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "integration-full",
      "configurePreset": "macos-integration",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^integration$"
        }
      },
      "execution": {
        "jobs": 1,
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "integration-fast-4k",
      "inherits": "integration-fast",
      "configurePreset": "macos-integration-4k"
    },
    {
      "name": "integration-full-4k",
      "inherits": "integration-full",
      "configurePreset": "macos-integration-4k"
    },
    {
      "name": "tooling",
      "configurePreset": "macos-tooling",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^tooling$"
        }
      },
      "execution": {
        "jobs": 10,
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "tooling-unit",
      "inherits": "tooling",
      "configurePreset": "macos-unit-16k"
    },
    {
      "name": "tooling-unit-4k",
      "inherits": "tooling-unit",
      "configurePreset": "macos-unit-4k"
    },
    {
      "name": "tooling-integration",
      "inherits": "tooling",
      "configurePreset": "macos-integration",
      "execution": {
        "jobs": 1,
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "tooling-integration-4k",
      "inherits": "tooling-integration",
      "configurePreset": "macos-integration-4k"
    },
    {
      "name": "tooling-jitprof",
      "configurePreset": "macos-jitprof",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^(jit-profile-final-report-contract|jit-profile-preset-contract)$"
        }
      },
      "execution": {
        "jobs": 1,
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "tooling-all",
      "inherits": "tooling-unit",
      "configurePreset": "macos-all"
    },
    {
      "name": "all",
      "configurePreset": "macos-all",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^(unit|integration)$"
        }
      },
      "execution": {
        "jobs": 1,
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "unit-asan-ubsan",
      "configurePreset": "macos-unit-16k-asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^unit$"
        }
      }
    },
    {
      "name": "unit-tsan",
      "configurePreset": "macos-unit-16k-tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "tsan"
        }
      },
      "execution": {
        "jobs": 3
      }
    },
    {
      "name": "loader-asan-ubsan",
      "configurePreset": "macos-loader-asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^embedded-kernel-handle-serialization$"
        }
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "instruction-evidence",
      "configurePreset": "macos-unit-16k",
      "environment": {
        "UML_INSTRUCTION_RAW_EVIDENCE": "1"
      },
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^(unit|instruction-evidence-validation)$"
        }
      },
      "execution": {
        "jobs": 1,
        "resourceSpecFile": "${sourceDir}/cmake/ctest-resources.json"
      }
    },
    {
      "name": "instruction-evidence-4k",
      "inherits": "instruction-evidence",
      "configurePreset": "macos-unit-4k"
    }
  ],
  "workflowPresets": [
    {
      "name": "check-unit",
      "steps": [
        {"type": "configure", "name": "macos-unit-16k"},
        {"type": "build", "name": "unit-test-binaries"},
        {"type": "test", "name": "unit"},
        {"type": "test", "name": "tooling-unit"}
      ]
    },
    {
      "name": "check-unit-4k",
      "steps": [
        {"type": "configure", "name": "macos-unit-4k"},
        {"type": "build", "name": "unit-test-binaries-4k"},
        {"type": "test", "name": "unit-4k"},
        {"type": "test", "name": "tooling-unit-4k"}
      ]
    },
    {
      "name": "check-integration",
      "steps": [
        {"type": "configure", "name": "macos-integration"},
        {"type": "build", "name": "macos-integration"},
        {"type": "test", "name": "tooling-integration"},
        {"type": "test", "name": "integration-fast"}
      ]
    },
    {
      "name": "check-gpu",
      "steps": [
        {"type": "configure", "name": "macos-unit-gpu"},
        {"type": "build", "name": "gpu-unit-test-binaries"},
        {"type": "test", "name": "unit-gpu"},
        {"type": "test", "name": "tooling-gpu-vnc"}
      ]
    },
    {
      "name": "check-gpu-asan-ubsan",
      "steps": [
        {"type": "configure", "name": "macos-unit-gpu-asan-ubsan"},
        {"type": "build", "name": "gpu-unit-test-binaries-asan-ubsan"},
        {"type": "test", "name": "unit-gpu-asan-ubsan"},
        {"type": "test", "name": "tooling-gpu-vnc-asan-ubsan"}
      ]
    },
    {
      "name": "check-integration-4k",
      "steps": [
        {"type": "configure", "name": "macos-integration-4k"},
        {"type": "build", "name": "macos-integration-4k"},
        {"type": "test", "name": "tooling-integration-4k"},
        {"type": "test", "name": "integration-fast-4k"}
      ]
    },
    {
      "name": "check-jitprof",
